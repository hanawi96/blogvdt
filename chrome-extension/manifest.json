{
  "manifest_version": 3,
  "name": "Vòng Dâu Tằm — Tạo đơn",
  "description": "Sidebar tạo đơn nổi trên Pancake và Zalo.",
  "version": "1.10.19",
  "permissions": [
    "sidePanel",
    "storage",
    "windows",
    "tabs",
    "cookies"
  ],
  "host_permissions": [
    "https://pancake.vn/*",
    "https://chat.zalo.me/*",
    "https://pos.pancake.vn/*",
    "https://vongdautambyanh.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Bật/tắt tạo đơn",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://pancake.vn/vongdautambyvui*",
        "https://chat.zalo.me/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "overlay.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://pos.pancake.vn/*"
      ],
      "js": [
        "pos-order-badges.js"
      ],
      "css": [
        "pos-order-badges.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "panel.html",
        "panel.css",
        "panel.js",
        "data/*",
        "sidepanel.html",
        "sidepanel.js",
        "icons/*"
      ],
      "matches": [
        "https://pancake.vn/*",
        "https://chat.zalo.me/*"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
