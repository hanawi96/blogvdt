{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "vong-dau-tam",
  // Custom entry: Astro fetch + Workflows + cron lịch backup.
  "main": "./src/worker.ts",
  // Ngày tương thích của Worker mới. Xem lại trước khi đẩy ngày này lên sau này.
  "compatibility_date": "2026-10-14",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  // Domain production. SITE_URL phải khớp hostname khách truy cập (không dùng www nếu canonical là apex).
  // workers_dev / preview_urls = false: chỉ phục vụ qua custom domain, tránh deploy lại bật URL tạm.
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "ENVIRONMENT": "production",
    "SITE_URL": "https://vongdautambyanh.com",
    "CF_ACCOUNT_ID": "6732e495e6dc332a4d51e0aba6c0408a",
    "D1_DATABASE_ID": "b98c2657-e991-42e8-bba3-a797452437b2"
  },
  "triggers": {
    // Mỗi giờ UTC: kiểm tra lịch backup / job hẹn giờ.
    "crons": ["0 * * * *"]
  },
  "workflows": [
    {
      "name": "vdt-backup",
      "binding": "BACKUP_WORKFLOW",
      "class_name": "BackupWorkflow"
    },
    {
      "name": "vdt-restore",
      "binding": "RESTORE_WORKFLOW",
      "class_name": "RestoreWorkflow"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      // Tên hiển thị của database. Local dùng tên này để định danh DB local.
      // --remote nhắm production theo database_id (DB production thật tên "blogvdt").
      "database_name": "vong-dau-tam",
      "database_id": "b98c2657-e991-42e8-bba3-a797452437b2",
      "migrations_dir": "migrations",
      // Lệnh không có --remote luôn dùng D1 local; --remote mới chạm database thật theo database_id.
      "remote": false
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "vong-dau-tam-media",
      "remote": false
    },
    {
      "binding": "BACKUPS",
      "bucket_name": "vong-dau-tam-backups",
      "remote": false
    }
  ],
  // Resize/encode ảnh lúc upload (tạo thumb) trước khi ghi R2.
  "images": {
    "binding": "IMAGES"
  }
}
