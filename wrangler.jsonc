{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "vong-dau-tam",
  "main": "@astrojs/cloudflare/entrypoints/server",
  // Ngày tương thích của Worker mới. Xem lại trước khi đẩy ngày này lên sau này.
  "compatibility_date": "2026-10-14",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  // Biến môi trường production. Khi chạy thử trên *.workers.dev: giữ ENVIRONMENT khác "production"
  // để toàn site noindex (không cho Google index tên miền tạm). Khi có domain thật:
  // đổi SITE_URL = "https://ten-mien.com" và ENVIRONMENT = "production" rồi deploy lại.
  "vars": {
    "ENVIRONMENT": "staging",
    "SITE_URL": ""
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      // Tên hiển thị của database. Local dùng tên này để định danh DB local.
      // --remote nhắm production theo database_id (DB production thật tên "blogvdt").
      "database_name": "vong-dau-tam",
      "database_id": "b98c2657-e991-42e8-bba3-a797452437b2",
      "migrations_dir": "migrations",
      // Lệnh không có --remote luôn dùng D1 local; --remote mới chạm database thật theo database_id.
      "remote": false
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "vong-dau-tam-media",
      "remote": false
    }
  ]
}
