---
import '../styles/global.css';
import AdminNavIcon from '../components/admin/AdminNavIcon.astro';
import ConfirmDialog from '../components/admin/ConfirmDialog.astro';
import { ROLE_LABELS } from '../features/auth/access';
import { userInitials } from '../features/auth/users';
import { routes } from '../lib/routes';

interface Props {
  title: string;
}

type NavIcon =
  | 'overview'
  | 'posts'
  | 'categories'
  | 'products'
  | 'productCategories'
  | 'orders'
  | 'customers'
  | 'media'
  | 'seo'
  | 'redirects'
  | 'users'
  | 'activity'
  | 'settings';

const { title } = Astro.props;
const session = Astro.locals.adminSession;
const path = Astro.url.pathname;
const isAdmin = session?.role === 'admin';
const items: { href: string; label: string; icon: NavIcon }[] = [
  { href: routes.admin, label: 'Tổng quan', icon: 'overview' },
  { href: routes.adminPosts, label: 'Bài viết', icon: 'posts' },
  { href: routes.adminCategories, label: 'Danh mục', icon: 'categories' },
  ...(isAdmin
    ? [
        { href: routes.adminProducts, label: 'Sản phẩm', icon: 'products' as const },
        { href: routes.adminProductCategories, label: 'Danh mục SP', icon: 'productCategories' as const },
        { href: routes.adminOrders, label: 'Đơn hàng', icon: 'orders' as const },
        { href: routes.adminCustomers, label: 'Khách hàng', icon: 'customers' as const },
      ]
    : []),
  { href: routes.adminMedia, label: 'Thư viện ảnh', icon: 'media' },
  ...(isAdmin
    ? [
        { href: routes.adminSeo, label: 'Kiểm tra SEO', icon: 'seo' as const },
        { href: routes.adminRedirects, label: 'Chuyển hướng', icon: 'redirects' as const },
        { href: routes.adminUsers, label: 'Người dùng', icon: 'users' as const },
        { href: routes.adminActivity, label: 'Nhật ký', icon: 'activity' as const },
        { href: routes.adminSettings, label: 'Cài đặt', icon: 'settings' as const },
      ]
    : []),
];

function current(href: string): boolean {
  if (href === routes.admin) return path === href;
  return path === href || path.startsWith(`${href}/`);
}
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex,nofollow" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-canvas font-sans text-ink antialiased">
    <a class="skip-link" href="#noi-dung">Tới nội dung</a>
    {
      session ? (
        <div class="admin-shell min-h-screen md:grid" data-admin-shell>
          <script is:inline>
            (() => {
              try {
                if (localStorage.getItem('admin-nav-collapsed') === '1') {
                  document.currentScript?.parentElement?.classList.add('is-nav-collapsed');
                }
              } catch {
                /* private mode */
              }
            })();
          </script>
          <aside class="admin-side">
            <div class="admin-side-head">
              <button
                class="admin-menu-toggle"
                type="button"
                data-nav-open
                aria-controls="admin-drawer"
                aria-expanded="false"
                aria-label="Mở menu quản trị"
              >
                <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M4 7h16M4 12h16M4 17h16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
                </svg>
              </button>
              <p class="admin-brand">Quản trị</p>
              <button
                class="admin-nav-collapse"
                type="button"
                data-nav-collapse
                aria-controls="admin-side-nav"
                aria-expanded="true"
                aria-label="Thu gọn menu"
                title="Thu gọn menu"
              >
                <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M14.5 7 10 12l4.5 5M7 5v14" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
              </button>
            </div>
            <nav class="admin-nav" id="admin-side-nav" aria-label="Quản trị">
              {items.map((item) => (
                <a
                  href={item.href}
                  title={item.label}
                  aria-label={item.label}
                  aria-current={current(item.href) ? 'page' : undefined}
                  class:list={[current(item.href) && 'is-current']}
                >
                  <AdminNavIcon name={item.icon} />
                  <span class="admin-nav-label">{item.label}</span>
                </a>
              ))}
            </nav>
            <div class="admin-account" data-account>
              <button
                class:list={['admin-account-trigger', current(routes.adminAccount) && 'is-current']}
                type="button"
                data-account-trigger
                aria-expanded="false"
                aria-controls="account-menu"
                aria-haspopup="menu"
                aria-label={`Tài khoản: ${session.displayName.trim() || 'Tài khoản'} (${ROLE_LABELS[session.role]})`}
                title={session.displayName.trim() || 'Tài khoản'}
              >
                {session.avatarUrl ? (
                  <img class="user-avatar" src={session.avatarUrl} alt="" width="40" height="40" />
                ) : (
                  <span class="user-avatar" aria-hidden="true">{userInitials(session.displayName)}</span>
                )}
                <span class="admin-account-meta">
                  <span class="admin-account-label">{session.displayName.trim() || 'Tài khoản'}</span>
                  <span class="admin-account-role">{ROLE_LABELS[session.role]}</span>
                </span>
                <svg class="admin-account-chevron" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
                  <path d="M4 6.5 8 10.5 12 6.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
              </button>
              <div class="admin-account-panel" id="account-menu" data-account-panel role="menu" hidden>
                <a role="menuitem" href={routes.adminAccount}>Thông tin tài khoản</a>
                <form method="post" action={routes.adminLogout}>
                  <input type="hidden" name="csrf" value={session.csrfToken} />
                  <button role="menuitem" type="submit">Đăng xuất</button>
                </form>
              </div>
            </div>
          </aside>
          <dialog id="admin-drawer" class="admin-drawer" aria-label="Menu quản trị">
            <div class="admin-drawer-head">
              <p class="admin-brand">Quản trị</p>
              <button class="admin-menu-toggle" type="button" data-nav-close aria-label="Đóng menu">
                <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M6 6l12 12M18 6 6 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
                </svg>
              </button>
            </div>
            <nav class="admin-drawer-nav" aria-label="Menu quản trị">
              {items.map((item) => (
                <a
                  href={item.href}
                  aria-current={current(item.href) ? 'page' : undefined}
                  class:list={[current(item.href) && 'is-current']}
                >
                  <AdminNavIcon name={item.icon} />
                  <span class="admin-nav-label">{item.label}</span>
                </a>
              ))}
            </nav>
          </dialog>
          <div>
            <header class="admin-page-head">
              <div>
                <h1 class="text-xl font-semibold">{title}</h1>
                <slot name="lead" />
              </div>
              <slot name="action" />
            </header>
            <main id="noi-dung" class="px-4 py-6">
              <slot />
            </main>
            <ConfirmDialog />
          </div>
        </div>
      ) : (
        <main id="noi-dung" class="mx-auto max-w-lg px-4 py-16">
          <h1 class="text-xl font-semibold">Không mở được trang quản trị</h1>
        </main>
    )
  }
    <script>
      const drawer = document.getElementById('admin-drawer');
      const drawerOpen = document.querySelector('[data-nav-open]');
      if (drawer instanceof HTMLDialogElement && drawerOpen instanceof HTMLButtonElement) {
        const menu = drawer;
        drawerOpen.addEventListener('click', () => {
          menu.showModal();
          drawerOpen.setAttribute('aria-expanded', 'true');
        });
        menu.addEventListener('close', () => drawerOpen.setAttribute('aria-expanded', 'false'));
        menu.querySelector('[data-nav-close]')?.addEventListener('click', () => menu.close());
        menu.addEventListener('click', (event) => {
          if (event.target !== menu) return;
          const box = menu.getBoundingClientRect();
          if (event.clientX > box.right || event.clientX < box.left || event.clientY < box.top || event.clientY > box.bottom) menu.close();
        });
        // Drawer modal chỉ dành cho màn hẹp; mở rộng cửa sổ thì đóng để trang không bị khóa sau backdrop.
        window.matchMedia('(width >= 48rem)').addEventListener('change', (event) => {
          if (event.matches && menu.open) menu.close();
        });
      }

      const shell = document.querySelector('[data-admin-shell]');
      const collapseBtn = document.querySelector('[data-nav-collapse]');
      const NAV_COLLAPSE_KEY = 'admin-nav-collapsed';
      if (shell instanceof HTMLElement && collapseBtn instanceof HTMLButtonElement) {
        const syncCollapse = (collapsed) => {
          shell.classList.toggle('is-nav-collapsed', collapsed);
          collapseBtn.setAttribute('aria-expanded', collapsed ? 'false' : 'true');
          collapseBtn.setAttribute('aria-label', collapsed ? 'Mở rộng menu' : 'Thu gọn menu');
          collapseBtn.title = collapsed ? 'Mở rộng menu' : 'Thu gọn menu';
          try {
            localStorage.setItem(NAV_COLLAPSE_KEY, collapsed ? '1' : '0');
          } catch {
            /* ignore */
          }
        };
        syncCollapse(shell.classList.contains('is-nav-collapsed'));
        collapseBtn.addEventListener('click', () => {
          syncCollapse(!shell.classList.contains('is-nav-collapsed'));
        });
      }
      const account = document.querySelector('[data-account]');
      const accountTrigger = account?.querySelector('[data-account-trigger]');
      const accountPanel = account?.querySelector('[data-account-panel]');
      if (account instanceof HTMLElement && accountTrigger instanceof HTMLButtonElement && accountPanel instanceof HTMLElement) {
        const setAccountOpen = (open: boolean) => {
          accountTrigger.setAttribute('aria-expanded', open ? 'true' : 'false');
          accountPanel.hidden = !open;
        };
        accountTrigger.addEventListener('click', () => {
          setAccountOpen(accountTrigger.getAttribute('aria-expanded') !== 'true');
        });
        document.addEventListener('click', (event) => {
          if (!(event.target instanceof Node) || account.contains(event.target)) return;
          setAccountOpen(false);
        });
        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape') setAccountOpen(false);
        });
      }
      document.querySelectorAll('form[data-busy]').forEach((form) => {
        if (!(form instanceof HTMLFormElement)) return;
        form.addEventListener('submit', (event) => {
          if (event.defaultPrevented) return;
          if (form.dataset.autosave === 'on' && form.dataset.saving !== 'manual') return;
          const submitter = event.submitter;
          // Submit sang tab/iframe khác: không khóa form trang hiện tại.
          if (submitter instanceof HTMLButtonElement) {
            const target = submitter.formTarget || form.getAttribute('target') || '';
            if (target === '_blank' || (target !== '' && target !== '_self')) return;
          }
          form.querySelectorAll('button[type="submit"]').forEach((button) => {
            if (button instanceof HTMLButtonElement) button.disabled = true;
          });
          if (submitter instanceof HTMLButtonElement) submitter.disabled = true;
          const target = submitter instanceof HTMLButtonElement ? submitter : form.querySelector('button[type="submit"]');
          if (target instanceof HTMLButtonElement && target.dataset.keepLabel !== 'true') target.textContent = 'Đang lưu...';
        });
      });
    </script>
  </body>
</html>
