---
import '../styles/global.css';
import { routes } from '../lib/routes';

interface Props {
  title: string;
}

const { title } = Astro.props;
const session = Astro.locals.adminSession;
const path = Astro.url.pathname;
const items = [
  [routes.admin, 'Tổng quan'],
  [routes.adminPosts, 'Bài viết'],
  [routes.adminCategories, 'Danh mục'],
  [routes.adminMedia, 'Thư viện ảnh'],
  ...(session?.role === 'admin'
    ? [
        [routes.adminProducts, 'Sản phẩm'],
        [routes.adminOrders, 'Đơn hàng'],
        [routes.adminSettings, 'Cài đặt'],
        [routes.adminSeo, 'Kiểm tra SEO'],
        [routes.adminUsers, 'Người dùng'],
        [routes.adminActivity, 'Nhật ký'],
      ]
    : []),
] as const;

function current(href: string): boolean {
  if (href === routes.admin) return path === href;
  return path === href || path.startsWith(`${href}/`);
}
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex,nofollow" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-canvas font-sans text-ink antialiased">
    <a class="skip-link" href="#noi-dung">Tới nội dung</a>
    {
      session ? (
        <div class="min-h-screen md:grid md:grid-cols-[15rem_1fr]">
          <aside class="border-b border-line bg-surface md:border-r md:border-b-0">
            <p class="px-4 py-5 text-lg font-semibold">Quản trị</p>
            <nav class="flex gap-1 overflow-x-auto px-3 pb-3 md:block" aria-label="Quản trị">
              {items.map(([href, label]) => (
                <a
                  href={href}
                  aria-current={current(href) ? 'page' : undefined}
                  class:list={[
                    'block rounded-md px-3 py-2 whitespace-nowrap',
                    current(href) ? 'bg-primary text-surface' : 'text-ink',
                  ]}
                >
                  {label}
                </a>
              ))}
            </nav>
            <div class="flex gap-2 px-3 py-4 md:block">
              <a class="btn" href={routes.adminAccount}>Tài khoản</a>
            <form method="post" action={routes.adminLogout} class="md:mt-2">
              <input type="hidden" name="csrf" value={session.csrfToken} />
              <button class="btn" type="submit">
                Đăng xuất
              </button>
            </form>
            </div>
          </aside>
          <div>
            <header class="admin-page-head">
              <div>
                <h1 class="text-xl font-semibold">{title}</h1>
                <slot name="lead" />
              </div>
              <slot name="action" />
            </header>
            <main id="noi-dung" class="px-4 py-6">
              <slot />
            </main>
          </div>
        </div>
      ) : (
        <main id="noi-dung" class="mx-auto max-w-lg px-4 py-16">
          <h1 class="text-xl font-semibold">Không mở được trang quản trị</h1>
        </main>
    )
  }
    <script>
      document.querySelectorAll('form[data-busy]').forEach((form) => {
        if (!(form instanceof HTMLFormElement)) return;
        form.addEventListener('submit', (event) => {
          if (event.defaultPrevented) return;
          if (form.dataset.autosave === 'on' && form.dataset.saving !== 'manual') return;
          const submitter = event.submitter;
          if (submitter instanceof HTMLButtonElement && submitter.formTarget === '_blank') return;
          form.querySelectorAll('button[type="submit"]').forEach((button) => {
            if (button instanceof HTMLButtonElement) button.disabled = true;
          });
          const target = submitter instanceof HTMLButtonElement ? submitter : form.querySelector('button[type="submit"]');
          if (target instanceof HTMLButtonElement && target.dataset.keepLabel !== 'true') target.textContent = 'Đang lưu...';
        });
      });
    </script>
  </body>
</html>
