---
import SiteFooter from '../components/public/SiteFooter.astro';
import SiteHeader from '../components/public/SiteHeader.astro';
import { shareImageType } from '../features/media/files';
import type { PublicSite } from '../features/settings/settings';
import { plainMetaText, shareImageUrl, shareMetadata, shareOriginFrom, type ShareTags } from '../lib/seo/meta';
import { EMPTY_TRACKING, buildTrackingSnippets, type Tracking, type TrackingEvent } from '../features/tracking/tracking';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  image?: string | null;
  imageAlt?: string | null;
  imageWidth?: number | null;
  imageHeight?: number | null;
  robots?: string;
  type?: 'website' | 'article';
  siteName?: string;
  publishedTime?: string;
  modifiedTime?: string;
  author?: string | null;
  jsonLd?: string[];
  faviconUrl?: string;
  chrome?: PublicSite | null;
  /** Bỏ header/footer — dùng trong iframe xem trước CMS. */
  embed?: boolean;
  /** Cấu hình theo dõi quảng cáo (đã hợp nhất landing + site). Mặc định rỗng = không nhúng gì. */
  tracking?: Tracking;
  /** Sự kiện cần bắn ngay khi tải: 'view' (xem trang) hoặc 'lead' (gửi đơn thành công). */
  trackEvent?: TrackingEvent | null;
}

const {
  title,
  description,
  canonical,
  image = null,
  imageAlt = null,
  imageWidth = null,
  imageHeight = null,
  robots = 'index,follow',
  type = 'website',
  siteName = title,
  publishedTime,
  modifiedTime,
  author = null,
  jsonLd = [],
  faviconUrl = '/favicon.svg',
  chrome = null,
  embed = false,
  tracking = EMPTY_TRACKING,
  trackEvent = null,
} = Astro.props;
const showChrome = Boolean(chrome) && !embed;
// Không bắn mã theo dõi khi xem trước trong CMS (embed).
const trackingSnippets = buildTrackingSnippets(embed ? EMPTY_TRACKING : tracking, embed ? null : trackEvent);
const robotsContent = Astro.locals.allowIndex === false ? 'noindex,nofollow' : robots;
const shareOrigin = shareOriginFrom(canonical, Astro.url.origin);
const share = shareMetadata({
  title,
  description,
  canonical,
  type,
  image: await reachableShareImage(shareOrigin, [
    { url: image, alt: imageAlt, width: imageWidth, height: imageHeight },
    { url: chrome?.ogImageUrl, alt: chrome?.ogImageAlt, width: chrome?.ogImageWidth, height: chrome?.ogImageHeight },
  ]),
});
const siteLabel = plainMetaText(siteName);

async function reachableShareImage(
  origin: string,
  candidates: Array<{ url?: string | null; alt?: string | null; width?: number | null; height?: number | null }>,
): Promise<ShareTags['image']> {
  const pending = candidates.flatMap((item) => {
    const url = shareImageUrl(origin, item.url);
    return url ? [{ url, alt: item.alt, width: item.width, height: item.height }] : [];
  });
  if (pending.length === 0) return null;
  let bucket: R2Bucket;
  try {
    const { getMediaBucket } = await import('../lib/cloudflare/env');
    bucket = getMediaBucket();
  } catch {
    return null;
  }
  for (const item of pending) {
    const mimeType = await shareImageType(bucket, item.url);
    if (mimeType === null) continue;
    return { url: item.url, alt: item.alt ?? '', width: item.width ?? null, height: item.height ?? null, mimeType };
  }
  return null;
}

---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{share.title}</title>
    <meta name="description" content={share.description} />
    {author && plainMetaText(author) && <meta name="author" content={plainMetaText(author)} />}
    <meta name="robots" content={robotsContent} />
    {share.url && <link rel="canonical" href={share.url} />}
    <meta property="og:title" content={share.title} />
    <meta property="og:description" content={share.description} />
    <meta property="og:type" content={share.type} />
    <meta property="og:site_name" content={siteLabel} />
    <meta property="og:locale" content="vi_VN" />
    {share.url && <meta property="og:url" content={share.url} />}
    {share.image && <meta property="og:image" content={share.image.url} />}
    {share.image?.mimeType && <meta property="og:image:type" content={share.image.mimeType} />}
    {share.image?.width && <meta property="og:image:width" content={String(share.image.width)} />}
    {share.image?.height && <meta property="og:image:height" content={String(share.image.height)} />}
    {share.image?.alt && <meta property="og:image:alt" content={share.image.alt} />}
    {share.type === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {share.type === 'article' && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    <meta name="twitter:card" content={share.card} />
    <meta name="twitter:title" content={share.title} />
    <meta name="twitter:description" content={share.description} />
    {share.url && <meta name="twitter:url" content={share.url} />}
    {share.image && <meta name="twitter:image" content={share.image.url} />}
    {share.image?.alt && <meta name="twitter:image:alt" content={share.image.alt} />}
    {jsonLd.map((entry) => <script type="application/ld+json" set:html={entry} />)}
    <link rel="icon" href={faviconUrl} />
    {trackingSnippets.headSrc.map((src) => <script async src={src}></script>)}
    {trackingSnippets.headScripts.map((code) => <script set:html={code} />)}
  </head>
  <body class:list={['bg-canvas font-sans text-ink antialiased', embed && 'preview-embed']}>
    {trackingSnippets.bodyNoscript.map((html) => <noscript set:html={html} />)}
    <a class="skip-link" href="#noi-dung">Tới nội dung</a>
    {showChrome && chrome && <SiteHeader site={chrome} />}
    <div id="noi-dung">
      <slot />
    </div>
    {showChrome && chrome && <SiteFooter site={chrome} />}
  </body>
</html>
