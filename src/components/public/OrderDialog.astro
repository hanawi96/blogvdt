---
import { ORDER_MAX_QUANTITY } from '../../features/orders/order';
import { WEIGHT_SCALES, weightExtras } from '../../features/products/weight';
import { routes } from '../../lib/routes';
import AddressField from './AddressField.astro';
import DiscountCodeField from './DiscountCodeField.astro';
import PaymentField from './PaymentField.astro';
import QtyStepper from './QtyStepper.astro';

// Modal đặt hàng dùng chung cho cả trang. Nút [data-order-open] truyền sản phẩm vào modal;
// khi tắt JS, nút vẫn là link tới /dat-hang nên đặt hàng không bị chặn.
const scaleGroups = Object.entries(WEIGHT_SCALES).filter(([, labels]) => labels.length > 0);
const babyExtras = weightExtras('baby');
---

<dialog id="order-dialog" class="order-dialog" aria-labelledby="order-dialog-title">
  <form class="add-form" method="post" action={routes.checkout} data-order-dialog-form>
    <div class="add-head">
      <p class="font-semibold">Đặt hàng</p>
      <button class="add-close" type="button" data-order-close aria-label="Đóng">×</button>
    </div>
    <div class="order-summary">
      <img class="order-thumb" data-od-thumb alt="" width="64" height="64" hidden />
      <div class="min-w-0">
        <p id="order-dialog-title" class="font-semibold" data-od-title></p>
        <p class="font-semibold text-primary-strong" data-od-price></p>
      </div>
    </div>
    <div class="absolute -left-[9999px]" aria-hidden="true">
      <label for="od-company">Công ty</label>
      <input id="od-company" name="company" tabindex="-1" autocomplete="off" />
    </div>
    <input type="hidden" name="productSlug" data-od-slug />
    <fieldset class="mt-3" data-od-weight hidden>
      <legend class="text-sm font-semibold">Cân nặng của bé</legend>
      {
        scaleGroups.map(([scale, labels]) => (
          <div class="weight-grid mt-2" role="radiogroup" data-scale-group={scale} hidden>
            {labels.map((label) => (
              <label class="weight-chip">
                <input type="radio" name="weight" value={label} disabled />
                <span>{label}</span>
              </label>
            ))}
            {scale === 'baby' && (
              <button type="button" class="weight-chip weight-chip-more" data-weight-more aria-expanded="false" aria-label="Cân nặng khác">
                <span aria-hidden="true">+</span>
              </button>
            )}
          </div>
        ))
      }
      <div class="weight-extra mt-2" data-weight-extra hidden>
        <select class="field" data-weight-extra-select aria-label="Chọn cân nặng lớn hơn">
          <option value="">Chọn cân nặng (16kg – 70kg)</option>
          {babyExtras.map((weight) => (
            <option value={weight} data-weight-value={weight}>{weight}</option>
          ))}
        </select>
      </div>
      <p class="weight-surcharge-note" data-weight-note hidden></p>
    </fieldset>
    <QtyStepper id="od-quantity" max={ORDER_MAX_QUANTITY} />
    <PaymentField small />
    <label class="mt-3 block text-sm font-semibold" for="od-name">
      Họ tên
      <input id="od-name" class="field mt-1" name="customerName" required maxlength="80" autocomplete="name" />
    </label>
    <label class="mt-3 block text-sm font-semibold" for="od-phone">
      Số điện thoại
      <input id="od-phone" class="field mt-1" name="phone" type="tel" required maxlength="20" autocomplete="tel" />
    </label>
    <AddressField idPrefix="od" compact />
    <label class="mt-3 block text-sm font-semibold" for="od-note">
      Ghi chú
      <textarea id="od-note" class="field mt-1 min-h-16" name="note" maxlength="500"></textarea>
    </label>
    <DiscountCodeField id="od-discount" />
    <p class="order-total">Tạm tính <strong data-od-total data-payable-amount="0"></strong></p>
    <p class="mt-2 text-sm text-muted">Xưởng gọi lại để chốt đơn. Website không thu tiền trực tuyến.</p>
    <button class="btn btn-primary mt-4 w-full" type="submit">Gửi đơn</button>
  </form>
</dialog>
<script>
  import { applyWeightPrice, weightOptionLabel, weightSurchargeLabel } from '../../features/products/weight';

  const dialog = document.getElementById('order-dialog');
  const form = dialog?.querySelector('form[data-order-dialog-form]');
  if (dialog instanceof HTMLDialogElement && form instanceof HTMLFormElement) {
    const money = new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND', maximumFractionDigits: 0 });
    const title = form.querySelector('[data-od-title]');
    const priceText = form.querySelector('[data-od-price]');
    const total = form.querySelector('[data-od-total]');
    const thumb = form.querySelector('[data-od-thumb]');
    const slugField = form.querySelector('[data-od-slug]');
    const weightWrap = form.querySelector('[data-od-weight]');
    const moreBtn = form.querySelector('[data-weight-more]');
    const extraWrap = form.querySelector('[data-weight-extra]');
    const extraSelect = form.querySelector('[data-weight-extra-select]');
    const weightNote = form.querySelector('[data-weight-note]');
    const quantity = form.querySelector('#od-quantity');
    const submit = form.querySelector('button[type="submit"]:not([value="apply"])');
    let price = 0;

    const selectedWeight = (): string => {
      const checked = form.querySelector('input[name="weight"]:checked');
      if (checked instanceof HTMLInputElement) return checked.value;
      if (extraSelect instanceof HTMLSelectElement && extraSelect.value) return extraSelect.value;
      return '';
    };

    const paintTotal = () => {
      if (!(total instanceof HTMLElement) || !(quantity instanceof HTMLInputElement)) return;
      const weight = selectedWeight();
      const unit = price > 0 ? applyWeightPrice(price, weight) : 0;
      const count = Number(quantity.value);
      const valid = Number.isInteger(count) && count >= 1;
      total.textContent = valid ? money.format(unit * count) : '—';
      total.dataset.payableAmount = valid ? String(unit * count) : '0';
      if (priceText instanceof HTMLElement && unit > 0) priceText.textContent = money.format(unit);
      const surcharge = weightSurchargeLabel(weight, price);
      if (weightNote instanceof HTMLElement) {
        weightNote.hidden = !(surcharge && unit > 0);
        weightNote.textContent = surcharge && unit > 0 ? `Vòng lớn hơn, cộng ${surcharge} nguyên liệu → ${money.format(unit)}/chiếc` : '';
      }
    };

    // Chỉ nhóm cân nặng đúng thang của sản phẩm được bật và gửi đi; thang 'none' thì ẩn hẳn.
    const showScale = (scale: string) => {
      let found = false;
      form.querySelectorAll<HTMLElement>('[data-scale-group]').forEach((group) => {
        const active = group.dataset.scaleGroup === scale;
        found ||= active;
        group.hidden = !active;
        group.querySelectorAll('input').forEach((input, index) => {
          input.disabled = !active;
          input.checked = false;
          input.required = active && index === 0;
        });
      });
      // Dropdown "cân nặng khác" chỉ dùng cho thang baby; reset mỗi lần đổi sản phẩm.
      const showExtra = scale === 'baby';
      if (extraWrap instanceof HTMLElement) extraWrap.hidden = true;
      if (moreBtn instanceof HTMLElement) {
        moreBtn.hidden = !showExtra;
        moreBtn.setAttribute('aria-expanded', 'false');
      }
      if (extraSelect instanceof HTMLSelectElement) {
        extraSelect.value = '';
        extraSelect.name = '';
        extraSelect.required = false;
        extraSelect.disabled = !showExtra;
      }
      if (weightNote instanceof HTMLElement) {
        weightNote.hidden = true;
        weightNote.textContent = '';
      }
      if (weightWrap instanceof HTMLElement) weightWrap.hidden = !found;
    };

    const fill = (trigger: HTMLElement) => {
      price = Number(trigger.dataset.price) || 0;
      if (title) title.textContent = trigger.dataset.name ?? '';
      if (priceText) priceText.textContent = money.format(price);
      if (slugField instanceof HTMLInputElement) slugField.value = trigger.dataset.slug ?? '';
      if (thumb instanceof HTMLImageElement) {
        const cover = trigger.dataset.cover ?? '';
        thumb.hidden = !cover;
        thumb.src = cover;
        thumb.alt = trigger.dataset.name ?? '';
      }
      if (quantity instanceof HTMLInputElement) quantity.value = '1';
      // Nhãn "(giá tăng X%)" phụ thuộc giá sản phẩm hiện tại nên cập nhật khi mở modal.
      if (extraSelect instanceof HTMLSelectElement) {
        extraSelect.querySelectorAll('option[data-weight-value]').forEach((opt) => {
          if (opt instanceof HTMLOptionElement) opt.textContent = weightOptionLabel(opt.dataset.weightValue ?? '', price);
        });
      }
      showScale(trigger.dataset.scale ?? 'none');
      paintTotal();
    };

    document.addEventListener('click', (event) => {
      if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      const trigger = event.target instanceof Element ? event.target.closest('[data-order-open]') : null;
      if (!(trigger instanceof HTMLElement)) return;
      event.preventDefault();
      document.querySelectorAll('dialog[open]').forEach((open) => {
        if (open instanceof HTMLDialogElement) open.close();
      });
      fill(trigger);
      dialog.showModal();
    });

    quantity?.addEventListener('input', paintTotal);
    if (moreBtn instanceof HTMLButtonElement && extraWrap instanceof HTMLElement) {
      moreBtn.addEventListener('click', () => {
        extraWrap.hidden = !extraWrap.hidden;
        moreBtn.setAttribute('aria-expanded', extraWrap.hidden ? 'false' : 'true');
      });
    }
    const setRadioRequired = (on: boolean) => {
      const first = form.querySelector('[data-scale-group]:not([hidden]) input[name="weight"]');
      if (first instanceof HTMLInputElement) first.required = on;
    };
    form.addEventListener('change', (event) => {
      const target = event.target;
      if (target instanceof HTMLInputElement && target.name === 'weight') {
        if (extraSelect instanceof HTMLSelectElement) { extraSelect.value = ''; extraSelect.name = ''; extraSelect.required = false; }
        paintTotal();
      }
    });
    if (extraSelect instanceof HTMLSelectElement) {
      extraSelect.addEventListener('change', () => {
        const picked = Boolean(extraSelect.value);
        form.querySelectorAll('input[name="weight"]').forEach((input) => {
          if (input instanceof HTMLInputElement) input.checked = false;
        });
        extraSelect.name = picked ? 'weight' : '';
        extraSelect.required = picked;
        setRadioRequired(!picked);
        paintTotal();
      });
    }
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog || (event.target instanceof Element && event.target.closest('[data-order-close]'))) dialog.close();
    });
    form.addEventListener('submit', (event) => {
      const button = event instanceof SubmitEvent ? event.submitter : submit;
      if (!(button instanceof HTMLButtonElement) || button.value === 'apply') return;
      button.disabled = true;
      button.textContent = 'Đang gửi...';
    });
    // Quay lại bằng nút Back (bfcache) thì mở lại nút gửi.
    window.addEventListener('pageshow', () => {
      if (submit instanceof HTMLButtonElement) {
        submit.disabled = false;
        submit.textContent = 'Gửi đơn';
      }
    });
  }
</script>
