---
import type { PublicComboPricing } from '../../features/home-collections/combo-price';
import { ORDER_MAX_QUANTITY } from '../../features/orders/order';
import { addonShipHint, type PublicAddon } from '../../features/products/addons';
import { TAG_NAME_MAX } from '../../features/products/tag-name';
import { WEIGHT_SCALES, weightExtras } from '../../features/products/weight';
import { formatVnd } from '../../lib/money';
import { routes } from '../../lib/routes';
import AddonPicker from './AddonPicker.astro';
import AddressField from './AddressField.astro';
import DiscountCodeField from './DiscountCodeField.astro';
import PaymentField from './PaymentField.astro';
import QtyStepper from './QtyStepper.astro';

// Modal đặt hàng dùng chung cho cả trang. Nút [data-order-open] truyền sản phẩm vào modal;
// khi tắt JS, nút vẫn là link tới /dat-hang nên đặt hàng không bị chặn.
interface Props {
  addons?: PublicAddon[];
  /** Phí ship khách trả mặc định (từ chi phí đơn đang bật). */
  shipBaseFee?: number;
  /** Offer combo / bán kèm đang bật — client tính tạm; server vẫn tính lại khi gửi. */
  comboPricing?: PublicComboPricing;
}

const emptyPricing: PublicComboPricing = { comboBySlug: {}, addonBundles: [] };
const { addons = [], shipBaseFee = 0, comboPricing = emptyPricing } = Astro.props;
const shipFeeSafe = Number.isSafeInteger(shipBaseFee) && shipBaseFee > 0 ? shipBaseFee : 0;
const scaleGroups = Object.entries(WEIGHT_SCALES).filter(([, labels]) => labels.length > 0);
const babyExtras = weightExtras('baby');
const showAddons = addons.length > 0;
const addonHint = addonShipHint(0);
const pricingJson = JSON.stringify(comboPricing);
---

<dialog id="order-dialog" class="order-dialog" aria-labelledby="order-dialog-title">
  <button class="add-close order-dialog-close" type="button" data-order-close aria-label="Đóng">×</button>
  <form class="add-form order-dialog-form" method="post" action={routes.checkout} data-order-dialog-form>
    <div class="order-dialog-body">
      <div class="add-head">
        <p class="font-semibold">Đặt hàng</p>
      </div>
      <div class="order-summary">
        <img class="order-thumb" data-od-thumb alt="" width="64" height="64" hidden />
        <div class="min-w-0">
          <p id="order-dialog-title" class="font-semibold" data-od-title></p>
          <p class="font-semibold text-primary-strong" data-od-price></p>
        </div>
      </div>
      <div class="absolute -left-[9999px]" aria-hidden="true">
        <label for="od-company">Công ty</label>
        <input id="od-company" name="company" tabindex="-1" autocomplete="off" />
      </div>
      <input type="hidden" name="productSlug" data-od-slug />
      <fieldset class="mt-3" data-od-weight hidden>
        <legend class="text-sm font-semibold">Cân nặng của bé</legend>
        {
          scaleGroups.map(([scale, labels]) => (
            <div class="weight-grid mt-2" role="radiogroup" data-scale-group={scale} hidden>
              {labels.map((label) => (
                <label class="weight-chip">
                  <input type="radio" name="weight" value={label} disabled />
                  <span>{label}</span>
                </label>
              ))}
              {scale === 'baby' && (
                <button type="button" class="weight-chip weight-chip-more" data-weight-more aria-expanded="false" aria-label="Cân nặng khác">
                  <span aria-hidden="true">+</span>
                </button>
              )}
            </div>
          ))
        }
        <div class="weight-extra mt-2" data-weight-extra hidden>
          <select class="field" data-weight-extra-select aria-label="Chọn cân nặng lớn hơn">
            <option value="">Chọn cân nặng (16kg – 70kg)</option>
            {babyExtras.map((weight) => (
              <option value={weight} data-weight-value={weight}>{weight}</option>
            ))}
          </select>
        </div>
        <p class="weight-surcharge-note" data-weight-note hidden></p>
      </fieldset>
      <QtyStepper id="od-quantity" max={ORDER_MAX_QUANTITY} />
      <label class="mt-3 block text-sm font-semibold" for="od-tag" data-od-tag-wrap hidden>
        Tên cần in lên thẻ
        <input id="od-tag" class="field mt-1" name="tagName" maxlength={TAG_NAME_MAX} autocomplete="off" placeholder="Ví dụ: Minh An" data-od-tag disabled />
      </label>
      <PaymentField small />
      <label class="mt-3 block text-sm font-semibold" for="od-name">
        Họ tên
        <input id="od-name" class="field mt-1" name="customerName" required maxlength="80" autocomplete="name" />
      </label>
      <label class="mt-3 block text-sm font-semibold" for="od-phone">
        Số điện thoại
        <input id="od-phone" class="field mt-1" name="phone" type="tel" required maxlength="20" autocomplete="tel" />
      </label>
      <AddressField idPrefix="od" compact />
      <label class="mt-3 block text-sm font-semibold" for="od-note">
        Ghi chú
        <textarea id="od-note" class="field mt-1 min-h-16" name="note" maxlength="500"></textarea>
      </label>
      {
        showAddons && (
          <div class="order-dialog-addons" data-od-addons hidden>
            <AddonPicker addons={addons} hint={addonHint} idPrefix="od-addon" class="mt-3" />
          </div>
        )
      }
      <DiscountCodeField id="od-discount" />
      <script type="application/json" data-od-combo-pricing set:html={pricingJson} />
      <div class="cart-sum-stack" data-od-ship data-ship-base={shipFeeSafe} hidden>
        <ul class="cart-sum-lines" data-od-lines aria-label="Sản phẩm trong đơn"></ul>
        <div class="cart-sum">
          <span>Tạm tính</span>
          <strong data-od-goods>{formatVnd(0)}</strong>
        </div>
        <div class="cart-sum cart-sum-muted cart-sum-combo" data-od-combo-save hidden>
          <span>Giảm combo</span>
          <strong data-od-combo-save-amount>−{formatVnd(0)}</strong>
        </div>
        <div class="cart-sum cart-sum-muted">
          <span>Phí vận chuyển</span>
          <strong data-od-ship-fee>{shipFeeSafe > 0 ? formatVnd(shipFeeSafe) : '—'}</strong>
        </div>
        <div class="cart-sum">
          <span>Phải trả</span>
          <strong data-od-payable>{formatVnd(0)}</strong>
        </div>
      </div>
      <p class="cart-sum-note" data-od-ship-note hidden>Nhận hàng kiểm tra hàng thoải mái, ưng ý thì mới thanh toán.</p>
    </div>
    <div class="order-dialog-foot">
      <button class="btn btn-primary order-dialog-submit" type="submit">
        <span class="order-dialog-submit-label">
          <span class="order-dialog-submit-row">
            <span class="order-dialog-submit-title">Gửi đơn</span>
            <strong class="order-dialog-submit-price" data-od-total data-payable-amount="0">(—)</strong>
          </span>
          <span class="order-dialog-submit-note">(Nhận hàng được kiểm tra hàng)</span>
        </span>
      </button>
    </div>
  </form>
</dialog>
<script>
  // Chỉ import module thuần — không kéo addons.ts (DB/Drizzle) vào bundle client.
  import {
    addonUnitWithSlugBundles,
    catalogUnitWithOfferList,
    type PublicComboPricing,
  } from '../../features/home-collections/combo-price';
  import { addonShipHint, addonShipHintText } from '../../features/products/addon-hint';
  import { productRequiresTagName } from '../../features/products/tag-name';
  import { applyWeightPrice, weightOptionLabel, weightSurchargeLabel } from '../../features/products/weight';
  import { resolveCustomerShippingFee, type ShipGroup } from '../../features/shipping/customer-fee';

  const dialog = document.getElementById('order-dialog');
  const form = dialog?.querySelector('form[data-order-dialog-form]');
  if (dialog instanceof HTMLDialogElement && form instanceof HTMLFormElement) {
    const money = new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND', maximumFractionDigits: 0 });
    const title = form.querySelector('[data-od-title]');
    const priceText = form.querySelector('[data-od-price]');
    const total = form.querySelector('[data-od-total]');
    const thumb = form.querySelector('[data-od-thumb]');
    const slugField = form.querySelector('[data-od-slug]');
    const weightWrap = form.querySelector('[data-od-weight]');
    const moreBtn = form.querySelector('[data-weight-more]');
    const extraWrap = form.querySelector('[data-weight-extra]');
    const extraSelect = form.querySelector('[data-weight-extra-select]');
    const weightNote = form.querySelector('[data-weight-note]');
    const tagWrap = form.querySelector('[data-od-tag-wrap]');
    const tagField = form.querySelector('[data-od-tag]');
    const quantity = form.querySelector('#od-quantity');
    const addonsWrap = form.querySelector('[data-od-addons]');
    const addonHintEl = addonsWrap?.querySelector('.addon-picker-hint');
    const shipRoot = form.querySelector('[data-od-ship]');
    const shipNote = form.querySelector('[data-od-ship-note]');
    const submit = form.querySelector('button[type="submit"]:not([value="apply"])');
    const pricingNode = form.querySelector('[data-od-combo-pricing]');
    let comboPricing: PublicComboPricing = { comboBySlug: {}, addonBundles: [] };
    try {
      const raw = pricingNode?.textContent?.trim();
      if (raw) comboPricing = JSON.parse(raw) as PublicComboPricing;
    } catch {
      comboPricing = { comboBySlug: {}, addonBundles: [] };
    }
    let price = 0;
    let productSlug = '';
    let shipGroup: ShipGroup = 'bracelet';
    const shipBase = shipRoot instanceof HTMLElement ? Number(shipRoot.dataset.shipBase || '0') : 0;

    const selectedWeight = (): string => {
      const checked = form.querySelector('input[name="weight"]:checked');
      if (checked instanceof HTMLInputElement) return checked.value;
      if (extraSelect instanceof HTMLSelectElement && extraSelect.value) return extraSelect.value;
      return '';
    };

    const selectedAddons = (): { name: string; slug: string; catalogPrice: number; price: number }[] => {
      const rows: { name: string; slug: string; catalogPrice: number; price: number }[] = [];
      form.querySelectorAll('input[name="addonSlug"][data-addon-toggle]:checked').forEach((node) => {
        if (!(node instanceof HTMLInputElement)) return;
        const catalogPrice = Number(node.dataset.addonPrice || '0');
        if (!Number.isSafeInteger(catalogPrice) || catalogPrice < 0) return;
        const slug = node.value.trim();
        const sale = addonUnitWithSlugBundles(
          catalogPrice,
          slug,
          productSlug,
          comboPricing.addonBundles,
        );
        const card = node.closest('[data-addon-card]');
        const name = card instanceof HTMLElement ? card.dataset.addonName || 'Bán kèm' : 'Bán kèm';
        rows.push({ name, slug, catalogPrice, price: sale });
      });
      return rows;
    };

    const paintOrderLines = (mainName: string, qty: number, unit: number, addons: { name: string; price: number }[]) => {
      if (!(shipRoot instanceof HTMLElement)) return;
      const list = shipRoot.querySelector('[data-od-lines]');
      if (!(list instanceof HTMLElement)) return;
      const rows: HTMLLIElement[] = [];
      if (mainName && unit > 0 && qty >= 1) {
        const li = document.createElement('li');
        li.className = 'cart-sum-line';
        const text = document.createElement('span');
        text.className = 'cart-sum-line-text';
        const nameEl = document.createElement('span');
        nameEl.className = 'cart-sum-line-name';
        nameEl.textContent = mainName;
        text.append(nameEl);
        if (qty > 1) {
          const qtyEl = document.createElement('span');
          qtyEl.className = 'cart-sum-line-qty';
          qtyEl.textContent = `×${qty}`;
          text.append(qtyEl);
        }
        const priceEl = document.createElement('span');
        priceEl.className = 'cart-sum-line-price';
        priceEl.textContent = money.format(unit * qty);
        li.append(text, priceEl);
        rows.push(li);
      }
      for (const addon of addons) {
        const li = document.createElement('li');
        li.className = 'cart-sum-line is-addon';
        const text = document.createElement('span');
        text.className = 'cart-sum-line-text';
        const nameEl = document.createElement('span');
        nameEl.className = 'cart-sum-line-name';
        nameEl.textContent = addon.name;
        text.append(nameEl);
        const priceEl = document.createElement('span');
        priceEl.className = 'cart-sum-line-price';
        priceEl.textContent = money.format(addon.price);
        li.append(text, priceEl);
        rows.push(li);
      }
      list.replaceChildren(...rows);
    };

    /** Badge free / with-addon = vòng; còn lại (bạc / bán kèm / khác) không miễn theo rule vòng. */
    const shipGroupFromBadge = (badge: string): ShipGroup =>
      badge === 'free' || badge === 'with-addon' ? 'bracelet' : 'other';

    const paintAddonToggle = (input: HTMLInputElement) => {
      const card = input.closest('[data-addon-card]');
      const button = card?.querySelector('[data-addon-confirm-open]');
      const mark = button?.querySelector('span[aria-hidden="true"]');
      if (mark) mark.textContent = input.checked ? '✓' : '+';
      button?.classList.toggle('is-added', input.checked);
      if (button instanceof HTMLButtonElement) {
        button.setAttribute('aria-pressed', input.checked ? 'true' : 'false');
        const name = card instanceof HTMLElement ? card.dataset.addonName || 'Bó dâu' : 'Bó dâu';
        button.setAttribute(
          'aria-label',
          input.checked ? `${name} đã chọn — bấm để bỏ` : `Thêm ${name}`,
        );
        button.title = input.checked ? 'Đã chọn — bấm để bỏ' : 'Thêm bán kèm';
      }
      card?.classList.toggle('is-selected', input.checked);
    };

    const resetAddons = () => {
      form.querySelectorAll<HTMLInputElement>('input[name="addonSlug"][data-addon-toggle]').forEach((input) => {
        input.checked = false;
        paintAddonToggle(input);
      });
    };

    const selectAddonBySlug = (slug: string) => {
      const value = slug.trim();
      if (!value) return false;
      const input = form.querySelector(
        `input[name="addonSlug"][value="${CSS.escape(value)}"][data-addon-toggle]`,
      );
      if (!(input instanceof HTMLInputElement)) return false;
      input.checked = true;
      paintAddonToggle(input);
      return true;
    };

    const paintTotal = () => {
      if (!(total instanceof HTMLElement) || !(quantity instanceof HTMLInputElement)) return;
      const weight = selectedWeight();
      const count = Number(quantity.value);
      const valid = Number.isInteger(count) && count >= 1;
      const qty = valid ? count : 1;
      const comboOffers = productSlug ? comboPricing.comboBySlug[productSlug] : undefined;
      const saleBase =
        price > 0 ? catalogUnitWithOfferList(price, valid ? count : 1, comboOffers) : 0;
      const unit = saleBase > 0 ? applyWeightPrice(saleBase, weight) : 0;
      const catalogUnit = price > 0 ? applyWeightPrice(price, weight) : 0;
      const mainGoods = valid ? unit * count : 0;
      const catalogMain = valid ? catalogUnit * count : 0;
      const addonsPicked = selectedAddons();
      const addonGoods = addonsPicked.reduce((sum, item) => sum + item.price, 0);
      const addonCatalog = addonsPicked.reduce((sum, item) => sum + item.catalogPrice, 0);
      const goods = mainGoods + addonGoods;
      const catalogGoods = catalogMain + addonCatalog;
      const comboSave = Math.max(0, catalogGoods - goods);
      const shipping = resolveCustomerShippingFee({
        lines: [
          { group: shipGroup, lineTotal: mainGoods },
          ...addonsPicked.map((item) => ({ group: 'addon' as const, lineTotal: item.price })),
        ],
        baseFee: shipBase,
      });
      const payable = goods + shipping.fee;
      total.textContent = valid ? `(${money.format(payable)})` : '(—)';
      total.dataset.payableAmount = valid ? String(payable) : '0';
      if (priceText instanceof HTMLElement && unit > 0) {
        priceText.textContent =
          saleBase < price && valid
            ? `${money.format(unit)}/chiếc · Combo ×${qty}`
            : money.format(unit);
      }
      const surcharge = weightSurchargeLabel(weight, saleBase > 0 ? saleBase : price);
      if (weightNote instanceof HTMLElement) {
        weightNote.hidden = !(surcharge && unit > 0);
        weightNote.textContent = surcharge && unit > 0 ? `Vòng lớn hơn, cộng ${surcharge} nguyên liệu → ${money.format(unit)}/chiếc` : '';
      }
      if (addonHintEl && addonsWrap instanceof HTMLElement && !addonsWrap.hidden) {
        addonHintEl.textContent = addonShipHintText(addonShipHint(mainGoods));
      }
      if (shipRoot instanceof HTMLElement) {
        shipRoot.hidden = !valid;
        if (shipNote instanceof HTMLElement) shipNote.hidden = !valid;
        const goodsOut = shipRoot.querySelector('[data-od-goods]');
        if (goodsOut) goodsOut.textContent = money.format(comboSave > 0 ? catalogGoods : goods);
        const comboRow = shipRoot.querySelector('[data-od-combo-save]');
        const comboAmount = shipRoot.querySelector('[data-od-combo-save-amount]');
        if (comboRow instanceof HTMLElement) comboRow.hidden = !(valid && comboSave > 0);
        if (comboAmount) comboAmount.textContent = `−${money.format(comboSave)}`;
        const shipFeeOut = shipRoot.querySelector('[data-od-ship-fee]');
        if (shipFeeOut) shipFeeOut.textContent = shipping.free ? 'Miễn phí' : money.format(shipping.fee);
        const payableOut = shipRoot.querySelector('[data-od-payable]');
        if (payableOut) payableOut.textContent = money.format(payable);
        const mainName = title instanceof HTMLElement ? title.textContent?.trim() || '' : '';
        paintOrderLines(mainName, valid ? count : 0, unit, addonsPicked);
      }
    };

    // Chỉ nhóm cân nặng đúng thang của sản phẩm được bật và gửi đi; thang 'none' thì ẩn hẳn.
    const showScale = (scale: string) => {
      let found = false;
      form.querySelectorAll<HTMLElement>('[data-scale-group]').forEach((group) => {
        const active = group.dataset.scaleGroup === scale;
        found ||= active;
        group.hidden = !active;
        group.querySelectorAll('input').forEach((input, index) => {
          input.disabled = !active;
          input.checked = false;
          input.required = active && index === 0;
        });
      });
      // Dropdown "cân nặng khác" chỉ dùng cho thang baby; reset mỗi lần đổi sản phẩm.
      const showExtra = scale === 'baby';
      if (extraWrap instanceof HTMLElement) extraWrap.hidden = true;
      if (moreBtn instanceof HTMLElement) {
        moreBtn.hidden = !showExtra;
        moreBtn.setAttribute('aria-expanded', 'false');
      }
      if (extraSelect instanceof HTMLSelectElement) {
        extraSelect.value = '';
        extraSelect.name = '';
        extraSelect.required = false;
        extraSelect.disabled = !showExtra;
      }
      if (weightNote instanceof HTMLElement) {
        weightNote.hidden = true;
        weightNote.textContent = '';
      }
      if (weightWrap instanceof HTMLElement) weightWrap.hidden = !found;
    };

    const fill = (trigger: HTMLElement) => {
      price = Number(trigger.dataset.price) || 0;
      productSlug = (trigger.dataset.slug ?? '').trim();
      if (title) title.textContent = trigger.dataset.name ?? '';
      if (priceText) priceText.textContent = money.format(price);
      if (slugField instanceof HTMLInputElement) slugField.value = productSlug;
      if (thumb instanceof HTMLImageElement) {
        const cover = trigger.dataset.cover ?? '';
        thumb.hidden = !cover;
        thumb.src = cover;
        thumb.alt = trigger.dataset.name ?? '';
      }
      if (quantity instanceof HTMLInputElement) {
        const max = Number(quantity.max) || 20;
        const wanted = Number(trigger.dataset.quantity);
        quantity.value = String(
          Number.isInteger(wanted) && wanted >= 1 ? Math.min(max, wanted) : 1,
        );
      }
      // Nhãn "(giá tăng X%)" phụ thuộc giá sản phẩm hiện tại nên cập nhật khi mở modal.
      if (extraSelect instanceof HTMLSelectElement) {
        extraSelect.querySelectorAll('option[data-weight-value]').forEach((opt) => {
          if (opt instanceof HTMLOptionElement) opt.textContent = weightOptionLabel(opt.dataset.weightValue ?? '', price);
        });
      }
      showScale(trigger.dataset.scale ?? 'none');
      const needsTag = productRequiresTagName(trigger.dataset.name ?? '');
      if (tagWrap instanceof HTMLElement) tagWrap.hidden = !needsTag;
      if (tagField instanceof HTMLInputElement) {
        tagField.disabled = !needsTag;
        tagField.required = needsTag;
        tagField.value = '';
      }
      // Badge free / with-addon chỉ gắn vòng → hiện bán kèm; bạc/bó riêng thì ẩn.
      // Combo trang chủ có thể truyền data-addon-slug để gắn sẵn sản phẩm phụ.
      const shipBadge = trigger.dataset.shipBadge ?? 'none';
      const preselectAddon = (trigger.dataset.addonSlug ?? '').trim();
      shipGroup = shipGroupFromBadge(shipBadge);
      const allowAddons = shipBadge === 'free' || shipBadge === 'with-addon' || Boolean(preselectAddon);
      if (addonsWrap instanceof HTMLElement) {
        addonsWrap.hidden = !allowAddons;
        resetAddons();
        if (allowAddons && preselectAddon) selectAddonBySlug(preselectAddon);
        if (addonHintEl) addonHintEl.textContent = addonShipHintText(addonShipHint(price));
      }
      paintTotal();
    };

    document.addEventListener('click', (event) => {
      if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      const trigger = event.target instanceof Element ? event.target.closest('[data-order-open]') : null;
      if (!(trigger instanceof HTMLElement)) return;
      event.preventDefault();
      document.querySelectorAll('dialog[open]').forEach((open) => {
        if (open instanceof HTMLDialogElement) open.close();
      });
      fill(trigger);
      dialog.showModal();
    });

    quantity?.addEventListener('input', paintTotal);
    form.addEventListener('addon-change', paintTotal);
    if (moreBtn instanceof HTMLButtonElement && extraWrap instanceof HTMLElement) {
      moreBtn.addEventListener('click', () => {
        extraWrap.hidden = !extraWrap.hidden;
        moreBtn.setAttribute('aria-expanded', extraWrap.hidden ? 'false' : 'true');
      });
    }
    const setRadioRequired = (on: boolean) => {
      const first = form.querySelector('[data-scale-group]:not([hidden]) input[name="weight"]');
      if (first instanceof HTMLInputElement) first.required = on;
    };
    form.addEventListener('change', (event) => {
      const target = event.target;
      if (target instanceof HTMLInputElement && target.name === 'weight') {
        if (extraSelect instanceof HTMLSelectElement) { extraSelect.value = ''; extraSelect.name = ''; extraSelect.required = false; }
        paintTotal();
      }
    });
    if (extraSelect instanceof HTMLSelectElement) {
      extraSelect.addEventListener('change', () => {
        const picked = Boolean(extraSelect.value);
        form.querySelectorAll('input[name="weight"]').forEach((input) => {
          if (input instanceof HTMLInputElement) input.checked = false;
        });
        extraSelect.name = picked ? 'weight' : '';
        extraSelect.required = picked;
        setRadioRequired(!picked);
        paintTotal();
      });
    }
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog || (event.target instanceof Element && event.target.closest('[data-order-close]'))) dialog.close();
    });
    const paintSubmitLabel = (label: string) => {
      if (!(submit instanceof HTMLButtonElement)) return;
      const title = submit.querySelector('.order-dialog-submit-title');
      if (title) title.textContent = label;
      else submit.textContent = label;
    };
    form.addEventListener('submit', (event) => {
      const button = event instanceof SubmitEvent ? event.submitter : submit;
      if (!(button instanceof HTMLButtonElement) || button.value === 'apply') return;
      button.disabled = true;
      paintSubmitLabel('Đang gửi...');
    });
    // Quay lại bằng nút Back (bfcache) thì mở lại nút gửi.
    window.addEventListener('pageshow', () => {
      if (submit instanceof HTMLButtonElement) {
        submit.disabled = false;
        paintSubmitLabel('Gửi đơn');
      }
    });
  }
</script>
