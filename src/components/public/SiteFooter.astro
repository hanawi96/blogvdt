---
import type { PublicSite } from '../../features/settings/settings';
import { routes } from '../../lib/routes';

interface Props {
  // Giữ để nơi gọi truyền site như trước; footer hiện không đọc trường nào từ đây.
  site?: PublicSite;
}

const brandName = 'Vòng dâu tằm by Ánh';
const brandLead =
  'Mỗi chiếc vòng được làm thủ công tỉ mỉ, gửi gắm yêu thương và mong ước tốt đẹp nhất đến bé yêu của mẹ';
const phoneDisplay = '0972.483.892';
const phoneHref = '0972483892';
const email = 'vongdautambyvui@gmail.com';
const address = 'Thôn Đông Cao, Mê Linh, Hà Nội';
const year = new Date().getFullYear();
const about = [
  [routes.about, 'Giới thiệu'],
  ['/#quy-trinh', 'Quy trình thủ công'],
  ['/#faq', 'Câu hỏi thường gặp'],
  [routes.terms, 'Điều khoản và dịch vụ'],
] as const;
const help = [
  [routes.policyShipping, 'Chính sách vận chuyển'],
  [routes.policyPayment, 'Chính sách thanh toán'],
  [routes.policyReturn, 'Chính sách đổi trả'],
  [routes.policyPrivacy, 'Chính sách bảo mật'],
] as const;
const heart = 'M12 20.5s-7.5-4.6-7.5-10.2A4.3 4.3 0 0 1 12 7.6a4.3 4.3 0 0 1 7.5 2.7c0 5.6-7.5 10.2-7.5 10.2z';
const social = [
  {
    label: 'Facebook',
    href: 'https://www.facebook.com/vongdautambyvui',
    path: 'M14 8h2.5V4.5H14A3.5 3.5 0 0 0 10.5 8v2.5H8V14h2.5v6.5H14V14h2.5l.5-3.5h-3V8.5a.5.5 0 0 1 .5-.5z',
  },
  {
    label: 'Instagram',
    href: 'https://www.instagram.com/vongdautambyvui',
    path: 'M8.5 4.5h7A3.5 3.5 0 0 1 19 8v7a3.5 3.5 0 0 1-3.5 3.5h-7A3.5 3.5 0 0 1 5 15V8A3.5 3.5 0 0 1 8.5 4.5zM12 9.2A2.8 2.8 0 1 0 12 14.8 2.8 2.8 0 0 0 12 9.2zM16.2 7.6h.01',
  },
  {
    label: 'TikTok',
    href: 'https://www.tiktok.com/@vongdautambyanh',
    path: 'M14.5 5.5c.7 1.6 2 2.7 3.7 3.1v2.4c-1.3-.1-2.5-.6-3.5-1.4v5.3a4.6 4.6 0 1 1-4.6-4.6c.3 0 .6 0 .9.1v2.5a2.1 2.1 0 1 0 1.5 2V5.5h2z',
  },
  {
    label: 'YouTube',
    href: 'https://www.youtube.com/@vongdautambyvuinguyen',
    path: 'M10 9.2v5.6l4.8-2.8L10 9.2zM5.5 8.2c0-1.5 1.2-2.7 2.7-2.7h7.6c1.5 0 2.7 1.2 2.7 2.7v7.6c0 1.5-1.2 2.7-2.7 2.7H8.2c-1.5 0-2.7-1.2-2.7-2.7V8.2z',
  },
] as const;
---

<footer class="site-footer">
  <div class="site-footer-inner">
    <div class="site-footer-grid">
      <div class="site-footer-brand">
        <p class="site-footer-name">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path class="is-filled" d={heart} /></svg>
          <span>{brandName}</span>
        </p>
        <p class="site-footer-lead">{brandLead}</p>
        <div class="site-footer-social">
          {social.map((item) => (
            <a href={item.href} aria-label={item.label} rel="noopener" target="_blank">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d={item.path} /></svg>
            </a>
          ))}
        </div>
      </div>

      <nav class="site-footer-col" aria-labelledby="footer-about">
        <p class="site-footer-label" id="footer-about">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="7.5" /><path d="M12 8.5v.01M12 11v4.5" /></svg>
          Về chúng tôi
        </p>
        <ul>
          {about.map(([href, label]) => (
            <li><a href={href}>{label}</a></li>
          ))}
        </ul>
      </nav>

      <nav class="site-footer-col" aria-labelledby="footer-help">
        <p class="site-footer-label" id="footer-help">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 14.5v-3.2A7 7 0 0 1 12 4.5a7 7 0 0 1 7 6.8v3.2M9 18.5a3 3 0 0 0 6 0" /><path d="M5 12.8h1.4A1.3 1.3 0 0 1 7.7 14v1.2A1.3 1.3 0 0 1 6.4 16.5H5v-3.7zM19 12.8h-1.4a1.3 1.3 0 0 0-1.3 1.2v1.2a1.3 1.3 0 0 0 1.3 1.3H19v-3.7z" /></svg>
          Hỗ trợ mẹ
        </p>
        <ul>
          {help.map(([href, label]) => (
            <li><a href={href}>{label}</a></li>
          ))}
        </ul>
      </nav>

      <div class="site-footer-col">
        <p class="site-footer-label">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.6 4.5h2.6l1.3 3.6-1.8 1.2a10 10 0 0 0 6 6l1.2-1.8 3.6 1.3v2.6a1.8 1.8 0 0 1-2 1.8A15 15 0 0 1 4.8 6.5a1.8 1.8 0 0 1 1.8-2z" /></svg>
          Liên hệ
        </p>
        <ul class="site-footer-contact">
          <li><a href={`tel:${phoneHref}`}>{phoneDisplay}</a></li>
          <li><a href={`mailto:${email}`}>{email}</a></li>
          <li><span>{address}</span></li>
        </ul>
      </div>
    </div>

    <div class="site-footer-divider" aria-hidden="true">
      <svg viewBox="0 0 24 24"><path class="is-filled" d={heart} /></svg>
    </div>
    <p class="site-footer-love">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path class="is-filled" d={heart} /></svg>
      Làm bằng tình yêu thương dành cho bé yêu
      <svg viewBox="0 0 24 24" aria-hidden="true"><path class="is-filled" d={heart} /></svg>
    </p>
    <p class="site-footer-copy">© {year} {brandName}. Tất cả quyền được bảo lưu.</p>
  </div>
</footer>
