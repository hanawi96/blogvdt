---
import { POLICIES } from '../../features/content/policies';
import type { PublicSite } from '../../features/settings/settings';
import { routes } from '../../lib/routes';
import LeafSprig from './LeafSprig.astro';

interface Props {
  site: PublicSite;
}

const { site } = Astro.props;
const phoneHref = site.phone.replace(/[^\d+]/g, '');
const year = new Date().getFullYear();
const about = [
  [routes.homeAbout, 'Giới thiệu'],
  [routes.knowledgeList, 'Bài viết cho mẹ'],
  [routes.catalog, 'Mẫu vòng dâu tằm'],
] as const;
const heart = 'M12 20.5s-7.5-4.6-7.5-10.2A4.3 4.3 0 0 1 12 7.6a4.3 4.3 0 0 1 7.5 2.7c0 5.6-7.5 10.2-7.5 10.2z';
---

<footer id="lien-he" class="site-footer">
  <div class="site-footer-inner">
    <div class="site-footer-grid">
      <div class="site-footer-brand">
        <p class="site-footer-name">
          {site.logoUrl ? <img src={site.logoUrl} alt="" width="32" height="32" /> : <LeafSprig />}
          <span>{site.siteName}</span>
        </p>
        {site.siteDescription && <p class="site-footer-lead">{site.siteDescription}</p>}
        {(site.facebookUrl || site.zaloUrl) && (
          <div class="site-footer-social">
            {site.facebookUrl && (
              <a href={site.facebookUrl} aria-label="Facebook" rel="noopener" target="_blank">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 8h2.5V4.5H14A3.5 3.5 0 0 0 10.5 8v2.5H8V14h2.5v6.5H14V14h2.5l.5-3.5h-3V8.5a.5.5 0 0 1 .5-.5z" /></svg>
              </a>
            )}
            {site.zaloUrl && (
              <a href={site.zaloUrl} aria-label="Zalo" rel="noopener" target="_blank">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4.5c-4.7 0-8.5 3.1-8.5 7 0 2.2 1.2 4.1 3.1 5.4L6 19.5l3.2-1.6c.9.2 1.8.4 2.8.4 4.7 0 8.5-3.1 8.5-7s-3.8-6.8-8.5-6.8z" /><path d="M8.5 10h3l-3 3.5h3M13.5 10v3.5M15.5 10v3.5h1.5" /></svg>
              </a>
            )}
          </div>
        )}
      </div>

      <nav class="site-footer-col" aria-labelledby="footer-about">
        <p class="site-footer-label" id="footer-about">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="7.5" /><path d="M12 8.5v.01M12 11v4.5" /></svg>
          Về chúng tôi
        </p>
        <ul>
          {about.map(([href, label]) => (
            <li><a href={href}>{label}</a></li>
          ))}
        </ul>
      </nav>

      <nav class="site-footer-col" aria-labelledby="footer-help">
        <p class="site-footer-label" id="footer-help">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path class="is-filled" d={heart} /></svg>
          Hỗ trợ mẹ
        </p>
        <ul>
          {POLICIES.map((policy) => (
            <li><a href={routes.policy(policy.slug)}>Chính sách {policy.title.toLowerCase()}</a></li>
          ))}
        </ul>
      </nav>

      <div class="site-footer-col">
        <p class="site-footer-label">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.6 4.5h2.6l1.3 3.6-1.8 1.2a10 10 0 0 0 6 6l1.2-1.8 3.6 1.3v2.6a1.8 1.8 0 0 1-2 1.8A15 15 0 0 1 4.8 6.5a1.8 1.8 0 0 1 1.8-2z" /></svg>
          Liên hệ
        </p>
        <ul class="site-footer-contact">
          {phoneHref && (
            <li>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.6 4.5h2.6l1.3 3.6-1.8 1.2a10 10 0 0 0 6 6l1.2-1.8 3.6 1.3v2.6a1.8 1.8 0 0 1-2 1.8A15 15 0 0 1 4.8 6.5a1.8 1.8 0 0 1 1.8-2z" /></svg>
              <a href={`tel:${phoneHref}`}>{site.phone}</a>
            </li>
          )}
          {site.contactInfo && (
            <li>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20.5s6-5.4 6-10.5a6 6 0 0 0-12 0c0 5.1 6 10.5 6 10.5z" /><circle cx="12" cy="10" r="2.2" /></svg>
              <span>{site.contactInfo}</span>
            </li>
          )}
        </ul>
      </div>
    </div>

    <div class="site-footer-divider" aria-hidden="true">
      <svg viewBox="0 0 24 24"><path class="is-filled" d={heart} /></svg>
    </div>
    <p class="site-footer-love">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path class="is-filled" d={heart} /></svg>
      Làm bằng tình yêu thương dành cho bé yêu
      <svg viewBox="0 0 24 24" aria-hidden="true"><path class="is-filled" d={heart} /></svg>
    </p>
    <p class="site-footer-copy">© {year} {site.siteName}. Tất cả quyền được bảo lưu.</p>
  </div>
</footer>
