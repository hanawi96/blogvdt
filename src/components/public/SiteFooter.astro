---
import { POLICIES } from '../../features/content/policies';
import type { PublicSite } from '../../features/settings/settings';
import { routes } from '../../lib/routes';

interface Props {
  site: PublicSite;
}

const { site } = Astro.props;
const phoneHref = site.phone.replace(/[^\d+]/g, '');
---

<footer id="lien-he" class="mt-16 border-t border-line bg-surface">
  <div class="mx-auto grid w-full max-w-5xl gap-8 px-4 py-10 sm:grid-cols-3">
    <div>
      <p class="font-semibold">{site.siteName}</p>
      {site.contactInfo && <p class="mt-2 text-muted">{site.contactInfo}</p>}
      {
        phoneHref && (
          <p class="mt-2">
            <a href={`tel:${phoneHref}`}>{site.phone}</a>
          </p>
        )
      }
      <div class="mt-3 flex flex-wrap gap-3">
        {site.facebookUrl && <a href={site.facebookUrl}>Facebook</a>}
        {site.zaloUrl && <a href={site.zaloUrl}>Zalo</a>}
      </div>
    </div>
    <div>
      <p class="font-semibold">Kiến thức</p>
      <p class="mt-2"><a href={routes.knowledgeList}>Bài viết</a></p>
      <p class="mt-2"><a href={routes.catalog}>Mẫu vòng</a></p>
    </div>
    <div>
      <p class="font-semibold">Chính sách</p>
      <ul class="mt-2 space-y-2">
        {POLICIES.map((policy) => <li><a href={routes.policy(policy.slug)}>{policy.title}</a></li>)}
      </ul>
    </div>
  </div>
</footer>
