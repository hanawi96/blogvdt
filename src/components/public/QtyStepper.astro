---
interface Props {
  id?: string;
  name?: string;
  min?: number;
  max: number;
  value?: number;
  hint?: string | null;
  class?: string;
}

const { id, name = 'quantity', min = 1, max, value, hint = null, class: className } = Astro.props;
const labelId = id ? `${id}-label` : undefined;
const safeMin = Number.isInteger(min) && min >= 1 ? min : 1;
const safeMax = Number.isInteger(max) && max >= safeMin ? max : safeMin;
const initial = value != null && Number.isInteger(value) ? Math.min(safeMax, Math.max(safeMin, value)) : safeMin;
---

<div class:list={['qty-stepper', className]} data-qty-stepper>
  <p class="qty-stepper-label" id={labelId}>Số lượng</p>
  <div class="qty-stepper-row" role="group" aria-labelledby={labelId}>
    <button class="qty-stepper-btn" type="button" data-qty-dec aria-label="Giảm số lượng">−</button>
    <input
      id={id}
      class="qty-stepper-input field"
      name={name}
      type="number"
      inputmode="numeric"
      min={safeMin}
      max={safeMax}
      value={initial}
      required
      data-qty-input
      aria-label="Số lượng"
    />
    <button class="qty-stepper-btn" type="button" data-qty-inc aria-label="Tăng số lượng">+</button>
  </div>
  {hint && <p class="qty-stepper-hint">{hint}</p>}
</div>
