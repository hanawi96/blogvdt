---
interface Props {
  page: number;
  pageCount: number;
  hrefFor: (page: number) => string;
}

const { page, pageCount, hrefFor } = Astro.props;

// Dải trang gọn quanh trang hiện tại; thêm trang đầu/cuối khi cần (tránh in cả trăm nút).
function pageWindow(current: number, total: number): (number | 'gap')[] {
  if (total <= 7) return Array.from({ length: total }, (_, index) => index + 1);
  const pages = new Set<number>([1, total, current, current - 1, current + 1]);
  const sorted = [...pages].filter((value) => value >= 1 && value <= total).sort((a, b) => a - b);
  const out: (number | 'gap')[] = [];
  let previous = 0;
  for (const value of sorted) {
    if (previous && value - previous > 1) out.push('gap');
    out.push(value);
    previous = value;
  }
  return out;
}

const items = pageWindow(page, pageCount);
---

{
  pageCount > 1 && (
    <nav class="pager" aria-label="Phân trang">
      <a class:list={['pager-arrow', page <= 1 && 'is-disabled']} href={page > 1 ? hrefFor(page - 1) : undefined} aria-label="Trang trước" aria-disabled={page <= 1 ? 'true' : undefined}>
        ‹
      </a>
      {items.map((item) =>
        item === 'gap' ? (
          <span class="pager-gap" aria-hidden="true">…</span>
        ) : item === page ? (
          <span class="pager-num is-active" aria-current="page">{item}</span>
        ) : (
          <a class="pager-num" href={hrefFor(item)} aria-label={`Trang ${item}`}>{item}</a>
        ),
      )}
      <a class:list={['pager-arrow', page >= pageCount && 'is-disabled']} href={page < pageCount ? hrefFor(page + 1) : undefined} aria-label="Trang sau" aria-disabled={page >= pageCount ? 'true' : undefined}>
        ›
      </a>
    </nav>
  )
}
