---
import { formatVnd } from '../../lib/money';
import { routes } from '../../lib/routes';
import { CART_MAX_QUANTITY } from '../../features/cart/cart';
import { requiresWeight, weightChips, weightExtras, weightOptionLabel, type WeightScale } from '../../features/products/weight';
import type { ProductShipBadge } from '../../features/shipping/customer-fee';
import FreeShipBadge from './FreeShipBadge.astro';
import ProductSalesBadge from './ProductSalesBadge.astro';
import QtyStepper from './QtyStepper.astro';

interface Props {
  product: {
    id: number;
    name: string;
    slug: string;
    price: number;
    comparePrice: number | null;
    weightScale: WeightScale;
    shipBadge?: ProductShipBadge;
    ratingLabel?: string | null;
    sold?: number;
    coverUrl: string | null;
    coverAlt: string;
    coverWidth: number | null;
    coverHeight: number | null;
  };
  eager?: boolean;
}

const { product, eager = false } = Astro.props;
const href = routes.product(product.slug);
const orderHref = `${routes.checkout}?san-pham=${encodeURIComponent(product.slug)}`;
const alt = product.coverAlt || product.name;
const addId = `add-${product.id}`;
const addTitleId = `add-title-${product.id}`;
const needsWeight = requiresWeight(product.weightScale);
const chips = needsWeight ? weightChips(product.weightScale) : [];
const extras = needsWeight ? weightExtras(product.weightScale) : [];
// Dữ liệu cho modal đặt hàng dùng chung (OrderDialog); thiếu JS thì vẫn là link /dat-hang.
const orderAttrs = {
  'data-order-open': '',
  'data-slug': product.slug,
  'data-name': product.name,
  'data-price': String(product.price),
  'data-scale': product.weightScale,
  'data-cover': product.coverUrl ?? '',
};
---

<article class="overflow-hidden rounded-lg border border-line bg-surface">
  <a class="catalog-card-media" href={href}>
    {
      product.coverUrl ? (
        <img
          src={product.coverUrl}
          alt={alt}
          width={product.coverWidth ?? undefined}
          height={product.coverHeight ?? undefined}
          loading={eager ? 'eager' : 'lazy'}
          fetchpriority={eager ? 'high' : undefined}
          class="aspect-square w-full object-cover"
        />
      ) : (
        <span class="block aspect-square bg-canvas" aria-hidden="true"></span>
      )
    }
    <ProductSalesBadge ratingLabel={product.ratingLabel ?? null} sold={product.sold ?? 0} />
  </a>
  <div class="p-3">
    <h2 class="text-base font-semibold"><a href={href}>{product.name}</a></h2>
    <p class="product-price">
      <span class="font-semibold text-primary-strong">{formatVnd(product.price)}</span>
      {product.comparePrice != null && <span class="product-compare">{formatVnd(product.comparePrice)}</span>}
    </p>
    {product.shipBadge && product.shipBadge !== 'none' && <FreeShipBadge variant={product.shipBadge} />}
    <div class="catalog-card-actions">
      {
        needsWeight ? (
          <button class="btn" type="button" data-add-open aria-haspopup="dialog" aria-controls={addId}>Thêm giỏ</button>
        ) : (
          <form method="post" action={routes.cart} data-cart-form>
            <input type="hidden" name="intent" value="add" />
            <input type="hidden" name="slug" value={product.slug} />
            <input type="hidden" name="weight" value="" />
            <input type="hidden" name="quantity" value="1" />
            <input type="hidden" name="price" value={product.price} />
            <button class="btn" type="submit">Thêm giỏ</button>
          </form>
        )
      }
      <a class="btn btn-primary" href={orderHref} {...orderAttrs}>Đặt hàng</a>
    </div>
  </div>
  {
    needsWeight && (
      <dialog id={addId} class="add-dialog" aria-labelledby={addTitleId}>
        <form class="add-form" method="post" action={routes.cart} data-cart-form data-requires-weight="true">
          <div class="add-head">
            <p id={addTitleId} class="font-semibold">{product.name}</p>
            <button class="add-close" type="button" data-add-close aria-label="Đóng">×</button>
          </div>
          <p class="font-semibold text-primary-strong" data-add-price>{formatVnd(product.price)}</p>
          <input type="hidden" name="intent" value="add" />
          <input type="hidden" name="slug" value={product.slug} />
          <input type="hidden" name="price" value={product.price} />
          <fieldset class="mt-3" data-weight-field data-base-price={product.price}>
            <legend class="text-sm font-semibold">Cân nặng của bé</legend>
            <div class="weight-grid mt-2" role="radiogroup">
              {chips.map((weight, index) => (
                <label class="weight-chip">
                  <input type="radio" name="weight" value={weight} required={index === 0} />
                  <span>{weight}</span>
                </label>
              ))}
              <button type="button" class="weight-chip weight-chip-more" data-weight-more aria-expanded="false" aria-label="Cân nặng khác">
                <span aria-hidden="true">+</span>
              </button>
            </div>
            <div class="weight-extra mt-2" data-weight-extra hidden>
              <select class="field" data-weight-extra-select aria-label="Chọn cân nặng lớn hơn">
                <option value="">Chọn cân nặng (16kg – 70kg)</option>
                {extras.map((weight) => (
                  <option value={weight}>{weightOptionLabel(weight, product.price)}</option>
                ))}
              </select>
            </div>
            <p class="weight-surcharge-note" data-weight-note hidden></p>
          </fieldset>
          <QtyStepper max={CART_MAX_QUANTITY} />
          <p class="add-error error-text mt-2" role="alert" hidden></p>
          <button class="btn btn-primary mt-4 w-full" type="submit">Thêm giỏ</button>
        </form>
      </dialog>
    )
  }
</article>
