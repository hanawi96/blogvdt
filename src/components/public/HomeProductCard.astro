---
import { CART_MAX_QUANTITY } from '../../features/cart/cart';
import { audienceCardLabel } from '../../features/products/audience';
import { discountPercent } from '../../features/products/catalog';
import { cordCardLabel } from '../../features/products/cord';
import { productRequiresTagName, TAG_NAME_MAX } from '../../features/products/tag-name';
import { requiresWeight, weightChips, weightExtras, weightOptionLabel, type WeightScale } from '../../features/products/weight';
import type { ProductShipBadge } from '../../features/shipping/customer-fee';
import { formatVnd } from '../../lib/money';
import { routes } from '../../lib/routes';
import FreeShipBadge from './FreeShipBadge.astro';
import InspectGoodsBadge from './InspectGoodsBadge.astro';
import ProductSalesBadge from './ProductSalesBadge.astro';
import QtyStepper from './QtyStepper.astro';
import WeightFitHint from './WeightFitHint.astro';

interface Props {
  product: {
    id: number;
    name: string;
    slug: string;
    price: number;
    comparePrice: number | null;
    cordType?: string;
    audience?: string;
    weightScale: WeightScale;
    shipBadge?: ProductShipBadge;
    ratingLabel?: string | null;
    sold?: number;
    coverUrl: string | null;
    coverAlt: string;
    coverWidth: number | null;
    coverHeight: number | null;
  };
  eager?: boolean;
}

const { product, eager = false } = Astro.props;
const href = routes.product(product.slug);
const orderHref = `${routes.checkout}?san-pham=${encodeURIComponent(product.slug)}`;
const cordLabel = cordCardLabel(product.cordType);
const audienceLabel = audienceCardLabel(product.audience);
const needsWeight = requiresWeight(product.weightScale);
const needsTag = productRequiresTagName(product.name);
const needsDialog = needsWeight || needsTag;
const chips = needsWeight ? weightChips(product.weightScale) : [];
const extras = needsWeight ? weightExtras(product.weightScale) : [];
const off = discountPercent(product.price, product.comparePrice);
const addId = `home-add-${product.id}`;
const addTitleId = `home-add-title-${product.id}`;
const orderAttrs = {
  'data-order-open': '',
  'data-slug': product.slug,
  'data-name': product.name,
  'data-price': String(product.price),
  'data-scale': product.weightScale,
  'data-cover': product.coverUrl ?? '',
  'data-ship-badge': product.shipBadge ?? 'none',
};
---

<article class="home-shop-card">
  <a class="home-shop-media" href={href} tabindex="-1" aria-hidden="true">
    {
      product.coverUrl ? (
        <img
          src={product.coverUrl}
          alt=""
          width={product.coverWidth ?? 480}
          height={product.coverHeight ?? 480}
          loading={eager ? 'eager' : 'lazy'}
          decoding="async"
          fetchpriority={eager ? 'high' : undefined}
          sizes="(min-width: 64rem) 16rem, (min-width: 40rem) 30vw, 46vw"
        />
      ) : (
        <span class="home-shop-media-empty" aria-hidden="true" />
      )
    }
    {off != null && <span class="home-shop-badge">-{off}%</span>}
    <ProductSalesBadge ratingLabel={product.ratingLabel ?? null} sold={product.sold ?? 0} />
  </a>
  <div class="home-shop-body">
    <h3 class="home-shop-name">
      <a href={href}>
        {cordLabel && <span class="home-shop-cord">{cordLabel}</span>}
        <span class="home-shop-name-text">{product.name}</span>
      </a>
    </h3>
    {audienceLabel && <p class="home-shop-audience">{audienceLabel}</p>}
    <p class="home-shop-price">
      <span class="home-shop-price-now">{formatVnd(product.price)}</span>
      {product.comparePrice != null && <span class="home-shop-price-was">{formatVnd(product.comparePrice)}</span>}
    </p>
    <InspectGoodsBadge />
    {product.shipBadge && product.shipBadge !== 'none' && <FreeShipBadge variant={product.shipBadge} />}
    <div class="home-shop-actions">
      <a class="btn btn-primary home-shop-buy" href={orderHref} {...orderAttrs}>
        <svg class="home-shop-btn-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" aria-hidden="true">
          <path
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 0 0-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.924-7.138a60.114 60.114 0 0 0-16.536-1.84M7.5 14.25 5.106 5.272M6 20.25a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Zm12.75 0a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Z"
          ></path>
        </svg>
        Mua ngay
      </a>
      {
        needsDialog ? (
          <button class="btn home-shop-cart" type="button" data-add-open aria-haspopup="dialog" aria-controls={addId}>
            <svg class="home-shop-btn-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"></path>
            </svg>
            Thêm giỏ
          </button>
        ) : (
          <form class="home-shop-cart-form" method="post" action={routes.cart} data-cart-form>
            <input type="hidden" name="intent" value="add" />
            <input type="hidden" name="slug" value={product.slug} />
            <input type="hidden" name="product_name" value={product.name} />
            <input type="hidden" name="weight" value="" />
            <input type="hidden" name="quantity" value="1" />
            <input type="hidden" name="price" value={product.price} />
            <button class="btn home-shop-cart" type="submit">
              <svg class="home-shop-btn-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"></path>
              </svg>
              Thêm giỏ
            </button>
          </form>
        )
      }
    </div>
  </div>
  {
    needsDialog && (
      <dialog id={addId} class="add-dialog" aria-labelledby={addTitleId}>
        <form
          class="add-form"
          method="post"
          action={routes.cart}
          data-cart-form
          data-requires-weight={needsWeight ? 'true' : undefined}
          data-requires-tag={needsTag ? 'true' : undefined}
        >
          <div class="add-head">
            <p id={addTitleId} class="font-semibold">{product.name}</p>
            <button class="add-close" type="button" data-add-close aria-label="Đóng">×</button>
          </div>
          <p class="font-semibold text-primary-strong" data-add-price>{formatVnd(product.price)}</p>
          <input type="hidden" name="intent" value="add" />
          <input type="hidden" name="slug" value={product.slug} />
          <input type="hidden" name="product_name" value={product.name} />
          <input type="hidden" name="price" value={product.price} />
          {
            needsWeight && (
              <fieldset class="mt-3" data-weight-field data-base-price={product.price}>
                <legend class="text-sm font-semibold">Cân nặng của bé</legend>
                <div class="weight-grid mt-2" role="radiogroup">
                  {chips.map((weight, index) => (
                    <label class="weight-chip">
                      <input type="radio" name="weight" value={weight} required={index === 0} />
                      <span>{weight}</span>
                    </label>
                  ))}
                  <button type="button" class="weight-chip weight-chip-more" data-weight-more aria-expanded="false" aria-label="Cân nặng khác">
                    <span aria-hidden="true">+</span>
                  </button>
                </div>
                <div class="weight-extra mt-2" data-weight-extra hidden>
                  <select class="field" data-weight-extra-select aria-label="Chọn cân nặng lớn hơn">
                    <option value="">Chọn cân nặng (16kg – 70kg)</option>
                    {extras.map((weight) => (
                      <option value={weight}>{weightOptionLabel(weight, product.price)}</option>
                    ))}
                  </select>
                </div>
                <p class="weight-surcharge-note" data-weight-note hidden></p>
                <WeightFitHint />
              </fieldset>
            )
          }
          {!needsWeight && <input type="hidden" name="weight" value="" />}
          {
            needsTag && (
              <label class="mt-3 block text-sm font-semibold" for={`home-tag-${product.id}`}>
                Tên cần in lên thẻ
                <input
                  id={`home-tag-${product.id}`}
                  class="field mt-1"
                  name="tagName"
                  required
                  maxlength={TAG_NAME_MAX}
                  autocomplete="off"
                  placeholder="Ví dụ: Minh An"
                />
              </label>
            )
          }
          <QtyStepper id={`home-qty-${product.id}`} max={CART_MAX_QUANTITY} />
          <p class="add-error error-text mt-2" role="alert" hidden></p>
          <button class="btn btn-primary mt-4 w-full" type="submit">Thêm giỏ</button>
        </form>
      </dialog>
    )
  }
</article>
