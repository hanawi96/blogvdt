---
import { CART_MAX_QUANTITY } from '../../features/cart/cart';
import { discountPercent } from '../../features/products/catalog';
import { requiresWeight, weightOptions, type WeightScale } from '../../features/products/weight';
import type { ProductShipBadge } from '../../features/shipping/customer-fee';
import { formatVnd } from '../../lib/money';
import { routes } from '../../lib/routes';
import FreeShipBadge from './FreeShipBadge.astro';
import QtyStepper from './QtyStepper.astro';

interface Props {
  product: {
    id: number;
    name: string;
    slug: string;
    price: number;
    comparePrice: number | null;
    weightScale: WeightScale;
    shipBadge?: ProductShipBadge;
    coverUrl: string | null;
    coverAlt: string;
    coverWidth: number | null;
    coverHeight: number | null;
  };
  eager?: boolean;
}

const { product, eager = false } = Astro.props;
const href = routes.product(product.slug);
const orderHref = `${routes.checkout}?san-pham=${encodeURIComponent(product.slug)}`;
const needsWeight = requiresWeight(product.weightScale);
const weights = needsWeight ? weightOptions(product.weightScale) : [];
const off = discountPercent(product.price, product.comparePrice);
const addId = `home-add-${product.id}`;
const addTitleId = `home-add-title-${product.id}`;
const orderAttrs = {
  'data-order-open': '',
  'data-slug': product.slug,
  'data-name': product.name,
  'data-price': String(product.price),
  'data-scale': product.weightScale,
  'data-cover': product.coverUrl ?? '',
};
---

<article class="home-shop-card">
  <a class="home-shop-media" href={href} tabindex="-1" aria-hidden="true">
    {
      product.coverUrl ? (
        <img
          src={product.coverUrl}
          alt=""
          width={product.coverWidth ?? 480}
          height={product.coverHeight ?? 480}
          loading={eager ? 'eager' : 'lazy'}
          decoding="async"
          fetchpriority={eager ? 'high' : undefined}
          sizes="(min-width: 64rem) 16rem, (min-width: 40rem) 30vw, 46vw"
        />
      ) : (
        <span class="home-shop-media-empty" aria-hidden="true" />
      )
    }
    {off != null && <span class="home-shop-badge">-{off}%</span>}
  </a>
  <div class="home-shop-body">
    <h3 class="home-shop-name"><a href={href}>{product.name}</a></h3>
    <p class="home-shop-price">
      <span class="home-shop-price-now">{formatVnd(product.price)}</span>
      {product.comparePrice != null && <span class="home-shop-price-was">{formatVnd(product.comparePrice)}</span>}
    </p>
    {product.shipBadge && product.shipBadge !== 'none' && <FreeShipBadge variant={product.shipBadge} />}
    <div class="home-shop-actions">
      <a class="btn btn-primary home-shop-buy" href={orderHref} {...orderAttrs}>Mua ngay</a>
      {
        needsWeight ? (
          <button class="btn home-shop-cart" type="button" data-add-open aria-haspopup="dialog" aria-controls={addId}>
            Thêm giỏ
          </button>
        ) : (
          <form class="home-shop-cart-form" method="post" action={routes.cart} data-cart-form>
            <input type="hidden" name="intent" value="add" />
            <input type="hidden" name="slug" value={product.slug} />
            <input type="hidden" name="weight" value="" />
            <input type="hidden" name="quantity" value="1" />
            <button class="btn home-shop-cart" type="submit">Thêm giỏ</button>
          </form>
        )
      }
    </div>
  </div>
  {
    needsWeight && (
      <dialog id={addId} class="add-dialog" aria-labelledby={addTitleId}>
        <form class="add-form" method="post" action={routes.cart} data-cart-form data-requires-weight="true">
          <div class="add-head">
            <p id={addTitleId} class="font-semibold">{product.name}</p>
            <button class="add-close" type="button" data-add-close aria-label="Đóng">×</button>
          </div>
          <p class="font-semibold text-primary-strong">{formatVnd(product.price)}</p>
          <input type="hidden" name="intent" value="add" />
          <input type="hidden" name="slug" value={product.slug} />
          <fieldset class="mt-3">
            <legend class="text-sm font-semibold">Cân nặng của bé</legend>
            <div class="weight-grid mt-2" role="radiogroup">
              {weights.map((weight, index) => (
                <label class="weight-chip">
                  <input type="radio" name="weight" value={weight} required={index === 0} />
                  <span>{weight}</span>
                </label>
              ))}
            </div>
          </fieldset>
          <QtyStepper id={`home-qty-${product.id}`} max={CART_MAX_QUANTITY} />
          <p class="add-error error-text mt-2" role="alert" hidden></p>
          <button class="btn btn-primary mt-4 w-full" type="submit">Thêm giỏ</button>
        </form>
      </dialog>
    )
  }
</article>
