---
import type { PublicPostCard } from '../../features/posts/public';
import { formatDateTime } from '../../lib/datetime';
import { routes } from '../../lib/routes';

interface Props {
  post: PublicPostCard;
  level?: 'h2' | 'h3';
  eager?: boolean;
}

const { post, level = 'h2', eager = false } = Astro.props;
const Heading = level;
// Ưu tiên bản card ~800px (nhẹ) cho lưới; ảnh gốc chỉ dùng khi ảnh cũ chưa có biến thể.
const imgSrc = post.cardUrl ?? post.coverUrl;
// Bản card là ảnh vuông 800×800; ảnh gốc dùng kích thước thật để tránh dịch layout (CLS).
const imgWidth = post.cardUrl ? 800 : (post.coverWidth ?? undefined);
const imgHeight = post.cardUrl ? 800 : (post.coverHeight ?? undefined);
// Màu chip danh mục ổn định theo slug (không ngẫu nhiên giữa các lần render) để nhận diện nhanh.
const CHIP_TONES = ['is-tone-1', 'is-tone-2', 'is-tone-3', 'is-tone-4'] as const;
function chipTone(key: string): string {
  let sum = 0;
  for (let i = 0; i < key.length; i += 1) sum = (sum + key.charCodeAt(i)) % 997;
  return CHIP_TONES[sum % CHIP_TONES.length];
}
const tone = post.categorySlug ? chipTone(post.categorySlug) : CHIP_TONES[0];
---

<article class="blog-card">
  {
    imgSrc ? (
      <a class="blog-card-media" href={routes.knowledge(post.slug)} aria-hidden={post.coverAlt ? undefined : 'true'} tabindex={post.coverAlt ? undefined : -1}>
        <img
          src={imgSrc}
          alt={post.coverAlt}
          width={imgWidth}
          height={imgHeight}
          loading={eager ? undefined : 'lazy'}
          decoding={eager ? undefined : 'async'}
        />
      </a>
    ) : (
      <a class="blog-card-media blog-card-media-empty" href={routes.knowledge(post.slug)} aria-hidden="true" tabindex={-1}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="4" width="18" height="16" rx="2" />
          <circle cx="8.5" cy="9.5" r="1.6" />
          <path d="m5 18 4.5-5 3 3L16 12l3 4" />
        </svg>
      </a>
    )
  }
  <div class="blog-card-body">
    {post.categoryName && post.categorySlug && (
      <a class:list={['blog-card-chip', tone]} href={routes.knowledgeCategory(post.categorySlug)}>{post.categoryName}</a>
    )}
    <Heading class="blog-card-title">
      <a href={routes.knowledge(post.slug)}>{post.title}</a>
    </Heading>
    {post.excerpt && <p class="blog-card-excerpt">{post.excerpt}</p>}
    <div class="blog-card-foot">
      {post.publishedAt && <time datetime={new Date(post.publishedAt).toISOString()}>{formatDateTime(post.publishedAt)}</time>}
      <a class="blog-card-more" href={routes.knowledge(post.slug)}>Đọc tiếp →</a>
    </div>
  </div>
</article>
