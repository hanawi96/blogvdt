---
import AddonPicker from './AddonPicker.astro';
import AddressField from './AddressField.astro';
import {
  addonUnitWithSlugBundles,
  catalogUnitWithOfferList,
  type PublicComboPricing,
} from '../../features/home-collections/combo-price';
import { ORDER_MAX_QUANTITY } from '../../features/orders/order';
import {
  addonShipHint,
  type AddonShipHint,
  type PublicAddon,
} from '../../features/products/addons';
import { productRequiresTagName, TAG_NAME_MAX } from '../../features/products/tag-name';
import { applyWeightPrice, requiresWeight, weightChips, weightExtras, weightOptionLabel, type WeightScale } from '../../features/products/weight';
import DiscountCodeField from './DiscountCodeField.astro';
import PaymentField from './PaymentField.astro';
import type { ShipGroup } from '../../features/shipping/customer-fee';
import { formatVnd } from '../../lib/money';
import { routes } from '../../lib/routes';
import type { FieldErrors } from '../../lib/validation/errors';

interface Props {
  product: { slug: string; name?: string; weightScale: WeightScale; price?: number };
  values?: {
    customerName: string;
    phone: string;
    address: string;
    provinceCode?: string;
    wardCode?: string;
    addressLine?: string;
    note: string;
    tagName?: string;
    quantity: string;
    weight: string;
    paymentMethod: string;
    discountCode?: string;
    addonSlug?: string;
    addonSlugs?: string[];
  };
  errors?: FieldErrors;
  quote?: { code: string; discountAmount: number; totalPrice: number } | null;
  landing?: string;
  shipping?: { free: boolean; fee: number } | null;
  goodsTotal?: number;
  /** Giá hàng trước giảm combo (để hiện tạm tính + dòng giảm). */
  catalogGoodsTotal?: number;
  /** Phí ship gốc (trước miễn ship) — dùng cập nhật live khi đổi SL/cân nặng. */
  shipBaseFee?: number;
  shipGroup?: ShipGroup;
  addons?: PublicAddon[];
  addonHint?: AddonShipHint;
  /** false khi trang SP đã có modal xác nhận bán kèm. */
  addonConfirmDialog?: boolean;
  comboPricing?: PublicComboPricing;
}

const emptyPricing: PublicComboPricing = { comboBySlug: {}, addonBundles: [] };
const {
  product,
  values = {
    customerName: '',
    phone: '',
    address: '',
    note: '',
    tagName: '',
    quantity: '1',
    weight: '',
    paymentMethod: '',
    discountCode: '',
    addonSlug: '',
    addonSlugs: [],
  },
  errors = {},
  quote = null,
  landing = '',
  shipping = null,
  goodsTotal = 0,
  catalogGoodsTotal,
  shipBaseFee = 0,
  shipGroup = 'other',
  addons = [],
  addonHint = addonShipHint(goodsTotal),
  addonConfirmDialog = true,
  comboPricing = emptyPricing,
} = Astro.props;
const showAddons = shipGroup === 'bracelet' && addons.length > 0;
const chips = weightChips(product.weightScale);
const extras = weightExtras(product.weightScale);
const hasWeight = requiresWeight(product.weightScale);
const needsTag = productRequiresTagName(product.name ?? '');
// Khi khách quay lại với cân nặng đã chọn nằm ngoài chip (16kg+), mở sẵn dropdown.
const extraSelected = extras.includes(values.weight);
const goodsPayable = quote?.totalPrice ?? goodsTotal;
const payable = goodsPayable + (shipping?.fee ?? 0);
const showSummary = Boolean(shipping) && (goodsTotal > 0 || (typeof product.price === 'number' && product.price > 0));
const chosenAddonSlugs =
  values.addonSlugs && values.addonSlugs.length > 0
    ? values.addonSlugs
    : values.addonSlug
      ? [values.addonSlug]
      : [];
const summaryQty = (() => {
  const qty = Number(values.quantity);
  return Number.isInteger(qty) && qty >= 1 ? qty : 1;
})();
const catalogPrice = typeof product.price === 'number' ? product.price : 0;
const productOffers = comboPricing.comboBySlug[product.slug] ?? [];
const saleUnitBase = catalogUnitWithOfferList(catalogPrice, summaryQty, productOffers);
const summaryAddons = addons.map((addon) => {
  const chosen = chosenAddonSlugs.includes(addon.slug);
  if (!chosen) return null;
  const sale = addonUnitWithSlugBundles(
    addon.price,
    addon.slug,
    product.slug,
    comboPricing.addonBundles,
  );
  return { ...addon, salePrice: sale };
}).filter((row): row is NonNullable<typeof row> => row != null);
const weightForSummary = values.weight ?? '';
const summaryMainUnit = saleUnitBase > 0 ? applyWeightPrice(saleUnitBase, weightForSummary) : 0;
const summaryCatalogUnit = catalogPrice > 0 ? applyWeightPrice(catalogPrice, weightForSummary) : 0;
const summaryMainTotal = summaryMainUnit * summaryQty;
const summaryAddonTotal = summaryAddons.reduce((sum, item) => sum + item.salePrice, 0);
const summaryCatalogAddon = summaryAddons.reduce((sum, item) => sum + item.price, 0);
const summaryCatalogTotal =
  catalogGoodsTotal ?? summaryCatalogUnit * summaryQty + summaryCatalogAddon;
const comboSaveTotal = Math.max(0, summaryCatalogTotal - (summaryMainTotal + summaryAddonTotal));
const summaryMainName = product.name?.trim() || 'Sản phẩm';
const pricingJson = JSON.stringify(comboPricing);
---

<form class="mt-6" method="post" action={routes.checkout} data-order-form data-product-slug={product.slug}>
  <input type="hidden" name="productSlug" value={product.slug} />
  {landing && <input type="hidden" name="landing" value={landing} />}
  <script type="application/json" data-order-combo-pricing set:html={pricingJson} />
  {typeof product.price === 'number' && (
    <span
      hidden
      data-payable-amount={payable > 0 ? payable : product.price}
      data-unit-price={product.price}
      data-catalog-price={product.price}
    ></span>
  )}
  <div class="absolute -left-[9999px]" aria-hidden="true">
    <label for="company">Công ty</label>
    <input id="company" name="company" tabindex="-1" autocomplete="off" />
  </div>
  {
    hasWeight && (
      <fieldset class="mt-4" data-weight-field>
        <legend class="mb-1 font-semibold">Cân nặng của bé</legend>
        <div class="weight-grid mt-2" role="radiogroup">
          {chips.map((weight, index) => (
            <label class="weight-chip">
              <input type="radio" name="weight" value={weight} required={index === 0} checked={values.weight === weight} />
              <span>{weight}</span>
            </label>
          ))}
          <button type="button" class="weight-chip weight-chip-more" data-weight-more aria-expanded={extraSelected ? 'true' : 'false'} aria-label="Cân nặng khác">
            <span aria-hidden="true">+</span>
          </button>
        </div>
        <div class="weight-extra mt-2" data-weight-extra hidden={!extraSelected}>
          <label class="sr-only" for="weight-extra-select">Chọn cân nặng lớn hơn</label>
          <select id="weight-extra-select" class="field" data-weight-extra-select>
            <option value="">Chọn cân nặng (16kg – 70kg)</option>
            {extras.map((weight) => (
              <option value={weight} selected={values.weight === weight}>{weightOptionLabel(weight, product.price ?? 0)}</option>
            ))}
          </select>
        </div>
        <p class="weight-surcharge-note" data-weight-note hidden></p>
        {errors.weight && <span class="error-text">{errors.weight}</span>}
      </fieldset>
    )
  }
  <div class="mt-4">
    <label class="mb-1 block font-semibold" for="quantity">Số lượng</label>
    <div class="qty-stepper-row" data-qty-stepper>
      <button class="qty-stepper-btn" type="button" data-qty-dec aria-label="Giảm số lượng">−</button>
      <input id="quantity" class="qty-stepper-input" name="quantity" type="number" inputmode="numeric" min="1" max={ORDER_MAX_QUANTITY} required value={values.quantity} data-qty-input aria-label="Số lượng" />
      <button class="qty-stepper-btn" type="button" data-qty-inc aria-label="Tăng số lượng">+</button>
    </div>
    {errors.quantity && <span class="error-text">{errors.quantity}</span>}
  </div>
  {
    needsTag && (
      <label class="mt-4 block" for="tag-name">
        <span class="mb-1 block font-semibold">Tên cần in lên thẻ</span>
        <input id="tag-name" class="field" name="tagName" required maxlength={TAG_NAME_MAX} autocomplete="off" placeholder="Ví dụ: Minh An" value={values.tagName ?? ''} />
        {errors.tagName && <span class="error-text">{errors.tagName}</span>}
      </label>
    )
  }
  {
    showAddons && (
      <>
        <AddonPicker
          addons={addons}
          hint={addonHint}
          selectedSlugs={
            values.addonSlugs && values.addonSlugs.length > 0
              ? values.addonSlugs
              : values.addonSlug
                ? [values.addonSlug]
                : []
          }
          idPrefix="order-addon"
          confirmDialog={addonConfirmDialog}
          class="mt-4"
        />
        {errors.addonSlug && <span class="error-text mt-1 block">{errors.addonSlug}</span>}
      </>
    )
  }
  <PaymentField value={values.paymentMethod} error={errors.paymentMethod} />
  <div class="form-pair mt-4">
    <label class="block" for="customer-name">
      <span class="mb-1 block font-semibold">Họ tên</span>
      <input id="customer-name" class="field" name="customerName" required maxlength="80" autocomplete="name" value={values.customerName} />
      {errors.customerName && <span class="error-text">{errors.customerName}</span>}
    </label>
    <label class="block" for="phone">
      <span class="mb-1 block font-semibold">Số điện thoại</span>
      <input id="phone" class="field" name="phone" type="tel" required maxlength="20" autocomplete="tel" value={values.phone} />
      {errors.phone && <span class="error-text">{errors.phone}</span>}
    </label>
  </div>
  <AddressField
    idPrefix="address"
    error={errors.address}
    address={values.address}
    provinceCode={values.provinceCode}
    wardCode={values.wardCode}
    line={values.addressLine}
    paired
  />
  <label class="mt-4 block" for="note">
    <span class="mb-1 block font-semibold">Ghi chú</span>
    <textarea id="note" class="field min-h-20" name="note" maxlength="500">{values.note}</textarea>
    {errors.note && <span class="error-text">{errors.note}</span>}
  </label>
  <DiscountCodeField id="discount-code" value={values.discountCode} error={errors.discountCode} quote={quote} />
  {
    showSummary && shipping && (
      <>
        <div
          class="cart-sum-stack"
          data-order-ship
          data-ship-base={shipBaseFee}
          data-ship-group={shipGroup}
          data-discount-amount={quote?.discountAmount ?? 0}
          data-product-name={summaryMainName}
        >
          <ul class="cart-sum-lines" data-order-lines aria-label="Sản phẩm trong đơn">
            {(summaryMainTotal > 0 || summaryMainUnit > 0) && (
              <li class="cart-sum-line">
                <span class="cart-sum-line-text">
                  <span class="cart-sum-line-name">{summaryMainName}</span>
                  {summaryQty > 1 && <span class="cart-sum-line-qty">×{summaryQty}</span>}
                </span>
                <span class="cart-sum-line-price">{formatVnd(summaryMainTotal)}</span>
              </li>
            )}
            {summaryAddons.map((addon) => (
              <li class="cart-sum-line is-addon">
                <span class="cart-sum-line-text">
                  <span class="cart-sum-line-name">{addon.name}</span>
                </span>
                <span class="cart-sum-line-price">{formatVnd(addon.salePrice)}</span>
              </li>
            ))}
          </ul>
          <div class="cart-sum">
            <span>Tạm tính</span>
            <strong data-order-goods>{formatVnd(comboSaveTotal > 0 ? summaryCatalogTotal : goodsTotal)}</strong>
          </div>
          <div class="cart-sum cart-sum-muted cart-sum-combo" data-order-combo-save hidden={comboSaveTotal <= 0}>
            <span>Giảm combo</span>
            <strong data-order-combo-save-amount>−{formatVnd(comboSaveTotal)}</strong>
          </div>
          {quote && quote.discountAmount > 0 && (
            <div class="cart-sum cart-sum-muted" data-order-discount-row>
              <span>Giảm giá</span>
              <strong data-order-discount>−{formatVnd(quote.discountAmount)}</strong>
            </div>
          )}
          <div class="cart-sum cart-sum-muted">
            <span>Phí vận chuyển</span>
            <strong data-order-ship-fee>{shipping.free ? 'Miễn phí' : formatVnd(shipping.fee)}</strong>
          </div>
          <div class="cart-sum">
            <span>Phải trả</span>
            <strong data-order-total>{formatVnd(payable)}</strong>
          </div>
        </div>
        <p class="cart-sum-note">Nhận hàng kiểm tra hàng thoải mái, ưng ý thì mới thanh toán.</p>
      </>
    )
  }
  <button class="btn btn-primary mt-6 w-full" type="submit">Gửi đơn</button>
</form>
<script>
  import {
    addonUnitWithSlugBundles,
    catalogUnitWithOfferList,
    type PublicComboPricing,
  } from '../../features/home-collections/combo-price';
  import { applyWeightPrice, weightSurchargeLabel } from '../../features/products/weight';
  import { resolveCustomerShippingFee, type ShipGroup } from '../../features/shipping/customer-fee';

  const money = new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND', maximumFractionDigits: 0 });

  document.querySelectorAll('form[data-order-form]').forEach((form) => {
    const amountEl = form.querySelector('[data-payable-amount][data-unit-price]');
    const quantity = form.querySelector('#quantity');
    const catalogPrice = amountEl instanceof HTMLElement ? Number(amountEl.dataset.catalogPrice || amountEl.dataset.unitPrice) || 0 : 0;
    const productSlug = form instanceof HTMLElement ? form.dataset.productSlug || '' : '';
    const pricingNode = form.querySelector('[data-order-combo-pricing]');
    let comboPricing: PublicComboPricing = { comboBySlug: {}, addonBundles: [] };
    try {
      const raw = pricingNode?.textContent?.trim();
      if (raw) comboPricing = JSON.parse(raw) as PublicComboPricing;
    } catch {
      comboPricing = { comboBySlug: {}, addonBundles: [] };
    }
    const shipRoot = form.querySelector('[data-order-ship]');
    const shipBase = shipRoot instanceof HTMLElement ? Number(shipRoot.dataset.shipBase || '0') : 0;
    const shipGroup = (shipRoot instanceof HTMLElement ? shipRoot.dataset.shipGroup || 'other' : 'other') as ShipGroup;
    const discountAmount =
      shipRoot instanceof HTMLElement ? Math.max(0, Number(shipRoot.dataset.discountAmount || '0') || 0) : 0;

    // ----- Cân nặng: nút "Cân nặng khác" + dropdown 16kg–70kg -----
    const field = form.querySelector('[data-weight-field]');
    const moreBtn = field?.querySelector('[data-weight-more]');
    const extraWrap = field?.querySelector('[data-weight-extra]');
    const extraSelect = field?.querySelector('[data-weight-extra-select]');
    const note = field?.querySelector('[data-weight-note]');

    const selectedWeight = (): string => {
      const checked = form.querySelector('input[name="weight"]:checked');
      if (checked instanceof HTMLInputElement) return checked.value;
      if (extraSelect instanceof HTMLSelectElement && extraSelect.value) return extraSelect.value;
      return '';
    };

    const selectedAddons = (): { name: string; catalogPrice: number; price: number }[] => {
      const rows: { name: string; catalogPrice: number; price: number }[] = [];
      form.querySelectorAll('input[name="addonSlug"]:checked').forEach((node) => {
        if (!(node instanceof HTMLInputElement) || !node.value) return;
        const catalog = Number(node.dataset.addonPrice || '0');
        if (!Number.isSafeInteger(catalog) || catalog < 0) return;
        const sale = addonUnitWithSlugBundles(
          catalog,
          node.value.trim(),
          productSlug,
          comboPricing.addonBundles,
        );
        const card = node.closest('[data-addon-card]');
        const name = card instanceof HTMLElement ? card.dataset.addonName || 'Bán kèm' : 'Bán kèm';
        rows.push({ name, catalogPrice: catalog, price: sale });
      });
      return rows;
    };

    const paintOrderLines = (mainName: string, qty: number, mainTotal: number, addons: { name: string; price: number }[]) => {
      if (!(shipRoot instanceof HTMLElement)) return;
      const list = shipRoot.querySelector('[data-order-lines]');
      if (!(list instanceof HTMLElement)) return;
      const rows: HTMLLIElement[] = [];
      if (mainName && mainTotal > 0) {
        const li = document.createElement('li');
        li.className = 'cart-sum-line';
        const text = document.createElement('span');
        text.className = 'cart-sum-line-text';
        const nameEl = document.createElement('span');
        nameEl.className = 'cart-sum-line-name';
        nameEl.textContent = mainName;
        text.append(nameEl);
        if (qty > 1) {
          const qtyEl = document.createElement('span');
          qtyEl.className = 'cart-sum-line-qty';
          qtyEl.textContent = `×${qty}`;
          text.append(qtyEl);
        }
        const priceEl = document.createElement('span');
        priceEl.className = 'cart-sum-line-price';
        priceEl.textContent = money.format(mainTotal);
        li.append(text, priceEl);
        rows.push(li);
      }
      for (const addon of addons) {
        const li = document.createElement('li');
        li.className = 'cart-sum-line is-addon';
        const text = document.createElement('span');
        text.className = 'cart-sum-line-text';
        const nameEl = document.createElement('span');
        nameEl.className = 'cart-sum-line-name';
        nameEl.textContent = addon.name;
        text.append(nameEl);
        const priceEl = document.createElement('span');
        priceEl.className = 'cart-sum-line-price';
        priceEl.textContent = money.format(addon.price);
        li.append(text, priceEl);
        rows.push(li);
      }
      list.replaceChildren(...rows);
    };

    // Đồng bộ số tiền hiển thị, phụ thu, phí ship và QR theo cân nặng + số lượng + bán kèm.
    const sync = () => {
      const weight = selectedWeight();
      const count = quantity instanceof HTMLInputElement ? Number(quantity.value) : 1;
      const qty = Number.isInteger(count) && count >= 1 ? count : 1;
      const offers = productSlug ? comboPricing.comboBySlug[productSlug] : undefined;
      const saleBase = catalogPrice > 0 ? catalogUnitWithOfferList(catalogPrice, qty, offers) : 0;
      const unit = saleBase > 0 ? applyWeightPrice(saleBase, weight) : 0;
      const catalogUnit = catalogPrice > 0 ? applyWeightPrice(catalogPrice, weight) : 0;
      const surcharge = weightSurchargeLabel(weight, saleBase > 0 ? saleBase : catalogPrice);
      if (note instanceof HTMLElement) {
        if (surcharge && unit > 0) {
          note.hidden = false;
          note.textContent = `Vòng lớn hơn, cộng ${surcharge} nguyên liệu → ${money.format(unit)}/chiếc`;
        } else {
          note.hidden = true;
          note.textContent = '';
        }
      }
      const mainGoods = unit > 0 ? unit * qty : 0;
      const catalogMain = catalogUnit > 0 ? catalogUnit * qty : 0;
      const addonsPicked = selectedAddons();
      const addonGoods = addonsPicked.reduce((sum, item) => sum + item.price, 0);
      const addonCatalog = addonsPicked.reduce((sum, item) => sum + item.catalogPrice, 0);
      const goods = mainGoods + addonGoods;
      const catalogGoods = catalogMain + addonCatalog;
      const comboSave = Math.max(0, catalogGoods - goods);
      const afterDiscount = Math.max(0, goods - discountAmount);
      const shipLines: { group: ShipGroup; lineTotal: number }[] = [
        { group: shipGroup, lineTotal: mainGoods },
        ...addonsPicked.map((item) => ({ group: 'addon' as const, lineTotal: item.price })),
      ];
      const shipping = resolveCustomerShippingFee({
        lines: shipLines,
        baseFee: shipBase,
      });
      const payable = afterDiscount + shipping.fee;
      if (amountEl instanceof HTMLElement) {
        amountEl.dataset.payableAmount = String(payable > 0 ? payable : unit);
      }
      // Sticky bar trang SP: cập nhật tổng hàng (vòng + bán kèm) khi đổi lựa chọn.
      const stickyPrice = document.querySelector('[data-product-sticky-price]');
      if (stickyPrice) stickyPrice.textContent = money.format(goods > 0 ? goods : unit);
      if (!(shipRoot instanceof HTMLElement)) return;
      const goodsOut = shipRoot.querySelector('[data-order-goods]');
      if (goodsOut) goodsOut.textContent = money.format(comboSave > 0 ? catalogGoods : goods);
      const comboRow = shipRoot.querySelector('[data-order-combo-save]');
      const comboAmount = shipRoot.querySelector('[data-order-combo-save-amount]');
      if (comboRow instanceof HTMLElement) comboRow.hidden = comboSave <= 0;
      if (comboAmount) comboAmount.textContent = `−${money.format(comboSave)}`;
      const shipFeeOut = shipRoot.querySelector('[data-order-ship-fee]');
      if (shipFeeOut) shipFeeOut.textContent = shipping.free ? 'Miễn phí' : money.format(shipping.fee);
      const totalOut = shipRoot.querySelector('[data-order-total]');
      if (totalOut) totalOut.textContent = money.format(payable);
      const mainName = shipRoot.dataset.productName?.trim() || 'Sản phẩm';
      paintOrderLines(mainName, qty, mainGoods, addonsPicked);
    };

    if (moreBtn instanceof HTMLButtonElement && extraWrap instanceof HTMLElement) {
      const moreButton = moreBtn;
      const extraBox = extraWrap;
      moreButton.addEventListener('click', () => {
        const open = extraBox.hidden;
        extraBox.hidden = !open;
        moreButton.setAttribute('aria-expanded', open ? 'true' : 'false');
      });
      // Chọn chip cân nặng thường thì bỏ chọn dropdown lớn (và ngược lại) để chỉ một giá trị gửi đi.
      form.querySelectorAll('input[name="weight"]').forEach((input) => {
        input.addEventListener('change', () => {
          if (extraSelect instanceof HTMLSelectElement) {
            extraSelect.value = '';
            extraSelect.name = '';
            extraSelect.required = false;
          }
          sync();
        });
      });
      const setRadioRequired = (on: boolean) => {
        const first = form.querySelector('input[name="weight"]');
        if (first instanceof HTMLInputElement) first.required = on;
      };
      if (extraSelect instanceof HTMLSelectElement) {
        extraSelect.addEventListener('change', () => {
          const picked = Boolean(extraSelect.value);
          form.querySelectorAll('input[name="weight"]').forEach((input) => {
            if (input instanceof HTMLInputElement) input.checked = false;
          });
          // Khi dùng dropdown, chính nó là trường cân nặng bắt buộc; radio thôi bắt buộc.
          extraSelect.name = picked ? 'weight' : '';
          extraSelect.required = picked;
          setRadioRequired(!picked);
          sync();
        });
        // Nếu quay lại với cân nặng lớn đã chọn, select đóng vai trò trường weight.
        if (extraSelect.value) {
          extraSelect.name = 'weight';
          extraSelect.required = true;
          setRadioRequired(false);
        }
      }
    }

    quantity?.addEventListener('input', sync);
    form.querySelectorAll('[data-qty-dec], [data-qty-inc]').forEach((button) => {
      button.addEventListener('click', () => window.requestAnimationFrame(sync));
    });
    form.querySelectorAll('input[name="addonSlug"]').forEach((input) => {
      input.addEventListener('change', sync);
    });
    form.addEventListener('addon-change', sync);
    sync();

    form.addEventListener('submit', (event) => {
      const button = event instanceof SubmitEvent ? event.submitter : null;
      if (!(button instanceof HTMLButtonElement) || button.value === 'apply') return;
      button.disabled = true;
      button.textContent = 'Đang gửi...';
    });
  });
</script>
