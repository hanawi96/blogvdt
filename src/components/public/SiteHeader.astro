---
import type { PublicSite } from '../../features/settings/settings';
import { routes } from '../../lib/routes';

interface Props {
  site: PublicSite;
}

const { site } = Astro.props;
const path = Astro.url.pathname;
const brandName = 'Vòng dâu tằm by Ánh';
const items = [
  [routes.home, 'Trang chủ'],
  [routes.knowledgeList, 'Bài viết'],
  [routes.catalog, 'Mẫu vòng'],
  [routes.about, 'Giới thiệu'],
  [routes.contact, 'Liên hệ'],
] as const;

function current(href: string): boolean {
  if (href.includes('#')) return false;
  if (href === routes.home) return path === routes.home;
  if (href === routes.catalog) return path === href || path.startsWith('/san-pham/');
  return path === href || path.startsWith(`${href}/`);
}
---

<header class="site-header">
  <div class="site-header-bar">
    <a href={routes.home} class="site-brand">
      {
        site.logoUrl ? (
          <img src={site.logoUrl} alt="" class="site-brand-mark site-brand-logo" width="40" height="40" />
        ) : null
      }
      <span class="site-brand-heart" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="22" height="22">
          <path
            fill="currentColor"
            d="M12 20.4s-6.8-4.2-6.8-9.2A3.9 3.9 0 0 1 12 8.7a3.9 3.9 0 0 1 6.8 2.5c0 5-6.8 9.2-6.8 9.2z"
          ></path>
          <path
            fill="currentColor"
            d="M18.2 5.1 18.7 4l.5 1.1 1.1.5-1.1.5-.5 1.1-.5-1.1-1.1-.5 1.1-.5zM20.4 7.6l.25-.55.25.55.55.25-.55.25-.25.55-.25-.55-.55-.25.55-.25z"
          ></path>
        </svg>
      </span>
      <span class="site-brand-text">
        <span class="site-brand-name">{brandName}</span>
        <span class="site-brand-tag">Thủ công cho mẹ &amp; bé</span>
      </span>
    </a>

    <nav class="site-nav" id="site-nav" data-site-nav aria-label="Chính">
      {
        items.map(([href, label]) => (
          <a href={href} class="site-nav-link" aria-current={current(href) ? 'page' : undefined}>
            {label}
          </a>
        ))
      }
    </nav>

    <div class="site-search" id="site-search" data-site-search hidden>
      <div class="site-search-sheet">
        <div class="site-search-sheet-head">
          <button class="site-search-close" type="button" data-site-search-close aria-label="Đóng tìm kiếm">
            <span aria-hidden="true">←</span>
          </button>
          <form class="site-search-form" action={routes.search} method="get" role="search" data-site-search-form>
            <label class="sr-only" for="site-search-q">Tìm bài viết hoặc mẫu vòng</label>
            <input
              id="site-search-q"
              class="site-search-input"
              type="search"
              name="q"
              maxlength="80"
              placeholder="Tìm bài viết, mẫu vòng…"
              autocomplete="off"
              enterkeyhint="search"
              data-site-search-input
            />
            <button class="site-search-submit" type="submit">Tìm</button>
          </form>
        </div>
        <div class="site-search-sheet-body">
          <div class="site-search-recent" data-site-search-recent hidden>
            <div class="site-search-recent-head">
              <p class="site-search-recent-title">Tìm gần đây</p>
              <button class="site-search-recent-clear" type="button" data-site-search-recent-clear>
                Xóa
              </button>
            </div>
            <ul class="site-search-recent-list" data-site-search-recent-list></ul>
          </div>
          <div class="site-search-panel" data-site-search-panel hidden>
            <p class="site-search-status" data-site-search-status hidden></p>
            <div data-site-search-groups></div>
            <a class="site-search-all" data-site-search-all hidden href={routes.search}>Xem tất cả kết quả</a>
          </div>
        </div>
      </div>
    </div>

    <div class="site-header-tools">
      <button
        class="site-search-toggle"
        type="button"
        data-site-search-toggle
        aria-controls="site-search"
        aria-expanded="false"
        aria-label="Tìm kiếm"
      >
        <span class="site-search-icon" aria-hidden="true"></span>
      </button>
      <a
        href={routes.cart}
        class="site-cart"
        data-cart-link
        aria-label="Giỏ hàng"
        aria-current={path === routes.cart ? 'page' : undefined}
      >
        <svg class="site-cart-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" width="20" height="20" aria-hidden="true">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M15.75 10.5V6a3.75 3.75 0 1 0-7.5 0v4.5m11.356-1.993 1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 0 1-1.12-1.243l1.264-12A1.125 1.125 0 0 1 5.513 7.5h12.974c.576 0 1.059.435 1.119 1.007ZM8.625 10.5a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm7.5 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z"
          ></path>
        </svg>
        <span class="site-cart-label">Giỏ</span>
        <span class="site-cart-badge" data-cart-count>0</span>
      </a>
      <button
        class="site-nav-toggle"
        type="button"
        data-site-nav-toggle
        aria-controls="site-nav"
        aria-expanded="false"
        aria-label="Mở menu"
      >
        <span class="site-nav-toggle-bars" aria-hidden="true"></span>
      </button>
    </div>
  </div>
  <div class="site-header-scrim" data-site-nav-scrim hidden></div>
</header>
<script>
  import { CART_COOKIE, CART_MAX_AGE, addCartLine, cartCount, parseCart, serializeCart, type CartLine } from '../../features/cart/cart';
  import { routes } from '../../lib/routes';

  function readCookie(): CartLine[] {
    const raw = document.cookie.split('; ').find((part) => part.startsWith(`${CART_COOKIE}=`));
    if (!raw) return [];
    const value = raw.slice(CART_COOKIE.length + 1);
    try {
      return parseCart(value.includes('%') ? decodeURIComponent(value) : value);
    } catch {
      return [];
    }
  }

  function paint(lines: CartLine[]) {
    const count = cartCount(lines);
    const label = count > 0 ? `Giỏ hàng, ${count} chiếc` : 'Giỏ hàng';
    document.querySelectorAll('[data-cart-count]').forEach((node) => {
      if (!(node instanceof HTMLElement)) return;
      node.hidden = false;
      node.textContent = String(count);
    });
    document.querySelectorAll('[data-cart-link]').forEach((node) => {
      if (node instanceof HTMLAnchorElement) node.setAttribute('aria-label', label);
    });
  }

  function store(lines: CartLine[]) {
    const secure = location.protocol === 'https:' ? '; Secure' : '';
    const maxAge = lines.length === 0 ? 0 : CART_MAX_AGE;
    const value = lines.length === 0 ? '' : encodeURIComponent(serializeCart(lines));
    document.cookie = `${CART_COOKIE}=${value}; Path=/; Max-Age=${maxAge}; SameSite=Lax${secure}`;
    paint(lines);
  }

  function flash(button: HTMLButtonElement, text: string) {
    const previous = button.dataset.label || button.textContent || 'Thêm vào giỏ';
    button.dataset.label = previous;
    button.textContent = text;
    window.setTimeout(() => {
      button.textContent = button.dataset.label || previous;
    }, 1200);
  }

  const nav = document.querySelector('[data-site-nav]');
  const toggle = document.querySelector('[data-site-nav-toggle]');
  const scrim = document.querySelector('[data-site-nav-scrim]');
  const header = document.querySelector('.site-header');
  const searchRoot = document.querySelector('[data-site-search]');
  const searchToggle = document.querySelector('[data-site-search-toggle]');
  const searchClose = document.querySelector('[data-site-search-close]');
  const searchForm = document.querySelector('[data-site-search-form]');
  const searchInput = document.querySelector('[data-site-search-input]');
  const searchPanel = document.querySelector('[data-site-search-panel]');
  const searchStatus = document.querySelector('[data-site-search-status]');
  const searchGroups = document.querySelector('[data-site-search-groups]');
  const searchAll = document.querySelector('[data-site-search-all]');
  const recentRoot = document.querySelector('[data-site-search-recent]');
  const recentList = document.querySelector('[data-site-search-recent-list]');
  const recentClear = document.querySelector('[data-site-search-recent-clear]');
  const suggestUrl = routes.searchSuggest;
  const searchPage = routes.search;
  const recentKey = 'vdt-search-recent';
  const recentMax = 6;
  let searchTimer = 0;
  let searchSeq = 0;

  function setNavOpen(open: boolean) {
    if (!(nav instanceof HTMLElement) || !(toggle instanceof HTMLButtonElement)) return;
    nav.classList.toggle('is-open', open);
    header?.classList.toggle('is-nav-open', open);
    toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
    toggle.setAttribute('aria-label', open ? 'Đóng menu' : 'Mở menu');
    if (scrim instanceof HTMLElement) scrim.hidden = !open;
    document.body.classList.toggle('site-nav-lock', open);
  }

  const wideQuery = window.matchMedia('(min-width: 48rem)');

  function readRecent(): string[] {
    try {
      const raw = localStorage.getItem(recentKey);
      if (!raw) return [];
      const parsed = JSON.parse(raw) as unknown;
      if (!Array.isArray(parsed)) return [];
      return parsed
        .filter((item): item is string => typeof item === 'string')
        .map((item) => item.replace(/\s+/g, ' ').trim().slice(0, 80))
        .filter(Boolean)
        .slice(0, recentMax);
    } catch {
      return [];
    }
  }

  function writeRecent(items: string[]) {
    try {
      localStorage.setItem(recentKey, JSON.stringify(items.slice(0, recentMax)));
    } catch {
      /* ignore quota / private mode */
    }
  }

  function rememberQuery(term: string) {
    const q = term.replace(/\s+/g, ' ').trim().slice(0, 80);
    if (q.length < 2) return;
    writeRecent([q, ...readRecent().filter((item) => item.toLowerCase() !== q.toLowerCase())]);
  }

  function renderRecent() {
    if (!(recentRoot instanceof HTMLElement) || !(recentList instanceof HTMLElement)) return;
    const items = readRecent();
    recentList.replaceChildren();
    if (items.length === 0) {
      recentRoot.hidden = true;
      return;
    }
    for (const item of items) {
      const li = document.createElement('li');
      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'site-search-recent-item';
      button.textContent = item;
      button.addEventListener('click', () => {
        if (!(searchInput instanceof HTMLInputElement)) return;
        searchInput.value = item;
        searchInput.focus();
        void runSuggest(item);
      });
      li.appendChild(button);
      recentList.appendChild(li);
    }
    recentRoot.hidden = false;
  }

  function hideRecent() {
    if (recentRoot instanceof HTMLElement) recentRoot.hidden = true;
  }

  function setSearchOpen(open: boolean) {
    if (!(searchRoot instanceof HTMLElement) || !(searchToggle instanceof HTMLButtonElement)) return;
    const wide = wideQuery.matches;
    searchRoot.hidden = wide ? false : !open;
    header?.classList.toggle('is-search-open', open && !wide);
    document.body.classList.toggle('site-search-lock', open && !wide);
    searchToggle.setAttribute('aria-expanded', !wide && open ? 'true' : 'false');
    searchToggle.setAttribute('aria-label', !wide && open ? 'Đóng tìm kiếm' : 'Tìm kiếm');
    if (open && !wide) {
      setNavOpen(false);
      if (searchInput instanceof HTMLInputElement) {
        searchInput.focus();
        searchInput.select();
        if (searchInput.value.trim().length < 2) {
          clearSuggest();
          renderRecent();
        } else {
          void runSuggest(searchInput.value);
        }
      } else {
        renderRecent();
      }
    } else if (!open && !wide) {
      clearSuggest();
      hideRecent();
      searchToggle.focus();
    }
  }

  function clearSuggest() {
    if (searchPanel instanceof HTMLElement) searchPanel.hidden = true;
    if (searchStatus instanceof HTMLElement) {
      searchStatus.hidden = true;
      searchStatus.textContent = '';
    }
    if (searchGroups instanceof HTMLElement) searchGroups.replaceChildren();
    if (searchAll instanceof HTMLAnchorElement) {
      searchAll.hidden = true;
      searchAll.href = searchPage;
    }
  }

  function showStatus(text: string) {
    if (!(searchPanel instanceof HTMLElement) || !(searchStatus instanceof HTMLElement)) return;
    hideRecent();
    searchPanel.hidden = false;
    searchStatus.hidden = false;
    searchStatus.textContent = text;
    if (searchGroups instanceof HTMLElement) searchGroups.replaceChildren();
    if (searchAll instanceof HTMLAnchorElement) searchAll.hidden = true;
  }

  function renderGroup(title: string, items: { label: string; href: string; meta?: string }[]) {
    const section = document.createElement('section');
    section.className = 'site-search-group';
    const heading = document.createElement('h2');
    heading.textContent = title;
    const list = document.createElement('ul');
    for (const item of items) {
      const li = document.createElement('li');
      const link = document.createElement('a');
      link.href = item.href;
      link.textContent = item.label;
      link.addEventListener('click', () => {
        if (searchInput instanceof HTMLInputElement) rememberQuery(searchInput.value);
      });
      li.appendChild(link);
      if (item.meta) {
        const meta = document.createElement('span');
        meta.textContent = item.meta;
        li.appendChild(meta);
      }
      list.appendChild(li);
    }
    section.appendChild(heading);
    section.appendChild(list);
    return section;
  }

  async function runSuggest(term: string) {
    const q = term.replace(/[%_]/g, '').replace(/\s+/g, ' ').trim().slice(0, 80);
    if (q.length < 2) {
      clearSuggest();
      renderRecent();
      return;
    }
    const seq = ++searchSeq;
    showStatus('Đang tìm…');
    try {
      const res = await fetch(`${suggestUrl}?q=${encodeURIComponent(q)}`, { headers: { accept: 'application/json' } });
      if (seq !== searchSeq) return;
      if (!res.ok) {
        showStatus('Không tìm được lúc này.');
        return;
      }
      const data = (await res.json()) as {
        posts?: { title: string; href: string }[];
        products?: { name: string; href: string; price?: number }[];
      };
      if (seq !== searchSeq) return;
      const posts = data.posts ?? [];
      const products = data.products ?? [];
      if (posts.length === 0 && products.length === 0) {
        showStatus('Không có gợi ý. Enter để xem trang kết quả.');
        if (searchAll instanceof HTMLAnchorElement) {
          searchAll.hidden = false;
          searchAll.href = `${searchPage}?q=${encodeURIComponent(q)}`;
        }
        return;
      }
      if (!(searchPanel instanceof HTMLElement) || !(searchGroups instanceof HTMLElement)) return;
      hideRecent();
      searchPanel.hidden = false;
      if (searchStatus instanceof HTMLElement) searchStatus.hidden = true;
      searchGroups.replaceChildren();
      if (posts.length) {
        searchGroups.appendChild(renderGroup('Bài viết', posts.map((post) => ({ label: post.title, href: post.href }))));
      }
      if (products.length) {
        searchGroups.appendChild(
          renderGroup(
            'Mẫu vòng',
            products.map((product) => ({
              label: product.name,
              href: product.href,
              meta: typeof product.price === 'number' ? `${product.price.toLocaleString('vi-VN')}₫` : undefined,
            })),
          ),
        );
      }
      if (searchAll instanceof HTMLAnchorElement) {
        searchAll.hidden = false;
        searchAll.href = `${searchPage}?q=${encodeURIComponent(q)}`;
      }
    } catch {
      if (seq !== searchSeq) return;
      showStatus('Không tìm được lúc này.');
    }
  }

  searchToggle?.addEventListener('click', () => {
    if (!(searchToggle instanceof HTMLButtonElement)) return;
    setSearchOpen(searchToggle.getAttribute('aria-expanded') !== 'true');
  });
  searchClose?.addEventListener('click', () => setSearchOpen(false));
  recentClear?.addEventListener('click', () => {
    writeRecent([]);
    hideRecent();
  });
  searchForm?.addEventListener('submit', () => {
    if (searchInput instanceof HTMLInputElement) rememberQuery(searchInput.value);
  });
  searchInput?.addEventListener('input', () => {
    if (!(searchInput instanceof HTMLInputElement)) return;
    window.clearTimeout(searchTimer);
    searchTimer = window.setTimeout(() => void runSuggest(searchInput.value), 280);
  });
  searchInput?.addEventListener('focus', () => {
    if (!(searchInput instanceof HTMLInputElement)) return;
    if (searchInput.value.trim().length < 2) renderRecent();
  });

  toggle?.addEventListener('click', () => {
    if (!(toggle instanceof HTMLButtonElement)) return;
    setSearchOpen(false);
    setNavOpen(toggle.getAttribute('aria-expanded') !== 'true');
  });
  scrim?.addEventListener('click', () => {
    setNavOpen(false);
    setSearchOpen(false);
  });
  nav?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => setNavOpen(false));
  });
  window.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      setNavOpen(false);
      setSearchOpen(false);
    }
  });
  wideQuery.addEventListener('change', (event) => {
    if (event.matches) {
      setNavOpen(false);
      document.body.classList.remove('site-search-lock');
      header?.classList.remove('is-search-open');
      if (searchRoot instanceof HTMLElement) searchRoot.hidden = false;
      if (searchToggle instanceof HTMLButtonElement) {
        searchToggle.setAttribute('aria-expanded', 'false');
        searchToggle.setAttribute('aria-label', 'Tìm kiếm');
      }
      return;
    }
    setSearchOpen(false);
  });
  if (wideQuery.matches) {
    if (searchRoot instanceof HTMLElement) searchRoot.hidden = false;
  }

  paint(readCookie());

  // Delegation: form/dialog thêm giỏ trên catalog, trang chủ và thẻ load động đều dùng được.
  document.addEventListener('click', (event) => {
    const target = event.target instanceof Element ? event.target : null;
    if (!target) return;
    const step = target.closest('[data-qty-dec], [data-qty-inc]');
    if (step instanceof HTMLElement) {
      const root = step.closest('[data-qty-stepper]');
      const input = root?.querySelector('input[data-qty-input]');
      if (!(input instanceof HTMLInputElement)) return;
      const min = Number(input.min) || 1;
      const max = Number(input.max) || 99;
      let next = Number(input.value);
      if (!Number.isInteger(next)) next = min;
      next = step.hasAttribute('data-qty-inc') ? next + 1 : next - 1;
      input.value = String(Math.min(max, Math.max(min, next)));
      input.dispatchEvent(new Event('input', { bubbles: true }));
      return;
    }
    const open = target.closest('[data-add-open]');
    if (open) {
      const dialog = open.closest('article')?.querySelector('dialog.add-dialog');
      if (dialog instanceof HTMLDialogElement && !dialog.open) dialog.showModal();
      return;
    }
    const close = target.closest('[data-add-close]');
    if (close) {
      const dialog = close.closest('dialog');
      if (dialog instanceof HTMLDialogElement) dialog.close();
      return;
    }
    if (target instanceof HTMLDialogElement && target.classList.contains('add-dialog')) target.close();
  });

  document.addEventListener('submit', (event) => {
    const node = event.target;
    if (!(node instanceof HTMLFormElement) || !node.hasAttribute('data-cart-form')) return;
    if (node.dataset.cartFrom === 'order') {
      const quantity = document.getElementById('quantity');
      const quantityField = node.querySelector('[name="quantity"]');
      if (quantityField instanceof HTMLInputElement && quantity instanceof HTMLInputElement) quantityField.value = quantity.value;
    }
    const data = new FormData(node);
    const weight = String(data.get('weight') ?? '').trim();
    const button = node.querySelector('button[type="submit"]');
    const notice = node.querySelector('.add-error');
    const warn = (message: string) => {
      event.preventDefault();
      if (notice instanceof HTMLElement) {
        notice.textContent = message;
        notice.hidden = false;
      } else if (button instanceof HTMLButtonElement) {
        flash(button, message);
      }
    };
    if (node.dataset.requiresWeight === 'true' && weight.length === 0) return warn('Chọn cân nặng');
    event.preventDefault();
    const quantity = Number(data.get('quantity') ?? '1');
    const result = addCartLine(readCookie(), {
      slug: String(data.get('slug') ?? ''),
      weight,
      quantity: Number.isInteger(quantity) ? quantity : 1,
    });
    if (!result.ok) {
      if (button instanceof HTMLButtonElement) flash(button, 'Giỏ đã đầy');
      return;
    }
    store(result.lines);
    // Bắn AddToCart cho Meta Pixel. fbq chỉ tồn tại khi admin đã dán Pixel ID (tự bật/tắt theo cấu hình).
    try {
      const fbq = (window as unknown as { fbq?: (...args: unknown[]) => void }).fbq;
      if (typeof fbq === 'function') {
        const price = Number(data.get('price') ?? '');
        const qty = Number.isInteger(quantity) ? quantity : 1;
        const payload: Record<string, unknown> = { content_type: 'product', contents: [{ id: String(data.get('slug') ?? ''), quantity: qty }] };
        if (Number.isFinite(price) && price > 0) {
          payload.value = price * qty;
          payload.currency = 'VND';
        }
        fbq('track', 'AddToCart', payload);
      }
    } catch {
      /* không để lỗi tracking ảnh hưởng thao tác thêm giỏ */
    }
    const dialog = node.closest('dialog');
    if (dialog instanceof HTMLDialogElement) {
      dialog.close();
      node.reset();
      if (notice instanceof HTMLElement) notice.hidden = true;
    }
    if (button instanceof HTMLButtonElement) flash(button, 'Đã thêm');
  });
</script>
