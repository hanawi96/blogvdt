---
import MediaPicker from './MediaPicker.svelte';
import ProductRecipe from './ProductRecipe.svelte';
import SlugField from './SlugField.svelte';
import type { CostedLine, MaterialOption } from '../../features/materials/costing';
import type { MediaItem } from '../../features/media/types';
import { CORD_TYPES } from '../../features/products/form';
import { PRODUCT_STATUS_LABELS } from '../../features/products/status';
import type { FieldErrors } from '../../lib/validation/errors';
import { routes } from '../../lib/routes';

interface Values {
  name: string;
  slug: string;
  price: string;
  comparePrice: string;
  categoryId: string;
  cordType: string;
  description: string;
  coverMediaId: string;
  album: string[];
  status: string;
  featured: boolean;
  sortOrder: string;
  seoTitle: string;
  metaDescription: string;
}

interface Props {
  csrf: string;
  action: string;
  values: Values;
  errors: FieldErrors;
  formError: string;
  media: MediaItem[];
  categories: { id: number; name: string }[];
  recipeOptions: MaterialOption[];
  recipeLines: CostedLine[];
  deleteAction?: string;
}

const { csrf, action, values, errors, formError, media, categories, recipeOptions, recipeLines, deleteAction } = Astro.props;
---

<form id="product-form" class="max-w-3xl" method="post" action={action} data-busy>
  <input type="hidden" name="csrf" value={csrf} />
  {formError && <p class="error-text mb-4" role="alert">{formError}</p>}
  <SlugField
    client:load
    title={values.name}
    slug={values.slug}
    titleError={errors.name ?? ''}
    slugError={errors.slug ?? ''}
    label="Tên"
    field="name"
  />
  <label class="mt-4 block">
    <span class="mb-1 block font-semibold">Giá (VND)</span>
    <input class="field" name="price" inputmode="numeric" required maxlength="8" value={values.price} />
    {errors.price && <span class="error-text">{errors.price}</span>}
  </label>
  <label class="mt-4 block">
    <span class="mb-1 block font-semibold">Giá gốc (VND)</span>
    <input class="field" name="comparePrice" inputmode="numeric" maxlength="8" value={values.comparePrice} placeholder="Để trống nếu không có" />
    {errors.comparePrice && <span class="error-text">{errors.comparePrice}</span>}
  </label>
  <ProductRecipe client:load options={recipeOptions} lines={recipeLines} error={errors.recipe ?? ''} materialsHref={routes.adminMaterials} />
  <label class="mt-4 block">
    <span class="mb-1 block font-semibold">Danh mục</span>
    <select class="field" name="categoryId">
      <option value="" selected={values.categoryId === ''}>Chưa chọn</option>
      {categories.map((category) => (
        <option value={category.id} selected={values.categoryId === String(category.id)}>{category.name}</option>
      ))}
    </select>
    {categories.length === 0 && (
      <span class="mt-1 block text-sm text-muted">Chưa có danh mục. <a href={routes.adminProductCategories}>Thêm danh mục sản phẩm</a></span>
    )}
    {errors.categoryId && <span class="error-text">{errors.categoryId}</span>}
  </label>
  <label class="mt-4 block">
    <span class="mb-1 block font-semibold">Kiểu dây</span>
    <select class="field" name="cordType">
      <option value="" selected={values.cordType === ''}>Chưa chọn</option>
      {CORD_TYPES.map((type) => (
        <option value={type} selected={values.cordType === type}>{type}</option>
      ))}
    </select>
    {errors.cordType && <span class="error-text">{errors.cordType}</span>}
  </label>
  <label class="mt-4 block">
    <span class="mb-1 block font-semibold">Mô tả</span>
    <textarea class="field min-h-32" name="description" required maxlength="2000">{values.description}</textarea>
    {errors.description && <span class="error-text">{errors.description}</span>}
  </label>
  <fieldset class="mt-4">
    <legend class="mb-1 font-semibold">Ảnh đại diện</legend>
    <MediaPicker client:load {csrf} items={media} name="coverMediaId" selected={values.coverMediaId ? [values.coverMediaId] : []} />
    {errors.coverMediaId && <span class="error-text">{errors.coverMediaId}</span>}
  </fieldset>
  <fieldset class="mt-4">
    <legend class="mb-1 font-semibold">Album</legend>
    <MediaPicker client:load {csrf} items={media} name="album" multiple selected={values.album} max={8} />
    {errors.album && <span class="error-text">{errors.album}</span>}
  </fieldset>

  <label class="mt-4 block">
    <span class="mb-1 block font-semibold">Thứ tự</span>
    <input class="field" name="sortOrder" inputmode="numeric" required maxlength="5" value={values.sortOrder} />
    {errors.sortOrder && <span class="error-text">{errors.sortOrder}</span>}
  </label>
  <label class="mt-4 flex items-center gap-2">
    <input type="checkbox" name="featured" value="1" checked={values.featured} data-product-featured />
    <span class="font-semibold">Hiện ở trang chủ</span>
  </label>
  <p class="mt-1 text-sm text-muted">Chỉ sản phẩm đang bán mới được đánh dấu nổi bật.</p>
  <label class="mt-4 block">
    <span class="mb-1 block font-semibold">SEO title</span>
    <input class="field" name="seoTitle" maxlength="180" value={values.seoTitle} />
    {errors.seoTitle && <span class="error-text">{errors.seoTitle}</span>}
  </label>
  <label class="mt-4 block">
    <span class="mb-1 block font-semibold">Meta description</span>
    <textarea class="field min-h-24" name="metaDescription" maxlength="300">{values.metaDescription}</textarea>
    {errors.metaDescription && <span class="error-text">{errors.metaDescription}</span>}
  </label>
  <label class="mt-4 block">
    <span class="mb-1 block font-semibold">Trạng thái</span>
    <select class="field" name="status" data-product-status>
      <option value="active" selected={values.status === 'active'}>{PRODUCT_STATUS_LABELS.active}</option>
      <option value="inactive" selected={values.status === 'inactive'}>{PRODUCT_STATUS_LABELS.inactive}</option>
    </select>
    {errors.status && <span class="error-text">{errors.status}</span>}
  </label>
</form>
<div class="mt-6 flex flex-wrap items-center gap-3">
  <button class="btn btn-primary" type="submit" form="product-form">Lưu sản phẩm</button>
  {
    deleteAction && (
      <form method="post" action={deleteAction} onsubmit="return confirm('Xóa sản phẩm này? Đơn cũ vẫn giữ tên và giá lúc đặt.')">
        <input type="hidden" name="csrf" value={csrf} />
        <button class="btn btn-accent" type="submit">Xóa sản phẩm</button>
      </form>
    )
  }
</div>
<script>
  const status = document.querySelector('[data-product-status]');
  const featured = document.querySelector('[data-product-featured]');
  if (status instanceof HTMLSelectElement && featured instanceof HTMLInputElement) {
    const syncFeatured = () => {
      const inactive = status.value === 'inactive';
      featured.disabled = inactive;
      if (inactive) featured.checked = false;
    };
    status.addEventListener('change', syncFeatured);
    syncFeatured();
  }
</script>
