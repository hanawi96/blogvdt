---
import ProductPhotos from './ProductPhotos.svelte';
import ProductRecipe from './ProductRecipe.svelte';
import SlugField from './SlugField.svelte';
import type { ProductPhoto } from '../../features/products/products';
import type { CostedLine, MaterialOption } from '../../features/materials/costing';
import { AUDIENCES, AUDIENCE_LABELS, readAudience } from '../../features/products/audience';
import { CORD_TYPES, CORD_TYPE_LABELS, normalizeCordType } from '../../features/products/cord';
import { PRODUCT_STATUSES, PRODUCT_STATUS_LABELS } from '../../features/products/status';
import type { FieldErrors } from '../../lib/validation/errors';
import { routes } from '../../lib/routes';

interface Values {
  name: string;
  slug: string;
  price: string;
  comparePrice: string;
  categoryIds: string[];
  cordType: string;
  audience: string;
  description: string;
  coverMediaId: string;
  album: string[];
  status: string;
  sortOrder: string;
  stockQty: string;
  rating: string;
  seoTitle: string;
  metaDescription: string;
}

interface Props {
  csrf: string;
  action: string;
  values: Values;
  errors: FieldErrors;
  formError: string;
  categories: { id: number; name: string }[];
  photos: { cover: ProductPhoto | null; album: ProductPhoto[] };
  recipeOptions: MaterialOption[];
  recipeLines: CostedLine[];
  deleteAction?: string;
}

const { csrf, action, values, errors, formError, categories, photos, recipeOptions, recipeLines, deleteAction } = Astro.props;
const selectedCategoryIds = new Set(values.categoryIds);
---

<form id="product-form" class="product-editor" method="post" action={action} data-busy>
  <input type="hidden" name="csrf" value={csrf} />
  {formError && <p class="error-text mb-4 col-span-full" role="alert">{formError}</p>}
  <div class="product-editor-main">
  <SlugField
    client:load
    title={values.name}
    slug={values.slug}
    titleError={errors.name ?? ''}
    slugError={errors.slug ?? ''}
    label="Tên"
    field="name"
  />
  <div class="product-price-row mt-4">
    <label class="block min-w-0">
      <span class="mb-1 block font-semibold">Giá (VND)</span>
      <input class="field" name="price" inputmode="numeric" required maxlength="8" value={values.price} />
      {errors.price && <span class="error-text">{errors.price}</span>}
    </label>
    <label class="block min-w-0">
      <span class="mb-1 block font-semibold">Giá gốc (VND)</span>
      <input class="field" name="comparePrice" inputmode="numeric" maxlength="8" value={values.comparePrice} placeholder="Để trống nếu không có" />
      {errors.comparePrice && <span class="error-text">{errors.comparePrice}</span>}
    </label>
  </div>
  <div class="product-price-row mt-4">
    <label class="block min-w-0">
      <span class="mb-1 block font-semibold">Tồn kho</span>
      <input class="field" name="stockQty" inputmode="numeric" maxlength="7" value={values.stockQty} placeholder="0" />
      {errors.stockQty && <span class="error-text">{errors.stockQty}</span>}
    </label>
    <label class="block min-w-0">
      <span class="mb-1 block font-semibold">Điểm đánh giá</span>
      <input class="field" name="rating" type="number" inputmode="decimal" min="0" max="5" step="0.1" value={values.rating} placeholder="Ví dụ: 4.5" data-product-rating />
      {errors.rating && <span class="error-text">{errors.rating}</span>}
    </label>
  </div>
  <ProductPhotos client:load {csrf} cover={photos.cover} album={photos.album} error={errors.coverMediaId ?? errors.album ?? ''} />
  <div class="mt-4">
    <span class="mb-1 block font-semibold">Danh mục</span>
    {categories.length === 0 ? (
      <span class="mt-1 block text-sm text-muted">Chưa có danh mục. <a href={routes.adminProductCategories}>Thêm danh mục sản phẩm</a></span>
    ) : (
      <div class="category-presets mt-1" role="group" aria-label="Chọn danh mục">
        {categories.map((category) => (
          <label class="category-preset">
            <input type="checkbox" name="categoryIds" value={category.id} checked={selectedCategoryIds.has(String(category.id))} />
            <span>{category.name}</span>
          </label>
        ))}
      </div>
    )}
    {(errors.categoryIds || errors.categoryId) && <span class="error-text">{errors.categoryIds || errors.categoryId}</span>}
  </div>
  <div class="mt-4">
    <span class="mb-1 block font-semibold" id="cord-type-label">Kiểu dây</span>
    <div class="category-presets" role="radiogroup" aria-labelledby="cord-type-label">
      {CORD_TYPES.map((type) => (
        <label class="category-preset">
          <input type="radio" name="cordType" value={type} checked={normalizeCordType(values.cordType) === type} />
          <span>{CORD_TYPE_LABELS[type]}</span>
        </label>
      ))}
    </div>
    {errors.cordType && <span class="error-text">{errors.cordType}</span>}
  </div>
  <div class="mt-4">
    <span class="mb-1 block font-semibold" id="audience-label">Đối tượng đeo</span>
    <div class="category-presets" role="radiogroup" aria-labelledby="audience-label">
      {AUDIENCES.map((value) => (
        <label class="category-preset">
          <input type="radio" name="audience" value={value} checked={readAudience(values.audience) === value} />
          <span>{AUDIENCE_LABELS[value]}</span>
        </label>
      ))}
    </div>
    {errors.audience && <span class="error-text">{errors.audience}</span>}
  </div>
  <label class="mt-4 block">
    <span class="mb-1 block font-semibold">Mô tả</span>
    <textarea class="field min-h-32" name="description" maxlength="2000">{values.description}</textarea>
    {errors.description && <span class="error-text">{errors.description}</span>}
  </label>
  <input type="hidden" name="sortOrder" value={values.sortOrder} />
  <label class="mt-4 block">
    <span class="mb-1 block font-semibold">SEO title</span>
    <input class="field" name="seoTitle" maxlength="180" value={values.seoTitle} />
    {errors.seoTitle && <span class="error-text">{errors.seoTitle}</span>}
  </label>
  <label class="mt-4 block">
    <span class="mb-1 block font-semibold">Meta description</span>
    <textarea class="field min-h-24" name="metaDescription" maxlength="300">{values.metaDescription}</textarea>
    {errors.metaDescription && <span class="error-text">{errors.metaDescription}</span>}
  </label>
  <div class="mt-4">
    <span class="mb-1 block font-semibold" id="product-status-label">Trạng thái</span>
    <div class="category-presets" role="radiogroup" aria-labelledby="product-status-label">
      {PRODUCT_STATUSES.map((status) => (
        <label class="category-preset">
          <input type="radio" name="status" value={status} checked={values.status === status} required />
          <span>{PRODUCT_STATUS_LABELS[status]}</span>
        </label>
      ))}
    </div>
    {errors.status && <span class="error-text">{errors.status}</span>}
  </div>
  </div>
  <div class="product-editor-side">
    <ProductRecipe client:load options={recipeOptions} lines={recipeLines} error={errors.recipe ?? ''} materialsHref={routes.adminMaterials} />
    <div class="product-editor-actions">
      <button class="btn btn-primary" type="submit">Lưu sản phẩm</button>
      {
        deleteAction && (
          <button
            class="btn btn-accent"
            type="submit"
            formaction={deleteAction}
            formmethod="post"
            onclick="return confirm('Xóa sản phẩm này? Đơn cũ vẫn giữ tên và giá lúc đặt.')"
          >
            Xóa sản phẩm
          </button>
        )
      }
    </div>
  </div>
</form>
<script>
  const ratingInput = document.querySelector('[data-product-rating]');
  if (ratingInput instanceof HTMLInputElement) {
    const clampRating = () => {
      const text = ratingInput.value.trim().replace(',', '.');
      if (!text) return;
      const score = Number(text);
      if (!Number.isFinite(score)) {
        ratingInput.value = '';
        return;
      }
      if (score > 5) ratingInput.value = '5';
      else if (score < 0) ratingInput.value = '0';
    };
    ratingInput.addEventListener('change', clampRating);
    ratingInput.addEventListener('blur', clampRating);
  }
  for (const node of document.querySelectorAll('#product-form input[name="cordType"]')) {
    if (!(node instanceof HTMLInputElement)) continue;
    const input = node;
    input.addEventListener('click', () => {
      if (input.dataset.wasChecked === '1') {
        input.checked = false;
        delete input.dataset.wasChecked;
      }
    });
    input.addEventListener('mousedown', () => {
      if (input.checked) input.dataset.wasChecked = '1';
      else delete input.dataset.wasChecked;
    });
  }
</script>
