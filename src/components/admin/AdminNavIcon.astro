      </>
    )
  }
  {
    name === 'media' && (
      <>
        <rect x="4.5" y="5.5" width="15" height="13" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.7"></rect>
        <circle cx="9" cy="10" r="1.4" fill="none" stroke="currentColor" stroke-width="1.7"></circle>
        <path d="m8 16.5 3-3.5 2.5 2.5L16.5 12l3 4.5" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"></path>
      </>
    )
  }
  {
    name === 'seo' && (
      <>
        <circle cx="10.5" cy="10.5" r="5.5" fill="none" stroke="currentColor" stroke-width="1.7"></circle>
        <path d="m14.5 14.5 4 4M7.5 10.5h6M10.5 7.5v6" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"></path>
      </>
    )
  }
  {
    name === 'redirects' && (
      <path
        d="M8 8.5h8.5l-2.8-2.8M16.5 15.5H8l2.8 2.8M16.5 8.5v3.2a3.8 3.8 0 0 1-3.8 3.8"
        fill="none"
        stroke="currentColor"
        stroke-width="1.7"
        stroke-linecap="round"
        stroke-linejoin="round"
      ></path>
    )
  }
  {
    name === 'landing' && (
      <>
        <rect x="4.5" y="4" width="15" height="16" rx="1.6" fill="none" stroke="currentColor" stroke-width="1.7"></rect>
        <path d="M7.5 8h9M7.5 11h5" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"></path>
        <rect x="7.5" y="14" width="6" height="3" rx="1" fill="none" stroke="currentColor" stroke-width="1.7"></rect>
      </>
