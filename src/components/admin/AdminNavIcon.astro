    name === 'costs' && (
      <path
        d="M4.5 7.5h15v10h-15zM4.5 7.5l2-3h11l2 3M9.5 12h5"
        fill="none"
        stroke="currentColor"
        stroke-width="1.7"
        stroke-linecap="round"
        stroke-linejoin="round"
      ></path>
    )
  }
  {
    name === 'orders' && (
