---
interface Props {
  name:
    | 'overview'
    | 'posts'
    | 'categories'
    | 'tags'
    | 'products'
    | 'productCategories'
    | 'materials'
    | 'pricing'
    | 'costs'
    | 'orders'
    | 'customers'
    | 'media'
    | 'seo'
    | 'redirects'
    | 'landing'
    | 'users'
    | 'activity'
    | 'settings';
}

const { name } = Astro.props;
---

<svg class="admin-nav-icon" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
  {
    name === 'overview' && (
      <>
        <rect x="3.5" y="3.5" width="7.5" height="7.5" rx="1.2" fill="none" stroke="currentColor" stroke-width="1.7"></rect>
        <rect x="13" y="3.5" width="7.5" height="4.5" rx="1.2" fill="none" stroke="currentColor" stroke-width="1.7"></rect>
        <rect x="3.5" y="13" width="7.5" height="7.5" rx="1.2" fill="none" stroke="currentColor" stroke-width="1.7"></rect>
        <rect x="13" y="10" width="7.5" height="10.5" rx="1.2" fill="none" stroke="currentColor" stroke-width="1.7"></rect>
      </>
    )
  }
  {
    name === 'posts' && (
      <path
        d="M7 3.5h7.5L19 8v12.5H7V3.5zm7.5 0V8H19M9.5 12h7M9.5 15.5h7M9.5 19h4.5"
        fill="none"
        stroke="currentColor"
        stroke-width="1.7"
        stroke-linecap="round"
        stroke-linejoin="round"
      ></path>
    )
  }
  {
    name === 'categories' && (
      <path
        d="M4 7.5 12 3.5 20 7.5 12 11.5 4 7.5zm0 4.5 8 4 8-4M4 16.5l8 4 8-4"
        fill="none"
        stroke="currentColor"
        stroke-width="1.7"
        stroke-linecap="round"
        stroke-linejoin="round"
      ></path>
    )
  }
  {
    name === 'tags' && (
      <path
        d="M4.5 12.5V6.2A1.7 1.7 0 0 1 6.2 4.5h6.3L19.5 11.5l-7 7-8-6zm5.2-4.2a1.35 1.35 0 1 0 0-2.7 1.35 1.35 0 0 0 0 2.7z"
        fill="none"
        stroke="currentColor"
        stroke-width="1.7"
        stroke-linecap="round"
        stroke-linejoin="round"
      ></path>
    )
  }
  {
    name === 'products' && (
      <path
        d="M4.5 8.5 12 4.5l7.5 4v8L12 20.5l-7.5-4v-8zm7.5 4V20"
        fill="none"
        stroke="currentColor"
        stroke-width="1.7"
        stroke-linecap="round"
        stroke-linejoin="round"
      ></path>
    )
  }
  {
    name === 'productCategories' && (
      <path
        d="M5 8.5h6.5V15H5V8.5zm8.5 0H19V12h-5.5V8.5zM5 16.5h6.5V19H5v-2.5zm8.5-3H19V19h-5.5v-5.5z"
        fill="none"
        stroke="currentColor"
        stroke-width="1.7"
        stroke-linecap="round"
        stroke-linejoin="round"
      ></path>
    )
  }
  {
    name === 'materials' && (
      <>
        <circle cx="8.5" cy="9" r="3.2" fill="none" stroke="currentColor" stroke-width="1.7"></circle>
        <circle cx="16" cy="9.5" r="2.6" fill="none" stroke="currentColor" stroke-width="1.7"></circle>
        <circle cx="12" cy="16.5" r="3.2" fill="none" stroke="currentColor" stroke-width="1.7"></circle>
      </>
    )
  }
  {
    name === 'pricing' && (
      <path
        d="M4.5 12.5V6.2A1.7 1.7 0 0 1 6.2 4.5h6.3L19.5 11.5l-7 7-8-6zm5.2-4.2a1.35 1.35 0 1 0 0-2.7 1.35 1.35 0 0 0 0 2.7z"
        fill="none"
        stroke="currentColor"
        stroke-width="1.7"
        stroke-linecap="round"
        stroke-linejoin="round"
      ></path>
    )
  }
