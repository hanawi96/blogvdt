---
import { CART_MAX_LINES } from '../../features/cart/cart';
import type { StaffDiscountChoice } from '../../features/discounts/discounts';
import type { StaffLineInput, StoredOrderLine } from '../../features/orders/staff';
import { weightOptions, type WeightScale } from '../../features/products/weight';
import { formatVnd } from '../../lib/money';

interface Props {
  choices: { id: number; name: string; price: number; weightScale: WeightScale; active: boolean; coverUrl?: string | null; categorySlug?: string }[];
  lines: StaffLineInput[];
  stored: StoredOrderLine[];
  orderTotal?: string;
  discountCode?: string;
  discountChoices?: StaffDiscountChoice[];
  extraDiscount?: string;
  error?: string;
  allowEmpty?: boolean;
  cart?: boolean;
}

const {
  choices,
  lines,
  stored,
  orderTotal = '',
  discountCode = '',
  discountChoices = [],
  extraDiscount = '',
  error = '',
  allowEmpty = false,
  cart = false,
} = Astro.props;
const active = choices.filter((choice) => choice.active);
const canAdd = active.length > 0;
const totalAmount = Number(orderTotal.replace(/\D/g, ''));
const totalLabel = orderTotal.trim() && Number.isSafeInteger(totalAmount) ? formatVnd(totalAmount) : formatVnd(0);
const extraAmount = Number(extraDiscount.replace(/\D/g, ''));
const extraLabel = extraDiscount.trim() && Number.isSafeInteger(extraAmount) && extraAmount > 0 ? formatVnd(extraAmount) : formatVnd(0);
const selectedCode = discountCode.trim().toUpperCase();
const codeOptions =
  selectedCode && !discountChoices.some((choice) => choice.code === selectedCode)
    ? [{ code: selectedCode, kind: 'fixed' as const, value: 0, minSubtotal: 0 }, ...discountChoices]
    : discountChoices;

function discountOptionLabel(choice: StaffDiscountChoice): string {
  if (choice.value <= 0 && choice.kind === 'fixed') return choice.code;
  const deal = choice.kind === 'percent' ? `−${choice.value}%` : `−${formatVnd(choice.value)}`;
  return choice.minSubtotal > 0 ? `${choice.code} · ${deal} · từ ${formatVnd(choice.minSubtotal)}` : `${choice.code} · ${deal}`;
}

function choiceOf(productId: string) {
  return choices.find((choice) => String(choice.id) === productId);
}

function weightsFor(line: StaffLineInput): string[] {
  const choice = choiceOf(line.productId);
  const labels = choice ? [...weightOptions(choice.weightScale)] : [];
  if (line.weight && !labels.includes(line.weight)) labels.unshift(line.weight);
  return labels;
}

function shownName(line: StaffLineInput): string {
  if (typeof line.name === 'string') return line.name;
  const source = /^\d+$/.test(line.slot) ? stored[Number(line.slot)] : undefined;
  if (source) return source.productName;
  return choiceOf(line.productId)?.name ?? '';
}

function keptPrice(line: StaffLineInput): number | null {
  if (!/^\d+$/.test(line.slot)) return null;
  const source = stored[Number(line.slot)];
  if (!source) return null;
  const productId = line.productId.trim() ? Number(line.productId) : null;
  if (source.productId !== productId || (source.optionLabel ?? '') !== line.weight.trim()) return null;
  return source.unitPrice;
}

function coverOf(line: StaffLineInput): string {
  return choiceOf(line.productId)?.coverUrl ?? '';
}
---

<div
  class:list={['staff-lines-wrap', cart && 'staff-lines-cart']}
  data-order-lines
  data-max={CART_MAX_LINES}
  data-add={canAdd ? '1' : '0'}
  data-allow-empty={allowEmpty ? '1' : undefined}
  data-cart={cart ? '1' : undefined}
>
  <pre hidden data-order-choices>{JSON.stringify(choices).replace(/</g, '\\u003c')}</pre>
  <pre hidden data-discount-choices>{JSON.stringify(discountChoices).replace(/</g, '\\u003c')}</pre>
  <ul class="staff-lines" data-line-list>
    {
      lines.map((line) => {
        const labels = weightsFor(line);
        const source = /^\d+$/.test(line.slot) ? stored[Number(line.slot)] : undefined;
        const name = shownName(line);
        const pickProduct = line.productId === '' && name === '';
        const automatic = keptPrice(line) ?? choiceOf(line.productId)?.price ?? null;
        const priceText = line.price?.trim() || (automatic !== null ? String(automatic) : '');
        const priceAmount = Number(priceText.replace(/\D/g, ''));
        const priceLabel = priceText && Number.isSafeInteger(priceAmount) ? `Đơn giá ${formatVnd(priceAmount)}` : 'Đơn giá';
        const cover = coverOf(line);
        return (
          <li
            class="staff-line"
            data-line
            data-keep={source ? '1' : undefined}
            data-frozen-product={source ? (source.productId ? String(source.productId) : 'none') : undefined}
            data-frozen-weight={source ? (source.optionLabel ?? '') : undefined}
            data-frozen-price={source ? String(source.unitPrice) : undefined}
          >
            <input type="hidden" name="lineSlot" value={line.slot} />
            <input type="hidden" name="lineProduct" data-product value={line.productId} />
            {cart ? (
              <div class="staff-line-card">
                <div class="staff-line-photo-wrap">
                  {cover ? (
                    <img class="staff-line-photo" src={cover} alt="" width="56" height="56" loading="lazy" decoding="async" data-line-photo />
                  ) : (
                    <span class="staff-line-photo" aria-hidden="true" data-line-photo></span>
                  )}
                </div>
                <div class="staff-line-main">
                  <div class="staff-line-top">
                    <label data-product-pick hidden={!pickProduct}>
                      <span class="sr-only">Sản phẩm</span>
                      <select class="field" data-product-select>
                        <option value="">Chọn sản phẩm</option>
                        {active.map((choice) => <option value={choice.id}>{choice.name}</option>)}
                      </select>
                    </label>
                    <label class="staff-line-name" data-name-field hidden={pickProduct}>
                      <span class="sr-only">Sản phẩm</span>
                      <input class="field staff-line-name-input" name="lineName" data-line-name maxlength="160" autocomplete="off" value={name} hidden={pickProduct} />
                    </label>
                    <button class="staff-line-remove" type="button" data-remove-line aria-label="Xóa sản phẩm" hidden={lines.length < 2 && !allowEmpty}>
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" /></svg>
                    </button>
                  </div>
                  <div class="staff-line-mid">
                    <div class="staff-line-tags">
                      <label class="staff-line-chip" data-weight-field hidden={labels.length === 0}>
                        <span class="sr-only">Cân nặng</span>
                        <input
                          class="field staff-line-chip-weight"
                          type="text"
                          name="lineWeight"
                          data-weight
                          maxlength="40"
                          autocomplete="off"
                          placeholder="Cân"
                          value={line.weight}
                        />
                      </label>
                      <div class="staff-line-chip staff-line-qty-chip" data-qty-stepper>
                        <button class="staff-line-qty-btn" type="button" data-qty-dec aria-label="Giảm số lượng">
                          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14" /></svg>
                        </button>
                        <input
                          class="field staff-line-chip-qty"
                          type="number"
                          name="lineQuantity"
                          data-qty
                          min="1"
                          max="20"
                          required
                          inputmode="numeric"
                          aria-label="Số lượng"
                          value={line.quantity || '1'}
                        />
                        <button class="staff-line-qty-btn" type="button" data-qty-inc aria-label="Tăng số lượng">
                          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
                        </button>
                      </div>
                    </div>
                    <div class="staff-line-price">
                      <button class="staff-money-text" type="button" data-money-text>{priceLabel}</button>
                      <input class="field" name="linePrice" data-line-price inputmode="numeric" maxlength="8" autocomplete="off" value={priceText} hidden />
                    </div>
                  </div>
                  <label class="staff-line-note">
                    <span class="od-label">Lưu ý sản phẩm</span>
                    <input class="field" name="lineNote" data-line-note maxlength="160" placeholder="Ví dụ: gói riêng, kèm thiệp" value={line.note ?? ''} />
                  </label>
                </div>
              </div>
            ) : (
              <>
                <label data-product-pick hidden={!pickProduct}>
                  <span class="od-label">Sản phẩm</span>
                  <select class="field" data-product-select>
                    <option value="">Chọn sản phẩm</option>
                    {active.map((choice) => <option value={choice.id}>{choice.name}</option>)}
                  </select>
                </label>
                <label data-name-field hidden={pickProduct}>
                  <span class="od-label">Sản phẩm</span>
                  <input class="field" name="lineName" data-line-name maxlength="160" autocomplete="off" value={name} hidden={pickProduct} />
                </label>
                <label data-weight-field hidden={labels.length === 0}>
                  <span class="od-label">Cân nặng</span>
                  <select class="field" name="lineWeight" data-weight>
                    <option value="">Chọn cân nặng</option>
                    {labels.map((label) => <option value={label} selected={line.weight === label}>{label}</option>)}
                  </select>
                </label>
                <div class="staff-line-qty">
                  <label>
                    <span class="od-label">Số lượng</span>
                    <input class="field" type="number" name="lineQuantity" data-qty min="1" max="20" required value={line.quantity || '1'} />
                  </label>
                  <button class="staff-line-remove" type="button" data-remove-line aria-label="Xóa sản phẩm" hidden={lines.length < 2 && !allowEmpty}>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" /></svg>
                  </button>
                </div>
                <div class="staff-line-price">
                  <button class="staff-money-text" type="button" data-money-text>{priceLabel}</button>
                  <input class="field" name="linePrice" data-line-price inputmode="numeric" maxlength="8" autocomplete="off" value={priceText} hidden />
                </div>
                <input type="hidden" name="lineNote" value={line.note ?? ''} />
              </>
            )}
          </li>
        );
      })
    }
  </ul>
  <template data-line-template>
    <li class="staff-line" data-line>
      <input type="hidden" name="lineSlot" value="" />
      <input type="hidden" name="lineProduct" data-product value="" />
      {cart ? (
        <div class="staff-line-card">
          <div class="staff-line-photo-wrap">
            <span class="staff-line-photo" aria-hidden="true" data-line-photo></span>
          </div>
          <div class="staff-line-main">
            <div class="staff-line-top">
              <label data-product-pick>
                <span class="sr-only">Sản phẩm</span>
                <select class="field" data-product-select>
                  <option value="" selected>Chọn sản phẩm</option>
                  {active.map((choice) => <option value={choice.id}>{choice.name}</option>)}
                </select>
              </label>
              <label class="staff-line-name" data-name-field hidden>
                <span class="sr-only">Sản phẩm</span>
                <input class="field staff-line-name-input" name="lineName" data-line-name maxlength="160" autocomplete="off" value="" hidden />
              </label>
              <button class="staff-line-remove" type="button" data-remove-line aria-label="Xóa sản phẩm">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" /></svg>
              </button>
            </div>
            <div class="staff-line-mid">
              <div class="staff-line-tags">
                <label class="staff-line-chip" data-weight-field hidden>
                  <span class="sr-only">Cân nặng</span>
                  <input class="field staff-line-chip-weight" type="text" name="lineWeight" data-weight maxlength="40" autocomplete="off" placeholder="Cân" value="" />
                </label>
                <div class="staff-line-chip staff-line-qty-chip" data-qty-stepper>
                  <button class="staff-line-qty-btn" type="button" data-qty-dec aria-label="Giảm số lượng">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14" /></svg>
                  </button>
                  <input class="field staff-line-chip-qty" type="number" name="lineQuantity" data-qty min="1" max="20" required inputmode="numeric" aria-label="Số lượng" value="1" />
                  <button class="staff-line-qty-btn" type="button" data-qty-inc aria-label="Tăng số lượng">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
                  </button>
                </div>
              </div>
              <div class="staff-line-price">
                <button class="staff-money-text" type="button" data-money-text>Đơn giá</button>
                <input class="field" name="linePrice" data-line-price inputmode="numeric" maxlength="8" autocomplete="off" value="" hidden />
              </div>
            </div>
            <label class="staff-line-note">
              <span class="od-label">Lưu ý sản phẩm</span>
              <input class="field" name="lineNote" data-line-note maxlength="160" placeholder="Ví dụ: gói riêng, kèm thiệp" value="" />
            </label>
          </div>
        </div>
      ) : (
        <>
          <label data-product-pick>
            <span class="od-label">Sản phẩm</span>
            <select class="field" data-product-select>
              <option value="" selected>Chọn sản phẩm</option>
              {active.map((choice) => <option value={choice.id}>{choice.name}</option>)}
            </select>
          </label>
          <label data-name-field hidden>
            <span class="od-label">Sản phẩm</span>
            <input class="field" name="lineName" data-line-name maxlength="160" autocomplete="off" value="" hidden />
          </label>
          <label data-weight-field hidden>
            <span class="od-label">Cân nặng</span>
            <select class="field" name="lineWeight" data-weight>
              <option value="">Chọn cân nặng</option>
            </select>
          </label>
          <div class="staff-line-qty">
            <label>
              <span class="od-label">Số lượng</span>
              <input class="field" type="number" name="lineQuantity" data-qty min="1" max="20" required value="1" />
            </label>
            <button class="staff-line-remove" type="button" data-remove-line aria-label="Xóa sản phẩm">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" /></svg>
            </button>
          </div>
          <div class="staff-line-price">
            <button class="staff-money-text" type="button" data-money-text>Đơn giá</button>
            <input class="field" name="linePrice" data-line-price inputmode="numeric" maxlength="8" autocomplete="off" value="" hidden />
          </div>
          <input type="hidden" name="lineNote" value="" />
        </>
      )}
    </li>
  </template>
  {
    allowEmpty && (
      <p class="od-note" data-lines-empty hidden={lines.length > 0}>
        {cart ? 'Chưa có sản phẩm. Chọn mẫu bên phải, rồi thêm vào đơn.' : 'Chưa có sản phẩm. Chọn mẫu bên phải rồi bấm Thêm vào đơn.'}
      </p>
    )
  }
  <button class="btn mt-3" type="button" data-add-line hidden={allowEmpty || !canAdd || lines.length >= CART_MAX_LINES}>Thêm mẫu</button>
  <div class="staff-pay">
    <div class="staff-discount" data-staff-discount>
      <label class="staff-discount-code">
        <span class="od-label">Mã giảm giá</span>
        <select class="field" name="discountCode" data-discount-code>
          <option value="">Không dùng mã</option>
          {codeOptions.map((choice) => (
            <option value={choice.code} selected={choice.code === selectedCode}>
              {discountOptionLabel(choice)}
            </option>
          ))}
        </select>
      </label>
      <p class="error-text" data-discount-code-msg role="alert" hidden></p>
      <div class="staff-extra" data-staff-extra>
        <span class="od-label">Giảm thêm</span>
        <button class="staff-money-text staff-extra-text" type="button" data-money-text>{extraLabel}</button>
        <div class="staff-extra-edit" data-extra-edit hidden>
          <input class="field staff-extra-input" name="discountExtra" data-discount-extra inputmode="numeric" maxlength="8" autocomplete="off" value={extraDiscount} aria-label="Số tiền giảm thêm" />
          <div class="staff-extra-presets" data-extra-presets></div>
        </div>
      </div>
    </div>
    <p class="od-note" data-pay-sub hidden></p>
    <div class="staff-pay-ship" data-pay-ship hidden={!cart || lines.length === 0}>
      <span class="od-label">Phí ship</span>
      <strong data-pay-ship-fee>Miễn phí</strong>
    </div>
    <div class="staff-pay-total" data-pay-total hidden={cart && lines.length === 0}>
      <span data-pay-label>Tổng tiền</span>
      <button class="staff-money-text" type="button" data-money-text data-pay-payable>{totalLabel}</button>
      <input class="field staff-pay-input" name="orderTotal" data-order-total inputmode="numeric" maxlength="9" autocomplete="off" value={orderTotal} data-lock={orderTotal ? '1' : undefined} hidden />
    </div>
  </div>
  {error && <p class="error-text mt-3" role="alert">{error}</p>}
</div>

<script>
  import { quoteDiscount, type DiscountRule } from '../../features/discounts/quote';
  import { staffExtraRoundPresets } from '../../features/orders/staff';
  import { qualifiesFreeShip, shipGroupOf } from '../../features/shipping/customer-fee';
  import { WEIGHT_SCALES } from '../../features/products/weight';
  import { groupDigits } from '../../lib/group-digits';
  import { formatVnd } from '../../lib/money';

  const lineEditor = document.querySelector('[data-order-lines]');
  if (lineEditor instanceof HTMLElement) {
    const root = lineEditor;
    const choices = JSON.parse(root.querySelector('[data-order-choices]')?.textContent || '[]') as {
      id: number;
      name?: string;
      price: number;
      scale?: string;
      weightScale?: string;
      coverUrl?: string | null;
      categorySlug?: string;
    }[];
    const discountChoices = JSON.parse(root.querySelector('[data-discount-choices]')?.textContent || '[]') as {
      code: string;
      kind: 'percent' | 'fixed';
      value: number;
      minSubtotal: number;
    }[];
    const max = Number(root.dataset.max || '8');
    const allowAdd = root.dataset.add === '1';
    const allowEmpty = root.dataset.allowEmpty === '1';
    const list = root.querySelector('[data-line-list]');
    const template = root.querySelector('template');
    const add = root.querySelector('[data-add-line]');

    function codeRule(code: string): DiscountRule | null {
      const choice = discountChoices.find((item) => item.code === code);
      if (!choice) return null;
      return {
        code: choice.code,
        kind: choice.kind,
        value: choice.value,
        minSubtotal: choice.minSubtotal,
        usageLimit: null,
        usedCount: 0,
        startsAt: null,
        endsAt: null,
        active: true,
      };
    }

    function readCodeQuote(subtotal: number): { amount: number; label: string | null; error: string } {
      const select = root.querySelector('[data-discount-code]');
      if (!(select instanceof HTMLSelectElement) || !select.value) return { amount: 0, label: null, error: '' };
      const quoted = quoteDiscount(codeRule(select.value), subtotal, Date.now());
      if (!quoted.ok) return { amount: 0, label: null, error: quoted.error };
      return { amount: quoted.quote.discountAmount, label: quoted.quote.code, error: '' };
    }

    function syncCompensationDiscount() {
      const box = document.querySelector('[data-compensation]');
      const block = root.querySelector('[data-staff-discount]');
      if (!(block instanceof HTMLElement)) return;
      block.hidden = box instanceof HTMLInputElement && box.checked;
    }

    function rows(): HTMLElement[] {
      if (!(list instanceof HTMLElement)) return [];
      return [...list.querySelectorAll<HTMLElement>('[data-line]')];
    }

    function labelsFor(scale: string): readonly string[] {
      if (scale in WEIGHT_SCALES) return WEIGHT_SCALES[scale as keyof typeof WEIGHT_SCALES];
      return [];
    }

    function weightControl(row: HTMLElement): HTMLInputElement | HTMLSelectElement | null {
      const weight = row.querySelector('[data-weight]');
      return weight instanceof HTMLInputElement || weight instanceof HTMLSelectElement ? weight : null;
    }

    function unitOf(row: HTMLElement): number | null {
      const product = row.querySelector('[data-product]');
      const weight = weightControl(row);
      if (!(product instanceof HTMLInputElement) || !weight) return null;
      const choice = choices.find((item) => String(item.id) === product.value);
      const productKey = product.value || 'none';
      const frozen = Number(row.dataset.frozenPrice ?? '');
      const keep =
        row.dataset.keep === '1' &&
        row.dataset.frozenProduct === productKey &&
        (row.dataset.frozenWeight ?? '') === weight.value &&
        Number.isInteger(frozen);
      if (keep) return frozen;
      return typeof choice?.price === 'number' ? choice.price : null;
    }

    function moneyButton(input: HTMLInputElement): HTMLElement | null {
      const scope = input.closest('[data-staff-extra], .staff-line-price, .staff-pay-total') ?? input.parentElement;
      const node = scope?.querySelector('[data-money-text]');
      return node instanceof HTMLElement ? node : null;
    }

    function extraEditPanel(): HTMLElement | null {
      const node = root.querySelector('[data-extra-edit]');
      return node instanceof HTMLElement ? node : null;
    }

    function isEditingExtra(): boolean {
      const edit = extraEditPanel();
      return Boolean(edit && !edit.hidden);
    }

    function paintMoneyText(input: HTMLInputElement) {
      const text = moneyButton(input);
      if (!text) return;
      if (input.matches('[data-discount-extra]')) {
        if (isEditingExtra()) return;
      } else if (!input.hidden) return;
      const amount = digits(input.value);
      text.textContent = input.matches('[data-line-price]') ? (input.value.trim() ? `Đơn giá ${formatVnd(amount)}` : 'Đơn giá') : formatVnd(amount);
    }

    function paintExtraPresets(room: number) {
      const box = root.querySelector('[data-extra-presets]');
      const input = root.querySelector('[data-discount-extra]');
      if (!(box instanceof HTMLElement)) return;
      const selected = input instanceof HTMLInputElement ? digits(input.value) : 0;
      box.replaceChildren();
      for (const amount of staffExtraRoundPresets(room)) {
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'staff-extra-preset';
        button.dataset.extraPreset = String(amount);
        button.textContent = formatVnd(amount);
        button.setAttribute('aria-label', `Giảm thêm ${formatVnd(amount)}`);
        if (amount === selected) button.setAttribute('aria-pressed', 'true');
        box.appendChild(button);
      }
    }

    function editMoney(input: HTMLInputElement) {
      const text = moneyButton(input);
      if (!text) return;
      input.dataset.previous = input.value;
      text.hidden = true;
      if (input.matches('[data-discount-extra]')) {
        const edit = extraEditPanel();
        if (edit) edit.hidden = false;
        paintExtraPresets(goodsRoom());
        input.focus();
        input.select();
        return;
      }
      input.hidden = false;
      input.focus();
      input.select();
    }

    function closeMoney(input: HTMLInputElement) {
      if (input.matches('[data-discount-extra]')) {
        const edit = extraEditPanel();
        if (edit) edit.hidden = true;
        const text = moneyButton(input);
        if (text) text.hidden = false;
        paintMoneyText(input);
        return;
      }
      input.hidden = true;
      const text = moneyButton(input);
      if (text) text.hidden = false;
      paintMoneyText(input);
    }

    function goodsRoom(): number {
      const subtotal = rows().reduce((sum, row) => {
        const price = row.querySelector('[data-line-price]');
        const qty = row.querySelector('[data-qty]');
        if (!(price instanceof HTMLInputElement) || !(qty instanceof HTMLInputElement)) return sum;
        const quantity = Number(qty.value);
        if (!Number.isInteger(quantity) || quantity < 1) return sum;
        const unit = price.value.trim() ? digits(price.value) : (unitOf(row) ?? 0);
        return sum + unit * quantity;
      }, 0);
      return Math.max(0, subtotal - readCodeQuote(subtotal).amount);
    }

    function fillPrice(row: HTMLElement) {
      const input = row.querySelector('[data-line-price]');
      if (!(input instanceof HTMLInputElement)) return;
      const amount = unitOf(row);
      input.value = amount === null ? '' : groupDigits(String(amount), 8);
      closeMoney(input);
    }

    function digits(value: string): number {
      const text = value.replace(/\D/g, '');
      if (!text) return 0;
      const amount = Number(text);
      return Number.isSafeInteger(amount) ? amount : 0;
    }

    function emitShipRule() {
      if (root.dataset.cart !== '1') return;
      const shipLines = rows().flatMap((row) => {
        const product = row.querySelector('[data-product]');
        const price = row.querySelector('[data-line-price]');
        const qty = row.querySelector('[data-qty]');
        if (!(product instanceof HTMLInputElement) || !(price instanceof HTMLInputElement) || !(qty instanceof HTMLInputElement)) return [];
        if (!product.value) return [];
        const quantity = Number(qty.value);
        if (!Number.isInteger(quantity) || quantity < 1) return [];
        const unit = price.value.trim() ? digits(price.value) : (unitOf(row) ?? 0);
        const choice = choices.find((item) => String(item.id) === product.value);
        return [{ group: shipGroupOf(choice?.categorySlug), lineTotal: unit * quantity }];
      });
      document.dispatchEvent(new CustomEvent('staff-ship-recalc', { detail: { free: qualifiesFreeShip(shipLines) } }));
    }

    function readShipState(): { free: boolean; fee: number } {
      const free = document.querySelector('[data-free-ship]');
      const fee = document.querySelector('[data-ship-fee]');
      const freeOn = free instanceof HTMLInputElement && free.checked;
      if (freeOn) return { free: true, fee: 0 };
      const amount = fee instanceof HTMLInputElement ? digits(fee.value) : 0;
      return { free: false, fee: amount };
    }

    let paintingPay = false;
    function paintPay() {
      if (paintingPay) return;
      paintingPay = true;
      try {
        const subtotal = rows().reduce((sum, row) => {
          const price = row.querySelector('[data-line-price]');
          const qty = row.querySelector('[data-qty]');
          if (!(price instanceof HTMLInputElement) || !(qty instanceof HTMLInputElement)) return sum;
          const quantity = Number(qty.value);
          if (!Number.isInteger(quantity) || quantity < 1) return sum;
          const unit = price.value.trim() ? digits(price.value) : (unitOf(row) ?? 0);
          return sum + unit * quantity;
        }, 0);
        const totalInput = root.querySelector('[data-order-total]');
        const extraInput = root.querySelector('[data-discount-extra]');
        const codeMsg = root.querySelector('[data-discount-code-msg]');
        const locked = totalInput instanceof HTMLInputElement && totalInput.dataset.lock === '1';
        const code = readCodeQuote(subtotal);
        if (codeMsg instanceof HTMLElement) {
          codeMsg.hidden = !code.error;
          codeMsg.textContent = code.error;
        }
        const room = Math.max(0, subtotal - code.amount);
        const editingExtra = isEditingExtra();
        let extra = extraInput instanceof HTMLInputElement ? digits(extraInput.value) : 0;
        let over = '';
        if (locked && totalInput instanceof HTMLInputElement) {
          const shownTotal = digits(totalInput.value);
          if (shownTotal > subtotal) over = 'Tổng lớn hơn tạm tính. Hãy tăng đơn giá.';
          else if (shownTotal > room) over = 'Tổng lớn hơn số sau mã giảm giá.';
          else extra = room - shownTotal;
        } else {
          extra = Math.min(extra, room);
          if (totalInput instanceof HTMLInputElement) totalInput.value = groupDigits(String(room - extra), 9);
        }
        if (extraInput instanceof HTMLInputElement && !editingExtra && !over) {
          extraInput.value = extra > 0 ? groupDigits(String(extra), 8) : '';
          paintMoneyText(extraInput);
        }
        if (editingExtra) paintExtraPresets(room);
        const sub = root.querySelector('[data-pay-sub]');
        if (sub instanceof HTMLElement) {
          // Mã/giảm thêm đã hiện ở hàng riêng và tổng tiền; chỉ báo khi tổng gõ tay lệch.
          sub.hidden = !over;
          sub.textContent = over;
        }
        // Quy tắc ship cập nhật checkbox/phí trước, rồi mới cộng vào tổng hiển thị.
        // orderTotal gửi lên server vẫn là tiền hàng (ship cộng lúc lưu đơn).
        emitShipRule();
        const ship = readShipState();
        const goodsPayable = totalInput instanceof HTMLInputElement ? digits(totalInput.value) : Math.max(0, room - extra);
        const hasLines = rows().some((row) => {
          const product = row.querySelector('[data-product]');
          return product instanceof HTMLInputElement && product.value !== '';
        });
        const shipRow = root.querySelector('[data-pay-ship]');
        const totalRow = root.querySelector('[data-pay-total]');
        const shipFeeOut = root.querySelector('[data-pay-ship-fee]');
        const showShipSummary = root.dataset.cart === '1' && hasLines;
        if (shipRow instanceof HTMLElement) shipRow.hidden = !showShipSummary;
        if (totalRow instanceof HTMLElement) totalRow.hidden = root.dataset.cart === '1' && !hasLines;
        if (shipFeeOut) shipFeeOut.textContent = ship.free ? 'Miễn phí' : formatVnd(ship.fee);
        const payableOut = root.querySelector('[data-pay-payable]');
        const payable = goodsPayable + (showShipSummary ? ship.fee : 0);
        if (payableOut instanceof HTMLElement && (!(totalInput instanceof HTMLInputElement) || totalInput.hidden)) {
          payableOut.textContent = formatVnd(payable);
          payableOut.dataset.amount = String(payable);
        } else if (totalInput instanceof HTMLInputElement) {
          paintMoneyText(totalInput);
          if (payableOut instanceof HTMLElement) payableOut.dataset.amount = String(payable);
        }
        document.dispatchEvent(new Event('staff-pay-updated'));
      } finally {
        paintingPay = false;
      }
    }

    function setCover(row: HTMLElement, url: string) {
      const photo = row.querySelector('[data-line-photo]');
      if (!(photo instanceof HTMLElement)) return;
      if (!url) {
        if (photo instanceof HTMLImageElement) {
          const blank = document.createElement('span');
          blank.className = 'staff-line-photo';
          blank.setAttribute('aria-hidden', 'true');
          blank.setAttribute('data-line-photo', '');
          photo.replaceWith(blank);
        }
        return;
      }
      if (photo instanceof HTMLImageElement) {
        photo.src = url;
        return;
      }
      const image = document.createElement('img');
      image.className = 'staff-line-photo';
      image.src = url;
      image.alt = '';
      image.width = 56;
      image.height = 56;
      image.loading = 'lazy';
      image.decoding = 'async';
      image.setAttribute('data-line-photo', '');
      photo.replaceWith(image);
    }

    function revealName(row: HTMLElement, productId: string) {
      const product = row.querySelector('[data-product]');
      const name = row.querySelector('[data-line-name]');
      const pick = row.querySelector('[data-product-pick]');
      const nameField = row.querySelector('[data-name-field]');
      if (!(product instanceof HTMLInputElement)) return;
      product.value = productId;
      const choice = choices.find((item) => String(item.id) === productId);
      if (name instanceof HTMLInputElement && choice?.name) name.value = choice.name;
      if (name instanceof HTMLInputElement) name.hidden = false;
      if (nameField instanceof HTMLElement) nameField.hidden = false;
      if (pick instanceof HTMLElement) pick.hidden = true;
      setCover(row, choice?.coverUrl ?? '');
    }

    function refill(row: HTMLElement, preferred = '') {
      const product = row.querySelector('[data-product]');
      const weight = weightControl(row);
      const field = row.querySelector('[data-weight-field]');
      if (!(product instanceof HTMLInputElement) || !weight || !(field instanceof HTMLElement)) return;
      const choice = choices.find((item) => String(item.id) === product.value);
      const labels = [...labelsFor(choice?.weightScale ?? choice?.scale ?? '')];
      const selected = preferred || weight.value;
      if (weight instanceof HTMLInputElement) {
        if (labels.length === 0 && !selected) {
          field.hidden = true;
          weight.value = '';
          return;
        }
        field.hidden = false;
        weight.value = selected;
        return;
      }
      if (selected && !labels.includes(selected)) labels.unshift(selected);
      weight.replaceChildren();
      if (labels.length === 0 && !selected) {
        field.hidden = true;
        weight.value = '';
        return;
      }
      field.hidden = false;
      weight.add(new Option('Chọn cân nặng', ''));
      for (const label of labels) weight.add(new Option(label, label, false, label === selected));
      if (selected) weight.value = selected;
    }

    function syncAdd() {
      const count = rows().length;
      if (add instanceof HTMLButtonElement) add.hidden = allowEmpty || !allowAdd || count >= max;
      for (const row of rows()) {
        const remove = row.querySelector('[data-remove-line]');
        if (remove instanceof HTMLButtonElement) remove.hidden = !allowEmpty && count < 2;
      }
      const empty = root.querySelector('[data-lines-empty]');
      if (empty instanceof HTMLElement) empty.hidden = count > 0;
    }

    function unlockTotal() {
      const total = root.querySelector('[data-order-total]');
      if (total instanceof HTMLInputElement) delete total.dataset.lock;
    }

    /** Dòng cùng sản phẩm + cùng cân + cùng lưu ý (để gộp số lượng thay vì tạo dòng mới). */
    function findMergeRow(productId: string, weightValue: string, note: string): HTMLElement | null {
      if (!productId) return null;
      for (const row of rows()) {
        const product = row.querySelector('[data-product]');
        const weight = weightControl(row);
        const noteInput = row.querySelector('[data-line-note]') ?? row.querySelector('input[name="lineNote"]');
        if (!(product instanceof HTMLInputElement) || !weight) continue;
        const rowNote = noteInput instanceof HTMLInputElement ? noteInput.value.trim() : '';
        if (product.value === productId && weight.value.trim() === weightValue.trim() && rowNote === note.trim()) return row;
      }
      return null;
    }

    /** Gộp vào dòng sẵn có: tăng số lượng, chặn theo max của ô số lượng. Trả về false nếu không gộp được. */
    function mergeIntoRow(row: HTMLElement, addQuantity: number): boolean {
      const qty = row.querySelector('[data-qty]');
      if (!(qty instanceof HTMLInputElement)) return false;
      const max = Number(qty.max || '20');
      const current = Number(qty.value);
      const base = Number.isInteger(current) && current >= 1 ? current : 1;
      const next = Math.min(max, base + Math.max(1, addQuantity));
      if (next === base) return false;
      qty.value = String(next);
      qty.dispatchEvent(new Event('input', { bubbles: true }));
      return true;
    }

    function appendLine(
      productId: string,
      weightValue = '',
      focus = true,
      extras: { quantity?: string; note?: string; cover?: string } = {},
    ): boolean {
      if (!(list instanceof HTMLElement) || !(template instanceof HTMLTemplateElement) || rows().length >= max) return false;
      const source = template.content.querySelector('[data-line]');
      if (!(source instanceof HTMLElement)) return false;
      const copy = source.cloneNode(true);
      if (!(copy instanceof HTMLElement)) return false;
      list.appendChild(copy);
      const weight = weightControl(copy);
      const qty = copy.querySelector('[data-qty]');
      const note = copy.querySelector('[data-line-note]') ?? copy.querySelector('input[name="lineNote"]');
      if (productId) {
        revealName(copy, productId);
        refill(copy, weightValue);
        if (weight && weightValue) weight.value = weightValue;
        fillPrice(copy);
        if (extras.cover) setCover(copy, extras.cover);
      }
      if (qty instanceof HTMLInputElement && extras.quantity) qty.value = extras.quantity;
      if (note instanceof HTMLInputElement && typeof extras.note === 'string') note.value = extras.note;
      syncAdd();
      unlockTotal();
      paintPay();
      if (!focus) return true;
      const weightField = copy.querySelector('[data-weight-field]');
      if (weightField instanceof HTMLElement && !weightField.hidden && weight && !weightValue) {
        weight.focus();
        if (weight instanceof HTMLInputElement) weight.select();
      } else if (!productId) {
        const pick = copy.querySelector('[data-product-select]');
        if (pick instanceof HTMLSelectElement) pick.focus();
      }
      return true;
    }

    root.addEventListener('change', (event) => {
      const target = event.target;
      if (!(target instanceof HTMLElement)) return;
      const row = target.closest('[data-line]');
      if (row instanceof HTMLElement) {
        if (target.matches('[data-product-select]') && target instanceof HTMLSelectElement && target.value) {
          revealName(row, target.value);
          refill(row);
          fillPrice(row);
        } else if (target.matches('[data-weight]')) fillPrice(row);
      }
      if (!(target instanceof HTMLInputElement && target.matches('[data-order-total]'))) unlockTotal();
      paintPay();
    });

    root.addEventListener('input', (event) => {
      const target = event.target;
      if (!(target instanceof HTMLInputElement)) return;
      if (target.matches('[data-order-total]')) {
        target.dataset.lock = '1';
        paintPay();
        return;
      }
      if (target.matches('[data-line-price]') || target.matches('[data-qty]') || target.matches('[data-discount-extra]')) {
        unlockTotal();
        paintPay();
      }
      if (target.matches('[data-weight]')) {
        const row = target.closest('[data-line]');
        if (row instanceof HTMLElement) fillPrice(row);
        unlockTotal();
        paintPay();
      }
    });

    root.addEventListener('keydown', (event) => {
      const target = event.target;
      if (!(target instanceof HTMLInputElement)) return;
      if (!target.matches('[data-line-price]') && !target.matches('[data-order-total]') && !target.matches('[data-discount-extra]')) return;
      if (event.key === 'Enter') {
        event.preventDefault();
        target.blur();
      } else if (event.key === 'Escape') {
        event.preventDefault();
        if (typeof target.dataset.previous === 'string') target.value = target.dataset.previous;
        target.blur();
      }
    });

    root.addEventListener('focusout', (event) => {
      const target = event.target;
      if (!(target instanceof HTMLInputElement)) return;
      if (!target.matches('[data-line-price]') && !target.matches('[data-order-total]') && !target.matches('[data-discount-extra]')) return;
      if (target.matches('[data-discount-extra]')) {
        const next = event.relatedTarget;
        if (next instanceof Node && target.closest('[data-staff-extra]')?.contains(next)) return;
      }
      closeMoney(target);
      paintPay();
    });

    root.addEventListener('mousedown', (event) => {
      const button = event.target instanceof Element ? event.target.closest('[data-extra-preset]') : null;
      if (button instanceof HTMLButtonElement) event.preventDefault();
    });

    root.addEventListener('click', (event) => {
      const button = event.target instanceof Element ? event.target.closest('button') : null;
      if (!(button instanceof HTMLButtonElement)) return;
      if (button.hasAttribute('data-money-text')) {
        const scope = button.closest('[data-staff-extra], .staff-line-price, .staff-pay-total') ?? button.parentElement;
        const input = scope?.querySelector('input');
        if (input instanceof HTMLInputElement) editMoney(input);
        return;
      }
      if (button.hasAttribute('data-extra-preset')) {
        const input = root.querySelector('[data-discount-extra]');
        if (!(input instanceof HTMLInputElement)) return;
        const amount = Number(button.dataset.extraPreset);
        if (!Number.isSafeInteger(amount) || amount < 1) return;
        input.value = groupDigits(String(amount), 8);
        unlockTotal();
        closeMoney(input);
        paintPay();
        return;
      }
      if (button.hasAttribute('data-qty-dec') || button.hasAttribute('data-qty-inc')) {
        const row = button.closest('[data-line]');
        const input = row?.querySelector('[data-qty]');
        if (!(input instanceof HTMLInputElement)) return;
        const min = Number(input.min || '1');
        const max = Number(input.max || '20');
        let next = Number(input.value);
        if (!Number.isInteger(next)) next = min;
        next = button.hasAttribute('data-qty-inc') ? next + 1 : next - 1;
        input.value = String(Math.min(max, Math.max(min, next)));
        input.dispatchEvent(new Event('input', { bubbles: true }));
        return;
      }
      if (button.hasAttribute('data-remove-line')) {
        if (!allowEmpty && rows().length < 2) return;
        button.closest('[data-line]')?.remove();
        syncAdd();
        unlockTotal();
        paintPay();
        return;
      }
      if (button.hasAttribute('data-add-line')) appendLine('');
    });

    document.addEventListener('staff-add-product', (event) => {
      if (!(event instanceof CustomEvent)) return;
      const detail = event.detail;
      if (typeof detail === 'string') appendLine(detail);
      else if (detail && typeof detail === 'object' && 'id' in detail && typeof detail.id === 'string') {
        const weight = 'weight' in detail && typeof detail.weight === 'string' ? detail.weight : '';
        const focus = !('focus' in detail) || detail.focus !== false;
        const quantity = 'quantity' in detail && typeof detail.quantity === 'string' ? detail.quantity : undefined;
        const note = 'note' in detail && typeof detail.note === 'string' ? detail.note : undefined;
        const cover = 'cover' in detail && typeof detail.cover === 'string' ? detail.cover : undefined;
        // Cùng sản phẩm + cùng cân + cùng lưu ý: gộp vào dòng sẵn có thay vì tạo dòng mới.
        const addQty = quantity && /^\d+$/.test(quantity) ? Number(quantity) : 1;
        const existing = findMergeRow(detail.id, weight, note ?? '');
        if (existing && mergeIntoRow(existing, addQty)) return;
        appendLine(detail.id, weight, focus, { quantity, note, cover });
      }
    });

    document.addEventListener('change', (event) => {
      const target = event.target;
      if (!(target instanceof HTMLElement)) return;
      if (!target.matches('[data-free-ship], [data-ship-fee], [data-compensation]')) return;
      syncCompensationDiscount();
      paintPay();
    });

    syncCompensationDiscount();
    syncAdd();
    paintPay();
  }
</script>
