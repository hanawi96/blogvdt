---
import PostEditor from './PostEditor.svelte';
import SlugField from './SlugField.svelte';
import type { FieldErrors } from '../../lib/validation/errors';

interface Values {
  title: string;
  slug: string;
  categoryId: string;
  coverMediaId: string;
  contentJson: string;
  seoTitle: string;
  metaDescription: string;
  status: string;
}

interface Props {
  csrf: string;
  action: string;
  values: Values;
  errors: FieldErrors;
  formError: string;
  categories: { id: number; name: string }[];
  covers: { id: number; filename: string }[];
  deleteAction?: string;
}

const { csrf, action, values, errors, formError, categories, covers, deleteAction } = Astro.props;
---

<form class="max-w-3xl" method="post" action={action} data-busy>
  <input type="hidden" name="csrf" value={csrf} />
  {formError && <p class="error-text mb-4" role="alert">{formError}</p>}
  <SlugField client:load title={values.title} slug={values.slug} titleError={errors.title ?? ''} slugError={errors.slug ?? ''} />
  <label class="mt-4 block">
    <span class="mb-1 block font-semibold">Danh mục</span>
    <select class="field" name="categoryId">
      <option value="">Không chọn</option>
      {categories.map((category) => <option value={category.id} selected={values.categoryId === String(category.id)}>{category.name}</option>)}
    </select>
    {errors.categoryId && <span class="error-text">{errors.categoryId}</span>}
  </label>
  <label class="mt-4 block">
    <span class="mb-1 block font-semibold">Ảnh đại diện</span>
    <select class="field" name="coverMediaId">
      <option value="">Không chọn</option>
      {covers.map((cover) => <option value={cover.id} selected={values.coverMediaId === String(cover.id)}>{cover.filename}</option>)}
    </select>
    {errors.coverMediaId && <span class="error-text">{errors.coverMediaId}</span>}
  </label>
  <PostEditor client:load csrf={csrf} contentJson={values.contentJson} contentError={errors.contentJson ?? ''} />
  <label class="mt-4 block">
    <span class="mb-1 block font-semibold">SEO title</span>
    <input class="field" name="seoTitle" maxlength="180" value={values.seoTitle} />
    {errors.seoTitle && <span class="error-text">{errors.seoTitle}</span>}
  </label>
  <label class="mt-4 block">
    <span class="mb-1 block font-semibold">Mô tả SEO</span>
    <textarea class="field min-h-24" name="metaDescription" maxlength="300">{values.metaDescription}</textarea>
    {errors.metaDescription && <span class="error-text">{errors.metaDescription}</span>}
  </label>
  <label class="mt-4 block">
    <span class="mb-1 block font-semibold">Trạng thái</span>
    <select class="field" name="status">
      <option value="draft" selected={values.status === 'draft'}>Bản nháp</option>
      <option value="published" selected={values.status === 'published'}>Đã xuất bản</option>
    </select>
    {errors.status && <span class="error-text">{errors.status}</span>}
  </label>
  <button class="btn btn-primary mt-6" type="submit">Lưu bài viết</button>
</form>
{
  deleteAction && (
    <form class="mt-4" method="post" action={deleteAction} onsubmit="return confirm('Xóa bài viết này?')">
      <input type="hidden" name="csrf" value={csrf} />
      <button class="btn btn-accent" type="submit">Xóa bài viết</button>
    </form>
  )
}
