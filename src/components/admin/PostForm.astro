---
import MediaPicker from './MediaPicker.svelte';
import PostEditor from './PostEditor.svelte';
import type { MediaItem } from '../../features/media/types';
import SearchPreview from './SearchPreview.astro';
import SeoChecklist from './SeoChecklist.svelte';
import SlugField from './SlugField.svelte';
import { lengthNote, metaDuplicateNote, SEO_DESC_RANGE, SEO_TITLE_RANGE } from '../../features/posts/seo-check';
import type { MetaCorpus } from '../../lib/seo/meta';
import { formatDateTime, formatTimeHm } from '../../lib/datetime';
import RetiredUrlDialog from './RetiredUrlDialog.astro';
import { routes } from '../../lib/routes';
import type { FieldErrors } from '../../lib/validation/errors';

interface Values {
  title: string;
  slug: string;
  categoryIds: string[];
  coverMediaId: string;
  contentJson: string;
  seoTitle: string;
  metaDescription: string;
  excerpt: string;
  status: string;
}


interface Meta {
  createdAt: number;
  updatedAt: number;
  publishedAt: number | null;
}

interface SeoSite {
  name: string;
  host: string;
  markUrl: string;
}

interface Props {
  csrf: string;
  action: string;
  values: Values;
  errors: FieldErrors;
  formError: string;
  categories: { id: number; name: string }[];
  media: MediaItem[];
  site: SeoSite;
  postId?: number;
  saved?: boolean;
  meta?: Meta;
  deleteAction?: string;
  livePublished?: boolean;
  corpus?: MetaCorpus;
  targets?: { title: string; path: string }[];
}

const { csrf, action, values, errors, formError, categories, media, site, postId, saved = false, meta, deleteAction, livePublished = false, corpus = { titles: [], descriptions: [] }, targets = [] } = Astro.props;
const publishLabel = values.status === 'published' ? 'Cập nhật' : 'Xuất bản';
const wasPublic = livePublished || meta?.publishedAt != null;
const selectedCategoryIds = new Set(values.categoryIds);
const saveStatus = formError
  ? 'Lưu thất bại'
  : values.status === 'draft' && meta
    ? `Đã lưu · ${formatTimeHm(meta.updatedAt)}`
    : saved
      ? 'Đã lưu'
      : '';
const saveState = formError ? 'error' : values.status === 'draft' && meta ? 'saved' : saved ? 'saved' : '';
const previewTitle = values.seoTitle || values.title || 'Tiêu đề bài viết';
const previewDescription = values.metaDescription || values.excerpt || 'Thêm mô tả SEO hoặc tóm tắt để xem trước đoạn này.';
const previewSlug = values.slug || 'duong-dan';
const titleLengthNote = lengthNote(values.seoTitle.length, SEO_TITLE_RANGE.min, SEO_TITLE_RANGE.max);
const descriptionLengthNote = lengthNote(values.metaDescription.length, SEO_DESC_RANGE.min, SEO_DESC_RANGE.max);
const duplicateNote = metaDuplicateNote(values.seoTitle || values.title, values.metaDescription || values.excerpt, corpus);
const autosave = values.status === 'draft' ? 'on' : 'off';
---

<form id="post-form" class="post-write" method="post" action={action} data-busy data-post-form data-autosave={autosave} data-live-published={livePublished ? '1' : '0'} data-site-host={site.host} data-post-id={postId ?? ''}>
  <script is:inline>
    (() => {
      try {
        if (localStorage.getItem('post-write-focus') === '1') {
          document.currentScript?.parentElement?.classList.add('is-focus');
        }
      } catch {
        /* private mode */
      }
    })();
  </script>
  <input type="hidden" name="csrf" value={csrf} />
  <input type="hidden" name="urlAction" value="" />
  <input type="hidden" name="urlTarget" value="" />
  <input type="hidden" name="updatedAt" value={meta ? String(meta.updatedAt) : ''} />
  {postId ? <input type="hidden" name="postId" value={String(postId)} /> : null}
  <button class="sr-only" type="submit" tabindex="-1" data-keep-label="true">Lưu trạng thái hiện tại</button>
  <div class="post-bar">
    <a class="btn btn-compact" href={routes.adminPosts}>Danh sách</a>
    <p class="post-save" role="status" aria-live="polite" data-save-status data-state={saveState || undefined}>{saveStatus}</p>
    <div class="post-bar-actions">
      <button
        class="btn btn-compact"
        id="focus-write"
        type="button"
        data-focus-write
        aria-pressed="false"
        title="Ẩn cột phụ để tập trung viết"
      >Chỉ viết</button>
      <button
        class="btn btn-compact"
        id="preview-post"
        type="button"
        data-preview-toggle
        aria-pressed="false"
        title="Xem trước cạnh trình soạn thảo"
      >Xem trước</button>
      <button
        class="sr-only"
        id="preview-submit"
        type="submit"
        formmethod="post"
        formaction={routes.adminPostPreview}
        formtarget="post-preview-frame"
        tabindex="-1"
        data-keep-label="true"
      >Làm mới xem trước</button>
      <button class="btn btn-compact" id="save-draft" type="submit" data-keep-label="true" hidden={values.status === 'published'}>Lưu nháp</button>
      <button class="btn btn-compact btn-primary" id="save-publish" type="submit" data-keep-label="true">{publishLabel}</button>
      <button class="btn btn-compact" id="unpublish-post" type="submit" data-keep-label="true" data-retire="unpublish" data-retire-form="post-form" hidden={values.status !== 'published'}>Gỡ xuất bản</button>
    </div>
  </div>
  {formError && <p class="error-text" role="alert">{formError}</p>}
  <input type="hidden" name="embed" value="1" disabled data-preview-embed />
  <div class="post-workspace">
  <div class="post-columns">
    <div class="post-main">
      <div class="post-canvas">
        <div class="post-title-block">
          <label class="sr-only" for="post-title">Tiêu đề</label>
          <input
            id="post-title"
            class="post-title-input"
            name="title"
            required
            maxlength="180"
            value={values.title}
            placeholder="Tiêu đề bài viết…"
            autocomplete="off"
            autofocus={!values.title}
          />
          {errors.title && <span class="error-text post-title-error">{errors.title}</span>}
        </div>
        <PostEditor client:load {csrf} {media} contentJson={values.contentJson} contentError={errors.contentJson ?? ''} />
      </div>
      <label class="mt-6 block">
        <span class="mb-1 block font-semibold">Tóm tắt</span>
        <textarea class="field min-h-24" name="excerpt" maxlength="300" placeholder="Để trống sẽ lấy đoạn đầu của bài.">{values.excerpt}</textarea>
        {errors.excerpt && <span class="error-text">{errors.excerpt}</span>}
      </label>
      <section class="post-card seo-card mt-6">
        <div class="seo-head">
          <div>
            <h2>Tối ưu hiển thị trên Google</h2>
            <p>Kiểm tra cách bài viết có thể xuất hiện trên trang kết quả tìm kiếm.</p>
          </div>
          <span class="seo-badge">SEO</span>
        </div>
        <SearchPreview
          site={site}
          title={previewTitle}
          description={previewDescription}
          slug={previewSlug}
          emptyDescription={!values.metaDescription && !values.excerpt}
          corpus={corpus}
        />
        <label class="mt-4 block">
          <span class="seo-label">
            <span>SEO Title</span>
            <span data-seo-title-count>{values.seoTitle.length} ký tự</span>
          </span>
          <input class="field" name="seoTitle" maxlength="180" value={values.seoTitle} />
          <span class="seo-hint">Nếu để trống, hệ thống sử dụng tiêu đề bài viết.</span>
          <span class="seo-hint" data-seo-title-note>{titleLengthNote}</span>
          {errors.seoTitle && <span class="error-text">{errors.seoTitle}</span>}
        </label>
        <label class="mt-4 block">
          <span class="seo-label">
            <span>Meta Description</span>
            <span data-seo-desc-count>{values.metaDescription.length} ký tự</span>
          </span>
          <textarea class="field min-h-24" name="metaDescription" maxlength="300">{values.metaDescription}</textarea>
          <span class="seo-hint">Nếu để trống, hệ thống dùng tóm tắt. Nên khoảng 70–160 ký tự.</span>
          <span class="seo-hint" data-seo-desc-note>{descriptionLengthNote}</span>
          <span class="seo-hint" data-seo-duplicate-note>{duplicateNote}</span>
          {errors.metaDescription && <span class="error-text">{errors.metaDescription}</span>}
        </label>
      </section>
    </div>
    <aside class="post-side">
      <section class="post-card">
        <h2 class="post-card-title">Xuất bản</h2>
        <label class="mt-3 block">
          <span class="sr-only">Trạng thái</span>
          <select class="field" id="post-status" name="status">
            <option value="draft" selected={values.status === 'draft'}>Bản nháp</option>
            <option value="published" selected={values.status === 'published'}>Đã xuất bản</option>
          </select>
          {errors.status && <span class="error-text">{errors.status}</span>}
        </label>
      </section>
      <section class="post-card">
        <h2 class="post-card-title">Danh mục</h2>
        {categories.length === 0 ? (
          <p class="mt-3 text-sm text-muted">Chưa có danh mục. Tạo trong mục Danh mục.</p>
        ) : (
          <div class="category-presets mt-3" role="group" aria-label="Chọn danh mục">
            {categories.map((category) => (
              <label class="category-preset">
                <input
                  type="checkbox"
                  name="categoryIds"
                  value={category.id}
                  checked={selectedCategoryIds.has(String(category.id))}
                />
                <span>{category.name}</span>
              </label>
            ))}
          </div>
        )}
        {(errors.categoryIds || errors.categoryId) && (
          <span class="error-text">{errors.categoryIds || errors.categoryId}</span>
        )}
      </section>
      <section class="post-card">
        <h2 class="post-card-title">Ảnh đại diện</h2>
        <MediaPicker client:load {csrf} items={media} name="coverMediaId" selected={values.coverMediaId ? [values.coverMediaId] : []} editAlt />
        {errors.coverMediaId && <span class="error-text">{errors.coverMediaId}</span>}
      </section>
      <section class="post-card">
        <h2 class="post-card-title">Đường dẫn</h2>
        <div class="mt-3">
          <SlugField client:load titleInput="post-title" slug={values.slug} slugError={errors.slug ?? ''} />
          <p class="mt-2 text-sm text-muted">Slug chỉ tự tạo khi ô này còn trống. Đổi slug bài đã xuất bản sẽ chuyển hướng 301.</p>
        </div>
      </section>
      <SeoChecklist client:load siteName={site.name} host={site.host} publishedAt={meta?.publishedAt ?? null} corpus={corpus} />
      {
        meta && (
          <section class="post-card">
            <h2 class="post-card-title">Thông tin</h2>
            <dl class="post-meta">
              <div>
                <dt>Tạo</dt>
                <dd>{formatDateTime(meta.createdAt)}</dd>
              </div>
              <div>
                <dt>Cập nhật</dt>
                <dd>{formatDateTime(meta.updatedAt)}</dd>
              </div>
              <div>
                <dt>Xuất bản</dt>
                <dd>{meta.publishedAt ? formatDateTime(meta.publishedAt) : 'Chưa xuất bản'}</dd>
              </div>
            </dl>
          </section>
        )
      }
      {
        deleteAction && (
          <details class="post-card">
            <summary>Thao tác khác</summary>
            <button
              class="btn btn-accent mt-3"
              type="submit"
              form="delete-post"
              data-retire={wasPublic ? 'delete' : undefined}
              data-retire-form={wasPublic ? 'delete-post' : undefined}
            >
              Cho vào thùng rác
            </button>
          </details>
        )
      }
    </aside>
  </div>
  <aside class="post-preview-pane" data-preview-pane hidden>
    <div class="post-preview-head">
      <p class="post-preview-title">Xem trước</p>
      <p class="post-preview-status" data-preview-status aria-live="polite"></p>
      <div class="post-preview-actions">
        <button class="btn btn-compact" type="button" data-preview-refresh>Làm mới</button>
        <button class="btn btn-compact" type="button" data-preview-blank title="Mở tab mới">Tab mới</button>
        <button class="btn btn-compact" type="button" data-preview-close>Đóng</button>
      </div>
    </div>
    <iframe name="post-preview-frame" title="Xem trước bài viết" data-preview-frame></iframe>
  </aside>
  </div>
</form>
{
  deleteAction && (
    <form
      id="delete-post"
      method="post"
      action={deleteAction}
      data-confirm-title={wasPublic ? undefined : 'Chuyển vào thùng rác?'}
      data-confirm={wasPublic ? undefined : `“${values.title}” sẽ rời khỏi danh sách bài viết. Bạn có thể khôi phục trong tab Thùng rác.`}
      data-confirm-ok={wasPublic ? undefined : 'Chuyển vào thùng rác'}
    >
      <input type="hidden" name="csrf" value={csrf} />
      <input type="hidden" name="urlAction" value="" />
      <input type="hidden" name="urlTarget" value="" />
    </form>
  )
}
<RetiredUrlDialog posts={targets} />

<script>
  const form = document.querySelector('form[data-post-form]');
  const status = document.getElementById('post-status');
  const publish = document.getElementById('save-publish');
  const draft = document.getElementById('save-draft');
  const unpublish = document.getElementById('unpublish-post');
  const postBar = form?.querySelector('.post-bar');

  function syncToolbarTop() {
    if (!(form instanceof HTMLFormElement) || !(postBar instanceof HTMLElement)) return;
    form.style.setProperty('--editor-toolbar-top', `${Math.ceil(postBar.getBoundingClientRect().height)}px`);
  }
  if (postBar instanceof HTMLElement && 'ResizeObserver' in window) {
    new ResizeObserver(syncToolbarTop).observe(postBar);
  }
  syncToolbarTop();

  function syncActions() {
    if (!(status instanceof HTMLSelectElement)) return;
    const published = status.value === 'published';
    if (publish instanceof HTMLButtonElement) publish.textContent = published ? 'Cập nhật' : 'Xuất bản';
    if (draft instanceof HTMLButtonElement) draft.hidden = published;
    if (unpublish instanceof HTMLButtonElement) unpublish.hidden = !published;
  }

  draft?.addEventListener('click', () => {
    if (status instanceof HTMLSelectElement) status.value = 'draft';
  });
  publish?.addEventListener('click', () => {
    if (status instanceof HTMLSelectElement) status.value = 'published';
  });
  status?.addEventListener('change', syncActions);
  syncActions();

  const snapshotKeys = ['title', 'slug', 'coverMediaId', 'contentJson', 'seoTitle', 'metaDescription', 'excerpt'];
  let timer = 0;
  let lastSnapshot = '';
  let chain = Promise.resolve();

  function snapshot() {
    if (!(form instanceof HTMLFormElement)) return '';
    const data = new FormData(form);
    const cats = data.getAll('categoryIds').map(String).sort().join(',');
    return [...snapshotKeys.map((key) => String(data.get(key) ?? '')), cats].join('\u0001');
  }

  function formatSavedAt(ms) {
    const parts = new Intl.DateTimeFormat('en-GB', {
      timeZone: 'Asia/Ho_Chi_Minh',
      hour: '2-digit',
      minute: '2-digit',
      hour12: false,
    }).formatToParts(new Date(ms));
    const hour = parts.find((part) => part.type === 'hour')?.value ?? '00';
    const minute = parts.find((part) => part.type === 'minute')?.value ?? '00';
    return `${hour}:${minute}`;
  }

  /** @param {'dirty'|'saving'|'saved'|'error'|'blocked'} state */
  function statusLine(state, detail) {
    const line = form?.querySelector('[data-save-status]');
    if (!(line instanceof HTMLElement)) return;
    let text = '';
    if (state === 'saving') text = 'Đang lưu…';
    else if (state === 'dirty') text = 'Chưa lưu';
    else if (state === 'saved') {
      const at = typeof detail === 'number' ? detail : Date.now();
      text = `Đã lưu · ${formatSavedAt(at)}`;
    } else if (state === 'blocked') text = typeof detail === 'string' && detail ? detail : 'Bài đã xuất bản, không tự lưu đè.';
    else text = typeof detail === 'string' && detail ? detail : 'Lưu thất bại';
    line.textContent = text;
    line.dataset.state = state === 'blocked' ? 'error' : state;
  }

  function readAutosave(value: unknown): {
    ok: boolean;
    error: string;
    id: number | null;
    skipped: boolean;
    updatedAt: number | null;
  } {
    if (!value || typeof value !== 'object') return { ok: false, error: '', id: null, skipped: false, updatedAt: null };
    const record = value as Record<string, unknown>;
    return {
      ok: record.ok === true,
      error: typeof record.error === 'string' ? record.error : '',
      id: typeof record.id === 'number' ? record.id : null,
      skipped: record.skipped === true,
      updatedAt: typeof record.updatedAt === 'number' ? record.updatedAt : null,
    };
  }

  function rememberRevision(updatedAt: number | null) {
    if (updatedAt === null || !(form instanceof HTMLFormElement)) return;
    const field = form.querySelector('input[name="updatedAt"]');
    if (field instanceof HTMLInputElement) field.value = String(updatedAt);
  }

  function enqueue(job: () => Promise<void>) {
    const run = chain.then(job, job);
    chain = run.then(
      () => undefined,
      () => undefined,
    );
    return run;
  }

  async function saveDraft() {
    if (!(form instanceof HTMLFormElement) || form.dataset.autosave !== 'on') return;
    const current = snapshot();
    if (current === lastSnapshot) return;
    const data = new FormData(form);
    const title = String(data.get('title') ?? '').trim();
    const slug = String(data.get('slug') ?? '').trim();
    if (!title || !slug) return;
    data.set('autosave', '1');
    data.set('status', 'draft');
    statusLine('saving');
    try {
      const response = await fetch(form.action, {
        method: 'POST',
        body: data,
        headers: { accept: 'application/json' },
      });
      const body = readAutosave(await response.json());
      if (!response.ok || !body.ok) {
        statusLine('error', body.error || 'Lưu thất bại');
        return;
      }
      if (body.skipped) {
        form.dataset.autosave = 'off';
        statusLine('blocked');
        return;
      }
      rememberRevision(body.updatedAt);
      lastSnapshot = current;
      if (body.id !== null) {
        form.dataset.postId = String(body.id);
        form.dispatchEvent(new Event('post-saved'));
        if (/\/new$/.test(form.action)) {
          form.action = form.action.replace(/\/new$/, `/${body.id}`);
          history.replaceState(null, '', form.action);
        }
      }
      if (snapshot() === current) statusLine('saved', body.updatedAt ?? Date.now());
      else {
        statusLine('saving');
        void enqueue(saveDraft);
      }
    } catch {
      statusLine('error');
    }
  }

  function schedule() {
    if (snapshot() !== lastSnapshot) statusLine('dirty');
    if (!(form instanceof HTMLFormElement) || form.dataset.autosave !== 'on') return;
    window.clearTimeout(timer);
    timer = window.setTimeout(() => {
      void enqueue(saveDraft);
    }, 2500);
  }

  function acceptEditorBaseline() {
    if (!(form instanceof HTMLFormElement)) return;
    window.clearTimeout(timer);
    const data = new FormData(form);
    const parts = lastSnapshot.split('\u0001');
    const index = snapshotKeys.indexOf('contentJson');
    if (index < 0) return;
    // Chỉ nhận JSON sau hydrate; giữ dirty nếu user đã sửa field khác trước đó.
    while (parts.length < snapshotKeys.length) parts.push('');
    parts[index] = String(data.get('contentJson') ?? '');
    lastSnapshot = parts.join('\u0001');
  }

  form?.addEventListener('input', schedule);
  form?.addEventListener('change', schedule);
  form?.addEventListener('post-input', schedule);
  form?.addEventListener('post-editor-ready', acceptEditorBaseline);
  lastSnapshot = snapshot();

  const FOCUS_KEY = 'post-write-focus';
  const focusBtn = document.getElementById('focus-write');
  function syncFocusUi(on) {
    if (!(form instanceof HTMLFormElement)) return;
    form.classList.toggle('is-focus', on);
    if (focusBtn instanceof HTMLButtonElement) {
      focusBtn.setAttribute('aria-pressed', on ? 'true' : 'false');
      focusBtn.textContent = on ? 'Hiện đủ' : 'Chỉ viết';
      focusBtn.title = on ? 'Hiện lại cột phụ và SEO' : 'Ẩn cột phụ để tập trung viết';
    }
    syncToolbarTop();
  }
  syncFocusUi(form instanceof HTMLFormElement && form.classList.contains('is-focus'));
  focusBtn?.addEventListener('click', () => {
    if (!(form instanceof HTMLFormElement)) return;
    const next = !form.classList.contains('is-focus');
    syncFocusUi(next);
    try {
      localStorage.setItem(FOCUS_KEY, next ? '1' : '0');
    } catch {
      /* ignore */
    }
  });

  const titleInput = document.getElementById('post-title');
  titleInput?.addEventListener('keydown', (event) => {
    if (!(event instanceof KeyboardEvent) || event.key !== 'Enter') return;
    event.preventDefault();
    const prose = form?.querySelector('.ProseMirror');
    if (prose instanceof HTMLElement) prose.focus();
  });

  const previewBtn = document.getElementById('preview-post');
  const previewSubmit = document.getElementById('preview-submit');
  const previewPane = form?.querySelector('[data-preview-pane]');
  const previewFrame = form?.querySelector('[data-preview-frame]');
  const previewStatus = form?.querySelector('[data-preview-status]');
  const previewEmbed = form?.querySelector('[data-preview-embed]');
  let previewOpen = false;

  function setPreviewStatus(text) {
    if (previewStatus instanceof HTMLElement) previewStatus.textContent = text;
  }

  function refreshPreview() {
    if (!(form instanceof HTMLFormElement) || !(previewSubmit instanceof HTMLButtonElement)) return;
    if (previewEmbed instanceof HTMLInputElement) previewEmbed.disabled = false;
    setPreviewStatus('Đang tải…');
    form.requestSubmit(previewSubmit);
  }

  function openPreview(refresh) {
    if (!(form instanceof HTMLFormElement)) return;
    previewOpen = true;
    form.classList.add('is-preview');
    if (previewPane instanceof HTMLElement) previewPane.hidden = false;
    if (previewBtn instanceof HTMLButtonElement) {
      previewBtn.setAttribute('aria-pressed', 'true');
      previewBtn.textContent = 'Làm mới';
      previewBtn.title = 'Làm mới bản xem trước';
    }
    syncToolbarTop();
    if (refresh) refreshPreview();
  }

  function closePreview() {
    if (!(form instanceof HTMLFormElement)) return;
    previewOpen = false;
    form.classList.remove('is-preview');
    if (previewPane instanceof HTMLElement) previewPane.hidden = true;
    if (previewEmbed instanceof HTMLInputElement) previewEmbed.disabled = true;
    if (previewFrame instanceof HTMLIFrameElement) previewFrame.src = 'about:blank';
    if (previewBtn instanceof HTMLButtonElement) {
      previewBtn.setAttribute('aria-pressed', 'false');
      previewBtn.textContent = 'Xem trước';
      previewBtn.title = 'Xem trước cạnh trình soạn thảo';
    }
    setPreviewStatus('');
    syncToolbarTop();
  }

  previewBtn?.addEventListener('click', () => {
    if (previewOpen) refreshPreview();
    else openPreview(true);
  });
  form?.querySelector('[data-preview-refresh]')?.addEventListener('click', () => refreshPreview());
  form?.querySelector('[data-preview-close]')?.addEventListener('click', () => closePreview());
  form?.querySelector('[data-preview-blank]')?.addEventListener('click', () => {
    if (!(form instanceof HTMLFormElement) || !(previewSubmit instanceof HTMLButtonElement)) return;
    if (previewEmbed instanceof HTMLInputElement) previewEmbed.disabled = true;
    previewSubmit.setAttribute('formtarget', '_blank');
    form.requestSubmit(previewSubmit);
    previewSubmit.setAttribute('formtarget', 'post-preview-frame');
    if (previewOpen && previewEmbed instanceof HTMLInputElement) previewEmbed.disabled = false;
  });
  previewFrame?.addEventListener('load', () => {
    if (previewOpen) setPreviewStatus('');
  });
  window.addEventListener('keydown', (event) => {
    if (!(event instanceof KeyboardEvent) || event.key !== 'Escape' || !previewOpen) return;
    if (document.querySelector('dialog[open]')) return;
    closePreview();
  });

  function quickSave(event) {
    if (!(event instanceof KeyboardEvent) || !(form instanceof HTMLFormElement)) return;
    if (!(event.ctrlKey || event.metaKey) || event.altKey) return;
    if (event.key === '\\') {
      event.preventDefault();
      focusBtn?.click();
      return;
    }
    if (event.key !== 's' && event.key !== 'S') return;
    if (document.querySelector('dialog[open]')) return;
    event.preventDefault();
    window.clearTimeout(timer);
    if (form.dataset.autosave === 'on') {
      void enqueue(saveDraft);
      return;
    }
    if (publish instanceof HTMLButtonElement) form.requestSubmit(publish);
    else if (draft instanceof HTMLButtonElement && !draft.hidden) form.requestSubmit(draft);
  }
  window.addEventListener('keydown', quickSave);

  window.addEventListener('beforeunload', (event) => {
    if (!(form instanceof HTMLFormElement) || form.dataset.leaving === '1') return;
    if (snapshot() === lastSnapshot) return;
    event.preventDefault();
  });

  form?.addEventListener('submit', (event) => {
    if (!(form instanceof HTMLFormElement) || !(event instanceof SubmitEvent)) return;
    if (event.submitter instanceof HTMLButtonElement && (event.submitter.id === 'preview-post' || event.submitter.id === 'preview-submit')) return;
    if (
      form.dataset.livePublished === '1' &&
      status instanceof HTMLSelectElement &&
      status.value === 'draft' &&
      form.dataset.confirmedUnpublish !== '1'
    ) {
      event.preventDefault();
      form.dispatchEvent(new CustomEvent('retire-open', { detail: { mode: 'unpublish', form: 'post-form' } }));
      return;
    }
    if (form.dataset.leaving === '1') {
      event.preventDefault();
      return;
    }
    if (form.dataset.autosave !== 'on' || form.dataset.saving === 'manual') {
      form.dataset.leaving = '1';
      statusLine('saving');
      return;
    }
    event.preventDefault();
    const submitter = event.submitter;
    window.clearTimeout(timer);
    void enqueue(async () => {
      await saveDraft();
      if (!(form instanceof HTMLFormElement)) return;
      if (status instanceof HTMLSelectElement && submitter instanceof HTMLButtonElement) {
        if (submitter.id === 'save-draft') status.value = 'draft';
        if (submitter.id === 'save-publish') status.value = 'published';
      }
      form.dataset.saving = 'manual';
      form.dataset.autosave = 'off';
      if (!form.reportValidity()) {
        form.dataset.saving = '';
        form.dataset.autosave = 'on';
        return;
      }
      statusLine('saving');
      form.querySelectorAll('button[type="submit"]').forEach((button) => {
        if (button instanceof HTMLButtonElement) button.disabled = false;
      });
      await new Promise((resolve) => window.setTimeout(resolve, 0));
      if (!(form instanceof HTMLFormElement) || form.dataset.saving !== 'manual') return;
      if (submitter instanceof HTMLButtonElement) form.requestSubmit(submitter);
      else form.requestSubmit();
    });
  });
</script>
