---
import MediaPicker from './MediaPicker.svelte';
import PostEditor from './PostEditor.svelte';
import type { MediaItem } from '../../features/media/types';
import SearchPreview from './SearchPreview.astro';
import SeoChecklist from './SeoChecklist.svelte';
import SlugField from './SlugField.svelte';
import { lengthNote, metaDuplicateNote, SEO_DESC_RANGE, SEO_TITLE_RANGE } from '../../features/posts/seo-check';
import type { MetaCorpus } from '../../lib/seo/meta';
import { formatDateTime } from '../../lib/datetime';
import RetiredUrlDialog from './RetiredUrlDialog.astro';
import { routes } from '../../lib/routes';
import type { FieldErrors } from '../../lib/validation/errors';

interface Values {
  title: string;
  slug: string;
  categoryId: string;
  coverMediaId: string;
  contentJson: string;
  seoTitle: string;
  metaDescription: string;
  excerpt: string;
  status: string;
}


interface Meta {
  createdAt: number;
  updatedAt: number;
  publishedAt: number | null;
}

interface SeoSite {
  name: string;
  host: string;
  markUrl: string;
}

interface Props {
  csrf: string;
  action: string;
  values: Values;
  errors: FieldErrors;
  formError: string;
  categories: { id: number; name: string }[];
  media: MediaItem[];
  site: SeoSite;
  postId?: number;
  saved?: boolean;
  meta?: Meta;
  deleteAction?: string;
  livePublished?: boolean;
  corpus?: MetaCorpus;
  targets?: { title: string; path: string }[];
}

const { csrf, action, values, errors, formError, categories, media, site, postId, saved = false, meta, deleteAction, livePublished = false, corpus = { titles: [], descriptions: [] }, targets = [] } = Astro.props;
const publishLabel = values.status === 'published' ? 'Cập nhật' : 'Xuất bản';
const saveStatus = formError ? 'Lưu thất bại' : saved ? 'Đã lưu' : '';
const previewTitle = values.seoTitle || values.title || 'Tiêu đề bài viết';
const previewDescription = values.metaDescription || values.excerpt || 'Thêm mô tả SEO hoặc tóm tắt để xem trước đoạn này.';
const previewSlug = values.slug || 'duong-dan';
const titleLengthNote = lengthNote(values.seoTitle.length, SEO_TITLE_RANGE.min, SEO_TITLE_RANGE.max);
const descriptionLengthNote = lengthNote(values.metaDescription.length, SEO_DESC_RANGE.min, SEO_DESC_RANGE.max);
const duplicateNote = metaDuplicateNote(values.seoTitle || values.title, values.metaDescription || values.excerpt, corpus);
const autosave = values.status === 'draft' ? 'on' : 'off';
---

<form id="post-form" class="post-write" method="post" action={action} data-busy data-post-form data-autosave={autosave} data-live-published={livePublished ? '1' : '0'} data-site-host={site.host} data-post-id={postId ?? ''}>
  <input type="hidden" name="csrf" value={csrf} />
  <input type="hidden" name="urlAction" value="" />
  <input type="hidden" name="urlTarget" value="" />
  <input type="hidden" name="updatedAt" value={meta ? String(meta.updatedAt) : ''} />
  {postId ? <input type="hidden" name="postId" value={String(postId)} /> : null}
  <button class="sr-only" type="submit" tabindex="-1" data-keep-label="true">Lưu trạng thái hiện tại</button>
  <div class="post-bar">
    <a class="btn btn-compact" href={routes.adminPosts}>Danh sách</a>
    <p class="post-save" role="status" data-save-status>{saveStatus}</p>
    <div class="post-bar-actions">
      <button class="btn btn-compact" id="preview-post" type="submit" formmethod="post" formaction={routes.adminPostPreview} formtarget="_blank" data-keep-label="true">Xem trước</button>
      <button class="btn btn-compact" id="save-draft" type="submit" data-keep-label="true" hidden={values.status === 'published'}>Lưu nháp</button>
      <button class="btn btn-compact btn-primary" id="save-publish" type="submit" data-keep-label="true">{publishLabel}</button>
      <button class="btn btn-compact" id="unpublish-post" type="submit" data-keep-label="true" data-retire="unpublish" data-retire-form="post-form" hidden={values.status !== 'published'}>Gỡ xuất bản</button>
    </div>
  </div>
  {formError && <p class="error-text" role="alert">{formError}</p>}
  <div class="post-columns">
    <div class="post-main">
      <label class="block">
        <span class="mb-1 block font-semibold">Tiêu đề</span>
        <input id="post-title" class="field field-title" name="title" required maxlength="180" value={values.title} />
        {errors.title && <span class="error-text">{errors.title}</span>}
      </label>
      <PostEditor client:load {csrf} {media} contentJson={values.contentJson} contentError={errors.contentJson ?? ''} />
      <label class="mt-6 block">
        <span class="mb-1 block font-semibold">Tóm tắt</span>
        <textarea class="field min-h-24" name="excerpt" maxlength="300" placeholder="Để trống sẽ lấy đoạn đầu của bài.">{values.excerpt}</textarea>
        {errors.excerpt && <span class="error-text">{errors.excerpt}</span>}
      </label>
      <section class="post-card seo-card mt-6">
        <div class="seo-head">
          <div>
            <h2>Tối ưu hiển thị trên Google</h2>
            <p>Kiểm tra cách bài viết có thể xuất hiện trên trang kết quả tìm kiếm.</p>
          </div>
          <span class="seo-badge">SEO</span>
        </div>
        <SearchPreview
          site={site}
          title={previewTitle}
          description={previewDescription}
          slug={previewSlug}
          emptyDescription={!values.metaDescription && !values.excerpt}
          corpus={corpus}
        />
        <label class="mt-4 block">
          <span class="seo-label">
            <span>SEO Title</span>
            <span data-seo-title-count>{values.seoTitle.length} ký tự</span>
          </span>
          <input class="field" name="seoTitle" maxlength="180" value={values.seoTitle} />
          <span class="seo-hint">Nếu để trống, hệ thống sử dụng tiêu đề bài viết.</span>
          <span class="seo-hint" data-seo-title-note>{titleLengthNote}</span>
          {errors.seoTitle && <span class="error-text">{errors.seoTitle}</span>}
        </label>
        <label class="mt-4 block">
          <span class="seo-label">
            <span>Meta Description</span>
            <span data-seo-desc-count>{values.metaDescription.length} ký tự</span>
          </span>
          <textarea class="field min-h-24" name="metaDescription" maxlength="300">{values.metaDescription}</textarea>
          <span class="seo-hint">Nếu để trống, hệ thống dùng tóm tắt. Nên khoảng 70–160 ký tự.</span>
          <span class="seo-hint" data-seo-desc-note>{descriptionLengthNote}</span>
          <span class="seo-hint" data-seo-duplicate-note>{duplicateNote}</span>
          {errors.metaDescription && <span class="error-text">{errors.metaDescription}</span>}
        </label>
      </section>
    </div>
    <aside class="post-side">
      <section class="post-card">
        <h2 class="post-card-title">Xuất bản</h2>
        <label class="mt-3 block">
          <span class="sr-only">Trạng thái</span>
          <select class="field" id="post-status" name="status">
            <option value="draft" selected={values.status === 'draft'}>Bản nháp</option>
            <option value="published" selected={values.status === 'published'}>Đã xuất bản</option>
          </select>
          {errors.status && <span class="error-text">{errors.status}</span>}
        </label>
      </section>
      <section class="post-card">
        <h2 class="post-card-title">Danh mục</h2>
        <label class="mt-3 block">
          <span class="sr-only">Danh mục</span>
          <select class="field" name="categoryId">
            <option value="">Không chọn</option>
            {categories.map((category) => <option value={category.id} selected={values.categoryId === String(category.id)}>{category.name}</option>)}
          </select>
          {errors.categoryId && <span class="error-text">{errors.categoryId}</span>}
        </label>
      </section>
      <section class="post-card">
        <h2 class="post-card-title">Ảnh đại diện</h2>
        <MediaPicker client:load {csrf} items={media} name="coverMediaId" selected={values.coverMediaId ? [values.coverMediaId] : []} editAlt />
        {errors.coverMediaId && <span class="error-text">{errors.coverMediaId}</span>}
      </section>
      <section class="post-card">
        <h2 class="post-card-title">Đường dẫn</h2>
        <div class="mt-3">
          <SlugField client:load titleInput="post-title" slug={values.slug} slugError={errors.slug ?? ''} />
          <p class="mt-2 text-sm text-muted">Slug chỉ tự tạo khi ô này còn trống. Đổi slug bài đã xuất bản sẽ chuyển hướng 301.</p>
        </div>
      </section>
      <SeoChecklist client:load siteName={site.name} host={site.host} publishedAt={meta?.publishedAt ?? null} corpus={corpus} />
      {
        meta && (
          <section class="post-card">
            <h2 class="post-card-title">Thông tin</h2>
            <dl class="post-meta">
              <div>
                <dt>Tạo</dt>
                <dd>{formatDateTime(meta.createdAt)}</dd>
              </div>
              <div>
                <dt>Cập nhật</dt>
                <dd>{formatDateTime(meta.updatedAt)}</dd>
              </div>
              <div>
                <dt>Xuất bản</dt>
                <dd>{meta.publishedAt ? formatDateTime(meta.publishedAt) : 'Chưa xuất bản'}</dd>
              </div>
            </dl>
          </section>
        )
      }
      {
        deleteAction && (
          <details class="post-card">
            <summary>Thao tác khác</summary>
            <button class="btn btn-accent mt-3" type="submit" form="delete-post" data-retire="delete" data-retire-form="delete-post">Cho vào thùng rác</button>
          </details>
        )
      }
    </aside>
  </div>
</form>
{
  deleteAction && (
    <form id="delete-post" method="post" action={deleteAction}>
      <input type="hidden" name="csrf" value={csrf} />
      <input type="hidden" name="urlAction" value="" />
      <input type="hidden" name="urlTarget" value="" />
    </form>
  )
}
<RetiredUrlDialog posts={targets} />

<script>
  const form = document.querySelector('form[data-post-form]');
  const status = document.getElementById('post-status');
  const publish = document.getElementById('save-publish');
  const draft = document.getElementById('save-draft');
  const unpublish = document.getElementById('unpublish-post');

  function syncActions() {
    if (!(status instanceof HTMLSelectElement)) return;
    const published = status.value === 'published';
    if (publish instanceof HTMLButtonElement) publish.textContent = published ? 'Cập nhật' : 'Xuất bản';
    if (draft instanceof HTMLButtonElement) draft.hidden = published;
    if (unpublish instanceof HTMLButtonElement) unpublish.hidden = !published;
  }

  draft?.addEventListener('click', () => {
    if (status instanceof HTMLSelectElement) status.value = 'draft';
  });
  publish?.addEventListener('click', () => {
    if (status instanceof HTMLSelectElement) status.value = 'published';
  });
  status?.addEventListener('change', syncActions);
  syncActions();

  const snapshotKeys = ['title', 'slug', 'categoryId', 'coverMediaId', 'contentJson', 'seoTitle', 'metaDescription', 'excerpt'];
  let timer = 0;
  let lastSnapshot = '';
  let chain = Promise.resolve();

  function snapshot() {
    if (!(form instanceof HTMLFormElement)) return '';
    const data = new FormData(form);
    return snapshotKeys.map((key) => String(data.get(key) ?? '')).join('\u0001');
  }

  function statusLine(text: string) {
    const line = form?.querySelector('[data-save-status]');
    if (line) line.textContent = text;
  }

  function readAutosave(value: unknown): {
    ok: boolean;
    error: string;
    id: number | null;
    skipped: boolean;
    updatedAt: number | null;
  } {
    if (!value || typeof value !== 'object') return { ok: false, error: '', id: null, skipped: false, updatedAt: null };
    const record = value as Record<string, unknown>;
    return {
      ok: record.ok === true,
      error: typeof record.error === 'string' ? record.error : '',
      id: typeof record.id === 'number' ? record.id : null,
      skipped: record.skipped === true,
      updatedAt: typeof record.updatedAt === 'number' ? record.updatedAt : null,
    };
  }

  function rememberRevision(updatedAt: number | null) {
    if (updatedAt === null || !(form instanceof HTMLFormElement)) return;
    const field = form.querySelector('input[name="updatedAt"]');
    if (field instanceof HTMLInputElement) field.value = String(updatedAt);
  }

  function enqueue(job: () => Promise<void>) {
    const run = chain.then(job, job);
    chain = run.then(
      () => undefined,
      () => undefined,
    );
    return run;
  }

  async function saveDraft() {
    if (!(form instanceof HTMLFormElement) || form.dataset.autosave !== 'on') return;
    const current = snapshot();
    if (current === lastSnapshot) return;
    const data = new FormData(form);
    const title = String(data.get('title') ?? '').trim();
    const slug = String(data.get('slug') ?? '').trim();
    if (!title || !slug) return;
    data.set('autosave', '1');
    data.set('status', 'draft');
    statusLine('Đang lưu');
    try {
      const response = await fetch(form.action, {
        method: 'POST',
        body: data,
        headers: { accept: 'application/json' },
      });
      const body = readAutosave(await response.json());
      if (!response.ok || !body.ok) {
        statusLine(body.error || 'Lưu thất bại');
        return;
      }
      if (body.skipped) {
        form.dataset.autosave = 'off';
        statusLine('Bài đã xuất bản, không tự lưu đè.');
        return;
      }
      rememberRevision(body.updatedAt);
      lastSnapshot = current;
      if (body.id !== null) {
        form.dataset.postId = String(body.id);
        form.dispatchEvent(new Event('post-saved'));
        if (/\/new$/.test(form.action)) {
          form.action = form.action.replace(/\/new$/, `/${body.id}`);
          history.replaceState(null, '', form.action);
        }
      }
      statusLine(snapshot() === current ? 'Đã lưu' : 'Đang lưu');
      if (snapshot() !== current) void enqueue(saveDraft);
    } catch {
      statusLine('Lưu thất bại');
    }
  }

  function schedule() {
    if (snapshot() !== lastSnapshot) statusLine('Chưa lưu');
    if (!(form instanceof HTMLFormElement) || form.dataset.autosave !== 'on') return;
    window.clearTimeout(timer);
    timer = window.setTimeout(() => {
      void enqueue(saveDraft);
    }, 2500);
  }

  form?.addEventListener('input', schedule);
  form?.addEventListener('change', schedule);
  form?.addEventListener('post-input', schedule);
  lastSnapshot = snapshot();

  window.addEventListener('beforeunload', (event) => {
    if (!(form instanceof HTMLFormElement) || form.dataset.leaving === '1') return;
    if (snapshot() === lastSnapshot) return;
    event.preventDefault();
  });

  form?.addEventListener('submit', (event) => {
    if (!(form instanceof HTMLFormElement) || !(event instanceof SubmitEvent)) return;
    if (event.submitter instanceof HTMLButtonElement && event.submitter.id === 'preview-post') return;
    if (
      form.dataset.livePublished === '1' &&
      status instanceof HTMLSelectElement &&
      status.value === 'draft' &&
      form.dataset.confirmedUnpublish !== '1'
    ) {
      event.preventDefault();
      form.dispatchEvent(new CustomEvent('retire-open', { detail: { mode: 'unpublish', form: 'post-form' } }));
      return;
    }
    if (form.dataset.leaving === '1') {
      event.preventDefault();
      return;
    }
    if (form.dataset.autosave !== 'on' || form.dataset.saving === 'manual') {
      form.dataset.leaving = '1';
      statusLine('Đang lưu');
      return;
    }
    event.preventDefault();
    const submitter = event.submitter;
    window.clearTimeout(timer);
    void enqueue(async () => {
      await saveDraft();
      if (!(form instanceof HTMLFormElement)) return;
      if (status instanceof HTMLSelectElement && submitter instanceof HTMLButtonElement) {
        if (submitter.id === 'save-draft') status.value = 'draft';
        if (submitter.id === 'save-publish') status.value = 'published';
      }
      form.dataset.saving = 'manual';
      form.dataset.autosave = 'off';
      if (!form.reportValidity()) {
        form.dataset.saving = '';
        form.dataset.autosave = 'on';
        return;
      }
      statusLine('Đang lưu');
      form.querySelectorAll('button[type="submit"]').forEach((button) => {
        if (button instanceof HTMLButtonElement) button.disabled = false;
      });
      await new Promise((resolve) => window.setTimeout(resolve, 0));
      if (!(form instanceof HTMLFormElement) || form.dataset.saving !== 'manual') return;
      if (submitter instanceof HTMLButtonElement) form.requestSubmit(submitter);
      else form.requestSubmit();
    });
  });
</script>
