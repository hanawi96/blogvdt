---
interface Props {
  site: { name: string; host: string; markUrl: string };
  title: string;
  description: string;
  slug: string;
  emptyDescription: boolean;
  titleName?: string;
  descriptionName?: string;
  fallbackTitleName?: string;
  fallbackDescriptionName?: string;
  homeUrl?: boolean;
  pathPrefix?: string;
  corpus?: { titles: string[]; descriptions: string[] };
}

const {
  site,
  title,
  description,
  slug,
  emptyDescription,
  titleName = 'seoTitle',
  descriptionName = 'metaDescription',
  fallbackTitleName = 'title',
  fallbackDescriptionName = 'excerpt',
  homeUrl = false,
  pathPrefix = 'kien-thuc',
  corpus = { titles: [], descriptions: [] },
} = Astro.props;
const urlText = homeUrl ? site.host : `${site.host} › ${pathPrefix.split('/').join(' › ')} › ${slug}`;
---

<div
  class="search-preview"
  data-search-preview
  data-host={site.host}
  data-title-name={titleName}
  data-description-name={descriptionName}
  data-fallback-title={fallbackTitleName}
  data-fallback-description={fallbackDescriptionName}
  data-home-url={homeUrl ? '' : undefined}
  data-path-prefix={pathPrefix}
  data-corpus={JSON.stringify(corpus)}
>
  <div class="serp-devices" role="group" aria-label="Kích thước xem trước">
    <button type="button" data-serp-device="desktop" aria-pressed="true">Máy tính</button>
    <button type="button" data-serp-device="mobile" aria-pressed="false">Điện thoại</button>
  </div>
  <div class="serp" data-serp-frame>
    <div class="serp-site">
      <span class="serp-mark">
        {site.markUrl ? <img src={site.markUrl} alt="" /> : site.name.slice(0, 1)}
      </span>
      <span>{site.name}</span>
    </div>
    <p class="serp-url" data-serp-url>{urlText}</p>
    <p class="serp-title" data-serp-title>{title}</p>
    <p class="serp-desc" data-serp-desc data-empty={emptyDescription ? '' : undefined}>{description}</p>
  </div>
  <p class="seo-hint">Đây chỉ là bản xem trước. Google có thể dùng tiêu đề hoặc đoạn mô tả khác.</p>
</div>

<script>
  import { lengthNote, metaDuplicateNote, SEO_DESC_RANGE, SEO_TITLE_RANGE } from '../../features/posts/seo-check';

  function fieldValue(form: HTMLFormElement, name: string): string {
    const field = form.querySelector(`[name="${name}"]`);
    if (field instanceof HTMLInputElement || field instanceof HTMLTextAreaElement) return field.value;
    return '';
  }

  function paint(root: HTMLElement) {
    const form = root.closest('form');
    if (!(form instanceof HTMLFormElement)) return;
    const seoTitle = fieldValue(form, root.dataset.titleName || 'seoTitle');
    const title = fieldValue(form, root.dataset.fallbackTitle || 'title').trim();
    const meta = fieldValue(form, root.dataset.descriptionName || 'metaDescription');
    const excerpt = fieldValue(form, root.dataset.fallbackDescription || 'excerpt').trim();
    const slug = fieldValue(form, 'slug').trim() || 'duong-dan';
    const resolvedTitle = seoTitle.trim() || title;
    const resolvedDescription = meta.trim() || excerpt;
    const headline = resolvedTitle || 'Tiêu đề bài viết';
    const description = resolvedDescription || 'Thêm mô tả SEO hoặc tóm tắt để xem trước đoạn này.';
    let corpus = { titles: [] as string[], descriptions: [] as string[] };
    try {
      const parsed = JSON.parse(root.dataset.corpus || '{}') as { titles?: unknown; descriptions?: unknown };
      corpus = {
        titles: Array.isArray(parsed.titles) ? parsed.titles.filter((item): item is string => typeof item === 'string') : [],
        descriptions: Array.isArray(parsed.descriptions) ? parsed.descriptions.filter((item): item is string => typeof item === 'string') : [],
      };
    } catch {
      corpus = { titles: [], descriptions: [] };
    }
    const titleNode = root.querySelector('[data-serp-title]');
    const descNode = root.querySelector('[data-serp-desc]');
    const urlNode = root.querySelector('[data-serp-url]');
    if (titleNode) titleNode.textContent = headline;
    if (descNode) {
      descNode.textContent = description;
      if (meta.trim() || excerpt) descNode.removeAttribute('data-empty');
      else descNode.setAttribute('data-empty', '');
    }
    if (urlNode) {
      const host = root.dataset.host || '';
      const prefix = (root.dataset.pathPrefix || 'kien-thuc').split('/').join(' › ');
      urlNode.textContent = root.hasAttribute('data-home-url') ? host : `${host} › ${prefix} › ${slug}`;
    }
    const titleCount = form.querySelector('[data-seo-title-count]');
    const descCount = form.querySelector('[data-seo-desc-count]');
    const titleNote = form.querySelector('[data-seo-title-note]');
    const descNote = form.querySelector('[data-seo-desc-note]');
    if (titleCount) titleCount.textContent = `${seoTitle.length} ký tự`;
    if (descCount) descCount.textContent = `${meta.length} ký tự`;
    if (titleNote) titleNote.textContent = lengthNote(seoTitle.length, SEO_TITLE_RANGE.min, SEO_TITLE_RANGE.max);
    if (descNote) descNote.textContent = lengthNote(meta.length, SEO_DESC_RANGE.min, SEO_DESC_RANGE.max);
    const duplicateNote = form.querySelector('[data-seo-duplicate-note]');
    if (duplicateNote) duplicateNote.textContent = metaDuplicateNote(resolvedTitle, resolvedDescription, corpus);
  }

  function bind(root: HTMLElement) {
    const form = root.closest('form');
    if (!(form instanceof HTMLFormElement) || root.dataset.bound === '1') return;
    root.dataset.bound = '1';
    const paintNow = () => paint(root);
    form.addEventListener('input', paintNow);
    form.addEventListener('post-input', paintNow);
    for (const button of root.querySelectorAll('[data-serp-device]')) {
      button.addEventListener('click', () => {
        const mobile = button.getAttribute('data-serp-device') === 'mobile';
        root.querySelector('[data-serp-frame]')?.classList.toggle('serp-mobile', mobile);
        for (const item of root.querySelectorAll('[data-serp-device]')) {
          item.setAttribute('aria-pressed', item === button ? 'true' : 'false');
        }
      });
    }
    paintNow();
  }

  for (const node of document.querySelectorAll('[data-search-preview]')) {
    if (node instanceof HTMLElement) bind(node);
  }
</script>
