---
import AddressField from '../public/AddressField.astro';
import OrderLineEditor from './OrderLineEditor.astro';
import StaffOrderMeta from './StaffOrderMeta.astro';
import StaffProductPicker from './StaffProductPicker.astro';
import type { StaffDiscountChoice } from '../../features/discounts/discounts';
import type { StaffFlagForm, StaffLineInput, StoredOrderLine } from '../../features/orders/staff';
import type { OrderCostKind } from '../../features/costs/order-costs';
import type { StaffPickerCategory, StaffPickerProduct } from '../../features/products/public';
import type { WeightScale } from '../../features/products/weight';
import type { FieldErrors } from '../../lib/validation/errors';

interface Props {
  csrfToken: string;
  submitLabel: string;
  values: {
    customerName: string;
    phone: string;
    address: string;
    note: string;
    provinceCode: string;
    wardCode: string;
    addressLine: string;
    orderTotal: string;
    discountCode: string;
    discountExtra: string;
  };
  flagForm: StaffFlagForm;
  flagError?: string;
  errors?: FieldErrors;
  lineError?: string;
  editorLines: StaffLineInput[];
  stored?: StoredOrderLine[];
  editorChoices: { id: number; name: string; price: number; weightScale: WeightScale; active: boolean; coverUrl?: string | null; categorySlug?: string }[];
  pickerProducts: StaffPickerProduct[];
  pickerCategories: StaffPickerCategory[];
  discountChoices: StaffDiscountChoice[];
  shippingCosts: ReadonlyArray<{ name: string; kind: OrderCostKind; value: number }>;
  defaultShippingFee: string;
  /** Layout hẹp + tra SĐT + chip bán chạy (Chrome extension / POS). */
  pos?: boolean;
  lookupUrl?: string;
}

const {
  csrfToken,
  submitLabel,
  values,
  flagForm,
  flagError = '',
  errors = {},
  lineError = '',
  editorLines,
  stored = [],
  editorChoices,
  pickerProducts,
  pickerCategories,
  discountChoices,
  shippingCosts,
  defaultShippingFee,
  pos = false,
  lookupUrl = '',
} = Astro.props;

---

<form class:list={['staff-order', pos && 'staff-order-pos']} method="post" data-busy autocomplete="off" data-pos={pos ? '1' : undefined} data-lookup-url={pos ? lookupUrl : undefined}>
  <input type="hidden" name="csrf" value={csrfToken} />
  <section class="od-card staff-order-customer">
    <h2>Khách hàng</h2>
    {
      pos && (
        <div class="pos-lookup" data-pos-lookup>
          <label class="pos-lookup-field">
            <span class="sr-only">Dán SĐT tra đơn</span>
            <input class="field" type="search" inputmode="tel" maxlength="20" placeholder="Dán SĐT tra đơn..." data-lookup-phone autocomplete="off" />
          </label>
          <button class="btn" type="button" data-lookup-run>Tra</button>
          <p class="pos-lookup-result od-note" data-lookup-result hidden></p>
        </div>
      )
    }
    <div class="form-pair">
      <div>
        <label class="block">
          <span class="od-label">Họ tên</span>
          <input class="field" name="customerName" required maxlength="80" autocomplete="name" value={values.customerName} data-customer-name />
        </label>
        {errors.customerName && <p class="error-text mt-2">{errors.customerName}</p>}
      </div>
      <div>
        <label class="block">
          <span class="od-label">Số điện thoại</span>
          <input class="field" type="tel" name="phone" required maxlength="20" inputmode="tel" autocomplete="tel" value={values.phone} data-customer-phone />
        </label>
        {errors.phone && <p class="error-text mt-2">{errors.phone}</p>}
      </div>
    </div>
    <AddressField
      idPrefix="staff"
      error={errors.address}
      address={values.address}
      provinceCode={values.provinceCode}
      wardCode={values.wardCode}
      line={values.addressLine}
      paired
    />
    {
      !pos && (
        <>
          <div class="mt-4">
            <StaffOrderMeta value={flagForm} error={flagError} shippingCosts={shippingCosts} defaultShipFee={defaultShippingFee} />
          </div>
          <label class="mt-4 block">
            <span class="od-label">Ghi chú của khách</span>
            <input class="field" name="note" maxlength="500" placeholder="Ví dụ: đặt qua Zalo" value={values.note} />
          </label>
          {errors.note && <p class="error-text mt-2">{errors.note}</p>}
        </>
      )
    }
  </section>

  <div class="staff-order-side">
    {pos && <StaffProductPicker pickerProducts={pickerProducts} pickerCategories={pickerCategories} pos />}

    <section class="od-card staff-order-cart">
      {
        pickerProducts.length === 0 && editorLines.length === 0 ? (
          <>
            <h2>Sản phẩm trong đơn</h2>
            <p class="od-note">Chưa có sản phẩm đang bán.</p>
          </>
        ) : (
          <div class="staff-cart-panel">
            <h2>Sản phẩm trong đơn</h2>
            <OrderLineEditor
              choices={editorChoices}
              lines={editorLines}
              stored={stored}
              orderTotal={values.orderTotal}
              discountCode={values.discountCode}
              discountChoices={discountChoices}
              extraDiscount={values.discountExtra}
              error={lineError}
              allowEmpty
              cart
            />
          </div>
        )
      }
    </section>

    <div class="staff-order-submit">
      <button class="btn btn-primary w-full" type="submit">{submitLabel}</button>
    </div>

    {!pos && <StaffProductPicker pickerProducts={pickerProducts} pickerCategories={pickerCategories} />}
  </div>

  {
    pos && (
      <section class="od-card staff-order-extra">
        <StaffOrderMeta value={flagForm} error={flagError} shippingCosts={shippingCosts} defaultShipFee={defaultShippingFee} />
        <label class="mt-4 block">
          <span class="od-label">Ghi chú của khách</span>
          <input class="field" name="note" maxlength="500" placeholder="Ví dụ: đặt qua Zalo" value={values.note} />
        </label>
        {errors.note && <p class="error-text mt-2">{errors.note}</p>}
      </section>
    )
  }
</form>

<script>
  const root = document.querySelector('.staff-picker');
  const lineEditor = document.querySelector('[data-order-lines]');
  if (root instanceof HTMLElement && lineEditor instanceof HTMLElement) {
    const editor = lineEditor;
    const query = root.querySelector('[data-pick-query]');
    const list = [...root.querySelectorAll<HTMLElement>('[data-pick]')].map((row) => ({
      row,
      name: fold(row.dataset.name ?? ''),
      category: row.dataset.category ?? 'none',
    }));
    const empty = root.querySelector('[data-pick-empty]');
    const limit = root.querySelector('[data-pick-limit]');
    const form = root.closest('form');
    const posMode = form instanceof HTMLFormElement && form.dataset.pos === '1';
    const ALL_TOP = 20;
    const HOT_TOP = 10;
    let category = posMode ? 'hot' : '';
    let text = '';

    function fold(value: string) {
      return value.toLowerCase().normalize('NFD').replace(/\p{M}/gu, '').replace(/đ/g, 'd');
    }

    function needsWeight(row: HTMLElement) {
      return row.dataset.weigh === '1';
    }

    function ready(row: HTMLElement) {
      return !needsWeight(row) || (row.dataset.weight ?? '') !== '';
    }

    function paintAdd(row: HTMLElement) {
      const add = row.querySelector('[data-pick-add]');
      if (add instanceof HTMLButtonElement) add.disabled = !ready(row);
    }

    function collapse(row: HTMLElement) {
      row.dataset.selected = '0';
      const toggle = row.querySelector('[data-pick-toggle]');
      if (toggle instanceof HTMLButtonElement) toggle.setAttribute('aria-pressed', 'false');
      const panel = row.querySelector('[data-pick-panel]');
      if (panel instanceof HTMLElement) panel.hidden = true;
      delete row.dataset.weight;
      for (const button of row.querySelectorAll('[data-weight-choice]')) button.setAttribute('aria-pressed', 'false');
      closeCustomWeight(row);
      paintAdd(row);
    }

    function expand(row: HTMLElement) {
      for (const item of list) {
        if (item.row !== row) collapse(item.row);
      }
      row.dataset.selected = '1';
      const toggle = row.querySelector('[data-pick-toggle]');
      if (toggle instanceof HTMLButtonElement) toggle.setAttribute('aria-pressed', 'true');
      const panel = row.querySelector('[data-pick-panel]');
      if (panel instanceof HTMLElement) panel.hidden = false;
      paintAdd(row);
    }

    function openCustomWeight(row: HTMLElement) {
      const custom = row.querySelector('[data-weight-custom]');
      const input = row.querySelector('[data-weight-custom-input]');
      const add = row.querySelector('[data-weight-add]');
      if (custom instanceof HTMLElement) custom.hidden = false;
      if (add instanceof HTMLButtonElement) add.hidden = true;
      if (input instanceof HTMLInputElement) {
        input.value = '';
        input.focus();
        input.select();
      }
    }

    function closeCustomWeight(row: HTMLElement) {
      const custom = row.querySelector('[data-weight-custom]');
      const input = row.querySelector('[data-weight-custom-input]');
      const add = row.querySelector('[data-weight-add]');
      if (custom instanceof HTMLElement) custom.hidden = true;
      if (add instanceof HTMLButtonElement) add.hidden = false;
      if (input instanceof HTMLInputElement) input.value = '';
    }

    function commitCustomWeight(row: HTMLElement) {
      const input = row.querySelector('[data-weight-custom-input]');
      if (!(input instanceof HTMLInputElement)) return;
      const label = input.value.replace(/\s+/g, ' ').trim();
      if (label) ensureWeightChip(row, label);
      else input.focus();
    }

    function chooseWeight(row: HTMLElement, label: string) {
      row.dataset.weight = label;
      for (const button of row.querySelectorAll<HTMLButtonElement>('[data-weight-choice]')) {
        button.setAttribute('aria-pressed', String(button.dataset.weightChoice === label));
      }
      paintAdd(row);
    }

    function ensureWeightChip(row: HTMLElement, label: string) {
      const weights = row.querySelector('[data-weights]');
      if (!(weights instanceof HTMLElement)) return;
      const existing = [...weights.querySelectorAll<HTMLButtonElement>('[data-weight-choice]')].find((button) => button.dataset.weightChoice === label);
      if (existing) {
        chooseWeight(row, label);
        closeCustomWeight(row);
        return;
      }
      const button = document.createElement('button');
      button.className = 'category-preset';
      button.type = 'button';
      button.dataset.weightChoice = label;
      button.setAttribute('aria-pressed', 'false');
      button.innerHTML = `<span></span>`;
      const span = button.querySelector('span');
      if (span) span.textContent = label;
      const slot = weights.querySelector('[data-weight-add-slot]');
      if (slot) weights.insertBefore(button, slot);
      else weights.appendChild(button);
      chooseWeight(row, label);
      closeCustomWeight(row);
    }

    function room() {
      const count = editor.querySelectorAll('[data-line-list] > [data-line]').length;
      return Number(editor.dataset.max || '8') - count;
    }

    function addRow(row: HTMLElement) {
      if (!ready(row)) return;
      if (room() <= 0) {
        if (limit instanceof HTMLElement) limit.hidden = false;
        return;
      }
      if (limit instanceof HTMLElement) limit.hidden = true;
      const qty = row.querySelector('[data-pick-qty]');
      const note = row.querySelector('[data-pick-note]');
      document.dispatchEvent(
        new CustomEvent('staff-add-product', {
          detail: {
            id: row.dataset.id ?? '',
            weight: row.dataset.weight ?? '',
            quantity: qty instanceof HTMLInputElement ? qty.value : '1',
            note: note instanceof HTMLInputElement ? note.value : '',
            cover: row.querySelector('.staff-pick-photo') instanceof HTMLImageElement ? row.querySelector<HTMLImageElement>('.staff-pick-photo')?.src ?? '' : '',
            focus: true,
          },
        }),
      );
      if (qty instanceof HTMLInputElement) qty.value = '1';
      if (note instanceof HTMLInputElement) note.value = '';
      collapse(row);
    }

    function apply() {
      const needle = fold(text.trim());
      const hotOnly = category === 'hot' && needle === '';
      const topOnly = category === '' && needle === '';
      const allCats = category === '' || category === 'all' || category === 'hot';
      let shown = 0;
      for (const item of list) {
        const match = (allCats || item.category === category) && (needle === '' || item.name.includes(needle));
        let visible = match;
        if (visible && hotOnly) visible = shown < HOT_TOP;
        if (visible && topOnly) visible = shown < ALL_TOP;
        item.row.hidden = !visible;
        if (visible) shown += 1;
        else if (item.row.dataset.selected === '1') collapse(item.row);
      }
      if (empty instanceof HTMLElement) empty.hidden = shown > 0;
    }

    root.addEventListener('click', (event) => {
      const button = event.target instanceof Element ? event.target.closest('button') : null;
      if (!(button instanceof HTMLButtonElement)) return;
      if (button.hasAttribute('data-category')) {
        category = button.dataset.category ?? '';
        for (const item of root.querySelectorAll<HTMLButtonElement>('button[data-category]')) item.setAttribute('aria-pressed', String(item === button));
        apply();
        return;
      }
      const row = button.closest('[data-pick]');
      if (!(row instanceof HTMLElement)) return;
      if (button.hasAttribute('data-weight-choice')) {
        chooseWeight(row, button.dataset.weightChoice ?? '');
        return;
      }
      if (button.hasAttribute('data-qty-dec') || button.hasAttribute('data-qty-inc')) {
        const input = row.querySelector('[data-pick-qty]');
        if (!(input instanceof HTMLInputElement)) return;
        const min = Number(input.min || '1');
        const max = Number(input.max || '20');
        let next = Number(input.value);
        if (!Number.isInteger(next)) next = min;
        next = button.hasAttribute('data-qty-inc') ? next + 1 : next - 1;
        input.value = String(Math.min(max, Math.max(min, next)));
        input.dispatchEvent(new Event('input', { bubbles: true }));
        return;
      }
      if (button.hasAttribute('data-weight-add')) {
        openCustomWeight(row);
        return;
      }
      if (button.hasAttribute('data-weight-custom-close')) {
        closeCustomWeight(row);
        return;
      }
      if (button.hasAttribute('data-pick-add')) {
        addRow(row);
        return;
      }
      if (button.hasAttribute('data-pick-toggle')) {
        if (row.dataset.selected === '1') collapse(row);
        else expand(row);
      }
    });

    root.addEventListener('keydown', (event) => {
      const target = event.target;
      if (!(target instanceof HTMLInputElement) || !target.hasAttribute('data-weight-custom-input')) return;
      const row = target.closest('[data-pick]');
      if (!(row instanceof HTMLElement)) return;
      if (event.key === 'Enter') {
        event.preventDefault();
        commitCustomWeight(row);
        return;
      }
      if (event.key === 'Escape') {
        event.preventDefault();
        closeCustomWeight(row);
      }
    });

    if (query instanceof HTMLInputElement) {
      query.addEventListener('keydown', (event) => {
        if (event.key === 'Enter') event.preventDefault();
      });
      query.addEventListener('input', () => {
        text = query.value;
        apply();
      });
    }
    apply();
  }
</script>

{
  pos && (
    <script>
      const form = document.querySelector('form.staff-order-pos');
      if (form instanceof HTMLFormElement) {
        const lookupUrl = form.dataset.lookupUrl ?? '';
        const phoneInput = form.querySelector('[data-lookup-phone]');
        const run = form.querySelector('[data-lookup-run]');
        const result = form.querySelector('[data-lookup-result]');
        const customerName = form.querySelector('[data-customer-name]');
        const customerPhone = form.querySelector('[data-customer-phone]');
        const addressRoot = form.querySelector('[data-address]');

        function money(amount: number) {
          return new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND', maximumFractionDigits: 0 }).format(amount);
        }

        function dayLabel(timestamp: number) {
          return new Intl.DateTimeFormat('vi-VN', { day: '2-digit', month: '2-digit', year: 'numeric' }).format(new Date(timestamp));
        }

        async function lookup() {
          if (!(phoneInput instanceof HTMLInputElement) || !(result instanceof HTMLElement)) return;
          const phone = phoneInput.value.trim();
          if (!phone) {
            result.hidden = false;
            result.textContent = 'Dán hoặc nhập số điện thoại để tra.';
            return;
          }
          result.hidden = false;
          result.textContent = 'Đang tra…';
          try {
            const response = await fetch(`${lookupUrl}?phone=${encodeURIComponent(phone)}`, {
              headers: { accept: 'application/json' },
              credentials: 'same-origin',
            });
            const data = (await response.json()) as {
              ok: boolean;
              found?: boolean;
              error?: string;
              customer?: {
                phone: string;
                customerName: string;
                address: string;
                orderCount: number;
                recent: {
                  code: string;
                  fulfillLabel: string;
                  statusLabel: string;
                  totalPrice: number;
                  productName: string;
                  createdAt: number;
                } | null;
              };
            };
            if (!response.ok || !data.ok) {
              result.textContent = data.error || 'Không tra được khách.';
              return;
            }
            if (!data.found || !data.customer) {
              result.textContent = 'Chưa có đơn với số này.';
              if (customerPhone instanceof HTMLInputElement) customerPhone.value = phone.replace(/\D/g, '') || phone;
              return;
            }
            const customer = data.customer;
            if (customerName instanceof HTMLInputElement) customerName.value = customer.customerName;
            if (customerPhone instanceof HTMLInputElement) customerPhone.value = customer.phone;
            if (addressRoot instanceof HTMLElement) {
              addressRoot.dispatchEvent(new CustomEvent('pos-set-address', { detail: { address: customer.address } }));
            }
            const recent = customer.recent;
            result.textContent = recent
              ? `${recent.fulfillLabel || recent.statusLabel} · ${recent.code} · ${dayLabel(recent.createdAt)} · ${money(recent.totalPrice)} · ${customer.orderCount} đơn · ${recent.productName}`
              : `Đã điền từ ${customer.orderCount} đơn trước.`;
          } catch {
            result.textContent = 'Không tra được khách.';
          }
        }

        if (run instanceof HTMLButtonElement) run.addEventListener('click', () => void lookup());
        if (phoneInput instanceof HTMLInputElement) {
          phoneInput.addEventListener('keydown', (event) => {
            if (event.key === 'Enter') {
              event.preventDefault();
              void lookup();
            }
          });
        }
      }
    </script>
  )
}
