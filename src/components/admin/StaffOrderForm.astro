---
import AddressField from '../public/AddressField.astro';
import OrderLineEditor from './OrderLineEditor.astro';
import StaffOrderMeta from './StaffOrderMeta.astro';
import StaffProductPicker from './StaffProductPicker.astro';
import type { StaffDiscountChoice } from '../../features/discounts/discounts';
import type { StaffFlagForm, StaffLineInput, StoredOrderLine } from '../../features/orders/staff';
import type { OrderCostKind } from '../../features/costs/order-costs';
import type { StaffPickerCategory, StaffPickerProduct } from '../../features/products/public';
import type { WeightScale } from '../../features/products/weight';
import type { FieldErrors } from '../../lib/validation/errors';

interface Props {
  csrfToken: string;
  submitLabel: string;
  values: {
    customerName: string;
    phone: string;
    address: string;
    note: string;
    provinceCode: string;
    wardCode: string;
    addressLine: string;
    orderTotal: string;
    discountCode: string;
    discountExtra: string;
  };
  flagForm: StaffFlagForm;
  flagError?: string;
  errors?: FieldErrors;
  lineError?: string;
  editorLines: StaffLineInput[];
  stored?: StoredOrderLine[];
  editorChoices: { id: number; name: string; price: number; weightScale: WeightScale; active: boolean; coverUrl?: string | null; categorySlug?: string }[];
  pickerProducts: StaffPickerProduct[];
  pickerCategories: StaffPickerCategory[];
  discountChoices: StaffDiscountChoice[];
  shippingCosts: ReadonlyArray<{ name: string; kind: OrderCostKind; value: number }>;
  defaultShippingFee: string;
  /** Layout hẹp + tra SĐT + chip bán chạy (Chrome extension / POS). */
  pos?: boolean;
  lookupUrl?: string;
  /** Ô dán nhanh SĐT + địa chỉ, chỉ trang thêm đơn. */
  quickPaste?: boolean;
}

const {
  csrfToken,
  submitLabel,
  values,
  flagForm,
  flagError = '',
  errors = {},
  lineError = '',
  editorLines,
  stored = [],
  editorChoices,
  pickerProducts,
  pickerCategories,
  discountChoices,
  shippingCosts,
  defaultShippingFee,
  pos = false,
  lookupUrl = '',
  quickPaste = false,
} = Astro.props;

---

<form
  class:list={['staff-order', pos && 'staff-order-pos']}
  method="post"
  data-busy
  autocomplete="off"
  data-pos={pos ? '1' : undefined}
  data-lookup-url={pos ? lookupUrl : undefined}
  novalidate={pos ? true : undefined}
>
  <input type="hidden" name="csrf" value={csrfToken} />
  <section class="od-card staff-order-customer">
    <h2>Khách hàng</h2>
    {
      pos && (
        <div class="pos-lookup" data-pos-lookup>
          <label class="pos-lookup-field">
            <span class="sr-only">Dán SĐT tra đơn</span>
            <input class="field" type="search" inputmode="tel" maxlength="20" placeholder="Dán SĐT tra đơn..." data-lookup-phone autocomplete="off" />
          </label>
          <button class="btn" type="button" data-lookup-run>Tra</button>
          <p class="pos-lookup-result od-note" data-lookup-result hidden></p>
        </div>
      )
    }
    {
      quickPaste && (
        <div class="quick-paste" data-quick-paste>
          <label class="block">
            <span class="od-label">Dán nhanh thông tin nhận hàng</span>
            <textarea
              class="field"
              rows="3"
              maxlength="500"
              placeholder={'Ví dụ:\n0901234567\n12 Nguyễn Huệ, Phường Bến Thành, TP.HCM'}
              data-quick-paste-input
            ></textarea>
          </label>
          <div class="quick-paste-bar">
            <button class="btn" type="button" data-quick-paste-run>Phân tích</button>
            <p class="quick-paste-status od-note" data-quick-paste-status role="status"></p>
          </div>
        </div>
      )
    }
    <div class="form-pair">
      <div>
        <label class="block">
          <span class="od-label">Họ tên</span>
          <input class="field" name="customerName" required maxlength="80" autocomplete="name" value={values.customerName} data-customer-name />
        </label>
        {errors.customerName && <p class="error-text mt-2">{errors.customerName}</p>}
      </div>
      <div>
        <label class="block">
          <span class="od-label">Số điện thoại</span>
          <input class="field" type="tel" name="phone" required maxlength="20" inputmode="tel" autocomplete="tel" value={values.phone} data-customer-phone />
        </label>
        {errors.phone && <p class="error-text mt-2">{errors.phone}</p>}
      </div>
    </div>
    {
      pos && (
        <div class="pos-legacy" data-pos-legacy>
          <div class="pos-legacy-head">
            <div class="pos-legacy-title-row">
              <label class="od-label" for="pos-legacy-input">Tìm nhanh địa chỉ cũ</label>
              <button type="button" class="pos-legacy-toggle" data-pos-legacy-toggle aria-expanded="false">
                Chọn tay 3 cấp
              </button>
            </div>
            <input
              id="pos-legacy-input"
              class="field"
              type="search"
              placeholder="Tráng Việt, Mê Linh hoặc dán cả câu"
              autocomplete="off"
              spellcheck="false"
              data-pos-legacy-input
            />
          </div>
          <p class="pos-legacy-hint od-note" data-pos-legacy-hint hidden></p>
          <ul class="pos-legacy-list" data-pos-legacy-list role="listbox" hidden></ul>
          <div class="pos-legacy-manual" data-pos-legacy-manual hidden>
            <p class="pos-legacy-manual-title">Chọn tay địa chỉ cũ</p>
            <div class="pos-legacy-manual-grid">
              <div class="block min-w-0">
                <span class="od-label" id="pos-legacy-province-label">Tỉnh / TP cũ</span>
                <div class="address-combo" data-pos-legacy-combo="province">
                  <button
                    class="address-combo-trigger field"
                    type="button"
                    data-combo-trigger
                    aria-haspopup="listbox"
                    aria-expanded="false"
                    aria-labelledby="pos-legacy-province-label"
                  >
                    <span class="address-combo-value is-placeholder" data-combo-value>Chọn tỉnh/TP cũ</span>
                    <span class="address-combo-caret" aria-hidden="true">
                      <svg viewBox="0 0 24 24"><path d="m6 9 6 6 6-6"></path></svg>
                    </span>
                  </button>
                  <div class="address-combo-panel" data-combo-panel hidden>
                    <input class="address-combo-query" type="search" placeholder="Tìm tỉnh/TP..." autocomplete="off" data-combo-query />
                    <p class="address-combo-head">Tỉnh / TP (cũ)</p>
                    <ul class="address-combo-list" data-combo-list role="listbox"></ul>
                  </div>
                </div>
              </div>
              <div class="block min-w-0">
                <span class="od-label" id="pos-legacy-district-label">Quận / Huyện cũ</span>
                <div class="address-combo" data-pos-legacy-combo="district">
                  <button
                    class="address-combo-trigger field"
                    type="button"
                    data-combo-trigger
                    aria-haspopup="listbox"
                    aria-expanded="false"
                    aria-labelledby="pos-legacy-district-label"
                    disabled
                  >
                    <span class="address-combo-value is-placeholder" data-combo-value>Chọn tỉnh trước</span>
                    <span class="address-combo-caret" aria-hidden="true">
                      <svg viewBox="0 0 24 24"><path d="m6 9 6 6 6-6"></path></svg>
                    </span>
                  </button>
                  <div class="address-combo-panel" data-combo-panel hidden>
                    <input class="address-combo-query" type="search" placeholder="Tìm quận/huyện..." autocomplete="off" data-combo-query />
                    <p class="address-combo-head">Quận / Huyện (cũ)</p>
                    <ul class="address-combo-list" data-combo-list role="listbox"></ul>
                  </div>
                </div>
              </div>
              <div class="block min-w-0">
                <span class="od-label" id="pos-legacy-ward-label">Phường / Xã cũ</span>
                <div class="address-combo" data-pos-legacy-combo="ward">
                  <button
                    class="address-combo-trigger field"
                    type="button"
                    data-combo-trigger
                    aria-haspopup="listbox"
                    aria-expanded="false"
                    aria-labelledby="pos-legacy-ward-label"
                    disabled
                  >
                    <span class="address-combo-value is-placeholder" data-combo-value>Chọn huyện trước</span>
                    <span class="address-combo-caret" aria-hidden="true">
                      <svg viewBox="0 0 24 24"><path d="m6 9 6 6 6-6"></path></svg>
                    </span>
                  </button>
                  <div class="address-combo-panel" data-combo-panel hidden>
                    <input class="address-combo-query" type="search" placeholder="Tìm phường/xã..." autocomplete="off" data-combo-query />
                    <p class="address-combo-head">Phường / Xã (cũ)</p>
                    <ul class="address-combo-list" data-combo-list role="listbox"></ul>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      )
    }
    <AddressField
      idPrefix="staff"
      error={errors.address}
      address={values.address}
      provinceCode={values.provinceCode}
      wardCode={values.wardCode}
      line={values.addressLine}
      paired
    />
    {
      !pos && (
        <>
          <div class="mt-4">
            <StaffOrderMeta value={flagForm} error={flagError} shippingCosts={shippingCosts} defaultShipFee={defaultShippingFee} />
          </div>
          <label class="mt-4 block">
            <span class="od-label">Ghi chú của khách</span>
            <input class="field" name="note" maxlength="500" placeholder="Ví dụ: đặt qua Zalo" value={values.note} />
          </label>
          {errors.note && <p class="error-text mt-2">{errors.note}</p>}
        </>
      )
    }
  </section>

  <div class="staff-order-side">
    {pos && <StaffProductPicker pickerProducts={pickerProducts} pickerCategories={pickerCategories} pos />}

    {
      pickerProducts.length === 0 && editorLines.length === 0 ? (
        <section class="od-card staff-order-cart">
          <h2>Sản phẩm trong đơn</h2>
          <p class="od-note">Chưa có sản phẩm đang bán.</p>
        </section>
      ) : (
        <OrderLineEditor
          choices={editorChoices}
          lines={editorLines}
          stored={stored}
          orderTotal={values.orderTotal}
          discountCode={values.discountCode}
          discountChoices={discountChoices}
          extraDiscount={values.discountExtra}
          error={lineError}
          allowEmpty
          cart
        />
      )
    }

    <div class="staff-order-submit">
      <button class="btn btn-primary w-full" type="submit">{submitLabel}</button>
    </div>

    {!pos && <StaffProductPicker pickerProducts={pickerProducts} pickerCategories={pickerCategories} />}
  </div>

  {
    pos && (
      <section class="od-card staff-order-extra">
        <StaffOrderMeta value={flagForm} error={flagError} shippingCosts={shippingCosts} defaultShipFee={defaultShippingFee} />
        <label class="mt-4 block">
          <span class="od-label">Ghi chú của khách</span>
          <input class="field" name="note" maxlength="500" placeholder="Ví dụ: đặt qua Zalo" value={values.note} />
        </label>
        {errors.note && <p class="error-text mt-2">{errors.note}</p>}
      </section>
    )
  }
</form>

<div class="staff-custom-modal" data-staff-custom-modal hidden>
  <button type="button" class="staff-custom-modal-backdrop" data-staff-custom-close aria-label="Đóng"></button>
  <div class="staff-custom-modal-sheet" role="dialog" aria-modal="true" aria-labelledby="staff-custom-modal-title">
    <div class="staff-custom-modal-head">
      <h3 id="staff-custom-modal-title">Sản phẩm tùy chỉnh</h3>
      <button type="button" class="staff-custom-modal-x" data-staff-custom-close aria-label="Đóng">×</button>
    </div>
    <p class="od-note" data-staff-custom-base></p>
    <form class="staff-custom-modal-form" data-staff-custom-form autocomplete="off">
      <label class="block">
        <span class="od-label">Tên trên đơn</span>
        <input class="field" maxlength="160" data-staff-custom-name required />
      </label>
      <div class="staff-custom-modal-pair">
        <label class="block">
          <span class="od-label">Giá bán</span>
          <input class="field" inputmode="numeric" maxlength="11" data-staff-custom-price required />
        </label>
        <label class="block">
          <span class="od-label">Giá vốn</span>
          <input class="field" inputmode="numeric" maxlength="11" data-staff-custom-cost required />
        </label>
      </div>
      <div class="staff-custom-modal-row">
        <div class="staff-qty-stepper" data-staff-custom-qty-stepper>
          <button class="staff-qty-btn" type="button" data-staff-custom-qty-dec aria-label="Giảm số lượng">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14" /></svg>
          </button>
          <input class="field staff-qty-input" type="number" min="1" max="20" value="1" inputmode="numeric" data-staff-custom-qty aria-label="Số lượng" />
          <button class="staff-qty-btn" type="button" data-staff-custom-qty-inc aria-label="Tăng số lượng">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
          </button>
        </div>
        <input class="field" maxlength="160" placeholder="Lưu ý sản phẩm…" data-staff-custom-note />
      </div>
      <div class="staff-custom-modal-weight" data-staff-custom-weight hidden>
        <span class="od-label">Cân nặng</span>
        <div class="staff-pick-weights" data-staff-custom-chips></div>
      </div>
      <p class="error-text" data-staff-custom-error hidden role="alert"></p>
      <div class="staff-custom-modal-actions">
        <button type="button" class="btn" data-staff-custom-close>Hủy</button>
        <button type="submit" class="btn btn-primary">Thêm vào đơn</button>
      </div>
    </form>
  </div>
</div>

<script>
  const root = document.querySelector('.staff-picker');
  const lineEditor = document.querySelector('[data-order-lines]');
  if (root instanceof HTMLElement && lineEditor instanceof HTMLElement) {
    const editor = lineEditor;
    const query = root.querySelector('[data-pick-query]');
    const list = [...root.querySelectorAll<HTMLElement>('[data-pick]')].map((row) => ({
      row,
      name: fold(row.dataset.name ?? ''),
      category: row.dataset.category ?? 'none',
    }));
    const empty = root.querySelector('[data-pick-empty]');
    const limit = root.querySelector('[data-pick-limit]');
    const form = root.closest('form');
    const posMode = form instanceof HTMLFormElement && form.dataset.pos === '1';
    const ALL_TOP = 20;
    const HOT_TOP = 10;
    let category = posMode ? 'hot' : '';
    let text = '';

    function fold(value: string) {
      return value.toLowerCase().normalize('NFD').replace(/\p{M}/gu, '').replace(/đ/g, 'd');
    }

    function needsWeight(row: HTMLElement) {
      return row.dataset.weigh === '1';
    }

    function ready(row: HTMLElement) {
      return !needsWeight(row) || (row.dataset.weight ?? '') !== '';
    }

    function paintAdd(row: HTMLElement) {
      const add = row.querySelector('[data-pick-add]');
      if (add instanceof HTMLButtonElement) add.disabled = !ready(row);
    }

    function collapse(row: HTMLElement) {
      row.dataset.selected = '0';
      const toggle = row.querySelector('[data-pick-toggle]');
      if (toggle instanceof HTMLButtonElement) toggle.setAttribute('aria-pressed', 'false');
      const panel = row.querySelector('[data-pick-panel]');
      if (panel instanceof HTMLElement) panel.hidden = true;
      delete row.dataset.weight;
      for (const button of row.querySelectorAll('[data-weight-choice]')) button.setAttribute('aria-pressed', 'false');
      closeCustomWeight(row);
      paintAdd(row);
    }

    function expand(row: HTMLElement) {
      for (const item of list) {
        if (item.row !== row) collapse(item.row);
      }
      row.dataset.selected = '1';
      const toggle = row.querySelector('[data-pick-toggle]');
      if (toggle instanceof HTMLButtonElement) toggle.setAttribute('aria-pressed', 'true');
      const panel = row.querySelector('[data-pick-panel]');
      if (panel instanceof HTMLElement) panel.hidden = false;
      paintAdd(row);
    }

    function openCustomWeight(row: HTMLElement) {
      const custom = row.querySelector('[data-weight-custom]');
      const input = row.querySelector('[data-weight-custom-input]');
      const add = row.querySelector('[data-weight-add]');
      if (custom instanceof HTMLElement) custom.hidden = false;
      if (add instanceof HTMLButtonElement) add.hidden = true;
      if (input instanceof HTMLInputElement) {
        input.value = '';
        input.focus();
        input.select();
      }
    }

    function closeCustomWeight(row: HTMLElement) {
      const custom = row.querySelector('[data-weight-custom]');
      const input = row.querySelector('[data-weight-custom-input]');
      const add = row.querySelector('[data-weight-add]');
      if (custom instanceof HTMLElement) custom.hidden = true;
      if (add instanceof HTMLButtonElement) add.hidden = false;
      if (input instanceof HTMLInputElement) input.value = '';
    }

    function commitCustomWeight(row: HTMLElement) {
      const input = row.querySelector('[data-weight-custom-input]');
      if (!(input instanceof HTMLInputElement)) return;
      const label = input.value.replace(/\s+/g, ' ').trim();
      if (label) ensureWeightChip(row, label);
      else input.focus();
    }

    function chooseWeight(row: HTMLElement, label: string) {
      row.dataset.weight = label;
      for (const button of row.querySelectorAll<HTMLButtonElement>('[data-weight-choice]')) {
        button.setAttribute('aria-pressed', String(button.dataset.weightChoice === label));
      }
      paintAdd(row);
    }

    function ensureWeightChip(row: HTMLElement, label: string) {
      const weights = row.querySelector('[data-weights]');
      if (!(weights instanceof HTMLElement)) return;
      const existing = [...weights.querySelectorAll<HTMLButtonElement>('[data-weight-choice]')].find((button) => button.dataset.weightChoice === label);
      if (existing) {
        chooseWeight(row, label);
        closeCustomWeight(row);
        return;
      }
      const button = document.createElement('button');
      button.className = 'category-preset';
      button.type = 'button';
      button.dataset.weightChoice = label;
      button.setAttribute('aria-pressed', 'false');
      button.innerHTML = `<span></span>`;
      const span = button.querySelector('span');
      if (span) span.textContent = label;
      const slot = weights.querySelector('[data-weight-add-slot]');
      if (slot) weights.insertBefore(button, slot);
      else weights.appendChild(button);
      chooseWeight(row, label);
      closeCustomWeight(row);
    }

    function room() {
      const count = editor.querySelectorAll('[data-line-list] > [data-line]').length;
      return Number(editor.dataset.max || '8') - count;
    }

    function addRow(row: HTMLElement) {
      if (!ready(row)) return;
      if (room() <= 0) {
        if (limit instanceof HTMLElement) limit.hidden = false;
        return;
      }
      if (limit instanceof HTMLElement) limit.hidden = true;
      const qty = row.querySelector('[data-pick-qty]');
      const note = row.querySelector('[data-pick-note]');
      document.dispatchEvent(
        new CustomEvent('staff-add-product', {
          detail: {
            id: row.dataset.id ?? '',
            weight: row.dataset.weight ?? '',
            quantity: qty instanceof HTMLInputElement ? qty.value : '1',
            note: note instanceof HTMLInputElement ? note.value : '',
            cover: row.querySelector('.staff-pick-photo') instanceof HTMLImageElement ? row.querySelector<HTMLImageElement>('.staff-pick-photo')?.src ?? '' : '',
            focus: true,
          },
        }),
      );
      if (qty instanceof HTMLInputElement) qty.value = '1';
      if (note instanceof HTMLInputElement) note.value = '';
      collapse(row);
    }

    function groupMoney(value: string) {
      const raw = value.replace(/\D/g, '').slice(0, 8);
      if (!raw) return '';
      return raw.replace(/\B(?=(\d{3})+(?!\d))/g, '.');
    }

    function moneyDigits(value: string) {
      const text = value.replace(/\D/g, '');
      if (!text) return null;
      const amount = Number(text);
      return Number.isSafeInteger(amount) ? amount : null;
    }

    const customModal = document.querySelector('[data-staff-custom-modal]');
    /** @type {HTMLElement | null} */
    let customSource: HTMLElement | null = null;
    let customWeight = '';

    function customEls() {
      return {
        root: customModal,
        form: document.querySelector('[data-staff-custom-form]'),
        base: document.querySelector('[data-staff-custom-base]'),
        name: document.querySelector('[data-staff-custom-name]'),
        price: document.querySelector('[data-staff-custom-price]'),
        cost: document.querySelector('[data-staff-custom-cost]'),
        qty: document.querySelector('[data-staff-custom-qty]'),
        note: document.querySelector('[data-staff-custom-note]'),
        weightBox: document.querySelector('[data-staff-custom-weight]'),
        chips: document.querySelector('[data-staff-custom-chips]'),
        error: document.querySelector('[data-staff-custom-error]'),
      };
    }

    function setCustomError(text: string) {
      const { error } = customEls();
      const msg = String(text || '').trim();
      if (error instanceof HTMLElement) {
        error.hidden = !msg;
        error.textContent = msg;
      }
    }

    function paintCustomChips(row: HTMLElement) {
      const { chips, weightBox } = customEls();
      const weigh = needsWeight(row);
      if (weightBox instanceof HTMLElement) weightBox.hidden = !weigh;
      if (!(chips instanceof HTMLElement)) return;
      chips.replaceChildren();
      if (!weigh) {
        customWeight = '';
        return;
      }
      for (const button of row.querySelectorAll<HTMLButtonElement>('[data-weight-choice]')) {
        const label = button.dataset.weightChoice ?? '';
        if (!label) continue;
        const chip = document.createElement('button');
        chip.type = 'button';
        chip.className = 'category-preset';
        chip.dataset.staffCustomChip = label;
        chip.setAttribute('aria-pressed', String(label === customWeight));
        chip.innerHTML = '<span></span>';
        const span = chip.querySelector('span');
        if (span) span.textContent = label;
        chips.appendChild(chip);
      }
    }

    function openCustomModal(row: HTMLElement) {
      if (room() <= 0) {
        if (limit instanceof HTMLElement) limit.hidden = false;
        return;
      }
      customSource = row;
      customWeight = '';
      const els = customEls();
      const name = row.dataset.name ?? '';
      const price = row.dataset.price ?? '';
      const unitCost = row.dataset.unitCost ?? '';
      if (els.base instanceof HTMLElement) els.base.textContent = name ? `Mẫu gốc: ${name}` : '';
      if (els.name instanceof HTMLInputElement) els.name.value = name;
      if (els.price instanceof HTMLInputElement) els.price.value = groupMoney(price);
      if (els.cost instanceof HTMLInputElement) els.cost.value = groupMoney(unitCost);
      if (els.qty instanceof HTMLInputElement) els.qty.value = '1';
      if (els.note instanceof HTMLInputElement) els.note.value = '';
      setCustomError('');
      paintCustomChips(row);
      if (els.root instanceof HTMLElement) els.root.hidden = false;
      queueMicrotask(() => {
        if (els.name instanceof HTMLInputElement) {
          els.name.focus();
          els.name.select();
        }
      });
    }

    function closeCustomModal() {
      customSource = null;
      customWeight = '';
      const { root: modal } = customEls();
      if (modal instanceof HTMLElement) modal.hidden = true;
      setCustomError('');
    }

    function commitCustomModal() {
      if (!(customSource instanceof HTMLElement)) return false;
      if (room() <= 0) {
        setCustomError(`Một đơn tối đa ${editor.dataset.max || '8'} mẫu.`);
        return false;
      }
      const els = customEls();
      const name = els.name instanceof HTMLInputElement ? els.name.value.replace(/\s+/g, ' ').trim() : '';
      if (!name) {
        setCustomError('Nhập tên sản phẩm.');
        return false;
      }
      const unitPrice = moneyDigits(els.price instanceof HTMLInputElement ? els.price.value : '');
      if (unitPrice === null) {
        setCustomError('Giá bán không hợp lệ.');
        return false;
      }
      const costRaw = els.cost instanceof HTMLInputElement ? els.cost.value.trim() : '';
      if (!costRaw) {
        setCustomError('Nhập giá vốn cho dòng tùy chỉnh.');
        return false;
      }
      const unitCost = moneyDigits(costRaw);
      if (unitCost === null) {
        setCustomError('Giá vốn không hợp lệ.');
        return false;
      }
      if (needsWeight(customSource) && !customWeight) {
        setCustomError('Chọn cân nặng cho bé.');
        return false;
      }
      const qty = els.qty instanceof HTMLInputElement ? els.qty.value : '1';
      const note = els.note instanceof HTMLInputElement ? els.note.value.trim().slice(0, 160) : '';
      const cover =
        customSource.querySelector('.staff-pick-photo') instanceof HTMLImageElement
          ? customSource.querySelector<HTMLImageElement>('.staff-pick-photo')?.src ?? ''
          : '';
      const source = customSource;
      document.dispatchEvent(
        new CustomEvent('staff-add-product', {
          detail: {
            id: source.dataset.id ?? '',
            weight: customWeight,
            quantity: qty,
            note,
            cover,
            focus: true,
            custom: true,
            name,
            price: String(unitPrice),
            unitCost: String(unitCost),
          },
        }),
      );
      closeCustomModal();
      collapse(source);
      return true;
    }

    function apply() {
      const needle = fold(text.trim());
      const hotOnly = category === 'hot' && needle === '';
      const topOnly = category === '' && needle === '';
      const allCats = category === '' || category === 'all' || category === 'hot';
      let shown = 0;
      for (const item of list) {
        const match = (allCats || item.category === category) && (needle === '' || item.name.includes(needle));
        let visible = match;
        if (visible && hotOnly) visible = shown < HOT_TOP;
        if (visible && topOnly) visible = shown < ALL_TOP;
        item.row.hidden = !visible;
        if (visible) shown += 1;
        else if (item.row.dataset.selected === '1') collapse(item.row);
      }
      if (empty instanceof HTMLElement) empty.hidden = shown > 0;
    }

    root.addEventListener('click', (event) => {
      const button = event.target instanceof Element ? event.target.closest('button') : null;
      if (!(button instanceof HTMLButtonElement)) return;
      if (button.hasAttribute('data-category')) {
        category = button.dataset.category ?? '';
        for (const item of root.querySelectorAll<HTMLButtonElement>('button[data-category]')) item.setAttribute('aria-pressed', String(item === button));
        apply();
        return;
      }
      const row = button.closest('[data-pick]');
      if (!(row instanceof HTMLElement)) return;
      if (button.hasAttribute('data-weight-choice')) {
        chooseWeight(row, button.dataset.weightChoice ?? '');
        return;
      }
      if (button.hasAttribute('data-qty-dec') || button.hasAttribute('data-qty-inc')) {
        const input = row.querySelector('[data-pick-qty]');
        if (!(input instanceof HTMLInputElement)) return;
        const min = Number(input.min || '1');
        const max = Number(input.max || '20');
        let next = Number(input.value);
        if (!Number.isInteger(next)) next = min;
        next = button.hasAttribute('data-qty-inc') ? next + 1 : next - 1;
        input.value = String(Math.min(max, Math.max(min, next)));
        input.dispatchEvent(new Event('input', { bubbles: true }));
        return;
      }
      if (button.hasAttribute('data-weight-add')) {
        openCustomWeight(row);
        return;
      }
      if (button.hasAttribute('data-weight-custom-close')) {
        closeCustomWeight(row);
        return;
      }
      if (button.hasAttribute('data-pick-add')) {
        addRow(row);
        return;
      }
      if (button.hasAttribute('data-pick-custom')) {
        openCustomModal(row);
        return;
      }
      if (button.hasAttribute('data-pick-toggle')) {
        if (row.dataset.selected === '1') collapse(row);
        else expand(row);
      }
    });

    customModal?.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      if (target.closest('[data-staff-custom-close]')) {
        closeCustomModal();
        return;
      }
      const chip = target.closest('[data-staff-custom-chip]');
      if (chip instanceof HTMLElement) {
        customWeight = chip.getAttribute('data-staff-custom-chip') || '';
        for (const item of customModal.querySelectorAll('[data-staff-custom-chip]')) {
          item.setAttribute('aria-pressed', String(item === chip));
        }
        return;
      }
      const els = customEls();
      if (target.closest('[data-staff-custom-qty-dec]') && els.qty instanceof HTMLInputElement) {
        const next = Math.max(1, Number(els.qty.value || '1') - 1);
        els.qty.value = String(next);
        return;
      }
      if (target.closest('[data-staff-custom-qty-inc]') && els.qty instanceof HTMLInputElement) {
        const next = Math.min(20, Number(els.qty.value || '1') + 1);
        els.qty.value = String(next);
      }
    });

    customEls().form?.addEventListener('submit', (event) => {
      event.preventDefault();
      commitCustomModal();
    });
    for (const field of [customEls().price, customEls().cost]) {
      field?.addEventListener('input', () => {
        if (field instanceof HTMLInputElement) field.value = groupMoney(field.value);
      });
    }
    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      if (customModal instanceof HTMLElement && !customModal.hidden) {
        event.preventDefault();
        closeCustomModal();
      }
    });

    root.addEventListener('keydown', (event) => {
      const target = event.target;
      if (!(target instanceof HTMLInputElement) || !target.hasAttribute('data-weight-custom-input')) return;
      const row = target.closest('[data-pick]');
      if (!(row instanceof HTMLElement)) return;
      if (event.key === 'Enter') {
        event.preventDefault();
        commitCustomWeight(row);
        return;
      }
      if (event.key === 'Escape') {
        event.preventDefault();
        closeCustomWeight(row);
      }
    });

    if (query instanceof HTMLInputElement) {
      query.addEventListener('keydown', (event) => {
        if (event.key === 'Enter') event.preventDefault();
      });
      query.addEventListener('input', () => {
        text = query.value;
        apply();
      });
    }
    apply();
  }
</script>

