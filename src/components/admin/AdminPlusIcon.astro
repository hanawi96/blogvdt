---
/** Icon dấu cộng trước chữ trên nút Thêm / Viết ở admin. */
interface Props {
  class?: string;
}

const { class: className = 'admin-plus-icon' } = Astro.props;
---

<svg
  class={className}
  xmlns="http://www.w3.org/2000/svg"
  fill="none"
  viewBox="0 0 24 24"
  stroke-width="1.5"
  stroke="currentColor"
  width="18"
  height="18"
  aria-hidden="true"
>
  <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"></path>
</svg>
