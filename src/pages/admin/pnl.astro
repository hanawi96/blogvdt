                        <tr>
                          <th scope="row">
                            <a href={productAdminHref(row.productId)}>{row.name}</a>
                          </th>
                          <td>{row.sold}</td>
                          <td>{formatVnd(row.revenue)}</td>
                          <td>−{formatVnd(row.goodsCost)}</td>
                          <td data-tone={moneyTone(row.contribution)}>{formatVnd(row.contribution)}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
