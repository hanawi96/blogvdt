          }
        </section>
      </div>
    )
  }

  <script>
    const filter = document.querySelector('[data-pnl-filter]');
    const dialog = document.querySelector('[data-pnl-date-dialog]');
    const openBtn = document.querySelector('[data-pnl-date-open]');
    if (filter instanceof HTMLElement && dialog instanceof HTMLDialogElement) {
      const base = filter.dataset.pnlBase || '/admin/pnl';
      const dayInput = dialog.querySelector('[data-pnl-date-day]');
      const rangeFrom = dialog.querySelector('[data-pnl-date-range-from]');
      const rangeTo = dialog.querySelector('[data-pnl-date-range-to]');
      const errorEl = dialog.querySelector('[data-pnl-date-error]');
      const ymd = /^\d{4}-\d{2}-\d{2}$/;

      const setExpanded = (open) => {
        if (openBtn instanceof HTMLButtonElement) openBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
      };
      const showError = (on) => {
        if (errorEl instanceof HTMLElement) errorEl.hidden = !on;
      };
      const go = (nextFrom, nextTo) => {
        const query = new URLSearchParams();
        if (nextFrom && nextTo) {
          query.set('from', nextFrom);
          query.set('to', nextTo);
        }
        const text = query.toString();
        window.location.assign(text ? `${base}?${text}` : base);
      };

      openBtn?.addEventListener('click', () => {
        showError(false);
        dialog.showModal();
        setExpanded(true);
      });
      for (const close of dialog.querySelectorAll('[data-pnl-date-close]')) {
        close.addEventListener('click', () => dialog.close());
      }
      dialog.addEventListener('click', (event) => {
        if (event.target !== dialog) return;
        const box = dialog.getBoundingClientRect();
        const inside =
          event.clientX >= box.left &&
          event.clientX <= box.right &&
          event.clientY >= box.top &&
          event.clientY <= box.bottom;
        if (!inside) dialog.close();
      });
      dialog.addEventListener('close', () => setExpanded(false));
      dialog.addEventListener('click', (event) => {
        const preset = event.target instanceof Element ? event.target.closest('[data-pnl-date-preset]') : null;
        if (!(preset instanceof HTMLButtonElement)) return;
        const nextFrom = preset.dataset.from ?? '';
        const nextTo = preset.dataset.to ?? '';
        if (!ymd.test(nextFrom) || !ymd.test(nextTo)) return;
        go(nextFrom, nextTo);
      });
      dialog.querySelector('[data-pnl-date-apply-day]')?.addEventListener('click', () => {
        const day = dayInput instanceof HTMLInputElement ? dayInput.value : '';
        if (!ymd.test(day)) {
          showError(true);
          return;
        }
        go(day, day);
      });
      dialog.querySelector('[data-pnl-date-apply-range]')?.addEventListener('click', () => {
        const start = rangeFrom instanceof HTMLInputElement ? rangeFrom.value : '';
        const end = rangeTo instanceof HTMLInputElement ? rangeTo.value : '';
        if (!ymd.test(start) || !ymd.test(end) || end < start) {
          showError(true);
          return;
        }
        go(start, end);
      });
      dialog.querySelector('[data-pnl-date-clear]')?.addEventListener('click', () => go('', ''));
    }
  </script>
</AdminLayout>

