---
import AdminLayout from '../../layouts/AdminLayout.astro';
import PnlWaterfallChart from '../../components/admin/PnlWaterfallChart.astro';
import { activityActor } from '../../features/activity/log';
import { mutationError } from '../../features/auth/session';
import { orderAdminHref, productAdminHref } from '../../features/pnl/breakdowns';
import { PNL_DEFAULT_LABOR_BUDGET, saveLaborBudget } from '../../features/pnl/labor';
import {
  adjacentMonthKey,
  isPnlPresetActive,
  pnlMonthChipPresets,
  pnlPeriodPath,
  pnlQuickChipPresets,
  pnlQuickPresets,
  pnlRangeCaption,
  readPnlPeriod,
} from '../../features/pnl/period';
import { loadPnlOverview } from '../../features/pnl/stats';
import { createDb } from '../../lib/db/client';
import { getDbBinding } from '../../lib/cloudflare/env';
import { vnMonthRange, vnTodayParts } from '../../lib/datetime';
import { formatVnd } from '../../lib/money';
import { routes } from '../../lib/routes';

const session = Astro.locals.adminSession;
if (!session) return Astro.redirect(routes.adminLogin);
if (session.role !== 'admin') {
  return new Response('Bạn không có quyền vào trang này.', { status: 403, headers: { 'content-type': 'text/plain; charset=utf-8' } });
}
Astro.response.headers.set('Cache-Control', 'private, no-store');

const db = createDb(getDbBinding());
let formError = '';
const notice = Astro.url.searchParams.get('notice') ?? '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const read = (name: string) => {
    const value = form.get(name);
    return typeof value === 'string' ? value : '';
  };
  const blocked = mutationError(Astro.request, session, form);
  const intent = read('intent');
  const monthKey = read('monthKey');
  if (blocked) {
    Astro.response.status = 403;
    formError = blocked;
  } else if (intent === 'labor-save') {
    const saved = await saveLaborBudget(
      db,
      { monthKey, amount: read('amount') },
      Date.now(),
      await activityActor(db, session.userId),
    );
    if (saved.ok) {
      const back = readPnlPeriod(new URLSearchParams(`month=${encodeURIComponent(monthKey)}`));
      return Astro.redirect(`${pnlPeriodPath(routes.adminPnl, back)}&notice=labor-saved`, 303);
    }
    Astro.response.status = 422;
    formError = saved.error;
  }
}

const period = readPnlPeriod(Astro.url.searchParams);
let loadError = '';
let overview: Awaited<ReturnType<typeof loadPnlOverview>> | null = null;
try {
  overview = await loadPnlOverview(db, period);
} catch (error) {
  console.error(JSON.stringify({ event: 'pnl_failed', name: error instanceof Error ? error.name : 'unknown' }));
  loadError = 'Không tải được số liệu lãi lỗ.';
}

const w = overview?.waterfall;
const laborBudgetSet = overview?.laborBudgetSet ?? false;
const quality = overview?.breakdowns.quality;
const sources = overview?.breakdowns.sources ?? [];
const topProducts = overview?.breakdowns.topProducts ?? [];
const vnToday = vnTodayParts();
const todayMax = `${vnToday.year}-${String(vnToday.month).padStart(2, '0')}-${String(vnToday.day).padStart(2, '0')}`;
const dateQuick = pnlQuickPresets();
const chipQuick = pnlQuickChipPresets();
const chipMonth = pnlMonthChipPresets();
const chipDay = chipQuick.filter((item) => item.id === 'today' || item.id === 'yesterday');
const chipRange = chipQuick.filter((item) => item.id === '7' || item.id === '30' || item.id === '60' || item.id === '90');
const chipShortLabel: Record<(typeof chipQuick)[number]['id'], string> = {
  today: 'Hôm nay',
  yesterday: 'Hôm qua',
  '7': '7 ngày',
  '30': '30 ngày',
  '60': '60 ngày',
  '90': '90 ngày',
};
const monthQuick = Array.from({ length: vnToday.month }, (_, index) => {
  const month = index + 1;
  const span = vnMonthRange(vnToday.year, month)!;
  return { month, from: span.from, to: span.to };
});
const from = period.from;
const to = period.to;
const rangeCaption = pnlRangeCaption(from, to);
const customRangeActive =
  !period.monthKey && !chipQuick.some((item) => isPnlPresetActive(period, item));
function monthPeriodHref(monthKey: string): string | null {
  const [yearText, monthText] = monthKey.split('-');
  const year = Number(yearText);
  const month = Number(monthText);
  const span = vnMonthRange(year, month);
  if (!span) return null;
  return pnlPeriodPath(routes.adminPnl, { monthKey, from: span.from, to: span.to });
}
const prevMonthKey = period.monthKey ? adjacentMonthKey(period.monthKey, -1) : null;
const nextMonthKey = period.monthKey ? adjacentMonthKey(period.monthKey, 1) : null;
const prevMonthHref = prevMonthKey ? monthPeriodHref(prevMonthKey) : null;
const nextMonthHref = nextMonthKey ? monthPeriodHref(nextMonthKey) : null;
const laborFormValue = laborBudgetSet && w ? String(w.laborBudget) : '';
const noticeText = notice === 'labor-saved' ? 'Đã lưu ngân sách tiền công (chỉ đối chiếu, không trừ lãi).' : '';

function moneyTone(value: number): 'good' | 'bad' | undefined {
  if (value > 0) return 'good';
  if (value < 0) return 'bad';
  return undefined;
}
---

<AdminLayout title="Lãi lỗ">
  <p slot="lead">Vốn đơn đã gồm tiền công ước lượng — ngân sách công chỉ để đối chiếu, không trừ thêm vào lãi.</p>

  {noticeText && <p class="mb-4 text-primary-strong" role="status" data-admin-flash>{noticeText}</p>}
  {formError && <p class="error-text" role="alert">{formError}</p>}
  {loadError && <p class="error-text" role="alert">{loadError}</p>}

  <section class="pnl-filter" aria-label="Chọn kỳ báo cáo" data-pnl-filter data-pnl-base={routes.adminPnl}>
    <div class="pnl-filter-summary">
      <p class="pnl-filter-label">Kỳ đang xem</p>
      <div class="pnl-filter-headline">
        {
          prevMonthHref ? (
            <a class="pnl-month-nav" href={prevMonthHref} aria-label="Tháng trước">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 6l-6 6 6 6" /></svg>
            </a>
          ) : period.monthKey ? (
            <span class="pnl-month-nav is-disabled" aria-hidden="true">
              <svg viewBox="0 0 24 24"><path d="M15 6l-6 6 6 6" /></svg>
            </span>
          ) : null
        }
        <div class="pnl-filter-titles">
          <p class="pnl-filter-value">{period.label}</p>
          <p class="pnl-filter-range">{rangeCaption} · giờ VN</p>
        </div>
        {
          nextMonthHref ? (
            <a class="pnl-month-nav" href={nextMonthHref} aria-label="Tháng sau">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6" /></svg>
            </a>
          ) : period.monthKey ? (
            <span class="pnl-month-nav is-disabled" aria-hidden="true">
              <svg viewBox="0 0 24 24"><path d="M9 6l6 6-6 6" /></svg>
            </span>
          ) : null
        }
      </div>
    </div>

    <div class="pnl-filter-controls">
      <div class="pnl-seg pnl-seg--month" role="group" aria-label="Theo tháng">
        {
          chipMonth.map((item) => {
            const active = isPnlPresetActive(period, item);
            const href = pnlPeriodPath(routes.adminPnl, { monthKey: item.monthKey, from: item.from, to: item.to });
            return (
              <a class="pnl-seg-btn" href={href} aria-current={active ? 'page' : undefined} data-active={active ? 'true' : undefined}>
                {item.label}
              </a>
            );
          })
        }
      </div>
      <div class="pnl-seg pnl-seg--day" role="group" aria-label="Theo ngày">
        {
          chipDay.map((item) => {
            const active = isPnlPresetActive(period, item);
            const href = pnlPeriodPath(routes.adminPnl, { monthKey: null, from: item.from, to: item.to });
            return (
              <a class="pnl-seg-btn" href={href} aria-current={active ? 'page' : undefined} data-active={active ? 'true' : undefined}>
                {chipShortLabel[item.id]}
              </a>
            );
          })
        }
      </div>
      <div class="pnl-seg pnl-seg--range" role="group" aria-label="Khoảng gần đây">
        {
          chipRange.map((item) => {
            const active = isPnlPresetActive(period, item);
            const href = pnlPeriodPath(routes.adminPnl, { monthKey: null, from: item.from, to: item.to });
            return (
              <a class="pnl-seg-btn" href={href} aria-current={active ? 'page' : undefined} data-active={active ? 'true' : undefined}>
                {chipShortLabel[item.id]}
              </a>
            );
          })
        }
      </div>
      <button
        class="pnl-filter-custom"
        type="button"
        data-pnl-date-open
        aria-haspopup="dialog"
        aria-expanded="false"
        aria-controls="pnl-date-dialog"
        data-active={customRangeActive ? 'true' : undefined}
      >
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 3v2M17 3v2M4 8h16M6 5h12a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2z" /></svg>
        <span>Tuỳ chỉnh</span>
      </button>
    </div>
  </section>

  <dialog id="pnl-date-dialog" class="order-date-dialog" aria-labelledby="pnl-date-dialog-title" data-pnl-date-dialog>
    <div class="order-date-dialog-card">
      <header class="order-date-dialog-head">
        <h2 id="pnl-date-dialog-title">Chọn thời gian</h2>
        <button class="order-date-dialog-close" type="button" data-pnl-date-close aria-label="Đóng">×</button>
      </header>
      <div class="order-date-dialog-body">
        <section class="order-date-section" aria-labelledby="pnl-date-quick-title">
          <h3 id="pnl-date-quick-title">Chọn nhanh</h3>
          <div class="order-date-months order-date-quicks">
            {
              dateQuick.map((item) => (
                <button
                  class="order-date-month"
                  type="button"
                  data-pnl-date-preset
                  data-from={item.from}
                  data-to={item.to}
                  aria-pressed={isPnlPresetActive(period, item) ? 'true' : 'false'}
                >
                  {item.label}
                </button>
              ))
            }
          </div>
        </section>
        <section class="order-date-section" aria-labelledby="pnl-date-months-title">
          <h3 id="pnl-date-months-title">Chọn nhanh tháng {vnToday.year}</h3>
          <div class="order-date-months">
            {
              monthQuick.map((item) => (
                <button
                  class="order-date-month"
                  type="button"
                  data-pnl-date-preset
                  data-from={item.from}
                  data-to={item.to}
                  aria-pressed={from === item.from && to === item.to ? 'true' : 'false'}
                >
                  Tháng {item.month}
                </button>
              ))
            }
          </div>
        </section>
        <section class="order-date-section" aria-labelledby="pnl-date-day-title">
          <h3 id="pnl-date-day-title">Một ngày</h3>
          <div class="order-date-row">
            <label class="sr-only" for="pnl-date-day">Ngày</label>
            <input
              id="pnl-date-day"
              class="field"
              type="date"
              data-pnl-date-day
              value={from && from === to ? from : ''}
              max={todayMax}
            />
            <button class="btn btn-primary" type="button" data-pnl-date-apply-day>Áp dụng</button>
          </div>
        </section>
        <section class="order-date-section" aria-labelledby="pnl-date-range-title">
          <h3 id="pnl-date-range-title">Khoảng ngày</h3>
          <div class="order-date-row order-date-range">
            <label class="sr-only" for="pnl-date-from">Từ ngày</label>
            <input
              id="pnl-date-from"
              class="field"
              type="date"
              data-pnl-date-range-from
              value={from && to && from !== to ? from : ''}
              max={todayMax}
            />
            <span class="order-date-range-sep" aria-hidden="true">→</span>
            <label class="sr-only" for="pnl-date-to">Đến ngày</label>
            <input
              id="pnl-date-to"
              class="field"
              type="date"
              data-pnl-date-range-to
              value={from && to && from !== to ? to : ''}
              max={todayMax}
            />
            <button class="btn btn-primary" type="button" data-pnl-date-apply-range>Áp dụng</button>
          </div>
          <p class="order-date-error" data-pnl-date-error hidden>Khoảng ngày không hợp lệ.</p>
        </section>
      </div>
      <footer class="order-date-dialog-foot">
        <button class="btn" type="button" data-pnl-date-clear>Về tháng này</button>
        <button class="btn" type="button" data-pnl-date-close>Đóng</button>
      </footer>
    </div>
  </dialog>

  {
    w && (
      <div class="pnl">
        <section class="dash-kpis dash-kpis-4" aria-label="Tóm tắt kỳ">
          <article class="dash-kpi">
            <p class="dash-kpi-label">Doanh thu</p>
            <p class="dash-kpi-value">{formatVnd(w.revenue)}</p>
            <p class="dash-delta">
              {w.orders} đơn
              {w.aov !== null ? ` · TB ${formatVnd(w.aov)}` : ''}
            </p>
          </article>
          <article class="dash-kpi">
            <p class="dash-kpi-label">Lãi gộp</p>
            <p class="dash-kpi-value" data-tone={moneyTone(w.grossProfit)}>{formatVnd(w.grossProfit)}</p>
            <p class="dash-delta">
              {w.costedOrders}/{w.orders} đơn có vốn
              {w.grossMarginPercent !== null ? ` · biên ${w.grossMarginPercent}%` : ''}
            </p>
          </article>
          <article class="dash-kpi">
            <p class="dash-kpi-label">Sau quảng cáo</p>
            <p class="dash-kpi-value" data-tone={moneyTone(w.profitAfterAds)}>{formatVnd(w.profitAfterAds)}</p>
            <p class="dash-delta">
              {w.adSpend > 0 ? `Ads −${formatVnd(w.adSpend)}` : 'Ads kỳ = 0'}
              {' · '}
              <a href={`${routes.adminCosts}?tab=ads`}>Chi phí ads</a>
            </p>
          </article>
          <article class="dash-kpi">
            <p class="dash-kpi-label">Giảm giá đã cho</p>
            <p class="dash-kpi-value">{formatVnd(w.discountAmount)}</p>
            <p class="dash-delta">Đã nằm trong doanh thu</p>
          </article>
        </section>

        <section class="dash-card pnl-waterfall" aria-labelledby="pnl-waterfall-title">
          <div class="dash-card-head">
            <h2 id="pnl-waterfall-title">Waterfall kỳ</h2>
          </div>
          <div class="pnl-waterfall-split">
            <div class="pnl-waterfall-chart-pane">
              <PnlWaterfallChart waterfall={w} />
            </div>
            <div class="pnl-waterfall-table-pane">
              <dl class="pnl-flow">
                <div class="pnl-flow-row">
                  <dt>Doanh thu (đơn hợp lệ)</dt>
                  <dd>{formatVnd(w.revenue)}</dd>
                </div>
                <div class="pnl-flow-row">
                  <dt>Doanh thu đã có vốn</dt>
                  <dd>{formatVnd(w.costedRevenue)}</dd>
                </div>
                <div class="pnl-flow-row" data-tone="cost">
                  <dt>− Vốn hàng <span class="pnl-flow-hint">(gồm tiền công ước lượng)</span></dt>
                  <dd>−{formatVnd(w.costGoods)}</dd>
                </div>
                <div class="pnl-flow-row" data-tone="cost">
                  <dt>− Chi phí đơn</dt>
                  <dd>−{formatVnd(w.costExtra)}</dd>
                </div>
                <div class="pnl-flow-row" data-tone="cost">
                  <dt>− Vốn ship</dt>
                  <dd>−{formatVnd(w.shippingCost)}</dd>
                </div>
                <div class="pnl-flow-row" data-tone={moneyTone(w.grossProfit)}>
                  <dt>= Lãi gộp</dt>
                  <dd>{formatVnd(w.grossProfit)}</dd>
                </div>
                <div class="pnl-flow-row" data-tone="cost">
                  <dt>− Quảng cáo</dt>
                  <dd>−{formatVnd(w.adSpend)}</dd>
                </div>
                <div class="pnl-flow-row pnl-flow-result" data-tone={moneyTone(w.profitAfterAds)}>
                  <dt>Lãi sau quảng cáo</dt>
                  <dd>{formatVnd(w.profitAfterAds)}</dd>
                </div>
              </dl>
            </div>
          </div>
          <p class="pnl-note">
            Biểu đồ bắt đầu từ doanh thu đã có vốn (khớp lãi gộp). Đơn hủy / gửi bù không tính. Ads theo ngày trong kỳ.
          </p>
        </section>

        {
          quality && quality.uncostedOrders > 0 && (
            <section class="dash-card pnl-quality" aria-labelledby="pnl-quality-title" data-tone="warn">
              <div class="dash-card-head">
                <h2 id="pnl-quality-title">Thiếu giá vốn</h2>
              </div>
              <p class="pnl-note pnl-note-tight">
                {quality.uncostedOrders} đơn ({formatVnd(quality.uncostedRevenue)}) chưa có đủ chi phí — không tính vào lãi
                gộp. Lãi trên trang này chỉ dựa trên đơn đã có vốn.
              </p>
              {
                quality.samples.length > 0 && (
                  <ul class="pnl-sample-list">
                    {quality.samples.map((sample) => (
                      <li>
                        <a href={orderAdminHref(sample.id)}>{sample.code}</a>
                        <span>{formatVnd(sample.totalPrice)}</span>
                      </li>
                    ))}
                  </ul>
                )
              }
              <p class="pnl-note">
                <a href={quality.ordersListHref}>Xem đơn trong kỳ</a>
                {' · '}
                Mở từng đơn để kiểm tra / cập nhật vốn nếu cần.
              </p>
            </section>
          )
        }

        <section class="dash-card pnl-labor" aria-labelledby="pnl-labor-title">
          <div class="dash-card-head">
            <h2 id="pnl-labor-title">Đối chiếu tiền công</h2>
          </div>
          {
            period.monthKey ? (
              <>
                <p class="pnl-note pnl-note-tight">
                  Không trừ vào lãi sau ads — tiền công ước lượng đã nằm trong vốn hàng. Ô này chỉ để so với ngân sách
                  tháng (vd. {formatVnd(PNL_DEFAULT_LABOR_BUDGET)}).
                </p>
                <dl class="pnl-labor-facts">
                  <div>
                    <dt>Ngân sách đã lưu</dt>
                    <dd>{laborBudgetSet ? formatVnd(w.laborBudget) : 'Chưa đặt'}</dd>
                  </div>
                  <div>
                    <dt>Lãi sau ads (tham chiếu)</dt>
                    <dd data-tone={moneyTone(w.profitAfterAds)}>{formatVnd(w.profitAfterAds)}</dd>
                  </div>
                </dl>
                <form method="post" class="pnl-labor-form">
                  <input type="hidden" name="csrf" value={session.csrfToken} />
                  <input type="hidden" name="intent" value="labor-save" />
                  <input type="hidden" name="monthKey" value={period.monthKey} />
                  <label for="pnl-labor-amount">Ngân sách tháng {period.monthKey}</label>
                  <input
                    id="pnl-labor-amount"
                    name="amount"
                    inputmode="numeric"
                    autocomplete="off"
                    placeholder={String(PNL_DEFAULT_LABOR_BUDGET)}
                    value={laborFormValue}
                    required
                  />
                  <button class="btn btn-primary" type="submit">Lưu đối chiếu</button>
                </form>
              </>
            ) : (
              <p class="pnl-note">Chọn xem theo tháng để đặt ngân sách tiền công đối chiếu.</p>
            )
          }
        </section>

        <section class="dash-card pnl-sources" aria-labelledby="pnl-sources-title">
          <div class="dash-card-head">
            <h2 id="pnl-sources-title">Theo nguồn khách</h2>
          </div>
          {
            sources.length === 0 ? (
              <p class="pnl-note pnl-note-tight">Chưa có đơn hợp lệ trong kỳ.</p>
            ) : (
              <div class="pnl-table-scroll">
                <table class="pnl-table pnl-table-grid pnl-table-sources">
                  <thead>
                    <tr>
                      <th scope="col">Nguồn</th>
                      <th scope="col">Đơn</th>
                      <th scope="col">Doanh thu</th>
                      <th scope="col">Lãi gộp</th>
                    </tr>
                  </thead>
                  <tbody>
                    {sources.map((row) => (
                      <tr>
                        <th scope="row">{row.label}</th>
                        <td>
                          {row.orders}
                          {row.costedOrders < row.orders ? ` (${row.costedOrders} có vốn)` : ''}
                        </td>
                        <td>{formatVnd(row.revenue)}</td>
                        <td data-tone={moneyTone(row.grossProfit)}>{formatVnd(row.grossProfit)}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )
          }
        </section>

        <section class="dash-card pnl-products" aria-labelledby="pnl-products-title">
          <div class="dash-card-head">
            <h2 id="pnl-products-title">Top sản phẩm theo lãi sau vốn hàng</h2>
          </div>
          <p class="pnl-note pnl-note-tight">
            Vốn hàng phân bổ theo tỷ lệ giá trị dòng trong đơn đã có chi phí. Chưa trừ phí đơn / ship / ads.
          </p>
          {
            topProducts.length === 0 ? (
              <p class="pnl-note">Chưa có sản phẩm đủ dữ liệu vốn trong kỳ.</p>
            ) : (
              <>
                <ul class="pnl-product-cards">
                  {
                    topProducts.map((row) => (
                      <li class="pnl-product-card">
                        <div class="pnl-product-card-head">
                          <a class="pnl-product-card-name" href={productAdminHref(row.productId)}>
                            {row.name}
                          </a>
                          <p class="pnl-product-card-sold">{row.sold} đã bán</p>
                        </div>
                        <dl class="pnl-product-card-metrics">
                          <div>
                            <dt>Doanh thu</dt>
                            <dd>{formatVnd(row.revenue)}</dd>
                          </div>
                          <div>
                            <dt>Vốn hàng</dt>
                            <dd>−{formatVnd(row.goodsCost)}</dd>
                          </div>
                          <div class="pnl-product-card-profit">
                            <dt>Lãi sau vốn</dt>
                            <dd data-tone={moneyTone(row.contribution)}>{formatVnd(row.contribution)}</dd>
                          </div>
                        </dl>
                      </li>
                    ))
                  }
                </ul>
                <div class="pnl-table-scroll pnl-products-table">
