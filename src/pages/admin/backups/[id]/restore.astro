---
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import { activityActor, activityWrite, commitWrites } from '../../../../features/activity/log';
import { mutationError } from '../../../../features/auth/session';
import { getBackupJob } from '../../../../features/backups/jobs';
import { releaseRestoreLock, tryAcquireRestoreLock } from '../../../../features/backups/restore-lock';
import { formatVnDateTime } from '../../../../features/backups/time';
import { createDb } from '../../../../lib/db/client';
import { getDbBinding } from '../../../../lib/cloudflare/env';
import { routes } from '../../../../lib/routes';
import { env } from 'cloudflare:workers';

const session = Astro.locals.adminSession;
if (!session) return Astro.redirect(routes.adminLogin);
if (session.role !== 'admin') {
  return new Response('Bạn không có quyền vào trang này.', { status: 403, headers: { 'content-type': 'text/plain; charset=utf-8' } });
}

const id = Number(Astro.params.id);
if (!Number.isInteger(id) || id < 1) return Astro.redirect(routes.adminBackups);

const db = createDb(getDbBinding());
const job = await getBackupJob(db, id);
if (!job || job.kind !== 'full' || job.status !== 'success' || !job.r2Key) {
  return Astro.redirect(routes.adminBackups);
}

let formError = '';
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const blocked = mutationError(Astro.request, session, form);
  if (blocked) {
    formError = blocked;
  } else {
    const confirm = String(form.get('confirm') ?? '').trim().toUpperCase();
    if (confirm !== 'K') {
      formError = 'Gõ K để xác nhận khôi phục.';
    } else {
      const workflow = env.RESTORE_WORKFLOW;
      if (!workflow) {
        formError = 'Thiếu binding RESTORE_WORKFLOW.';
      } else {
        const lock = await tryAcquireRestoreLock(db);
        if (!lock.ok) {
          formError = lock.error;
        } else {
          try {
            await workflow.create({ params: { jobId: job.id, actorId: session.userId } });
            const actor = await activityActor(db, session.userId);
            await commitWrites(db, [
              activityWrite(
                db,
                {
                  actorId: actor.id,
                  actorName: actor.name,
                  action: 'backup.restore',
                  objectType: 'backup',
                  objectId: String(job.id),
                  summary: `Bắt đầu khôi phục DB từ backup #${job.id}`,
                  createdAt: Date.now(),
                },
                false,
              ),
            ]);
            return Astro.redirect(`${routes.adminBackups}?restored=1`, 303);
          } catch (error) {
            await releaseRestoreLock(db);
            formError = error instanceof Error ? error.message : 'Không khởi tạo được restore.';
          }
        }
      }
    }
  }
}
---

<AdminLayout title={`Khôi phục backup #${job.id}`}>
  <p class="settings-lead">
    Thao tác này <strong>ghi đè toàn bộ database</strong>. Hệ thống sẽ tự tạo một backup full trước khi restore.
    Trong lúc import, website có thể gián đoạn. Sau khi xong bạn sẽ phải đăng nhập lại.
  </p>
  {formError && <p class="error-text mb-4" role="alert">{formError}</p>}

  <form method="post" class="settings-panel" data-busy>
    <input type="hidden" name="csrf" value={session.csrfToken} />
    <p class="seo-hint mb-4">
      Backup #{job.id} · {formatVnDateTime(job.createdAt)}
      {(job.bytes ?? 0) > 0 ? ` · ${Math.round((job.bytes ?? 0) / 1024)} KB` : ''}
    </p>
    <label class="block">
      <span class="mb-1 block font-semibold">Gõ K để xác nhận ghi đè database</span>
      <input class="field" name="confirm" maxlength="1" autocomplete="off" required style="max-width: 4rem" />
    </label>
    <div class="settings-save">
      <button class="btn btn-danger" type="submit">Khôi phục ngay</button>
      <a class="btn btn-ghost" href={routes.adminBackups}>Hủy</a>
    </div>
  </form>
</AdminLayout>
