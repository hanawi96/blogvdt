---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import PostForm from '../../../components/admin/PostForm.astro';
import { mutationError } from '../../../features/auth/session';
import { listCategories } from '../../../features/posts/categories';
import { autosaveResponse, excerptFieldValue, expectedRevision, firstFieldError, isAutosave, parsePostForm } from '../../../features/posts/form';
import { activityActor } from '../../../features/activity/log';
import { getPost, listMetaCorpus, saveDraftPost, updatePost } from '../../../features/posts/posts';
import { listMedia } from '../../../features/media/media';
import { getPublicSite } from '../../../features/settings/settings';
import { createDb } from '../../../lib/db/client';
import { getDbBinding } from '../../../lib/cloudflare/env';
import { collectMetaCorpus, mergeMetaCorpus, siteListCorpus } from '../../../lib/seo/meta';
import { routes } from '../../../lib/routes';
import type { FieldErrors } from '../../../lib/validation/errors';

const session = Astro.locals.adminSession;
if (!session) return Astro.redirect(routes.adminLogin);

const id = Number(Astro.params.id);
if (!Number.isInteger(id) || id < 1) return Astro.redirect(routes.adminPosts);

const db = createDb(getDbBinding());
const post = await getPost(db, id);
if (!post) return Astro.redirect(routes.adminPosts);

const categories = await listCategories(db);
const corpus = mergeMetaCorpus(await listMetaCorpus(db, id), collectMetaCorpus(categories), siteListCorpus());
const site = await getPublicSite(db);
const seoSite = {
  name: site?.siteName || 'Website',
  host: Astro.url.hostname,
  markUrl: site?.faviconUrl || site?.logoUrl || '',
};
const media = await listMedia(db);
let values = {
  title: post.title,
  slug: post.slug,
  categoryId: post.categoryId ? String(post.categoryId) : '',
  coverMediaId: post.coverMediaId ? String(post.coverMediaId) : '',
  contentJson: post.contentJson,
  seoTitle: post.seoTitle ?? '',
  metaDescription: post.metaDescription ?? '',
  excerpt: excerptFieldValue(post.excerpt, post.contentJson),
  status: post.status,
};
let errors: FieldErrors = {};
let formError = '';
let revision = post.updatedAt;
const saved = Astro.url.searchParams.get('saved') === '1';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const autosave = isAutosave(form);
  const expected = expectedRevision(form);
  const blocked = mutationError(Astro.request, session, form);
  if (blocked) {
    if (autosave) return autosaveResponse({ ok: false, error: blocked }, 403);
    Astro.response.status = 403;
    formError = blocked;
    if (expected !== null) revision = expected;
  } else {
    const parsed = parsePostForm(form);
    if (autosave) {
      if (!parsed.ok) return autosaveResponse({ ok: false, error: firstFieldError(parsed.errors) }, 422);
      const actor = await activityActor(db, session.userId);
      const saved = await saveDraftPost(db, id, { ...parsed.input, status: 'draft' }, Date.now(), actor, expected);
      if (!saved.ok) return autosaveResponse({ ok: false, error: saved.error, conflict: saved.conflict }, saved.conflict ? 409 : 422);
      return autosaveResponse({ ok: true, id, skipped: saved.skipped, updatedAt: saved.updatedAt });
    }
    values = valuesFrom(form, values.contentJson);
    if (expected !== null) revision = expected;
    if (!parsed.ok) {
      Astro.response.status = 422;
      errors = parsed.errors;
    } else {
      const actor = await activityActor(db, session.userId);
      const updated = await updatePost(db, id, parsed.input, Date.now(), actor, expected);
      if (!updated.ok) {
        Astro.response.status = 422;
        formError = updated.error;
      } else {
        return Astro.redirect(`${routes.adminPost(id)}?saved=1`, 303);
      }
    }
  }
}

function valuesFrom(form: FormData, fallbackContent: string) {
  const read = (name: string) => {
    const value = form.get(name);
    return typeof value === 'string' ? value : '';
  };
  return {
    title: read('title'),
    slug: read('slug'),
    categoryId: read('categoryId'),
    coverMediaId: read('coverMediaId'),
    contentJson: read('contentJson') || fallbackContent,
    seoTitle: read('seoTitle'),
    metaDescription: read('metaDescription'),
    excerpt: read('excerpt'),
    status: read('status') || 'draft',
  };
}
---

<AdminLayout title="Sửa bài viết">
  <PostForm
    csrf={session.csrfToken}
    action={routes.adminPost(id)}
    deleteAction={routes.adminPostDelete(id)}
    {values}
    {errors}
    {formError}
    {saved}
    meta={{ createdAt: post.createdAt, updatedAt: revision, publishedAt: post.publishedAt }}
    {categories}
    {media}
    site={seoSite}
    postId={id}
    livePublished={post.status === 'published'}
    corpus={corpus}
  />
</AdminLayout>
