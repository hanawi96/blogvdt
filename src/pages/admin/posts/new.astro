---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import PostForm from '../../../components/admin/PostForm.astro';
import { mutationError } from '../../../features/auth/session';
import { listCategories } from '../../../features/posts/categories';
import { parsePostForm } from '../../../features/posts/form';
import { createPost } from '../../../features/posts/posts';
import { listMedia } from '../../../features/media/media';
import { createDb } from '../../../lib/db/client';
import { getDbBinding } from '../../../lib/cloudflare/env';
import { routes } from '../../../lib/routes';
import type { FieldErrors } from '../../../lib/validation/errors';

const session = Astro.locals.adminSession;
if (!session) return Astro.redirect(routes.adminLogin);

const db = createDb(getDbBinding());
const categories = await listCategories(db);
const covers = (await listMedia(db)).map((item) => ({
  id: item.id,
  filename: item.filename,
  url: item.url,
  alt: item.altText,
}));
const empty = {
  title: '',
  slug: '',
  categoryId: '',
  coverMediaId: '',
  contentJson: '{"type":"doc","content":[]}',
  seoTitle: '',
  metaDescription: '',
  status: 'draft',
};
let values = empty;
let errors: FieldErrors = {};
let formError = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const blocked = mutationError(Astro.request, session, form);
  if (blocked) {
    Astro.response.status = 403;
    formError = blocked;
  } else {
    const parsed = parsePostForm(form);
    values = valuesFrom(form);
    if (!parsed.ok) {
      Astro.response.status = 422;
      errors = parsed.errors;
    } else {
      const saved = await createPost(db, parsed.input);
      if (!saved.ok) {
        Astro.response.status = 422;
        formError = saved.error;
      } else {
        return Astro.redirect(`${routes.adminPost(saved.id)}?saved=1`, 303);
      }
    }
  }
}

function valuesFrom(form: FormData) {
  const read = (name: string) => {
    const value = form.get(name);
    return typeof value === 'string' ? value : '';
  };
  return {
    title: read('title'),
    slug: read('slug'),
    categoryId: read('categoryId'),
    coverMediaId: read('coverMediaId'),
    contentJson: read('contentJson') || empty.contentJson,
    seoTitle: read('seoTitle'),
    metaDescription: read('metaDescription'),
    status: read('status') || 'draft',
  };
}
---

<AdminLayout title="Viết bài">
  <PostForm csrf={session.csrfToken} action={routes.adminPostNew} {values} {errors} {formError} {categories} {covers} />
</AdminLayout>
