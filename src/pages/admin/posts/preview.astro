---
// Xem trước bản nháp: không ghi database, không index.
import type { JSONContent } from '@tiptap/core';
import { canAccessPath } from '../../../features/auth/access';
import { mutationError } from '../../../features/auth/session';
import { applyCoverMeasure, getMediaFile, layoutContentImages } from '../../../features/media/media';
import { collectMediaSrcs, sanitizePostContent } from '../../../features/posts/content';
import { firstFieldError, parsePostForm } from '../../../features/posts/form';
import { collectHeadings, type HeadingItem } from '../../../features/posts/headings';
import { collectPostCardIds, listPublishedPostCardsByIds } from '../../../features/posts/post-cards';
import { getPost } from '../../../features/posts/posts';
import { renderPostHtml } from '../../../features/posts/render';
import { getPublicSite } from '../../../features/settings/settings';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import PublicLayout from '../../../layouts/PublicLayout.astro';
import { getDbBinding, optionalMediaBucket } from '../../../lib/cloudflare/env';
import { createDb } from '../../../lib/db/client';
import { formatDateTime } from '../../../lib/datetime';
import { routes } from '../../../lib/routes';

const session = Astro.locals.adminSession;
if (!session) return Astro.redirect(routes.adminLogin);
if (!canAccessPath(session.role, Astro.url.pathname)) {
  return new Response('Không có quyền xem trước bài này.', {
    status: 403,
    headers: { 'cache-control': 'no-store', 'x-robots-tag': 'noindex, nofollow' },
  });
}
const savedId = Number(Astro.url.searchParams.get('id') ?? '');
const savedPreview = Astro.request.method === 'GET' && Number.isInteger(savedId) && savedId > 0;
if (Astro.request.method !== 'POST' && !savedPreview) {
  return new Response('Method Not Allowed', {
    status: 405,
    headers: { 'cache-control': 'no-store' },
  });
}

const db = createDb(getDbBinding());
const form = savedPreview ? null : await Astro.request.formData();
const blocked = form ? mutationError(Astro.request, session, form) : '';
let message = blocked ?? '';
let publishedAt: number | null = null;
let updatedAt: number | null = null;
let article: {
  title: string;
  description: string;
  html: string;
  headings: HeadingItem[];
  cover: { url: string; alt: string; width: number | null; height: number | null } | null;
} | null = null;

if (savedPreview) {
  const post = await getPost(db, savedId);
  if (!post) {
    message = 'Không tìm thấy bài viết.';
  } else if (post.deletedAt != null) {
    message = 'Bài đang ở thùng rác.';
  } else {
    publishedAt = post.publishedAt;
    updatedAt = post.updatedAt;
    article = await articleFrom(post.title, post.metaDescription || post.excerpt || post.title, post.contentJson, post.coverMediaId);
  }
} else if (blocked) {
  Astro.response.status = 403;
} else if (form) {
  const postedId = Number(form.get('postId') ?? '');
  if (Number.isInteger(postedId) && postedId > 0) {
    const saved = await getPost(db, postedId);
    if (saved) {
      publishedAt = saved.publishedAt;
      updatedAt = saved.updatedAt;
    }
  }
  form.set('status', 'draft');
  const parsed = parsePostForm(form);
  if (!parsed.ok) {
    Astro.response.status = 422;
    message = firstFieldError(parsed.errors);
  } else {
    article = await articleFrom(
      parsed.input.title,
      parsed.input.metaDescription || parsed.input.excerpt || parsed.input.title,
      parsed.input.contentJson,
      parsed.input.coverMediaId,
    );
  }
}

Astro.response.headers.set('Cache-Control', 'no-store');
Astro.response.headers.set('X-Robots-Tag', 'noindex');

async function articleFrom(title: string, description: string, contentJson: string, coverMediaId: number | null) {
  const bucket = optionalMediaBucket();
  const sanitized = sanitizePostContent(contentJson);
  const content = sanitized.ok ? (JSON.parse(sanitized.json) as JSONContent) : null;
  const stored = coverMediaId ? await getMediaFile(db, coverMediaId) : null;
  const [measured] = stored
    ? await applyCoverMeasure(bucket, [{ coverUrl: stored.url, coverWidth: stored.width, coverHeight: stored.height }])
    : [null];
  const embedIds = content ? collectPostCardIds(content) : [];
  const [images, cardsById] = await Promise.all([
    content ? layoutContentImages(db, bucket, collectMediaSrcs(content)) : Promise.resolve({ sizes: new Map(), missing: new Set<string>() }),
    listPublishedPostCardsByIds(db, embedIds),
  ]);
  const measuredCards = new Map((await applyCoverMeasure(bucket, [...cardsById.values()])).map((card) => [card.id, card] as const));
  return {
    title,
    description,
    html: content
      ? renderPostHtml(content, images.sizes, { skip: images.missing, eager: measured?.coverUrl ? 0 : 1, cardsById: measuredCards })
      : '',
    headings: content ? collectHeadings(content) : [],
    cover: measured?.coverUrl ? { url: measured.coverUrl, alt: stored?.alt ?? '', width: measured.coverWidth, height: measured.coverHeight } : null,
  };
}

const site = article ? await getPublicSite(db) : null;
---

{
  article ? (
    <PublicLayout
      title="Xem trước"
      description="Bản xem trước. Trang này không được lập chỉ mục."
      robots="noindex,nofollow"
      siteName={site?.siteName || 'Xem trước'}
      faviconUrl={site?.faviconUrl || '/favicon.svg'}
      chrome={site}
    >
      <p class="preview-banner">Bản xem trước. Trang này không được lưu và không được lập chỉ mục.</p>
      <main class="post-page">
        <div class="post-page-glow" aria-hidden="true"></div>
        <div class="post-page-shell">
          <nav class="post-crumb" aria-label="Đường dẫn">
            <ol>
              <li><a href={routes.home}>Trang chủ</a></li>
              <li>
                <span class="post-crumb-sep" aria-hidden="true">·</span>
                <a href={routes.knowledgeList}>Kiến thức</a>
              </li>
              <li>
                <span class="post-crumb-sep" aria-hidden="true">·</span>
                <span aria-current="page">{article.title}</span>
              </li>
            </ol>
          </nav>
          <header class="post-hero">
            <h1 class="post-headline">{article.title}</h1>
            <p class="post-byline">
              {publishedAt && <time>{formatDateTime(publishedAt)}</time>}
              {publishedAt && updatedAt && <span class="post-byline-dot" aria-hidden="true"></span>}
              {updatedAt && <span>Cập nhật {formatDateTime(updatedAt)}</span>}
              {!publishedAt && !updatedAt && <span>Xem trước · chưa ghi ra trang công khai</span>}
            </p>
          </header>
          {
            article.cover && (
              <figure class="post-cover">
                <img
                  src={article.cover.url}
                  alt={article.cover.alt}
                  width={article.cover.width ?? undefined}
                  height={article.cover.height ?? undefined}
                  fetchpriority="high"
                />
              </figure>
            )
          }
          {
            article.headings.length > 0 && (
              <nav class="post-toc" aria-label="Mục lục">
                <p class="post-toc-label">Trong bài này</p>
                <ol>
                  {
                    article.headings.map((heading) => (
                      <li class:list={[heading.level === 3 && 'post-toc-sub']}>
                        <a href={`#${heading.id}`}>{heading.text}</a>
                      </li>
                    ))
                  }
                </ol>
              </nav>
            )
          }
          <article class="post-body" set:html={article.html} />
        </div>
      </main>
    </PublicLayout>
  ) : (
    <AdminLayout title="Xem trước">
      <p class="error-text" role="alert">{message || 'Không xem trước được.'}</p>
    </AdminLayout>
  )
}
