---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { hasInboundPostLink, inspectPostLinks, listPostLinkCounts, searchInternalLinks, suggestPosts } from '../../../features/posts/link-lookup';
import { listPosts, searchPublishedPosts, slugIsTaken, type PostListSort } from '../../../features/posts/posts';
import RetiredUrlDialog from '../../../components/admin/RetiredUrlDialog.astro';
import { listPickerCategories, listRedirectPostTargets } from '../../../features/redirects/manage';
import { SLUG_PATTERN } from '../../../features/posts/slug';
import { isPostStatus, POST_STATUS_LABELS } from '../../../features/posts/status';
import { createDb } from '../../../lib/db/client';
import { getDbBinding } from '../../../lib/cloudflare/env';
import { formatDateTime } from '../../../lib/datetime';
import { routes } from '../../../lib/routes';

const session = Astro.locals.adminSession;
if (!session) return Astro.redirect(routes.adminLogin);
const canPurge = session.role === 'admin';

const wantsJson = Astro.request.headers.get('accept')?.includes('application/json') ?? false;
if (wantsJson) {
  const db = createDb(getDbBinding());
  const excludeRaw = Number(Astro.url.searchParams.get('exclude') ?? '');
  const exclude = Number.isInteger(excludeRaw) && excludeRaw > 0 ? excludeRaw : null;
  const jsonHeaders = { 'content-type': 'application/json; charset=utf-8', 'cache-control': 'no-store' };
  const slug = Astro.url.searchParams.get('slug');
  if (slug !== null) {
    const taken = SLUG_PATTERN.test(slug) ? await slugIsTaken(db, slug, exclude) : false;
    return new Response(JSON.stringify({ taken }), { headers: jsonHeaders });
  }
  if (Astro.url.searchParams.get('check') === '1') {
    const current = Astro.url.searchParams.get('current');
    const issues = await inspectPostLinks(db, Astro.url.searchParams.getAll('path'), current);
    const inbound = Astro.url.searchParams.get('inbound') === '1' && current ? await hasInboundPostLink(db, { path: current, excludeId: exclude }) : null;
    return new Response(JSON.stringify({ issues, inbound }), { headers: jsonHeaders });
  }
  if (Astro.url.searchParams.get('suggest') === '1') {
    const categoryRaw = Number(Astro.url.searchParams.get('category') ?? '');
    const suggestions = await suggestPosts(db, {
      title: Astro.url.searchParams.get('title') ?? '',
      categoryId: Number.isInteger(categoryRaw) && categoryRaw > 0 ? categoryRaw : null,
      excludeId: exclude,
    });
    const withCatalog = [{ title: 'Mẫu vòng dâu tằm', path: routes.catalog }, ...suggestions].slice(0, 8);
    return new Response(JSON.stringify({ suggestions: withCatalog }), { headers: jsonHeaders });
  }
  const q = Astro.url.searchParams.get('q') ?? '';
  if (Astro.url.searchParams.get('links') === '1') {
    const links = await searchInternalLinks(db, q, exclude);
    return new Response(JSON.stringify({ links }), { headers: jsonHeaders });
  }
  const found = await searchPublishedPosts(db, q, exclude);
  return new Response(JSON.stringify({ posts: found }), { headers: jsonHeaders });
}

const query = Astro.url.searchParams.get('q') ?? '';
const statusParam = Astro.url.searchParams.get('status') ?? '';
const status = statusParam === 'trash' ? 'trash' : isPostStatus(statusParam) ? statusParam : '';
const sort: PostListSort = Astro.url.searchParams.get('sort') === 'oldest' ? 'oldest' : 'newest';
const page = Number(Astro.url.searchParams.get('page') ?? '1');
const trashed = Astro.url.searchParams.get('trashed') === '1' || Astro.url.searchParams.get('deleted') === '1';
const purged = Astro.url.searchParams.get('purged') === '1';
const listError = Astro.url.searchParams.get('error') ?? '';
const copyError = listError === 'copy';
const bulkError = listError === 'bulk';
const retireError = listError === 'retire';
const actionError = copyError || bulkError || retireError ? '' : listError.slice(0, 200);
const bulkParam = Astro.url.searchParams.get('bulk') ?? '';
const bulkCount = Math.max(0, Number(Astro.url.searchParams.get('n')) || 0);
const bulkSkipped = Math.max(0, Number(Astro.url.searchParams.get('skip')) || 0);
const bulkNotice =
  bulkParam === 'publish'
    ? `Đã xuất bản ${bulkCount} bài.${bulkSkipped > 0 ? ` Bỏ qua ${bulkSkipped} bài chưa đủ nội dung.` : ''}`
    : bulkParam === 'trash'
      ? `Đã chuyển ${bulkCount} bài vào thùng rác.`
      : bulkParam === 'restore'
        ? `Đã khôi phục ${bulkCount} bài thành bản nháp.${bulkSkipped > 0 ? ` Bỏ qua ${bulkSkipped} bài còn vướng chuyển hướng.` : ''}`
        : bulkParam === 'purge'
          ? `Đã xóa vĩnh viễn ${bulkCount} bài.`
          : '';
let loadError = '';
let result: Awaited<ReturnType<typeof listPosts>> | null = null;
let targets: { title: string; path: string }[] = [];
let linkCounts: Awaited<ReturnType<typeof listPostLinkCounts>> = new Map();
let categoryOptions: { id: number; name: string }[] = [];
try {
  const db = createDb(getDbBinding());
  result = await listPosts(db, { query, status, sort, page: Number.isInteger(page) ? page : 1 });
  const inTrash = status === 'trash';
  [targets, linkCounts, categoryOptions] = await Promise.all([
    listRedirectPostTargets(db),
    inTrash ? Promise.resolve(new Map()) : listPostLinkCounts(db, result.rows),
    inTrash ? Promise.resolve([]) : listPickerCategories(db),
  ]);
} catch (error) {
  console.error(JSON.stringify({ event: 'post_list_failed', name: error instanceof Error ? error.name : 'unknown' }));
  loadError = 'Không tải được danh sách bài viết.';
}

const filters = [
  { id: '', label: 'Tất cả', count: result?.counts.all ?? 0 },
  { id: 'published', label: 'Đã xuất bản', count: result?.counts.published ?? 0 },
  { id: 'draft', label: 'Bản nháp', count: result?.counts.draft ?? 0 },
  { id: 'trash', label: 'Thùng rác', count: result?.counts.trash ?? 0 },
] as const;

function pageHref(next: { page?: number; status?: string; sort?: PostListSort; query?: string }): string {
  const params = new URLSearchParams();
  const nextQuery = next.query ?? query;
  const nextStatus = next.status ?? status;
  const nextSort = next.sort ?? sort;
  const nextPage = next.page ?? 1;
  if (nextQuery) params.set('q', nextQuery);
  if (nextStatus) params.set('status', nextStatus);
  if (nextSort === 'oldest') params.set('sort', 'oldest');
  if (nextPage > 1) params.set('page', String(nextPage));
  const text = params.toString();
  return text ? `${routes.adminPosts}?${text}` : routes.adminPosts;
}
---

<AdminLayout title="Quản lý bài viết">
  <p slot="lead">{status === 'trash' ? 'Bài trong thùng rác vẫn giữ nội dung. Khôi phục sẽ thành bản nháp.' : result ? `${result.libraryTotal} bài trong thư viện` : 'Danh sách bài viết'}</p>
  <a slot="action" class="btn btn-primary" href={routes.adminPostNew}>Viết bài</a>
  {loadError && <p class="error-text" role="alert">{loadError}</p>}
  {
    result && (
      <>
        {!(result.counts.all === 0 && result.counts.trash === 0 && !query) && (
          <div class="post-controls">
            <form class="post-toolbar" method="get" data-post-search>
              {status && <input type="hidden" name="status" value={status} />}
              {sort === 'oldest' && <input type="hidden" name="sort" value="oldest" />}
              <label class="sr-only" for="post-query">Tìm bài viết</label>
              <input id="post-query" class="field" name="q" value={query} placeholder="Tìm bài viết..." maxlength="180" />
            </form>
            <div class="post-filters" role="group" aria-label="Lọc trạng thái">
              {filters.map((filter) => (
                <a href={pageHref({ status: filter.id, page: 1 })} aria-current={status === filter.id ? 'page' : undefined}>
                  {filter.label} ({filter.count})
                </a>
              ))}
            </div>
          </div>
        )}
        <div data-post-results>
          {trashed && <p class="mb-4 text-primary-strong" role="status">Đã chuyển bài vào thùng rác.</p>}
          {purged && <p class="mb-4 text-primary-strong" role="status">Đã xóa vĩnh viễn bài viết.</p>}
          {copyError && <p class="error-text mb-4" role="alert">Không sao chép được bài viết.</p>}
          {bulkNotice && <p class="mb-4 text-primary-strong" role="status">{bulkNotice}</p>}
          {bulkError && <p class="error-text mb-4" role="alert">Không thực hiện được thao tác hàng loạt. Chọn tối đa 20 bài rồi thử lại.</p>}
          {retireError && <p class="error-text mb-4" role="alert">Chưa xử lý được URL cũ. Hãy chọn cách xử lý hợp lệ cho các bài đã công khai.</p>}
          {actionError && <p class="error-text mb-4" role="alert">{actionError}</p>}
          <p class="mb-3 text-sm" role="status" data-category-status hidden></p>
          {result.rows.length > 0 && (
            <form
              id="post-bulk"
              class="bulk-bar"
              method="post"
              action={routes.adminPostsBulk}
              aria-label="Thao tác hàng loạt"
              data-post-bulk
              hidden
            >
              <input type="hidden" name="csrf" value={session.csrfToken} />
              <input type="hidden" name="q" value={query} />
              <input type="hidden" name="status" value={status} />
              <input type="hidden" name="sort" value={sort} />
              <input type="hidden" name="page" value={String(result.page)} />
              <input type="hidden" name="bulk" value="" data-bulk-action />
              <input type="hidden" name="urlAction" value="" />
              <input type="hidden" name="urlTarget" value="" />
              <span class="bulk-count" aria-live="polite" data-bulk-count>Đã chọn 0</span>
              <button class="bulk-link" type="button" data-bulk-pick-all>Chọn tất cả</button>
              {status === 'trash' ? (
                <>
                  <button class="btn" type="submit" data-bulk-submit="restore">Khôi phục</button>
                  {canPurge && <button class="btn btn-accent" type="submit" data-bulk-submit="purge">Xóa vĩnh viễn</button>}
                </>
              ) : (
                <>
                  <button class="btn" type="submit" data-bulk-submit="publish">Xuất bản</button>
                  <button class="btn btn-accent" type="submit" data-bulk-submit="trash">Thùng rác</button>
                </>
              )}
              <button class="bulk-link" type="button" data-bulk-clear>Bỏ chọn</button>
              <span class="error-text" role="alert" data-bulk-error hidden></span>
            </form>
          )}
        <div data-post-list data-csrf={session.csrfToken}>
          {result.rows.length === 0 && result.counts.all === 0 && !query && status !== 'trash' ? (
            <section class="cms-empty">
              <span class="cms-empty-icon" aria-hidden="true">
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M7 3.5h7l4 4V20.5H7z" />
                  <path d="M14 3.5V8h4M9.5 12.5h6M9.5 16h4" />
                </svg>
              </span>
              <h2 class="cms-empty-title">Chưa có bài viết nào</h2>
              <p class="cms-empty-text">Viết bài chia sẻ kiến thức để thu hút khách tự nhiên từ Google và xây lòng tin với người mua.</p>
              <ul class="cms-empty-points">
                <li>Soạn bài bằng trình soạn thảo có ảnh, tiêu đề, danh mục và thẻ.</li>
                <li>Chèn liên kết tới sản phẩm hoặc bài liên quan ngay trong nội dung.</li>
                <li>Công cụ Kiểm tra SEO rà title, mô tả, ảnh và liên kết giúp bài lên top.</li>
              </ul>
              <a class="btn btn-primary" href={routes.adminPostNew}>Viết bài đầu tiên</a>
            </section>
          ) : result.rows.length === 0 ? (
            <p class="post-empty">
              {status === 'trash' && !query ? 'Thùng rác trống.' : 'Không có bài khớp bộ lọc.'}
            </p>
          ) : status === 'trash' ? (
            <table class="post-table">
              <thead>
                <tr>
                  <th class="product-check"><input type="checkbox" aria-label="Chọn tất cả bài trong thùng rác" data-bulk-all /></th>
                  <th>Tiêu đề</th>
                  <th>Người xóa</th>
                  <th>Trước khi xóa</th>
                  <th>Vào thùng rác</th>
                  <th>Thao tác</th>
                </tr>
              </thead>
              <tbody>
                {result.rows.map((post) => {
                  const actor = post.deletedByName?.trim() || '—';
                  return (
                    <tr>
                      <td class="product-check">
                        <input type="checkbox" form="post-bulk" name="ids" value={post.id} aria-label={`Chọn ${post.title}`} />
                      </td>
                      <td><span class="post-title">{post.title}</span></td>
                      <td>{actor}</td>
                      <td>
                        <span class="post-status" data-status={post.status === 'published' ? 'published' : 'draft'}>
                          {isPostStatus(post.status) ? POST_STATUS_LABELS[post.status] : post.status}
                        </span>
                      </td>
                      <td>{post.deletedAt ? formatDateTime(post.deletedAt) : '—'}</td>
                      <td>
                        <div class="post-actions">
                          <form
                            method="post"
                            action={routes.adminPostRestore(post.id)}
                            data-busy
                            data-confirm-title="Khôi phục bài viết?"
                            data-confirm={`“${post.title}” sẽ trở lại thành bản nháp. Bài không tự xuất bản lại.`}
                            data-confirm-ok="Khôi phục"
                          >
                            <input type="hidden" name="csrf" value={session.csrfToken} />
                            <button class="btn" type="submit">Khôi phục</button>
                          </form>
                          {canPurge && (
                            <form
                              method="post"
                              action={routes.adminPostPurge(post.id)}
                              data-busy
                              data-confirm-title="Xóa vĩnh viễn?"
                              data-confirm={`“${post.title}” sẽ bị xóa khỏi cơ sở dữ liệu và không khôi phục được trong CMS. Ảnh trong thư viện được giữ nguyên.`}
                              data-confirm-ok="Xóa vĩnh viễn"
                              data-confirm-tone="danger"
                            >
                              <input type="hidden" name="csrf" value={session.csrfToken} />
                              <button class="btn btn-accent" type="submit">Xóa vĩnh viễn</button>
                            </form>
                          )}
                        </div>
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          ) : (
            <table class="post-table">
              <thead>
                <tr>
                  <th class="product-check"><input type="checkbox" aria-label="Chọn tất cả bài đang hiện" data-bulk-all /></th>
                  <th>Tiêu đề</th>
                  <th>Tác giả</th>
                  <th>Danh mục</th>
                  <th>Trạng thái</th>
                  <th title="Số bài đã xuất bản khác có liên kết tới bài này">Link vào</th>
                  <th title="Số bài khác mà bài này liên kết tới">Link ra</th>
                  <th aria-sort={sort === 'oldest' ? 'ascending' : 'descending'}>
                    <a href={pageHref({ sort: sort === 'oldest' ? 'newest' : 'oldest', page: 1 })}>Cập nhật</a>
                  </th>
                  <th>Thao tác</th>
                </tr>
              </thead>
              <tbody>
                {result.rows.map((post) => {
                  const published = post.status === 'published';
                  const wasPublic = published || post.publishedAt != null;
                  const links = linkCounts.get(post.id);
                  return (
                    <tr>
                      <td class="product-check">
                        <input
                          type="checkbox"
                          form="post-bulk"
                          name="ids"
                          value={post.id}
                          aria-label={`Chọn ${post.title}`}
                          data-public={wasPublic ? '1' : undefined}
                        />
                      </td>
                      <td>
                        <a class="post-title" href={routes.adminPost(post.id)}>{post.title}</a>
                      </td>
                      <td data-label="Tác giả">{post.authorName?.trim() || post.authorUsername || '—'}</td>
                      <td data-label="Danh mục">
                        <select
                          class="post-category"
                          data-post-category={routes.adminPostCategory(post.id)}
                          data-saved={post.categoryId ?? ''}
                          aria-label={`Danh mục của “${post.title}”`}
                        >
                          <option value="">Chưa có danh mục</option>
                          {categoryOptions.map((category) => (
                            <option value={category.id} selected={category.id === post.categoryId}>{category.name}</option>
                          ))}
                        </select>
                      </td>
                      <td>
                        <span class="post-status" data-status={published ? 'published' : 'draft'}>
                          {isPostStatus(post.status) ? POST_STATUS_LABELS[post.status] : post.status}
                        </span>
                      </td>
                      <td data-label="Link vào">{links?.inbound ?? '—'}</td>
                      <td data-label="Link ra">{links?.outbound ?? '—'}</td>
                      <td>{formatDateTime(post.updatedAt)}</td>
                      <td>
                        <div class="post-actions">
                          <a href={routes.adminPost(post.id)}>Sửa</a>
                          <span class="post-actions-sep" aria-hidden="true">|</span>
                          {published ? (
                            <a href={routes.knowledge(post.slug)} target="_blank" rel="noopener">Xem bài</a>
                          ) : (
                            <a href={`${routes.adminPostPreview}?id=${post.id}`} target="_blank" rel="noopener">Xem trước</a>
                          )}
                          <details class="row-menu">
                            <summary aria-label={`Thao tác khác: ${post.title}`}>⋯</summary>
                            <div>
                              <form method="post" action={routes.adminPostCopy(post.id)}>
                                <input type="hidden" name="csrf" value={session.csrfToken} />
                                <button type="submit">Sao chép</button>
                              </form>
                              <form
                                id={`delete-post-${post.id}`}
                                method="post"
                                action={routes.adminPostDelete(post.id)}
                                data-confirm-title={wasPublic ? undefined : 'Chuyển vào thùng rác?'}
                                data-confirm={wasPublic ? undefined : `“${post.title}” sẽ rời khỏi danh sách bài viết. Bạn có thể khôi phục trong tab Thùng rác.`}
                                data-confirm-ok={wasPublic ? undefined : 'Chuyển vào thùng rác'}
                              >
                                <input type="hidden" name="csrf" value={session.csrfToken} />
                                <input type="hidden" name="urlAction" value="" />
                                <input type="hidden" name="urlTarget" value="" />
                                <button type="submit" data-retire={wasPublic ? 'delete' : undefined} data-retire-form={wasPublic ? `delete-post-${post.id}` : undefined}>Thùng rác</button>
                              </form>
                            </div>
                          </details>
                        </div>
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          )}
        </div>
        {result.pageCount > 1 && (
          <nav class="post-pager" aria-label="Phân trang">
            {result.page > 1 && <a class="btn" href={pageHref({ page: result.page - 1 })}>Trang trước</a>}
            <span>Trang {result.page}/{result.pageCount}</span>
            {result.page < result.pageCount && <a class="btn" href={pageHref({ page: result.page + 1 })}>Trang sau</a>}
          </nav>
        )}
        </div>
      </>
    )
  }
  <RetiredUrlDialog posts={targets} />
</AdminLayout>

<script>
  document.addEventListener('toggle', (event) => {
    const menu = event.target;
    if (!(menu instanceof HTMLDetailsElement) || !menu.open || !menu.classList.contains('row-menu')) return;
    for (const other of document.querySelectorAll('details.row-menu[open]')) {
      if (other !== menu && other instanceof HTMLDetailsElement) other.open = false;
    }
  }, true);

  document.addEventListener('pointerdown', (event) => {
    const target = event.target;
    if (!(target instanceof Node)) return;
    for (const menu of document.querySelectorAll('details.row-menu[open]')) {
      if (menu instanceof HTMLDetailsElement && !menu.contains(target)) menu.open = false;
    }
  });

  const searchForm = document.querySelector('[data-post-search]');
  const input = document.querySelector('#post-query');
  // Vùng kết quả bị thay HTML sau mỗi thao tác hàng loạt nên mọi phần tử bên trong đều truy vấn lại khi dùng.
  const results = document.querySelector<HTMLElement>('[data-post-results]');
  const postList = () => results?.querySelector<HTMLElement>('[data-post-list]');

  const rowBoxes = () => (results ? [...results.querySelectorAll<HTMLInputElement>('input[name="ids"]')] : []);
  let anchor: HTMLInputElement | null = null;

  function syncSelection() {
    const boxes = rowBoxes();
    const picked = boxes.filter((box) => box.checked).length;
    const allChecked = boxes.length > 0 && picked === boxes.length;
    const all = results?.querySelector<HTMLInputElement>('[data-bulk-all]');
    if (all) {
      all.checked = allChecked;
      all.indeterminate = picked > 0 && !allChecked;
    }
    const bar = results?.querySelector<HTMLFormElement>('[data-post-bulk]');
    if (!bar) return;
    bar.hidden = picked === 0;
    const count = bar.querySelector('[data-bulk-count]');
    if (count) count.textContent = `Đã chọn ${picked}`;
    const pickAll = bar.querySelector<HTMLButtonElement>('[data-bulk-pick-all]');
    if (pickAll) pickAll.hidden = allChecked;
    const error = bar.querySelector<HTMLElement>('[data-bulk-error]');
    if (error && picked === 0) error.hidden = true;
  }

  function pick(checked: boolean) {
    for (const box of rowBoxes()) box.checked = checked;
    syncSelection();
  }

  function bulkError(message: string) {
    const error = results?.querySelector<HTMLElement>('[data-bulk-error]');
    if (!(error instanceof HTMLElement)) return;
    error.textContent = message;
    error.hidden = message === '';
  }

  function setConfirm(form: HTMLFormElement, confirm: { title: string; message: string; ok: string; tone: string } | null) {
    if (!confirm) {
      delete form.dataset.confirm;
      delete form.dataset.confirmTitle;
      delete form.dataset.confirmOk;
      delete form.dataset.confirmTone;
      return;
    }
    form.dataset.confirm = confirm.message;
    form.dataset.confirmTitle = confirm.title;
    form.dataset.confirmOk = confirm.ok;
    form.dataset.confirmTone = confirm.tone;
  }

  results?.addEventListener('click', (event) => {
    const target = event.target instanceof Element ? event.target : null;
    if (!target) return;

    if (target instanceof HTMLInputElement && target.name === 'ids') {
      if (event.shiftKey && anchor && anchor !== target && anchor.isConnected) {
        const boxes = rowBoxes();
        const from = boxes.indexOf(anchor);
        const to = boxes.indexOf(target);
        if (from >= 0 && to >= 0) {
          for (const box of boxes.slice(Math.min(from, to), Math.max(from, to) + 1)) box.checked = target.checked;
        }
      }
      anchor = target;
      return;
    }

    if (target.closest('[data-bulk-pick-all]')) return pick(true);
    if (target.closest('[data-bulk-clear]')) return pick(false);

    const action = target.closest<HTMLButtonElement>('[data-post-bulk] button[data-bulk-submit]');
    if (!action?.form) return;
    const form = action.form;
    const kind = action.dataset.bulkSubmit ?? '';
    const picked = rowBoxes().filter((box) => box.checked);
    if (picked.length === 0) return;
    // Nút submit không mang name; ghi loại thao tác vào input ẩn để fetch và dialog đều gửi đúng.
    const actionInput = form.querySelector<HTMLInputElement>('[data-bulk-action]');
    if (actionInput) actionInput.value = kind;

    if (kind === 'trash') {
      const publicCount = picked.filter((box) => box.dataset.public === '1').length;
      if (publicCount > 0) {
        // Bài đã công khai cần cách xử lý URL cũ; mở hộp thoại để chọn một cách chung cho cả nhóm.
        event.preventDefault();
        bulkError('');
        form.dispatchEvent(new CustomEvent('retire-open', { detail: { mode: 'delete', form: 'post-bulk' }, bubbles: true }));
        return;
      }
      setConfirm(form, {
        title: 'Chuyển vào thùng rác',
        message: `${picked.length} bản nháp sẽ vào thùng rác. Bạn có thể khôi phục sau.`,
        ok: `Chuyển ${picked.length} bài`,
        tone: '',
      });
    } else if (kind === 'purge') {
      setConfirm(form, {
        title: 'Xóa vĩnh viễn',
        message: `${picked.length} bài sẽ bị xóa khỏi cơ sở dữ liệu và không khôi phục được. Ảnh trong thư viện được giữ nguyên.`,
        ok: `Xóa ${picked.length} bài`,
        tone: 'danger',
      });
    } else {
      setConfirm(form, null);
    }
  });

  results?.addEventListener('change', (event) => {
    const target = event.target;
    if (!(target instanceof HTMLInputElement)) return;
    if (target.hasAttribute('data-bulk-all')) return pick(target.checked);
    if (target.name === 'ids') syncSelection();
  });

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape' || document.querySelector('dialog[open]')) return;
    if (rowBoxes().some((box) => box.checked)) pick(false);
  });

  // ConfirmDialog và RetiredUrlDialog chặn ở pha capture; lượt submit đã xác nhận mới tới đây.
  document.addEventListener('submit', async (event) => {
    const form = event.target;
    if (!(form instanceof HTMLFormElement) || !form.hasAttribute('data-post-bulk') || event.defaultPrevented || !results) return;
    event.preventDefault();
    if (form.dataset.sending === '1') return;
    const data = new FormData(form);
    const buttons = [...form.querySelectorAll('button')];
    form.dataset.sending = '1';
    for (const button of buttons) button.disabled = true;
    postList()?.setAttribute('aria-busy', 'true');
    try {
      const response = await fetch(form.getAttribute('action') ?? location.href, { method: 'POST', body: data, headers: { accept: 'text/html' } });
      const url = new URL(response.url);
      const next = response.ok ? new DOMParser().parseFromString(await response.text(), 'text/html') : null;
      const nextResults = next?.querySelector('[data-post-results]');
      if (!next || !nextResults) throw new Error(`bulk_${response.status}`);
      results.innerHTML = nextResults.innerHTML;
      const lead = document.querySelector('[slot="lead"]');
      const nextLead = next.querySelector('[slot="lead"]');
      if (lead && nextLead) lead.textContent = nextLead.textContent;
      history.replaceState(null, '', url.pathname + url.search);
      anchor = null;
      syncSelection();
    } catch {
      bulkError('Không thực hiện được. Tải lại trang rồi thử lại.');
    } finally {
      delete form.dataset.sending;
      for (const button of buttons) button.disabled = false;
      postList()?.removeAttribute('aria-busy');
    }
  });

  const categoryStatus = () => results?.querySelector<HTMLElement>('[data-category-status]');
  let categoryTimer = 0;
  const announce = (text: string, failed: boolean) => {
    const node = categoryStatus();
    if (!(node instanceof HTMLElement)) return;
    window.clearTimeout(categoryTimer);
    node.textContent = text;
    node.className = `mb-3 text-sm ${failed ? 'error-text' : 'text-primary-strong'}`;
    node.hidden = false;
    if (!failed) categoryTimer = window.setTimeout(() => (node.hidden = true), 2500);
  };
  document.addEventListener('change', async (event) => {
    const select = event.target;
    if (!(select instanceof HTMLSelectElement) || !select.dataset.postCategory) return;
    const list = postList();
    const body = new FormData();
    body.set('csrf', list instanceof HTMLElement ? (list.dataset.csrf ?? '') : '');
    body.set('categoryId', select.value);
    select.disabled = true;
    let error = '';
    try {
      const response = await fetch(select.dataset.postCategory, { method: 'POST', body, headers: { accept: 'application/json' } });
      const data: unknown = await response.json().catch(() => null);
      if (response.ok) select.dataset.saved = select.value;
      else if (data && typeof data === 'object' && 'error' in data && typeof data.error === 'string') error = data.error;
      else error = 'Không đổi được danh mục.';
    } catch {
      error = 'Không kết nối được. Hãy thử lại.';
    }
    select.disabled = false;
    if (error) {
      select.value = select.dataset.saved ?? '';
      announce(error, true);
    } else {
      announce(`Đã đổi danh mục thành “${select.selectedOptions[0]?.text ?? ''}”.`, false);
    }
  });

  if (searchForm instanceof HTMLFormElement && input instanceof HTMLInputElement) {
    let timer = 0;
    const go = () => {
      const url = new URL(location.href);
      const value = input.value.trim();
      if (value) url.searchParams.set('q', value);
      else url.searchParams.delete('q');
      for (const name of ['page', 'deleted', 'trashed', 'purged', 'error', 'bulk', 'n', 'skip']) url.searchParams.delete(name);
      if (url.toString() === location.href) return;
      postList()?.setAttribute('aria-busy', 'true');
      location.assign(url);
    };
    input.addEventListener('input', () => {
      window.clearTimeout(timer);
      timer = window.setTimeout(go, 300);
    });
    searchForm.addEventListener('submit', (event) => {
      event.preventDefault();
      window.clearTimeout(timer);
      go();
    });
  }

  syncSelection();
</script>
