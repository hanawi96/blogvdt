---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { listPosts } from '../../../features/posts/posts';
import { isPostStatus, POST_STATUS_LABELS } from '../../../features/posts/status';
import { createDb } from '../../../lib/db/client';
import { getDbBinding } from '../../../lib/cloudflare/env';
import { formatDateTime } from '../../../lib/datetime';
import { routes } from '../../../lib/routes';

if (!Astro.locals.adminSession) return Astro.redirect(routes.adminLogin);

const query = Astro.url.searchParams.get('q') ?? '';
const statusParam = Astro.url.searchParams.get('status') ?? '';
const status = isPostStatus(statusParam) ? statusParam : '';
const page = Number(Astro.url.searchParams.get('page') ?? '1');
let loadError = '';
let result: Awaited<ReturnType<typeof listPosts>> | null = null;
try {
  result = await listPosts(createDb(getDbBinding()), { query, status, page: Number.isInteger(page) ? page : 1 });
} catch (error) {
  console.error(JSON.stringify({ event: 'post_list_failed', name: error instanceof Error ? error.name : 'unknown' }));
  loadError = 'Không tải được danh sách bài viết.';
}

function pageHref(nextPage: number): string {
  const params = new URLSearchParams();
  if (query) params.set('q', query);
  if (status) params.set('status', status);
  if (nextPage > 1) params.set('page', String(nextPage));
  const text = params.toString();
  return text ? `${routes.adminPosts}?${text}` : routes.adminPosts;
}
---

<AdminLayout title="Bài viết">
  <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
    <form class="flex flex-wrap gap-2" method="get">
      <label class="sr-only" for="post-query">Tìm bài viết</label>
      <input id="post-query" class="field max-w-xs" name="q" value={query} placeholder="Tìm tiêu đề" maxlength="180" />
      <label class="sr-only" for="post-status">Trạng thái</label>
      <select id="post-status" class="field w-auto" name="status">
        <option value="" selected={status === ''}>Mọi trạng thái</option>
        <option value="draft" selected={status === 'draft'}>Bản nháp</option>
        <option value="published" selected={status === 'published'}>Đã xuất bản</option>
      </select>
      <button class="btn" type="submit">Lọc</button>
    </form>
    <a class="btn btn-primary" href={routes.adminPostNew}>Viết bài</a>
  </div>
  {loadError && <p class="error-text" role="alert">{loadError}</p>}
  {
    result && result.rows.length === 0 && <p class="text-muted">Chưa có bài viết khớp bộ lọc.</p>
  }
  {
    result && result.rows.length > 0 && (
      <table class="w-full border-collapse text-left">
        <thead>
          <tr class="border-b border-line">
            <th class="py-2">Tiêu đề</th>
            <th class="py-2">Danh mục</th>
            <th class="py-2">Trạng thái</th>
            <th class="py-2">Cập nhật</th>
          </tr>
        </thead>
        <tbody>
          {result.rows.map((post) => (
            <tr class="border-b border-line">
              <td class="py-2">
                <a class="font-semibold underline" href={routes.adminPost(post.id)}>
                  {post.title}
                </a>
              </td>
              <td class="py-2">{post.categoryName ?? '—'}</td>
              <td class="py-2">{isPostStatus(post.status) ? POST_STATUS_LABELS[post.status] : post.status}</td>
              <td class="py-2">{formatDateTime(post.updatedAt)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    )
  }
  {
    result && result.pageCount > 1 && (
      <nav class="mt-4 flex gap-3" aria-label="Phân trang">
        {result.page > 1 && <a href={pageHref(result.page - 1)}>Trang trước</a>}
        <span>
          Trang {result.page}/{result.pageCount}
        </span>
        {result.page < result.pageCount && <a href={pageHref(result.page + 1)}>Trang sau</a>}
      </nav>
    )
  }
</AdminLayout>
