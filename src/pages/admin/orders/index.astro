---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { activityActor } from '../../../features/activity/log';
import { mutationError } from '../../../features/auth/session';
import { orderCreatedRange } from '../../../features/orders/order';
import { deleteOrder, listOrders, orderAdminQuery, orderListStatus } from '../../../features/orders/orders';
import { isOrderStatus, ORDER_STATUS_LABELS, ORDER_STATUSES } from '../../../features/orders/status';
import { createDb } from '../../../lib/db/client';
import { getDbBinding } from '../../../lib/cloudflare/env';
import { formatDateTime } from '../../../lib/datetime';
import { formatVnd } from '../../../lib/money';
import { routes } from '../../../lib/routes';

const session = Astro.locals.adminSession;
if (!session) return Astro.redirect(routes.adminLogin);

const query = Astro.url.searchParams.get('q') ?? '';
const status = orderListStatus(Astro.url.searchParams.get('status'));
const from = Astro.url.searchParams.get('from') ?? '';
const to = Astro.url.searchParams.get('to') ?? '';
const page = Number(Astro.url.searchParams.get('page') ?? '1');
const range = orderCreatedRange(from, to);
let loadError = range.invalid ? 'Khoảng ngày không hợp lệ.' : '';
const notice = Astro.url.searchParams.get('notice');

if (Astro.request.method === 'POST') {
  if (session.role !== 'admin') {
    return new Response('Bạn không có quyền xóa đơn hàng.', { status: 403, headers: { 'content-type': 'text/plain; charset=utf-8' } });
  }
  const form = await Astro.request.formData();
  const blocked = mutationError(Astro.request, session, form);
  const id = Number(form.get('id'));
  if (blocked) {
    Astro.response.status = 403;
    loadError = blocked;
  } else if (form.get('intent') !== 'delete' || !Number.isInteger(id) || id < 1) {
    Astro.response.status = 422;
    loadError = 'Thao tác không hợp lệ.';
  } else {
    const db = createDb(getDbBinding());
    const removed = await deleteOrder(db, id, await activityActor(db, session.userId));
    const back = orderAdminQuery({ query, status, from, to, page: Number.isInteger(page) ? page : 1 });
    return Astro.redirect(`${back}${back.includes('?') ? '&' : '?'}notice=${removed.ok ? 'deleted' : 'missing'}`, 303);
  }
}
let result: Awaited<ReturnType<typeof listOrders>> | null = null;
if (!range.invalid) {
  try {
    result = await listOrders(createDb(getDbBinding()), {
      query,
      status,
      start: range.start,
      end: range.end,
      page: Number.isInteger(page) ? page : 1,
    });
  } catch (error) {
    console.error(JSON.stringify({ event: 'order_list_failed', name: error instanceof Error ? error.name : 'unknown' }));
    loadError = 'Không tải được danh sách đơn.';
  }
}

const stats = [
  { id: '', label: 'Tổng đơn', count: result?.counts.all ?? 0 },
  { id: 'new', label: 'Đơn mới', count: result?.counts.incoming ?? 0 },
  { id: 'processing', label: 'Đang xử lý', count: result?.counts.processing ?? 0 },
  { id: 'completed', label: 'Hoàn thành', count: result?.counts.completed ?? 0 },
] as const;

function pageHref(nextPage: number): string {
  return orderAdminQuery({ query, status, from, to, page: nextPage });
}
---

<AdminLayout title="Quản lý đơn hàng">
  <p slot="lead">{result ? `${result.libraryTotal} đơn hàng` : 'Danh sách đơn hàng'}</p>
  {loadError && <p class="error-text mb-4" role="alert">{loadError}</p>}
  {notice === 'deleted' && <p class="mb-4 text-primary-strong" role="status">Đã xóa đơn hàng.</p>}
  {notice === 'missing' && <p class="error-text mb-4" role="alert">Không tìm thấy đơn hàng cần xóa.</p>}
  {
    result && result.libraryTotal === 0 && !query && !from && !to && status === '' ? (
      <section class="cms-empty">
        <span class="cms-empty-icon" aria-hidden="true">
          <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M7 4.5h10v15H7z" />
            <path d="M10 8h4M10 11.5h4M10 15h2.5" />
          </svg>
        </span>
        <h2 class="cms-empty-title">Chưa có đơn hàng nào</h2>
        <p class="cms-empty-text">Đơn hàng sẽ hiện ở đây ngay khi khách gửi thông tin đặt mua trên website. Xưởng gọi lại để chốt, website không thu tiền trực tuyến.</p>
        <ul class="cms-empty-points">
          <li>Mỗi đơn gồm sản phẩm, lựa chọn, số lượng và thông tin liên hệ khách.</li>
          <li>Theo dõi trạng thái: mới, xác nhận, đang chuẩn bị, đã gửi, hoàn thành.</li>
          <li>Đơn từ trang đích quảng cáo được gắn nguồn để đo chuyển đổi.</li>
        </ul>
        <a class="btn btn-primary" href={routes.checkout} target="_blank" rel="noopener">Xem trang đặt hàng</a>
      </section>
    ) : result ? (
      <>
        <div class="order-stats">
          {stats.map((item) => (
            <a href={orderAdminQuery({ query, status: item.id, from, to })} aria-current={status === item.id ? 'page' : undefined}>
              <span>{item.label}</span>
              <strong>{item.count}</strong>
            </a>
          ))}
        </div>
        <form class="post-toolbar product-toolbar order-toolbar" method="get" data-order-search>
          <label class="sr-only" for="order-query">Tìm đơn</label>
          <input id="order-query" class="field" name="q" value={query} placeholder="Mã, tên hoặc số điện thoại" maxlength="80" />
          <label class="sr-only" for="order-status">Trạng thái</label>
          <select id="order-status" class="field" name="status">
            <option value="" selected={status === ''}>Tất cả trạng thái</option>
            <option value="processing" selected={status === 'processing'}>Đang xử lý</option>
            {ORDER_STATUSES.map((item) => <option value={item} selected={status === item}>{ORDER_STATUS_LABELS[item]}</option>)}
          </select>
          <label class="sr-only" for="order-from">Từ ngày</label>
          <input id="order-from" class="field" type="date" name="from" value={from} />
          <label class="sr-only" for="order-to">Đến ngày</label>
          <input id="order-to" class="field" type="date" name="to" value={to} />
        </form>
        <div data-order-list>
          {result.rows.length === 0 ? (
            <p class="post-empty">Không có đơn khớp bộ lọc.</p>
          ) : (
            <table class="post-table order-table">
              <thead>
                <tr>
                  <th>Mã đơn</th>
                  <th>Khách hàng</th>
                  <th>Sản phẩm</th>
                  <th>Tổng tiền</th>
                  <th>Trạng thái</th>
                  <th>Thời gian</th>
                  <th>Thao tác</th>
                </tr>
              </thead>
              <tbody>
                {result.rows.map((order) => (
                  <tr>
                    <td><a class="post-title" href={routes.adminOrder(order.id)}>{order.code}</a></td>
                    <td data-label="Khách hàng">{order.customerName}</td>
                    <td data-label="Sản phẩm">{order.productName}</td>
                    <td data-label="Tổng tiền">{formatVnd(order.totalPrice)}</td>
                    <td data-label="Trạng thái">
                      <span class="order-badge" data-status={order.status}>
                        {isOrderStatus(order.status) ? ORDER_STATUS_LABELS[order.status] : order.status}
                      </span>
                    </td>
                    <td data-label="Thời gian">{formatDateTime(order.createdAt)}</td>
                    <td data-label="Thao tác">
                      <div class="post-actions">
                        <a href={routes.adminOrder(order.id)}>Xem</a>
                        <span class="post-actions-sep" aria-hidden="true">|</span>
                        <form
                          method="post"
                          data-busy
                          data-confirm-title={`Xóa đơn ${order.code}?`}
                          data-confirm="Đơn sẽ bị xóa vĩnh viễn cùng các dòng sản phẩm và không khôi phục được. Nếu chỉ muốn bỏ đơn, hãy đổi trạng thái sang Hủy đơn."
                          data-confirm-ok="Xóa"
                          data-confirm-tone="danger"
                        >
                          <input type="hidden" name="csrf" value={session.csrfToken} />
                          <input type="hidden" name="intent" value="delete" />
                          <input type="hidden" name="id" value={order.id} />
                          <button class="category-delete" type="submit" data-keep-label="true">Xóa</button>
                        </form>
                      </div>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          )}
        </div>
        {result.pageCount > 1 && (
          <nav class="post-pager" aria-label="Phân trang">
            {result.page > 1 && <a class="btn" href={pageHref(result.page - 1)}>Trang trước</a>}
            <span>Trang {result.page}/{result.pageCount}</span>
            {result.page < result.pageCount && <a class="btn" href={pageHref(result.page + 1)}>Trang sau</a>}
          </nav>
        )}
      </>
    ) : null
  }
</AdminLayout>

<script>
  const form = document.querySelector('[data-order-search]');
  const list = document.querySelector('[data-order-list]');
  if (form instanceof HTMLFormElement) {
    const input = form.querySelector('input[name="q"]');
    let timer = 0;
    const go = () => {
      const data = new FormData(form);
      const read = (name: string) => {
        const value = data.get(name);
        return typeof value === 'string' ? value : '';
      };
      const params = new URLSearchParams();
      const term = read('q').trim();
      const status = read('status');
      const from = read('from');
      const to = read('to');
      if (term) params.set('q', term);
      if (status) params.set('status', status);
      if (/^\d{4}-\d{2}-\d{2}$/.test(from)) params.set('from', from);
      if (/^\d{4}-\d{2}-\d{2}$/.test(to)) params.set('to', to);
      const next = params.size ? `/admin/orders?${params}` : '/admin/orders';
      if (next === `${location.pathname}${location.search}`) return;
      list?.setAttribute('aria-busy', 'true');
      location.assign(next);
    };
    if (input instanceof HTMLInputElement) {
      input.addEventListener('input', () => {
        window.clearTimeout(timer);
        timer = window.setTimeout(go, 300);
      });
    }
    form.addEventListener('change', (event) => {
      if (event.target === input) return;
      window.clearTimeout(timer);
      go();
    });
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      window.clearTimeout(timer);
      go();
    });
  }
</script>
