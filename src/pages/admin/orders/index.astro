---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { activityActor } from '../../../features/activity/log';
import { mutationError } from '../../../features/auth/session';
import { orderProfit } from '../../../features/costs/order-costs';
import { orderCreatedRange } from '../../../features/orders/order';
import { deleteOrder, listOrders, orderAdminQuery, orderListPayment, orderListSource, orderListStatus, updateOrderPriority, updateOrderStatus } from '../../../features/orders/orders';
import { CUSTOMER_TIER_LABELS, customerTierOf } from '../../../features/orders/customers';
import { ORDER_PAYMENT_FILTERS } from '../../../features/orders/payment';
import { collectionLabel, formatShipLabel, ORDER_SOURCES, sourceLabel } from '../../../features/orders/staff';
import {
  isOrderStatus,
  nextOrderStatuses,
  ORDER_LIST_FILTERS,
  ORDER_STATUS_LABELS,
  orderStatusLabel,
  type OrderStatus,
} from '../../../features/orders/status';
import { createDb } from '../../../lib/db/client';
import { getDbBinding } from '../../../lib/cloudflare/env';
import { formatDateShort, formatOrderDateFilterLabel, formatTimeHms, vnMonthRange, vnTodayParts } from '../../../lib/datetime';
import { formatVnd } from '../../../lib/money';
import { routes } from '../../../lib/routes';

const session = Astro.locals.adminSession;
if (!session) return Astro.redirect(routes.adminLogin);

const query = Astro.url.searchParams.get('q') ?? '';
const status = orderListStatus(Astro.url.searchParams.get('status'));
const source = orderListSource(Astro.url.searchParams.get('source'));
const payment = orderListPayment(Astro.url.searchParams.get('payment'));
const from = Astro.url.searchParams.get('from') ?? '';
const to = Astro.url.searchParams.get('to') ?? '';
const page = Number(Astro.url.searchParams.get('page') ?? '1');
const range = orderCreatedRange(from, to);
const vnToday = vnTodayParts();
const monthQuick = Array.from({ length: vnToday.month }, (_, index) => {
  const month = index + 1;
  const span = vnMonthRange(vnToday.year, month)!;
  return { month, from: span.from, to: span.to };
});
const dateFilterLabel = formatOrderDateFilterLabel(from, to);
let loadError = range.invalid ? 'Khoảng ngày không hợp lệ.' : '';
const notice = Astro.url.searchParams.get('notice');
const bulkCount = Math.max(0, Number(Astro.url.searchParams.get('n')) || 0);
const canBulkDelete = session.role === 'admin';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const blocked = mutationError(Astro.request, session, form);
  const id = Number(form.get('id'));
  const intent = form.get('intent');
  if (blocked) {
    Astro.response.status = 403;
    loadError = blocked;
  } else if (!Number.isInteger(id) || id < 1) {
    Astro.response.status = 422;
    loadError = 'Thao tác không hợp lệ.';
  } else if (intent === 'priority') {
    const on = form.get('priority') === '1';
    const db = createDb(getDbBinding());
    const result = await updateOrderPriority(db, id, on);
    return Astro.redirect(
      orderAdminQuery({
        query,
        status,
        source,
        payment,
        from,
        to,
        page: Number.isInteger(page) ? page : 1,
        notice: result.ok ? (on ? 'priority-on' : 'priority-off') : 'priority-error',
      }),
      303,
    );
  } else if (intent === 'status') {
    const next = form.get('status');
    if (typeof next !== 'string' || !isOrderStatus(next)) {
      Astro.response.status = 422;
      loadError = 'Trạng thái không hợp lệ.';
    } else {
      const db = createDb(getDbBinding());
      const result = await updateOrderStatus(db, id, next);
      return Astro.redirect(
        orderAdminQuery({
          query,
          status,
          source,
          payment,
          from,
          to,
          page: Number.isInteger(page) ? page : 1,
          notice: result.ok ? 'status' : 'status-error',
        }),
        303,
      );
    }
  } else if (intent === 'delete') {
    if (session.role !== 'admin') {
      return new Response('Bạn không có quyền xóa đơn hàng.', { status: 403, headers: { 'content-type': 'text/plain; charset=utf-8' } });
    }
    const db = createDb(getDbBinding());
    const removed = await deleteOrder(db, id, await activityActor(db, session.userId));
    return Astro.redirect(
      orderAdminQuery({
        query,
        status,
        source,
        payment,
        from,
        to,
        page: Number.isInteger(page) ? page : 1,
        notice: removed.ok ? 'deleted' : 'missing',
      }),
      303,
    );
  } else {
    Astro.response.status = 422;
    loadError = 'Thao tác không hợp lệ.';
  }
}
let result: Awaited<ReturnType<typeof listOrders>> | null = null;
if (!range.invalid) {
  try {
    result = await listOrders(createDb(getDbBinding()), {
      query,
      status,
      source,
      payment,
      start: range.start,
      end: range.end,
      page: Number.isInteger(page) ? page : 1,
    });
  } catch (error) {
    console.error(JSON.stringify({ event: 'order_list_failed', name: error instanceof Error ? error.name : 'unknown' }));
    loadError = 'Không tải được danh sách đơn.';
  }
}

function pageHref(nextPage: number): string {
  return orderAdminQuery({ query, status, source, payment, from, to, page: nextPage });
}
---

<AdminLayout title="Quản lý đơn hàng">
  <a slot="action" class="btn btn-primary" href={routes.adminOrderNew}>Thêm đơn</a>
  <p slot="lead">{result ? `${result.libraryTotal} đơn hàng` : 'Danh sách đơn hàng'}</p>
  {loadError && <p class="error-text mb-4" role="alert">{loadError}</p>}
  {notice === 'deleted' && <p class="mb-4 text-primary-strong" role="status">Đã xóa đơn hàng.</p>}
  {notice === 'bulk-deleted' && (
    <p class="mb-4 text-primary-strong" role="status">
      {bulkCount > 0 ? `Đã xóa ${bulkCount} đơn hàng.` : 'Không có đơn nào được xóa.'}
    </p>
  )}
  {notice === 'priority-on' && <p class="mb-4 text-primary-strong" role="status">Đã gắn ưu tiên.</p>}
  {notice === 'priority-off' && <p class="mb-4 text-primary-strong" role="status">Đã bỏ ưu tiên.</p>}
  {notice === 'status' && <p class="mb-4 text-primary-strong" role="status">Đã cập nhật trạng thái.</p>}
  {notice === 'missing' && <p class="error-text mb-4" role="alert">Không tìm thấy đơn hàng cần xóa.</p>}
  {notice === 'bulk-error' && <p class="error-text mb-4" role="alert">Không thực hiện được thao tác hàng loạt. Thử lại.</p>}
  {notice === 'priority-error' && <p class="error-text mb-4" role="alert">Không đổi được ưu tiên. Đơn có thể đã kết thúc.</p>}
  {notice === 'status-error' && <p class="error-text mb-4" role="alert">Không đổi được trạng thái. Kiểm tra bước chuyển hợp lệ.</p>}
  {
    result && result.libraryTotal === 0 && !query && !source && !payment && !from && !to && (status === '' || status === 'unshipped') ? (
      <section class="cms-empty">
        <span class="cms-empty-icon" aria-hidden="true">
          <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M7 4.5h10v15H7z" />
            <path d="M10 8h4M10 11.5h4M10 15h2.5" />
          </svg>
        </span>
        <h2 class="cms-empty-title">Chưa có đơn hàng nào</h2>
        <p class="cms-empty-text">Đơn hàng sẽ hiện ở đây ngay khi khách gửi thông tin đặt mua trên website. Xưởng gọi lại để chốt, website không thu tiền trực tuyến.</p>
        <ul class="cms-empty-points">
          <li>Mỗi đơn gồm sản phẩm, lựa chọn, số lượng và thông tin liên hệ khách.</li>
          <li>Theo dõi trạng thái: mới, xác nhận, đang chuẩn bị, đã gửi, hoàn thành.</li>
          <li>Đơn từ trang đích quảng cáo được gắn nguồn để đo chuyển đổi.</li>
        </ul>
        <a class="btn btn-primary" href={routes.adminOrderNew}>Thêm đơn hàng đầu tiên</a>
      </section>
    ) : result ? (
      <>
        <form class="post-toolbar product-toolbar order-toolbar" method="get" data-order-search>
          <label class="sr-only" for="order-query">Tìm đơn</label>
          <input id="order-query" class="field" name="q" value={query} placeholder="Mã, tên hoặc số điện thoại" maxlength="80" />
          <label class="sr-only" for="order-status">Trạng thái</label>
          <select id="order-status" class="field" name="status">
            <option value="all" selected={status === ''}>Tất cả trạng thái</option>
            {ORDER_LIST_FILTERS.map((item) => (
              <option value={item.value} selected={status === item.value}>{item.label}</option>
            ))}
          </select>
          <label class="sr-only" for="order-source">Nguồn khách</label>
          <select id="order-source" class="field" name="source">
            <option value="" selected={source === ''}>Tất cả nguồn</option>
            {ORDER_SOURCES.map((item) => (
              <option value={item.value} selected={source === item.value}>{item.label}</option>
            ))}
          </select>
          <label class="sr-only" for="order-payment">Thanh toán</label>
          <select id="order-payment" class="field" name="payment">
            <option value="" selected={payment === ''}>Tất cả thanh toán</option>
            {ORDER_PAYMENT_FILTERS.map((item) => (
              <option value={item.value} selected={payment === item.value}>{item.label}</option>
            ))}
          </select>
          <input type="hidden" name="from" value={from} data-order-from />
          <input type="hidden" name="to" value={to} data-order-to />
          <button
            class="field order-date-trigger"
            type="button"
            data-order-date-open
            aria-haspopup="dialog"
            aria-expanded="false"
            aria-controls="order-date-dialog"
            data-active={from || to ? 'true' : undefined}
          >
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 3v2M17 3v2M4 8h16M6 5h12a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2z" /></svg>
            <span data-order-date-label>{dateFilterLabel}</span>
          </button>
        </form>
        <dialog id="order-date-dialog" class="order-date-dialog" aria-labelledby="order-date-dialog-title" data-order-date-dialog>
          <div class="order-date-dialog-card">
            <header class="order-date-dialog-head">
              <h2 id="order-date-dialog-title">Chọn thời gian</h2>
              <button class="order-date-dialog-close" type="button" data-order-date-close aria-label="Đóng">×</button>
            </header>
            <div class="order-date-dialog-body">
              <section class="order-date-section" aria-labelledby="order-date-months-title">
                <h3 id="order-date-months-title">Chọn nhanh tháng {vnToday.year}</h3>
                <div class="order-date-months">
                  {monthQuick.map((item) => (
                    <button
                      class="order-date-month"
                      type="button"
                      data-order-date-month
                      data-from={item.from}
                      data-to={item.to}
                      aria-pressed={from === item.from && to === item.to ? 'true' : 'false'}
                    >
                      Tháng {item.month}
                    </button>
                  ))}
                </div>
              </section>
              <section class="order-date-section" aria-labelledby="order-date-day-title">
                <h3 id="order-date-day-title">Một ngày</h3>
                <div class="order-date-row">
                  <label class="sr-only" for="order-date-day">Ngày</label>
                  <input id="order-date-day" class="field" type="date" data-order-date-day value={from && from === to ? from : ''} max={`${vnToday.year}-${String(vnToday.month).padStart(2, '0')}-${String(vnToday.day).padStart(2, '0')}`} />
                  <button class="btn btn-primary" type="button" data-order-date-apply-day>Áp dụng</button>
                </div>
              </section>
              <section class="order-date-section" aria-labelledby="order-date-range-title">
                <h3 id="order-date-range-title">Khoảng ngày</h3>
                <div class="order-date-row order-date-range">
                  <label class="sr-only" for="order-date-from">Từ ngày</label>
                  <input id="order-date-from" class="field" type="date" data-order-date-range-from value={from && to && from !== to ? from : ''} />
                  <span class="order-date-range-sep" aria-hidden="true">→</span>
                  <label class="sr-only" for="order-date-to">Đến ngày</label>
                  <input id="order-date-to" class="field" type="date" data-order-date-range-to value={from && to && from !== to ? to : ''} />
                  <button class="btn btn-primary" type="button" data-order-date-apply-range>Áp dụng</button>
                </div>
                <p class="order-date-error" data-order-date-error hidden>Khoảng ngày không hợp lệ.</p>
              </section>
            </div>
            <footer class="order-date-dialog-foot">
              <button class="btn" type="button" data-order-date-clear disabled={!from && !to}>Xóa lọc</button>
              <button class="btn" type="button" data-order-date-close>Đóng</button>
            </footer>
          </div>
        </dialog>
        <div data-order-results>
          <form
            id="order-bulk"
            class="bulk-bar order-bulk-bar"
            method="post"
            action={routes.adminOrdersBulk}
            aria-label="Thao tác hàng loạt"
            data-order-bulk
            data-busy
            data-confirm-title="Xóa các đơn đã chọn?"
            data-confirm="Các đơn sẽ bị xóa vĩnh viễn cùng dòng sản phẩm và không khôi phục được."
            data-confirm-ok="Xóa"
            data-confirm-tone="danger"
            hidden
          >
            <input type="hidden" name="csrf" value={session.csrfToken} />
            <input type="hidden" name="q" value={query} />
            <input type="hidden" name="status" value={status === '' ? 'all' : status} />
            <input type="hidden" name="source" value={source} />
            <input type="hidden" name="payment" value={payment} />
            <input type="hidden" name="from" value={from} />
            <input type="hidden" name="to" value={to} />
            <input type="hidden" name="page" value={String(result.page)} />
            <span class="order-bulk-count" aria-live="polite" data-bulk-count>
              <span class="order-bulk-check" aria-hidden="true">✓</span>
              <span data-bulk-count-text>0 đơn</span>
            </span>
            <button class="order-bulk-btn" type="button" data-bulk-demo="status">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20h4L18 10l-4-4L4 16v4z" /></svg>
              Trạng thái
            </button>
            <button class="order-bulk-btn is-priority" type="button" data-bulk-demo="priority">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 3 2.4 4.9 5.4.8-3.9 3.8.9 5.4L12 15.9 7.2 18l.9-5.4L4.2 8.7l5.4-.8z" /></svg>
              Ưu tiên
            </button>
            <button class="order-bulk-btn is-soft" type="button" data-bulk-demo="unpriority">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 3 2.4 4.9 5.4.8-3.9 3.8.9 5.4L12 15.9 7.2 18l.9-5.4L4.2 8.7l5.4-.8z" /></svg>
              Bỏ ưu tiên
            </button>
            <button class="order-bulk-btn is-export" type="button" data-bulk-demo="export">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v12m0 0 4-4m-4 4-4-4M5 21h14" /></svg>
              Export
            </button>
            <button class="order-bulk-btn is-invoice" type="button" data-bulk-demo="invoice">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 3h8l4 4v14H7V3zM15 3v5h5M9 12h6M9 16h6" /></svg>
              Xuất HĐ
            </button>
            {canBulkDelete ? (
              <button class="order-bulk-btn is-delete" type="submit" name="bulk" value="delete" data-bulk-delete>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 7h14M10 7V5h4v2m-6 3v8m4-8v8M7 7l1 12h8l1-12" /></svg>
                Xóa
              </button>
            ) : null}
            <button class="order-bulk-close" type="button" data-bulk-clear aria-label="Bỏ chọn">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
            </button>
            <span class="error-text order-bulk-error" role="alert" data-bulk-error hidden></span>
            <span class="order-bulk-demo" role="status" data-bulk-demo-msg hidden></span>
          </form>
          <div data-order-list>
          {result.rows.length === 0 ? (
            <p class="post-empty">Không có đơn khớp bộ lọc.</p>
          ) : (
            <table class="post-table order-table">
              <thead>
                <tr>
                  <th class="product-check order-check-col">
                    <input type="checkbox" aria-label="Chọn tất cả đơn đang hiện" data-bulk-all />
                  </th>
                  <th>Mã đơn</th>
                  <th>Khách & giao hàng</th>
                  <th>Sản phẩm</th>
                  <th>Giá trị</th>
                  <th>Lãi ròng</th>
                  <th>Ngày đặt</th>
                  <th>Thao tác</th>
                </tr>
              </thead>
              <tbody>
                {result.rows.map((order, index) => {
                  const stt = (result.page - 1) * result.pageSize + index + 1;
                  const profit = orderProfit(order);
                  const shipLater =
                    order.shipOn !== null &&
                    order.status !== 'shipped' &&
                    order.status !== 'completed' &&
                    order.status !== 'cancelled';
                  const source = sourceLabel(order.source);
                  const currentStatus = isOrderStatus(order.status) ? (order.status as OrderStatus) : null;
                  const statusChoices = currentStatus ? [currentStatus, ...nextOrderStatuses(currentStatus)] : [];
                  const tier = customerTierOf(order.customerOrderCount);
                  return (
                  <tr data-priority={order.priority === 1 ? '1' : undefined}>
                    <td class="product-check order-check-col" data-label="Chọn">
                      <div class="order-check-cell">
                        <input type="checkbox" form="order-bulk" name="ids" value={order.id} aria-label={`Chọn đơn ${order.code}`} />
                        <span class="order-stt" aria-hidden="true">{stt}</span>
                      </div>
                    </td>
                    <td data-label="Mã đơn">
                      <div class="order-code-cell">
                        <div class="order-code-row">
                          <a class="order-code-link" href={routes.adminOrder(order.id)}>{order.code}</a>
                          <button
                            class="order-icon-btn"
                            type="button"
                            data-copy-code={order.code}
                            aria-label={`Sao chép mã ${order.code}`}
                            title="Sao chép mã"
                          >
                            <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
                              <path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" d="M8 8h10v12H8zM6 16H5a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v1" />
                            </svg>
                          </button>
                        </div>
                        {statusChoices.length > 1 ? (
                          <form method="post" data-busy>
                            <input type="hidden" name="csrf" value={session.csrfToken} />
                            <input type="hidden" name="intent" value="status" />
                            <input type="hidden" name="id" value={order.id} />
                            <label class="sr-only" for={`order-status-${order.id}`}>Trạng thái đơn {order.code}</label>
                            <select
                              id={`order-status-${order.id}`}
                              class="order-status-select"
                              name="status"
                              data-status={order.status}
                              data-status-select
                            >
                              {statusChoices.map((item) => (
                                <option value={item} selected={order.status === item}>{ORDER_STATUS_LABELS[item]}</option>
                              ))}
                            </select>
                          </form>
                        ) : (
                          <span class="order-badge" data-status={order.status}>
                            {orderStatusLabel(order.status)}
                          </span>
                        )}
                        {shipLater && order.shipOn !== null && (
                          <span class="od-note">Gửi sau {formatShipLabel(order.shipOn)}</span>
                        )}
                      </div>
                    </td>
                    <td data-label="Khách & giao hàng">
                      <div class="order-customer-cell">
                        <div class="order-customer-head">
                          <span class="order-customer-name">{order.customerName}</span>
                          {source && <span class="order-chip" data-tone="source">{source}</span>}
                          <span class="order-chip" data-tone={tier}>{CUSTOMER_TIER_LABELS[tier]}</span>
                        </div>
                        <div class="order-customer-line">
                          <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
                            <path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" d="M6.5 4.5h3l1.2 3.2-1.8 1.1a12 12 0 0 0 5.3 5.3l1.1-1.8 3.2 1.2v3a1.5 1.5 0 0 1-1.5 1.5A13.5 13.5 0 0 1 5 6a1.5 1.5 0 0 1 1.5-1.5z" />
                          </svg>
                          <span>{order.phone}</span>
                        </div>
                        <div class="order-customer-line order-customer-address">
                          <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
                            <path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" d="M12 21s6-5.2 6-10a6 6 0 1 0-12 0c0 4.8 6 10 6 10z" />
                            <circle cx="12" cy="11" r="2.2" fill="none" stroke="currentColor" stroke-width="1.8" />
                          </svg>
                          <span>{order.address}</span>
                        </div>
                      </div>
                    </td>
                    <td data-label="Sản phẩm">
                      <div class="order-products-wrap">
                        <ul class="order-products">
                          {order.lines.map((line) => (
                            <li class="order-product">
                              <div class="order-product-head">
                                <span class="order-product-name">{line.productName}</span>
                                <span class="order-product-qty">×{line.quantity}</span>
                              </div>
                              <div class="order-product-meta">
                                {line.optionLabel && (
                                  <span class="order-product-chip">
                                    <span class="order-product-dot" aria-hidden="true"></span>
                                    {line.optionLabel}
                                  </span>
                                )}
                                <span class="order-product-chip">
                                  <span class="order-product-dot" data-tone="price" aria-hidden="true"></span>
                                  {formatVnd(line.unitPrice)}
                                </span>
                              </div>
                            </li>
                          ))}
                        </ul>
                        {order.note && (
                          <div class="order-line-note" data-tone="customer">
                            <p>{order.note}</p>
                          </div>
                        )}
                        {order.internalNote && (
                          <div class="order-line-note" data-tone="internal">
                            <p>{order.internalNote}</p>
                          </div>
                        )}
                        {order.status !== 'completed' && order.status !== 'cancelled' ? (
                          <div class="order-product-demos">
                            <a class="order-demo-btn" href={routes.adminOrderEdit(order.id)}>+ Thêm SP</a>
                            <a class="order-demo-btn" href={routes.adminOrderEdit(order.id)}>Ghi chú</a>
                          </div>
                        ) : null}
                      </div>
                    </td>
                    <td data-label="Giá trị">
                      <div class="order-sum">
                        <span class="order-sum-value">{formatVnd(order.totalPrice)}</span>
                        <span class="order-pay">{collectionLabel(order.payState, order.paymentMethod)}</span>
                        {order.compensation === 1 && <span class="order-pay">Gửi bù</span>}
                      </div>
                    </td>
                    <td data-label="Lãi ròng">
                      <div class="order-profit-cell">
                        {profit === null ? (
                          <span class="text-muted">—</span>
                        ) : (
                          <span class="order-profit" data-sign={profit < 0 ? 'loss' : 'gain'}>{formatVnd(profit)}</span>
                        )}
                        <a class="order-profit-link" href={routes.adminOrder(order.id)}>Chi tiết</a>
                      </div>
                    </td>
                    <td data-label="Ngày đặt">
                      <div class="order-date-cell">
                        <span class="order-date-time">{formatTimeHms(order.createdAt)}</span>
                        <span class="order-date-day">{formatDateShort(order.createdAt)}</span>
                      </div>
                    </td>
                    <td data-label="Thao tác">
                      <div class="order-row-actions">
                        {order.status !== 'completed' && order.status !== 'cancelled' ? (
                          <form method="post" data-busy>
                            <input type="hidden" name="csrf" value={session.csrfToken} />
                            <input type="hidden" name="intent" value="priority" />
                            <input type="hidden" name="id" value={order.id} />
                            <input type="hidden" name="priority" value={order.priority === 1 ? '0' : '1'} />
                            <button
                              class="order-priority-star"
                              type="submit"
                              data-on={order.priority === 1 ? 'true' : 'false'}
                              data-keep-label="true"
                              aria-label={order.priority === 1 ? `Bỏ ưu tiên đơn ${order.code}` : `Ưu tiên đơn ${order.code}`}
                              title={order.priority === 1 ? 'Bỏ ưu tiên' : 'Ưu tiên'}
                            >
                              <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
                                <path d="M12 17.27 18.18 21l-1.64-7.03L22 9.24l-7.19-.62L12 2 9.19 8.62 2 9.24l5.46 4.73L5.82 21z"></path>
                              </svg>
                            </button>
                          </form>
                        ) : (
                          <span
                            class="order-priority-star"
                            data-on={order.priority === 1 ? 'true' : 'false'}
                            aria-hidden="true"
                          >
                            <svg viewBox="0 0 24 24" width="16" height="16">
                              <path d="M12 17.27 18.18 21l-1.64-7.03L22 9.24l-7.19-.62L12 2 9.19 8.62 2 9.24l5.46 4.73L5.82 21z"></path>
                            </svg>
                          </span>
                        )}
                        <a class="order-icon-btn is-view" href={routes.adminOrder(order.id)} aria-label={`Xem đơn ${order.code}`} title="Xem">
                          <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true">
                            <path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" d="M3 12s3.5-6 9-6 9 6 9 6-3.5 6-9 6-9-6-9-6z" />
                            <circle cx="12" cy="12" r="2.2" fill="none" stroke="currentColor" stroke-width="1.8" />
                          </svg>
                        </a>
                        {order.status !== 'completed' && order.status !== 'cancelled' && (
                          <a class="order-icon-btn is-edit" href={routes.adminOrderEdit(order.id)} aria-label={`Sửa đơn ${order.code}`} title="Sửa">
                            <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true">
                              <path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" d="M4 20h4L18 10l-4-4L4 16v4zM14 6l4 4" />
                            </svg>
                          </a>
                        )}
                        {canBulkDelete ? (
                          <form
                            method="post"
                            data-busy
                            data-confirm-title={`Xóa đơn ${order.code}?`}
                            data-confirm="Đơn sẽ bị xóa vĩnh viễn cùng các dòng sản phẩm và không khôi phục được. Nếu chỉ muốn bỏ đơn, hãy đổi trạng thái sang Hủy đơn."
                            data-confirm-ok="Xóa"
                            data-confirm-tone="danger"
                          >
                            <input type="hidden" name="csrf" value={session.csrfToken} />
                            <input type="hidden" name="intent" value="delete" />
                            <input type="hidden" name="id" value={order.id} />
                            <button class="order-icon-btn is-delete" type="submit" aria-label={`Xóa đơn ${order.code}`} title="Xóa">
                              <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true">
                                <path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" d="M5 7h14M10 7V5h4v2m-6 3v8m4-8v8M7 7l1 12h8l1-12" />
                              </svg>
                            </button>
                          </form>
                        ) : null}
                      </div>
                    </td>
                  </tr>
                  );
                })}
              </tbody>
            </table>
          )}
          </div>
        </div>
        {result.pageCount > 1 && (
          <nav class="post-pager" aria-label="Phân trang">
            {result.page > 1 && <a class="btn" href={pageHref(result.page - 1)}>Trang trước</a>}
            <span>Trang {result.page}/{result.pageCount}</span>
            {result.page < result.pageCount && <a class="btn" href={pageHref(result.page + 1)}>Trang sau</a>}
          </nav>
        )}
      </>
    ) : null
  }
</AdminLayout>

<script>
  const form = document.querySelector('[data-order-search]');
  const results = document.querySelector('[data-order-results]');
  const list = document.querySelector('[data-order-list]');
  const dateDialog = document.querySelector('[data-order-date-dialog]');
  let goSearch: (() => void) | null = null;
  if (form instanceof HTMLFormElement) {
    const input = form.querySelector('input[name="q"]');
    let timer = 0;
    const go = () => {
      const data = new FormData(form);
      const read = (name: string) => {
        const value = data.get(name);
        return typeof value === 'string' ? value : '';
      };
      const params = new URLSearchParams();
      const term = read('q').trim();
      const status = read('status');
      const source = read('source');
      const payment = read('payment');
      const from = read('from');
      const to = read('to');
      if (term) params.set('q', term);
      if (status) params.set('status', status);
      if (source) params.set('source', source);
      if (payment) params.set('payment', payment);
      if (/^\d{4}-\d{2}-\d{2}$/.test(from)) params.set('from', from);
      if (/^\d{4}-\d{2}-\d{2}$/.test(to)) params.set('to', to);
      const next = params.size ? `/admin/orders?${params}` : '/admin/orders';
      if (next === `${location.pathname}${location.search}`) return;
      list?.setAttribute('aria-busy', 'true');
      location.assign(next);
    };
    goSearch = go;
    if (input instanceof HTMLInputElement) {
      input.addEventListener('input', () => {
        window.clearTimeout(timer);
        timer = window.setTimeout(go, 300);
      });
    }
    form.addEventListener('change', (event) => {
      if (event.target === input) return;
      const target = event.target;
      if (target instanceof HTMLElement && target.closest('[data-order-date-dialog]')) return;
      window.clearTimeout(timer);
      go();
    });
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      window.clearTimeout(timer);
      go();
    });
  }

  if (form instanceof HTMLFormElement && dateDialog instanceof HTMLDialogElement) {
    const openBtn = document.querySelector('[data-order-date-open]');
    const fromInput = form.querySelector<HTMLInputElement>('[data-order-from]');
    const toInput = form.querySelector<HTMLInputElement>('[data-order-to]');
    const dayInput = dateDialog.querySelector<HTMLInputElement>('[data-order-date-day]');
    const rangeFrom = dateDialog.querySelector<HTMLInputElement>('[data-order-date-range-from]');
    const rangeTo = dateDialog.querySelector<HTMLInputElement>('[data-order-date-range-to]');
    const errorEl = dateDialog.querySelector<HTMLElement>('[data-order-date-error]');
    const clearBtn = dateDialog.querySelector<HTMLButtonElement>('[data-order-date-clear]');
    const ymd = /^\d{4}-\d{2}-\d{2}$/;

    const setExpanded = (open: boolean) => {
      if (openBtn instanceof HTMLButtonElement) openBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
    };

    const showError = (on: boolean) => {
      if (!errorEl) return;
      errorEl.hidden = !on;
    };

    const applyDates = (nextFrom: string, nextTo: string) => {
      if (fromInput) fromInput.value = nextFrom;
      if (toInput) toInput.value = nextTo;
      showError(false);
      dateDialog.close();
      goSearch?.();
    };

    openBtn?.addEventListener('click', () => {
      showError(false);
      dateDialog.showModal();
      setExpanded(true);
    });

    for (const close of dateDialog.querySelectorAll('[data-order-date-close]')) {
      close.addEventListener('click', () => dateDialog.close());
    }

    dateDialog.addEventListener('click', (event) => {
      if (event.target !== dateDialog) return;
      const box = dateDialog.getBoundingClientRect();
      const inside =
        event.clientX >= box.left &&
        event.clientX <= box.right &&
        event.clientY >= box.top &&
        event.clientY <= box.bottom;
      if (!inside) dateDialog.close();
    });

    dateDialog.addEventListener('close', () => setExpanded(false));

    dateDialog.addEventListener('click', (event) => {
      const monthBtn = event.target instanceof Element ? event.target.closest('[data-order-date-month]') : null;
      if (!(monthBtn instanceof HTMLButtonElement)) return;
      const nextFrom = monthBtn.dataset.from ?? '';
      const nextTo = monthBtn.dataset.to ?? '';
      if (!ymd.test(nextFrom) || !ymd.test(nextTo)) return;
      applyDates(nextFrom, nextTo);
    });

    dateDialog.querySelector('[data-order-date-apply-day]')?.addEventListener('click', () => {
      const day = dayInput?.value ?? '';
      if (!ymd.test(day)) {
        showError(true);
        return;
      }
      applyDates(day, day);
    });

    dateDialog.querySelector('[data-order-date-apply-range]')?.addEventListener('click', () => {
      const start = rangeFrom?.value ?? '';
      const end = rangeTo?.value ?? '';
      if (!ymd.test(start) || !ymd.test(end) || end < start) {
        showError(true);
        return;
      }
      applyDates(start, end);
    });

    clearBtn?.addEventListener('click', () => applyDates('', ''));
  }

  if (results instanceof HTMLElement) {
    const root = results;
    const bar = root.querySelector('[data-order-bulk]');
    const all = root.querySelector('[data-bulk-all]');
    const countText = bar?.querySelector('[data-bulk-count-text]');
    const demoMsg = bar?.querySelector('[data-bulk-demo-msg]');
    const error = bar?.querySelector('[data-bulk-error]');
    const demoLabels: Record<string, string> = {
      status: 'Đổi trạng thái hàng loạt sắp có.',
      priority: 'Gắn ưu tiên hàng loạt sắp có.',
      unpriority: 'Bỏ ưu tiên hàng loạt sắp có.',
      export: 'Export đơn hàng sắp có.',
      invoice: 'Xuất hóa đơn hàng loạt sắp có.',
    };

    root.addEventListener('change', (event) => {
      const target = event.target;
      if (!(target instanceof HTMLSelectElement) || !target.hasAttribute('data-status-select')) return;
      const form = target.closest('form');
      if (!(form instanceof HTMLFormElement)) return;
      if (target.value === 'cancelled' && !confirm('Hủy đơn này? Đơn vẫn được giữ trong lịch sử.')) {
        target.value = target.dataset.status ?? target.value;
        return;
      }
      form.requestSubmit();
    });

    function boxes(): HTMLInputElement[] {
      return [...root.querySelectorAll<HTMLInputElement>('input[name="ids"]')];
    }

    function selected(): HTMLInputElement[] {
      return boxes().filter((box) => box.checked);
    }

    function paint() {
      if (!(bar instanceof HTMLFormElement) || !(countText instanceof HTMLElement)) return;
      const picked = selected();
      const total = boxes().length;
      countText.textContent = `${picked.length} đơn`;
      bar.hidden = picked.length === 0;
      if (all instanceof HTMLInputElement) {
        all.checked = total > 0 && picked.length === total;
        all.indeterminate = picked.length > 0 && picked.length < total;
      }
      if (demoMsg instanceof HTMLElement) demoMsg.hidden = true;
      if (error instanceof HTMLElement) error.hidden = true;
    }

    function pick(on: boolean) {
      for (const box of boxes()) box.checked = on;
      paint();
    }

    root.addEventListener('change', (event) => {
      const target = event.target;
      if (!(target instanceof HTMLInputElement)) return;
      if (target.hasAttribute('data-bulk-all')) return pick(target.checked);
      if (target.name === 'ids') paint();
    });

    root.addEventListener('click', (event) => {
      const target = event.target instanceof Element ? event.target.closest('button') : null;
      if (!(target instanceof HTMLButtonElement)) return;
      if (target.hasAttribute('data-bulk-clear')) {
        pick(false);
        return;
      }
      const code = target.dataset.copyCode;
      if (code) {
        void navigator.clipboard.writeText(code).then(
          () => {
            target.dataset.copied = '1';
            window.setTimeout(() => {
              delete target.dataset.copied;
            }, 1200);
          },
          () => undefined,
        );
        return;
      }
      const demo = target.dataset.bulkDemo;
      if (demo && demoMsg instanceof HTMLElement) {
        demoMsg.hidden = false;
        demoMsg.textContent = demoLabels[demo] ?? 'Chức năng sắp có.';
        return;
      }
      if (target.hasAttribute('data-bulk-delete') && bar instanceof HTMLFormElement) {
        const n = selected().length;
        bar.dataset.confirmTitle = `Xóa ${n} đơn đã chọn?`;
        bar.dataset.confirm = `${n} đơn sẽ bị xóa vĩnh viễn cùng dòng sản phẩm và không khôi phục được.`;
        bar.dataset.confirmOk = `Xóa ${n} đơn`;
      }
    });

    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape' || document.querySelector('dialog[open]')) return;
      if (selected().length > 0) pick(false);
    });

    paint();
  }
</script>
