---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { activityActor } from '../../../features/activity/log';
import { mutationError } from '../../../features/auth/session';
import { orderCreatedRange } from '../../../features/orders/order';
import OrderListPanel from '../../../components/admin/OrderListPanel.astro';
import { deleteOrder, listOrders, orderAdminQuery, orderListPayment, orderListSource, orderListStatus, orderPanelQuery, pendingUnshippedSummary, updateOrderFulfillStatus, updateOrderPriority } from '../../../features/orders/orders';
import { ORDER_PAYMENT_FILTERS } from '../../../features/orders/payment';
import { ORDER_SOURCES } from '../../../features/orders/staff';
import { isFulfillStatus, ORDER_LIST_FILTERS } from '../../../features/orders/status';
import { createDb } from '../../../lib/db/client';
import { getDbBinding } from '../../../lib/cloudflare/env';
import { formatOrderDateFilterLabel, vnLastNDaysRange, vnMonthRange, vnTodayParts, vnYesterdayRange } from '../../../lib/datetime';
import { formatVnd } from '../../../lib/money';
import { routes } from '../../../lib/routes';

const session = Astro.locals.adminSession;
if (!session) return Astro.redirect(routes.adminLogin);

const query = Astro.url.searchParams.get('q') ?? '';
const status = orderListStatus(Astro.url.searchParams.get('status'));
const source = orderListSource(Astro.url.searchParams.get('source'));
const payment = orderListPayment(Astro.url.searchParams.get('payment'));
const from = Astro.url.searchParams.get('from') ?? '';
const to = Astro.url.searchParams.get('to') ?? '';
const page = Number(Astro.url.searchParams.get('page') ?? '1');
const range = orderCreatedRange(from, to);
const vnToday = vnTodayParts();
const monthQuick = Array.from({ length: vnToday.month }, (_, index) => {
  const month = index + 1;
  const span = vnMonthRange(vnToday.year, month)!;
  return { month, from: span.from, to: span.to };
});
const yesterdayQuick = vnYesterdayRange();
const last7Quick = vnLastNDaysRange(7)!;
const last30Quick = vnLastNDaysRange(30)!;
const dateQuick = [
  { label: 'Hôm qua', from: yesterdayQuick.from, to: yesterdayQuick.to },
  { label: '7 ngày qua', from: last7Quick.from, to: last7Quick.to },
  { label: '30 ngày qua', from: last30Quick.from, to: last30Quick.to },
];
const dateFilterLabel = formatOrderDateFilterLabel(from, to);
let loadError = range.invalid ? 'Khoảng ngày không hợp lệ.' : '';
const notice = Astro.url.searchParams.get('notice');
const bulkCount = Math.max(0, Number(Astro.url.searchParams.get('n')) || 0);
const canBulkDelete = session.role === 'admin';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const blocked = mutationError(Astro.request, session, form);
  const id = Number(form.get('id'));
  const intent = form.get('intent');
  if (blocked) {
    Astro.response.status = 403;
    loadError = blocked;
  } else if (!Number.isInteger(id) || id < 1) {
    Astro.response.status = 422;
    loadError = 'Thao tác không hợp lệ.';
  } else if (intent === 'priority') {
    const on = form.get('priority') === '1';
    const db = createDb(getDbBinding());
    const result = await updateOrderPriority(db, id, on);
    return Astro.redirect(
      orderAdminQuery({
        query,
        status,
        source,
        payment,
        from,
        to,
        page: Number.isInteger(page) ? page : 1,
        notice: result.ok ? (on ? 'priority-on' : 'priority-off') : 'priority-error',
      }),
      303,
    );
  } else if (intent === 'fulfill') {
    const next = form.get('fulfill');
    if (typeof next !== 'string' || !isFulfillStatus(next)) {
      Astro.response.status = 422;
      loadError = 'Trạng thái giao không hợp lệ.';
    } else {
      const db = createDb(getDbBinding());
      const result = await updateOrderFulfillStatus(db, id, next);
      return Astro.redirect(
        orderAdminQuery({
          query,
          status,
          source,
          payment,
          from,
          to,
          page: Number.isInteger(page) ? page : 1,
          notice: result.ok ? 'status' : 'status-error',
        }),
        303,
      );
    }
  } else if (intent === 'delete') {
    if (session.role !== 'admin') {
      return new Response('Bạn không có quyền xóa đơn hàng.', { status: 403, headers: { 'content-type': 'text/plain; charset=utf-8' } });
    }
    const db = createDb(getDbBinding());
    const removed = await deleteOrder(db, id, await activityActor(db, session.userId));
    return Astro.redirect(
      orderAdminQuery({
        query,
        status,
        source,
        payment,
        from,
        to,
        page: Number.isInteger(page) ? page : 1,
        notice: removed.ok ? 'deleted' : 'missing',
      }),
      303,
    );
  } else {
    Astro.response.status = 422;
    loadError = 'Thao tác không hợp lệ.';
  }
}
const db = createDb(getDbBinding());
let result: Awaited<ReturnType<typeof listOrders>> | null = null;
let pendingSummary = { revenue: 0, orderCount: 0 };
try {
  pendingSummary = await pendingUnshippedSummary(db);
} catch (error) {
  console.error(JSON.stringify({ event: 'order_pending_summary_failed', name: error instanceof Error ? error.name : 'unknown' }));
}
if (!range.invalid) {
  try {
    result = await listOrders(db, {
      query,
      status,
      source,
      payment,
      start: range.start,
      end: range.end,
      page: Number.isInteger(page) ? page : 1,
    });
  } catch (error) {
    console.error(JSON.stringify({ event: 'order_list_failed', name: error instanceof Error ? error.name : 'unknown' }));
    loadError = 'Không tải được danh sách đơn.';
  }
}

function pageHref(nextPage: number): string {
  return orderAdminQuery({ query, status, source, payment, from, to, page: nextPage });
}

const listFilters = { query, status, source, payment, from, to };
const nextPanelHref =
  result && result.page < result.pageCount
    ? orderPanelQuery({ ...listFilters, page: result.page + 1 })
    : '';
const shippedPanelHref =
  status === 'shipped' ? '' : orderPanelQuery({ ...listFilters, status: 'shipped', page: 1 });
---

<AdminLayout title="Quản lý đơn hàng">
  <div slot="action" class="order-page-actions">
    <div class="order-pending-revenue" title="Tổng tiền các đơn chưa gửi hàng và chờ gửi lại">
      <span class="order-pending-revenue-icon" aria-hidden="true">đ</span>
      <span class="order-pending-revenue-label">Doanh thu chưa gửi:</span>
      <span class="order-pending-revenue-value">
        {formatVnd(pendingSummary.revenue)}
        <span class="order-pending-revenue-sep">/</span>
        {pendingSummary.orderCount} đơn
      </span>
    </div>
    <button
      class="btn order-export-history-btn"
      type="button"
      data-order-export-history-open
      aria-haspopup="dialog"
      aria-controls="order-export-dialog"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 3h8l4 4v14H7V3zM15 3v5h5M9 12h6M9 16h4" /></svg>
      Lịch sử Export
    </button>
    <a class="btn btn-primary" href={routes.adminOrderNew}>Thêm đơn hàng</a>
  </div>
  <p slot="lead" data-order-lead>{result ? `${result.total} đơn hàng` : 'Danh sách đơn hàng'}</p>
  {loadError && <p class="error-text mb-4" role="alert">{loadError}</p>}
  {notice === 'deleted' && <p class="mb-4 text-primary-strong" role="status">Đã xóa đơn hàng.</p>}
  {notice === 'bulk-deleted' && (
    <p class="mb-4 text-primary-strong" role="status">
      {bulkCount > 0 ? `Đã xóa ${bulkCount} đơn hàng.` : 'Không có đơn nào được xóa.'}
    </p>
  )}
  {notice === 'priority-on' && <p class="mb-4 text-primary-strong" role="status">Đã gắn ưu tiên.</p>}
  {notice === 'priority-off' && <p class="mb-4 text-primary-strong" role="status">Đã bỏ ưu tiên.</p>}
  {notice === 'status' && <p class="mb-4 text-primary-strong" role="status">Đã cập nhật trạng thái.</p>}
  {notice === 'missing' && <p class="error-text mb-4" role="alert">Không tìm thấy đơn hàng cần xóa.</p>}
  {notice === 'bulk-error' && <p class="error-text mb-4" role="alert">Không thực hiện được thao tác hàng loạt. Thử lại.</p>}
  {notice === 'priority-error' && <p class="error-text mb-4" role="alert">Không đổi được ưu tiên. Đơn có thể đã kết thúc.</p>}
  {notice === 'status-error' && <p class="error-text mb-4" role="alert">Không đổi được trạng thái. Kiểm tra bước chuyển hợp lệ.</p>}
  {
    result && result.libraryTotal === 0 && !query && !source && !payment && !from && !to && (status === '' || status === 'unshipped') ? (
      <section class="cms-empty">
        <span class="cms-empty-icon" aria-hidden="true">
          <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M7 4.5h10v15H7z" />
            <path d="M10 8h4M10 11.5h4M10 15h2.5" />
          </svg>
        </span>
        <h2 class="cms-empty-title">Chưa có đơn hàng nào</h2>
        <p class="cms-empty-text">Đơn hàng sẽ hiện ở đây ngay khi khách gửi thông tin đặt mua trên website. Xưởng gọi lại để chốt, website không thu tiền trực tuyến.</p>
        <ul class="cms-empty-points">
          <li>Mỗi đơn gồm sản phẩm, lựa chọn, số lượng và thông tin liên hệ khách.</li>
          <li>Theo dõi trạng thái: mới, xác nhận, đang chuẩn bị, đã gửi, hoàn thành.</li>
          <li>Đơn từ trang đích quảng cáo được gắn nguồn để đo chuyển đổi.</li>
        </ul>
        <a class="btn btn-primary" href={routes.adminOrderNew}>Thêm đơn hàng đầu tiên</a>
      </section>
    ) : result ? (
      <>
        <form class="post-toolbar product-toolbar order-toolbar" method="get" data-order-search>
          <label class="sr-only" for="order-query">Tìm đơn</label>
          <input id="order-query" class="field" name="q" value={query} placeholder="Mã, tên hoặc số điện thoại" maxlength="80" />
          <label class="sr-only" for="order-status">Trạng thái</label>
          <select id="order-status" class="field" name="status">
            <option value="all" selected={status === ''}>Tất cả trạng thái</option>
            {ORDER_LIST_FILTERS.map((item) => (
              <option value={item.value} selected={status === item.value}>{item.label}</option>
            ))}
          </select>
          <label class="sr-only" for="order-source">Nguồn khách</label>
          <select id="order-source" class="field" name="source">
            <option value="" selected={source === ''}>Tất cả nguồn</option>
            {ORDER_SOURCES.map((item) => (
              <option value={item.value} selected={source === item.value}>{item.label}</option>
            ))}
          </select>
          <label class="sr-only" for="order-payment">Thanh toán</label>
          <select id="order-payment" class="field" name="payment">
            <option value="" selected={payment === ''}>Tất cả thanh toán</option>
            {ORDER_PAYMENT_FILTERS.map((item) => (
              <option value={item.value} selected={payment === item.value}>{item.label}</option>
            ))}
          </select>
          <input type="hidden" name="from" value={from} data-order-from />
          <input type="hidden" name="to" value={to} data-order-to />
          <button
            class="field order-date-trigger"
            type="button"
            data-order-date-open
            aria-haspopup="dialog"
            aria-expanded="false"
            aria-controls="order-date-dialog"
            data-active={from || to ? 'true' : undefined}
          >
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 3v2M17 3v2M4 8h16M6 5h12a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2z" /></svg>
            <span data-order-date-label>{dateFilterLabel}</span>
          </button>
        </form>
        <dialog id="order-date-dialog" class="order-date-dialog" aria-labelledby="order-date-dialog-title" data-order-date-dialog>
          <div class="order-date-dialog-card">
            <header class="order-date-dialog-head">
              <h2 id="order-date-dialog-title">Chọn thời gian</h2>
              <button class="order-date-dialog-close" type="button" data-order-date-close aria-label="Đóng">×</button>
            </header>
            <div class="order-date-dialog-body">
              <section class="order-date-section" aria-labelledby="order-date-quick-title">
                <h3 id="order-date-quick-title">Chọn nhanh</h3>
                <div class="order-date-months order-date-quicks">
                  {dateQuick.map((item) => (
                    <button
                      class="order-date-month"
                      type="button"
                      data-order-date-month
                      data-from={item.from}
                      data-to={item.to}
                      aria-pressed={from === item.from && to === item.to ? 'true' : 'false'}
                    >
                      {item.label}
                    </button>
                  ))}
                </div>
              </section>
              <section class="order-date-section" aria-labelledby="order-date-months-title">
                <h3 id="order-date-months-title">Chọn nhanh tháng {vnToday.year}</h3>
                <div class="order-date-months">
                  {monthQuick.map((item) => (
                    <button
                      class="order-date-month"
                      type="button"
                      data-order-date-month
                      data-from={item.from}
                      data-to={item.to}
                      aria-pressed={from === item.from && to === item.to ? 'true' : 'false'}
                    >
                      Tháng {item.month}
                    </button>
                  ))}
                </div>
              </section>
              <section class="order-date-section" aria-labelledby="order-date-day-title">
                <h3 id="order-date-day-title">Một ngày</h3>
                <div class="order-date-row">
                  <label class="sr-only" for="order-date-day">Ngày</label>
                  <input id="order-date-day" class="field" type="date" data-order-date-day value={from && from === to ? from : ''} max={`${vnToday.year}-${String(vnToday.month).padStart(2, '0')}-${String(vnToday.day).padStart(2, '0')}`} />
                  <button class="btn btn-primary" type="button" data-order-date-apply-day>Áp dụng</button>
                </div>
              </section>
              <section class="order-date-section" aria-labelledby="order-date-range-title">
                <h3 id="order-date-range-title">Khoảng ngày</h3>
                <div class="order-date-row order-date-range">
                  <label class="sr-only" for="order-date-from">Từ ngày</label>
                  <input id="order-date-from" class="field" type="date" data-order-date-range-from value={from && to && from !== to ? from : ''} />
                  <span class="order-date-range-sep" aria-hidden="true">→</span>
                  <label class="sr-only" for="order-date-to">Đến ngày</label>
                  <input id="order-date-to" class="field" type="date" data-order-date-range-to value={from && to && from !== to ? to : ''} />
                  <button class="btn btn-primary" type="button" data-order-date-apply-range>Áp dụng</button>
                </div>
                <p class="order-date-error" data-order-date-error hidden>Khoảng ngày không hợp lệ.</p>
              </section>
            </div>
            <footer class="order-date-dialog-foot">
              <button class="btn" type="button" data-order-date-clear disabled={!from && !to}>Xóa lọc</button>
              <button class="btn" type="button" data-order-date-close>Đóng</button>
            </footer>
          </div>
        </dialog>
        <div data-order-board>
          <OrderListPanel
            result={result}
            csrfToken={session.csrfToken}
            canBulkDelete={canBulkDelete}
            query={query}
            status={status}
            source={source}
            payment={payment}
            from={from}
            to={to}
            pageHref={pageHref}
            nextPanelHref={nextPanelHref}
            shippedPanelHref={shippedPanelHref}
          />
        </div>
      </>
    ) : null
  }
  <dialog id="order-export-dialog" class="order-export-dialog" aria-labelledby="order-export-dialog-title" data-order-export-dialog data-csrf={session.csrfToken}>
    <div class="order-export-dialog-card">
      <header class="order-export-dialog-head">
        <div class="order-export-dialog-title-wrap">
          <span class="order-export-dialog-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M7 3h8l4 4v14H7V3zM15 3v5h5M9 12h6M9 16h4" /></svg>
          </span>
          <div>
            <h2 id="order-export-dialog-title">Lịch sử Export</h2>
            <p>Quản lý các file Excel đã export</p>
          </div>
        </div>
        <button class="order-export-dialog-close" type="button" data-order-export-close aria-label="Đóng">×</button>
      </header>
      <div class="order-export-dialog-toolbar">
        <label class="order-export-select-all">
          <input type="checkbox" data-order-export-select-all />
          <span>Chọn tất cả</span>
        </label>
        <button class="btn" type="button" data-order-export-delete-selected hidden>Xóa đã chọn</button>
      </div>
      <div class="order-export-list" data-order-export-list>
        <p class="order-export-empty" data-order-export-empty>Chưa có file export.</p>
      </div>
      <p class="order-export-status" data-order-export-status hidden role="status"></p>
      <div class="order-export-skipped" data-order-export-skipped hidden>
        <h3 data-order-export-skipped-title>Đơn bị bỏ qua</h3>
        <ul data-order-export-skipped-list></ul>
      </div>
    </div>
  </dialog>
</AdminLayout>

<script>
  const PANEL = '/admin/orders/panel';
  const LIST = '/admin/orders';
  const EXPORTS = '/admin/orders/exports';
  const BULK = '/admin/orders/bulk';
  const CACHE_MAX = 3;
  const form = document.querySelector('[data-order-search]');
  const board = document.querySelector('[data-order-board]');
  const dateDialog = document.querySelector('[data-order-date-dialog]');
  const lead = document.querySelector('[data-order-lead]');
  const cache = new Map<string, string>();
  const inflight = new Map<string, Promise<string>>();
  let navSeq = 0;

  function pageUrl(params: URLSearchParams): string {
    const text = params.toString();
    return text ? `${LIST}?${text}` : LIST;
  }

  function panelUrl(params: URLSearchParams): string {
    const text = params.toString();
    return text ? `${PANEL}?${text}` : PANEL;
  }

  function formParams(): URLSearchParams {
    const params = new URLSearchParams();
    if (!(form instanceof HTMLFormElement)) return params;
    const data = new FormData(form);
    const read = (name: string) => {
      const value = data.get(name);
      return typeof value === 'string' ? value : '';
    };
    const term = read('q').trim();
    const status = read('status');
    const source = read('source');
    const payment = read('payment');
    const from = read('from');
    const to = read('to');
    if (term) params.set('q', term);
    if (status) params.set('status', status);
    if (source) params.set('source', source);
    if (payment) params.set('payment', payment);
    if (/^\d{4}-\d{2}-\d{2}$/.test(from)) params.set('from', from);
    if (/^\d{4}-\d{2}-\d{2}$/.test(to)) params.set('to', to);
    return params;
  }

  function remember(key: string, html: string) {
    if (cache.has(key)) cache.delete(key);
    cache.set(key, html);
    while (cache.size > CACHE_MAX) {
      const first = cache.keys().next().value;
      if (first === undefined) break;
      cache.delete(first);
    }
  }

  async function loadPanel(url: string): Promise<string> {
    const hit = cache.get(url);
    if (hit) {
      cache.delete(url);
      cache.set(url, hit);
      return hit;
    }
    const pending = inflight.get(url);
    if (pending) return pending;
    const request = fetch(url, {
      credentials: 'same-origin',
      headers: { accept: 'text/html' },
      priority: 'low',
    } as RequestInit)
      .then(async (response) => {
        if (!response.ok) throw new Error(`panel ${response.status}`);
        const html = await response.text();
        remember(url, html);
        return html;
      })
      .finally(() => {
        inflight.delete(url);
      });
    inflight.set(url, request);
    return request;
  }

  function prefetch(url: string) {
    if (!url || cache.has(url) || inflight.has(url)) return;
    void loadPanel(url).catch(() => undefined);
  }

  function schedulePrefetch() {
    const panel = board?.querySelector('[data-order-panel]');
    if (!(panel instanceof HTMLElement)) return;
    const next = panel.dataset.nextPanel ?? '';
    const shipped = panel.dataset.shippedPanel ?? '';
    const run = () => {
      prefetch(next);
      prefetch(shipped);
    };
    const idle = (window as Window & { requestIdleCallback?: (cb: () => void, opts?: { timeout: number }) => number })
      .requestIdleCallback;
    if (typeof idle === 'function') idle(run, { timeout: 1500 });
    else window.setTimeout(run, 200);
  }

  function syncToolbar(params: URLSearchParams) {
    if (!(form instanceof HTMLFormElement)) return;
    const q = form.querySelector('input[name="q"]');
    const status = form.querySelector('select[name="status"]');
    const source = form.querySelector('select[name="source"]');
    const payment = form.querySelector('select[name="payment"]');
    const from = form.querySelector('[data-order-from]');
    const to = form.querySelector('[data-order-to]');
    const label = form.querySelector('[data-order-date-label]');
    const trigger = form.querySelector('[data-order-date-open]');
    if (q instanceof HTMLInputElement) q.value = params.get('q') ?? '';
    if (status instanceof HTMLSelectElement) status.value = params.get('status') ?? 'unshipped';
    if (source instanceof HTMLSelectElement) source.value = params.get('source') ?? '';
    if (payment instanceof HTMLSelectElement) payment.value = params.get('payment') ?? '';
    const fromVal = params.get('from') ?? '';
    const toVal = params.get('to') ?? '';
    if (from instanceof HTMLInputElement) from.value = fromVal;
    if (to instanceof HTMLInputElement) to.value = toVal;
    if (trigger instanceof HTMLElement) {
      if (fromVal || toVal) trigger.dataset.active = 'true';
      else delete trigger.dataset.active;
    }
    if (label instanceof HTMLElement) {
      if (!fromVal && !toVal) label.textContent = 'Chọn ngày';
      else if (fromVal && toVal) {
        const vnToday = new Intl.DateTimeFormat('en-CA', { timeZone: 'Asia/Ho_Chi_Minh', year: 'numeric', month: '2-digit', day: '2-digit' }).format(new Date());
        const shift = (ymd: string, days: number) => {
          const [y, m, d] = ymd.split('-').map(Number);
          const utc = Date.UTC(y, m - 1, d + days);
          const dt = new Date(utc);
          return `${dt.getUTCFullYear()}-${String(dt.getUTCMonth() + 1).padStart(2, '0')}-${String(dt.getUTCDate()).padStart(2, '0')}`;
        };
        const yesterday = shift(vnToday, -1);
        if (fromVal === yesterday && toVal === yesterday) label.textContent = 'Hôm qua';
        else if (fromVal === shift(vnToday, -6) && toVal === vnToday) label.textContent = '7 ngày qua';
        else if (fromVal === shift(vnToday, -29) && toVal === vnToday) label.textContent = '30 ngày qua';
        else if (fromVal === toVal) {
          const parts = fromVal.split('-');
          label.textContent = `${parts[2]}/${parts[1]}`;
        } else {
          const a = fromVal.split('-');
          const b = toVal.split('-');
          label.textContent = a[1] === b[1] ? `${a[2]}–${b[2]}/${b[1]}` : `${a[2]}/${a[1]}–${b[2]}/${b[1]}`;
        }
      } else label.textContent = 'Chọn ngày';
    }
  }

  let goSearch: (() => void) | null = null;
  let restoreSelection: (() => void) | null = null;
  let clearSelection: (() => void) | null = null;

  async function softNavigate(listHref: string, opts: { push: boolean; params?: URLSearchParams }) {
    if (!(board instanceof HTMLElement)) {
      location.assign(listHref);
      return;
    }
    const params = opts.params ?? new URL(listHref, location.origin).searchParams;
    const targetPanel = panelUrl(params);
    const seq = ++navSeq;
    board.setAttribute('aria-busy', 'true');
    try {
      const html = await loadPanel(targetPanel);
      if (seq !== navSeq) return;
      const doc = new DOMParser().parseFromString(html, 'text/html');
      const nextPanel = doc.querySelector('[data-order-panel]');
      if (!(nextPanel instanceof HTMLElement)) throw new Error('panel missing');
      board.replaceChildren(nextPanel);
      if (lead instanceof HTMLElement) lead.textContent = nextPanel.dataset.lead ?? lead.textContent;
      syncToolbar(params);
      if (opts.push) history.pushState({ orderSoft: true }, '', listHref);
      schedulePrefetch();
      restoreSelection?.();
    } catch {
      location.assign(listHref);
    } finally {
      if (seq === navSeq) board.removeAttribute('aria-busy');
    }
  }
  if (form instanceof HTMLFormElement) {
    const input = form.querySelector('input[name="q"]');
    let timer = 0;
    const go = () => {
      const params = formParams();
      // Đổi lọc → về trang 1
      params.delete('page');
      const next = pageUrl(params);
      if (next === `${location.pathname}${location.search}`) return;
      cache.clear();
      clearSelection?.();
      void softNavigate(next, { push: true, params });
    };
    goSearch = go;
    if (input instanceof HTMLInputElement) {
      input.addEventListener('input', () => {
        window.clearTimeout(timer);
        timer = window.setTimeout(go, 300);
      });
    }
    form.addEventListener('change', (event) => {
      if (event.target === input) return;
      const target = event.target;
      if (target instanceof HTMLElement && target.closest('[data-order-date-dialog]')) return;
      window.clearTimeout(timer);
      go();
    });
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      window.clearTimeout(timer);
      go();
    });

    const statusSelect = form.querySelector('select[name="status"]');
    statusSelect?.addEventListener('pointerenter', () => {
      const panel = board?.querySelector('[data-order-panel]');
      if (panel instanceof HTMLElement) prefetch(panel.dataset.shippedPanel ?? '');
    });
  }

  if (form instanceof HTMLFormElement && dateDialog instanceof HTMLDialogElement) {
    const openBtn = document.querySelector('[data-order-date-open]');
    const fromInput = form.querySelector<HTMLInputElement>('[data-order-from]');
    const toInput = form.querySelector<HTMLInputElement>('[data-order-to]');
    const dayInput = dateDialog.querySelector<HTMLInputElement>('[data-order-date-day]');
    const rangeFrom = dateDialog.querySelector<HTMLInputElement>('[data-order-date-range-from]');
    const rangeTo = dateDialog.querySelector<HTMLInputElement>('[data-order-date-range-to]');
    const errorEl = dateDialog.querySelector<HTMLElement>('[data-order-date-error]');
    const clearBtn = dateDialog.querySelector<HTMLButtonElement>('[data-order-date-clear]');
    const ymd = /^\d{4}-\d{2}-\d{2}$/;

    const setExpanded = (open: boolean) => {
      if (openBtn instanceof HTMLButtonElement) openBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
    };
    const showError = (on: boolean) => {
      if (!errorEl) return;
      errorEl.hidden = !on;
    };
    const applyDates = (nextFrom: string, nextTo: string) => {
      if (fromInput) fromInput.value = nextFrom;
      if (toInput) toInput.value = nextTo;
      showError(false);
      dateDialog.close();
      goSearch?.();
    };

    openBtn?.addEventListener('click', () => {
      showError(false);
      dateDialog.showModal();
      setExpanded(true);
    });
    for (const close of dateDialog.querySelectorAll('[data-order-date-close]')) {
      close.addEventListener('click', () => dateDialog.close());
    }
    dateDialog.addEventListener('click', (event) => {
      if (event.target !== dateDialog) return;
      const box = dateDialog.getBoundingClientRect();
      const inside =
        event.clientX >= box.left &&
        event.clientX <= box.right &&
        event.clientY >= box.top &&
        event.clientY <= box.bottom;
      if (!inside) dateDialog.close();
    });
    dateDialog.addEventListener('close', () => setExpanded(false));
    dateDialog.addEventListener('click', (event) => {
      const monthBtn = event.target instanceof Element ? event.target.closest('[data-order-date-month]') : null;
      if (!(monthBtn instanceof HTMLButtonElement)) return;
      const nextFrom = monthBtn.dataset.from ?? '';
      const nextTo = monthBtn.dataset.to ?? '';
      if (!ymd.test(nextFrom) || !ymd.test(nextTo)) return;
      applyDates(nextFrom, nextTo);
    });
    dateDialog.querySelector('[data-order-date-apply-day]')?.addEventListener('click', () => {
      const day = dayInput?.value ?? '';
      if (!ymd.test(day)) {
        showError(true);
        return;
      }
      applyDates(day, day);
    });
    dateDialog.querySelector('[data-order-date-apply-range]')?.addEventListener('click', () => {
      const start = rangeFrom?.value ?? '';
      const end = rangeTo?.value ?? '';
      if (!ymd.test(start) || !ymd.test(end) || end < start) {
        showError(true);
        return;
      }
      applyDates(start, end);
    });
    clearBtn?.addEventListener('click', () => applyDates('', ''));
  }

  const exportDialog = document.querySelector('[data-order-export-dialog]');
  const exportList = document.querySelector('[data-order-export-list]');
  const exportStatus = document.querySelector('[data-order-export-status]');
  const exportEmpty = document.querySelector('[data-order-export-empty]');
  const exportSelectAll = document.querySelector('[data-order-export-select-all]');
  const exportDeleteSelected = document.querySelector('[data-order-export-delete-selected]');
  const exportCsrf =
    exportDialog instanceof HTMLElement ? (exportDialog.dataset.csrf ?? '') : '';

  function setExportStatus(text: string, tone: 'ok' | 'err' | 'info' = 'info') {
    if (!(exportStatus instanceof HTMLElement)) return;
    exportStatus.hidden = !text;
    exportStatus.textContent = text;
    exportStatus.dataset.tone = tone;
  }

  function setExportSkipped(items: { orderId: number; code: string; reason: string }[]) {
    const box = document.querySelector('[data-order-export-skipped]');
    const title = document.querySelector('[data-order-export-skipped-title]');
    const list = document.querySelector('[data-order-export-skipped-list]');
    if (!(box instanceof HTMLElement) || !(list instanceof HTMLElement)) return;
    list.replaceChildren();
    if (items.length === 0) {
      box.hidden = true;
      return;
    }
    box.hidden = false;
    if (title instanceof HTMLElement) title.textContent = `Đơn bị bỏ qua (${items.length})`;
    for (const item of items) {
      const li = document.createElement('li');
      const link = document.createElement('a');
      link.href = `/admin/orders/${item.orderId}`;
      link.textContent = item.code;
      const reason = document.createElement('span');
      reason.textContent = ` — ${item.reason}`;
      li.append(link, reason);
      list.append(li);
    }
  }

  function syncExportDeleteBtn() {
    if (!(exportDeleteSelected instanceof HTMLButtonElement) || !(exportList instanceof HTMLElement)) return;
    const n = exportList.querySelectorAll<HTMLInputElement>('input[data-order-export-id]:checked').length;
    exportDeleteSelected.hidden = n === 0;
    exportDeleteSelected.textContent = n > 0 ? `Xóa đã chọn (${n})` : 'Xóa đã chọn';
  }

  function renderExportItems(
    items: {
      id: number;
      filename: string;
      orderCount: number;
      downloaded: boolean;
      createdLabel: string;
    }[],
  ) {
    if (!(exportList instanceof HTMLElement)) return;
    for (const node of exportList.querySelectorAll('[data-order-export-row]')) node.remove();
    if (exportEmpty instanceof HTMLElement) exportEmpty.hidden = items.length > 0;
    if (exportSelectAll instanceof HTMLInputElement) {
      exportSelectAll.checked = false;
      exportSelectAll.indeterminate = false;
    }
    for (const item of items) {
      const row = document.createElement('article');
      row.className = 'order-export-row';
      row.dataset.orderExportRow = '1';
      row.innerHTML = `
        <label class="order-export-check">
          <input type="checkbox" data-order-export-id value="${item.id}" />
          <span class="sr-only">Chọn ${item.filename}</span>
        </label>
        <span class="order-export-file-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24"><path d="M7 3h8l4 4v14H7V3zM15 3v5h5M9 12h6M9 16h4" /></svg>
        </span>
        <div class="order-export-meta">
          <div class="order-export-name-row">
            <strong class="order-export-name">${item.filename}</strong>
            ${item.downloaded ? '<span class="order-export-badge">Đã tải</span>' : ''}
          </div>
          <div class="order-export-sub">
            <span>${item.createdLabel}</span>
            <span>${item.orderCount} đơn</span>
          </div>
        </div>
        <div class="order-export-actions">
          <button class="btn btn-primary order-export-download" type="button" data-order-export-download="${item.id}">Tải xuống</button>
          <button class="order-export-delete" type="button" data-order-export-delete="${item.id}" aria-label="Xóa file">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 7h14M10 7V5h4v2m-6 3v8m4-8v8M7 7l1 12h8l1-12" /></svg>
          </button>
        </div>
      `;
      exportList.append(row);
    }
    syncExportDeleteBtn();
  }

  async function refreshExportHistory() {
    setExportStatus('Đang tải lịch sử…');
    try {
      const response = await fetch(EXPORTS, { credentials: 'same-origin', headers: { accept: 'application/json' } });
      if (!response.ok) throw new Error('list failed');
      const data = (await response.json()) as {
        ok?: boolean;
        items?: { id: number; filename: string; orderCount: number; downloaded: boolean; createdLabel: string }[];
      };
      renderExportItems(data.items ?? []);
      setExportStatus('');
    } catch {
      setExportStatus('Không tải được lịch sử export.', 'err');
    }
  }

  async function openExportHistory(opts?: { keepSkipped?: boolean }) {
    if (!(exportDialog instanceof HTMLDialogElement)) return;
    if (!opts?.keepSkipped) setExportSkipped([]);
    exportDialog.showModal();
    await refreshExportHistory();
  }

  function showExportToast(text: string, tone: 'info' | 'ok' | 'err' = 'info') {
    let toast = document.querySelector('[data-order-export-toast]');
    if (!(toast instanceof HTMLElement)) {
      toast = document.createElement('div');
      toast.className = 'order-export-toast';
      toast.setAttribute('data-order-export-toast', '');
      toast.setAttribute('role', 'status');
      toast.setAttribute('aria-live', 'polite');
      document.body.append(toast);
    }
    toast.textContent = text;
    toast.dataset.tone = tone;
    toast.hidden = false;
    toast.dataset.open = '1';
    return toast;
  }

  function hideExportToast(delayMs = 0) {
    const toast = document.querySelector('[data-order-export-toast]');
    if (!(toast instanceof HTMLElement)) return;
    window.clearTimeout(Number(toast.dataset.hideTimer || 0));
    if (delayMs <= 0) {
      toast.hidden = true;
      delete toast.dataset.open;
      return;
    }
    toast.dataset.hideTimer = String(
      window.setTimeout(() => {
        toast.hidden = true;
        delete toast.dataset.open;
      }, delayMs),
    );
  }

  async function downloadExport(id: number, button: HTMLButtonElement) {
    button.disabled = true;
    try {
      const body = new FormData();
      body.set('csrf', exportCsrf);
      body.set('intent', 'download');
      body.set('id', String(id));
      const response = await fetch(EXPORTS, { method: 'POST', body, credentials: 'same-origin' });
      if (!response.ok) {
        const data = (await response.json().catch(() => null)) as { error?: string } | null;
        setExportStatus(data?.error || 'Không tải được file.', 'err');
        return;
      }
      const blob = await response.blob();
      const disposition = response.headers.get('content-disposition') || '';
      const match = /filename="([^"]+)"/.exec(disposition);
      const filename = match?.[1] || 'SPX_DonHang.xlsx';
      const url = URL.createObjectURL(blob);
      const anchor = document.createElement('a');
      anchor.href = url;
      anchor.download = filename;
      anchor.click();
      URL.revokeObjectURL(url);
      const first = response.headers.get('x-export-first-download') === '1';
      const shipped = Number(response.headers.get('x-export-shipped-count') || '0');
      await refreshExportHistory();
      if (first) {
        setExportStatus(`Đã tải ${filename}${shipped > 0 ? ` · đánh dấu ${shipped} đơn đã gửi hàng` : ''}.`, 'ok');
        cache.clear();
        void softNavigate(`${location.pathname}${location.search}`, { push: false });
      } else {
        setExportStatus(`Đã tải lại ${filename}.`, 'ok');
      }
    } catch {
      setExportStatus('Không tải được file.', 'err');
    } finally {
      button.disabled = false;
    }
  }

  async function deleteExports(ids: number[]) {
    if (ids.length === 0) return;
    const body = new FormData();
    body.set('csrf', exportCsrf);
    body.set('intent', 'delete');
    for (const id of ids) body.append('ids', String(id));
    const response = await fetch(EXPORTS, { method: 'POST', body, credentials: 'same-origin', headers: { accept: 'application/json' } });
    const data = (await response.json().catch(() => null)) as { ok?: boolean; error?: string; count?: number } | null;
    if (!response.ok || !data?.ok) {
      setExportStatus(data?.error || 'Không xóa được file.', 'err');
      return;
    }
    await refreshExportHistory();
    setExportStatus(`Đã xóa ${data.count ?? ids.length} file.`, 'ok');
  }

  document.querySelector('[data-order-export-history-open]')?.addEventListener('click', () => {
    void openExportHistory();
  });
  if (exportDialog instanceof HTMLDialogElement) {
    for (const close of exportDialog.querySelectorAll('[data-order-export-close]')) {
      close.addEventListener('click', () => exportDialog.close());
    }
    exportDialog.addEventListener('click', (event) => {
      if (event.target !== exportDialog) return;
      const box = exportDialog.getBoundingClientRect();
      const inside =
        event.clientX >= box.left &&
        event.clientX <= box.right &&
        event.clientY >= box.top &&
        event.clientY <= box.bottom;
      if (!inside) exportDialog.close();
    });
    exportDialog.addEventListener('change', (event) => {
      const target = event.target;
      if (!(target instanceof HTMLInputElement)) return;
      if (target.hasAttribute('data-order-export-select-all')) {
        for (const box of exportDialog.querySelectorAll<HTMLInputElement>('input[data-order-export-id]')) {
          box.checked = target.checked;
        }
      }
      syncExportDeleteBtn();
    });
    exportDialog.addEventListener('click', (event) => {
      const button = event.target instanceof Element ? event.target.closest('button') : null;
      if (!(button instanceof HTMLButtonElement)) return;
      const downloadId = Number(button.dataset.orderExportDownload);
      if (Number.isInteger(downloadId) && downloadId > 0) {
        void downloadExport(downloadId, button);
        return;
      }
      const deleteId = Number(button.dataset.orderExportDelete);
      if (Number.isInteger(deleteId) && deleteId > 0) {
        void deleteExports([deleteId]);
        return;
      }
      if (button.hasAttribute('data-order-export-delete-selected')) {
        const ids = [...exportDialog.querySelectorAll<HTMLInputElement>('input[data-order-export-id]:checked')].map((box) => Number(box.value));
        void deleteExports(ids.filter((id) => Number.isInteger(id) && id > 0));
      }
    });
  }

  if (board instanceof HTMLElement) {
    const root = board;
    const selectedIds = new Set<string>();
    const demoLabels: Record<string, string> = {
      status: 'Đổi trạng thái hàng loạt sắp có.',
      priority: 'Gắn ưu tiên hàng loạt sắp có.',
      unpriority: 'Bỏ ưu tiên hàng loạt sắp có.',
      invoice: 'Xuất hóa đơn hàng loạt sắp có.',
    };

    async function runBulkExport() {
      const bar = root.querySelector('[data-order-bulk]');
      if (!(bar instanceof HTMLFormElement)) return;
      const error = bar.querySelector('[data-bulk-error]');
      const exportBtn = bar.querySelector<HTMLButtonElement>('[data-bulk-export]');
      if (selectedIds.size === 0) {
        if (error instanceof HTMLElement) {
          error.hidden = false;
          error.textContent = 'Chưa chọn đơn để export.';
        }
        return;
      }
      if (exportBtn?.disabled) return;
      syncBulkHidden(bar);
      const body = new FormData(bar);
      body.set('bulk', 'export');
      if (error instanceof HTMLElement) {
        error.hidden = true;
        error.textContent = '';
      }
      if (exportBtn) exportBtn.disabled = true;
      showExportToast('Đang export…', 'info');
      try {
        const response = await fetch(BULK, {
          method: 'POST',
          body,
          credentials: 'same-origin',
          headers: { accept: 'application/json' },
        });
        const data = (await response.json().catch(() => null)) as
          | {
              ok?: boolean;
              error?: string;
              orderCount?: number;
              skippedCount?: number;
              filename?: string;
              skipped?: { orderId: number; code: string; reason: string }[];
            }
          | null;
        if (!response.ok || !data?.ok) {
          const message = data?.error || 'Không export được đơn hàng.';
          const failedSkipped = data?.skipped ?? [];
          showExportToast(message, 'err');
          hideExportToast(2800);
          if (failedSkipped.length > 0) {
            await openExportHistory({ keepSkipped: true });
            setExportSkipped(failedSkipped);
            setExportStatus(message, 'err');
          } else if (error instanceof HTMLElement) {
            error.hidden = false;
            error.textContent = message;
          }
          return;
        }
        clearSelection?.();
        showExportToast(
          (data.skipped?.length ?? 0) > 0
            ? `Đã export ${data.orderCount} đơn (bỏ qua ${data.skipped?.length}).`
            : `Đã export ${data.orderCount} đơn.`,
          (data.skipped?.length ?? 0) > 0 ? 'err' : 'ok',
        );
        hideExportToast(2200);
        await openExportHistory({ keepSkipped: true });
        const skippedItems = data.skipped ?? [];
        setExportSkipped(skippedItems);
        setExportStatus(
          skippedItems.length > 0
            ? `Đã tạo ${data.filename}: ${data.orderCount} đơn hợp lệ, bỏ qua ${skippedItems.length} đơn lỗi (xem danh sách bên dưới).`
            : `Đã tạo ${data.filename}: ${data.orderCount} đơn.`,
          skippedItems.length > 0 ? 'err' : 'ok',
        );
        cache.clear();
        void softNavigate(`${location.pathname}${location.search}`, { push: false });
      } catch {
        showExportToast('Không export được đơn hàng.', 'err');
        hideExportToast(2800);
        if (error instanceof HTMLElement) {
          error.hidden = false;
          error.textContent = 'Không export được đơn hàng.';
        }
      } finally {
        if (exportBtn) exportBtn.disabled = false;
      }
    }

    function boxes(): HTMLInputElement[] {
      return [...root.querySelectorAll('input[name="ids"]')].filter((node): node is HTMLInputElement => node instanceof HTMLInputElement);
    }
    function paint() {
      const bar = root.querySelector('[data-order-bulk]');
      const all = root.querySelector('[data-bulk-all]');
      const countText = bar?.querySelector('[data-bulk-count-text]');
      const demoMsg = bar?.querySelector('[data-bulk-demo-msg]');
      const error = bar?.querySelector('[data-bulk-error]');
      if (!(bar instanceof HTMLFormElement) || !(countText instanceof HTMLElement)) return;
      const pageBoxes = boxes();
      const pageChecked = pageBoxes.filter((box) => box.checked).length;
      countText.textContent = `${selectedIds.size} đơn`;
      bar.hidden = selectedIds.size === 0;
      if (all instanceof HTMLInputElement) {
        all.checked = pageBoxes.length > 0 && pageChecked === pageBoxes.length;
        all.indeterminate = pageChecked > 0 && pageChecked < pageBoxes.length;
      }
      if (demoMsg instanceof HTMLElement) demoMsg.hidden = true;
      if (error instanceof HTMLElement) error.hidden = true;
      syncBulkHidden(bar);
    }
    function syncBulkHidden(bar: HTMLFormElement) {
      for (const node of bar.querySelectorAll('[data-bulk-extra]')) node.remove();
      const onPage = new Set(boxes().map((box) => box.value));
      for (const id of selectedIds) {
        if (onPage.has(id)) continue;
        const input = document.createElement('input');
        input.type = 'hidden';
        input.name = 'ids';
        input.value = id;
        input.dataset.bulkExtra = '1';
        bar.append(input);
      }
    }
    function applyPageChecks() {
      for (const box of boxes()) box.checked = selectedIds.has(box.value);
      paint();
    }
    function pickPage(on: boolean) {
      for (const box of boxes()) {
        box.checked = on;
        if (on) selectedIds.add(box.value);
        else selectedIds.delete(box.value);
      }
      paint();
    }
    restoreSelection = applyPageChecks;
    clearSelection = () => {
      selectedIds.clear();
      applyPageChecks();
    };

    root.addEventListener('change', (event) => {
      const target = event.target;
      if (target instanceof HTMLSelectElement && target.hasAttribute('data-fulfill-select')) {
        const rowForm = target.closest('form');
        if (!(rowForm instanceof HTMLFormElement)) return;
        if (target.value === target.dataset.fulfill) return;
        rowForm.requestSubmit();
        return;
      }
      if (!(target instanceof HTMLInputElement)) return;
      if (target.hasAttribute('data-bulk-all')) return pickPage(target.checked);
      if (target.name === 'ids') {
        if (target.checked) selectedIds.add(target.value);
        else selectedIds.delete(target.value);
        paint();
      }
    });

    root.addEventListener('click', (event) => {
      const pagerLink = event.target instanceof Element ? event.target.closest('.post-pager a.btn') : null;
      if (pagerLink instanceof HTMLAnchorElement) {
        event.preventDefault();
        const href = pagerLink.getAttribute('href') ?? '';
        if (!href) return;
        void softNavigate(href, { push: true });
        return;
      }
      const target = event.target instanceof Element ? event.target.closest('button') : null;
      if (!(target instanceof HTMLButtonElement)) return;
      if (target.hasAttribute('data-bulk-clear')) {
        clearSelection?.();
        return;
      }
      const code = target.dataset.copyCode;
      if (code) {
        void navigator.clipboard.writeText(code).then(
          () => {
            target.dataset.copied = '1';
            window.setTimeout(() => {
              delete target.dataset.copied;
            }, 1200);
          },
          () => undefined,
        );
        return;
      }
      if (target.hasAttribute('data-bulk-export')) {
        void runBulkExport();
        return;
      }
      const demo = target.dataset.bulkDemo;
      const demoMsg = root.querySelector('[data-bulk-demo-msg]');
      if (demo && demoMsg instanceof HTMLElement) {
        demoMsg.hidden = false;
        demoMsg.textContent = demoLabels[demo] ?? 'Chức năng sắp có.';
        return;
      }
      const bar = root.querySelector('[data-order-bulk]');
      if (target.hasAttribute('data-bulk-delete') && bar instanceof HTMLFormElement) {
        const n = selectedIds.size;
        bar.dataset.confirmTitle = `Xóa ${n} đơn đã chọn?`;
        bar.dataset.confirm = `${n} đơn sẽ bị xóa vĩnh viễn cùng dòng sản phẩm và không khôi phục được.`;
        bar.dataset.confirmOk = `Xóa ${n} đơn`;
        syncBulkHidden(bar);
      }
    });

    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape' || document.querySelector('dialog[open]')) return;
      if (selectedIds.size > 0) clearSelection?.();
    });

    window.addEventListener('popstate', () => {
      if (!location.pathname.startsWith(LIST)) return;
      cache.clear();
      void softNavigate(`${location.pathname}${location.search}`, { push: false });
    });

    paint();
    schedulePrefetch();
  }
</script>
