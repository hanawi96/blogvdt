---
import StaffOrderForm from '../../../components/admin/StaffOrderForm.astro';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { mutationError } from '../../../features/auth/session';
import { listStaffDiscountChoices } from '../../../features/discounts/discounts';
import { createStaffOrder } from '../../../features/orders/orders';
import { parseStaffCustomer, priceStaffLines, readStaffFlags, readStaffLineInputs, type StaffFlagForm, type StaffLineInput } from '../../../features/orders/staff';
import { isShippingOrderCost, listOrderCosts } from '../../../features/costs/order-costs';
import { baseCustomerShippingFee, qualifiesFreeShip, shipGroupOf } from '../../../features/shipping/customer-fee';
import { listStaffPickerProducts } from '../../../features/products/public';
import { createDb } from '../../../lib/db/client';
import { getDbBinding } from '../../../lib/cloudflare/env';
import { groupDigits } from '../../../lib/group-digits';
import { routes } from '../../../lib/routes';
import type { FieldErrors } from '../../../lib/validation/errors';

const session = Astro.locals.adminSession;
if (!session) return Astro.redirect(routes.adminLogin);

const db = createDb(getDbBinding());
const picker = await listStaffPickerProducts(db);
const products = picker.products;
const discountChoices = await listStaffDiscountChoices(db);
const shippingCosts = (await listOrderCosts(db)).filter((cost) => cost.active && isShippingOrderCost(cost.name));
const defaultShippingFeeAmount = baseCustomerShippingFee(shippingCosts);
const defaultShippingFee = defaultShippingFeeAmount > 0 ? groupDigits(String(defaultShippingFeeAmount), 8) : '';
let formError = '';
let lineError = '';
let flagError = '';
let errors: FieldErrors = {};
let postedLines: StaffLineInput[] | null = null;
const values = { customerName: '', phone: '', address: '', note: '', provinceCode: '', wardCode: '', addressLine: '', orderTotal: '', discountCode: '', discountExtra: '' };
const flagForm: StaffFlagForm = {
  payState: 'cod',
  source: '',
  priority: false,
  compensation: false,
  shipLater: false,
  shipOn: '',
  shippingFee: defaultShippingFee,
  freeShip: false,
  depositAmount: '',
};

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const blocked = mutationError(Astro.request, session, form);
  const read = (name: string) => {
    const value = form.get(name);
    return typeof value === 'string' ? value : '';
  };
  values.customerName = read('customerName');
  values.phone = read('phone');
  values.address = read('address');
  values.note = read('note');
  values.provinceCode = read('provinceCode');
  values.wardCode = read('wardCode');
  values.addressLine = read('addressLine');
  values.orderTotal = read('orderTotal');
  values.discountCode = read('discountCode');
  values.discountExtra = read('discountExtra');
  flagForm.payState = read('payState') || 'cod';
  flagForm.source = read('source');
  flagForm.priority = read('priority') === 'on';
  flagForm.compensation = read('compensation') === 'on';
  flagForm.shipLater = read('shipLater') === 'on';
  flagForm.shipOn = read('shipOn');
  flagForm.shippingFee = read('shippingFee');
  flagForm.freeShip = read('freeShip') === 'on';
  flagForm.depositAmount = read('depositAmount');
  postedLines = readStaffLineInputs(form);
  const flags = readStaffFlags({
    ...flagForm,
    priority: flagForm.priority ? 'on' : '',
    compensation: flagForm.compensation ? 'on' : '',
    shipLater: flagForm.shipLater ? 'on' : '',
    freeShip: flagForm.freeShip ? 'on' : '',
    depositAmount: flagForm.depositAmount,
  });
  if (blocked) {
    Astro.response.status = 403;
    formError = blocked;
  } else {
    if (!flags.ok) flagError = flags.error;
    const customer = parseStaffCustomer({ ...values, paymentMethod: flags.ok ? flags.flags.paymentMethod : 'cod' });
    const priced = postedLines ? priceStaffLines(postedLines, products, []) : null;
    if (!customer.ok) errors = customer.errors;
    if (!priced || !priced.ok) {
      lineError = !postedLines && form.getAll('lineSlot').length === 0
        ? 'Thêm ít nhất một sản phẩm.'
        : priced && !priced.ok
          ? priced.error
          : 'Dòng sản phẩm không hợp lệ.';
    }
    let staffFlags = flags.ok ? flags.flags : null;
    if (priced?.ok && staffFlags) {
      const freeShip = qualifiesFreeShip(
        priced.lines.map((line) => ({
          group: shipGroupOf(products.find((product) => product.id === line.productId)?.categorySlug),
          lineTotal: line.lineTotal,
        })),
      );
      if (freeShip) {
        staffFlags = { ...staffFlags, shippingFee: 0 };
        flagForm.freeShip = true;
        flagForm.shippingFee = '';
      }
    }
    if (customer.ok && priced && priced.ok && staffFlags) {
      const created = await createStaffOrder(
        db,
        {
          ...customer.value,
          lines: priced.lines,
          discountCode: values.discountCode.trim() ? values.discountCode : null,
          orderTotal: values.orderTotal,
          discountExtra: values.discountExtra,
          flags: staffFlags,
        },
        session.userId,
      );
      if (!created.ok) {
        Astro.response.status = 422;
        formError = created.error;
      } else {
        return Astro.redirect(`${routes.adminOrder(created.id)}?saved=created`, 303);
      }
    } else {
      Astro.response.status = 422;
    }
  }
}

const editorLines: StaffLineInput[] = postedLines ?? [];
---

<AdminLayout title="Thêm đơn">
  <a slot="action" class="btn" href={routes.adminOrders}>Danh sách</a>
  <p slot="lead">Đơn khách đặt qua Zalo, Facebook hoặc điện thoại.</p>
  {formError && <p class="error-text mb-4" role="alert">{formError}</p>}
  <StaffOrderForm
    csrfToken={session.csrfToken}
    submitLabel="Tạo đơn"
    values={values}
    flagForm={flagForm}
    flagError={flagError}
    errors={errors}
    lineError={lineError}
    editorLines={editorLines}
    editorChoices={products}
    pickerProducts={products}
    pickerCategories={picker.categories}
    discountChoices={discountChoices}
    shippingCosts={shippingCosts}
    defaultShippingFee={defaultShippingFee}
  />
</AdminLayout>
