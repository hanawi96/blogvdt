---
import OrderListPanel from '../../../components/admin/OrderListPanel.astro';
import OrderPeriodSummary from '../../../components/admin/OrderPeriodSummary.astro';
import { orderCreatedRange } from '../../../features/orders/order';
import {
  listOrderDayBuckets,
  listOrders,
  orderAdminQuery,
  orderListPayment,
  listTheTenTagNotes,
  orderListSort,
  orderListSource,
  orderListStatus,
  orderListTag,
  orderPanelQuery,
  type OrderDayBucket,
  type OrderTagNote,
} from '../../../features/orders/orders';
import {
  loadOrderPeriodStats,
  resolveOrderSummaryWindow,
  type PosTodayStats,
} from '../../../features/orders/pos-today-stats';
import { createDb } from '../../../lib/db/client';
import { getDbBinding } from '../../../lib/cloudflare/env';
import { formatOrderDateFilterLabel } from '../../../lib/datetime';
import { routes } from '../../../lib/routes';

export const prerender = false;

const session = Astro.locals.adminSession;
if (!session) return Astro.redirect(routes.adminLogin);

const query = Astro.url.searchParams.get('q') ?? '';
const status = orderListStatus(Astro.url.searchParams.get('status'), query);
const source = orderListSource(Astro.url.searchParams.get('source'));
const payment = orderListPayment(Astro.url.searchParams.get('payment'));
const from = Astro.url.searchParams.get('from') ?? '';
const to = Astro.url.searchParams.get('to') ?? '';
const tag = orderListTag(Astro.url.searchParams.get('tag'));
const sort = orderListSort(Astro.url.searchParams.get('sort'));
const page = Number(Astro.url.searchParams.get('page') ?? '1');
const range = orderCreatedRange(from, to);

if (range.invalid) {
  return new Response('Khoảng ngày không hợp lệ.', {
    status: 422,
    headers: { 'content-type': 'text/plain; charset=utf-8', 'cache-control': 'private, no-store' },
  });
}

const summaryResolved = resolveOrderSummaryWindow(from, to);
const summaryUsesDateFilter = summaryResolved.ok && summaryResolved.usesDateFilter;
const summaryPeriodLabel = summaryUsesDateFilter ? formatOrderDateFilterLabel(from, to) : 'hôm nay';

let result: Awaited<ReturnType<typeof listOrders>>;
let dayBuckets: OrderDayBucket[] = [];
let theTenTags: OrderTagNote[] = [];
let periodSummary: PosTodayStats = {
  orders: 0,
  revenue: 0,
  revenueOrders: 0,
  profit: 0,
  costedOrders: 0,
  sources: [],
};
try {
  const db = createDb(getDbBinding());
  const listFilters = {
    query,
    status,
    source,
    payment,
    start: range.start,
    end: range.end,
    tag,
    sort,
  };
  const [listed, buckets, tags, period] = await Promise.all([
    listOrders(db, {
      ...listFilters,
      page: Number.isInteger(page) ? page : 1,
    }),
    listOrderDayBuckets(db, listFilters),
    listTheTenTagNotes(db),
    summaryResolved.ok
      ? loadOrderPeriodStats(db, summaryResolved.window)
      : Promise.resolve(periodSummary),
  ]);
  result = listed;
  dayBuckets = buckets;
  theTenTags = tags;
  periodSummary = period;
} catch (error) {
  console.error(JSON.stringify({ event: 'order_panel_failed', name: error instanceof Error ? error.name : 'unknown' }));
  return new Response('Không tải được danh sách đơn.', {
    status: 500,
    headers: { 'content-type': 'text/plain; charset=utf-8', 'cache-control': 'private, no-store' },
  });
}

const listFilters = { query, status, source, payment, from, to, tag, sort };
function pageHref(nextPage: number): string {
  return orderAdminQuery({ ...listFilters, page: nextPage });
}
const nextPanelHref =
  result.page < result.pageCount ? orderPanelQuery({ ...listFilters, page: result.page + 1 }) : '';
const shippedPanelHref =
  status === 'shipped' ? '' : orderPanelQuery({ ...listFilters, status: 'shipped', page: 1 });

Astro.response.headers.set('cache-control', 'private, no-store');
Astro.response.headers.set('content-type', 'text/html; charset=utf-8');
---
<div data-order-panel-payload>
  <OrderPeriodSummary
    stats={periodSummary}
    periodLabel={summaryPeriodLabel}
    usesDateFilter={summaryUsesDateFilter}
  />
  <OrderListPanel
    result={result}
    dayBuckets={dayBuckets}
    csrfToken={session.csrfToken}
    canBulkDelete={session.role === 'admin'}
    query={query}
    status={status}
    source={source}
    payment={payment}
    from={from}
    to={to}
    tag={tag}
    sort={sort}
    theTenTags={theTenTags}
    pageHref={pageHref}
    nextPanelHref={nextPanelHref}
    shippedPanelHref={shippedPanelHref}
  />
</div>
