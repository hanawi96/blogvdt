---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { mutationError } from '../../../features/auth/session';
import { getOrder, updateOrderStatus } from '../../../features/orders/orders';
import { isOrderStatus, ORDER_STATUS_LABELS, ORDER_STATUSES } from '../../../features/orders/status';
import { createDb } from '../../../lib/db/client';
import { getDbBinding } from '../../../lib/cloudflare/env';
import { formatDateTime } from '../../../lib/datetime';
import { formatVnd } from '../../../lib/money';
import { routes } from '../../../lib/routes';

const session = Astro.locals.adminSession;
if (!session) return Astro.redirect(routes.adminLogin);

const id = Number(Astro.params.id);
if (!Number.isInteger(id) || id < 1) return Astro.redirect(routes.adminOrders);

const db = createDb(getDbBinding());
let order = await getOrder(db, id);
if (!order) return Astro.redirect(routes.adminOrders);

let formError = '';
const saved = Astro.url.searchParams.get('saved') === '1';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const blocked = mutationError(Astro.request, session, form);
  const status = form.get('status');
  if (blocked) {
    Astro.response.status = 403;
    formError = blocked;
  } else if (typeof status !== 'string' || !isOrderStatus(status)) {
    Astro.response.status = 422;
    formError = 'Trạng thái không hợp lệ.';
  } else {
    const result = await updateOrderStatus(db, id, status);
    if (!result.ok) {
      Astro.response.status = 422;
      formError = result.error;
    } else {
      return Astro.redirect(`${routes.adminOrder(id)}?saved=1`, 303);
    }
  }
  order = (await getOrder(db, id)) ?? order;
}
---

<AdminLayout title={`Đơn ${order.code}`}>
  {saved && <p class="mb-4 text-primary-strong" role="status">Đã cập nhật trạng thái.</p>}
  {formError && <p class="error-text mb-4" role="alert">{formError}</p>}
  <dl class="grid max-w-3xl gap-3">
    <div><dt class="text-sm text-muted">Khách</dt><dd>{order.customerName}</dd></div>
    <div><dt class="text-sm text-muted">Số điện thoại</dt><dd><a href={`tel:${order.phone}`}>{order.phone}</a></dd></div>
    <div><dt class="text-sm text-muted">Địa chỉ</dt><dd>{order.address}</dd></div>
    <div><dt class="text-sm text-muted">Ghi chú</dt><dd>{order.note || '—'}</dd></div>
    <div>
      <dt class="text-sm text-muted">Sản phẩm lúc đặt</dt>
      <dd>
        {order.productId ? <a class="underline" href={routes.adminProduct(order.productId)}>{order.productName}</a> : order.productName}
        {order.optionLabel ? ` · ${order.optionLabel}` : ''}
      </dd>
    </div>
    <div><dt class="text-sm text-muted">Giá và số lượng</dt><dd>{formatVnd(order.unitPrice)} × {order.quantity} = {formatVnd(order.totalPrice)}</dd></div>
    <div><dt class="text-sm text-muted">Tạo</dt><dd>{formatDateTime(order.createdAt)}</dd></div>
    <div><dt class="text-sm text-muted">Cập nhật</dt><dd>{formatDateTime(order.updatedAt)}</dd></div>
  </dl>
  <form class="mt-6 flex flex-wrap items-end gap-3" method="post" action={routes.adminOrder(id)} data-busy>
    <input type="hidden" name="csrf" value={session.csrfToken} />
    <label>
      <span class="mb-1 block font-semibold">Trạng thái</span>
      <select class="field w-auto" name="status">
        {ORDER_STATUSES.map((item) => <option value={item} selected={order.status === item}>{ORDER_STATUS_LABELS[item]}</option>)}
      </select>
    </label>
    <button class="btn btn-primary" type="submit">Lưu trạng thái</button>
  </form>
</AdminLayout>
