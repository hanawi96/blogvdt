---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { mutationError } from '../../../features/auth/session';
import { orderHandoffText } from '../../../features/orders/order';
import { getOrder, updateOrderFulfillStatus, updateOrderNote, updateOrderStatus } from '../../../features/orders/orders';
import {
  canEditOrderProducts,
  collectionLabel,
  orderLineSources,
  remainingAfterDeposit,
  shipLaterPill,
  sourceLabel,
} from '../../../features/orders/staff';
import {
  canTransitionOrder,
  FULFILL_STATUS_LABELS,
  FULFILL_STATUSES,
  fulfillStatusOf,
  isFulfillStatus,
  isOrderStatus,
  ORDER_STATUS_LABELS,
  orderShippedAgoLabel,
} from '../../../features/orders/status';
import { productCoversByIds } from '../../../features/products/public';
import { createDb } from '../../../lib/db/client';
import { getDbBinding } from '../../../lib/cloudflare/env';
import { formatDateTime } from '../../../lib/datetime';
import { formatVnd } from '../../../lib/money';
import { routes } from '../../../lib/routes';

export const prerender = false;

const session = Astro.locals.adminSession;
if (!session) return Astro.redirect(routes.adminLogin);

const id = Number(Astro.params.id);
if (!Number.isInteger(id) || id < 1) return Astro.redirect(routes.adminOrders);

const db = createDb(getDbBinding());
let order = await getOrder(db, id);
if (!order) return Astro.redirect(routes.adminOrders);

let formError = '';
let noteError = '';
const saved = Astro.url.searchParams.get('saved');

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const blocked = mutationError(Astro.request, session, form);
  const intent = form.get('intent');
  if (blocked) {
    Astro.response.status = 403;
    formError = blocked;
  } else if (intent === 'note') {
    const note = form.get('internalNote');
    const result = await updateOrderNote(db, id, typeof note === 'string' ? note : '');
    if (!result.ok) {
      Astro.response.status = 422;
      noteError = result.error;
    } else {
      return Astro.redirect(`${routes.adminOrder(id)}?saved=note`, 303);
    }
  } else if (intent === 'fulfill') {
    const fulfill = form.get('fulfill');
    if (typeof fulfill !== 'string' || !isFulfillStatus(fulfill)) {
      Astro.response.status = 422;
      formError = 'Trạng thái giao không hợp lệ.';
    } else {
      const result = await updateOrderFulfillStatus(db, id, fulfill);
      if (!result.ok) {
        Astro.response.status = 422;
        formError = result.error;
      } else {
        return Astro.redirect(`${routes.adminOrder(id)}?saved=fulfill`, 303);
      }
    }
  } else if (intent === 'status') {
    // Chỉ dùng cho hoàn thành đơn.
    const status = form.get('status');
    if (typeof status !== 'string' || status !== 'completed' || !isOrderStatus(status)) {
      Astro.response.status = 422;
      formError = 'Trạng thái không hợp lệ.';
    } else {
      const result = await updateOrderStatus(db, id, status);
      if (!result.ok) {
        Astro.response.status = 422;
        formError = result.error;
      } else {
        return Astro.redirect(`${routes.adminOrder(id)}?saved=status`, 303);
      }
    }
  }
  order = (await getOrder(db, id)) ?? order;
}

const editable = canEditOrderProducts(order.status);
const fulfill = fulfillStatusOf(order);
const lines = orderLineSources(order);
const covers = await productCoversByIds(
  db,
  lines.flatMap((line) => (line.productId ? [line.productId] : [])),
);
const pieces = lines.reduce((sum, line) => sum + line.quantity, 0);
const sendLater =
  order.shipOn !== null && fulfill === 'unshipped' && order.status !== 'completed' && order.status !== 'cancelled';
const laterPill = sendLater && order.shipOn != null ? shipLaterPill(order.shipOn) : null;
const handoff = orderHandoffText(order);
const statusLabel = isOrderStatus(order.status) ? ORDER_STATUS_LABELS[order.status] : order.status;
const fulfillLabel =
  fulfill == null
    ? statusLabel
    : fulfill === 'shipped'
      ? orderShippedAgoLabel(order.shippedAt)
      : FULFILL_STATUS_LABELS[fulfill];
const canComplete = isOrderStatus(order.status) && canTransitionOrder(order.status, 'completed');
const subtotal = order.subtotal ?? order.totalPrice + order.discountAmount;
const listNow = Date.now();
---

<AdminLayout title={`Đơn ${order.code}`}>
  <div slot="action" class="dash-quick">
    {editable && <a class="btn btn-primary" href={routes.adminOrderEdit(id)}>Sửa đơn</a>}
    <a class="btn" href={routes.adminOrders}>Danh sách</a>
  </div>

  {saved === 'fulfill' && <p class="mb-4 text-primary-strong" role="status" data-admin-flash>Đã cập nhật trạng thái giao hàng.</p>}
  {saved === 'status' && <p class="mb-4 text-primary-strong" role="status" data-admin-flash>Đã cập nhật trạng thái.</p>}
  {saved === 'note' && <p class="mb-4 text-primary-strong" role="status" data-admin-flash>Đã lưu ghi chú nội bộ.</p>}
  {saved === 'created' && <p class="mb-4 text-primary-strong" role="status" data-admin-flash>Đã tạo đơn.</p>}
  {saved === 'edited' && <p class="mb-4 text-primary-strong" role="status" data-admin-flash>Đã cập nhật đơn hàng.</p>}
  {Astro.url.searchParams.get('notice') === 'locked' && (
    <p class="error-text mb-4" role="alert" data-admin-flash>Đơn đã kết thúc, không sửa được.</p>
  )}
  {formError && <p class="error-text mb-4" role="alert">{formError}</p>}

  <div class="od-page">
    <section class="od-card od-head" aria-label="Tóm tắt đơn">
      <div class="od-head-main">
        <div class="od-head-line">
          <span class="od-code">{order.code}</span>
          {fulfill != null ? (
            <span class="order-shipped-pill" data-fulfill={fulfill}>{fulfillLabel}</span>
          ) : (
            <span class="order-badge" data-status={order.status}>{statusLabel}</span>
          )}
        </div>
        <p class="od-meta">
          <span>Tạo {formatDateTime(order.createdAt)}</span>
          {order.shippedAt != null && <span>Gửi {formatDateTime(order.shippedAt)}</span>}
          <span>{lines.length} mẫu · {pieces} chiếc</span>
        </p>
        <p class="od-chip-row">
          <span class="od-chip">{collectionLabel(order.payState, order.paymentMethod)}</span>
          {order.source && <span class="od-chip">{sourceLabel(order.source)}</span>}
          {order.priority === 1 && <span class="od-chip">Ưu tiên</span>}
          {order.compensation === 1 && <span class="od-chip">Gửi bù</span>}
          {laterPill && <span class="order-ship-later-pill" data-tone={laterPill.tone}>{laterPill.label}</span>}
        </p>
      </div>
      <div class="od-head-total">
        <span>Khách trả</span>
        <strong>{formatVnd(order.totalPrice)}</strong>
        {order.discountAmount > 0 && (
          <span class="od-note">Đã giảm{order.discountCode ? ` ${order.discountCode}` : ''} {formatVnd(order.discountAmount)}</span>
        )}
        {order.compensation === 1 && <span class="od-note">Không thu tiền</span>}
      </div>
    </section>

    <div class="od-columns">
      <div class="od-col">
        <section class="od-card">
          <h2>Khách hàng</h2>
          <dl class="od-facts od-facts-customer">
            <div>
              <dt>Họ tên</dt>
              <dd>{order.customerName}</dd>
            </div>
            <div>
              <dt>Số điện thoại</dt>
              <dd><a class="od-phone" href={`tel:${order.phone}`}>{order.phone}</a></dd>
            </div>
            <div class="od-fact-wide">
              <dt>Địa chỉ</dt>
              <dd>{order.address}</dd>
            </div>
            {order.note ? (
              <div class="od-fact-wide">
                <dt>Ghi chú khách</dt>
                <dd class="od-callout">{order.note}</dd>
              </div>
            ) : null}
          </dl>
        </section>

        <section class="od-card">
          <h2>Sản phẩm</h2>
          <ul class="od-lines">
            {lines.map((line) => {
              const cover = line.productId ? covers.get(line.productId) : undefined;
              return (
                <li>
                  <div class="od-line-media" aria-hidden={!cover}>
                    {cover ? (
                      <img src={cover.url} alt={cover.alt} width="64" height="64" loading="lazy" />
                    ) : (
                      <span class="od-line-ph"></span>
                    )}
                  </div>
                  <div class="od-line-main">
                    <p class="od-line-name">{line.productName}</p>
                    <p class="od-line-meta">
                      {line.optionLabel && <span class="od-tag">{line.optionLabel}</span>}
                      <span>
                        {line.quantity} × {formatVnd(line.unitPrice)}
                      </span>
                      {line.productId ? <a href={routes.adminProduct(line.productId)}>Xem SP</a> : null}
                    </p>
                    {line.note ? <p class="od-line-note">{line.note}</p> : null}
                  </div>
                  <strong class="od-line-total">{formatVnd(line.lineTotal)}</strong>
                </li>
              );
            })}
          </ul>

          <dl class="od-money">
            <div>
              <dt>Tạm tính</dt>
              <dd>{formatVnd(subtotal)}</dd>
            </div>
            {order.discountAmount > 0 && (
              <div>
                <dt>Giảm{order.discountCode ? ` (${order.discountCode})` : ''}</dt>
                <dd>− {formatVnd(order.discountAmount)}</dd>
              </div>
            )}
            <div>
              <dt>Phí ship khách</dt>
              <dd>{order.shippingFee > 0 ? formatVnd(order.shippingFee) : 'Miễn phí'}</dd>
            </div>
            {order.payState === 'deposit' && order.depositAmount > 0 && (
              <div>
                <dt>Đã cọc</dt>
                <dd>
                  {formatVnd(order.depositAmount)} · còn {formatVnd(remainingAfterDeposit(order.totalPrice, order.depositAmount))}
                </dd>
              </div>
            )}
            <div class="od-money-total">
              <dt>Phải trả</dt>
              <dd>{formatVnd(order.totalPrice)}</dd>
            </div>
          </dl>
        </section>

        <section class="od-card">
          <h2>Ghi chú nội bộ</h2>
          <form method="post" action={routes.adminOrder(id)} data-busy>
            <input type="hidden" name="csrf" value={session.csrfToken} />
            <input type="hidden" name="intent" value="note" />
            <label>
              <span class="sr-only">Ghi chú nội bộ</span>
              <textarea
                class="field min-h-24"
                name="internalNote"
                maxlength="1000"
                placeholder="Chỉ nhân viên thấy — giao giờ nào, lưu ý đóng gói…"
              >{order.internalNote ?? ''}</textarea>
            </label>
            {noteError && <p class="error-text mt-2" role="alert">{noteError}</p>}
            <button class="btn mt-3" type="submit">Lưu ghi chú</button>
          </form>
        </section>
      </div>

      <aside class="od-col od-aside">
        <section class="od-card">
          <h2>Xử lý đơn</h2>
          {fulfill != null && editable ? (
            <div class="od-fulfill-presets" role="group" aria-label="Trạng thái giao hàng">
              {FULFILL_STATUSES.map((item) => {
                const label = item === 'shipped' ? orderShippedAgoLabel(order.shippedAt, listNow) : FULFILL_STATUS_LABELS[item];
                const current = fulfill === item;
                return (
                  <form
                    method="post"
                    action={routes.adminOrder(id)}
                    data-busy
                    data-confirm-title="Đổi trạng thái giao hàng?"
                    data-confirm={`Đơn ${order.code} sẽ chuyển sang «${FULFILL_STATUS_LABELS[item]}».`}
                    data-confirm-ok="Đổi trạng thái"
                  >
                    <input type="hidden" name="csrf" value={session.csrfToken} />
                    <input type="hidden" name="intent" value="fulfill" />
                    <input type="hidden" name="fulfill" value={item} />
                    <button
                      class:list={['od-fulfill-btn', current && 'is-current']}
                      type="submit"
                      data-fulfill={item}
                      disabled={current}
                      aria-pressed={current ? 'true' : 'false'}
                    >
                      {label}
                    </button>
                  </form>
                );
              })}
            </div>
          ) : (
            <p class="od-note" style="margin-top:0">Đơn {statusLabel.toLowerCase()}.</p>
          )}
          {canComplete && editable ? (
            <form
              class="od-complete-form"
              method="post"
              action={routes.adminOrder(id)}
              data-busy
              data-confirm-title="Hoàn thành đơn?"
              data-confirm={`Đơn ${order.code} sẽ được đánh dấu hoàn thành.`}
              data-confirm-ok="Hoàn thành"
            >
              <input type="hidden" name="csrf" value={session.csrfToken} />
              <input type="hidden" name="intent" value="status" />
              <input type="hidden" name="status" value="completed" />
              <button class="btn w-full" type="submit">Hoàn thành</button>
            </form>
          ) : null}
          <p class="od-note">Thanh toán: {collectionLabel(order.payState, order.paymentMethod)}. Phí ship vốn {formatVnd(order.shippingCost)}.</p>
        </section>

        <section class="od-card">
          <h2>Giao hàng</h2>
          <ul class="order-handoff">
            {handoff.split('\n').map((line) => (
              <li>
                <span class="handoff-dot" aria-hidden="true"></span>
                {line}
              </li>
            ))}
          </ul>
          <button class="btn mt-3 w-full" type="button" data-copy-order>Sao chép thông tin giao hàng</button>
          <p class="mt-2 text-primary-strong" data-copy-status role="status" hidden></p>
        </section>

      </aside>
    </div>
  </div>
</AdminLayout>

<script define:vars={{ handoff }}>
  const button = document.querySelector('[data-copy-order]');
  const status = document.querySelector('[data-copy-status]');
  button?.addEventListener('click', async () => {
    if (!(status instanceof HTMLElement)) return;
    try {
      await navigator.clipboard.writeText(handoff);
      status.hidden = false;
      status.textContent = 'Đã sao chép thông tin giao hàng.';
    } catch {
      status.hidden = false;
      status.textContent = 'Không sao chép được. Hãy chọn nội dung phía trên.';
    }
  });
</script>
