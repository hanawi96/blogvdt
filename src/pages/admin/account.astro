---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { mutationError } from '../../features/auth/session';
import { changeOwnPassword } from '../../features/auth/users';
import { createDb } from '../../lib/db/client';
import { getDbBinding } from '../../lib/cloudflare/env';
import { routes } from '../../lib/routes';

const session = Astro.locals.adminSession;
if (!session) return Astro.redirect(routes.adminLogin);

let formError = '';
let saved = Astro.url.searchParams.get('saved') === '1';

if (Astro.request.method === 'POST') {
  saved = false;
  const form = await Astro.request.formData();
  const blocked = mutationError(Astro.request, session, form);
  if (blocked) {
    Astro.response.status = 403;
    formError = blocked;
  } else if (String(form.get('next') ?? '') !== String(form.get('confirm') ?? '')) {
    Astro.response.status = 422;
    formError = 'Mật khẩu mới không khớp.';
  } else {
    const changed = await changeOwnPassword(
      createDb(getDbBinding()),
      session.userId,
      session.sessionId,
      String(form.get('current') ?? ''),
      String(form.get('next') ?? ''),
    );
    if (!changed.ok) {
      Astro.response.status = 422;
      formError = changed.error;
    } else {
      return Astro.redirect(`${routes.adminAccount}?saved=1`, 303);
    }
  }
}
---

<AdminLayout title="Tài khoản">
  <p slot="lead">Đổi mật khẩu của bạn. Các phiên khác sẽ bị đăng xuất.</p>
  {saved && <p class="mb-4 text-primary-strong" role="status">Đã đổi mật khẩu.</p>}
  {formError && <p class="error-text mb-4" role="alert">{formError}</p>}
  <form class="max-w-xl" method="post" data-busy>
    <input type="hidden" name="csrf" value={session.csrfToken} />
    <label class="block">
      <span class="mb-1 block font-semibold">Mật khẩu hiện tại</span>
      <input class="field" type="password" name="current" autocomplete="current-password" required maxlength="200" />
    </label>
    <label class="mt-4 block">
      <span class="mb-1 block font-semibold">Mật khẩu mới</span>
      <input class="field" type="password" name="next" autocomplete="new-password" required minlength="12" maxlength="200" />
    </label>
    <label class="mt-4 block">
      <span class="mb-1 block font-semibold">Nhập lại mật khẩu mới</span>
      <input class="field" type="password" name="confirm" autocomplete="new-password" required minlength="12" maxlength="200" />
    </label>
    <button class="btn btn-primary mt-6" type="submit">Đổi mật khẩu</button>
  </form>
</AdminLayout>
