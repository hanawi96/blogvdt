---
import SearchPreview from '../../components/admin/SearchPreview.astro';
import SlugField from '../../components/admin/SlugField.svelte';
import AdminLayout from '../../layouts/AdminLayout.astro';
import { activityActor } from '../../features/activity/log';
import { mutationError } from '../../features/auth/session';
import { categoryDeleteWarning, deleteCategory, listCategories, saveCategory } from '../../features/posts/categories';
import { lengthNote, metaDuplicateNote, SEO_DESC_RANGE, SEO_TITLE_RANGE } from '../../features/posts/seo-check';
import { listMetaCorpus } from '../../features/posts/posts';
import { getPublicSite } from '../../features/settings/settings';
import { createDb } from '../../lib/db/client';
import { getDbBinding } from '../../lib/cloudflare/env';
import { collectMetaCorpus, mergeMetaCorpus, siteListCorpus } from '../../lib/seo/meta';
import { routes } from '../../lib/routes';

const session = Astro.locals.adminSession;
if (!session) return Astro.redirect(routes.adminLogin);

const db = createDb(getDbBinding());
let formError = '';
let editingId = '';
let name = '';
let slug = '';
let description = '';
let seoTitle = '';
let metaDescription = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const blocked = mutationError(Astro.request, session, form);
  if (blocked) {
    Astro.response.status = 403;
    formError = blocked;
  } else {
    const intent = String(form.get('intent') ?? 'save');
    const idValue = Number(form.get('id'));
    const id = Number.isInteger(idValue) && idValue > 0 ? idValue : undefined;
    const actor = await activityActor(db, session.userId);
    if (intent === 'delete' && id) {
      await deleteCategory(db, id, actor);
      return Astro.redirect(routes.adminCategories, 303);
    }
    name = String(form.get('name') ?? '');
    slug = String(form.get('slug') ?? '');
    description = String(form.get('description') ?? '');
    seoTitle = String(form.get('seoTitle') ?? '');
    metaDescription = String(form.get('metaDescription') ?? '');
    editingId = id ? String(id) : '';
    const saved = await saveCategory(db, { id, name, slug, description, seoTitle, metaDescription }, Date.now(), actor);
    if (!saved.ok) {
      Astro.response.status = 422;
      formError = saved.error;
    } else {
      return Astro.redirect(`${routes.adminCategories}?saved=1`, 303);
    }
  }
}

const categories = await listCategories(db);
const saved = Astro.url.searchParams.get('saved') === '1';
const editId = Number(Astro.url.searchParams.get('edit') ?? '');
const editing = categories.find((category) => category.id === editId);
if (Astro.request.method !== 'POST' && editing) {
  editingId = String(editing.id);
  name = editing.name;
  slug = editing.slug;
  description = editing.description ?? '';
  seoTitle = editing.seoTitle ?? '';
  metaDescription = editing.metaDescription ?? '';
}
const site = await getPublicSite(db);
const excludeCategory = editingId ? Number(editingId) : null;
const corpus = mergeMetaCorpus(
  collectMetaCorpus(categories.filter((category) => category.id !== excludeCategory)),
  await listMetaCorpus(db, null),
  siteListCorpus(),
);
const titleLengthNote = lengthNote(seoTitle.length, SEO_TITLE_RANGE.min, SEO_TITLE_RANGE.max);
const descriptionLengthNote = lengthNote(metaDescription.length, SEO_DESC_RANGE.min, SEO_DESC_RANGE.max);
const duplicateNote = metaDuplicateNote(seoTitle || name, metaDescription || description, corpus);
const slugError = formError.startsWith('Slug') ? formError : '';
const nameError = formError.startsWith('Nhập tên') || formError.startsWith('Tên') ? formError : '';
const bannerError = slugError || nameError ? '' : formError;
---

<AdminLayout title="Danh mục">
  {saved && !formError && <p class="mb-4 text-primary-strong" role="status">Đã lưu danh mục.</p>}
  {bannerError && <p class="error-text mb-4" role="alert">{bannerError}</p>}
  <div class="category-layout">
    <form class="category-panel" method="post" data-busy>
      <h2 class="category-panel-title">{editingId ? 'Sửa danh mục' : 'Thêm danh mục'}</h2>
      <input type="hidden" name="csrf" value={session.csrfToken} />
      <input type="hidden" name="intent" value="save" />
      {editingId && <input type="hidden" name="id" value={editingId} />}
      <SlugField client:load label="Tên" field="name" title={name} {slug} titleError={nameError} {slugError} />
      <p class="seo-hint">Slug tự tạo từ tên tiếng Việt cho đến khi bạn sửa ô này.</p>
      <label class="mt-4 block">
        <span class="mb-1 block font-semibold">Mô tả</span>
        <textarea class="field min-h-24" name="description" maxlength="300">{description}</textarea>
      </label>
      <div class="mt-4">
        <SearchPreview
          site={{ name: site?.siteName || 'Website', host: Astro.url.host, markUrl: site?.faviconUrl || site?.logoUrl || '' }}
          title={seoTitle || name || 'Tên danh mục'}
          description={metaDescription || description || 'Thêm mô tả SEO hoặc mô tả danh mục để xem trước đoạn này.'}
          slug={slug || 'danh-muc'}
          emptyDescription={!metaDescription && !description}
          fallbackTitleName="name"
          fallbackDescriptionName="description"
          pathPrefix="kien-thuc/danh-muc"
          corpus={corpus}
        />
      </div>
      <label class="mt-4 block">
        <span class="seo-label">
          <span>SEO Title</span>
          <span data-seo-title-count>{seoTitle.length} ký tự</span>
        </span>
        <input class="field" name="seoTitle" maxlength="180" value={seoTitle} />
        <span class="seo-hint">Để trống thì dùng tên danh mục.</span>
        <span class="seo-hint" data-seo-title-note>{titleLengthNote}</span>
      </label>
      <label class="mt-4 block">
        <span class="seo-label">
          <span>Meta Description</span>
          <span data-seo-desc-count>{metaDescription.length} ký tự</span>
        </span>
        <textarea class="field min-h-24" name="metaDescription" maxlength="300">{metaDescription}</textarea>
        <span class="seo-hint">Để trống thì dùng mô tả danh mục. Nên khoảng 70–160 ký tự.</span>
        <span class="seo-hint" data-seo-desc-note>{descriptionLengthNote}</span>
        <span class="seo-hint" data-seo-duplicate-note>{duplicateNote}</span>
      </label>
      <div class="category-actions">
        <button class="btn btn-primary" type="submit">{editingId ? 'Cập nhật' : 'Thêm danh mục'}</button>
        {editingId && <a class="btn" href={routes.adminCategories}>Hủy</a>}
      </div>
    </form>
    <section class="category-panel">
      <h2 class="category-panel-title">Danh sách</h2>
      {
        categories.length === 0 ? (
          <p class="text-muted">Chưa có danh mục.</p>
        ) : (
          <ul>
            {categories.map((category) => (
              <li class:list={['category-row', editingId === String(category.id) && 'category-row-current']}>
                <div>
                  <p class="font-semibold">{category.name}</p>
                  <p class="text-sm text-muted">{category.slug}</p>
                  <p class="text-sm text-muted">{category.postCount === 0 ? 'Chưa có bài' : category.postCount === 1 ? '1 bài' : `${category.postCount} bài`}</p>
                </div>
                <div class="flex gap-2">
                  <a class="btn" href={`${routes.adminCategories}?edit=${category.id}`}>Sửa</a>
                  <form method="post" onsubmit={`return confirm(${JSON.stringify(categoryDeleteWarning(category.postCount))})`}>
                    <input type="hidden" name="csrf" value={session.csrfToken} />
                    <input type="hidden" name="intent" value="delete" />
                    <input type="hidden" name="id" value={category.id} />
                    <button class="btn btn-accent" type="submit">Xóa</button>
                  </form>
                </div>
              </li>
            ))}
          </ul>
        )
      }
    </section>
  </div>
</AdminLayout>
