---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { activityActor } from '../../features/activity/log';
import { mutationError } from '../../features/auth/session';
import { deleteMaterial, listMaterials, saveMaterial } from '../../features/materials/materials';
import { deleteGroup, GROUP_NAME_MAX, moveGroup, saveGroup } from '../../features/materials/groups';
import { applyMaterialReprice, loadMaterialImpact, loadMaterialReprice } from '../../features/materials/pricing';
import {
  DEFAULT_ROUND_STEP,
  DEFAULT_TARGET_MARGIN,
  MATERIAL_MAX_PRICE,
  MAX_TARGET_MARGIN,
  ROUND_STEPS,
  parseRoundStep,
  parseTargetMargin,
  repriceLines,
  repriceNote,
  repriceOffer,
} from '../../features/materials/costing';
import { isProductStatus, PRODUCT_STATUS_LABELS } from '../../features/products/status';
import { createDb } from '../../lib/db/client';
import { getDbBinding } from '../../lib/cloudflare/env';
import { formatDateTime } from '../../lib/datetime';
import { formatVnd } from '../../lib/money';
import { routes } from '../../lib/routes';

const session = Astro.locals.adminSession;
if (!session) return Astro.redirect(routes.adminLogin);
if (session.role !== 'admin') {
  return new Response('Bạn không có quyền vào trang này.', { status: 403, headers: { 'content-type': 'text/plain; charset=utf-8' } });
}

const groupParam = Number(Astro.url.searchParams.get('nhom'));
const groupId = Number.isSafeInteger(groupParam) && groupParam > 0 ? groupParam : null;
const groupsParam = Astro.url.searchParams.get('groups') === '1';
const pageParam = Number(Astro.url.searchParams.get('page') ?? '1');
const page = Number.isInteger(pageParam) ? pageParam : 1;
const notice = Astro.url.searchParams.get('notice') ?? '';
const errorCode = Astro.url.searchParams.get('error') ?? '';
const db = createDb(getDbBinding());

// Điểm cuối JSON cho phần xem trước tác động khi đổi đơn giá (chỉ admin, đã kiểm tra quyền ở trên).
const impactId = Number(Astro.url.searchParams.get('impact'));
if (Astro.request.method === 'GET' && Number.isInteger(impactId) && impactId > 0) {
  const impact = await loadMaterialImpact(db, impactId);
  return new Response(JSON.stringify(impact), {
    headers: { 'content-type': 'application/json; charset=utf-8', 'cache-control': 'no-store' },
  });
}

let formError = '';
let saveFailed = false;
let groupsFailed = false;
let groupError = '';
let groupDraft = '';
let groupDraftId = '';
const values = { id: '', name: '', code: '', groupId: '', unitCost: '', active: true };

function listHref(next?: { notice?: string; error?: string; edit?: number; groups?: boolean; reprice?: number; truoc?: number; vatlieu?: number; n?: number; u?: number }): string {
  const params = new URLSearchParams();
  if (groupId) params.set('nhom', String(groupId));
  if (page > 1) params.set('page', String(page));
  if (next?.notice) params.set('notice', next.notice);
  if (next?.error) params.set('error', next.error);
  if (next?.edit) params.set('edit', String(next.edit));
  if (next?.groups) params.set('groups', '1');
  if (next?.reprice) params.set('reprice', String(next.reprice));
  if (next?.truoc !== undefined && next.reprice) params.set('truoc', String(next.truoc));
  if (next?.vatlieu) params.set('vatlieu', String(next.vatlieu));
  if (next?.n !== undefined && next.notice === 'repriced') params.set('n', String(next.n));
  if (next?.u !== undefined && next.notice === 'repriced') params.set('u', String(next.u));
  const text = params.toString();
  return text ? `${routes.adminMaterials}?${text}` : routes.adminMaterials;
}

function groupHref(id: number | null): string {
  const params = new URLSearchParams();
  if (id) params.set('nhom', String(id));
  const text = params.toString();
  return text ? `${routes.adminMaterials}?${text}` : routes.adminMaterials;
}

const wantsJson = Astro.request.headers.get('x-requested-with') === 'fetch';
const jsonHeaders = { 'content-type': 'application/json; charset=utf-8', 'cache-control': 'no-store' };

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const read = (name: string) => {
    const value = form.get(name);
    return typeof value === 'string' ? value : '';
  };
  const blocked = mutationError(Astro.request, session, form);
  const idValue = Number(read('id'));
  const id = Number.isInteger(idValue) && idValue > 0 ? idValue : undefined;
  const intent = read('intent');
  if (blocked) {
    if (wantsJson && (intent === 'save' || intent === 'group-save' || intent === 'group-delete' || intent === 'group-move')) {
      return new Response(JSON.stringify({ ok: false, error: blocked }), { status: 403, headers: jsonHeaders });
    }
    Astro.response.status = 403;
    formError = blocked;
  } else if (intent === 'delete' && id) {
    const removed = await deleteMaterial(db, id, await activityActor(db, session.userId));
    return Astro.redirect(listHref(removed.ok ? { notice: 'deleted' } : { error: removed.error.startsWith('Nguyên liệu đang') ? 'used' : 'missing' }), 303);
  } else if (intent === 'group-move' && id) {
    await moveGroup(db, id, read('direction') === 'up' ? 'up' : 'down');
    // Gọi bằng fetch từ hộp thoại nhóm: chỉ cần xác nhận, không chuyển trang.
    if (wantsJson) {
      return new Response(JSON.stringify({ ok: true }), { headers: jsonHeaders });
    }
    return Astro.redirect(listHref({ groups: true }), 303);
  } else if (intent === 'group-delete' && id) {
    const removed = await deleteGroup(db, id, await activityActor(db, session.userId));
    if (wantsJson) {
      if (!removed.ok) return new Response(JSON.stringify({ ok: false, error: removed.error }), { status: 422, headers: jsonHeaders });
      return new Response(JSON.stringify({ ok: true, notice: 'Đã xóa nhóm thành công.', id }), { headers: jsonHeaders });
    }
    if (removed.ok) return Astro.redirect(listHref({ groups: true, notice: 'group-deleted' }), 303);
    Astro.response.status = 422;
    groupsFailed = true;
    groupError = removed.error;
  } else if (intent === 'group-save') {
    groupDraftId = id ? String(id) : '';
    groupDraft = read('groupName');
    const saved = await saveGroup(db, { id, name: groupDraft }, Date.now(), await activityActor(db, session.userId));
    if (wantsJson) {
      if (!saved.ok) return new Response(JSON.stringify({ ok: false, error: saved.error }), { status: 422, headers: jsonHeaders });
      return new Response(
        JSON.stringify({
          ok: true,
          notice: id ? 'Đã đổi tên nhóm thành công.' : 'Đã thêm nhóm thành công.',
          created: !id,
          group: { id: saved.group.id, name: saved.group.name, materialCount: saved.group.materialCount },
        }),
        { headers: jsonHeaders },
      );
    }
    if (saved.ok) return Astro.redirect(listHref({ groups: true, notice: id ? 'group-saved' : 'group-created' }), 303);
    Astro.response.status = 422;
    groupsFailed = true;
    groupError = saved.error;
  } else if (intent === 'save') {
    values.id = id ? String(id) : '';
    values.name = read('name');
    values.code = read('code');
    values.groupId = read('groupId');
    values.unitCost = read('unitCost');
    values.active = read('active') === '1';
    const saved = await saveMaterial(
      db,
      { id, name: values.name, code: values.code, groupId: Number(values.groupId), unitCost: values.unitCost, active: values.active },
      Date.now(),
      await activityActor(db, session.userId),
    );
    if (wantsJson) {
      if (!saved.ok) return new Response(JSON.stringify({ ok: false, error: saved.error }), { status: 422, headers: jsonHeaders });
      if (saved.priceChanged) {
        return new Response(
          JSON.stringify({
            ok: true,
            reprice: true,
            id: saved.id,
            previous: saved.previousUnitCost,
            material: saved.material,
          }),
          { headers: jsonHeaders },
        );
      }
      return new Response(
        JSON.stringify({
          ok: true,
          notice: id ? 'Đã cập nhật nguyên liệu thành công.' : 'Đã thêm nguyên liệu thành công.',
          created: !id,
          material: saved.material,
        }),
        { headers: jsonHeaders },
      );
    }
    if (saved.ok && saved.priceChanged) return Astro.redirect(listHref({ reprice: saved.id, truoc: saved.previousUnitCost }), 303);
    if (saved.ok) return Astro.redirect(listHref({ notice: 'saved' }), 303);
    Astro.response.status = 422;
    formError = saved.error;
    saveFailed = true;
  } else if (intent === 'reprice' && id) {
    const previous = Number(read('truoc'));
    const currentUnit = Number(read('hien-tai'));
    const mode = read('mode') === 'margin' ? 'margin' : read('mode') === 'keep' ? 'keep' : 'none';
    const picked = form
      .getAll('ids')
      .map((value) => Number(value))
      .filter((value) => Number.isInteger(value) && value > 0);
    if (mode === 'none') return Astro.redirect(listHref({ notice: 'saved-price', vatlieu: id }), 303);
    if (picked.length === 0) return Astro.redirect(listHref({ reprice: id, truoc: previous, error: 'none' }), 303);
    const applied = await applyMaterialReprice(
      db,
      {
        materialId: id,
        previousUnitCost: previous,
        unitCost: currentUnit,
        mode,
        margin: parseTargetMargin(read('bien')),
        step: mode === 'keep' ? DEFAULT_ROUND_STEP : parseRoundStep(read('lam-tron')),
        ids: picked,
      },
      await activityActor(db, session.userId),
    );
    if (!applied.ok) {
      const code = applied.error.includes('sửa tiếp') ? 'stale' : 'reprice';
      return Astro.redirect(listHref({ notice: 'saved-price', error: code, vatlieu: id }), 303);
    }
    return Astro.redirect(listHref({ notice: 'repriced', vatlieu: id, n: applied.updated, u: applied.skipped }), 303);
  } else {
    Astro.response.status = 422;
    formError = 'Thao tác không hợp lệ.';
  }
}

const repriceParam = Number(Astro.url.searchParams.get('reprice'));
const truocText = Astro.url.searchParams.get('truoc');
const previousParam = Number(truocText);
const vatlieuParam = Number(Astro.url.searchParams.get('vatlieu'));
const focusMaterial = Number.isInteger(vatlieuParam) && vatlieuParam > 0 ? vatlieuParam : 0;
const updatedCount = Number(Astro.url.searchParams.get('n') ?? '0');
const skippedCount = Number(Astro.url.searchParams.get('u') ?? '0');
let repriceView: {
  id: number;
  name: string;
  unitCost: number;
  previous: number;
  total: number;
  mode: 'keep' | 'margin' | 'none';
  lines: ReturnType<typeof repriceLines>;
  payload: string;
} | null = null;

if (Astro.request.method === 'GET' && Number.isInteger(repriceParam) && repriceParam > 0) {
  const previousOk = truocText !== null && Number.isInteger(previousParam) && previousParam >= 0 && previousParam <= MATERIAL_MAX_PRICE;
  const context = previousOk ? await loadMaterialReprice(db, repriceParam) : null;
  const offer = context && context.unitCost !== previousParam ? repriceOffer(context.rows, previousParam, context.unitCost) : { open: false, mode: 'none' as const };
  if (!context || !offer.open) return Astro.redirect(listHref({ notice: 'saved-price', vatlieu: context ? repriceParam : focusMaterial || undefined }), 303);
  repriceView = {
    id: context.id,
    name: context.name,
    unitCost: context.unitCost,
    previous: previousParam,
    total: context.total,
    mode: offer.mode,
    lines: repriceLines(context.rows, previousParam, context.unitCost, offer.mode, DEFAULT_TARGET_MARGIN, DEFAULT_ROUND_STEP),
    payload: JSON.stringify({ previous: previousParam, unitCost: context.unitCost, rows: context.rows }),
  };
}

let result: Awaited<ReturnType<typeof listMaterials>> | null = null;
let loadError = '';
try {
  result = await listMaterials(db, { groupId, page });
} catch (error) {
  console.error(JSON.stringify({ event: 'material_list_failed', name: error instanceof Error ? error.name : 'unknown' }));
  loadError = 'Không tải được danh sách nguyên liệu.';
}

const editId = Number(Astro.url.searchParams.get('edit') ?? '');
const editing = Astro.request.method !== 'POST' && result ? result.rows.find((row) => row.id === editId) : undefined;
if (editing) {
  values.id = String(editing.id);
  values.name = editing.name;
  values.code = editing.code;
  values.groupId = editing.groupId === null ? '' : String(editing.groupId);
  values.unitCost = String(editing.unitCost);
  values.active = editing.active;
}
const dialogOpen = saveFailed || Boolean(editing);
const groupsOpen = groupsFailed || groupsParam;
const groupList = result?.groups ?? [];
const editingUsedBy = editing?.usedBy ?? 0;

const drafts = (result?.rows ?? []).map((row) => ({
  id: row.id,
  name: row.name,
  code: row.code,
  groupId: row.groupId === null ? '' : String(row.groupId),
  unitCost: String(row.unitCost),
  active: row.active,
  usedBy: row.usedBy,
}));

// Rows đã sắp theo nhóm; gom liên tiếp để mỗi nhóm là một khối.
const sections: { name: string; rows: NonNullable<typeof result>['rows'] }[] = [];
for (const row of result?.rows ?? []) {
  const last = sections[sections.length - 1];
  if (last && last.name === row.group) last.rows.push(row);
  else sections.push({ name: row.group, rows: [row] });
}

const stepLabels: Record<number, string> = { 1: 'Không làm tròn', 500: '500 ₫', 1000: '1.000 ₫', 5000: '5.000 ₫', 10000: '10.000 ₫' };
const percent = (value: number | null) => (value === null ? '—' : `${value}%`);
const pricingHref = focusMaterial > 0 ? `${routes.adminPricing}?vat-lieu=${focusMaterial}&loc=tat-ca` : routes.adminPricing;
const noticeText =
  notice === 'saved'
    ? 'Đã lưu nguyên liệu.'
    : notice === 'saved-price'
      ? 'Đã lưu nguyên liệu. Giá vốn các sản phẩm liên quan đã tự cập nhật. Giá bán giữ nguyên.'
      : notice === 'repriced'
        ? updatedCount > 0
          ? `Đã cập nhật giá bán ${updatedCount} sản phẩm.${skippedCount > 0 ? ` ${skippedCount} sản phẩm giữ nguyên vì giá không đổi hoặc chạm giá gốc.` : ''}`
          : 'Không có sản phẩm nào cần đổi giá bán.'
        : notice === 'deleted'
        ? 'Đã xóa nguyên liệu.'
        : notice === 'group-created'
          ? 'Đã tạo nhóm.'
          : notice === 'group-saved'
            ? 'Đã đổi tên nhóm.'
            : notice === 'group-deleted'
              ? 'Đã xóa nhóm.'
              : '';
const errorText =
  errorCode === 'used'
    ? 'Nguyên liệu đang được sản phẩm dùng, chưa xóa được. Hãy chuyển sang ngừng dùng.'
    : errorCode === 'missing'
      ? 'Không tìm thấy nguyên liệu.'
      : errorCode === 'none'
        ? 'Chưa chọn sản phẩm nào.'
        : errorCode === 'stale'
          ? 'Đơn giá vừa được sửa tiếp. Hãy sửa lại nếu vẫn muốn cập nhật giá bán.'
          : errorCode === 'reprice'
            ? 'Không cập nhật được giá bán.'
            : '';
const filtering = Boolean(groupId);

function pageHref(next: number): string {
  const params = new URLSearchParams();
  if (groupId) params.set('nhom', String(groupId));
  if (next > 1) params.set('page', String(next));
  const text = params.toString();
  return text ? `${routes.adminMaterials}?${text}` : routes.adminMaterials;
}
---

<AdminLayout title="Nguyên liệu">
  <p slot="lead" data-materials-lead>{result ? `${result.libraryTotal} nguyên liệu · ${result.groups.length} nhóm` : 'Quản lý nguyên liệu'}</p>
  <div slot="action" class="dash-quick">
    <button class="btn" type="button" data-groups-open>Quản lý nhóm</button>
    <button class="btn btn-primary" type="button" data-material-new>Thêm nguyên liệu</button>
  </div>
  {loadError && <p class="error-text mb-4" role="alert">{loadError}</p>}
  <p
    class="mb-4 text-primary-strong"
    role="status"
    data-materials-flash
    data-admin-flash
    hidden={!noticeText || !!formError}
  >
    {noticeText}
    {(notice === 'saved-price' || notice === 'repriced') && <> <a href={pricingHref}>Xem trên trang Định giá</a></>}
  </p>
  {errorText && !formError && <p class="error-text mb-4" role="alert" data-admin-flash>{errorText}</p>}
  {formError && !dialogOpen && <p class="error-text mb-4" role="alert">{formError}</p>}
  {
    result && result.libraryTotal === 0 && !filtering ? (
      <section class="cms-empty" data-materials-empty data-csrf={session.csrfToken}>
        <span class="cms-empty-icon" aria-hidden="true">
          <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="8" cy="9" r="3.2" />
            <circle cx="16" cy="9" r="3.2" />
            <circle cx="12" cy="16" r="3.2" />
          </svg>
        </span>
        <h2 class="cms-empty-title">Chưa có nguyên liệu nào</h2>
        <p class="cms-empty-text">Nhập các nguyên liệu làm vòng và đơn giá một lần. Từ bước sau, mỗi sản phẩm chọn nguyên liệu nó dùng và giá vốn tự tính.</p>
        <ul class="cms-empty-points">
          <li>Chia nhóm cho dễ tìm, ví dụ Charm bạc, Bi bạc, Đá - Hổ phách.</li>
          <li>Đổi đơn giá ở một chỗ, mọi sản phẩm dùng nguyên liệu đó cập nhật theo.</li>
          <li>Nguyên liệu đang được sản phẩm dùng không bị xóa nhầm.</li>
        </ul>
        <button class="btn btn-primary" type="button" data-material-new>Thêm nguyên liệu đầu tiên</button>
      </section>
    ) : result ? (
      <div data-materials-board data-csrf={session.csrfToken} data-filter-group={groupId ?? ''} data-library-total={result.libraryTotal}>
        <nav class="catalog-chips material-chips" aria-label="Lọc theo nhóm">
          <a class="chip" href={groupHref(null)} aria-current={groupId === null ? 'true' : undefined} data-chip-all>Tất cả ({result.libraryTotal})</a>
          {result.groups.map((item) => (
            <a class="chip" href={groupHref(item.id)} aria-current={groupId === item.id ? 'true' : undefined} data-chip-group={item.id}>
              {item.name} ({item.materialCount})
            </a>
          ))}
        </nav>
        <div data-materials-sections>
          {sections.length === 0 ? (
            <p class="post-empty" data-materials-empty-filter>Không có nguyên liệu khớp.</p>
          ) : (
            sections.map((section) => (
              <section class="material-group" aria-label={section.name} data-material-group={section.name}>
                <h2 class="material-group-title">
                  {section.name}
                  <span data-group-count>{section.rows.length} nguyên liệu</span>
                </h2>
                <table class="post-table material-table">
                  <colgroup>
                    <col />
                    <col class="material-col-price" />
                    <col class="material-col-use" />
                    <col class="material-col-time" />
                    <col class="material-col-actions" />
                  </colgroup>
                  <thead>
                    <tr>
                      <th>Nguyên liệu</th>
                      <th>Đơn giá</th>
                      <th>Số sản phẩm</th>
                      <th>Cập nhật</th>
                      <th>Thao tác</th>
                    </tr>
                  </thead>
                  <tbody>
                    {section.rows.map((row) => (
                      <tr data-material-row={row.id}>
                        <td>
                          <a class="post-title" href={`${routes.adminMaterials}?edit=${row.id}`} data-material-edit={row.id}>{row.name}</a>
                          {!row.active && <span class="material-off">Ngừng dùng</span>}
                          <p class="catalog-slug"><span class="truncate">{row.code}</span></p>
                        </td>
                        <td data-label="Đơn giá">
                          <button
                            type="button"
                            class="material-price material-price-edit"
                            data-material-price-edit
                            data-unit-cost={row.unitCost}
                            title="Sửa nhanh đơn giá"
                          >
                            {formatVnd(row.unitCost)}
                          </button>
                        </td>
                        <td data-label="Số sản phẩm">
                          <span class="catalog-count" class:list={[{ 'is-empty': row.usedBy === 0 }]}>{row.usedBy} sản phẩm</span>
                        </td>
                        <td data-label="Cập nhật">{formatDateTime(row.updatedAt)}</td>
                        <td data-label="Thao tác">
                          <div class="post-actions">
                            <a href={`${routes.adminMaterials}?edit=${row.id}`} data-material-edit={row.id}>Sửa</a>
                            <span class="post-actions-sep" aria-hidden="true">|</span>
                            {row.usedBy > 0 ? (
                              <button class="category-delete" type="button" disabled title="Đang có sản phẩm dùng, chưa xóa được.">Xóa</button>
                            ) : (
                              <form
                                method="post"
                                data-busy
                                data-confirm-title={`Xóa nguyên liệu “${row.name}”?`}
                                data-confirm="Nguyên liệu sẽ bị xóa vĩnh viễn. Thao tác này không hoàn tác."
                                data-confirm-ok="Xóa"
                                data-confirm-tone="danger"
                              >
                                <input type="hidden" name="csrf" value={session.csrfToken} />
                                <input type="hidden" name="intent" value="delete" />
                                <input type="hidden" name="id" value={row.id} />
                                <button class="category-delete" type="submit" data-keep-label="true">Xóa</button>
                              </form>
                            )}
                          </div>
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </section>
            ))
          )}
        </div>
        {result.pageCount > 1 && (
          <nav class="post-pager" aria-label="Phân trang">
            {result.page > 1 && <a class="btn" href={pageHref(result.page - 1)}>Trang trước</a>}
            <span>Trang {result.page}/{result.pageCount}</span>
            {result.page < result.pageCount && <a class="btn" href={pageHref(result.page + 1)}>Trang sau</a>}
          </nav>
        )}
      </div>
    ) : null
  }

  <dialog
    class="category-dialog"
    aria-labelledby="material-dialog-title"
    data-material-dialog
    data-csrf={session.csrfToken}
    data-open={dialogOpen ? 'true' : undefined}
    data-materials={JSON.stringify(drafts)}
  >
    <form method="post" data-busy data-material-ajax="save">
      <input type="hidden" name="csrf" value={session.csrfToken} />
      <input type="hidden" name="intent" value="save" />
      <input type="hidden" name="id" value={values.id} data-field="id" />
      <h2 id="material-dialog-title" class="text-lg font-semibold" data-material-title>{values.id ? 'Sửa nguyên liệu' : 'Thêm nguyên liệu'}</h2>
      {formError && dialogOpen && <p class="error-text mt-2" role="alert" data-material-form-error>{formError}</p>}
      <label class="mt-4 block">
        <span class="mb-1 block font-semibold">Tên nguyên liệu</span>
        <input class="field" name="name" required maxlength="120" value={values.name} data-field="name" />
      </label>
      <label class="mt-4 block">
        <span class="mb-1 block font-semibold">Nhóm</span>
        <select class="field" name="groupId" required data-field="groupId">
          <option value="" disabled selected={values.groupId === ''}>Chọn nhóm</option>
          {groupList.map((item) => <option value={item.id} selected={String(item.id) === values.groupId}>{item.name}</option>)}
        </select>
        <span class="seo-hint">
          {groupList.length === 0 ? 'Chưa có nhóm nào. ' : 'Cần nhóm mới? '}
          <button class="underline" type="button" data-groups-open>Quản lý nhóm</button>
        </span>
      </label>
      <label class="mt-4 block">
        <span class="mb-1 block font-semibold">Đơn giá (VND)</span>
        <input class="field" name="unitCost" required inputmode="numeric" maxlength="12" value={values.unitCost} data-field="unitCost" />
      </label>
      <div class="material-impact" data-material-impact aria-live="polite" hidden></div>
      <label class="mt-4 block">
        <span class="mb-1 block font-semibold">Mã</span>
        <input class="field" name="code" maxlength="60" value={values.code} readonly={Boolean(values.id)} data-field="code" placeholder="Để trống để tự tạo từ tên" />
        <span class="seo-hint" data-material-code-hint>{values.id ? 'Mã không đổi sau khi tạo.' : 'Mã dùng chữ thường, số và dấu gạch dưới.'}</span>
      </label>
      <label class="mt-4 flex items-center gap-2">
        <input type="checkbox" name="active" value="1" checked={values.active} data-field="active" />
        <span>Đang dùng</span>
      </label>
      <p class="seo-hint" data-material-used hidden>{editingUsedBy > 0 ? `Đang được ${editingUsedBy} sản phẩm dùng.` : ''}</p>
      <div class="category-actions">
        <button class="btn" type="button" data-material-close>Hủy</button>
        <button class="btn btn-primary" type="submit" data-material-save>Lưu</button>
      </div>
    </form>
  </dialog>

  <dialog
    class="category-dialog"
    aria-labelledby="group-dialog-title"
    data-groups-dialog
    data-csrf={session.csrfToken}
    data-open={groupsOpen ? 'true' : undefined}
  >
    <h2 id="group-dialog-title" class="text-lg font-semibold">Nhóm nguyên liệu</h2>
    {groupError && <p class="error-text mt-2" role="alert" data-group-form-error>{groupError}</p>}
    <p class="mt-2 text-primary-strong" role="status" data-group-flash hidden></p>
    <form method="post" data-busy data-group-ajax="save" class="mt-4 flex items-end gap-2">
      <input type="hidden" name="csrf" value={session.csrfToken} />
      <input type="hidden" name="intent" value="group-save" />
      <label class="block grow">
        <span class="mb-1 block font-semibold">Tên nhóm mới</span>
        <input class="field" name="groupName" required maxlength={GROUP_NAME_MAX} autocomplete="off" value={groupDraftId ? '' : groupDraft} data-group-create-name />
      </label>
      <button class="btn btn-primary" type="submit" data-group-create-submit>Thêm</button>
    </form>
    {groupList.length === 0 && <p class="seo-hint mt-4" data-groups-empty>Chưa có nhóm nào. Thêm nhóm đầu tiên ở trên.</p>}
    <ul class="mt-4 grid gap-3" data-groups-list>
      {
        groupList.map((item, index) => (
          <li class="flex flex-nowrap items-center gap-2" data-group-row={item.id}>
            <form method="post" data-busy data-group-ajax="save" class="flex min-w-0 grow items-center gap-2">
              <input type="hidden" name="csrf" value={session.csrfToken} />
              <input type="hidden" name="intent" value="group-save" />
              <input type="hidden" name="id" value={item.id} />
              <input class="field min-w-0 grow" name="groupName" required maxlength={GROUP_NAME_MAX} autocomplete="off" aria-label={`Tên nhóm ${item.name}`} value={groupDraftId === String(item.id) ? groupDraft : item.name} />
              <button class="btn shrink-0" type="submit">Lưu</button>
            </form>
            <span class:list={['catalog-count shrink-0', item.materialCount === 0 && 'is-empty']}>{item.materialCount} NL</span>
            <div class="flex shrink-0 items-center gap-2">
              <form method="post" data-group-move>
                <input type="hidden" name="csrf" value={session.csrfToken} />
                <input type="hidden" name="intent" value="group-move" />
                <input type="hidden" name="direction" value="up" />
                <input type="hidden" name="id" value={item.id} />
                <button class="btn" type="submit" aria-label={`Đưa “${item.name}” lên`} disabled={index === 0} data-keep-label="true">↑</button>
              </form>
              <form method="post" data-group-move>
                <input type="hidden" name="csrf" value={session.csrfToken} />
                <input type="hidden" name="intent" value="group-move" />
                <input type="hidden" name="direction" value="down" />
                <input type="hidden" name="id" value={item.id} />
                <button class="btn" type="submit" aria-label={`Đưa “${item.name}” xuống`} disabled={index === groupList.length - 1} data-keep-label="true">↓</button>
              </form>
              {item.materialCount > 0 ? (
                <button class="btn" type="button" disabled title="Nhóm đang có nguyên liệu, chưa xóa được." aria-label={`Xóa nhóm “${item.name}”`}>
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" width="18" height="18" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
                  </svg>
                </button>
              ) : (
                <form
                  method="post"
                  data-busy
                  data-group-ajax="delete"
                  data-confirm-title={`Xóa nhóm “${item.name}”?`}
                  data-confirm="Nhóm trống sẽ bị xóa. Thao tác này không hoàn tác."
                  data-confirm-ok="Xóa"
                  data-confirm-tone="danger"
                >
                  <input type="hidden" name="csrf" value={session.csrfToken} />
                  <input type="hidden" name="intent" value="group-delete" />
                  <input type="hidden" name="id" value={item.id} />
                  <button class="btn" type="submit" data-keep-label="true" aria-label={`Xóa nhóm “${item.name}”`}>
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" width="18" height="18" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
                    </svg>
                  </button>
                </form>
              )}
            </div>
          </li>
        ))
      }
    </ul>
    <div class="category-actions">
      <button class="btn" type="button" data-groups-close>Đóng</button>
    </div>
  </dialog>

  {
    repriceView && (
      <dialog
        class="reprice-dialog"
        aria-labelledby="reprice-dialog-title"
        data-reprice-dialog
        data-open="true"
        data-dismiss={listHref({ notice: 'saved-price', vatlieu: repriceView.id })}
        data-reprice={repriceView.payload}
      >
        <form
          method="post"
          data-busy
          data-confirm-title="Cập nhật giá bán?"
          data-confirm="Giá bán của các sản phẩm đã chọn sẽ đổi ngay trên website. Giá cũ không được lưu lại. Đơn hàng đã đặt giữ nguyên giá."
          data-confirm-ok="Cập nhật giá"
        >
          <input type="hidden" name="csrf" value={session.csrfToken} />
          <input type="hidden" name="intent" value="reprice" />
          <input type="hidden" name="id" value={repriceView.id} />
          <input type="hidden" name="truoc" value={repriceView.previous} />
          <input type="hidden" name="hien-tai" value={repriceView.unitCost} />
          <h2 id="reprice-dialog-title" class="text-lg font-semibold">Cập nhật giá bán</h2>
          <p class="mt-2">
            Đã đổi <strong>{repriceView.name}</strong> từ {formatVnd(repriceView.previous)} {repriceView.unitCost > repriceView.previous ? 'lên' : 'xuống'} {formatVnd(repriceView.unitCost)}. Có {repriceView.total} sản phẩm đang dùng nguyên liệu này.
          </p>
          {errorText && <p class="error-text mt-2" role="alert">{errorText}</p>}
          {repriceView.total > repriceView.lines.length && (
            <p class="pricing-summary">Chỉ liệt kê {repriceView.lines.length} sản phẩm đầu tiên. Số còn lại chỉnh trên trang Định giá.</p>
          )}
          <div class="reprice-modes">
            <label class="reprice-mode">
              <input type="radio" name="mode" value="keep" checked={repriceView.mode === 'keep'} data-reprice-mode />
              <span><strong>Giữ tiền lời</strong><span class="seo-hint">Cộng hoặc trừ đúng phần vốn thay đổi, rồi làm tròn lên 1.000 ₫.</span></span>
            </label>
            <label class="reprice-mode">
              <input type="radio" name="mode" value="margin" checked={repriceView.mode === 'margin'} data-reprice-mode />
              <span><strong>Đặt lại theo biên</strong><span class="seo-hint">Tính lại giá bán từ giá vốn mới, theo biên và bước làm tròn bên dưới.</span></span>
            </label>
            <div class="reprice-tools" data-reprice-tools hidden={repriceView.mode !== 'margin'}>
              <label>
                <span class="mb-1 block font-semibold">Biên mục tiêu (%)</span>
                <input class="field" name="bien" type="number" inputmode="numeric" min="0" max={MAX_TARGET_MARGIN} value={DEFAULT_TARGET_MARGIN} data-reprice-margin />
              </label>
              <label>
                <span class="mb-1 block font-semibold">Làm tròn lên</span>
                <select class="field" name="lam-tron" data-reprice-step>
                  {ROUND_STEPS.map((item) => <option value={item} selected={item === DEFAULT_ROUND_STEP}>{stepLabels[item]}</option>)}
                </select>
              </label>
            </div>
            <label class="reprice-mode">
              <input type="radio" name="mode" value="none" checked={repriceView.mode === 'none'} data-reprice-mode />
              <span><strong>Không đổi giá bán</strong><span class="seo-hint">Đơn giá mới vẫn được giữ. Giá bán các sản phẩm giữ nguyên.</span></span>
            </label>
          </div>
          <p class="pricing-summary">Đổi cách tính sẽ chọn lại những sản phẩm có giá mới. Dòng tô màu là biên dưới 30%, đang lỗ, hoặc bị giá gốc chặn.</p>
          <table class="post-table reprice-table">
            <thead>
              <tr>
                <th class="product-check">
                  <input type="checkbox" aria-label="Chọn tất cả sản phẩm có thể đổi giá" data-reprice-all disabled={!repriceView.lines.some((line) => line.changed)} />
                </th>
                <th>Sản phẩm</th>
                <th>Số lượng</th>
                <th>Giá hiện tại</th>
                <th>Giá mới</th>
                <th>Biên</th>
              </tr>
            </thead>
            <tbody>
              {repriceView.lines.map((line) => {
                const note = line.blocked && line.comparePrice !== null ? repriceNote(line, repriceView.mode, formatVnd(line.comparePrice)) : repriceNote(line, repriceView.mode, '');
                const marginLabel = repriceView.mode === 'none' || line.marginAfter === null ? `biên ${percent(line.marginBefore)}` : `${percent(line.marginBefore)} → ${percent(line.marginAfter)}`;
                return (
                  <tr class:list={[{ 'is-warn': line.warn }]} data-reprice-id={line.productId}>
                    <td class="product-check">
                      <input type="checkbox" name="ids" value={line.productId} checked={line.changed} disabled={!line.changed} aria-label={`Chọn ${line.name}`} data-reprice-check />
                    </td>
                    <td data-label="Sản phẩm">
                      <a class="post-title" href={routes.adminProduct(line.productId)} target="_blank" rel="noopener">{line.name}</a>
                      {isProductStatus(line.status) && line.status !== 'active' && <span class="material-off">{PRODUCT_STATUS_LABELS[line.status]}</span>}
                      {note && <span class="reprice-note" data-reprice-note>{note}</span>}
                      {!note && <span class="reprice-note" data-reprice-note hidden></span>}
                    </td>
                    <td data-label="Số lượng">{line.quantity}</td>
                    <td data-label="Giá hiện tại">{formatVnd(line.price)}</td>
                    <td data-label="Giá mới"><strong class="material-price" data-reprice-next>{line.nextPrice !== null && line.nextPrice !== line.price ? formatVnd(line.nextPrice) : '—'}</strong></td>
                    <td data-label="Biên"><span class="pricing-margin" data-reprice-margin-text data-tone={line.warn ? 'low' : 'ok'}>{marginLabel}</span></td>
                  </tr>
                );
              })}
            </tbody>
          </table>
          <div class="pricing-bar">
            <span data-reprice-count aria-live="polite">Đã chọn {repriceView.lines.filter((line) => line.changed).length}</span>
            <div class="dash-quick">
              <button class="btn" type="button" data-reprice-close>Để sau</button>
              <button class="btn btn-primary" type="submit" data-reprice-apply disabled={!repriceView.lines.some((line) => line.changed)}>Cập nhật giá bán</button>
            </div>
          </div>
        </form>
      </dialog>
    )
  }
</AdminLayout>

<script>
  import { LOW_MARGIN_PERCENT, impactOfUnitCostChange, parseMaterialPrice, type ImpactRow } from '../../features/materials/costing';

  type Draft = { id: number | null; name: string; code: string; groupId: string; unitCost: string; active: boolean; usedBy: number };
  type SavedMaterial = {
    id: number;
    code: string;
    name: string;
    groupId: number;
    group: string;
    unitCost: number;
    active: boolean;
    updatedAt: number;
    usedBy: number;
  };
  const dialog = document.querySelector('[data-material-dialog]');
  if (dialog instanceof HTMLDialogElement) {
    const modal = dialog;
    let drafts: Draft[] = JSON.parse(modal.dataset.materials ?? '[]');
    const field = (name: string) => modal.querySelector<HTMLInputElement>(`[data-field="${name}"]`);
    const groupSelect = modal.querySelector<HTMLSelectElement>('[data-field="groupId"]');
    const title = modal.querySelector('[data-material-title]');
    const hint = modal.querySelector('[data-material-code-hint]');
    const used = modal.querySelector('[data-material-used]');
    const flashEl = document.querySelector('[data-materials-flash]');
    let flashTimer = 0;
    const money = new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND', maximumFractionDigits: 0 });
    const when = new Intl.DateTimeFormat('vi-VN', { timeZone: 'Asia/Ho_Chi_Minh', dateStyle: 'short', timeStyle: 'short' });

    const showFlash = (message: string) => {
      if (!(flashEl instanceof HTMLElement)) return;
      flashEl.replaceChildren();
      flashEl.textContent = message;
      flashEl.hidden = !message;
      window.clearTimeout(flashTimer);
      if (!message) return;
      flashTimer = window.setTimeout(() => {
        flashEl.hidden = true;
        flashEl.textContent = '';
      }, 2000);
    };

    // Xem trước tác động: tải một lần danh sách sản phẩm đang dùng nguyên liệu, rồi tính lại mỗi khi đổi ô đơn giá.
    const impactBox = modal.querySelector('[data-material-impact]');
    let impact: { total: number; rows: ImpactRow[]; oldUnit: number } | null = null;
    let impactToken = 0;

    const percent = (value: number | null) => (value === null ? '—' : `${value}%`);

    const renderImpact = () => {
      if (!(impactBox instanceof HTMLElement)) return;
      impactBox.replaceChildren();
      impactBox.hidden = true;
      delete impactBox.dataset.tone;
      const cost = field('unitCost');
      if (!impact || !cost) return;
      const next = parseMaterialPrice(cost.value);
      if (next === null || next === impact.oldUnit) return;
      const result = impactOfUnitCostChange(impact.rows, impact.oldUnit, next);
      const low = Math.min(Math.abs(result.minDelta), Math.abs(result.maxDelta));
      const high = Math.max(Math.abs(result.minDelta), Math.abs(result.maxDelta));
      const range = low === high ? money.format(low) : `${money.format(low)} đến ${money.format(high)}`;
      const summary = document.createElement('p');
      summary.textContent = `Ảnh hưởng ${impact.total} sản phẩm. Giá vốn mỗi sản phẩm ${next > impact.oldUnit ? 'tăng' : 'giảm'} ${range}.`;
      impactBox.appendChild(summary);
      if (result.flagged.length > 0) {
        const lossCount = result.flagged.filter((item) => item.toneAfter === 'loss').length;
        const warn = document.createElement('p');
        warn.className = 'material-impact-warn';
        warn.textContent = `${result.flagged.length} sản phẩm sẽ có biên dưới ${LOW_MARGIN_PERCENT}%${lossCount > 0 ? ` (${lossCount} sản phẩm lỗ)` : ''}:`;
        const list = document.createElement('ul');
        for (const item of result.flagged.slice(0, 5)) {
          const row = document.createElement('li');
          row.textContent = `${item.name}: biên ${percent(item.marginBefore)} → ${percent(item.marginAfter)}`;
          list.appendChild(row);
        }
        if (result.flagged.length > 5) {
          const more = document.createElement('li');
          more.textContent = `…và ${result.flagged.length - 5} sản phẩm khác`;
          list.appendChild(more);
        }
        impactBox.appendChild(warn);
        impactBox.appendChild(list);
        impactBox.dataset.tone = 'warn';
      }
      if (impact.total > impact.rows.length) {
        const note = document.createElement('p');
        note.className = 'material-impact-note';
        note.textContent = `Chỉ tính ${impact.rows.length} sản phẩm đầu tiên trong ${impact.total}.`;
        impactBox.appendChild(note);
      }
      impactBox.hidden = false;
    };

    const loadImpact = async (draft: Draft) => {
      impactToken += 1;
      const token = impactToken;
      impact = null;
      renderImpact();
      if (draft.id === null || draft.usedBy < 1) return;
      try {
        const response = await fetch(`/admin/materials?impact=${draft.id}`, { headers: { accept: 'application/json' } });
        if (!response.ok) return;
        const data: unknown = await response.json();
        if (token !== impactToken) return;
        if (typeof data !== 'object' || data === null || !('rows' in data) || !('total' in data)) return;
        const { rows, total } = data as { rows: unknown; total: unknown };
        if (!Array.isArray(rows) || typeof total !== 'number') return;
        impact = { total, rows: rows as ImpactRow[], oldUnit: parseMaterialPrice(draft.unitCost) ?? 0 };
        renderImpact();
      } catch {
        // Xem trước chỉ là thông tin phụ: lỗi mạng thì vẫn lưu được bình thường.
      }
    };
    field('unitCost')?.addEventListener('input', renderImpact);

    const open = (draft: Draft) => {
      const editing = draft.id !== null;
      const id = field('id');
      if (id) id.value = editing ? String(draft.id) : '';
      const name = field('name');
      if (name) name.value = draft.name;
      if (groupSelect) groupSelect.value = draft.groupId;
      const cost = field('unitCost');
      if (cost) cost.value = draft.unitCost;
      const code = field('code');
      if (code) {
        code.value = draft.code;
        code.readOnly = editing;
      }
      const active = field('active');
      if (active) active.checked = draft.active;
      if (title) title.textContent = editing ? 'Sửa nguyên liệu' : 'Thêm nguyên liệu';
      if (hint) hint.textContent = editing ? 'Mã không đổi sau khi tạo.' : 'Mã dùng chữ thường, số và dấu gạch dưới.';
      if (used instanceof HTMLElement) {
        used.hidden = draft.usedBy < 1;
        used.textContent = draft.usedBy > 0 ? `Đang được ${draft.usedBy} sản phẩm dùng.` : '';
      }
      modal.querySelector('[data-material-form-error]')?.remove();
      const saveBtn = modal.querySelector<HTMLButtonElement>('[data-material-save]');
      if (saveBtn) {
        saveBtn.disabled = false;
        saveBtn.textContent = 'Lưu';
      }
      modal.showModal();
      name?.focus();
      void loadImpact(draft);
    };

    const csrf = () => modal.dataset.csrf ?? document.querySelector<HTMLElement>('[data-materials-board], [data-materials-empty]')?.dataset.csrf ?? '';

    const syncLead = (libraryTotal: number) => {
      const lead = document.querySelector('[data-materials-lead]');
      if (!(lead instanceof HTMLElement)) return;
      const groupCount = document.querySelectorAll('[data-groups-list] [data-group-row]').length || document.querySelectorAll('[data-chip-group]').length;
      lead.textContent = `${libraryTotal} nguyên liệu · ${groupCount} nhóm`;
    };

    const bumpChip = (groupId: number, groupName: string, delta: number) => {
      const all = document.querySelector('[data-chip-all]');
      const board = document.querySelector('[data-materials-board]');
      if (all instanceof HTMLElement && board instanceof HTMLElement) {
        const next = Math.max(0, Number(board.dataset.libraryTotal ?? '0') + delta);
        board.dataset.libraryTotal = String(next);
        all.textContent = `Tất cả (${next})`;
        syncLead(next);
      }
      const chip = document.querySelector(`[data-chip-group="${groupId}"]`);
      if (chip instanceof HTMLElement) {
        const match = chip.textContent?.match(/^(.*)\((\d+)\)\s*$/);
        const count = Math.max(0, (match ? Number(match[2]) : 0) + delta);
        chip.textContent = `${match?.[1]?.trim() || groupName} (${count})`;
      }
      const groupRow = document.querySelector(`[data-group-row="${groupId}"] .catalog-count`);
      if (groupRow instanceof HTMLElement) {
        const match = groupRow.textContent?.match(/^(\d+)/);
        const count = Math.max(0, (match ? Number(match[1]) : 0) + delta);
        groupRow.textContent = `${count} NL`;
        groupRow.classList.toggle('is-empty', count === 0);
      }
    };

    const priceEditButton = (unitCost: number) => {
      const price = document.createElement('button');
      price.type = 'button';
      price.className = 'material-price material-price-edit';
      price.dataset.materialPriceEdit = '';
      price.dataset.unitCost = String(unitCost);
      price.title = 'Sửa nhanh đơn giá';
      price.textContent = money.format(unitCost);
      return price;
    };

    const buildRow = (material: SavedMaterial) => {
      const tr = document.createElement('tr');
      tr.dataset.materialRow = String(material.id);
      const nameTd = document.createElement('td');
      const link = document.createElement('a');
      link.className = 'post-title';
      link.href = `${location.pathname}?edit=${material.id}`;
      link.dataset.materialEdit = String(material.id);
      link.textContent = material.name;
      nameTd.append(link);
      if (!material.active) {
        const off = document.createElement('span');
        off.className = 'material-off';
        off.textContent = 'Ngừng dùng';
        nameTd.append(off);
      }
      const slug = document.createElement('p');
      slug.className = 'catalog-slug';
      const code = document.createElement('span');
      code.className = 'truncate';
      code.textContent = material.code;
      slug.append(code);
      nameTd.append(slug);

      const priceTd = document.createElement('td');
      priceTd.dataset.label = 'Đơn giá';
      priceTd.append(priceEditButton(material.unitCost));

      const usedTd = document.createElement('td');
      usedTd.dataset.label = 'Số sản phẩm';
      const usedBadge = document.createElement('span');
      usedBadge.className = material.usedBy === 0 ? 'catalog-count is-empty' : 'catalog-count';
      usedBadge.textContent = `${material.usedBy} sản phẩm`;
      usedTd.append(usedBadge);

      const timeTd = document.createElement('td');
      timeTd.dataset.label = 'Cập nhật';
      timeTd.textContent = when.format(new Date(material.updatedAt));

      const actionsTd = document.createElement('td');
      actionsTd.dataset.label = 'Thao tác';
      const actions = document.createElement('div');
      actions.className = 'post-actions';
      const edit = document.createElement('a');
      edit.href = `${location.pathname}?edit=${material.id}`;
      edit.dataset.materialEdit = String(material.id);
      edit.textContent = 'Sửa';
      const sep = document.createElement('span');
      sep.className = 'post-actions-sep';
      sep.setAttribute('aria-hidden', 'true');
      sep.textContent = '|';
      actions.append(edit, sep);
      if (material.usedBy > 0) {
        const disabled = document.createElement('button');
        disabled.className = 'category-delete';
        disabled.type = 'button';
        disabled.disabled = true;
        disabled.title = 'Đang có sản phẩm dùng, chưa xóa được.';
        disabled.textContent = 'Xóa';
        actions.append(disabled);
      } else {
        const form = document.createElement('form');
        form.method = 'post';
        form.dataset.busy = '';
        form.dataset.confirmTitle = `Xóa nguyên liệu “${material.name}”?`;
        form.dataset.confirm = 'Nguyên liệu sẽ bị xóa vĩnh viễn. Thao tác này không hoàn tác.';
        form.dataset.confirmOk = 'Xóa';
        form.dataset.confirmTone = 'danger';
        for (const [name, value] of [
          ['csrf', csrf()],
          ['intent', 'delete'],
          ['id', String(material.id)],
        ] as const) {
          const input = document.createElement('input');
          input.type = 'hidden';
          input.name = name;
          input.value = value;
          form.append(input);
        }
        const del = document.createElement('button');
        del.className = 'category-delete';
        del.type = 'submit';
        del.dataset.keepLabel = 'true';
        del.textContent = 'Xóa';
        form.append(del);
        actions.append(form);
      }
      actionsTd.append(actions);
      tr.append(nameTd, priceTd, usedTd, timeTd, actionsTd);
      return tr;
    };

    const ensureBoard = (material: SavedMaterial) => {
      let board = document.querySelector('[data-materials-board]');
      if (board instanceof HTMLElement) return board;
      const empty = document.querySelector('[data-materials-empty]');
      board = document.createElement('div');
      board.setAttribute('data-materials-board', '');
      (board as HTMLElement).dataset.csrf = csrf();
      (board as HTMLElement).dataset.filterGroup = '';
      (board as HTMLElement).dataset.libraryTotal = '0';
      const chips = document.createElement('nav');
      chips.className = 'catalog-chips material-chips';
      chips.setAttribute('aria-label', 'Lọc theo nhóm');
      const all = document.createElement('a');
      all.className = 'chip';
      all.href = location.pathname;
      all.dataset.chipAll = '';
      all.setAttribute('aria-current', 'true');
      all.textContent = 'Tất cả (0)';
      chips.append(all);
      if (groupSelect) {
        for (const option of groupSelect.options) {
          if (!option.value) continue;
          const chip = document.createElement('a');
          chip.className = 'chip';
          chip.href = `${location.pathname}?nhom=${option.value}`;
          chip.dataset.chipGroup = option.value;
          chip.textContent = `${option.textContent ?? material.group} (0)`;
          chips.append(chip);
        }
      }
      const sections = document.createElement('div');
      sections.dataset.materialsSections = '';
      board.append(chips, sections);
      empty?.replaceWith(board);
      return board as HTMLElement;
    };

    const ensureSection = (board: HTMLElement, groupName: string) => {
      const host = board.querySelector('[data-materials-sections]');
      if (!(host instanceof HTMLElement)) return null;
      host.querySelector('[data-materials-empty-filter]')?.remove();
      let section = [...host.querySelectorAll('[data-material-group]')].find(
        (node) => node instanceof HTMLElement && node.dataset.materialGroup === groupName,
      );
      if (section instanceof HTMLElement) return section;
      section = document.createElement('section');
      section.className = 'material-group';
      section.setAttribute('aria-label', groupName);
      (section as HTMLElement).dataset.materialGroup = groupName;
      const heading = document.createElement('h2');
      heading.className = 'material-group-title';
      heading.append(document.createTextNode(groupName + ' '));
      const count = document.createElement('span');
      count.dataset.groupCount = '';
      count.textContent = '0 nguyên liệu';
      heading.append(count);
      const table = document.createElement('table');
      table.className = 'post-table material-table';
      table.innerHTML =
        '<colgroup><col /><col class="material-col-price" /><col class="material-col-use" /><col class="material-col-time" /><col class="material-col-actions" /></colgroup><thead><tr><th>Nguyên liệu</th><th>Đơn giá</th><th>Số sản phẩm</th><th>Cập nhật</th><th>Thao tác</th></tr></thead><tbody></tbody>';
      section.append(heading, table);
      host.append(section);
      return section as HTMLElement;
    };

    const upsertMaterial = (material: SavedMaterial, created: boolean) => {
      const board = ensureBoard(material);
      const filter = board.dataset.filterGroup ?? '';
      const visible = !filter || filter === String(material.groupId);
      const existing = document.querySelector(`[data-material-row="${material.id}"]`);
      const draft: Draft = {
        id: material.id,
        name: material.name,
        code: material.code,
        groupId: String(material.groupId),
        unitCost: String(material.unitCost),
        active: material.active,
        usedBy: material.usedBy,
      };
      const index = drafts.findIndex((item) => item.id === material.id);
      if (index >= 0) drafts[index] = draft;
      else drafts.unshift(draft);
      modal.dataset.materials = JSON.stringify(drafts);

      if (created) bumpChip(material.groupId, material.group, 1);

      if (existing) {
        const oldSection = existing.closest('[data-material-group]');
        existing.remove();
        if (oldSection instanceof HTMLElement) {
          const oldBody = oldSection.querySelector('tbody');
          const oldCount = oldSection.querySelector('[data-group-count]');
          if (oldBody && oldCount) oldCount.textContent = `${oldBody.children.length} nguyên liệu`;
          if (oldBody && oldBody.children.length === 0) oldSection.remove();
        }
      }

      if (!visible) return;
      const section = ensureSection(board, material.group);
      const body = section?.querySelector('tbody');
      if (!(body instanceof HTMLTableSectionElement)) return;
      body.prepend(buildRow(material));
      const countEl = section?.querySelector('[data-group-count]');
      if (countEl) countEl.textContent = `${body.children.length} nguyên liệu`;
    };

    const showFormError = (message: string) => {
      modal.querySelector('[data-material-form-error]')?.remove();
      const err = document.createElement('p');
      err.className = 'error-text mt-2';
      err.setAttribute('role', 'alert');
      err.dataset.materialFormError = '';
      err.textContent = message;
      title?.after(err);
    };

    const unlock = (form: HTMLFormElement) => {
      const saveBtn = form.querySelector<HTMLButtonElement>('[data-material-save]');
      if (saveBtn) {
        saveBtn.disabled = false;
        saveBtn.textContent = 'Lưu';
      }
    };

    for (const button of document.querySelectorAll('[data-material-new]')) {
      button.addEventListener('click', () => open({ id: null, name: '', code: '', groupId: '', unitCost: '', active: true, usedBy: 0 }));
    }
    for (const button of modal.querySelectorAll('[data-groups-open]')) {
      button.addEventListener('click', () => modal.close());
    }

    // Sửa nhanh đơn giá ngay trên bảng: click số → gõ → Enter/blur lưu; Esc hủy. Đổi giá vẫn đi luồng reprice.
    type PriceEdit = { row: HTMLTableRowElement; input: HTMLInputElement; original: number; skipBlur: boolean };
    let priceEdit: PriceEdit | null = null;

    const renderPriceCell = (td: HTMLTableCellElement, unitCost: number) => {
      td.replaceChildren(priceEditButton(unitCost));
    };

    const cancelPriceEdit = () => {
      if (!priceEdit) return;
      const { row, original } = priceEdit;
      priceEdit = null;
      const td = row.querySelector<HTMLTableCellElement>('td[data-label="Đơn giá"]');
      if (td) renderPriceCell(td, original);
    };

    const commitPriceEdit = async () => {
      if (!priceEdit || priceEdit.input.dataset.saving === '1') return;
      const edit = priceEdit;
      const id = Number(edit.row.dataset.materialRow);
      const draft = drafts.find((item) => item.id === id);
      if (!draft || draft.id === null) {
        cancelPriceEdit();
        return;
      }
      const next = parseMaterialPrice(edit.input.value);
      if (next === null) {
        edit.skipBlur = false;
        edit.input.setCustomValidity('Đơn giá là số nguyên VND, từ 0 đến 99.999.999.');
        edit.input.reportValidity();
        edit.input.focus();
        return;
      }
      edit.input.setCustomValidity('');
      if (next === edit.original) {
        cancelPriceEdit();
        return;
      }
      edit.input.dataset.saving = '1';
      edit.input.disabled = true;
      const body = new FormData();
      body.set('csrf', csrf());
      body.set('intent', 'save');
      body.set('id', String(draft.id));
      body.set('name', draft.name);
      body.set('code', draft.code);
      body.set('groupId', draft.groupId);
      body.set('unitCost', String(next));
      if (draft.active) body.set('active', '1');
      try {
        const response = await fetch(location.pathname, {
          method: 'POST',
          body,
          headers: { 'x-requested-with': 'fetch' },
        });
        const data = (await response.json()) as {
          ok?: boolean;
          error?: string;
          notice?: string;
          reprice?: boolean;
          id?: number;
          previous?: number;
          material?: SavedMaterial;
        };
        if (!response.ok || !data.ok || !data.material) {
          edit.skipBlur = false;
          edit.input.disabled = false;
          delete edit.input.dataset.saving;
          edit.input.setCustomValidity(data.error || 'Chưa lưu được đơn giá.');
          edit.input.reportValidity();
          edit.input.focus();
          return;
        }
        if (data.reprice && data.id != null && data.previous != null) {
          const url = new URL(location.href);
          url.searchParams.set('reprice', String(data.id));
          url.searchParams.set('truoc', String(data.previous));
          location.assign(url);
          return;
        }
        priceEdit = null;
        upsertMaterial(data.material, false);
        showFlash(data.notice || 'Đã cập nhật đơn giá.');
      } catch {
        edit.skipBlur = false;
        edit.input.disabled = false;
        delete edit.input.dataset.saving;
        edit.input.setCustomValidity('Không kết nối được máy chủ.');
        edit.input.reportValidity();
        edit.input.focus();
      }
    };

    const openPriceEdit = (button: HTMLButtonElement) => {
      if (priceEdit?.input.dataset.saving === '1') return;
      if (priceEdit) cancelPriceEdit();
      const row = button.closest<HTMLTableRowElement>('tr[data-material-row]');
      const td = button.closest<HTMLTableCellElement>('td[data-label="Đơn giá"]');
      if (!row || !td) return;
      const id = Number(row.dataset.materialRow);
      const draft = drafts.find((item) => item.id === id);
      if (!draft) return;
      const original = Number(button.dataset.unitCost);
      const baseline = Number.isFinite(original) ? original : (parseMaterialPrice(draft.unitCost) ?? 0);
      const input = document.createElement('input');
      input.className = 'field material-price-input';
      input.type = 'text';
      input.inputMode = 'numeric';
      input.autocomplete = 'off';
      input.value = String(baseline);
      input.setAttribute('aria-label', `Đơn giá ${draft.name}`);
      const state: PriceEdit = { row, input, original: baseline, skipBlur: false };
      priceEdit = state;
      td.replaceChildren(input);
      input.focus();
      input.select();
      input.addEventListener('keydown', (event) => {
        if (event.key === 'Enter') {
          event.preventDefault();
          state.skipBlur = true;
          void commitPriceEdit();
          return;
        }
        if (event.key === 'Escape') {
          event.preventDefault();
          state.skipBlur = true;
          cancelPriceEdit();
        }
      });
      input.addEventListener('blur', () => {
        if (state.skipBlur) {
          state.skipBlur = false;
          return;
        }
        void commitPriceEdit();
      });
      input.addEventListener('input', () => input.setCustomValidity(''));
    };

    document.addEventListener('click', (event) => {
      if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      const target = event.target instanceof Element ? event.target : null;
      if (!target) return;
      const priceBtn = target.closest<HTMLButtonElement>('[data-material-price-edit]');
      if (priceBtn) {
        event.preventDefault();
        openPriceEdit(priceBtn);
        return;
      }
      const link = target.closest('a[data-material-edit]');
      if (!(link instanceof HTMLAnchorElement)) return;
      const draft = drafts.find((item) => String(item.id) === link.dataset.materialEdit);
      if (!draft) return;
      event.preventDefault();
      open(draft);
    });
    modal.addEventListener('click', (event) => {
      if (event.target instanceof Element && event.target.closest('[data-material-close]')) {
        modal.close();
        return;
      }
      if (event.target !== modal) return;
      const box = modal.getBoundingClientRect();
      const inside = event.clientX >= box.left && event.clientX <= box.right && event.clientY >= box.top && event.clientY <= box.bottom;
      if (!inside) modal.close();
    });
    modal.addEventListener('close', () => {
      impactToken += 1;
      impact = null;
      renderImpact();
      const url = new URL(location.href);
      if (!url.searchParams.has('edit')) return;
      url.searchParams.delete('edit');
      history.replaceState(null, '', url);
    });
    modal.addEventListener(
      'submit',
      (event) => {
        const form = event.target;
        if (!(form instanceof HTMLFormElement) || form.dataset.materialAjax !== 'save') return;
        if (event.defaultPrevented) return;
        event.preventDefault();
        event.stopPropagation();
        const body = new FormData(form);
        void (async () => {
          try {
            const response = await fetch(location.pathname, {
              method: 'POST',
              body,
              headers: { 'x-requested-with': 'fetch' },
            });
            const data = (await response.json()) as {
              ok?: boolean;
              error?: string;
              notice?: string;
              created?: boolean;
              reprice?: boolean;
              id?: number;
              previous?: number;
              material?: SavedMaterial;
            };
            if (!response.ok || !data.ok || !data.material) {
              unlock(form);
              showFormError(data.error || 'Chưa lưu được nguyên liệu.');
              return;
            }
            if (data.reprice && data.id != null && data.previous != null) {
              const url = new URL(location.href);
              url.searchParams.set('reprice', String(data.id));
              url.searchParams.set('truoc', String(data.previous));
              location.assign(url);
              return;
            }
            upsertMaterial(data.material, Boolean(data.created));
            modal.close();
            unlock(form);
            showFlash(data.notice || 'Đã lưu nguyên liệu.');
          } catch {
            unlock(form);
            showFormError('Không kết nối được máy chủ.');
          }
        })();
      },
      true,
    );
    if (modal.dataset.open === 'true') {
      const usedNow = modal.querySelector('[data-material-used]');
      if (usedNow instanceof HTMLElement) usedNow.hidden = !usedNow.textContent;
      modal.showModal();
      // Mở sẵn khi sửa (không qua JS): lấy đơn giá đã lưu làm mốc so sánh, không dùng giá vừa gõ.
      const stored = drafts.find((item) => String(item.id) === field('id')?.value);
      if (stored) void loadImpact(stored);
    }
  }

  const groupsDialog = document.querySelector('[data-groups-dialog]');
  if (groupsDialog instanceof HTMLDialogElement) {
    const groupsModal = groupsDialog;
    const csrf = () => groupsModal.dataset.csrf ?? '';
    const flashEl = groupsModal.querySelector('[data-group-flash]');
    let flashTimer = 0;

    const showFlash = (message: string, isError = false) => {
      if (!(flashEl instanceof HTMLElement)) return;
      flashEl.textContent = message;
      flashEl.hidden = !message;
      flashEl.classList.toggle('error-text', isError);
      flashEl.classList.toggle('text-primary-strong', !isError);
      window.clearTimeout(flashTimer);
      if (!message) return;
      flashTimer = window.setTimeout(() => {
        flashEl.hidden = true;
        flashEl.textContent = '';
      }, 2000);
    };

    for (const button of document.querySelectorAll('[data-groups-open]')) {
      button.addEventListener('click', () => groupsModal.showModal());
    }
    groupsModal.addEventListener('click', (event) => {
      if (event.target instanceof Element && event.target.closest('[data-groups-close]')) {
        groupsModal.close();
        return;
      }
      if (event.target !== groupsModal) return;
      const box = groupsModal.getBoundingClientRect();
      const inside = event.clientX >= box.left && event.clientX <= box.right && event.clientY >= box.top && event.clientY <= box.bottom;
      if (!inside) groupsModal.close();
    });
    groupsModal.addEventListener('close', () => {
      const url = new URL(location.href);
      if (!url.searchParams.has('groups')) return;
      url.searchParams.delete('groups');
      history.replaceState(null, '', url);
    });
    if (groupsModal.dataset.open === 'true') groupsModal.showModal();

    // Đổi thứ tự nhóm ngay trên màn hình, lưu nền bằng fetch (không tải lại trang). Các yêu cầu chạy lần lượt để thứ tự trên server khớp.
    const rows = () => [...groupsModal.querySelectorAll('li[data-group-row]')];
    const syncRows = () => {
      const list = rows();
      list.forEach((row, index) => {
        const up = row.querySelector('input[value="up"]')?.closest('form')?.querySelector('button');
        const down = row.querySelector('input[value="down"]')?.closest('form')?.querySelector('button');
        if (up instanceof HTMLButtonElement) up.disabled = index === 0;
        if (down instanceof HTMLButtonElement) down.disabled = index === list.length - 1;
      });
      // Thanh lọc nhóm ở trang chính đi theo cùng thứ tự.
      const chips = document.querySelector('.material-chips');
      if (!chips) return;
      for (const row of list) {
        const chip = chips.querySelector(`a[href$="nhom=${row.getAttribute('data-group-row')}"], a[href*="nhom=${row.getAttribute('data-group-row')}&"]`);
        if (chip) chips.appendChild(chip);
      }
    };
    const syncLead = () => {
      const lead = document.querySelector('[data-materials-lead]');
      if (!(lead instanceof HTMLElement)) return;
      const match = lead.textContent?.match(/^(\d+)\s+nguyên liệu/);
      if (!match) return;
      lead.textContent = `${match[1]} nguyên liệu · ${rows().length} nhóm`;
    };
    const showMoveError = () => {
      groupsModal.querySelector('[data-group-move-error]')?.remove();
      const message = document.createElement('p');
      message.className = 'error-text mt-2';
      message.setAttribute('role', 'alert');
      message.setAttribute('data-group-move-error', '');
      message.textContent = 'Chưa lưu được thứ tự nhóm. Hãy tải lại trang và thử lại.';
      const heading = groupsModal.querySelector('h2');
      heading?.parentNode?.insertBefore(message, heading.nextSibling);
    };
    const showGroupError = (message: string) => {
      groupsModal.querySelector('[data-group-form-error]')?.remove();
      const err = document.createElement('p');
      err.className = 'error-text mt-2';
      err.setAttribute('role', 'alert');
      err.dataset.groupFormError = '';
      err.textContent = message;
      groupsModal.querySelector('h2')?.after(err);
    };
    const unlock = (form: HTMLFormElement) => {
      for (const button of form.querySelectorAll('button[type="submit"]')) {
        if (!(button instanceof HTMLButtonElement)) continue;
        button.disabled = false;
        if (button.hasAttribute('data-group-create-submit')) button.textContent = 'Thêm';
        else if (button.dataset.keepLabel !== 'true') button.textContent = 'Lưu';
      }
    };
    const groupHrefOf = (id: number | null) => {
      if (!id) return location.pathname;
      return `${location.pathname}?nhom=${id}`;
    };
    const syncSelect = (group: { id: number; name: string }, mode: 'upsert' | 'remove') => {
      for (const select of document.querySelectorAll('select[name="groupId"]')) {
        if (!(select instanceof HTMLSelectElement)) continue;
        const existing = select.querySelector(`option[value="${group.id}"]`);
        if (mode === 'remove') {
          existing?.remove();
          continue;
        }
        if (existing instanceof HTMLOptionElement) {
          existing.textContent = group.name;
          continue;
        }
        const option = document.createElement('option');
        option.value = String(group.id);
        option.textContent = group.name;
        select.append(option);
      }
    };
    const syncChip = (group: { id: number; name: string; materialCount: number }, mode: 'upsert' | 'remove') => {
      const chips = document.querySelector('.material-chips');
      if (!chips) return;
      const found = chips.querySelector(`a[href$="nhom=${group.id}"], a[href*="nhom=${group.id}&"]`);
      if (mode === 'remove') {
        found?.remove();
        return;
      }
      if (found) {
        found.textContent = `${group.name} (${group.materialCount})`;
        return;
      }
      const chip = document.createElement('a');
      chip.className = 'chip';
      chip.href = groupHrefOf(group.id);
      chip.textContent = `${group.name} (${group.materialCount})`;
      chips.append(chip);
    };
    const buildRow = (group: { id: number; name: string; materialCount: number }) => {
      const li = document.createElement('li');
      li.className = 'flex flex-nowrap items-center gap-2';
      li.dataset.groupRow = String(group.id);

      const saveForm = document.createElement('form');
      saveForm.method = 'post';
      saveForm.dataset.busy = '';
      saveForm.dataset.groupAjax = 'save';
      saveForm.className = 'flex min-w-0 grow items-center gap-2';
      for (const [name, value] of [
        ['csrf', csrf()],
        ['intent', 'group-save'],
        ['id', String(group.id)],
      ] as const) {
        const input = document.createElement('input');
        input.type = 'hidden';
        input.name = name;
        input.value = value;
        saveForm.append(input);
      }
      const nameInput = document.createElement('input');
      nameInput.className = 'field min-w-0 grow';
      nameInput.name = 'groupName';
      nameInput.required = true;
      nameInput.maxLength = 80;
      nameInput.autocomplete = 'off';
      nameInput.setAttribute('aria-label', `Tên nhóm ${group.name}`);
      nameInput.value = group.name;
      const saveBtn = document.createElement('button');
      saveBtn.className = 'btn shrink-0';
      saveBtn.type = 'submit';
      saveBtn.textContent = 'Lưu';
      saveForm.append(nameInput, saveBtn);

      const count = document.createElement('span');
      count.className = group.materialCount === 0 ? 'catalog-count shrink-0 is-empty' : 'catalog-count shrink-0';
      count.textContent = `${group.materialCount} NL`;

      const actions = document.createElement('div');
      actions.className = 'flex shrink-0 items-center gap-2';

      const move = (direction: 'up' | 'down', label: string) => {
        const form = document.createElement('form');
        form.method = 'post';
        form.dataset.groupMove = '';
        for (const [name, value] of [
          ['csrf', csrf()],
          ['intent', 'group-move'],
          ['direction', direction],
          ['id', String(group.id)],
        ] as const) {
          const input = document.createElement('input');
          input.type = 'hidden';
          input.name = name;
          input.value = value;
          form.append(input);
        }
        const button = document.createElement('button');
        button.className = 'btn';
        button.type = 'submit';
        button.dataset.keepLabel = 'true';
        button.setAttribute('aria-label', label);
        button.textContent = direction === 'up' ? '↑' : '↓';
        form.append(button);
        return form;
      };

      const deleteForm = document.createElement('form');
      deleteForm.method = 'post';
      deleteForm.dataset.busy = '';
      deleteForm.dataset.groupAjax = 'delete';
      deleteForm.dataset.confirmTitle = `Xóa nhóm “${group.name}”?`;
      deleteForm.dataset.confirm = 'Nhóm trống sẽ bị xóa. Thao tác này không hoàn tác.';
      deleteForm.dataset.confirmOk = 'Xóa';
      deleteForm.dataset.confirmTone = 'danger';
      for (const [name, value] of [
        ['csrf', csrf()],
        ['intent', 'group-delete'],
        ['id', String(group.id)],
      ] as const) {
        const input = document.createElement('input');
        input.type = 'hidden';
        input.name = name;
        input.value = value;
        deleteForm.append(input);
      }
      const del = document.createElement('button');
      del.className = 'btn';
      del.type = 'submit';
      del.dataset.keepLabel = 'true';
      del.setAttribute('aria-label', `Xóa nhóm “${group.name}”`);
      del.innerHTML =
        '<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" width="18" height="18" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" /></svg>';
      deleteForm.append(del);

      actions.append(move('up', `Đưa “${group.name}” lên`), move('down', `Đưa “${group.name}” xuống`), deleteForm);
      li.append(saveForm, count, actions);
      return li;
    };

    let queue: Promise<void> = Promise.resolve();
    groupsModal.addEventListener('submit', (event) => {
      const form = event.target;
      if (!(form instanceof HTMLFormElement) || !form.hasAttribute('data-group-move')) return;
      event.preventDefault();
      event.stopPropagation();
      const row = form.closest('li[data-group-row]');
      const direction = new FormData(form).get('direction');
      const sibling = direction === 'up' ? row?.previousElementSibling : row?.nextElementSibling;
      if (!row || !sibling) return;
      if (direction === 'up') row.parentNode?.insertBefore(row, sibling);
      else row.parentNode?.insertBefore(sibling, row);
      syncRows();
      const body = new FormData(form);
      queue = queue.then(async () => {
        try {
          const response = await fetch(location.pathname, { method: 'POST', body, headers: { 'x-requested-with': 'fetch' } });
          if (!response.ok) showMoveError();
        } catch {
          showMoveError();
        }
      });
    });

    groupsModal.addEventListener(
      'submit',
      (event) => {
        const form = event.target;
        if (!(form instanceof HTMLFormElement) || !form.dataset.groupAjax) return;
        if (event.defaultPrevented) return;
        event.preventDefault();
        event.stopPropagation();
        const intent = form.dataset.groupAjax;
        const body = new FormData(form);
        void (async () => {
          try {
            const response = await fetch(location.pathname, {
              method: 'POST',
              body,
              headers: { 'x-requested-with': 'fetch' },
            });
            const data = (await response.json()) as {
              ok?: boolean;
              error?: string;
              notice?: string;
              created?: boolean;
              id?: number;
              group?: { id: number; name: string; materialCount: number };
            };
            if (!response.ok || !data.ok) {
              unlock(form);
              showGroupError(data.error || 'Chưa lưu được nhóm.');
              return;
            }
            groupsModal.querySelector('[data-group-form-error]')?.remove();
            if (intent === 'save' && data.group) {
              const list = groupsModal.querySelector('[data-groups-list]');
              const existing = groupsModal.querySelector(`[data-group-row="${data.group.id}"]`);
              if (data.created || !existing) {
                groupsModal.querySelector('[data-groups-empty]')?.remove();
                const row = buildRow(data.group);
                list?.append(row);
                syncRows();
                const createName = groupsModal.querySelector<HTMLInputElement>('[data-group-create-name]');
                if (createName) createName.value = '';
              } else {
                const nameInput = existing.querySelector<HTMLInputElement>('input[name="groupName"]');
                if (nameInput) nameInput.value = data.group.name;
                const delForm = existing.querySelector('form[data-group-ajax="delete"]');
                if (delForm instanceof HTMLFormElement) {
                  delForm.dataset.confirmTitle = `Xóa nhóm “${data.group.name}”?`;
                }
              }
              syncChip(data.group, 'upsert');
              syncSelect(data.group, 'upsert');
              syncLead();
              unlock(form);
              showFlash(data.notice || 'Đã lưu nhóm.');
              return;
            }
            if (intent === 'delete' && data.id != null) {
              groupsModal.querySelector(`[data-group-row="${data.id}"]`)?.remove();
              syncChip({ id: data.id, name: '', materialCount: 0 }, 'remove');
              syncSelect({ id: data.id, name: '' }, 'remove');
              if (rows().length === 0) {
                const empty = document.createElement('p');
                empty.className = 'seo-hint mt-4';
                empty.dataset.groupsEmpty = '';
                empty.textContent = 'Chưa có nhóm nào. Thêm nhóm đầu tiên ở trên.';
                groupsModal.querySelector('[data-groups-list]')?.before(empty);
              } else syncRows();
              syncLead();
              showFlash(data.notice || 'Đã xóa nhóm.');
              return;
            }
            unlock(form);
          } catch {
            unlock(form);
            showGroupError('Không kết nối được máy chủ.');
          }
        })();
      },
      true,
    );
  }
</script>

<script>
  import {
    DEFAULT_ROUND_STEP,
    parseRoundStep,
    parseTargetMargin,
    repriceLines,
    repriceNote,
    type RepriceMode,
    type RepriceSource,
  } from '../../features/materials/costing';

  const repriceDialog = document.querySelector('[data-reprice-dialog]');
  if (repriceDialog instanceof HTMLDialogElement) {
    const modal = repriceDialog;
    const money = new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND', maximumFractionDigits: 0 });
    const percentText = (value: number | null) => (value === null ? '—' : `${value}%`);

    const readRows = (value: unknown): { previous: number; unitCost: number; rows: RepriceSource[] } | null => {
      if (typeof value !== 'object' || value === null || !('rows' in value) || !('previous' in value) || !('unitCost' in value)) return null;
      const source = value as { previous: unknown; unitCost: unknown; rows: unknown };
      if (typeof source.previous !== 'number' || typeof source.unitCost !== 'number' || !Array.isArray(source.rows)) return null;
      const rows = source.rows.flatMap((item) => {
        if (typeof item !== 'object' || item === null) return [];
        const row = item as Record<string, unknown>;
        if (typeof row.productId !== 'number' || typeof row.name !== 'string' || typeof row.price !== 'number' || typeof row.cost !== 'number' || typeof row.quantity !== 'number' || typeof row.status !== 'string') return [];
        return [{ productId: row.productId, name: row.name, price: row.price, comparePrice: typeof row.comparePrice === 'number' ? row.comparePrice : null, cost: row.cost, quantity: row.quantity, status: row.status }];
      });
      return { previous: source.previous, unitCost: source.unitCost, rows };
    };

    let parsed: { previous: number; unitCost: number; rows: RepriceSource[] } | null = null;
    try {
      parsed = readRows(JSON.parse(modal.dataset.reprice ?? ''));
    } catch {
      parsed = null;
    }

    const modeOf = (): RepriceMode => {
      const picked = modal.querySelector<HTMLInputElement>('[data-reprice-mode]:checked');
      if (picked?.value === 'keep' || picked?.value === 'margin' || picked?.value === 'none') return picked.value;
      return 'none';
    };

    const sync = () => {
      const checks = [...modal.querySelectorAll<HTMLInputElement>('[data-reprice-check]')];
      const enabled = checks.filter((item) => !item.disabled);
      const picked = enabled.filter((item) => item.checked).length;
      const count = modal.querySelector('[data-reprice-count]');
      if (count) count.textContent = `Đã chọn ${picked}`;
      const apply = modal.querySelector('[data-reprice-apply]');
      if (apply instanceof HTMLButtonElement) apply.disabled = picked === 0;
      const all = modal.querySelector<HTMLInputElement>('[data-reprice-all]');
      if (all) {
        all.disabled = enabled.length === 0;
        all.checked = picked > 0 && picked === enabled.length;
        all.indeterminate = picked > 0 && picked < enabled.length;
      }
    };

    const render = () => {
      if (!parsed) return;
      const mode = modeOf();
      const tools = modal.querySelector<HTMLElement>('[data-reprice-tools]');
      if (tools) tools.hidden = mode !== 'margin';
      const marginInput = modal.querySelector('[data-reprice-margin]');
      const stepInput = modal.querySelector('[data-reprice-step]');
      const margin = parseTargetMargin(marginInput instanceof HTMLInputElement ? marginInput.value : '');
      const step = mode === 'margin' ? parseRoundStep(stepInput instanceof HTMLSelectElement ? stepInput.value : '') : DEFAULT_ROUND_STEP;
      const lines = repriceLines(parsed.rows, parsed.previous, parsed.unitCost, mode, margin, step);
      for (const line of lines) {
        const tr = modal.querySelector<HTMLTableRowElement>(`[data-reprice-id="${line.productId}"]`);
        if (!tr) continue;
        tr.classList.toggle('is-warn', line.warn);
        const check = tr.querySelector<HTMLInputElement>('[data-reprice-check]');
        if (check) {
          check.disabled = !line.changed;
          check.checked = line.changed;
        }
        const next = tr.querySelector('[data-reprice-next]');
        if (next) next.textContent = line.nextPrice !== null && line.nextPrice !== line.price ? money.format(line.nextPrice) : '—';
        const marginText = tr.querySelector('[data-reprice-margin-text]');
        if (marginText instanceof HTMLElement) {
          marginText.textContent = mode === 'none' || line.marginAfter === null ? `biên ${percentText(line.marginBefore)}` : `${percentText(line.marginBefore)} → ${percentText(line.marginAfter)}`;
          marginText.dataset.tone = line.warn ? 'low' : 'ok';
        }
        const note = tr.querySelector('[data-reprice-note]');
        if (note instanceof HTMLElement) {
          const text = repriceNote(line, mode, line.comparePrice !== null ? money.format(line.comparePrice) : '');
          note.textContent = text;
          note.hidden = text === '';
        }
      }
      sync();
    };

    for (const input of modal.querySelectorAll('[data-reprice-mode]')) input.addEventListener('change', render);
    modal.querySelector('[data-reprice-margin]')?.addEventListener('input', render);
    modal.querySelector('[data-reprice-step]')?.addEventListener('change', render);
    modal.querySelector('[data-reprice-all]')?.addEventListener('change', (event) => {
      const all = event.currentTarget;
      if (!(all instanceof HTMLInputElement)) return;
      for (const check of modal.querySelectorAll<HTMLInputElement>('[data-reprice-check]')) {
        if (!check.disabled) check.checked = all.checked;
      }
      sync();
    });
    modal.querySelector('tbody')?.addEventListener('change', (event) => {
      const target = event.target;
      if (target instanceof HTMLInputElement && target.matches('[data-reprice-check]')) sync();
    });
    let leaving = false;
    const dismiss = () => {
      leaving = true;
      modal.close();
    };
    modal.querySelector('[data-reprice-close]')?.addEventListener('click', dismiss);
    modal.addEventListener('click', (event) => {
      if (event.target !== modal) return;
      const box = modal.getBoundingClientRect();
      const inside = event.clientX >= box.left && event.clientX <= box.right && event.clientY >= box.top && event.clientY <= box.bottom;
      if (!inside) dismiss();
    });
    modal.addEventListener('cancel', () => {
      leaving = true;
    });
    modal.addEventListener('close', () => {
      if (!leaving) return;
      const href = modal.dataset.dismiss;
      if (href) location.assign(href);
    });
    sync();
    if (modal.dataset.open === 'true') modal.showModal();
  }
</script>
