---
import { z } from 'zod';
import PublicLayout from '../../layouts/PublicLayout.astro';
import { attemptLogin } from '../../features/auth/login';
import { createSession, SESSION_COOKIE, sessionCookieOptions } from '../../features/auth/session';
import { createDb } from '../../lib/db/client';
import { getDbBinding } from '../../lib/cloudflare/env';
import { clientIp, hashIp, isSameOrigin } from '../../lib/http';
import { routes } from '../../lib/routes';
import { fieldErrors, type FieldErrors } from '../../lib/validation/errors';

if (Astro.locals.adminSession) return Astro.redirect(routes.admin);

const loginSchema = z.object({
  username: z.string().trim().min(1, 'Nhập tên đăng nhập hoặc email.').max(120, 'Tên đăng nhập quá dài.'),
  password: z.string().min(1, 'Nhập mật khẩu.').max(200, 'Mật khẩu quá dài.'),
});

let errors: FieldErrors = {};
let message = '';
let username = '';

if (Astro.request.method === 'POST') {
  if (!isSameOrigin(Astro.request)) {
    Astro.response.status = 403;
    message = 'Nguồn gửi không hợp lệ.';
  } else {
    const form = await Astro.request.formData();
    username = String(form.get('username') ?? '');
    const parsed = loginSchema.safeParse({
      username,
      password: String(form.get('password') ?? ''),
    });
    if (!parsed.success) {
      Astro.response.status = 422;
      errors = fieldErrors(parsed.error);
    } else {
      let address: string | null = null;
      try {
        address = Astro.clientAddress;
      } catch {
        address = null;
      }
      const result = await attemptLogin(
        createDb(getDbBinding()),
        parsed.data.username,
        parsed.data.password,
        await hashIp(clientIp(Astro.request, address)),
      );
      if (!result.ok) {
        Astro.response.status = result.reason === 'locked' ? 429 : 401;
        message =
          result.reason === 'locked'
            ? 'Đăng nhập tạm khóa. Thử lại sau 15 phút.'
            : result.reason === 'disabled'
              ? 'Tài khoản đã bị khóa.'
              : 'Sai tên đăng nhập hoặc mật khẩu.';
      } else {
        const session = await createSession(createDb(getDbBinding()), result.userId, result.role);
        Astro.cookies.set(SESSION_COOKIE, session.sessionId, sessionCookieOptions(Astro.url.protocol === 'https:'));
        return Astro.redirect(routes.admin, 303);
      }
    }
  }
}
---

<PublicLayout title="Đăng nhập" description="Đăng nhập quản trị" robots="noindex,nofollow">
  <main class="mx-auto max-w-md px-4 py-16">
    <h1 class="text-2xl font-semibold">Đăng nhập</h1>
    {message && <p class="error-text mt-4" role="alert">{message}</p>}
    <form class="mt-6" method="post" data-busy>
      <label class="block">
        <span class="mb-1 block font-semibold">Tên đăng nhập hoặc email</span>
        <input class="field" name="username" autocomplete="username" required maxlength="120" value={username} />
        {errors.username && <span class="error-text">{errors.username}</span>}
      </label>
      <label class="mt-4 block">
        <span class="mb-1 block font-semibold">Mật khẩu</span>
        <input class="field" type="password" name="password" autocomplete="current-password" required maxlength="200" />
        {errors.password && <span class="error-text">{errors.password}</span>}
      </label>
      <button class="btn btn-primary mt-6" type="submit">Đăng nhập</button>
    </form>
  </main>
  <script>
    document.querySelectorAll('form[data-busy]').forEach((form) => {
      form.addEventListener('submit', () => {
        const button = form.querySelector('button[type="submit"]');
        if (button instanceof HTMLButtonElement) {
          button.disabled = true;
          button.textContent = 'Đang lưu...';
        }
      });
    });
  </script>
</PublicLayout>
