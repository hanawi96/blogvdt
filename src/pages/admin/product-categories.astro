---
import ProductCategoryFields from '../../components/admin/ProductCategoryFields.svelte';
import { activityActor } from '../../features/activity/log';
import { mutationError } from '../../features/auth/session';
import {
  categoryListQuery,
  deleteProductCategory,
  listProductCategories,
  moveProductCategory,
  productCategoryDeleteWarning,
  saveProductCategory,
} from '../../features/products/categories';
import { listMedia } from '../../features/media/media';
import { productAdminQuery } from '../../features/products/products';
import AdminLayout from '../../layouts/AdminLayout.astro';
import { createDb } from '../../lib/db/client';
import { getDbBinding } from '../../lib/cloudflare/env';
import { routes } from '../../lib/routes';

const session = Astro.locals.adminSession;
if (!session) return Astro.redirect(routes.adminLogin);
if (session.role !== 'admin') {
  return new Response('Bạn không có quyền vào trang này.', { status: 403, headers: { 'content-type': 'text/plain; charset=utf-8' } });
}

const db = createDb(getDbBinding());
const query = categoryListQuery(Astro.url.searchParams.get('q') ?? '');
let formError = '';
let saveFailed = false;
let editingId = '';
let name = '';
let slug = '';
let description = '';
let coverMediaId = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const blocked = mutationError(Astro.request, session, form);
  if (blocked) {
    Astro.response.status = 403;
    formError = blocked;
  } else {
    const intent = String(form.get('intent') ?? 'save');
    const idValue = Number(form.get('id'));
    const id = Number.isInteger(idValue) && idValue > 0 ? idValue : undefined;
    const actor = await activityActor(db, session.userId);
    if (intent === 'delete' && id) {
      const removed = await deleteProductCategory(db, id, actor);
      if (!removed.ok) return Astro.redirect(listHref(removed.error.startsWith('Danh mục đang') ? 'used' : undefined), 303);
      return Astro.redirect(listHref('deleted'), 303);
    }
    if (intent === 'move' && id) {
      const direction = form.get('direction') === 'down' ? 'down' : 'up';
      const moved = await moveProductCategory(db, id, direction);
      return Astro.redirect(listHref(moved.moved ? 'moved' : undefined), 303);
    }
    name = String(form.get('name') ?? '');
    slug = String(form.get('slug') ?? '');
    description = String(form.get('description') ?? '');
    coverMediaId = String(form.get('coverMediaId') ?? '');
    editingId = id ? String(id) : '';
    const saved = await saveProductCategory(db, { id, name, slug, description, coverMediaId }, Date.now(), actor);
    if (!saved.ok) {
      Astro.response.status = 422;
      formError = saved.error;
      saveFailed = true;
    } else {
      return Astro.redirect(listHref('saved'), 303);
    }
  }
}

const [categories, mediaItems] = await Promise.all([listProductCategories(db, query), listMedia(db)]);
const notice = Astro.url.searchParams.get('notice') ?? '';
const editId = Number(Astro.url.searchParams.get('edit') ?? '');
let editing = categories.find((category) => category.id === editId);
if (!editing && query && editId > 0) editing = (await listProductCategories(db)).find((category) => category.id === editId);
if (Astro.request.method !== 'POST' && editing) {
  editingId = String(editing.id);
  name = editing.name;
  slug = editing.slug;
  description = editing.description;
  coverMediaId = editing.coverMediaId ? String(editing.coverMediaId) : '';
}
const dialogOpen = saveFailed || (Astro.request.method !== 'POST' && Boolean(editing));
const slugError = formError.startsWith('Slug') ? formError : '';
const nameError = formError.startsWith('Nhập tên') || formError.startsWith('Tên') ? formError : '';
const descriptionError = formError.startsWith('Mô tả') ? formError : '';
const coverError = formError.startsWith('Ảnh') ? formError : '';
const bannerError = slugError || nameError || descriptionError || coverError ? '' : formError;
const fieldErrors = {
  form: dialogOpen ? bannerError : '',
  name: nameError,
  slug: slugError,
  description: descriptionError,
  cover: coverError,
};
const drafts = categories.map((category) => ({
  id: category.id,
  name: category.name,
  slug: category.slug,
  description: category.description,
  coverMediaId: category.coverMediaId ? String(category.coverMediaId) : '',
}));
const noticeText =
  notice === 'saved' ? 'Đã lưu danh mục.' : notice === 'deleted' ? 'Đã xóa danh mục.' : notice === 'moved' ? 'Đã đổi thứ tự.' : '';
const searching = query.length > 0;

function listHref(noticeName?: 'saved' | 'deleted' | 'moved' | 'used', edit?: number): string {
  const params = new URLSearchParams();
  if (query) params.set('q', query);
  if (edit && edit > 0) params.set('edit', String(edit));
  if (noticeName === 'used') params.set('error', 'used');
  else if (noticeName) params.set('notice', noticeName);
  const text = params.toString();
  return text ? `${routes.adminProductCategories}?${text}` : routes.adminProductCategories;
}

function productCountLabel(count: number): string {
  if (count === 0) return 'Chưa có sản phẩm';
  if (count === 1) return '1 sản phẩm';
  return `${count} sản phẩm`;
}
---

<AdminLayout title="Danh mục sản phẩm">
  <p slot="lead">{searching ? `${categories.length} danh mục khớp` : `${categories.length} danh mục`}</p>
  <button slot="action" class="btn btn-primary" type="button" data-category-new>Thêm danh mục</button>
  {noticeText && !formError && <p class="mb-4 text-primary-strong" role="status">{noticeText}</p>}
  {Astro.url.searchParams.get('error') === 'used' && !formError && <p class="error-text mb-4" role="alert">Danh mục đang có sản phẩm, chưa xóa được.</p>}
  {bannerError && !dialogOpen && <p class="error-text mb-4" role="alert">{bannerError}</p>}
  <form class="post-toolbar" method="get" data-category-search>
    <label class="sr-only" for="category-query">Tìm danh mục</label>
    <input id="category-query" class="field" name="q" value={query} placeholder="Tên hoặc slug" maxlength="80" />
  </form>
  <div data-category-list>
    {
      categories.length === 0 ? (
        <p class="post-empty">{searching ? 'Không có danh mục khớp.' : 'Chưa có danh mục sản phẩm.'}</p>
      ) : (
        <table class="post-table">
          <thead>
            <tr>
              <th>Danh mục</th>
              <th>Sản phẩm</th>
              <th>Thứ tự</th>
              <th>Thao tác</th>
            </tr>
          </thead>
          <tbody>
            {categories.map((category, index) => (
              <tr>
                <td data-label="Danh mục">
                  <div class="user-cell">
                    <span class="category-cover">
                      {category.coverKey && <img src={routes.media(category.coverKey)} alt="" width="40" height="40" loading="lazy" />}
                    </span>
                    <div class="min-w-0">
                      <a class="post-title" href={listHref(undefined, category.id)} data-category-edit={category.id}>{category.name}</a>
                      <p class="catalog-slug">
                        <span class="truncate">{category.slug}</span>
                        <button type="button" class="catalog-copy" data-copy-slug={category.slug} aria-label={`Sao chép slug ${category.slug}`}>
                          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <rect x="9" y="9" width="13" height="13" rx="2"></rect>
                            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                          </svg>
                        </button>
                      </p>
                    </div>
                  </div>
                </td>
                <td data-label="Sản phẩm">
                  <a class:list={['catalog-count', category.productCount === 0 && 'is-empty']} href={productAdminQuery({ category: category.id })}>
                    {productCountLabel(category.productCount)}
                  </a>
                </td>
                <td data-label="Thứ tự">
                  <div class="category-order">
                    <form method="post" data-busy>
                      <input type="hidden" name="csrf" value={session.csrfToken} />
                      <input type="hidden" name="intent" value="move" />
                      <input type="hidden" name="direction" value="up" />
                      <input type="hidden" name="id" value={category.id} />
                      <button type="submit" aria-label={`Đưa “${category.name}” lên`} disabled={searching || index === 0} data-keep-label="true">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 14l6-6 6 6"></path></svg>
                      </button>
                    </form>
                    <span>{searching ? '—' : index + 1}</span>
                    <form method="post" data-busy>
                      <input type="hidden" name="csrf" value={session.csrfToken} />
                      <input type="hidden" name="intent" value="move" />
                      <input type="hidden" name="direction" value="down" />
                      <input type="hidden" name="id" value={category.id} />
                      <button type="submit" aria-label={`Đưa “${category.name}” xuống`} disabled={searching || index === categories.length - 1} data-keep-label="true">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 10l6 6 6-6"></path></svg>
                      </button>
                    </form>
                  </div>
                </td>
                <td data-label="Thao tác">
                  <div class="post-actions">
                    <a href={listHref(undefined, category.id)} data-category-edit={category.id}>Sửa</a>
                    <span class="post-actions-sep" aria-hidden="true">|</span>
                    {category.productCount > 0 ? (
                      <button class="category-delete" type="button" disabled title="Danh mục đang có sản phẩm, chưa xóa được.">Xóa</button>
                    ) : (
                      <form
                        method="post"
                        data-busy
                        data-confirm-title={productCategoryDeleteWarning()}
                        data-confirm={`“${category.name}” sẽ bị xóa. Thao tác này không hoàn tác.`}
                        data-confirm-ok="Xóa"
                        data-confirm-tone="danger"
                      >
                        <input type="hidden" name="csrf" value={session.csrfToken} />
                        <input type="hidden" name="intent" value="delete" />
                        <input type="hidden" name="id" value={category.id} />
                        <button class="category-delete" type="submit" data-keep-label="true">Xóa</button>
                      </form>
                    )}
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      )
    }
  </div>

  <dialog
    class="category-dialog"
    aria-labelledby="category-dialog-title"
    data-category-dialog
    data-open={dialogOpen ? 'true' : undefined}
    data-categories={JSON.stringify(drafts)}
  >
    <form method="post" data-busy>
      <input type="hidden" name="csrf" value={session.csrfToken} />
      <input type="hidden" name="intent" value="save" />
      <ProductCategoryFields
        client:load
        csrf={session.csrfToken}
        items={mediaItems}
        initial={{ id: editingId ? Number(editingId) : null, name, slug, description, coverMediaId }}
        errors={fieldErrors}
      />
    </form>
  </dialog>
</AdminLayout>

<script>
  const dialog = document.querySelector('[data-category-dialog]');
  if (dialog instanceof HTMLDialogElement) {
    const modal = dialog;
    type CategoryDraft = { id: number | null; name: string; slug: string; description: string; coverMediaId: string };
    const drafts: CategoryDraft[] = JSON.parse(modal.dataset.categories ?? '[]');
    const open = (draft: CategoryDraft) => {
      window.dispatchEvent(new CustomEvent('product-category-form', { detail: draft }));
      modal.showModal();
    };
    document.querySelector('[data-category-new]')?.addEventListener('click', () => {
      open({ id: null, name: '', slug: '', description: '', coverMediaId: '' });
    });
    document.addEventListener('click', (event) => {
      if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      const link = event.target instanceof Element ? event.target.closest('a[data-category-edit]') : null;
      if (!(link instanceof HTMLAnchorElement)) return;
      const draft = drafts.find((item) => String(item.id) === link.dataset.categoryEdit);
      if (!draft) return;
      event.preventDefault();
      open(draft);
    });
    modal.addEventListener('click', (event) => {
      if (event.target instanceof Element && event.target.closest('[data-category-close]')) {
        modal.close();
        return;
      }
      if (event.target !== modal) return;
      const box = modal.getBoundingClientRect();
      const inside = event.clientX >= box.left && event.clientX <= box.right && event.clientY >= box.top && event.clientY <= box.bottom;
      if (!inside) modal.close();
    });
    modal.addEventListener('close', () => {
      const url = new URL(location.href);
      if (!url.searchParams.has('edit')) return;
      url.searchParams.delete('edit');
      history.replaceState(null, '', url);
    });
    if (modal.dataset.open === 'true') modal.showModal();
  }

  const form = document.querySelector('[data-category-search]');
  const list = document.querySelector('[data-category-list]');
  if (form instanceof HTMLFormElement) {
    const input = form.querySelector('input[name="q"]');
    let timer = 0;
    const go = () => {
      const data = new FormData(form);
      const value = data.get('q');
      const term = typeof value === 'string' ? value.trim() : '';
      const next = term ? `/admin/product-categories?q=${encodeURIComponent(term)}` : '/admin/product-categories';
      if (next === location.pathname + location.search) return;
      list?.setAttribute('aria-busy', 'true');
      location.assign(next);
    };
    if (input instanceof HTMLInputElement) {
      input.addEventListener('input', () => {
        window.clearTimeout(timer);
        timer = window.setTimeout(go, 300);
      });
    }
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      window.clearTimeout(timer);
      go();
    });
  }

  for (const button of document.querySelectorAll('[data-copy-slug]')) {
    if (!(button instanceof HTMLButtonElement)) continue;
    button.addEventListener('click', async () => {
      const slug = button.dataset.copySlug;
      if (!slug || !(await copySlug(slug))) return;
      button.dataset.copied = 'true';
      window.setTimeout(() => delete button.dataset.copied, 1200);
    });
  }

  async function copySlug(slug: string): Promise<boolean> {
    try {
      await navigator.clipboard.writeText(slug);
      return true;
    } catch {
      const area = document.createElement('textarea');
      area.value = slug;
      area.setAttribute('readonly', '');
      area.style.position = 'fixed';
      area.style.left = '-999px';
      document.body.appendChild(area);
      area.select();
      const copied = document.execCommand('copy');
      area.remove();
      return copied;
    }
  }
</script>
