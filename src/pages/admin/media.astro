---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { mutationError } from '../../features/auth/session';
import { listMedia, listMediaUses, parseUpload, saveMedia, updateMediaAlt } from '../../features/media/media';
import MediaPicker from '../../components/admin/MediaPicker.svelte';
import { createDb } from '../../lib/db/client';
import { getDbBinding, getMediaBucket } from '../../lib/cloudflare/env';
import { routes } from '../../lib/routes';

const session = Astro.locals.adminSession;
if (!session) return Astro.redirect(routes.adminLogin);

const db = createDb(getDbBinding());
const wantsJson = Astro.request.headers.get('accept')?.includes('application/json') ?? false;

if (Astro.request.method === 'GET' && wantsJson) {
  const items = await listMedia(db);
  return new Response(JSON.stringify(items), {
    headers: { 'content-type': 'application/json' },
  });
}

let formError = '';
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const blocked = mutationError(Astro.request, session, form);
  if (blocked) {
    Astro.response.status = 403;
    if (wantsJson) return json({ error: blocked }, 403);
    formError = blocked;
  } else if (String(form.get('intent') ?? '') === 'alt') {
    const id = Number(form.get('id'));
    const alt = String(form.get('alt') ?? '');
    if (!Number.isInteger(id) || id < 1) {
      Astro.response.status = 422;
      if (wantsJson) return json({ error: 'Ảnh không hợp lệ.' }, 422);
      formError = 'Ảnh không hợp lệ.';
    } else {
      await updateMediaAlt(db, id, alt);
      if (wantsJson) return json({ ok: true });
      return Astro.redirect(`${routes.adminMedia}?saved=1`, 303);
    }
  } else {
    const parsed = await parseUpload(form);
    if (!parsed.ok) {
      Astro.response.status = 422;
      if (wantsJson) return json({ error: parsed.error }, 422);
      formError = parsed.error;
    } else {
      const saved = await saveMedia(db, getMediaBucket(), parsed);
      if (!saved.ok) {
        Astro.response.status = 422;
        if (wantsJson) return json({ error: saved.error }, 422);
        formError = saved.error;
      } else if (wantsJson) {
        return json({
          id: saved.id,
          url: saved.url,
          alt: parsed.altText,
          filename: parsed.filename,
          width: parsed.width,
          height: parsed.height,
          sizeBytes: parsed.bytes.byteLength,
          createdAt: saved.createdAt,
        }, 201);
      } else {
        return Astro.redirect(`${routes.adminMedia}?saved=1`, 303);
      }
    }
  }
}

const items = await listMedia(db);
const uses = await listMediaUses(db);
const saved = Astro.url.searchParams.get('saved') === '1';
const errorCode = Astro.url.searchParams.get('error');
const deleteError = errorCode === 'in-use' ? 'Ảnh đang được dùng, chưa xóa được.' : errorCode === 'missing' ? 'Không tìm thấy ảnh.' : '';

function json(body: unknown, status = 200) {
  return new Response(JSON.stringify(body), { status, headers: { 'content-type': 'application/json' } });
}
---

<AdminLayout title="Thư viện ảnh">
  {(formError || deleteError) && <p class="error-text mb-4" role="alert">{formError || deleteError}</p>}
  {saved && <p class="mb-4 text-primary-strong" role="status">Đã lưu ảnh.</p>}
  <MediaPicker client:load csrf={session.csrfToken} {items} {uses} manage />
</AdminLayout>
