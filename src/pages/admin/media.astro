---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { mutationError } from '../../features/auth/session';
import { listMedia, parseUpload, saveMedia, updateMediaAlt } from '../../features/media/media';
import { createDb } from '../../lib/db/client';
import { getDbBinding, getMediaBucket } from '../../lib/cloudflare/env';
import { routes } from '../../lib/routes';

const session = Astro.locals.adminSession;
if (!session) return Astro.redirect(routes.adminLogin);

const db = createDb(getDbBinding());
const wantsJson = Astro.request.headers.get('accept')?.includes('application/json') ?? false;

if (Astro.request.method === 'GET' && wantsJson) {
  const items = await listMedia(db);
  return new Response(JSON.stringify(items.map((item) => ({ id: item.id, url: item.url, alt: item.altText, width: item.width, height: item.height }))), {
    headers: { 'content-type': 'application/json' },
  });
}

let formError = '';
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const blocked = mutationError(Astro.request, session, form);
  if (blocked) {
    Astro.response.status = 403;
    if (wantsJson) return json({ error: blocked }, 403);
    formError = blocked;
  } else if (String(form.get('intent') ?? '') === 'alt') {
    const id = Number(form.get('id'));
    const alt = String(form.get('alt') ?? '');
    if (!Number.isInteger(id) || id < 1) {
      Astro.response.status = 422;
      formError = 'Ảnh không hợp lệ.';
    } else {
      await updateMediaAlt(db, id, alt);
      return Astro.redirect(`${routes.adminMedia}?saved=1`, 303);
    }
  } else {
    const parsed = await parseUpload(form);
    if (!parsed.ok) {
      Astro.response.status = 422;
      if (wantsJson) return json({ error: parsed.error }, 422);
      formError = parsed.error;
    } else {
      const saved = await saveMedia(db, getMediaBucket(), parsed);
      if (!saved.ok) {
        Astro.response.status = 422;
        if (wantsJson) return json({ error: saved.error }, 422);
        formError = saved.error;
      } else if (wantsJson) {
        return json({ id: saved.id, url: saved.url, alt: parsed.altText }, 201);
      } else {
        return Astro.redirect(`${routes.adminMedia}?saved=1`, 303);
      }
    }
  }
}

const items = await listMedia(db);
const saved = Astro.url.searchParams.get('saved') === '1';
const errorCode = Astro.url.searchParams.get('error');
const deleteError = errorCode === 'in-use' ? 'Ảnh đang được dùng, chưa xóa được.' : errorCode === 'missing' ? 'Không tìm thấy ảnh.' : '';

function json(body: unknown, status: number) {
  return new Response(JSON.stringify(body), { status, headers: { 'content-type': 'application/json' } });
}
---

<AdminLayout title="Thư viện ảnh">
  {saved && <p class="mb-4 text-primary-strong" role="status">Đã lưu ảnh.</p>}
  {(formError || deleteError) && <p class="error-text mb-4" role="alert">{formError || deleteError}</p>}
  <form class="max-w-xl" method="post" enctype="multipart/form-data" data-busy>
    <input type="hidden" name="csrf" value={session.csrfToken} />
    <label class="block">
      <span class="mb-1 block font-semibold">Ảnh JPEG, PNG hoặc WebP, tối đa 2 MB</span>
      <input class="field" type="file" name="file" accept="image/jpeg,image/png,image/webp" required />
    </label>
    <label class="mt-4 block">
      <span class="mb-1 block font-semibold">Mô tả ảnh</span>
      <input class="field" name="alt" maxlength="200" />
    </label>
    <button class="btn btn-primary mt-4" type="submit">Tải lên</button>
  </form>
  {
    items.length === 0 ? (
      <p class="mt-8 text-muted">Chưa có ảnh.</p>
    ) : (
      <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {items.map((item) => (
          <li class="rounded-md border border-line bg-surface p-3">
            <img
              class="h-40 w-full rounded-md object-cover"
              src={item.url}
              alt={item.altText || item.filename}
              width={item.width ?? undefined}
              height={item.height ?? undefined}
              loading="lazy"
            />
            <p class="mt-2 text-sm text-muted">{item.filename}</p>
            <form class="mt-3" method="post" data-busy>
              <input type="hidden" name="csrf" value={session.csrfToken} />
              <input type="hidden" name="intent" value="alt" />
              <input type="hidden" name="id" value={item.id} />
              <label class="block">
                <span class="sr-only">Mô tả ảnh {item.filename}</span>
                <input class="field" name="alt" maxlength="200" value={item.altText} />
              </label>
              <button class="btn mt-2" type="submit">Lưu mô tả</button>
            </form>
            <form class="mt-2" method="post" action={routes.adminMediaDelete(item.id)} onsubmit="return confirm('Xóa ảnh này?')">
              <input type="hidden" name="csrf" value={session.csrfToken} />
              <button class="btn btn-accent" type="submit">Xóa</button>
            </form>
          </li>
        ))}
      </ul>
    )
  }
</AdminLayout>
