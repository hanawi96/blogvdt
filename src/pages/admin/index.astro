---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getDashboard } from '../../features/dashboard/stats';
import { orderStatusLabel } from '../../features/orders/status';
import { createDb } from '../../lib/db/client';
import { getDbBinding } from '../../lib/cloudflare/env';
import { formatDateTime } from '../../lib/datetime';
import { routes } from '../../lib/routes';

if (!Astro.locals.adminSession) return Astro.redirect(routes.adminLogin);

let loadError = '';
let dashboard: Awaited<ReturnType<typeof getDashboard>> | null = null;
try {
  dashboard = await getDashboard(createDb(getDbBinding()));
} catch (error) {
  console.error(JSON.stringify({ event: 'dashboard_failed', name: error instanceof Error ? error.name : 'unknown' }));
  loadError = 'Không tải được số liệu.';
}

const cards = dashboard
  ? [
      ['Bài viết', dashboard.posts],
      ['Đã xuất bản', dashboard.publishedPosts],
      ['Sản phẩm', dashboard.products],
      ['Đơn hàng', dashboard.orders],
      ['Đơn mới', dashboard.newOrders],
    ]
  : [];
---

<AdminLayout title="Tổng quan">
  {loadError && <p class="error-text" role="alert">{loadError}</p>}
  {
    dashboard && (
      <>
        <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-5">
          {cards.map(([label, value]) => (
            <li class="rounded-md border border-line bg-surface p-4">
              <p class="text-sm text-muted">{label}</p>
              <p class="mt-1 text-2xl font-semibold">{value}</p>
            </li>
          ))}
        </ul>
        <h2 class="mt-8 text-lg font-semibold">Đơn gần đây</h2>
        {dashboard.recentOrders.length === 0 ? (
          <p class="mt-3 text-muted">Chưa có đơn hàng.</p>
        ) : (
          <table class="mt-3 w-full border-collapse text-left">
            <thead>
              <tr class="border-b border-line">
                <th class="py-2">Mã</th>
                <th class="py-2">Khách</th>
                <th class="py-2">Trạng thái</th>
                <th class="py-2">Thời gian</th>
              </tr>
            </thead>
            <tbody>
              {dashboard.recentOrders.map((order) => (
                <tr class="border-b border-line">
                  <td class="py-2"><a class="font-semibold underline" href={routes.adminOrder(order.id)}>{order.code}</a></td>
                  <td class="py-2">{order.customerName}</td>
                  <td class="py-2">{orderStatusLabel(order.status)}</td>
                  <td class="py-2">{formatDateTime(order.createdAt)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        )}
      </>
    )
  }
</AdminLayout>
