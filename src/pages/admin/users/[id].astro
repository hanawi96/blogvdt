---
import MediaPicker from '../../../components/admin/MediaPicker.svelte';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { isAdminRole, isAdminStatus, STATUS_LABELS } from '../../../features/auth/access';
import { activityActor } from '../../../features/activity/log';
import { mutationError, SESSION_COOKIE } from '../../../features/auth/session';
import { getUser, issuePasswordReset, PROFILE_LINKS, readUserProfile, revokeUserSessions, updateUser, type UserProfile } from '../../../features/auth/users';
import { listMedia } from '../../../features/media/media';
import { createDb } from '../../../lib/db/client';
import { getDbBinding } from '../../../lib/cloudflare/env';
import { formatDateTime } from '../../../lib/datetime';
import { routes } from '../../../lib/routes';

const session = Astro.locals.adminSession;
if (!session) return Astro.redirect(routes.adminLogin);
if (session.role !== 'admin') return new Response('Bạn không có quyền vào trang này.', { status: 403 });

const id = Number(Astro.params.id);
if (!Number.isInteger(id) || id < 1) return Astro.redirect(routes.adminUsers);

const db = createDb(getDbBinding());
const user = await getUser(db, id);
if (!user) return Astro.redirect(routes.adminUsers);

let displayName = user.displayName;
let email = user.email ?? '';
let role: string = user.role;
let status: string = user.status;
let profile: UserProfile = {
  avatarMediaId: user.avatarMediaId,
  bio: user.bio,
  facebookUrl: user.facebookUrl,
  zaloUrl: user.zaloUrl,
  instagramUrl: user.instagramUrl,
  tiktokUrl: user.tiktokUrl,
  websiteUrl: user.websiteUrl,
};
let formError = '';
let saved = '';
let link = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const blocked = mutationError(Astro.request, session, form);
  const intent = String(form.get('intent') ?? '');
  if (blocked) {
    Astro.response.status = 403;
    formError = blocked;
  } else if (intent === 'revoke') {
    const revoked = await revokeUserSessions(db, id, await activityActor(db, session.userId));
    saved = id === session.userId ? '' : revoked ? 'Đã thu hồi mọi phiên đăng nhập.' : 'Không có phiên để thu hồi.';
    if (id === session.userId) {
      Astro.cookies.delete(SESSION_COOKIE, { path: '/' });
      return Astro.redirect(routes.adminLogin, 303);
    }
  } else if (intent === 'reset') {
    const issued = await issuePasswordReset(db, id);
    if (!issued.ok) {
      Astro.response.status = 422;
      formError = issued.error;
    } else {
      link = `${Astro.url.origin}${routes.adminActivate}?token=${issued.token}`;
      saved = 'Đã tạo liên kết đặt lại mật khẩu.';
    }
  } else if (intent === 'profile') {
    displayName = String(form.get('displayName') ?? '');
    email = String(form.get('email') ?? '');
    role = String(form.get('role') ?? '');
    status = String(form.get('status') ?? '');
    const parsed = readUserProfile(form);
    profile = parsed.profile;
    if (parsed.avatarInvalid) {
      Astro.response.status = 422;
      formError = 'Ảnh không hợp lệ.';
    } else if (!isAdminRole(role) || !isAdminStatus(status)) {
      Astro.response.status = 422;
      formError = 'Vai trò hoặc trạng thái không hợp lệ.';
    } else {
      const updated = await updateUser(db, id, { displayName, email, role, status, ...profile }, Date.now(), await activityActor(db, session.userId));
      if (!updated.ok) {
        Astro.response.status = 422;
        formError = updated.error;
      } else {
        saved = 'Đã lưu tài khoản.';
        if (id === session.userId && status !== 'active') {
          Astro.cookies.delete(SESSION_COOKIE, { path: '/' });
          return Astro.redirect(routes.adminLogin, 303);
        }
      }
    }
  } else {
    Astro.response.status = 422;
    formError = 'Thao tác không hợp lệ.';
  }
}

const current = (await getUser(db, id)) ?? user;
const library = await listMedia(db);
const statusChoices = current.status === 'invited' ? (['invited', 'disabled'] as const) : (['active', 'disabled'] as const);
---

<AdminLayout title={current.displayName || current.username}>
  <p slot="lead">{current.email || current.username}</p>
  <a slot="action" class="btn" href={routes.adminUsers}>Danh sách</a>
  {saved && <p class="mb-4 text-primary-strong" role="status">{saved}</p>}
  {formError && <p class="error-text mb-4" role="alert">{formError}</p>}
  <div class="max-w-4xl">
    <form method="post" data-busy>
      <input type="hidden" name="csrf" value={session.csrfToken} />
      <input type="hidden" name="intent" value="profile" />
      <h2 class="text-lg font-semibold">Hồ sơ</h2>
      <div class="mt-4">
        <MediaPicker client:load csrf={session.csrfToken} items={library} name="avatarMediaId" selected={profile.avatarMediaId ? [String(profile.avatarMediaId)] : []} />
      </div>
      <label class="mt-4 block">
        <span class="mb-1 block font-semibold">Giới thiệu</span>
        <textarea class="field" name="bio" maxlength="500" rows="4">{profile.bio}</textarea>
      </label>
      <div class="profile-links mt-4">
        {PROFILE_LINKS.map(([key, label]) => (
          <label class:list={['block', key === 'websiteUrl' && 'is-wide']}>
            <span class="mb-1 block font-semibold">{label}</span>
            <input class="field" type="url" name={key} maxlength="300" value={profile[key]} placeholder="https://" />
          </label>
        ))}
      </div>
      <h2 class="mt-8 text-lg font-semibold">Tài khoản</h2>
      <label class="mt-4 block">
        <span class="mb-1 block font-semibold">Họ tên</span>
        <input class="field" name="displayName" required maxlength="80" value={displayName} />
      </label>
      <label class="mt-4 block">
        <span class="mb-1 block font-semibold">Email</span>
        <input class="field" type="email" name="email" required maxlength="120" value={email} />
      </label>
      <label class="mt-4 block">
        <span class="mb-1 block font-semibold">Vai trò</span>
        <select class="field" name="role">
          <option value="editor" selected={role === 'editor'}>Biên tập</option>
          <option value="admin" selected={role === 'admin'}>Quản trị</option>
        </select>
      </label>
      <label class="mt-4 block">
        <span class="mb-1 block font-semibold">Trạng thái</span>
        <select class="field" name="status">
          {statusChoices.map((choice) => (
            <option value={choice} selected={status === choice}>{STATUS_LABELS[choice]}</option>
          ))}
        </select>
      </label>
      <p class="mt-3 text-sm text-muted">Đăng nhập cuối: {current.lastLoginAt ? formatDateTime(current.lastLoginAt) : 'Chưa đăng nhập'}. Tài khoản không bị xóa.</p>
      <div class="mt-6 flex flex-wrap items-center gap-3">
        <button class="btn btn-primary" type="submit">Lưu</button>
        <button class="btn" type="submit" form="user-reset">Tạo liên kết đặt mật khẩu</button>
        <button class="btn" type="submit" form="user-revoke">Thu hồi phiên đăng nhập</button>
      </div>
    </form>
    {link && (
      <label class="mt-4 block">
        <span class="mb-1 block font-semibold">Liên kết một lần</span>
        <input class="field" readonly value={link} />
      </label>
    )}
  </div>
  <form id="user-reset" method="post" data-busy>
    <input type="hidden" name="csrf" value={session.csrfToken} />
    <input type="hidden" name="intent" value="reset" />
  </form>
  <form
    id="user-revoke"
    method="post"
    data-busy
    data-confirm-title="Thu hồi phiên đăng nhập?"
    data-confirm="Mọi phiên đang đăng nhập của tài khoản này sẽ bị đăng xuất."
    data-confirm-ok="Thu hồi"
    data-confirm-tone="danger"
  >
    <input type="hidden" name="csrf" value={session.csrfToken} />
    <input type="hidden" name="intent" value="revoke" />
  </form>
</AdminLayout>
