---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { activityActor } from '../../../features/activity/log';
import { mutationError } from '../../../features/auth/session';
import { isAdminRole } from '../../../features/auth/access';
import { createUser } from '../../../features/auth/users';
import { createDb } from '../../../lib/db/client';
import { getDbBinding } from '../../../lib/cloudflare/env';
import { routes } from '../../../lib/routes';

const session = Astro.locals.adminSession;
if (!session) return Astro.redirect(routes.adminLogin);
if (session.role !== 'admin') return new Response('Bạn không có quyền vào trang này.', { status: 403 });

let displayName = '';
let email = '';
let role = 'editor';
let formError = '';
let createdOk = false;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  displayName = String(form.get('displayName') ?? '');
  email = String(form.get('email') ?? '');
  role = String(form.get('role') ?? 'editor');
  const blocked = mutationError(Astro.request, session, form);
  if (blocked) {
    Astro.response.status = 403;
    formError = blocked;
  } else if (!isAdminRole(role)) {
    Astro.response.status = 422;
    formError = 'Vai trò không hợp lệ.';
  } else {
    const db = createDb(getDbBinding());
    const created = await createUser(db, { displayName, email, role }, Date.now(), await activityActor(db, session.userId));
    if (!created.ok) {
      Astro.response.status = 422;
      formError = created.error;
    } else {
      createdOk = true;
      displayName = '';
      email = '';
      role = 'editor';
    }
  }
}
---

<AdminLayout title="Thêm tài khoản">
  <p slot="lead">Tài khoản mới nhận liên kết đặt mật khẩu. Ảnh và giới thiệu thêm ở trang sửa.</p>
  <a slot="action" class="btn" href={routes.adminUsers}>Danh sách</a>
  {formError && <p class="error-text mb-4" role="alert">{formError}</p>}
  <form class="max-w-xl" method="post" data-busy>
    <input type="hidden" name="csrf" value={session.csrfToken} />
    <label class="block">
      <span class="mb-1 block font-semibold">Họ tên</span>
      <input class="field" name="displayName" required maxlength="80" value={displayName} />
    </label>
    <label class="mt-4 block">
      <span class="mb-1 block font-semibold">Email</span>
      <input class="field" type="email" name="email" required maxlength="120" value={email} />
    </label>
    <label class="mt-4 block">
      <span class="mb-1 block font-semibold">Vai trò</span>
      <select class="field" name="role">
        <option value="editor" selected={role === 'editor'}>Biên tập</option>
        <option value="admin" selected={role === 'admin'}>Quản trị</option>
      </select>
    </label>
    <p class="mt-3 text-sm text-muted">Biên tập quản lý bài viết, danh mục và thư viện ảnh. Quản trị thêm cài đặt, người dùng, sản phẩm và đơn hàng.</p>
    <button class="btn btn-primary mt-6" type="submit">Tạo tài khoản</button>
    {createdOk && <p class="mt-3 text-primary-strong" role="status">Đã tạo người dùng thành công</p>}
  </form>
</AdminLayout>
