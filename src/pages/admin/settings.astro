---
import MediaPicker from '../../components/admin/MediaPicker.svelte';
import SearchPreview from '../../components/admin/SearchPreview.astro';
import AdminLayout from '../../layouts/AdminLayout.astro';
import { activityActor } from '../../features/activity/log';
import { mutationError } from '../../features/auth/session';
import { listMediaByIds } from '../../features/media/media';
import { lengthNote, metaDuplicateNote, SEO_DESC_RANGE, SEO_TITLE_RANGE } from '../../features/posts/seo-check';
import { listMetaCorpus } from '../../features/posts/posts';
import { getSettings, OPEN_DAY_OPTIONS, parseOpenDays, parseSettingsForm, saveSettings, SETTING_KEYS, type SiteSettingValues } from '../../features/settings/settings';
import { createDb } from '../../lib/db/client';
import { getDbBinding } from '../../lib/cloudflare/env';
import { mergeMetaCorpus, siteListCorpus } from '../../lib/seo/meta';
import { routes } from '../../lib/routes';
import type { FieldErrors } from '../../lib/validation/errors';

const TABS = ['general', 'brand', 'seo', 'tracking'] as const;
type SettingsTab = (typeof TABS)[number];

const TAB_FIELDS: Record<SettingsTab, Array<keyof SiteSettingValues>> = {
  general: [
    'site_name',
    'site_description',
    'phone',
    'contact_email',
    'contact_info',
    'address_locality',
    'address_region',
    'postal_code',
    'geo_latitude',
    'geo_longitude',
    'opens_at',
    'closes_at',
    'open_days',
    'facebook_url',
    'zalo_url',
    'instagram_url',
    'tiktok_url',
    'youtube_url',
  ],
  brand: ['logo_media_id', 'favicon_media_id'],
  seo: ['default_seo_title', 'default_seo_description', 'og_media_id'],
  tracking: ['meta_pixel_id', 'ga_measurement_id', 'google_ads_id', 'google_ads_label', 'tiktok_pixel_id', 'gtm_id'],
};

const session = Astro.locals.adminSession;
if (!session) return Astro.redirect(routes.adminLogin);

const db = createDb(getDbBinding());
let values = await getSettings(db);
let errors: FieldErrors = {};
let formError = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const blocked = mutationError(Astro.request, session, form);
  if (blocked) {
    Astro.response.status = 403;
    formError = blocked;
  } else {
    const parsed = parseSettingsForm(form);
    values = valuesFrom(form, values);
    if (!parsed.ok) {
      Astro.response.status = 422;
      errors = parsed.errors;
      formError = 'Chưa lưu. Kiểm tra các ô được báo và thử lại.';
    } else {
      try {
        const changed = await saveSettings(db, parsed.values, Date.now(), await activityActor(db, session.userId));
        return Astro.redirect(`${routes.adminSettings}?saved=${changed > 0 ? '1' : '0'}${tabQuery(Astro.url.searchParams.get('tab'))}`, 303);
      } catch (error) {
        console.error(JSON.stringify({ event: 'settings_save_failed', name: error instanceof Error ? error.name : 'unknown' }));
        Astro.response.status = 500;
        formError = 'Không lưu được. Dữ liệu trên form vẫn còn.';
      }
    }
  }
}

const saved = Astro.url.searchParams.get('saved');
const requestedTab = Astro.url.searchParams.get('tab');
const errorTab = (Object.entries(TAB_FIELDS).find(([, keys]) => keys.some((key) => errors[key]))?.[0] ?? '') as SettingsTab | '';
const activeTab: SettingsTab = errorTab || resolveTab(requestedTab);
const media = await listMediaByIds(db, [values.logo_media_id, values.favicon_media_id, values.og_media_id]);
const logo = media.find((item) => String(item.id) === values.logo_media_id);
const previewTitle = values.default_seo_title || values.site_name || 'Tên website';
const previewDescription = values.default_seo_description || values.site_description || 'Thêm mô tả để xem trước đoạn này.';
const corpus = mergeMetaCorpus(await listMetaCorpus(db, null), siteListCorpus());
const duplicateNote = metaDuplicateNote(values.default_seo_title || values.site_name, values.default_seo_description || values.site_description, corpus);
const selectedOpenDays = new Set(parseOpenDays(values.open_days));

function valuesFrom(form: FormData, current: SiteSettingValues): SiteSettingValues {
  const next = { ...current };
  for (const key of SETTING_KEYS) {
    const value = form.get(key);
    if (typeof value === 'string') next[key] = value;
  }
  next.open_days = parseOpenDays(
    [...form.getAll('open_day'), typeof form.get('open_days') === 'string' ? String(form.get('open_days')) : '']
      .filter(Boolean)
      .join(','),
  ).join(',');
  return next;
}

/** `contact` là alias cũ → tab Cửa hàng (`general`). */
function resolveTab(value: string | null): SettingsTab {
  if (value === 'contact') return 'general';
  return isTab(value) ? value : 'general';
}

function isTab(value: string | null): value is SettingsTab {
  return TABS.some((tab) => tab === value);
}

function tabQuery(value: string | null): string {
  const tab = resolveTab(value);
  return tab === 'general' ? '' : `&tab=${tab}`;
}
---

<AdminLayout title="Cài đặt website">
  <p class="settings-lead">Quản lý thông tin và cách website hiển thị.</p>
  <form method="post" data-busy data-settings data-active-tab={activeTab}>
    <input type="hidden" name="csrf" value={session.csrfToken} />
    <div class="settings-tabs" role="tablist" aria-label="Nhóm cài đặt">
      <button type="button" role="tab" data-settings-tab="general" aria-selected={activeTab === 'general' ? 'true' : 'false'}>Cửa hàng</button>
      <button type="button" role="tab" data-settings-tab="brand" aria-selected={activeTab === 'brand' ? 'true' : 'false'}>Nhận diện</button>
      <button type="button" role="tab" data-settings-tab="seo" aria-selected={activeTab === 'seo' ? 'true' : 'false'}>SEO & chia sẻ</button>
      <button type="button" role="tab" data-settings-tab="tracking" aria-selected={activeTab === 'tracking' ? 'true' : 'false'}>Theo dõi quảng cáo</button>
    </div>
    {formError && <p class="error-text mb-4" role="alert">{formError}</p>}

    <div class="settings-panel" data-settings-panel="general" hidden={activeTab !== 'general'}>

      <fieldset class="settings-section">
        <legend class="settings-section-title">Tên & mô tả</legend>
        <label class="block">
          <span class="settings-field-label">Tên website</span>
          <input class="field" name="site_name" required maxlength="120" value={values.site_name} />
          {errors.site_name && <span class="error-text">{errors.site_name}</span>}
        </label>
        <label class="mt-4 block">
          <span class="settings-field-label">Mô tả</span>
          <textarea class="field min-h-24" name="site_description" maxlength="300">{values.site_description}</textarea>
          {errors.site_description && <span class="error-text">{errors.site_description}</span>}
        </label>
      </fieldset>

      <fieldset class="settings-section">
        <legend class="settings-section-title">Liên hệ</legend>
        <label class="block">
          <span class="settings-field-label">Số điện thoại</span>
          <input class="field" name="phone" type="tel" inputmode="tel" maxlength="30" autocomplete="tel" value={values.phone} />
          <span class="seo-hint">Ví dụ 0901234567 hoặc +84901234567. Schema sẽ chuẩn hóa dạng +84…</span>
          {errors.phone && <span class="error-text">{errors.phone}</span>}
        </label>
        <label class="mt-4 block">
          <span class="settings-field-label">Email liên hệ</span>
          <input class="field" name="contact_email" type="email" maxlength="120" autocomplete="email" value={values.contact_email} />
          {errors.contact_email && <span class="error-text">{errors.contact_email}</span>}
        </label>
      </fieldset>

      <fieldset class="settings-section">
        <legend class="settings-section-title">Địa chỉ</legend>
        <label class="block">
          <span class="settings-field-label">Số nhà, đường, thôn/xóm</span>
          <textarea class="field min-h-24" name="contact_info" maxlength="300">{values.contact_info}</textarea>
          {errors.contact_info && <span class="error-text">{errors.contact_info}</span>}
        </label>
        <div class="mt-4 grid gap-4 sm:grid-cols-2">
          <label class="block">
            <span class="settings-field-label">Phường/xã hoặc quận/huyện</span>
            <input class="field" name="address_locality" maxlength="120" value={values.address_locality} />
            {errors.address_locality && <span class="error-text">{errors.address_locality}</span>}
          </label>
          <label class="block">
            <span class="settings-field-label">Tỉnh / thành phố</span>
            <input class="field" name="address_region" maxlength="120" value={values.address_region} />
            {errors.address_region && <span class="error-text">{errors.address_region}</span>}
          </label>
        </div>
        <label class="mt-4 block">
          <span class="settings-field-label">Mã bưu chính</span>
          <input class="field" name="postal_code" maxlength="20" value={values.postal_code} />
          <span class="seo-hint">Không bắt buộc.</span>
          {errors.postal_code && <span class="error-text">{errors.postal_code}</span>}
        </label>
        <div class="mt-4 grid gap-4 sm:grid-cols-2">
          <label class="block">
            <span class="settings-field-label">Vĩ độ (latitude)</span>
            <input class="field" name="geo_latitude" inputmode="decimal" maxlength="20" placeholder="21.1608" value={values.geo_latitude} />
            {errors.geo_latitude && <span class="error-text">{errors.geo_latitude}</span>}
          </label>
          <label class="block">
            <span class="settings-field-label">Kinh độ (longitude)</span>
            <input class="field" name="geo_longitude" inputmode="decimal" maxlength="20" placeholder="105.7351" value={values.geo_longitude} />
            {errors.geo_longitude && <span class="error-text">{errors.geo_longitude}</span>}
          </label>
        </div>
        <p class="seo-hint mt-1">Lấy từ Google Maps (chuột phải → tọa độ). Để trống nếu không muốn LocalBusiness / geo.</p>
      </fieldset>

      <fieldset class="settings-section">
        <legend class="settings-section-title">Giờ mở cửa</legend>
        <div class="grid gap-4 sm:grid-cols-2">
          <label class="block">
            <span class="settings-field-label">Mở lúc</span>
            <input class="field" name="opens_at" type="time" value={values.opens_at} />
            {errors.opens_at && <span class="error-text">{errors.opens_at}</span>}
          </label>
          <label class="block">
            <span class="settings-field-label">Đóng lúc</span>
            <input class="field" name="closes_at" type="time" value={values.closes_at} />
            {errors.closes_at && <span class="error-text">{errors.closes_at}</span>}
          </label>
        </div>
        <div class="mt-3 flex flex-wrap gap-x-4 gap-y-2">
          {OPEN_DAY_OPTIONS.map((day) => (
            <label class="admin-check">
              <input type="checkbox" name="open_day" value={day.value} checked={selectedOpenDays.has(day.value)} />
              <span>{day.label}</span>
            </label>
          ))}
        </div>
        <span class="seo-hint mt-2 block">Chọn ngày và giờ nếu xưởng / điểm nhận hàng có giờ cố định.</span>
      </fieldset>

      <fieldset class="settings-section">
        <legend class="settings-section-title">Mạng xã hội</legend>
        <label class="block">
          <span class="settings-field-label">Facebook</span>
          <input class="field" name="facebook_url" type="url" maxlength="300" placeholder="https://" value={values.facebook_url} />
          {errors.facebook_url && <span class="error-text">{errors.facebook_url}</span>}
        </label>
        <label class="mt-4 block">
          <span class="settings-field-label">Zalo</span>
          <input class="field" name="zalo_url" type="url" maxlength="300" placeholder="https://" value={values.zalo_url} />
          {errors.zalo_url && <span class="error-text">{errors.zalo_url}</span>}
        </label>
        <label class="mt-4 block">
          <span class="settings-field-label">Instagram</span>
          <input class="field" name="instagram_url" type="url" maxlength="300" placeholder="https://" value={values.instagram_url} />
          {errors.instagram_url && <span class="error-text">{errors.instagram_url}</span>}
        </label>
        <label class="mt-4 block">
          <span class="settings-field-label">TikTok</span>
          <input class="field" name="tiktok_url" type="url" maxlength="300" placeholder="https://" value={values.tiktok_url} />
          {errors.tiktok_url && <span class="error-text">{errors.tiktok_url}</span>}
        </label>
        <label class="mt-4 block">
          <span class="settings-field-label">YouTube</span>
          <input class="field" name="youtube_url" type="url" maxlength="300" placeholder="https://" value={values.youtube_url} />
          {errors.youtube_url && <span class="error-text">{errors.youtube_url}</span>}
        </label>
      </fieldset>
    </div>

    <div class="settings-panel" data-settings-panel="brand" hidden={activeTab !== 'brand'}>
      <fieldset class="settings-section">
        <legend class="settings-section-title">Logo</legend>
        <MediaPicker client:load csrf={session.csrfToken} items={media} name="logo_media_id" selected={values.logo_media_id ? [values.logo_media_id] : []} editAlt />
        <p class="seo-hint">Bỏ ảnh chỉ gỡ khỏi website, không xóa file trong thư viện.</p>
        {errors.logo_media_id && <span class="error-text">{errors.logo_media_id}</span>}
      </fieldset>
      <fieldset class="settings-section">
        <legend class="settings-section-title">Favicon</legend>
        <MediaPicker client:load csrf={session.csrfToken} items={media} name="favicon_media_id" selected={values.favicon_media_id ? [values.favicon_media_id] : []} editAlt />
        <p class="seo-hint">JPEG, PNG hoặc WebP. Chưa chọn thì trang dùng favicon.svg có sẵn.</p>
        {errors.favicon_media_id && <span class="error-text">{errors.favicon_media_id}</span>}
      </fieldset>
    </div>

    <div class="settings-panel" data-settings-panel="seo" hidden={activeTab !== 'seo'}>
      <SearchPreview
        site={{ name: values.site_name || 'Website', host: Astro.url.host, markUrl: logo?.url ?? '' }}
        title={previewTitle}
        description={previewDescription}
        slug=""
        emptyDescription={!values.default_seo_description && !values.site_description}
        titleName="default_seo_title"
        descriptionName="default_seo_description"
        fallbackTitleName="site_name"
        fallbackDescriptionName="site_description"
        homeUrl
        corpus={corpus}
      />
      <label class="mt-4 block">
        <span class="seo-label">
          <span>SEO Title</span>
          <span data-seo-title-count>{values.default_seo_title.length} ký tự</span>
        </span>
        <input class="field" name="default_seo_title" maxlength="180" value={values.default_seo_title} />
        <span class="seo-hint">Để trống thì dùng tên website.</span>
        <span class="seo-hint" data-seo-title-note>{lengthNote(values.default_seo_title.length, SEO_TITLE_RANGE.min, SEO_TITLE_RANGE.max)}</span>
        {errors.default_seo_title && <span class="error-text">{errors.default_seo_title}</span>}
      </label>
      <label class="mt-4 block">
        <span class="seo-label">
          <span>Meta Description</span>
          <span data-seo-desc-count>{values.default_seo_description.length} ký tự</span>
        </span>
        <textarea class="field min-h-24" name="default_seo_description" maxlength="300">{values.default_seo_description}</textarea>
        <span class="seo-hint">Để trống thì dùng mô tả website. Nên khoảng 70–160 ký tự.</span>
        <span class="seo-hint" data-seo-desc-note>{lengthNote(values.default_seo_description.length, SEO_DESC_RANGE.min, SEO_DESC_RANGE.max)}</span>
        <span class="seo-hint" data-seo-duplicate-note>{duplicateNote}</span>
        {errors.default_seo_description && <span class="error-text">{errors.default_seo_description}</span>}
      </label>
      <fieldset class="settings-section mt-6">
        <legend class="settings-section-title">Ảnh Open Graph mặc định</legend>
        <MediaPicker client:load csrf={session.csrfToken} items={media} name="og_media_id" selected={values.og_media_id ? [values.og_media_id] : []} editAlt />
        <p class="seo-hint">Dùng khi trang không có ảnh riêng. Bài viết và sản phẩm vẫn dùng ảnh của chúng.</p>
        {errors.og_media_id && <span class="error-text">{errors.og_media_id}</span>}
      </fieldset>
    </div>

    <div class="settings-panel" data-settings-panel="tracking" hidden={activeTab !== 'tracking'}>
      <p class="seo-hint mb-3">Mã theo dõi mặc định cho toàn site và các trang đích. Mỗi trang đích có thể nhập mã riêng để ghi đè. Để trống nếu chưa chạy quảng cáo.</p>
      <label class="block">
        <span class="mb-1 block font-semibold">Meta Pixel ID (Facebook)</span>
        <input class="field" name="meta_pixel_id" inputmode="numeric" maxlength="40" placeholder="Ví dụ 123456789012345" value={values.meta_pixel_id} />
        <span class="seo-hint">Lấy trong Trình quản lý sự kiện của Meta. Chỉ gồm chữ số.</span>
        {errors.meta_pixel_id && <span class="error-text">{errors.meta_pixel_id}</span>}
      </label>
      <label class="mt-4 block">
        <span class="mb-1 block font-semibold">Google Analytics (GA4)</span>
        <input class="field" name="ga_measurement_id" maxlength="40" placeholder="G-XXXXXXXXXX" value={values.ga_measurement_id} />
        <span class="seo-hint">Dạng G-XXXXXXXXXX trong Google Analytics 4.</span>
        {errors.ga_measurement_id && <span class="error-text">{errors.ga_measurement_id}</span>}
      </label>
      <label class="mt-4 block">
        <span class="mb-1 block font-semibold">Google Ads — ID chuyển đổi</span>
        <input class="field" name="google_ads_id" maxlength="40" placeholder="AW-123456789" value={values.google_ads_id} />
        <span class="seo-hint">Dạng AW-123456789. Dùng để đo chuyển đổi Google Ads (khác GA4).</span>
        {errors.google_ads_id && <span class="error-text">{errors.google_ads_id}</span>}
      </label>
      <label class="mt-4 block">
        <span class="mb-1 block font-semibold">Google Ads — nhãn chuyển đổi</span>
        <input class="field" name="google_ads_label" maxlength="60" placeholder="abcDEfghIJ" value={values.google_ads_label} />
        <span class="seo-hint">Phần sau dấu gạch chéo trong mã chuyển đổi Google Ads.</span>
        {errors.google_ads_label && <span class="error-text">{errors.google_ads_label}</span>}
      </label>
      <label class="mt-4 block">
        <span class="mb-1 block font-semibold">TikTok Pixel ID</span>
        <input class="field" name="tiktok_pixel_id" maxlength="40" placeholder="Ví dụ C9ABCD1234EF" value={values.tiktok_pixel_id} />
        <span class="seo-hint">Lấy trong Trình quản lý sự kiện của TikTok.</span>
        {errors.tiktok_pixel_id && <span class="error-text">{errors.tiktok_pixel_id}</span>}
      </label>
      <label class="mt-4 block">
        <span class="mb-1 block font-semibold">Google Tag Manager</span>
        <input class="field" name="gtm_id" maxlength="40" placeholder="GTM-XXXXXX" value={values.gtm_id} />
        <span class="seo-hint">Dạng GTM-XXXXXX. Cấp cho bên chạy quảng cáo để họ tự quản mọi thẻ mà không cần sửa code.</span>
        {errors.gtm_id && <span class="error-text">{errors.gtm_id}</span>}
      </label>
    </div>

    <div class="settings-save">
      <button class="btn btn-primary" type="submit">Lưu cài đặt</button>
      <p class="settings-status text-primary-strong" role="status" data-settings-status>
        {saved === '1' && !formError ? 'Đã lưu cài đặt.' : saved === '0' && !formError ? 'Không có thay đổi.' : ''}
      </p>
    </div>
  </form>
</AdminLayout>

<script>
  const form = document.querySelector('[data-settings]');
  if (form instanceof HTMLFormElement) {
    const tabs = [...form.querySelectorAll('[data-settings-tab]')];
    const panels = [...form.querySelectorAll('[data-settings-panel]')];
    const show = (id: string) => {
      for (const tab of tabs) {
        if (!(tab instanceof HTMLButtonElement)) continue;
        const selected = tab.dataset.settingsTab === id;
        tab.setAttribute('aria-selected', selected ? 'true' : 'false');
        tab.tabIndex = selected ? 0 : -1;
      }
      for (const panel of panels) {
        if (panel instanceof HTMLElement) panel.hidden = panel.dataset.settingsPanel !== id;
      }
    };
    show(form.dataset.activeTab || 'general');
    for (const tab of tabs) {
      tab.addEventListener('click', () => {
        const id = tab instanceof HTMLElement ? tab.dataset.settingsTab : '';
        if (!id) return;
        show(id);
        const url = new URL(location.href);
        url.searchParams.set('tab', id);
        history.replaceState(null, '', url);
      });
    }
    form.addEventListener('submit', () => {
      const status = form.querySelector('[data-settings-status]');
      if (status) status.textContent = 'Đang lưu...';
    });
  }
</script>
