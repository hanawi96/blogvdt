---
import MediaPicker from '../../components/admin/MediaPicker.svelte';
import SearchPreview from '../../components/admin/SearchPreview.astro';
import AdminLayout from '../../layouts/AdminLayout.astro';
import { mutationError } from '../../features/auth/session';
import { listMedia } from '../../features/media/media';
import { lengthNote, SEO_DESC_RANGE, SEO_TITLE_RANGE } from '../../features/posts/seo-check';
import { getSettings, parseSettingsForm, saveSettings, SETTING_KEYS, type SiteSettingValues } from '../../features/settings/settings';
import { createDb } from '../../lib/db/client';
import { getDbBinding } from '../../lib/cloudflare/env';
import { routes } from '../../lib/routes';
import type { FieldErrors } from '../../lib/validation/errors';

const TABS = ['general', 'contact', 'brand', 'seo'] as const;
type SettingsTab = (typeof TABS)[number];

const TAB_FIELDS: Record<SettingsTab, Array<keyof SiteSettingValues>> = {
  general: ['site_name', 'site_description'],
  contact: ['phone', 'contact_info', 'facebook_url', 'zalo_url'],
  brand: ['logo_media_id', 'favicon_media_id'],
  seo: ['default_seo_title', 'default_seo_description', 'og_media_id'],
};

const session = Astro.locals.adminSession;
if (!session) return Astro.redirect(routes.adminLogin);

const db = createDb(getDbBinding());
const media = await listMedia(db);
let values = await getSettings(db);
let errors: FieldErrors = {};
let formError = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const blocked = mutationError(Astro.request, session, form);
  if (blocked) {
    Astro.response.status = 403;
    formError = blocked;
  } else {
    const parsed = parseSettingsForm(form);
    values = valuesFrom(form, values);
    if (!parsed.ok) {
      Astro.response.status = 422;
      errors = parsed.errors;
      formError = 'Chưa lưu. Kiểm tra các ô được báo và thử lại.';
    } else {
      try {
        const changed = await saveSettings(db, parsed.values);
        return Astro.redirect(`${routes.adminSettings}?saved=${changed > 0 ? '1' : '0'}${tabQuery(Astro.url.searchParams.get('tab'))}`, 303);
      } catch (error) {
        console.error(JSON.stringify({ event: 'settings_save_failed', name: error instanceof Error ? error.name : 'unknown' }));
        Astro.response.status = 500;
        formError = 'Không lưu được. Dữ liệu trên form vẫn còn.';
      }
    }
  }
}

const saved = Astro.url.searchParams.get('saved');
const requestedTab = Astro.url.searchParams.get('tab');
const errorTab = (Object.entries(TAB_FIELDS).find(([, keys]) => keys.some((key) => errors[key]))?.[0] ?? '') as SettingsTab | '';
const activeTab: SettingsTab = errorTab || (isTab(requestedTab) ? requestedTab : 'general');
const logo = media.find((item) => String(item.id) === values.logo_media_id);
const previewTitle = values.default_seo_title || values.site_name || 'Tên website';
const previewDescription = values.default_seo_description || values.site_description || 'Thêm mô tả để xem trước đoạn này.';

function valuesFrom(form: FormData, current: SiteSettingValues): SiteSettingValues {
  const next = { ...current };
  for (const key of SETTING_KEYS) {
    const value = form.get(key);
    if (typeof value === 'string') next[key] = value;
  }
  return next;
}

function isTab(value: string | null): value is SettingsTab {
  return TABS.some((tab) => tab === value);
}

function tabQuery(value: string | null): string {
  return isTab(value) ? `&tab=${value}` : '';
}
---

<AdminLayout title="Cài đặt website">
  <p class="settings-lead">Quản lý thông tin và cách website hiển thị.</p>
  <form method="post" data-busy data-settings data-active-tab={activeTab}>
    <input type="hidden" name="csrf" value={session.csrfToken} />
    <div class="settings-tabs" role="tablist" aria-label="Nhóm cài đặt">
      <button type="button" role="tab" data-settings-tab="general" aria-selected={activeTab === 'general' ? 'true' : 'false'}>Thông tin chung</button>
      <button type="button" role="tab" data-settings-tab="contact" aria-selected={activeTab === 'contact' ? 'true' : 'false'}>Liên hệ</button>
      <button type="button" role="tab" data-settings-tab="brand" aria-selected={activeTab === 'brand' ? 'true' : 'false'}>Nhận diện</button>
      <button type="button" role="tab" data-settings-tab="seo" aria-selected={activeTab === 'seo' ? 'true' : 'false'}>SEO & chia sẻ</button>
    </div>
    {formError && <p class="error-text mb-4" role="alert">{formError}</p>}

    <div class="settings-panel" data-settings-panel="general" hidden={activeTab !== 'general'}>
      <label class="block">
        <span class="mb-1 block font-semibold">Tên website</span>
        <input class="field" name="site_name" required maxlength="120" value={values.site_name} />
        {errors.site_name && <span class="error-text">{errors.site_name}</span>}
      </label>
      <label class="mt-4 block">
        <span class="mb-1 block font-semibold">Mô tả</span>
        <textarea class="field min-h-24" name="site_description" maxlength="300">{values.site_description}</textarea>
        {errors.site_description && <span class="error-text">{errors.site_description}</span>}
      </label>
    </div>

    <div class="settings-panel" data-settings-panel="contact" hidden={activeTab !== 'contact'}>
      <label class="block">
        <span class="mb-1 block font-semibold">Số điện thoại</span>
        <input class="field" name="phone" type="tel" inputmode="tel" maxlength="30" autocomplete="tel" value={values.phone} />
        <span class="seo-hint">Ví dụ 0901234567 hoặc +84901234567.</span>
        {errors.phone && <span class="error-text">{errors.phone}</span>}
      </label>
      <label class="mt-4 block">
        <span class="mb-1 block font-semibold">Địa chỉ</span>
        <textarea class="field min-h-24" name="contact_info" maxlength="300">{values.contact_info}</textarea>
        {errors.contact_info && <span class="error-text">{errors.contact_info}</span>}
      </label>
      <label class="mt-4 block">
        <span class="mb-1 block font-semibold">Facebook</span>
        <input class="field" name="facebook_url" type="url" maxlength="300" placeholder="https://" value={values.facebook_url} />
        {errors.facebook_url && <span class="error-text">{errors.facebook_url}</span>}
      </label>
      <label class="mt-4 block">
        <span class="mb-1 block font-semibold">Zalo</span>
        <input class="field" name="zalo_url" type="url" maxlength="300" placeholder="https://" value={values.zalo_url} />
        {errors.zalo_url && <span class="error-text">{errors.zalo_url}</span>}
      </label>
    </div>

    <div class="settings-panel" data-settings-panel="brand" hidden={activeTab !== 'brand'}>
      <fieldset>
        <legend class="mb-1 font-semibold">Logo</legend>
        <MediaPicker client:load csrf={session.csrfToken} items={media} name="logo_media_id" selected={values.logo_media_id ? [values.logo_media_id] : []} editAlt />
        <p class="seo-hint">Bỏ ảnh chỉ gỡ khỏi website, không xóa file trong thư viện.</p>
        {errors.logo_media_id && <span class="error-text">{errors.logo_media_id}</span>}
      </fieldset>
      <fieldset class="mt-4">
        <legend class="mb-1 font-semibold">Favicon</legend>
        <MediaPicker client:load csrf={session.csrfToken} items={media} name="favicon_media_id" selected={values.favicon_media_id ? [values.favicon_media_id] : []} editAlt />
        <p class="seo-hint">JPEG, PNG hoặc WebP. Chưa chọn thì trang dùng favicon.svg có sẵn.</p>
        {errors.favicon_media_id && <span class="error-text">{errors.favicon_media_id}</span>}
      </fieldset>
    </div>

    <div class="settings-panel" data-settings-panel="seo" hidden={activeTab !== 'seo'}>
      <SearchPreview
        site={{ name: values.site_name || 'Website', host: Astro.url.host, markUrl: logo?.url ?? '' }}
        title={previewTitle}
        description={previewDescription}
        slug=""
        emptyDescription={!values.default_seo_description && !values.site_description}
        titleName="default_seo_title"
        descriptionName="default_seo_description"
        fallbackTitleName="site_name"
        fallbackDescriptionName="site_description"
        homeUrl
      />
      <label class="mt-4 block">
        <span class="seo-label">
          <span>SEO Title</span>
          <span data-seo-title-count>{values.default_seo_title.length} ký tự</span>
        </span>
        <input class="field" name="default_seo_title" maxlength="180" value={values.default_seo_title} />
        <span class="seo-hint">Để trống thì dùng tên website.</span>
        <span class="seo-hint" data-seo-title-note>{lengthNote(values.default_seo_title.length, SEO_TITLE_RANGE.min, SEO_TITLE_RANGE.max)}</span>
        {errors.default_seo_title && <span class="error-text">{errors.default_seo_title}</span>}
      </label>
      <label class="mt-4 block">
        <span class="seo-label">
          <span>Meta Description</span>
          <span data-seo-desc-count>{values.default_seo_description.length} ký tự</span>
        </span>
        <textarea class="field min-h-24" name="default_seo_description" maxlength="300">{values.default_seo_description}</textarea>
        <span class="seo-hint">Để trống thì dùng mô tả website. Nên khoảng 70–160 ký tự.</span>
        <span class="seo-hint" data-seo-desc-note>{lengthNote(values.default_seo_description.length, SEO_DESC_RANGE.min, SEO_DESC_RANGE.max)}</span>
        {errors.default_seo_description && <span class="error-text">{errors.default_seo_description}</span>}
      </label>
      <fieldset class="mt-4">
        <legend class="mb-1 font-semibold">Ảnh Open Graph mặc định</legend>
        <MediaPicker client:load csrf={session.csrfToken} items={media} name="og_media_id" selected={values.og_media_id ? [values.og_media_id] : []} editAlt />
        <p class="seo-hint">Dùng khi trang không có ảnh riêng. Bài viết và sản phẩm vẫn dùng ảnh của chúng.</p>
        {errors.og_media_id && <span class="error-text">{errors.og_media_id}</span>}
      </fieldset>
    </div>

    <div class="settings-save">
      <button class="btn btn-primary" type="submit">Lưu cài đặt</button>
      <p class="settings-status text-primary-strong" role="status" data-settings-status>
        {saved === '1' && !formError ? 'Đã lưu cài đặt.' : saved === '0' && !formError ? 'Không có thay đổi.' : ''}
      </p>
    </div>
  </form>
</AdminLayout>

<script>
  const form = document.querySelector('[data-settings]');
  if (form instanceof HTMLFormElement) {
    const tabs = [...form.querySelectorAll('[data-settings-tab]')];
    const panels = [...form.querySelectorAll('[data-settings-panel]')];
    const show = (id: string) => {
      for (const tab of tabs) {
        if (!(tab instanceof HTMLButtonElement)) continue;
        const selected = tab.dataset.settingsTab === id;
        tab.setAttribute('aria-selected', selected ? 'true' : 'false');
        tab.tabIndex = selected ? 0 : -1;
      }
      for (const panel of panels) {
        if (panel instanceof HTMLElement) panel.hidden = panel.dataset.settingsPanel !== id;
      }
    };
    show(form.dataset.activeTab || 'general');
    for (const tab of tabs) {
      tab.addEventListener('click', () => {
        const id = tab instanceof HTMLElement ? tab.dataset.settingsTab : '';
        if (!id) return;
        show(id);
        const url = new URL(location.href);
        url.searchParams.set('tab', id);
        history.replaceState(null, '', url);
      });
    }
    form.addEventListener('submit', () => {
      const status = form.querySelector('[data-settings-status]');
      if (status) status.textContent = 'Đang lưu...';
    });
  }
</script>
