---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { mutationError } from '../../features/auth/session';
import { listMedia } from '../../features/media/media';
import { getSettings, parseSettingsForm, saveSettings, SETTING_KEYS, type SiteSettingValues } from '../../features/settings/settings';
import { createDb } from '../../lib/db/client';
import { getDbBinding } from '../../lib/cloudflare/env';
import { routes } from '../../lib/routes';
import type { FieldErrors } from '../../lib/validation/errors';

const session = Astro.locals.adminSession;
if (!session) return Astro.redirect(routes.adminLogin);

const db = createDb(getDbBinding());
const covers = (await listMedia(db)).map((item) => ({ id: item.id, filename: item.filename }));
let values = await getSettings(db);
let errors: FieldErrors = {};
let formError = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const blocked = mutationError(Astro.request, session, form);
  if (blocked) {
    Astro.response.status = 403;
    formError = blocked;
  } else {
    const parsed = parseSettingsForm(form);
    values = valuesFrom(form, values);
    if (!parsed.ok) {
      Astro.response.status = 422;
      errors = parsed.errors;
    } else {
      await saveSettings(db, parsed.values);
      return Astro.redirect(`${routes.adminSettings}?saved=1`, 303);
    }
  }
}

const saved = Astro.url.searchParams.get('saved') === '1';
const fields: Array<{ key: keyof SiteSettingValues; label: string; area?: boolean }> = [
  { key: 'site_name', label: 'Tên website' },
  { key: 'site_description', label: 'Mô tả', area: true },
  { key: 'phone', label: 'Điện thoại' },
  { key: 'contact_info', label: 'Thông tin liên hệ', area: true },
  { key: 'facebook_url', label: 'Facebook' },
  { key: 'zalo_url', label: 'Zalo' },
  { key: 'default_seo_title', label: 'SEO title mặc định' },
  { key: 'default_seo_description', label: 'Mô tả SEO mặc định', area: true },
];

function valuesFrom(form: FormData, current: SiteSettingValues): SiteSettingValues {
  const next = { ...current };
  for (const key of SETTING_KEYS) {
    const value = form.get(key);
    if (typeof value === 'string') next[key] = value;
  }
  return next;
}
---

<AdminLayout title="Cài đặt">
  {saved && !formError && <p class="mb-4 text-primary-strong" role="status">Đã lưu cài đặt.</p>}
  {formError && <p class="error-text mb-4" role="alert">{formError}</p>}
  <form class="max-w-xl" method="post" data-busy>
    <input type="hidden" name="csrf" value={session.csrfToken} />
    {
      fields.map((field) => (
        <label class="mt-4 block first:mt-0">
          <span class="mb-1 block font-semibold">{field.label}</span>
          {field.area ? (
            <textarea class="field min-h-24" name={field.key} maxlength="300">{values[field.key]}</textarea>
          ) : (
            <input class="field" name={field.key} maxlength="300" value={values[field.key]} />
          )}
          {errors[field.key] && <span class="error-text">{errors[field.key]}</span>}
        </label>
      ))
    }
    <label class="mt-4 block">
      <span class="mb-1 block font-semibold">Logo</span>
      <select class="field" name="logo_media_id">
        <option value="">Không chọn</option>
        {covers.map((cover) => <option value={cover.id} selected={values.logo_media_id === String(cover.id)}>{cover.filename}</option>)}
      </select>
      {errors.logo_media_id && <span class="error-text">{errors.logo_media_id}</span>}
    </label>
    <label class="mt-4 block">
      <span class="mb-1 block font-semibold">Favicon</span>
      <select class="field" name="favicon_media_id">
        <option value="">Không chọn</option>
        {covers.map((cover) => <option value={cover.id} selected={values.favicon_media_id === String(cover.id)}>{cover.filename}</option>)}
      </select>
      {errors.favicon_media_id && <span class="error-text">{errors.favicon_media_id}</span>}
    </label>
    <button class="btn btn-primary mt-6" type="submit">Lưu cài đặt</button>
  </form>
</AdminLayout>
