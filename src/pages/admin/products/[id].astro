---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import ProductForm from '../../../components/admin/ProductForm.astro';
import { mutationError } from '../../../features/auth/session';
import { parseRecipe, resolveRecipeLines, type RecipeLine } from '../../../features/materials/costing';
import { listRecipeOptions, loadRecipe } from '../../../features/materials/recipes';
import { listMedia } from '../../../features/media/media';
import { listProductCategories } from '../../../features/products/categories';
import { parseProductForm } from '../../../features/products/form';
import { getProduct, updateProduct } from '../../../features/products/products';
import { createDb } from '../../../lib/db/client';
import { getDbBinding } from '../../../lib/cloudflare/env';
import { routes } from '../../../lib/routes';
import type { FieldErrors } from '../../../lib/validation/errors';

const session = Astro.locals.adminSession;
if (!session) return Astro.redirect(routes.adminLogin);

const id = Number(Astro.params.id);
if (!Number.isInteger(id) || id < 1) return Astro.redirect(routes.adminProducts);

const db = createDb(getDbBinding());
const product = await getProduct(db, id);
if (!product) return Astro.redirect(routes.adminProducts);

const media = await listMedia(db);
const categories = await listProductCategories(db);
const currentRecipe = await loadRecipe(db, id);
let postedRecipe: RecipeLine[] | null = null;
let values = {
  name: product.name,
  slug: product.slug,
  price: String(product.price),
  comparePrice: product.comparePrice == null ? '' : String(product.comparePrice),
  categoryId: product.categoryId ? String(product.categoryId) : '',
  cordType: product.cordType,
  description: product.description,
  coverMediaId: product.coverMediaId ? String(product.coverMediaId) : '',
  album: product.albumIds.map(String),
  status: product.status,
  featured: product.isFeatured,
  sortOrder: String(product.sortOrder),
  seoTitle: product.seoTitle ?? '',
  metaDescription: product.metaDescription ?? '',
};
let errors: FieldErrors = {};
let formError = '';
const saved = Astro.url.searchParams.get('saved') === '1';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const blocked = mutationError(Astro.request, session, form);
  values = valuesFrom(form);
  const posted = parseRecipe(
    form.getAll('materialId').filter((value): value is string => typeof value === 'string'),
    form.getAll('materialQty').filter((value): value is string => typeof value === 'string'),
  );
  if (posted.ok) postedRecipe = posted.lines;
  if (blocked) {
    Astro.response.status = 403;
    formError = blocked;
  } else {
    const parsed = parseProductForm(form);
    if (!parsed.ok) {
      Astro.response.status = 422;
      errors = parsed.errors;
    } else {
      const result = await updateProduct(db, id, parsed.input);
      if (!result.ok) {
        Astro.response.status = 422;
        formError = result.error;
      } else {
        return Astro.redirect(`${routes.adminProduct(id)}?saved=1`, 303);
      }
    }
  }
}

// Gửi lỗi thì giữ đúng công thức khách vừa chọn; mở trang bình thường thì lấy công thức đã lưu.
const recipeSource: RecipeLine[] = postedRecipe ?? currentRecipe.map(({ materialId, quantity }) => ({ materialId, quantity }));
const recipeOptions = await listRecipeOptions(db, [...currentRecipe.map((line) => line.materialId), ...recipeSource.map((line) => line.materialId)]);
const recipeLines = resolveRecipeLines(recipeSource, recipeOptions);

function valuesFrom(form: FormData) {
  const read = (name: string) => {
    const value = form.get(name);
    return typeof value === 'string' ? value : '';
  };
  return {
    name: read('name'),
    slug: read('slug'),
    price: read('price'),
    comparePrice: read('comparePrice'),
    categoryId: read('categoryId'),
    cordType: read('cordType'),
    description: read('description'),
    coverMediaId: read('coverMediaId'),
    album: form.getAll('album').filter((value): value is string => typeof value === 'string'),
    status: read('status') || 'active',
    featured: form.get('featured') === '1',
    sortOrder: read('sortOrder') || '0',
    seoTitle: read('seoTitle'),
    metaDescription: read('metaDescription'),
  };
}
---

<AdminLayout title="Sửa sản phẩm">
  {saved && <p class="mb-4 text-primary-strong" role="status">Đã lưu sản phẩm.</p>}
  <ProductForm
    csrf={session.csrfToken}
    action={routes.adminProduct(id)}
    deleteAction={routes.adminProductDelete(id)}
    {values}
    {errors}
    {formError}
    {media}
    {categories}
    {recipeOptions}
    {recipeLines}
  />
</AdminLayout>
