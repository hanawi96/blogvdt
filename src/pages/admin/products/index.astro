---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { listProducts } from '../../../features/products/products';
import { isProductStatus, PRODUCT_STATUS_LABELS } from '../../../features/products/status';
import { createDb } from '../../../lib/db/client';
import { getDbBinding } from '../../../lib/cloudflare/env';
import { formatVnd } from '../../../lib/money';
import { routes } from '../../../lib/routes';

if (!Astro.locals.adminSession) return Astro.redirect(routes.adminLogin);

const query = Astro.url.searchParams.get('q') ?? '';
const statusParam = Astro.url.searchParams.get('status') ?? '';
const status = isProductStatus(statusParam) ? statusParam : '';
const page = Number(Astro.url.searchParams.get('page') ?? '1');
let loadError = '';
let result: Awaited<ReturnType<typeof listProducts>> | null = null;
try {
  result = await listProducts(createDb(getDbBinding()), { query, status, page: Number.isInteger(page) ? page : 1 });
} catch (error) {
  console.error(JSON.stringify({ event: 'product_list_failed', name: error instanceof Error ? error.name : 'unknown' }));
  loadError = 'Không tải được danh sách sản phẩm.';
}

function pageHref(nextPage: number): string {
  const params = new URLSearchParams();
  if (query) params.set('q', query);
  if (status) params.set('status', status);
  if (nextPage > 1) params.set('page', String(nextPage));
  const text = params.toString();
  return text ? `${routes.adminProducts}?${text}` : routes.adminProducts;
}
---

<AdminLayout title="Sản phẩm">
  <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
    <form class="flex flex-wrap gap-2" method="get">
      <label class="sr-only" for="product-query">Tìm sản phẩm</label>
      <input id="product-query" class="field max-w-xs" name="q" value={query} placeholder="Tìm tên" maxlength="160" />
      <label class="sr-only" for="product-status">Trạng thái</label>
      <select id="product-status" class="field w-auto" name="status">
        <option value="" selected={status === ''}>Mọi trạng thái</option>
        <option value="active" selected={status === 'active'}>Đang bán</option>
        <option value="inactive" selected={status === 'inactive'}>Ngừng bán</option>
      </select>
      <button class="btn" type="submit">Lọc</button>
    </form>
    <a class="btn btn-primary" href={routes.adminProductNew}>Thêm sản phẩm</a>
  </div>
  {loadError && <p class="error-text" role="alert">{loadError}</p>}
  {result && result.rows.length === 0 && <p class="text-muted">Chưa có sản phẩm khớp bộ lọc.</p>}
  {
    result && result.rows.length > 0 && (
      <div class="overflow-x-auto">
        <table class="w-full border-collapse text-left">
          <thead>
            <tr class="border-b border-line">
              <th class="py-2">Tên</th>
              <th class="py-2">Giá</th>
              <th class="py-2">Trạng thái</th>
              <th class="py-2">Trang chủ</th>
            </tr>
          </thead>
          <tbody>
            {result.rows.map((product) => (
              <tr class="border-b border-line">
                <td class="py-2">
                  <a class="font-semibold underline" href={routes.adminProduct(product.id)}>{product.name}</a>
                </td>
                <td class="py-2">{formatVnd(product.price)}</td>
                <td class="py-2">{isProductStatus(product.status) ? PRODUCT_STATUS_LABELS[product.status] : product.status}</td>
                <td class="py-2">{product.isFeatured ? 'Có' : '—'}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )
  }
  {
    result && result.pageCount > 1 && (
      <nav class="mt-4 flex gap-3" aria-label="Phân trang">
        {result.page > 1 && <a href={pageHref(result.page - 1)}>Trang trước</a>}
        <span>Trang {result.page}/{result.pageCount}</span>
        {result.page < result.pageCount && <a href={pageHref(result.page + 1)}>Trang sau</a>}
      </nav>
    )
  }
</AdminLayout>
