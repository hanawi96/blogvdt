---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { mutationError } from '../../features/auth/session';
import { advanceHealthRun, loadHealth, type HealthSnapshot } from '../../features/seo/health-run';
import {
  HEALTH_CODE_LABELS,
  HEALTH_CODES,
  HEALTH_LOAD_ERROR,
  HEALTH_RUN_ERROR,
  healthFigures,
  healthNote,
  isHealthCode,
  readHealthFilters,
} from '../../features/seo/health';
import { HEALTH_PRIORITY_LIMIT, HEALTH_UI } from '../../features/seo/messages';
import { createDb } from '../../lib/db/client';
import { getDbBinding, getSiteOrigin, optionalMediaBucket } from '../../lib/cloudflare/env';
import { formatDateTime } from '../../lib/datetime';
import { routes } from '../../lib/routes';

const session = Astro.locals.adminSession;
if (!session) return Astro.redirect(routes.adminLogin);
if (session.role !== 'admin') return new Response('Bạn không có quyền vào trang này.', { status: 403 });

const filters = readHealthFilters(Astro.url.searchParams);
let formError = '';
const origin = getSiteOrigin(Astro.url.origin);

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const blocked = mutationError(Astro.request, session, form);
  if (blocked) {
    Astro.response.status = 403;
    formError = blocked;
  } else {
    try {
      const mode = form.get('mode') === 'continue' ? 'continue' : 'start';
      await advanceHealthRun(createDb(getDbBinding()), {
        mode,
        origin,
        now: Date.now(),
        bucket: optionalMediaBucket(),
      });
      return Astro.redirect(routes.adminSeo);
    } catch (error) {
      console.error(JSON.stringify({ event: 'seo_health_run_failed', name: error instanceof Error ? error.name : 'unknown' }));
      formError = HEALTH_RUN_ERROR;
    }
  }
}

let loadError = '';
let snapshot: HealthSnapshot | null = null;
try {
  snapshot = await loadHealth(createDb(getDbBinding()), filters);
} catch (error) {
  console.error(JSON.stringify({ event: 'seo_health_load_failed', name: error instanceof Error ? error.name : 'unknown' }));
  loadError = HEALTH_LOAD_ERROR;
}

const figures = snapshot?.figures ?? healthFigures({ failed: true, hasRun: false, errors: 0, warnings: 0, verified: 0, pending: 0 });
const whenLabel = snapshot?.run ? formatDateTime(snapshot.run.finishedAt ?? snapshot.run.startedAt) : '';
const note = loadError
  ? loadError
  : healthNote({
      failed: false,
      phase: snapshot?.run?.phase ?? null,
      whenLabel,
      published: snapshot?.published ?? 0,
      verified: snapshot?.verified ?? 0,
      unchecked: snapshot?.unchecked ?? 0,
      stale: snapshot?.stale ?? 0,
    });
const inProgress = Boolean(snapshot?.run && snapshot.run.phase !== 'done');
const filtered = Boolean(filters.severity || filters.code || filters.postId);
const hasRun = Boolean(snapshot?.run);
const score = snapshot?.score ?? null;
const breakdown = snapshot?.breakdown ?? [];
const priority = breakdown.slice(0, HEALTH_PRIORITY_LIMIT);
const priorityExtra = Math.max(0, breakdown.length - priority.length);
const scoreTone = score ? (score.score >= 90 ? 'good' : score.score >= 70 ? 'warn' : 'bad') : 'warn';
const scoreProvisional = Boolean(hasRun && score && !score.ready);

function pageHref(page: number): string {
  const params = new URLSearchParams();
  if (filters.severity) params.set('severity', filters.severity);
  if (filters.code) params.set('code', filters.code);
  if (filters.postId) params.set('post', String(filters.postId));
  if (page > 1) params.set('page', String(page));
  const text = params.toString();
  return text ? `${routes.adminSeo}?${text}` : routes.adminSeo;
}

// Link lọc nhanh theo loại lỗi: giữ bài đang chọn, bỏ severity và trang để xem toàn bộ loại đó.
function codeHref(code: string): string {
  if (filters.code === code) return filters.postId ? `${routes.adminSeo}?post=${filters.postId}` : routes.adminSeo;
  const params = new URLSearchParams();
  params.set('code', code);
  if (filters.postId) params.set('post', String(filters.postId));
  return `${routes.adminSeo}?${params.toString()}`;
}

function codeLabel(code: string): string {
  return isHealthCode(code) ? HEALTH_CODE_LABELS[code] : code;
}
---

<AdminLayout title="Kiểm tra SEO">
  <p slot="lead">{note}</p>
  <form slot="action" method="post" class="order-page-actions seo-run-actions">
    <input type="hidden" name="csrf" value={session.csrfToken} />
    {
      inProgress ? (
        <>
          <button class="btn btn-primary" type="submit" name="mode" value="continue">Tiếp tục kiểm tra</button>
          <button class="btn" type="submit" name="mode" value="start">Kiểm tra lại từ đầu</button>
        </>
      ) : (
        <button class="btn btn-primary" type="submit" name="mode" value="start">{snapshot?.run ? 'Kiểm tra lại' : 'Chạy kiểm tra'}</button>
      )
    }
  </form>
  {formError && <p class="error-text" role="alert">{formError}</p>}
  {
    !loadError && snapshot?.run && (
      <section class="health-overview" aria-label="Tổng quan sức khỏe">
        <div class="health-score" data-tone={scoreTone}>
          <p class="health-score-value">{hasRun && score ? `${score.score}%` : '—'}</p>
          <p class="health-score-label">{HEALTH_UI.scoreLabel}</p>
          {hasRun && score && (
            <div class="health-meter" role="img" aria-label={`Đạt ${score.score} phần trăm`}>
              <span style={`width:${score.score}%`}></span>
            </div>
          )}
          {scoreProvisional && <p class="health-score-note">{HEALTH_UI.scoreProvisional}</p>}
        </div>
        <ul class="health-stats">
          <li>
            <span class="health-stat-value">{hasRun && score ? `${score.cleanPosts}/${score.denominator}` : '—'}</span>
            <span class="health-stat-label">{HEALTH_UI.cleanLabel}</span>
          </li>
          <li data-kind="error">
            <span class="health-stat-value">{figures.errors}</span>
            <span class="health-stat-label">{HEALTH_UI.errorsLabel}</span>
          </li>
          <li data-kind="warning">
            <span class="health-stat-value">{figures.warnings}</span>
            <span class="health-stat-label">{HEALTH_UI.warningsLabel}</span>
          </li>
          <li>
            <span class="health-stat-value">{figures.pending}</span>
            <span class="health-stat-label">{HEALTH_UI.pendingLabel}</span>
          </li>
        </ul>
      </section>
    )
  }
  {
    hasRun && priority.length > 0 && (
      <section class="health-codes" aria-label={HEALTH_UI.priorityHeading}>
        <h2 class="health-section-title">{HEALTH_UI.priorityHeading}</h2>
        <p class="health-priority-hint">{HEALTH_UI.priorityHint}</p>
        <ul class="health-code-grid">
          {priority.map((stat) => (
            <li>
              <a
                class="health-code"
                href={codeHref(stat.code)}
                aria-pressed={filters.code === stat.code}
                data-active={filters.code === stat.code}
              >
                <span class="health-code-label">{stat.label}</span>
                <span class="health-code-counts">
                  {stat.errors > 0 && <span class="health-chip" data-kind="error">{stat.errors} lỗi</span>}
                  {stat.warnings > 0 && <span class="health-chip" data-kind="warning">{stat.warnings} cảnh báo</span>}
                </span>
              </a>
            </li>
          ))}
        </ul>
        {priorityExtra > 0 && <p class="health-priority-more">{HEALTH_UI.priorityMore(priorityExtra)}</p>}
        {filters.code && (
          <a class="health-code-clear" href={filters.postId ? `${routes.adminSeo}?post=${filters.postId}` : routes.adminSeo}>
            {HEALTH_UI.priorityClear}
          </a>
        )}
      </section>
    )
  }
  {
    snapshot && !snapshot.run && !loadError && (
      <section class="cms-empty">
        <span class="cms-empty-icon" aria-hidden="true">
          <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="10.5" cy="10.5" r="6" />
            <path d="m15 15 4.5 4.5" />
            <path d="M8 10.5h5M10.5 8v5" />
          </svg>
        </span>
        <h2 class="cms-empty-title">{HEALTH_UI.emptyTitle}</h2>
        <p class="cms-empty-text">
          {snapshot.published > 0 ? HEALTH_UI.emptyBodyPublished(snapshot.published) : HEALTH_UI.emptyBodyNone}
        </p>
        <ul class="cms-empty-points">
          {HEALTH_UI.emptyPoints.map((point) => <li>{point}</li>)}
        </ul>
        <form method="post">
          <input type="hidden" name="csrf" value={session.csrfToken} />
          <button class="btn btn-primary" type="submit" name="mode" value="start">{HEALTH_UI.emptyStart}</button>
        </form>
      </section>
    )
  }
  {
    snapshot?.run && (
      <section class="health-results" aria-label={HEALTH_UI.issuesHeading}>
        <div class="health-results-head">
          <h2 class="health-section-title">{HEALTH_UI.issuesHeading}</h2>
        </div>
        <form class="seo-filter-toolbar" method="get">
          <div class="seo-filter-field">
            <label class="seo-filter-label" for="seo-severity">{HEALTH_UI.filterSeverity}</label>
            <select id="seo-severity" class="field" name="severity">
              <option value="" selected={filters.severity === ''}>{HEALTH_UI.filterAllSeverity}</option>
              <option value="error" selected={filters.severity === 'error'}>{HEALTH_UI.errorsLabel}</option>
              <option value="warning" selected={filters.severity === 'warning'}>{HEALTH_UI.warningsLabel}</option>
            </select>
          </div>
          <div class="seo-filter-field">
            <label class="seo-filter-label" for="seo-code">{HEALTH_UI.filterCode}</label>
            <select id="seo-code" class="field" name="code">
              <option value="" selected={filters.code === ''}>{HEALTH_UI.filterAllCode}</option>
              {HEALTH_CODES.map((code) => (
                <option value={code} selected={filters.code === code}>{HEALTH_CODE_LABELS[code]}</option>
              ))}
            </select>
          </div>
          <div class="seo-filter-field seo-filter-field-post">
            <label class="seo-filter-label" for="seo-post">{HEALTH_UI.filterPost}</label>
            <select id="seo-post" class="field" name="post">
              <option value="" selected={filters.postId === null}>{HEALTH_UI.filterAllPost}</option>
              {snapshot.postOptions.map((option) => (
                <option value={option.id} selected={filters.postId === option.id}>{option.title}</option>
              ))}
              {filters.postId && !snapshot.postOptions.some((option) => option.id === filters.postId) && (
                <option value={filters.postId} selected>Bài {filters.postId}</option>
              )}
            </select>
          </div>
          <div class="seo-filter-actions">
            <button class="btn" type="submit">{HEALTH_UI.filterSubmit}</button>
            {filtered && <a class="btn" href={routes.adminSeo}>{HEALTH_UI.filterReset}</a>}
          </div>
        </form>
        {
          snapshot.issues.length === 0 ? (
            <div class="health-empty" data-state={filtered ? 'filtered' : snapshot.run.phase === 'done' ? 'done' : 'progress'}>
              <p>
                {filtered
                  ? HEALTH_UI.issuesEmptyFiltered
                  : snapshot.run.phase === 'done'
                    ? HEALTH_UI.issuesEmptyDone
                    : HEALTH_UI.issuesEmptyProgress}
              </p>
              {filtered && <a class="btn" href={routes.adminSeo}>{HEALTH_UI.filterReset}</a>}
            </div>
          ) : (
            <table class="post-table health-table">
              <thead>
                <tr>
                  <th>{HEALTH_UI.colPost}</th>
                  <th>{HEALTH_UI.colLevel}</th>
                  <th>{HEALTH_UI.colCode}</th>
                  <th>{HEALTH_UI.colDetail}</th>
                  <th>{HEALTH_UI.colFix}</th>
                </tr>
              </thead>
              <tbody>
                {snapshot.issues.map((issue) => (
                  <tr>
                    <td class="health-list-post" data-label={HEALTH_UI.colPost}>
                      {issue.postId ? (
                        <a class="font-semibold underline" href={routes.adminPost(issue.postId)}>{issue.postTitle}</a>
                      ) : (
                        issue.postTitle
                      )}
                    </td>
                    <td class="health-list-level" data-label={HEALTH_UI.colLevel} data-kind={issue.severity}>
                      {issue.severity === 'error' ? HEALTH_UI.levelError : HEALTH_UI.levelWarning}
                    </td>
                    <td class="health-list-code" data-label={HEALTH_UI.colCode}>{codeLabel(issue.code)}</td>
                    <td class="health-list-detail" data-label={HEALTH_UI.colDetail}>{issue.detail}</td>
                    <td class="health-list-fix" data-label={HEALTH_UI.colFix}>
                      {issue.postId ? (
                        <a class="category-list-edit" href={routes.adminPost(issue.postId)}>{HEALTH_UI.fixAction}</a>
                      ) : (
                        '—'
                      )}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          )
        }
        {
          snapshot.pageCount > 1 && (
            <nav class="post-pager" aria-label="Phân trang">
              {snapshot.page > 1 && <a class="btn" href={pageHref(snapshot.page - 1)}>Trang trước</a>}
              <span>Trang {snapshot.page}/{snapshot.pageCount}</span>
              {snapshot.page < snapshot.pageCount && <a class="btn" href={pageHref(snapshot.page + 1)}>Trang sau</a>}
            </nav>
          )
        }
      </section>
    )
  }
  {
    snapshot?.run && (snapshot.uncheckedPosts.length > 0 || snapshot.stalePosts.length > 0) && (
      <aside class="health-aside" aria-label="Trạng thái bài viết">
        {
          snapshot.uncheckedPosts.length > 0 && (
            <section>
              <h2 class="health-aside-title">{HEALTH_UI.uncheckedHeading}</h2>
              <ul class="health-aside-list">
                {snapshot.uncheckedPosts.map((post) => (
                  <li><a href={routes.adminPost(post.id)}>{post.title}</a></li>
                ))}
              </ul>
              {snapshot.unchecked > snapshot.uncheckedPosts.length && (
                <p class="health-aside-more">{HEALTH_UI.morePosts(snapshot.unchecked - snapshot.uncheckedPosts.length)}</p>
              )}
            </section>
          )
        }
        {
          snapshot.stalePosts.length > 0 && (
            <section>
              <h2 class="health-aside-title">{HEALTH_UI.staleHeading}</h2>
              <ul class="health-aside-list">
                {snapshot.stalePosts.map((post) => (
                  <li><a href={routes.adminPost(post.id)}>{post.title}</a></li>
                ))}
              </ul>
              {snapshot.stale > snapshot.stalePosts.length && (
                <p class="health-aside-more">{HEALTH_UI.morePosts(snapshot.stale - snapshot.stalePosts.length)}</p>
              )}
            </section>
          )
        }
      </aside>
    )
  }
</AdminLayout>
