</style>
<script>
  type ProductMeta = { id: number; name: string; cover: string };
  type BraceletGroupState = { primary: number; addons: number[] };
  type PickerTarget =
    | { mode: 'multi'; index: number }
    | { mode: 'pair'; pairIndex: number; role: 'primary' | 'addon'; addonIndex?: number };
  type PickItem = { id: number; name: string; coverUrl?: string | null };

  const kindInputs = document.querySelectorAll('[data-collection-kind]');
  const kindOptions = document.querySelector('[data-kind-options]');
  const pairFields = document.querySelector('[data-pair-fields]');
  const pairBadgeWrap = document.querySelector('[data-pair-badge-wrap]');
  const pairDiscountWrap = document.querySelector('[data-pair-discount-wrap]');
  const pairDiscountType = document.querySelector('[data-pair-discount-type]');
  const pairDiscountValue = document.querySelector('[data-pair-discount-value]');
  const pairDiscountHint = document.querySelector('[data-pair-discount-hint]');
  const braceletFields = document.querySelector('[data-bracelet-fields]');
  const pairBuyQty = document.querySelector('[data-pair-buy-qty]');
  const pairBadge = document.querySelector('[data-pair-badge]');
  const braceletBadge = document.querySelector('[data-bracelet-badge]');
  const hint = document.querySelector('[data-kind-hint]');
  const idsField = document.querySelector('[data-product-ids]');
  const countEl = document.querySelector('[data-pick-count]');
  const selectedPanel = document.querySelector('[data-selected-panel]');
  const selectedList = document.querySelector('[data-selected-list]');
  const selectedEmpty = document.querySelector('[data-selected-empty]');
  const multiHead = document.querySelector('[data-multi-selected-head]');
  const pairHead = document.querySelector('[data-pair-selected-head]');
  const pairSlots = document.querySelector('[data-pair-slots]');
  const pairCountEl = document.querySelector('[data-pair-count]');
  const dialog = document.querySelector('[data-pick-dialog]');
  const pickTitle = document.querySelector('[data-pick-title]');
  const grid = document.querySelector('[data-pick-grid]');
  const emptyEl = document.querySelector('[data-pick-empty]');
  const pager = document.querySelector('[data-pick-pager]');
  const statusEl = document.querySelector('[data-pick-status]');
  const prevBtn = document.querySelector('[data-pick-prev]');
  const nextBtn = document.querySelector('[data-pick-next]');
  const closeBtn = document.querySelector('[data-pick-close]');
  const categorySelect = document.querySelector('[data-pick-category]');
  const MULTI_MAX = 6;
  const PAIR_MAX = Number(selectedPanel instanceof HTMLElement ? selectedPanel.dataset.pairMax : 3) || 3;
  const ADDON_MAX = Number(selectedPanel instanceof HTMLElement ? selectedPanel.dataset.addonMax : 3) || 3;
  const DISCOUNT_PERCENT_MAX =
    Number(selectedPanel instanceof HTMLElement ? selectedPanel.dataset.discountPercentMax : 70) || 70;
  const DISCOUNT_AMOUNT_MAX =
    Number(selectedPanel instanceof HTMLElement ? selectedPanel.dataset.discountAmountMax : 5_000_000) || 5_000_000;
  const groupsField = document.querySelector('[data-bracelet-groups]');
  const editorForm = document.querySelector('.home-collection-form');
  const metaById = new Map<number, ProductMeta>();
  const initialIds =
    idsField instanceof HTMLInputElement
      ? idsField.value
          .split(',')
          .map((part) => Number(part.trim()))
          .filter((id) => Number.isInteger(id) && id > 0)
      : [];
  let initialGroups: BraceletGroupState[] = [];
  try {
    const raw =
      groupsField instanceof HTMLTextAreaElement || groupsField instanceof HTMLInputElement
        ? groupsField.value
        : '[]';
    const parsed: unknown = JSON.parse(raw);
    if (Array.isArray(parsed)) {
      initialGroups = parsed.flatMap((item) => {
        if (!item || typeof item !== 'object') return [];
        const row = item as { primary?: unknown; addons?: unknown };
        const primary = Number(row.primary);
        const addons = Array.isArray(row.addons)
          ? row.addons.map((id) => Number(id)).filter((id) => Number.isInteger(id) && id > 0)
          : [];
        if (!Number.isInteger(primary) || primary < 1 || addons.length === 0) return [];
        return [{ primary, addons }];
      });
    }
  } catch {
    initialGroups = [];
  }
  let multiSlots = Array.from({ length: MULTI_MAX }, (_, i) => initialIds[i] ?? 0);
  let groups: BraceletGroupState[] = Array.from({ length: PAIR_MAX }, (_, i) => {
    const group = initialGroups[i];
    return {
      primary: group?.primary ?? 0,
      addons: group?.addons?.length ? [...group.addons] : [0],
    };
  });
  let pickerTarget: PickerTarget | null = null;
  let page = 1;
  let pageCount = 1;
  let total = 0;
  let loading = false;

  const kindValue = () => {
    for (const input of kindInputs) {
      if (input instanceof HTMLInputElement && input.checked) return input.value;
    }
    return 'products';
  };
  const isPairKind = () => kindValue() === 'bracelet_addon';

  const rememberMeta = (id: number, name: string, cover: string) => {
    if (!Number.isInteger(id) || id < 1) return;
    metaById.set(id, { id, name: name || `#${id}`, cover: cover || '' });
  };

  document.querySelectorAll('[data-selected-id]').forEach((node) => {
    if (!(node instanceof HTMLElement)) return;
    const id = Number(node.dataset.selectedId);
    const name =
      node.querySelector('.home-collection-slot-name, .home-collection-pair-pick-name')?.textContent?.trim() || '';
    const cover = node.querySelector('img')?.getAttribute('src') || '';
    rememberMeta(id, name, cover);
  });

  const pickMeta = (id: number): ProductMeta | null => metaById.get(id) ?? null;

  const completeGroups = () =>
    groups
      .filter((group) => group.primary > 0 && group.addons.some((id) => id > 0))
      .map((group) => ({
        primary: group.primary,
        addons: group.addons.filter((id) => id > 0),
      }));

  const denseIds = () => {
    if (!isPairKind()) return multiSlots.filter((id) => id > 0);
    return completeGroups().flatMap((group) => [group.primary, ...group.addons]);
  };

  const completePairCount = () => completeGroups().length;

  /** SP đã gắn trong ngữ cảnh picker hiện tại (multi: cả khối; bracelet: chỉ combo đang chọn). */
  const pickerHighlightIds = (): Set<number> => {
    if (!isPairKind()) return new Set(denseIds());
    if (pickerTarget?.mode !== 'pair') return new Set();
    const group = groups[pickerTarget.pairIndex];
    const ids = new Set<number>();
    if (!group) return ids;
    if (group.primary) ids.add(group.primary);
    for (const addon of group.addons) {
      if (addon) ids.add(addon);
    }
    return ids;
  };

  const makeMultiSlot = (index: number, meta: ProductMeta | null) => {
    const li = document.createElement('li');
    li.className = meta ? 'home-collection-slot is-filled' : 'home-collection-slot is-empty';
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'home-collection-slot-btn';
    btn.dataset.openPicker = 'multi';
    btn.dataset.slotIndex = String(index);
    btn.setAttribute('aria-label', meta ? `Đổi sản phẩm ô ${index + 1}` : `Chọn sản phẩm ô ${index + 1}`);
    if (meta) btn.dataset.selectedId = String(meta.id);
    const orderEl = document.createElement('span');
    orderEl.className = 'home-collection-slot-order';
    orderEl.textContent = String(index + 1);
    btn.append(orderEl);
    if (meta) {
      if (meta.cover) {
        const img = document.createElement('img');
        img.src = meta.cover;
        img.alt = '';
        img.width = 72;
        img.height = 72;
        img.loading = 'lazy';
        img.decoding = 'async';
        btn.append(img);
      } else {
        const empty = document.createElement('span');
        empty.className = 'home-collection-pick-empty';
        empty.setAttribute('aria-hidden', 'true');
        btn.append(empty);
      }
      const name = document.createElement('span');
      name.className = 'home-collection-slot-name';
      name.textContent = meta.name;
      btn.append(name);
    } else {
      const placeholder = document.createElement('span');
      placeholder.className = 'home-collection-slot-placeholder';
      const plus = document.createElement('span');
      plus.className = 'home-collection-slot-plus';
      plus.setAttribute('aria-hidden', 'true');
      plus.textContent = '+';
      placeholder.append(plus, document.createTextNode('Thêm'));
      btn.append(placeholder);
    }
    li.append(btn);
    if (meta) {
      const clear = document.createElement('button');
      clear.type = 'button';
      clear.className = 'home-collection-slot-clear';
      clear.dataset.multiClear = String(index);
      clear.setAttribute('aria-label', `Xóa ô ${index + 1}`);
      clear.textContent = '×';
      li.append(clear);
    }
    return li;
  };

  const fillPairButton = (button: HTMLElement, meta: ProductMeta | null) => {
    button.replaceChildren();
    if (!meta) {
      const empty = document.createElement('span');
      empty.className = 'home-collection-pair-pick-empty';
      empty.textContent = 'Bấm để chọn sản phẩm';
      button.append(empty);
      return;
    }
    if (meta.cover) {
      const img = document.createElement('img');
      img.src = meta.cover;
      img.alt = '';
      img.width = 96;
      img.height = 96;
      img.loading = 'lazy';
      img.decoding = 'async';
      button.append(img);
    } else {
      const empty = document.createElement('span');
      empty.className = 'home-collection-pick-empty';
      empty.setAttribute('aria-hidden', 'true');
      button.append(empty);
    }
    const name = document.createElement('span');
    name.className = 'home-collection-pair-pick-name';
    name.textContent = meta.name;
    const muted = document.createElement('span');
    muted.className = 'text-muted';
    muted.textContent = `#${meta.id}`;
    button.append(name, muted);
  };

  const renderMultiSelected = () => {
    if (!(selectedList instanceof HTMLOListElement)) return;
    selectedList.replaceChildren();
    for (let index = 0; index < MULTI_MAX; index += 1) {
      const id = multiSlots[index] ?? 0;
      selectedList.append(makeMultiSlot(index, id ? pickMeta(id) : null));
    }
    const filled = multiSlots.filter((id) => id > 0).length;
    if (selectedEmpty instanceof HTMLElement) selectedEmpty.hidden = filled > 0;
  };

  const makeAddonSlot = (
    pairIndex: number,
    addonIndex: number,
    meta: ProductMeta | null,
    canRemove: boolean,
  ) => {
    const slot = document.createElement('div');
    slot.className = meta
      ? 'home-collection-pair-slot is-addon is-filled'
      : 'home-collection-pair-slot is-addon';
    slot.dataset.pairSlot = 'addon';
    slot.dataset.pairIndex = String(pairIndex);
    slot.dataset.addonIndex = String(addonIndex);
    if (meta) slot.dataset.selectedId = String(meta.id);
    const top = document.createElement('div');
    top.className = 'home-collection-pair-slot-top';
    const label = document.createElement('p');
    label.className = 'home-collection-pair-slot-label';
    label.textContent = `Lựa chọn ${addonIndex + 1}`;
    const clear = document.createElement('button');
    clear.type = 'button';
    clear.className = 'home-collection-pair-clear';
    clear.dataset.pairClear = 'addon';
    clear.dataset.pairIndex = String(pairIndex);
    clear.dataset.addonIndex = String(addonIndex);
    clear.hidden = !canRemove && !meta;
    clear.textContent = 'Xóa';
    top.append(label, clear);
    const button = document.createElement('button');
    button.type = 'button';
    button.className = 'home-collection-pair-pick';
    button.dataset.openPicker = 'pair';
    button.dataset.pairRole = 'addon';
    button.dataset.pairIndex = String(pairIndex);
    button.dataset.addonIndex = String(addonIndex);
    fillPairButton(button, meta);
    slot.append(top, button);
    return slot;
  };

  const renderPairSelected = () => {
    for (let pairIndex = 0; pairIndex < PAIR_MAX; pairIndex += 1) {
      const row = pairSlots?.querySelector(`[data-pair-row="${pairIndex}"]`);
      if (!(row instanceof HTMLElement)) continue;
      const group = groups[pairIndex] ?? { primary: 0, addons: [0] };
      const clearRow = row.querySelector(`[data-pair-clear-row="${pairIndex}"]`);
      if (clearRow instanceof HTMLElement) {
        clearRow.hidden = !(group.primary || group.addons.some((id) => id > 0));
      }
      const primarySlot = row.querySelector('[data-pair-slot="primary"]');
      if (primarySlot instanceof HTMLElement) {
        const meta = group.primary ? pickMeta(group.primary) : null;
        primarySlot.classList.toggle('is-filled', Boolean(meta));
        if (meta) primarySlot.dataset.selectedId = String(meta.id);
        else delete primarySlot.dataset.selectedId;
        const clear = primarySlot.querySelector('[data-pair-clear="primary"]');
        if (clear instanceof HTMLElement) clear.hidden = !meta;
        const button = primarySlot.querySelector('[data-open-picker="pair"]');
        if (button instanceof HTMLElement) fillPairButton(button, meta);
      }
      const list = row.querySelector(`[data-addon-list="${pairIndex}"]`);
      if (list instanceof HTMLElement) {
        const addonIds = group.addons.length ? group.addons : [0];
        list.replaceChildren(
          ...addonIds.map((addonId, addonIndex) =>
            makeAddonSlot(
              pairIndex,
              addonIndex,
              addonId ? pickMeta(addonId) : null,
              addonIds.length > 1,
            ),
          ),
        );
      }
      const addBtn = row.querySelector(`[data-addon-add="${pairIndex}"]`);
      if (addBtn instanceof HTMLElement) {
        const filled = group.addons.filter((id) => id > 0).length;
        addBtn.hidden = filled >= ADDON_MAX;
      }
    }
    if (pairCountEl) pairCountEl.textContent = String(completePairCount());
  };

  const writeGroupsField = (complete: BraceletGroupState[]) => {
    if (groupsField instanceof HTMLTextAreaElement || groupsField instanceof HTMLInputElement) {
      groupsField.value = JSON.stringify(complete);
    }
  };

  const writeSelection = () => {
    const ids = denseIds();
    if (idsField instanceof HTMLInputElement) idsField.value = ids.join(',');
    if (countEl) countEl.textContent = String(ids.length);
    if (isPairKind()) {
      const complete = completeGroups();
      writeGroupsField(complete);
      renderPairSelected();
    } else {
      writeGroupsField([]);
      renderMultiSelected();
    }
  };

  /**
   * Primary: duy nhất giữa các combo (và không nằm ở ô bán kèm).
   * Addon: được dùng chung nhiều combo (vd. 7/9 cành); chỉ tránh trùng trong cùng combo.
   */
  const clearIdAcrossGroups = (id: number, exceptIndex: number, role: 'primary' | 'addon') => {
    groups = groups.map((group, index) => {
      if (index === exceptIndex) {
        if (role === 'primary') {
          return {
            primary: group.primary,
            addons: group.addons.map((addon) => (addon === id ? 0 : addon)),
          };
        }
        return {
          primary: group.primary === id ? 0 : group.primary,
          addons: group.addons.map((addon) => (addon === id ? 0 : addon)),
        };
      }
      if (role === 'primary') {
        return {
          primary: group.primary === id ? 0 : group.primary,
          addons: group.addons.map((addon) => (addon === id ? 0 : addon)),
        };
      }
      // Addon mới: giữ bán kèm ở combo khác; chỉ gỡ nếu đang là vòng chính combo khác.
      return {
        primary: group.primary === id ? 0 : group.primary,
        addons: group.addons,
      };
    });
  };

  const setPairRole = (
    pairIndex: number,
    role: 'primary' | 'addon',
    id: number,
    addonIndex = 0,
  ) => {
    if (pairIndex < 0 || pairIndex >= PAIR_MAX) return;
    clearIdAcrossGroups(id, pairIndex, role);
    const group = groups[pairIndex] ?? { primary: 0, addons: [0] };
    if (role === 'primary') {
      group.addons = group.addons.map((addon) => (addon === id ? 0 : addon));
      group.primary = id;
    } else {
      if (group.primary === id) group.primary = 0;
      const next = group.addons.length ? [...group.addons] : [0];
      while (next.length <= addonIndex) next.push(0);
      next[addonIndex] = id;
      group.addons = next;
    }
    groups[pairIndex] = group;
  };

  const clearPairRole = (
    pairIndex: number,
    role: 'primary' | 'addon',
    addonIndex = 0,
  ) => {
    if (pairIndex < 0 || pairIndex >= PAIR_MAX) return;
    const group = groups[pairIndex] ?? { primary: 0, addons: [0] };
    if (role === 'primary') group.primary = 0;
    else if (group.addons.length <= 1) group.addons = [0];
    else group.addons = group.addons.filter((_, index) => index !== addonIndex);
    if (group.addons.length === 0) group.addons = [0];
    groups[pairIndex] = group;
  };

  const clearPairRow = (pairIndex: number) => {
    if (pairIndex < 0 || pairIndex >= PAIR_MAX) return;
    groups[pairIndex] = { primary: 0, addons: [0] };
  };

  const addAddonSlot = (pairIndex: number) => {
    if (pairIndex < 0 || pairIndex >= PAIR_MAX) return;
    const group = groups[pairIndex] ?? { primary: 0, addons: [0] };
    if (group.addons.filter((id) => id > 0).length >= ADDON_MAX) return;
    if (group.addons.length >= ADDON_MAX) return;
    group.addons = [...group.addons, 0];
    groups[pairIndex] = group;
  };

  const assignMultiSlot = (index: number, id: number) => {
    multiSlots = multiSlots.map((item) => (item === id ? 0 : item));
    multiSlots[index] = id;
  };

  const clearMultiSlot = (index: number) => {
    multiSlots[index] = 0;
  };

  let kindReady = false;
  const syncKind = () => {
    const value = kindValue();
    const pairMode = value === 'bracelet_addon';
    const comboMode = value === 'pair_discount';
    const discountMode = comboMode || pairMode;
    if (pairFields instanceof HTMLElement) pairFields.hidden = !comboMode;
    if (pairBadgeWrap instanceof HTMLElement) pairBadgeWrap.hidden = !comboMode;
    if (pairDiscountWrap instanceof HTMLElement) pairDiscountWrap.hidden = !discountMode;
    if (pairDiscountHint instanceof HTMLElement) pairDiscountHint.hidden = !discountMode;
    if (braceletFields instanceof HTMLElement) braceletFields.hidden = !pairMode;
    if (pairBuyQty instanceof HTMLInputElement) pairBuyQty.disabled = !comboMode;
    if (pairBadge instanceof HTMLInputElement) pairBadge.disabled = !comboMode;
    if (pairDiscountType instanceof HTMLSelectElement) pairDiscountType.disabled = !discountMode;
    if (braceletBadge instanceof HTMLInputElement) braceletBadge.disabled = !pairMode;
    const discountOn =
      discountMode && pairDiscountType instanceof HTMLSelectElement && Boolean(pairDiscountType.value);
    if (pairDiscountValue instanceof HTMLInputElement) {
      pairDiscountValue.disabled = !discountOn;
      pairDiscountValue.placeholder =
        pairDiscountType instanceof HTMLSelectElement && pairDiscountType.value === 'amount'
          ? 'Vd. 20000'
          : 'Vd. 10';
    }
    if (pairDiscountHint) {
      if (pairMode) {
        pairDiscountHint.textContent =
          pairDiscountType instanceof HTMLSelectElement && pairDiscountType.value === 'amount'
            ? `Số tiền trừ trên giá bán kèm khi mua cùng vòng chính (tối đa ${DISCOUNT_AMOUNT_MAX.toLocaleString('vi-VN')}đ).`
            : pairDiscountType instanceof HTMLSelectElement && pairDiscountType.value === 'percent'
              ? `Phần trăm giảm trên giá bán kèm (1–${DISCOUNT_PERCENT_MAX}%).`
              : 'Tuỳ chọn. Giảm thật trên bán kèm khi khách mua cùng vòng chính.';
      } else {
        pairDiscountHint.textContent =
          pairDiscountType instanceof HTMLSelectElement && pairDiscountType.value === 'amount'
            ? `Số tiền trừ trên mỗi chiếc khi mua đủ số lượng combo (tối đa ${DISCOUNT_AMOUNT_MAX.toLocaleString('vi-VN')}đ).`
            : pairDiscountType instanceof HTMLSelectElement && pairDiscountType.value === 'percent'
              ? `Phần trăm giảm trên giá bán mỗi chiếc (1–${DISCOUNT_PERCENT_MAX}%).`
              : 'Tuỳ chọn. Để trống nếu chỉ dùng giá so sánh trên sản phẩm.';
      }
    }
    if (kindOptions instanceof HTMLElement) {
      kindOptions.querySelectorAll('.home-collection-kind-option').forEach((node) => {
        if (!(node instanceof HTMLElement)) return;
        const input = node.querySelector('input[data-collection-kind]');
        node.classList.toggle('is-on', input instanceof HTMLInputElement && input.checked);
      });
    }
    if (hint) {
      hint.textContent = pairMode
        ? `Mỗi combo: 1 vòng chính + tối đa ${ADDON_MAX} bán kèm; có thể giảm % hoặc số tiền trên bán kèm.`
        : comboMode
          ? 'Khối combo: số lượng 2–10; có thể giảm % hoặc số tiền / chiếc khi mua đủ số lượng (áp giá thật khi đặt hàng).'
          : 'Dùng cho khối danh sách thường (Mẫu hot…). Không có số lượng combo.';
    }
    if (selectedPanel instanceof HTMLElement) selectedPanel.dataset.selectedKind = value;
    if (multiHead instanceof HTMLElement) multiHead.hidden = pairMode;
    if (pairHead instanceof HTMLElement) pairHead.hidden = !pairMode;
    if (selectedList instanceof HTMLElement) selectedList.hidden = pairMode;
    if (pairSlots instanceof HTMLElement) pairSlots.hidden = !pairMode;
    if (pairMode) {
      const filled = multiSlots.filter((id) => id > 0);
      if (!groups.some((group) => group.primary || group.addons.some((addon) => addon > 0)) && filled.length) {
        groups = Array.from({ length: PAIR_MAX }, (_, i) => {
          const addonId = filled[i * 2 + 1] ?? 0;
          return {
            primary: filled[i * 2] ?? 0,
            addons: addonId > 0 ? [addonId] : [0],
          };
        });
      }
    } else {
      const fromGroups = completeGroups().flatMap((group) => [group.primary, ...group.addons]);
      if (fromGroups.length && !multiSlots.some((id) => id > 0)) {
        multiSlots = Array.from({ length: MULTI_MAX }, (_, i) => fromGroups[i] ?? 0);
      }
    }
    // Lần đầu giữ HTML SSR — tránh nháy do replaceChildren + CSS scope.
    if (!kindReady) {
      kindReady = true;
      const ids = denseIds();
      if (countEl) countEl.textContent = String(ids.length);
      if (pairCountEl) pairCountEl.textContent = String(completePairCount());
      if (selectedEmpty instanceof HTMLElement) selectedEmpty.hidden = ids.length > 0;
      return;
    }
    writeSelection();
  };

  const syncPager = () => {
    if (pager instanceof HTMLElement) pager.hidden = pageCount <= 1;
    if (statusEl) statusEl.textContent = `Trang ${page}/${pageCount} · ${total} SP`;
    if (prevBtn instanceof HTMLButtonElement) prevBtn.disabled = loading || page <= 1;
    if (nextBtn instanceof HTMLButtonElement) nextBtn.disabled = loading || page >= pageCount;
    if (categorySelect instanceof HTMLSelectElement) categorySelect.disabled = loading;
  };

  const makeCard = (item: PickItem) => {
    const button = document.createElement('button');
    button.type = 'button';
    button.className = 'home-collection-pick';
    button.dataset.pickId = String(item.id);
    button.dataset.pickName = item.name;
    button.dataset.pickCover = item.coverUrl || '';
    const alreadyInScope = pickerHighlightIds().has(item.id);
    if (alreadyInScope) button.classList.add('is-on');
    const media = document.createElement('span');
    media.className = 'home-collection-pick-media';
    if (item.coverUrl) {
      const img = document.createElement('img');
      img.src = item.coverUrl;
      img.alt = '';
      img.width = 96;
      img.height = 96;
      img.loading = 'lazy';
      img.decoding = 'async';
      media.append(img);
    } else {
      const empty = document.createElement('span');
      empty.className = 'home-collection-pick-empty';
      empty.setAttribute('aria-hidden', 'true');
      media.append(empty);
    }
    if (alreadyInScope) {
      const badge = document.createElement('span');
      badge.className = 'home-collection-pick-badge';
      badge.textContent = 'đã thêm';
      media.append(badge);
    }
    const text = document.createElement('span');
    text.className = 'home-collection-pick-text';
    const strong = document.createElement('strong');
    strong.textContent = item.name;
    const muted = document.createElement('span');
    muted.className = 'text-muted';
    muted.textContent = `#${item.id}`;
    text.append(strong, muted);
    button.append(media, text);
    return button;
  };

  const loadPage = async (nextPage: number) => {
    if (!(dialog instanceof HTMLElement) || !(grid instanceof HTMLElement) || loading) return;
    const url = dialog.dataset.picksUrl;
    if (!url) return;
    loading = true;
    syncPager();
    const params = new URLSearchParams();
    params.set('page', String(nextPage));
    if (categorySelect instanceof HTMLSelectElement && categorySelect.value) params.set('category', categorySelect.value);
    try {
      const response = await fetch(`${url}?${params}`, { headers: { accept: 'application/json' } });
      const data = (await response.json()) as {
        ok?: boolean;
        error?: string;
        items?: PickItem[];
        page?: number;
        pageCount?: number;
        total?: number;
      };
      if (!response.ok || !data.ok || !Array.isArray(data.items)) throw new Error(data.error || 'load failed');
      page = Number(data.page) || 1;
      pageCount = Number(data.pageCount) || 1;
      total = Number(data.total) || 0;
      grid.replaceChildren(...data.items.map((item) => makeCard(item)));
      if (emptyEl instanceof HTMLElement) emptyEl.hidden = data.items.length > 0;
    } catch (error) {
      console.error(
        JSON.stringify({ event: 'home_collection_picks_ui_failed', name: error instanceof Error ? error.name : 'unknown' }),
      );
    } finally {
      loading = false;
      syncPager();
    }
  };

  const openPicker = (target: PickerTarget) => {
    pickerTarget = target;
    if (pickTitle) {
      if (target.mode === 'pair') {
        pickTitle.textContent =
          target.role === 'primary'
            ? `Chọn vòng chính · combo ${target.pairIndex + 1}`
            : `Chọn bán kèm · combo ${target.pairIndex + 1} · lựa chọn ${(target.addonIndex ?? 0) + 1}`;
      } else {
        pickTitle.textContent = `Chọn sản phẩm #${target.index + 1}`;
      }
    }
    if (categorySelect instanceof HTMLSelectElement) categorySelect.value = '';
    if (dialog instanceof HTMLDialogElement) {
      if (!dialog.open) dialog.showModal();
      void loadPage(1);
    }
  };

  const closePicker = () => {
    pickerTarget = null;
    if (dialog instanceof HTMLDialogElement && dialog.open) dialog.close();
  };

  const applyPick = (id: number, name: string, cover: string) => {
    if (!pickerTarget) return;
    rememberMeta(id, name, cover);
    if (pickerTarget.mode === 'pair') {
      setPairRole(pickerTarget.pairIndex, pickerTarget.role, id, pickerTarget.addonIndex ?? 0);
    } else assignMultiSlot(pickerTarget.index, id);
    writeSelection();
    closePicker();
  };

  selectedList?.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    const clear = target.closest('[data-multi-clear]');
    if (clear instanceof HTMLElement) {
      event.preventDefault();
      const index = Number(clear.dataset.multiClear);
      if (Number.isInteger(index) && index >= 0 && index < MULTI_MAX) {
        clearMultiSlot(index);
        writeSelection();
      }
      return;
    }
    const open = target.closest('[data-open-picker="multi"]');
    if (!(open instanceof HTMLElement)) return;
    const index = Number(open.dataset.slotIndex);
    if (!Number.isInteger(index) || index < 0 || index >= MULTI_MAX) return;
    openPicker({ mode: 'multi', index });
  });

  pairSlots?.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    const rowOf = (node: Element) => {
      const row = node.closest('[data-pair-row]');
      if (!(row instanceof HTMLElement)) return NaN;
      return Number(row.dataset.pairRow);
    };
    const addAddon = target.closest('[data-addon-add]');
    if (addAddon instanceof HTMLElement) {
      event.preventDefault();
      const pairIndex = Number(addAddon.dataset.addonAdd);
      if (Number.isInteger(pairIndex)) {
        addAddonSlot(pairIndex);
        writeSelection();
      }
      return;
    }
    const clearRow = target.closest('[data-pair-clear-row]');
    if (clearRow instanceof HTMLElement) {
      event.preventDefault();
      clearPairRow(Number(clearRow.dataset.pairClearRow));
      writeSelection();
      return;
    }
    const clear = target.closest('[data-pair-clear]');
    if (clear instanceof HTMLElement) {
      event.preventDefault();
      const pairIndex = Number.isInteger(Number(clear.dataset.pairIndex))
        ? Number(clear.dataset.pairIndex)
        : rowOf(clear);
      const role = clear.dataset.pairClear === 'addon' ? 'addon' : 'primary';
      const addonIndex = Number(clear.dataset.addonIndex);
      if (Number.isInteger(pairIndex) && pairIndex >= 0 && pairIndex < PAIR_MAX) {
        clearPairRole(pairIndex, role, Number.isInteger(addonIndex) ? addonIndex : 0);
        writeSelection();
      }
      return;
    }
    const open = target.closest('[data-open-picker="pair"]');
    if (!(open instanceof HTMLElement)) return;
    const pairIndex = Number.isInteger(Number(open.dataset.pairIndex))
      ? Number(open.dataset.pairIndex)
      : rowOf(open);
    if (!Number.isInteger(pairIndex) || pairIndex < 0 || pairIndex >= PAIR_MAX) return;
    const addonIndex = Number(open.dataset.addonIndex);
    openPicker({
      mode: 'pair',
      pairIndex,
      role: open.dataset.pairRole === 'addon' ? 'addon' : 'primary',
      addonIndex: Number.isInteger(addonIndex) ? addonIndex : 0,
    });
  });

  grid?.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    const card = target.closest('[data-pick-id]');
    if (!(card instanceof HTMLElement)) return;
    const id = Number(card.dataset.pickId);
      if (!Number.isInteger(id) || id < 1) return;
    applyPick(id, card.dataset.pickName || '', card.dataset.pickCover || '');
  });

  closeBtn?.addEventListener('click', () => closePicker());
  dialog?.addEventListener('click', (event) => {
    if (event.target === dialog) closePicker();
  });
  categorySelect?.addEventListener('change', () => {
    void loadPage(1);
  });
  prevBtn?.addEventListener('click', () => {
    if (page > 1) void loadPage(page - 1);
  });
  nextBtn?.addEventListener('click', () => {
    if (page < pageCount) void loadPage(page + 1);
  });

  kindInputs.forEach((input) => {
    input.addEventListener('change', syncKind);
  });
  if (pairDiscountType instanceof HTMLSelectElement) {
    pairDiscountType.addEventListener('change', syncKind);
  }
  // Đồng bộ JSON combo ngay trước khi FormData dựng — tránh mất combo 2+ khi submit.
  if (editorForm instanceof HTMLFormElement) {
    editorForm.addEventListener('submit', () => {
      if (isPairKind()) writeGroupsField(completeGroups());
    });
    editorForm.addEventListener('formdata', (event) => {
      if (!isPairKind()) return;
      event.formData.set('braceletGroups', JSON.stringify(completeGroups()));
    });
  }
  syncKind();
</script>
