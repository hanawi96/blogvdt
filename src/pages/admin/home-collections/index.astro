---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import AdminPlusIcon from '../../../components/admin/AdminPlusIcon.astro';
import { activityActor } from '../../../features/activity/log';
import { mutationError } from '../../../features/auth/session';
import {
  COMBO_DISCOUNT_AMOUNT_MAX,
  COMBO_DISCOUNT_PERCENT_MAX,
  HOME_COLLECTION_BRACELET_ADDON_MAX,
  HOME_COLLECTION_KINDS,
  HOME_COLLECTION_MAX,
  HOME_COLLECTION_PAIR_MAX,
  HOME_COLLECTION_PRODUCT_MAX,
  collectionFormValue,
  deleteHomeCollection,
  getHomeCollection,
  listHomeCollectionPicksByIds,
  listHomeCollections,
  parseBraceletGroups,
  saveHomeCollection,
  setHomeCollectionActive,
  type BraceletAddonGroup,
  type HomeCollection,
  type HomeCollectionInput,
  type HomeCollectionPick,
} from '../../../features/home-collections/collections';
import { listProductCategories } from '../../../features/products/categories';
import { createDb } from '../../../lib/db/client';
import { getDbBinding } from '../../../lib/cloudflare/env';
import { routes } from '../../../lib/routes';

const session = Astro.locals.adminSession;
if (!session) return Astro.redirect(routes.adminLogin);
if (session.role !== 'admin') {
  return new Response('Bạn không có quyền vào trang này.', { status: 403, headers: { 'content-type': 'text/plain; charset=utf-8' } });
}
Astro.response.headers.set('Cache-Control', 'private, no-store');

const db = createDb(getDbBinding());
const listHref = routes.adminHomeCollections;
let formError = '';
const values: HomeCollectionInput = {
  title: '',
  slug: '',
  subtitle: '',
  kind: 'products',
  productIds: [],
  braceletGroups: [],
  badge: '',
  buyQty: '2',
  discountType: '',
  discountValue: '',
  active: false,
  sortOrder: '0',
};

function readProductIds(form: FormData): number[] {
  const ordered = form.get('productIds');
  const source =
    typeof ordered === 'string' && ordered.trim()
      ? ordered.split(',')
      : form.getAll('productId').map((item) => (typeof item === 'string' ? item : ''));
  const ids: number[] = [];
  for (const item of source) {
    const id = Number(item.trim());
    if (!Number.isInteger(id) || id < 1 || ids.includes(id)) continue;
    ids.push(id);
    if (ids.length >= HOME_COLLECTION_PRODUCT_MAX) break;
  }
  return ids;
}

function readBraceletGroups(form: FormData): BraceletAddonGroup[] {
  const raw = form.get('braceletGroups');
  if (typeof raw !== 'string' || !raw.trim()) return [];
  return parseBraceletGroups(raw);
}

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const read = (name: string) => {
    const value = form.get(name);
    return typeof value === 'string' ? value : '';
  };
  const blocked = mutationError(Astro.request, session, form);
  const idValue = Number(read('id'));
  const id = Number.isSafeInteger(idValue) && idValue > 0 ? idValue : undefined;
  const intent = read('intent');
  if (blocked) {
    Astro.response.status = 403;
    formError = blocked;
  } else if (intent === 'delete' && id) {
    const removed = await deleteHomeCollection(db, id, await activityActor(db, session.userId));
    const key = removed.ok ? 'notice=deleted' : `error=${encodeURIComponent(removed.error)}`;
    return Astro.redirect(`${listHref}?${key}`, 303);
  } else if (intent === 'toggle' && id) {
    const turnedOn = read('active') === '1';
    const toggled = await setHomeCollectionActive(db, id, turnedOn, Date.now(), await activityActor(db, session.userId));
    const key = toggled.ok ? 'notice=saved' : `error=${encodeURIComponent(toggled.error)}`;
    return Astro.redirect(`${listHref}?${key}`, 303);
  } else if (intent === 'save') {
    values.id = id;
    values.title = read('title');
    values.slug = '';
    values.subtitle = read('subtitle');
    values.kind = HOME_COLLECTION_KINDS.includes(read('kind') as (typeof HOME_COLLECTION_KINDS)[number])
      ? read('kind')
      : 'products';
    values.productIds = readProductIds(form);
    values.braceletGroups = [];
    // Badge / buyQty: tên field riêng theo loại — tránh 2 input cùng name="badge" ghi đè nhau.
    if (values.kind === 'pair_discount') {
      values.badge = read('pairBadge');
    values.buyQty = read('buyQty') || '2';
      values.discountType = read('discountType');
      values.discountValue = read('discountValue');
    } else if (values.kind === 'bracelet_addon') {
      values.badge = read('braceletBadge');
      values.buyQty = '2';
      values.discountType = read('discountType');
      values.discountValue = read('discountValue');
      values.braceletGroups = readBraceletGroups(form);
      values.productIds = [];
    } else {
      values.badge = '';
      values.buyQty = '2';
      values.discountType = '';
      values.discountValue = '';
    }
    values.active = read('active') === '1';
    values.sortOrder = read('sortOrder') || '0';
    const saved = await saveHomeCollection(db, values, Date.now(), await activityActor(db, session.userId));
    if (saved.ok) return Astro.redirect(`${listHref}?notice=saved`, 303);
    Astro.response.status = 422;
    formError = saved.error;
  } else {
    Astro.response.status = 422;
    formError = 'Thao tác không hợp lệ.';
  }
}

const editId = Number(Astro.url.searchParams.get('edit') ?? '');
const wantNew = Astro.url.searchParams.get('new') === '1';
if (Astro.request.method === 'GET' && Number.isInteger(editId) && editId > 0) {
  const row = await getHomeCollection(db, editId);
  if (row) Object.assign(values, collectionFormValue(row));
}

let rows: HomeCollection[] = [];
let selectedOrdered: HomeCollectionPick[] = [];
let categoryOptions: { id: number; name: string }[] = [];
let loadError = '';

const notice = Astro.url.searchParams.get('notice') ?? '';
const errorText = Astro.url.searchParams.get('error') ?? '';
const noticeText = notice === 'saved' ? 'Đã lưu khối trang chủ.' : notice === 'deleted' ? 'Đã xóa khối.' : '';

try {
  rows = await listHomeCollections(db);
} catch (error) {
  console.error(JSON.stringify({ event: 'home_collection_list_failed', name: error instanceof Error ? error.name : 'unknown' }));
  loadError = 'Không tải được khối trang chủ.';
}

const canCreate = rows.length < HOME_COLLECTION_MAX;
const editing = Boolean(values.id);
const creating = !editing && (wantNew || Boolean(formError && !values.id));
const focusForm = editing || creating || Boolean(formError);
if (focusForm && creating && !canCreate && !formError) {
  return Astro.redirect(listHref, 303);
}

if (focusForm && !loadError) {
  try {
    const pickIds =
      values.kind === 'bracelet_addon'
        ? (values.braceletGroups ?? []).flatMap((group) => [group.primary, ...group.addons])
        : values.productIds;
    const [selectedPicks, categories] = await Promise.all([
      listHomeCollectionPicksByIds(db, pickIds),
      listProductCategories(db),
    ]);
    selectedOrdered = selectedPicks;
    categoryOptions = categories
      .filter((row) => row.status === 'active')
      .map((row) => ({ id: row.id, name: row.name }));
  } catch (error) {
    console.error(JSON.stringify({ event: 'home_collection_picks_failed', name: error instanceof Error ? error.name : 'unknown' }));
    loadError = 'Không tải được sản phẩm đã chọn.';
  }
}

function kindLabel(kind: string): string {
  if (kind === 'pair_discount') return 'Combo mua 2';
  if (kind === 'bracelet_addon') return 'Vòng + bán kèm';
  return 'Danh sách SP';
}

function countMeta(row: HomeCollection): { label: string; value: string } {
  if (row.kind === 'bracelet_addon') {
    return {
      label: 'Combo',
      value: `${row.braceletGroups.length}/${HOME_COLLECTION_PAIR_MAX}`,
    };
  }
  return {
    label: 'Sản phẩm',
    value: `${row.productIds.length}/${HOME_COLLECTION_PRODUCT_MAX}`,
  };
}
---

<AdminLayout title="Trang chủ SP">
  {
    !focusForm && (
      <p slot="lead" class="text-sm text-muted">
        Tối đa {HOME_COLLECTION_MAX} khối · mỗi khối ≤ {HOME_COLLECTION_PRODUCT_MAX} SP. Chỉ hiện ngoài trang chủ khi bật và còn SP đang bán.
      </p>
    )
  }

  {noticeText && !formError && <p class="mb-4 text-primary-strong" role="status" data-admin-flash>{noticeText}</p>}
  {errorText && !formError && <p class="error-text mb-4" role="alert" data-admin-flash>{errorText}</p>}
  {formError && <p class="error-text mb-4" role="alert">{formError}</p>}
  {loadError && <p class="error-text mb-4" role="alert">{loadError}</p>}

  {
    focusForm ? (
      <section class="home-collection-editor">
        <form class="home-collection-form" method="post" data-busy>
          <input type="hidden" name="csrf" value={session.csrfToken} />
          <input type="hidden" name="intent" value="save" />
          {values.id && <input type="hidden" name="id" value={values.id} />}
          <input type="hidden" name="productIds" value={values.productIds.join(',')} data-product-ids />
          {/* textarea tránh cắt JSON vì dấu " trong attribute value của input hidden */}
          <textarea name="braceletGroups" data-bracelet-groups hidden>{JSON.stringify(values.braceletGroups ?? [])}</textarea>

          <header class="home-collection-editor-bar">
            <div class="home-collection-editor-bar-text">
              <a class="home-collection-back" href={listHref}>← Các khối</a>
              <h2 class="home-collection-editor-title">{editing ? 'Sửa khối' : 'Thêm khối'}</h2>
            </div>
            <div class="home-collection-editor-bar-actions">
              <a class="btn" href={listHref}>Hủy</a>
              <button class="btn btn-primary" type="submit">
                {!editing && <AdminPlusIcon />}
                {editing ? 'Cập nhật' : 'Thêm khối'}
              </button>
            </div>
          </header>

          <div class="home-collection-settings">
            <label class="home-collection-field home-collection-field-title">
              <span>Tiêu đề</span>
              <input class="field" name="title" required maxlength="80" value={values.title} placeholder="Mẫu hot 2026" />
            </label>
            <label class="home-collection-field home-collection-field-narrow">
              <span>Thứ tự</span>
              <input class="field" name="sortOrder" inputmode="numeric" maxlength="2" value={values.sortOrder} />
            </label>
            <fieldset class="home-collection-field home-collection-field-kind-picker">
              <legend>Loại khối</legend>
              <div class="home-collection-kind-options" data-kind-options>
                <label class:list={['home-collection-kind-option', values.kind === 'products' && 'is-on']}>
                  <input type="radio" name="kind" value="products" data-collection-kind checked={values.kind === 'products'} />
                  <span class="home-collection-kind-option-title">Danh sách SP</span>
                  <span class="home-collection-kind-option-desc">Hiển thị mẫu như lưới sản phẩm thường (vd. Mẫu hot).</span>
            </label>
                <label class:list={['home-collection-kind-option', values.kind === 'pair_discount' && 'is-on']}>
                  <input type="radio" name="kind" value="pair_discount" data-collection-kind checked={values.kind === 'pair_discount'} />
                  <span class="home-collection-kind-option-title">Combo mua 2</span>
                  <span class="home-collection-kind-option-desc">Gợi ý mua nhiều chiếc cùng mẫu — có số lượng combo & badge.</span>
                </label>
                <label class:list={['home-collection-kind-option', values.kind === 'bracelet_addon' && 'is-on']}>
                  <input type="radio" name="kind" value="bracelet_addon" data-collection-kind checked={values.kind === 'bracelet_addon'} />
                  <span class="home-collection-kind-option-title">Vòng + bán kèm</span>
                  <span class="home-collection-kind-option-desc">Từng cặp chính + phụ; mua ngay gắn sẵn sản phẩm kèm.</span>
                </label>
            </div>
            </fieldset>
            <label class="home-collection-field home-collection-field-subtitle" data-subtitle-field>
              <span>Mô tả ngắn</span>
              <input class="field" name="subtitle" maxlength="160" value={values.subtitle} placeholder="Những mẫu mẹ đang chọn nhiều." />
            </label>
            <label class="home-collection-field home-collection-field-qty" data-pair-fields hidden={values.kind !== 'pair_discount'}>
                <span>Số lượng combo</span>
              <input
                class="field"
                name="buyQty"
                inputmode="numeric"
                maxlength="2"
                value={values.kind === 'pair_discount' ? values.buyQty : '2'}
                disabled={values.kind !== 'pair_discount'}
                data-pair-buy-qty
              />
              </label>
            <label class="home-collection-field home-collection-field-badge" data-pair-badge-wrap hidden={values.kind !== 'pair_discount'}>
              <span>Badge combo</span>
              <input
                class="field"
                name="pairBadge"
                maxlength="40"
                value={values.kind === 'pair_discount' ? values.badge : ''}
                placeholder="Mua 2 giảm"
                disabled={values.kind !== 'pair_discount'}
                data-pair-badge
              />
              </label>
            <div
              class="home-collection-field home-collection-field-discount"
              data-pair-discount-wrap
              hidden={values.kind !== 'pair_discount' && values.kind !== 'bracelet_addon'}
            >
              <span>Giảm giá</span>
              <div class="home-collection-discount-row">
                <select
                  class="field"
                  name="discountType"
                  disabled={values.kind !== 'pair_discount' && values.kind !== 'bracelet_addon'}
                  data-pair-discount-type
                >
                  <option value="" selected={values.discountType !== 'percent' && values.discountType !== 'amount'}>
                    Không giảm thêm
                  </option>
                  <option value="percent" selected={values.discountType === 'percent'}>Giảm theo %</option>
                  <option value="amount" selected={values.discountType === 'amount'}>Giảm số tiền cố định</option>
                </select>
                <input
                  class="field"
                  name="discountValue"
                  inputmode="numeric"
                  maxlength="8"
                  value={
                    values.kind === 'pair_discount' || values.kind === 'bracelet_addon' ? values.discountValue : ''
                  }
                  placeholder={values.discountType === 'amount' ? 'Vd. 20000' : 'Vd. 10'}
                  disabled={
                    (values.kind !== 'pair_discount' && values.kind !== 'bracelet_addon') || !values.discountType
                  }
                  data-pair-discount-value
                />
            </div>
            </div>
            <label
              class="home-collection-field home-collection-field-badge-wide"
              data-bracelet-fields
              hidden={values.kind !== 'bracelet_addon'}
            >
              <span>Badge (tuỳ chọn)</span>
              <input
                class="field"
                name="braceletBadge"
                maxlength="40"
                value={values.kind === 'bracelet_addon' ? values.badge : ''}
                placeholder="Thường miễn ship khi mua kèm"
                disabled={values.kind !== 'bracelet_addon'}
                data-bracelet-badge
              />
            </label>
            <div class="home-collection-field home-collection-field-active">
              <span>Hiển thị</span>
              <label class="admin-check home-collection-active-control">
                <input type="checkbox" name="active" value="1" checked={values.active} />
                <span>Hiện trên trang chủ</span>
              </label>
            </div>
            <p
              class="home-collection-discount-hint seo-hint"
              data-pair-discount-hint
              hidden={values.kind !== 'pair_discount' && values.kind !== 'bracelet_addon'}
            >
              {values.kind === 'bracelet_addon'
                ? values.discountType === 'amount'
                  ? `Số tiền trừ trên giá bán kèm khi mua cùng vòng chính (tối đa ${COMBO_DISCOUNT_AMOUNT_MAX.toLocaleString('vi-VN')}đ).`
                  : values.discountType === 'percent'
                    ? `Phần trăm giảm trên giá bán kèm (1–${COMBO_DISCOUNT_PERCENT_MAX}%).`
                    : 'Tuỳ chọn. Giảm thật trên bán kèm khi khách mua cùng vòng chính.'
                : values.discountType === 'amount'
                  ? `Số tiền trừ trên mỗi chiếc khi mua đủ số lượng combo (tối đa ${COMBO_DISCOUNT_AMOUNT_MAX.toLocaleString('vi-VN')}đ).`
                  : values.discountType === 'percent'
                    ? `Phần trăm giảm trên giá bán mỗi chiếc (1–${COMBO_DISCOUNT_PERCENT_MAX}%).`
                    : 'Tuỳ chọn. Để trống nếu chỉ dùng giá so sánh trên sản phẩm.'}
            </p>
            <p class="home-collection-kind-hint" data-kind-hint>
              {values.kind === 'bracelet_addon'
                ? `Mỗi combo: 1 vòng chính + tối đa ${HOME_COLLECTION_BRACELET_ADDON_MAX} bán kèm; có thể giảm % hoặc số tiền trên bán kèm.`
                : values.kind === 'pair_discount'
                  ? 'Khối combo: số lượng 2–10; có thể giảm % hoặc số tiền / chiếc khi mua đủ số lượng (áp giá thật khi đặt hàng).'
                  : 'Dùng cho khối danh sách thường (Mẫu hot…). Không có số lượng combo.'}
            </p>
          </div>

          <section
            class="home-collection-selected"
            aria-label="Đã chọn"
            data-selected-panel
            data-selected-kind={values.kind}
            data-pair-max={String(HOME_COLLECTION_PAIR_MAX)}
            data-addon-max={String(HOME_COLLECTION_BRACELET_ADDON_MAX)}
            data-discount-percent-max={String(COMBO_DISCOUNT_PERCENT_MAX)}
            data-discount-amount-max={String(COMBO_DISCOUNT_AMOUNT_MAX)}
          >
            <div class="home-collection-selected-head" data-multi-selected-head hidden={values.kind === 'bracelet_addon'}>
              <h3>
                Đã chọn <span>(<span data-pick-count>{values.productIds.length}</span>/{HOME_COLLECTION_PRODUCT_MAX})</span>
              </h3>
              <p class="seo-hint" data-selected-empty hidden={values.productIds.length > 0}>Bấm ô trống để thêm sản phẩm.</p>
            </div>
            <div class="home-collection-selected-head" data-pair-selected-head hidden={values.kind !== 'bracelet_addon'}>
              <h3>
                Combo vòng + bán kèm
                <span>(<span data-pair-count>{(values.braceletGroups ?? []).length}</span>/{HOME_COLLECTION_PAIR_MAX})</span>
              </h3>
              <p class="seo-hint">
                Mỗi hàng = 1 combo (điền Combo 2, Combo 3 phía dưới). Bán kèm như 7/9 cành dùng chung được nhiều combo.
              </p>
            </div>

            <ol class="home-collection-selected-slots" data-selected-list hidden={values.kind === 'bracelet_addon'}>
              {Array.from({ length: HOME_COLLECTION_PRODUCT_MAX }, (_, index) => {
                const product = selectedOrdered[index];
                return (
                  <li class:list={['home-collection-slot', product ? 'is-filled' : 'is-empty']}>
                    <button
                      class="home-collection-slot-btn"
                      type="button"
                      data-open-picker="multi"
                      data-slot-index={String(index)}
                      data-selected-id={product ? String(product.id) : undefined}
                      aria-label={product ? `Đổi sản phẩm ô ${index + 1}` : `Chọn sản phẩm ô ${index + 1}`}
                    >
                    <span class="home-collection-slot-order">{index + 1}</span>
                      {product ? (
                        <>
                    {product.coverUrl ? (
                      <img src={product.coverUrl} alt="" width="72" height="72" loading="lazy" decoding="async" />
                    ) : (
                      <span class="home-collection-pick-empty" aria-hidden="true" />
                    )}
                    <span class="home-collection-slot-name">{product.name}</span>
                        </>
                      ) : (
                        <span class="home-collection-slot-placeholder">
                          <span class="home-collection-slot-plus" aria-hidden="true">+</span>
                          Thêm
                        </span>
                      )}
                    </button>
                    {product && (
                      <button class="home-collection-slot-clear" type="button" data-multi-clear={String(index)} aria-label={`Xóa ô ${index + 1}`}>
                        ×
                      </button>
                    )}
                  </li>
                );
              })}
            </ol>

            <div class="home-collection-pair-slots" data-pair-slots hidden={values.kind !== 'bracelet_addon'}>
              {
                Array.from({ length: HOME_COLLECTION_PAIR_MAX }, (_, pairIndex) => {
                  const group = (values.braceletGroups ?? [])[pairIndex];
                  const primary = group ? selectedOrdered.find((item) => item.id === group.primary) : undefined;
                  const addonIds = group?.addons?.length ? group.addons : [0];
                  const hasAny = Boolean(primary) || addonIds.some((id) => id > 0);
                return (
                    <div class="home-collection-pair-row" data-pair-row={String(pairIndex)}>
                      <div class="home-collection-pair-row-head">
                        <p class="home-collection-pair-row-title">Combo {pairIndex + 1}</p>
                        <div class="home-collection-pair-row-actions">
                          <button
                            class="home-collection-pair-clear"
                            type="button"
                            data-pair-clear-row={String(pairIndex)}
                            hidden={!hasAny}
                          >
                            Xóa combo
                          </button>
                        </div>
                      </div>
                      <div
                        class:list={['home-collection-pair-slot', primary && 'is-filled']}
                        data-pair-slot="primary"
                        data-pair-index={String(pairIndex)}
                        data-selected-id={primary ? String(primary.id) : undefined}
                      >
                        <div class="home-collection-pair-slot-top">
                          <p class="home-collection-pair-slot-label">Sản phẩm chính</p>
                          <button
                            class="home-collection-pair-clear"
                            type="button"
                            data-pair-clear="primary"
                            data-pair-index={String(pairIndex)}
                            hidden={!primary}
                          >
                            Xóa
                          </button>
                        </div>
                        <button
                          class="home-collection-pair-pick"
                          type="button"
                          data-open-picker="pair"
                          data-pair-role="primary"
                          data-pair-index={String(pairIndex)}
                        >
                          {primary ? (
                            <>
                              {primary.coverUrl ? (
                                <img src={primary.coverUrl} alt="" width="96" height="96" loading="lazy" decoding="async" />
                      ) : (
                        <span class="home-collection-pick-empty" aria-hidden="true" />
                      )}
                              <span class="home-collection-pair-pick-name">{primary.name}</span>
                              <span class="text-muted">#{primary.id}</span>
                            </>
                          ) : (
                            <span class="home-collection-pair-pick-empty">Bấm để chọn vòng chính</span>
                          )}
                        </button>
                      </div>
                      <div class="home-collection-addon-block" data-addon-block={String(pairIndex)}>
                        <div class="home-collection-addon-block-head">
                          <p class="home-collection-pair-slot-label">Bán kèm — khách chọn một hoặc nhiều</p>
                          <button
                            class="btn"
                            type="button"
                            data-addon-add={String(pairIndex)}
                            hidden={addonIds.filter((id) => id > 0).length >= HOME_COLLECTION_BRACELET_ADDON_MAX}
                          >
                            + Thêm lựa chọn
                          </button>
                        </div>
                        <div class="home-collection-addon-list" data-addon-list={String(pairIndex)}>
                          {addonIds.map((addonId, addonIndex) => {
                            const addon = addonId > 0 ? selectedOrdered.find((item) => item.id === addonId) : undefined;
                            return (
                              <div
                                class:list={['home-collection-pair-slot', 'is-addon', addon && 'is-filled']}
                                data-pair-slot="addon"
                                data-pair-index={String(pairIndex)}
                                data-addon-index={String(addonIndex)}
                                data-selected-id={addon ? String(addon.id) : undefined}
                              >
                                <div class="home-collection-pair-slot-top">
                                  <p class="home-collection-pair-slot-label">Lựa chọn {addonIndex + 1}</p>
                                  <button
                                    class="home-collection-pair-clear"
                                    type="button"
                                    data-pair-clear="addon"
                                    data-pair-index={String(pairIndex)}
                                    data-addon-index={String(addonIndex)}
                                    hidden={!addon && addonIds.length <= 1}
                                  >
                                    Xóa
                                  </button>
                                </div>
                                <button
                                  class="home-collection-pair-pick"
                                  type="button"
                                  data-open-picker="pair"
                                  data-pair-role="addon"
                                  data-pair-index={String(pairIndex)}
                                  data-addon-index={String(addonIndex)}
                                >
                                  {addon ? (
                                    <>
                                      {addon.coverUrl ? (
                                        <img src={addon.coverUrl} alt="" width="96" height="96" loading="lazy" decoding="async" />
                                      ) : (
                                        <span class="home-collection-pick-empty" aria-hidden="true" />
                                      )}
                                      <span class="home-collection-pair-pick-name">{addon.name}</span>
                                      <span class="text-muted">#{addon.id}</span>
                                    </>
                                  ) : (
                                    <span class="home-collection-pair-pick-empty">Bấm để chọn bán kèm</span>
                                  )}
                                </button>
                              </div>
                );
              })}
            </div>
                      </div>
                    </div>
                  );
                })
              }
            </div>
          </section>
        </form>

        <dialog
          class="home-collection-pick-dialog"
          data-pick-dialog
          data-picks-url={routes.adminHomeCollectionPicks}
          aria-labelledby="home-collection-pick-title"
        >
          <div class="home-collection-pick-dialog-card">
            <header class="home-collection-pick-dialog-head">
              <h3 id="home-collection-pick-title" data-pick-title>Chọn sản phẩm</h3>
              <button class="btn" type="button" data-pick-close>Đóng</button>
            </header>
            <div class="home-collection-pick-toolbar">
              <label class="home-collection-pick-filter">
                <span>Danh mục</span>
                <select class="field" data-pick-category>
                  <option value="">Tất cả</option>
                  {categoryOptions.map((category) => (
                    <option value={String(category.id)}>{category.name}</option>
                  ))}
                </select>
              </label>
              <p class="seo-hint home-collection-pick-hint">Sold cao → thấp · bấm ảnh để chọn</p>
            </div>
            <div class="home-collection-picks" data-pick-grid></div>
            <p class="cms-empty-text" data-pick-empty hidden>Chưa có sản phẩm đang bán.</p>
            <nav class="home-collection-pick-pager" data-pick-pager hidden aria-label="Phân trang sản phẩm">
              <button class="btn" type="button" data-pick-prev>Trước</button>
              <span class="home-collection-pick-pager-status" data-pick-status>Trang 1/1</span>
              <button class="btn" type="button" data-pick-next>Sau</button>
            </nav>
          </div>
        </dialog>
      </section>
    ) : (
      <section class="category-panel home-collection-list-panel">
        <div class="home-collection-list-head">
          <div class="home-collection-list-head-text">
            <h2 class="category-panel-title">Các khối</h2>
            <p class="home-collection-list-count">
              <span>{rows.length}</span>/{HOME_COLLECTION_MAX} khối
            </p>
          </div>
          {canCreate && (
            <a class="btn btn-primary" href={`${listHref}?new=1`}>
              <AdminPlusIcon />
              Thêm khối
            </a>
          )}
        </div>

        {
          rows.length === 0 ? (
            <div class="home-collection-empty">
              <p class="home-collection-empty-title">Chưa có khối trang chủ</p>
              <p class="text-muted">Thêm khối đầu tiên (ví dụ “Mẫu hot 2026”) để hiện trên trang chủ.</p>
              {canCreate && (
                <a class="btn btn-primary" href={`${listHref}?new=1`}>
                  <AdminPlusIcon />
                  Thêm khối
                </a>
              )}
            </div>
          ) : (
            <ul class="home-collection-list">
              {rows.map((row) => {
                const count = countMeta(row);
                return (
                  <li class:list={['home-collection-item', !row.active && 'is-off']} data-kind={row.kind}>
                    <div class="home-collection-item-body">
                  <div class="home-collection-item-main">
                    <div class="home-collection-item-top">
                          <div class="home-collection-item-heading">
                            <div class="home-collection-item-tags">
                              <span class="home-collection-kind-chip" data-kind={row.kind}>{kindLabel(row.kind)}</span>
                              <span class="home-collection-status" data-status={row.active ? 'active' : 'inactive'}>
                        {row.active ? 'Đang hiện' : 'Đang tắt'}
                      </span>
                            </div>
                            <a class="home-collection-item-title" href={`${listHref}?edit=${row.id}`}>{row.title}</a>
                          </div>
                    </div>
                    {row.subtitle && <p class="home-collection-item-sub">{row.subtitle}</p>}
                    <dl class="home-collection-item-meta">
                      <div>
                            <dt>{count.label}</dt>
                            <dd>{count.value}</dd>
                      </div>
                      <div>
                        <dt>Thứ tự</dt>
                        <dd>{row.sortOrder}</dd>
                      </div>
                    </dl>
                  </div>
                      <div class="home-collection-item-ops">
                        <a class="home-collection-op home-collection-op-edit" href={`${listHref}?edit=${row.id}`}>Sửa</a>
                    <form method="post" data-busy>
                      <input type="hidden" name="csrf" value={session.csrfToken} />
                      <input type="hidden" name="intent" value="toggle" />
                      <input type="hidden" name="id" value={row.id} />
                      <input type="hidden" name="active" value={row.active ? '0' : '1'} />
                          <button class="home-collection-op home-collection-op-toggle" type="submit">
                            {row.active ? 'Tắt' : 'Bật'}
                          </button>
                    </form>
                    <form
                      method="post"
                      data-busy
                      data-confirm-title={`Xóa khối “${row.title}”?`}
                      data-confirm="Khối sẽ biến mất khỏi trang chủ."
                      data-confirm-ok="Xóa"
                      data-confirm-tone="danger"
                    >
                      <input type="hidden" name="csrf" value={session.csrfToken} />
                      <input type="hidden" name="intent" value="delete" />
                      <input type="hidden" name="id" value={row.id} />
                          <button class="home-collection-op home-collection-op-delete" type="submit" data-keep-label="true">
                            Xóa
                          </button>
                    </form>
                      </div>
                  </div>
                </li>
                );
              })}
            </ul>
          )
        }
      </section>
    )
  }
</AdminLayout>

