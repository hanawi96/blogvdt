---
import CatalogCard from '../components/public/CatalogCard.astro';
import DataError from '../components/public/DataError.astro';
import Pagination from '../components/public/Pagination.astro';
import ProductStory from '../components/public/ProductStory.astro';
import { listSellableProductCategories } from '../features/products/categories';
import {
  CATALOG_SORTS,
  catalogFiltered,
  catalogNeedsRedirect,
  catalogPath,
  listCatalogProducts,
  readCatalogQuery,
} from '../features/products/catalog';
import { getPublicSite } from '../features/settings/settings';
import OrderDialog from '../components/public/OrderDialog.astro';
import PublicLayout from '../layouts/PublicLayout.astro';
import { createDb } from '../lib/db/client';
import { getDbBinding, getSiteOrigin } from '../lib/cloudflare/env';
import { buildMeta, canonicalUrl, documentTitle, withPageSuffix } from '../lib/seo/meta';
import { routes } from '../lib/routes';

const query = readCatalogQuery(Astro.url.searchParams);
if (catalogNeedsRedirect(Astro.url, query)) return Astro.redirect(catalogPath(query), 301);

const page = query.page;
const filtered = catalogFiltered(query);
const loaded = await loadCatalog();
const outOfRange = Boolean(loaded.site) && page > loaded.pageCount && (loaded.total > 0 || page > 1);
if (outOfRange) Astro.response.status = 404;
if (loaded.site && !outOfRange) Astro.response.headers.set('Cache-Control', 'public, max-age=60');
else Astro.response.headers.set('Cache-Control', 'no-store');

const origin = getSiteOrigin(Astro.url.origin);
const meta = buildMeta(origin, {
  title: loaded.site
    ? `${documentTitle('Mẫu vòng dâu tằm', loaded.site.siteName, page)}`
    : 'Chưa sẵn sàng',
  description: withPageSuffix('Các mẫu vòng dâu tằm thủ công đang nhận đặt. Xem ảnh, giá bán và giá gốc nếu có.', page),
  path: filtered || page === 1 ? routes.catalog : catalogPath(query),
  siteName: loaded.site?.siteName,
  robots: !loaded.site || outOfRange ? 'noindex,nofollow' : filtered ? 'noindex,follow' : 'index,follow',
});
// prev/next chỉ khi trang được index: có site, không ngoài phạm vi, không đang lọc.
const canIndex = Boolean(loaded.site) && !outOfRange && !filtered;
const prevUrl = canIndex && page > 1 ? canonicalUrl(origin, catalogPath(query, page - 1)) || null : null;
const nextUrl = canIndex && page < loaded.pageCount ? canonicalUrl(origin, catalogPath(query, page + 1)) || null : null;

async function loadCatalog() {
  try {
    const db = createDb(getDbBinding());
    const site = await getPublicSite(db);
    if (!site) return { site: null, failed: false, products: [], categories: [], total: 0, pageCount: 1 };
    const [list, categories] = await Promise.all([listCatalogProducts(db, query), listSellableProductCategories(db)]);
    return { site, failed: false, products: list.products, categories, total: list.total, pageCount: list.pageCount };
  } catch (error) {
    console.error(JSON.stringify({ event: 'catalog_public_list_failed', name: error instanceof Error ? error.name : 'unknown' }));
    return { site: null, failed: true, products: [], categories: [], total: 0, pageCount: 1 };
  }
}
---

<PublicLayout
  title={meta.title}
  description={meta.description}
  canonical={loaded.site && !outOfRange ? meta.canonical : undefined}
  prevUrl={prevUrl}
  nextUrl={nextUrl}
  robots={meta.robots}
  siteName={meta.siteName}
  faviconUrl={loaded.site?.faviconUrl || '/favicon.svg'}
  chrome={loaded.site}
>
  {
    !loaded.site ? (
      <DataError failed={loaded.failed} />
    ) : outOfRange ? (
      <main class="mx-auto max-w-5xl px-4 py-16">
        <h1 class="text-3xl font-semibold">Không có trang này</h1>
        <p class="mt-4"><a href={routes.catalog}>Về mẫu vòng dâu tằm</a></p>
      </main>
    ) : (
      <main class="mx-auto max-w-6xl px-4 py-10">
        <header class="catalog-head">
          <div class="catalog-head-top">
            <h1>Mẫu vòng dâu tằm</h1>
            <p class="catalog-count">
              {loaded.total === 0 ? (filtered ? 'Không có mẫu khớp' : 'Chưa có mẫu đang bán') : loaded.total === 1 ? '1 mẫu' : `${loaded.total} mẫu`}
            </p>
          </div>
          <p class="catalog-lead">Vòng làm thủ công, đang nhận đặt. Giá là giá từng chiếc, chưa gồm phí giao.</p>
          <div class="catalog-bar">
            <form class="catalog-search" method="get" action={routes.catalog} role="search">
              {query.category && <input type="hidden" name="danh-muc" value={query.category} />}
              {query.sort !== 'mac-dinh' && <input type="hidden" name="sap-xep" value={query.sort} />}
              <label class="sr-only" for="catalog-q">Tìm mẫu vòng</label>
              <input id="catalog-q" class="field" type="search" name="q" value={query.q} placeholder="Tìm tên mẫu vòng..." maxlength="80" />
              <button class="btn btn-primary" type="submit">Tìm</button>
              {query.q && <a class="btn" href={catalogPath({ ...query, q: '' }, 1)}>Xóa</a>}
            </form>
            <div class="catalog-tools">
              {loaded.categories.length > 0 && (
                <div class="catalog-group">
                  <span class="catalog-label" id="catalog-cats">Danh mục</span>
                  <nav class="catalog-chips" aria-labelledby="catalog-cats">
                    <a class="chip" href={catalogPath({ ...query, category: '' }, 1)} aria-current={query.category === '' ? 'true' : undefined}>Tất cả</a>
                    {loaded.categories.map((category) => (
                      <a class="chip" href={catalogPath({ ...query, category: category.slug }, 1)} aria-current={query.category === category.slug ? 'true' : undefined}>
                        {category.name}
                      </a>
                    ))}
                  </nav>
                </div>
              )}
              <div class="catalog-group">
                <span class="catalog-label" id="catalog-sort">Sắp xếp</span>
                <div class="catalog-segment" role="group" aria-labelledby="catalog-sort">
                  {CATALOG_SORTS.map((sort) => (
                    <a class="chip" href={catalogPath({ ...query, sort: sort.value }, 1)} aria-current={query.sort === sort.value ? 'true' : undefined}>
                      {sort.label}
                    </a>
                  ))}
                </div>
              </div>
            </div>
          </div>
        </header>
        {loaded.products.length > 0 && (
          <ul class="mt-4 grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3">
            {loaded.products.map((product, index) => (
              <li><CatalogCard product={product} eager={index < 4} /></li>
            ))}
          </ul>
        )}
        <Pagination page={page} pageCount={loaded.pageCount} hrefFor={(next) => catalogPath(query, next)} />
        <div class="catalog-story">
          <ProductStory />
        </div>
        {loaded.products.length > 0 && <OrderDialog />}
      </main>
    )
  }
</PublicLayout>
