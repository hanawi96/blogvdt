---
import DataError from '../../components/public/DataError.astro';
import Pagination from '../../components/public/Pagination.astro';
import ProductCard from '../../components/public/ProductCard.astro';
import { listPublicProducts } from '../../features/products/public';
import { getPublicSite } from '../../features/settings/settings';
import PublicLayout from '../../layouts/PublicLayout.astro';
import { createDb } from '../../lib/db/client';
import { getDbBinding, getSiteOrigin } from '../../lib/cloudflare/env';
import { buildMeta } from '../../lib/seo/meta';
import { routes } from '../../lib/routes';

const page = pageNumber(Astro.url.searchParams.get('page'));
const loaded = await loadProducts();
const outOfRange = loaded.site && loaded.total > 0 && page > loaded.pageCount;
if (outOfRange) Astro.response.status = 404;
if (loaded.site && !outOfRange) Astro.response.headers.set('Cache-Control', 'public, max-age=60');
else Astro.response.headers.set('Cache-Control', 'no-store');

const meta = buildMeta(getSiteOrigin(Astro.url.origin), {
  title: loaded.site ? `Sản phẩm | ${loaded.site.siteName}` : 'Chưa sẵn sàng',
  description: loaded.site?.defaultSeoDescription || 'Vòng tơ tằm thủ công đang nhận đặt.',
  path: page > 1 ? `${routes.products}?page=${page}` : routes.products,
  siteName: loaded.site?.siteName,
  robots: loaded.site && !outOfRange ? 'index,follow' : 'noindex,nofollow',
});

function pageNumber(value: string | null): number {
  const parsed = Number(value ?? '1');
  return Number.isInteger(parsed) && parsed > 0 ? parsed : 1;
}

async function loadProducts() {
  try {
    const db = createDb(getDbBinding());
    const site = await getPublicSite(db);
    if (!site) return { site: null, failed: false, products: [], total: 0, pageCount: 1 };
    const list = await listPublicProducts(db, page);
    return { site, failed: false, products: list.products, total: list.total, pageCount: list.pageCount };
  } catch (error) {
    console.error(JSON.stringify({ event: 'product_public_list_failed', name: error instanceof Error ? error.name : 'unknown' }));
    return { site: null, failed: true, products: [], total: 0, pageCount: 1 };
  }
}
---

<PublicLayout
  title={meta.title}
  description={meta.description}
  canonical={loaded.site && !outOfRange ? meta.canonical : undefined}
  robots={meta.robots}
  siteName={meta.siteName}
  faviconUrl={loaded.site?.faviconUrl || '/favicon.svg'}
  chrome={loaded.site}
>
  {
    !loaded.site ? (
      <DataError failed={loaded.failed} />
    ) : outOfRange ? (
      <main class="mx-auto max-w-5xl px-4 py-16">
        <h1 class="text-3xl font-semibold">Không có trang này</h1>
        <p class="mt-4"><a href={routes.products}>Về danh sách sản phẩm</a></p>
      </main>
    ) : (
      <main class="mx-auto max-w-5xl px-4 py-10">
        <h1 class="text-3xl font-semibold">Sản phẩm</h1>
        <p class="mt-3 max-w-2xl text-muted">Vòng tơ tằm làm thủ công. Giá là giá từng chiếc, chưa gồm phí giao.</p>
        {loaded.products.length === 0 ? (
          <p class="mt-8 text-muted">Chưa có sản phẩm đang bán.</p>
        ) : (
          <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {loaded.products.map((product) => (
              <li><ProductCard product={product} /></li>
            ))}
          </ul>
        )}
        <Pagination page={page} pageCount={loaded.pageCount} hrefFor={(next) => (next > 1 ? `${routes.products}?page=${next}` : routes.products)} />
      </main>
    )
  }
</PublicLayout>
