---
import DataError from '../../components/public/DataError.astro';
import FreeShipBadge from '../../components/public/FreeShipBadge.astro';
import NotFound from '../../components/public/NotFound.astro';
import OrderForm from '../../components/public/OrderForm.astro';
import ProductStory from '../../components/public/ProductStory.astro';
import QtyStepper from '../../components/public/QtyStepper.astro';
import { CART_MAX_QUANTITY } from '../../features/cart/cart';
import { getPublicProduct } from '../../features/products/public';
import { isPubliclySellable } from '../../features/products/status';
import { requiresWeight, weightChips, weightExtras, weightOptionLabel } from '../../features/products/weight';
import { getPublicSite } from '../../features/settings/settings';
import { productShipBadge } from '../../features/shipping/customer-fee';
import { productViewPayload } from '../../features/tracking/tracking';
import PublicLayout from '../../layouts/PublicLayout.astro';
import { redirectHttpResponse } from '../../features/redirects/http';
import { resolvePublicRedirect } from '../../features/redirects/lookup';
import { createDb } from '../../lib/db/client';
import { getDbBinding, getSiteOrigin } from '../../lib/cloudflare/env';
import { formatVnd } from '../../lib/money';
import { breadcrumbSchema, buildMeta, jsonLd, productSchema } from '../../lib/seo/meta';
import { routes } from '../../lib/routes';

const slug = Astro.params.slug ?? '';
const loaded = await loadProduct();
if (loaded.http) return loaded.http;
const visible = loaded.product && isPubliclySellable(loaded.product) ? loaded.product : null;
if (!visible) {
  Astro.response.status = loaded.site ? 404 : 503;
  Astro.response.headers.set('Cache-Control', 'no-store');
  Astro.response.headers.set('X-Robots-Tag', 'noindex');
} else {
  Astro.response.headers.set('Cache-Control', 'public, max-age=60');
}

const origin = getSiteOrigin(Astro.url.origin);
const meta = buildMeta(origin, {
  title: visible ? `${visible.seoTitle || visible.name} | ${loaded.site?.siteName ?? ''}` : 'Không tìm thấy trang',
  description: visible?.metaDescription || visible?.description || loaded.site?.defaultSeoDescription || 'Không tìm thấy sản phẩm.',
  path: routes.product(slug),
  image: visible?.images[0]?.url,
  siteName: loaded.site?.siteName,
  robots: visible ? 'index,follow' : 'noindex,nofollow',
});
const crumbs = visible && loaded.site
  ? [
      { name: 'Trang chủ', path: routes.home },
      { name: 'Mẫu vòng dâu tằm', path: routes.catalog },
      { name: visible.name, path: routes.product(visible.slug) },
    ]
  : [];
const trail = visible && loaded.site ? breadcrumbSchema(origin, crumbs) : null;
const shipBadge = visible ? productShipBadge(visible.price, visible.categorySlug) : 'none';
const jsonLdBlocks = visible && loaded.site
  ? [
      ...(trail ? [jsonLd(trail)] : []),
      jsonLd(productSchema({
        name: visible.name,
        description: visible.description,
        canonical: meta.canonical,
        image: meta.image,
        price: visible.price,
        siteName: loaded.site.siteName,
      })),
    ]
  : [];

const commitments = [
  'Làm từ cây dâu tằm ta Việt Nam',
  'Không hóa chất, không nhuộm màu',
  'Làm theo cân nặng riêng của bé',
  'Hạt dâu tằm lâu năm, già chắc & đặc lõi',
  'Nhận hàng kiểm tra hàng thoải mái',
];

const needsWeight = visible ? requiresWeight(visible.weightScale) : false;
const addChips = needsWeight && visible ? weightChips(visible.weightScale) : [];
const addExtras = needsWeight && visible ? weightExtras(visible.weightScale) : [];

async function loadProduct() {
  try {
    const db = createDb(getDbBinding());
    const site = await getPublicSite(db);
    if (!site) return { site: null, failed: false, product: null, http: null };
    const product = await getPublicProduct(db, slug);
    if (product && !isPubliclySellable(product)) {
      const outcome = await resolvePublicRedirect(db, routes.product(slug));
      if (outcome) return { site, failed: false, product: null, http: redirectHttpResponse(outcome) };
    }
    return { site, failed: false, product, http: null };
  } catch (error) {
    console.error(JSON.stringify({ event: 'product_public_failed', name: error instanceof Error ? error.name : 'unknown' }));
    return { site: null, failed: true, product: null, http: null };
  }
}
---

<PublicLayout
  title={meta.title}
  description={meta.description}
  canonical={visible ? meta.canonical : undefined}
  image={meta.image}
  imageAlt={visible?.images[0]?.alt}
  imageWidth={visible?.images[0]?.width}
  imageHeight={visible?.images[0]?.height}
  robots={meta.robots}
  siteName={meta.siteName}
  jsonLd={jsonLdBlocks}
  faviconUrl={loaded.site?.faviconUrl || '/favicon.svg'}
  chrome={loaded.site}
  trackEvent={visible ? 'view' : null}
  trackPayload={visible ? productViewPayload({ slug: visible.slug, name: visible.name, price: visible.price }) : null}
>
  {
    !loaded.site ? (
      <DataError failed={loaded.failed} />
    ) : !visible ? (
      <NotFound />
    ) : (
      <main class="mx-auto max-w-3xl px-4 py-10">
        <nav aria-label="Đường dẫn">
          <ol class="flex flex-wrap gap-2 text-sm text-muted">
            {crumbs.map((crumb, index) => (
              <li class="flex gap-2">
                {index > 0 && <span aria-hidden="true">/</span>}
                {index === crumbs.length - 1 ? <span>{crumb.name}</span> : <a href={crumb.path}>{crumb.name}</a>}
              </li>
            ))}
          </ol>
        </nav>
        <h1 class="mt-4 text-4xl font-semibold tracking-tight text-balance">{visible.name}</h1>
        <p class="mt-3 text-xl font-semibold text-primary-strong">{formatVnd(visible.price)}</p>
        {shipBadge !== 'none' && <FreeShipBadge variant={shipBadge} class="mt-2" />}
        {visible.images.length > 0 && (
          <ul class="mt-6 grid gap-3">
            {visible.images.map((image, index) => (
              <li>
                <img
                  class="h-auto w-full rounded-lg"
                  src={image.url}
                  alt={image.alt}
                  width={image.width ?? undefined}
                  height={image.height ?? undefined}
                  loading={index === 0 ? undefined : 'lazy'}
                />
              </li>
            ))}
          </ul>
        )}
        <p class="mt-6 whitespace-pre-line leading-relaxed">{visible.description}</p>
        <section class="commit-box mt-6" aria-label="Cam kết">
          <p class="commit-title">Cam kết</p>
          <ul class="commit-list">
            {commitments.map((item) => (
              <li>
                <svg class="commit-icon" viewBox="0 0 20 20" width="20" height="20" aria-hidden="true">
                  <circle cx="10" cy="10" r="10" fill="currentColor" />
                  <path d="M6 10.5l2.5 2.5L14 7.5" fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </section>
        {!needsWeight && (
          <form id="cart-add-form" method="post" action={routes.cart} data-cart-form data-cart-from="order">
            <input type="hidden" name="intent" value="add" />
            <input type="hidden" name="slug" value={visible.slug} />
            <input type="hidden" name="product_name" value={visible.name} />
            <input type="hidden" name="weight" value="" />
            <input type="hidden" name="quantity" value="1" />
            <input type="hidden" name="price" value={visible.price} />
          </form>
        )}
        <div class="product-cta-row mt-6">
          <a class="btn btn-cta product-buy-cta" href="#dat-hang" data-scroll-to="dat-hang">
            Đặt mua ngay <span aria-hidden="true">→</span>
          </a>
          {needsWeight ? (
            <button class="btn order-add-cart" type="button" data-add-open aria-haspopup="dialog" aria-controls="product-add-dialog">Thêm vào giỏ</button>
          ) : (
            <button class="btn order-add-cart" type="submit" form="cart-add-form">Thêm vào giỏ</button>
          )}
        </div>
        {needsWeight && (
          <dialog id="product-add-dialog" class="add-dialog" aria-labelledby="product-add-title">
            <form class="add-form" method="post" action={routes.cart} data-cart-form data-requires-weight="true">
              <div class="add-head">
                <p id="product-add-title" class="font-semibold">{visible.name}</p>
                <button class="add-close" type="button" data-add-close aria-label="Đóng">×</button>
              </div>
              <p class="font-semibold text-primary-strong" data-add-price>{formatVnd(visible.price)}</p>
              <input type="hidden" name="intent" value="add" />
              <input type="hidden" name="slug" value={visible.slug} />
              <input type="hidden" name="product_name" value={visible.name} />
              <input type="hidden" name="price" value={visible.price} />
              <fieldset class="mt-3" data-weight-field data-base-price={visible.price}>
                <legend class="text-sm font-semibold">Cân nặng của bé</legend>
                <div class="weight-grid mt-2" role="radiogroup">
                  {addChips.map((weight, index) => (
                    <label class="weight-chip">
                      <input type="radio" name="weight" value={weight} required={index === 0} />
                      <span>{weight}</span>
                    </label>
                  ))}
                  <button type="button" class="weight-chip weight-chip-more" data-weight-more aria-expanded="false" aria-label="Cân nặng khác">
                    <span aria-hidden="true">+</span>
                  </button>
                </div>
                <div class="weight-extra mt-2" data-weight-extra hidden>
                  <select class="field" data-weight-extra-select aria-label="Chọn cân nặng lớn hơn">
                    <option value="">Chọn cân nặng (16kg – 70kg)</option>
                    {addExtras.map((weight) => (
                      <option value={weight}>{weightOptionLabel(weight, visible.price)}</option>
                    ))}
                  </select>
                </div>
                <p class="weight-surcharge-note" data-weight-note hidden></p>
              </fieldset>
              <QtyStepper max={CART_MAX_QUANTITY} />
              <p class="add-error error-text mt-2" role="alert" hidden></p>
              <button class="btn btn-primary mt-4 w-full" type="submit">Thêm vào giỏ</button>
            </form>
          </dialog>
        )}
        <ProductStory />
        <section id="dat-hang" class="product-order mt-10 rounded-lg bg-surface p-4 sm:p-6" aria-labelledby="order-heading">
          <h2 id="order-heading" class="text-xl font-semibold">Đặt hàng</h2>
          <p class="mt-2 text-muted">Xưởng gọi lại để chốt đơn. Website không thu tiền trực tuyến.</p>
          <OrderForm product={visible} />
        </section>
      </main>
    )
  }
</PublicLayout>
<script>
  // Cuộn mượt tới phần đặt hàng khi bấm "Đặt mua ngay"; vẫn giữ anchor để hoạt động nếu JS tắt.
  const buyCta = document.querySelector('[data-scroll-to]');
  if (buyCta instanceof HTMLAnchorElement) {
    buyCta.addEventListener('click', (event) => {
      const target = document.getElementById(buyCta.dataset.scrollTo || '');
      if (!target) return;
      event.preventDefault();
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      target.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'start' });
      const field = target.querySelector('input, select, textarea, button');
      if (field instanceof HTMLElement) window.setTimeout(() => field.focus({ preventScroll: true }), reduceMotion ? 0 : 450);
    });
  }
</script>
