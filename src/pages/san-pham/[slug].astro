---
import AddonPicker from '../../components/public/AddonPicker.astro';
import DataError from '../../components/public/DataError.astro';
import FaqSection from '../../components/public/FaqSection.astro';
import FreeShipBadge from '../../components/public/FreeShipBadge.astro';
import NotFound from '../../components/public/NotFound.astro';
import OrderForm from '../../components/public/OrderForm.astro';
import ProductComments from '../../components/public/ProductComments.svelte';
import ProductProcess from '../../components/public/ProductProcess.astro';
import ProductStory from '../../components/public/ProductStory.astro';
import QtyStepper from '../../components/public/QtyStepper.astro';
import { CART_MAX_QUANTITY } from '../../features/cart/cart';
import { listOrderCosts } from '../../features/costs/order-costs';
import { listPublicCommentThreads } from '../../features/product-comments/comments';
import { addonShipHint, listPublicAddons, type PublicAddon } from '../../features/products/addons';
import { getPublicProduct } from '../../features/products/public';
import { isPubliclySellable } from '../../features/products/status';
import { productRequiresTagName, TAG_NAME_MAX } from '../../features/products/tag-name';
import { requiresWeight, weightChips, weightExtras, weightOptionLabel } from '../../features/products/weight';
import { getPublicSite } from '../../features/settings/settings';
import {
  baseCustomerShippingFee,
  productShipBadge,
  resolveCustomerShippingFee,
  shipGroupOf,
} from '../../features/shipping/customer-fee';
import { productViewPayload } from '../../features/tracking/tracking';
import PublicLayout from '../../layouts/PublicLayout.astro';
import { redirectHttpResponse } from '../../features/redirects/http';
import { resolvePublicRedirect } from '../../features/redirects/lookup';
import { createDb } from '../../lib/db/client';
import { getDbBinding, getSiteOrigin } from '../../lib/cloudflare/env';
import { formatVnd } from '../../lib/money';
import { breadcrumbSchema, buildMeta, jsonLd, productSchema } from '../../lib/seo/meta';
import { routes } from '../../lib/routes';

const slug = Astro.params.slug ?? '';
const loaded = await loadProduct();
if (loaded.http) return loaded.http;
const visible = loaded.product && isPubliclySellable(loaded.product) ? loaded.product : null;
const commentThreads = visible ? loaded.comments : [];
const productShipGroup = visible ? shipGroupOf(visible.categorySlug) : 'other';
const showAddonPicker = productShipGroup === 'bracelet' && loaded.addons.length > 0;
const addons = showAddonPicker ? loaded.addons : [];
const goodsTotal = visible ? visible.price : 0;
const shipping = visible
  ? resolveCustomerShippingFee({
      lines: [{ group: productShipGroup, lineTotal: goodsTotal }],
      baseFee: loaded.shipBaseFee,
    })
  : null;
const addonHint = addonShipHint(goodsTotal);
if (!visible) {
  Astro.response.status = loaded.site ? 404 : 503;
  Astro.response.headers.set('Cache-Control', 'no-store');
  Astro.response.headers.set('X-Robots-Tag', 'noindex');
} else {
  Astro.response.headers.set('Cache-Control', 'public, max-age=60');
}

const origin = getSiteOrigin(Astro.url.origin);
const meta = buildMeta(origin, {
  title: visible ? `${visible.seoTitle || visible.name} | ${loaded.site?.siteName ?? ''}` : 'Không tìm thấy trang',
  description: visible?.metaDescription || visible?.description || loaded.site?.defaultSeoDescription || 'Không tìm thấy sản phẩm.',
  path: routes.product(slug),
  image: visible?.images[0]?.url,
  siteName: loaded.site?.siteName,
  robots: visible ? 'index,follow' : 'noindex,nofollow',
});
const crumbs = visible && loaded.site
  ? [
      { name: 'Trang chủ', path: routes.home },
      { name: 'Mẫu vòng dâu tằm', path: routes.catalog },
      { name: visible.name, path: routes.product(visible.slug) },
    ]
  : [];
const trail = visible && loaded.site ? breadcrumbSchema(origin, crumbs) : null;
const shipBadge = visible ? productShipBadge(visible.price, visible.categorySlug) : 'none';
/** Chỉ vòng: cam kết / quy trình / FAQ. Bạc và bán kèm (bó dâu) không hiện. */
const showBraceletStory = productShipGroup === 'bracelet';
const jsonLdBlocks = visible && loaded.site
  ? [
      ...(trail ? [jsonLd(trail)] : []),
      jsonLd(productSchema({
        name: visible.name,
        description: visible.description,
        canonical: meta.canonical,
        image: meta.image,
        price: visible.price,
        siteName: loaded.site.siteName,
      })),
    ]
  : [];

const commitments = [
  'Làm từ cây dâu tằm ta Việt Nam',
  'Không hóa chất, không nhuộm màu',
  'Làm theo cân nặng riêng của bé',
  'Hạt dâu tằm lâu năm, già chắc & đặc lõi',
  'Nhận hàng kiểm tra hàng thoải mái',
];

const needsWeight = visible ? requiresWeight(visible.weightScale) : false;
const needsTag = visible ? productRequiresTagName(visible.name) : false;
const needsAddDialog = needsWeight || needsTag;
const addChips = needsWeight && visible ? weightChips(visible.weightScale) : [];
const addExtras = needsWeight && visible ? weightExtras(visible.weightScale) : [];

async function loadProduct(): Promise<{
  site: Awaited<ReturnType<typeof getPublicSite>>;
  failed: boolean;
  product: Awaited<ReturnType<typeof getPublicProduct>>;
  http: Response | null;
  shipBaseFee: number;
  comments: Awaited<ReturnType<typeof listPublicCommentThreads>>;
  addons: PublicAddon[];
}> {
  try {
    const db = createDb(getDbBinding());
    const site = await getPublicSite(db);
    if (!site) {
      return { site: null, failed: false, product: null, http: null, shipBaseFee: 0, comments: [], addons: [] };
    }
    const [product, shipBaseFee, addons] = await Promise.all([
      getPublicProduct(db, slug),
      listOrderCosts(db).then((costs) => baseCustomerShippingFee(costs)),
      listPublicAddons(db),
    ]);
    if (product && !isPubliclySellable(product)) {
      const outcome = await resolvePublicRedirect(db, routes.product(slug));
      if (outcome?.type === 'redirect') {
        return {
          site,
          failed: false,
          product: null,
          http: redirectHttpResponse(outcome),
          shipBaseFee,
          comments: [],
          addons: [],
        };
      }
    }
    const comments =
      product && isPubliclySellable(product) ? await listPublicCommentThreads(db, product.id) : [];
    return { site, failed: false, product, http: null, shipBaseFee, comments, addons };
  } catch (error) {
    console.error(JSON.stringify({ event: 'product_public_failed', name: error instanceof Error ? error.name : 'unknown' }));
    return { site: null, failed: true, product: null, http: null, shipBaseFee: 0, comments: [], addons: [] };
  }
}
---

<PublicLayout
  title={meta.title}
  description={meta.description}
  canonical={visible ? meta.canonical : undefined}
  image={meta.image}
  imageAlt={visible?.images[0]?.alt}
  imageWidth={visible?.images[0]?.width}
  imageHeight={visible?.images[0]?.height}
  robots={meta.robots}
  siteName={meta.siteName}
  jsonLd={jsonLdBlocks}
  faviconUrl={loaded.site?.faviconUrl || '/favicon.svg'}
  chrome={loaded.site}
  trackEvent={visible ? 'view' : null}
  trackPayload={visible ? productViewPayload({ slug: visible.slug, name: visible.name, price: visible.price }) : null}
>
  {
    !loaded.site ? (
      <DataError failed={loaded.failed} />
    ) : !visible ? (
      <NotFound />
    ) : (
      <main class="mx-auto max-w-3xl px-4 py-10">
        <nav aria-label="Đường dẫn">
          <ol class="flex flex-wrap gap-2 text-sm text-muted">
            {crumbs.map((crumb, index) => (
              <li class="flex gap-2">
                {index > 0 && <span aria-hidden="true">/</span>}
                {index === crumbs.length - 1 ? <span>{crumb.name}</span> : <a href={crumb.path}>{crumb.name}</a>}
              </li>
            ))}
          </ol>
        </nav>
        <h1 class="product-title mt-4 font-semibold tracking-tight text-balance">{visible.name}</h1>
        <p class="mt-3 text-xl font-semibold text-primary-strong">{formatVnd(visible.price)}</p>
        {shipBadge !== 'none' && <FreeShipBadge variant={shipBadge} class="mt-2" />}
        {visible.images.length > 0 && (
          <ul class="mt-6 grid gap-3">
            {visible.images.map((image, index) => (
              <li>
                <img
                  class="h-auto w-full rounded-lg"
                  src={image.url}
                  alt={image.alt}
                  width={image.width ?? undefined}
                  height={image.height ?? undefined}
                  loading={index === 0 ? undefined : 'lazy'}
                />
              </li>
            ))}
          </ul>
        )}
        <p class="mt-6 whitespace-pre-line leading-relaxed">{visible.description}</p>
        {showBraceletStory && (
          <section class="commit-box mt-6" aria-label="Cam kết">
            <p class="commit-title">Cam kết</p>
            <ul class="commit-list">
              {commitments.map((item) => (
                <li>
                  <svg class="commit-icon" viewBox="0 0 20 20" width="20" height="20" aria-hidden="true">
                    <circle cx="10" cy="10" r="10" fill="currentColor" />
                    <path d="M6 10.5l2.5 2.5L14 7.5" fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </section>
        )}
        <div data-addon-root={showAddonPicker ? '' : undefined}>
        {!needsAddDialog && (
          <form id="cart-add-form" method="post" action={routes.cart} data-cart-form data-cart-from="order">
            <input type="hidden" name="intent" value="add" />
            <input type="hidden" name="slug" value={visible.slug} />
            <input type="hidden" name="product_name" value={visible.name} />
            <input type="hidden" name="weight" value="" />
            <input type="hidden" name="quantity" value="1" />
            <input type="hidden" name="price" value={visible.price} />
            {showAddonPicker && <span data-addon-sync-list></span>}
          </form>
        )}
        {showAddonPicker && (
          <AddonPicker addons={addons} hint={addonHint} idPrefix="product-addon" />
        )}
        <div class="product-cta-row mt-6">
          <a class="btn btn-cta product-buy-cta" href="#dat-hang" data-scroll-to="dat-hang">
            Đặt mua ngay <span aria-hidden="true">→</span>
          </a>
          {needsAddDialog ? (
            <button class="btn order-add-cart" type="button" data-add-open aria-haspopup="dialog" aria-controls="product-add-dialog">Thêm vào giỏ</button>
          ) : (
            <button class="btn order-add-cart" type="submit" form="cart-add-form">Thêm vào giỏ</button>
          )}
        </div>
        {needsAddDialog && (
          <dialog id="product-add-dialog" class="add-dialog" aria-labelledby="product-add-title">
            <form
              class="add-form"
              method="post"
              action={routes.cart}
              data-cart-form
              data-requires-weight={needsWeight ? 'true' : undefined}
              data-requires-tag={needsTag ? 'true' : undefined}
            >
              <div class="add-head">
                <p id="product-add-title" class="font-semibold">{visible.name}</p>
                <button class="add-close" type="button" data-add-close aria-label="Đóng">×</button>
              </div>
              <p class="font-semibold text-primary-strong" data-add-price>{formatVnd(visible.price)}</p>
              <input type="hidden" name="intent" value="add" />
              <input type="hidden" name="slug" value={visible.slug} />
              <input type="hidden" name="product_name" value={visible.name} />
              <input type="hidden" name="price" value={visible.price} />
              {showAddonPicker && <span data-addon-sync-list></span>}
              {
                needsWeight ? (
                  <fieldset class="mt-3" data-weight-field data-base-price={visible.price}>
                    <legend class="text-sm font-semibold">Cân nặng của bé</legend>
                    <div class="weight-grid mt-2" role="radiogroup">
                      {addChips.map((weight, index) => (
                        <label class="weight-chip">
                          <input type="radio" name="weight" value={weight} required={index === 0} />
                          <span>{weight}</span>
                        </label>
                      ))}
                      <button type="button" class="weight-chip weight-chip-more" data-weight-more aria-expanded="false" aria-label="Cân nặng khác">
                        <span aria-hidden="true">+</span>
                      </button>
                    </div>
                    <div class="weight-extra mt-2" data-weight-extra hidden>
                      <select class="field" data-weight-extra-select aria-label="Chọn cân nặng lớn hơn">
                        <option value="">Chọn cân nặng (16kg – 70kg)</option>
                        {addExtras.map((weight) => (
                          <option value={weight}>{weightOptionLabel(weight, visible.price)}</option>
                        ))}
                      </select>
                    </div>
                    <p class="weight-surcharge-note" data-weight-note hidden></p>
                  </fieldset>
                ) : (
                  <input type="hidden" name="weight" value="" />
                )
              }
              {
                needsTag && (
                  <label class="mt-3 block text-sm font-semibold" for="product-tag-name">
                    Tên cần in lên thẻ
                    <input id="product-tag-name" class="field mt-1" name="tagName" required maxlength={TAG_NAME_MAX} autocomplete="off" placeholder="Ví dụ: Minh An" />
                  </label>
                )
              }
              <QtyStepper max={CART_MAX_QUANTITY} />
              <p class="add-error error-text mt-2" role="alert" hidden></p>
              <button class="btn btn-primary mt-4 w-full" type="submit">Thêm vào giỏ</button>
            </form>
          </dialog>
        )}
        {showBraceletStory && <ProductProcess class="home-defer" />}
        {showBraceletStory && <ProductStory />}
        {showBraceletStory && <FaqSection class="product-faq home-defer" accordionName="product-faq" />}
        <ProductComments client:load productId={visible.id} threads={commentThreads} />
        <style is:inline>
          /* Chặn nháy form đặt hàng trước khi CSS bundle kịp. */
          #dat-hang[data-order-panel]:not([data-open]) {
            display: none !important;
          }
        </style>
        <section
          id="dat-hang"
          class="product-order mt-10 rounded-lg bg-surface p-4 sm:p-6"
          aria-labelledby="order-heading"
          data-order-panel
          hidden
          inert
        >
          <h2 id="order-heading" class="text-xl font-semibold">Đặt hàng</h2>
          <OrderForm
            product={visible}
            shipping={shipping}
            goodsTotal={goodsTotal}
            shipBaseFee={loaded.shipBaseFee}
            shipGroup={productShipGroup}
            addons={addons}
            addonHint={addonHint}
            addonConfirmDialog={false}
          />
        </section>
        </div>
        <noscript>
          <style>
            #dat-hang[data-order-panel] {
              display: block !important;
            }
          </style>
        </noscript>
        <div class="product-sticky-order" data-product-sticky-order>
          <div class="product-sticky-order-inner">
            <p
              class="product-sticky-order-price"
              data-product-sticky-price
              data-sticky-base={visible.price}
            >
              {formatVnd(visible.price)}
            </p>
            <a class="btn btn-cta product-sticky-order-btn" href="#dat-hang" data-scroll-to="dat-hang">
              <span class="product-sticky-order-label">
                <span class="product-sticky-order-title">
                  Đặt hàng
                  <span aria-hidden="true">↓</span>
                </span>
                {shipBadge === 'free' && <span class="product-sticky-order-ship">(miễn phí vận chuyển)</span>}
              </span>
            </a>
          </div>
        </div>
      </main>
    )
  }
</PublicLayout>
<script>
  import '../../scripts/youtube-facade';
</script>
<script>
  // Box đặt hàng ẩn mặc định; bấm CTA mới hiện + cuộn tới. Sticky ẩn khi form đã trong khung nhìn.
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const orderBox = document.getElementById('dat-hang');
  const sticky = document.querySelector('[data-product-sticky-order]');

  function focusOrderField(target: HTMLElement) {
    const field = target.querySelector('input:not([type="hidden"]), select, textarea, button');
    if (field instanceof HTMLElement) {
      window.setTimeout(() => field.focus({ preventScroll: true }), reduceMotion ? 0 : 450);
    }
  }

  function revealOrder(scroll: boolean) {
    if (!(orderBox instanceof HTMLElement)) return;
    const wasClosed = !orderBox.hasAttribute('data-open');
    if (wasClosed) {
      orderBox.setAttribute('data-open', '');
      orderBox.removeAttribute('hidden');
      orderBox.removeAttribute('inert');
    }
    if (!scroll) return;
    const run = () => {
      orderBox.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'start' });
      focusOrderField(orderBox);
    };
    if (wasClosed) requestAnimationFrame(() => requestAnimationFrame(run));
    else run();
  }

  function onOrderCta(anchor: HTMLAnchorElement, event: Event) {
    if (anchor.dataset.scrollTo !== 'dat-hang') return;
    event.preventDefault();
    revealOrder(true);
    if (location.hash !== '#dat-hang') history.replaceState(null, '', '#dat-hang');
  }

  document.querySelectorAll('[data-scroll-to]').forEach((node) => {
    if (node instanceof HTMLAnchorElement) {
      node.addEventListener('click', (event) => onOrderCta(node, event));
    }
  });

  if (location.hash === '#dat-hang') revealOrder(true);

  if (sticky instanceof HTMLElement && orderBox instanceof HTMLElement) {
    const sync = (orderInView: boolean) => {
      const open = orderBox.hasAttribute('data-open');
      const away = open && orderInView;
      sticky.classList.toggle('is-away', away);
      sticky.setAttribute('aria-hidden', away ? 'true' : 'false');
      sticky.toggleAttribute('inert', away);
      document.documentElement.classList.toggle('has-product-sticky-order', !away);
    };
    document.documentElement.classList.add('has-product-sticky-order');
    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          const entry = entries[0];
          sync(Boolean(entry?.isIntersecting));
        },
        { rootMargin: '0px 0px -18% 0px', threshold: 0.08 },
      );
      observer.observe(orderBox);
    }
  }
</script>
