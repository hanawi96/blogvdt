---
import DataError from '../components/public/DataError.astro';
import OrderForm from '../components/public/OrderForm.astro';
import { listOrderCosts } from '../features/costs/order-costs';
import { applyDiscount } from '../features/discounts/quote';
import { priceDiscount } from '../features/discounts/discounts';
import {
  addonUnitWithBundleOffers,
  catalogUnitWithComboOffers,
  listActiveAddonBundleOffers,
  listActiveComboOffersByProductId,
} from '../features/home-collections/collections';
import { toPublicComboPricing } from '../features/home-collections/combo-price';
import { lineUnitPrice, ORDER_MAX_QUANTITY, parseCartOrder, parseOrderSubmission } from '../features/orders/order';
import { applyWeightPrice } from '../features/products/weight';
import { placeCartOrder, placeOrder } from '../features/orders/orders';
import {
  addonShipHint,
  findAddonsInCatalog,
  listPublicAddons,
  readAddonSlugFields,
  resolveAddonSlug,
  type PublicAddon,
} from '../features/products/addons';
import { listOrderCatalog } from '../features/products/public';
import { getPublicSite } from '../features/settings/settings';
import { baseCustomerShippingFee, resolveCustomerShippingFee, shipGroupOf } from '../features/shipping/customer-fee';
import PublicLayout from '../layouts/PublicLayout.astro';
import { createDb } from '../lib/db/client';
import { getDbBinding, getSiteOrigin } from '../lib/cloudflare/env';
import { clientIp, hashIp, isSameOrigin } from '../lib/http';
import { formatVnd } from '../lib/money';
import { buildMeta } from '../lib/seo/meta';
import { routes } from '../lib/routes';
import type { FieldErrors } from '../lib/validation/errors';
import type { DiscountQuote } from '../features/discounts/quote';

let site: Awaited<ReturnType<typeof getPublicSite>> = null;
let catalog: Awaited<ReturnType<typeof listOrderCatalog>> = [];
let addons: PublicAddon[] = [];
let comboOffers: Awaited<ReturnType<typeof listActiveComboOffersByProductId>> = new Map();
let addonOffers: Awaited<ReturnType<typeof listActiveAddonBundleOffers>> = [];
let shipBaseFee = 0;
let failed = false;
let db: ReturnType<typeof createDb> | null = null;
try {
  db = createDb(getDbBinding());
  site = await getPublicSite(db);
  if (site) {
    const [orderCatalog, publicAddons, costs, offers, bundles] = await Promise.all([
      listOrderCatalog(db),
      listPublicAddons(db),
      listOrderCosts(db),
      listActiveComboOffersByProductId(db),
      listActiveAddonBundleOffers(db),
    ]);
    catalog = orderCatalog;
    addons = publicAddons;
    comboOffers = offers;
    addonOffers = bundles;
    shipBaseFee = baseCustomerShippingFee(costs);
  }
} catch (error) {
  failed = true;
  console.error(JSON.stringify({ event: 'checkout_load_failed', name: error instanceof Error ? error.name : 'unknown' }));
}

const posted = Astro.request.method === 'POST';
const form = posted ? await Astro.request.formData() : null;
const read = (name: string) => {
  const value = form?.get(name);
  return typeof value === 'string' ? value : '';
};
const selectedSlug = posted ? read('productSlug') : (Astro.url.searchParams.get('san-pham') ?? '');
const selected = catalog.find((product) => product.slug === selectedSlug) ?? null;
const postedAddonSlugs = form ? readAddonSlugFields(form) : [];
const queryAddonSlug = !posted
  ? resolveAddonSlug(Astro.url.searchParams.get('ban-kem'), addons)
  : null;
const activeAddonSlugs = posted ? postedAddonSlugs : queryAddonSlug ? [queryAddonSlug] : [];
const pickedAddons = findAddonsInCatalog(activeAddonSlugs, catalog);
const queryQty = !posted ? Number(Astro.url.searchParams.get('so-luong') ?? '') : NaN;
const defaultQty =
  Number.isInteger(queryQty) && queryQty >= 1 && queryQty <= ORDER_MAX_QUANTITY ? String(queryQty) : '1';
const values = {
  customerName: read('customerName'),
  phone: read('phone'),
  address: read('address'),
  provinceCode: read('provinceCode'),
  wardCode: read('wardCode'),
  addressLine: read('addressLine'),
  note: read('note'),
  tagName: read('tagName'),
  quantity: read('quantity') || defaultQty,
  weight: read('weight'),
  paymentMethod: read('paymentMethod'),
  discountCode: read('discountCode'),
  addonSlug: activeAddonSlugs[0] ?? '',
  addonSlugs: activeAddonSlugs,
};
const landing = read('landing');
let errors: FieldErrors = {};
let formError = '';
let quote: DiscountQuote | null = null;

function merchandiseWithAddon(): { ok: true; subtotal: number } | { ok: false; error: string } {
  if (!selected) return { ok: false, error: 'Chọn sản phẩm đang bán.' };
  const quantity = Number(values.quantity);
  if (!Number.isInteger(quantity) || quantity < 1 || quantity > ORDER_MAX_QUANTITY) {
    return { ok: false, error: `Số lượng là số nguyên từ 1 đến ${ORDER_MAX_QUANTITY}.` };
  }
  const uniquePosted = [...new Set(postedAddonSlugs)];
  if (uniquePosted.length > 0 && pickedAddons.length !== uniquePosted.length) {
    return { ok: false, error: 'Bó dâu bán kèm không còn bán.' };
  }
  const orderIds = new Set([selected.id, ...pickedAddons.map((item) => item.id)]);
  const main = lineUnitPrice(selected, quantity, values.weight, comboOffers, addonOffers, orderIds) * quantity;
  const addonTotal = pickedAddons.reduce(
    (sum, item) => sum + addonUnitWithBundleOffers(item.price, item.id, orderIds, addonOffers),
    0,
  );
  return { ok: true, subtotal: main + addonTotal };
}

if (posted) {
  Astro.response.headers.set('Cache-Control', 'no-store');
  if (!site) {
    Astro.response.status = 503;
  } else if (!isSameOrigin(Astro.request)) {
    Astro.response.status = 403;
    formError = 'Nguồn gửi không hợp lệ.';
  } else if (read('intent') === 'apply') {
    if (read('company').trim()) {
      Astro.response.status = 403;
      formError = 'Không gửi được đơn.';
    } else {
      const goods = merchandiseWithAddon();
      if (!goods.ok) {
        Astro.response.status = 422;
        if (goods.error.includes('Số lượng')) errors = { quantity: goods.error };
        else if (goods.error.includes('Bó dâu')) errors = { addonSlug: goods.error };
        else errors = { productSlug: goods.error };
      } else if (!db) {
        Astro.response.status = 503;
        formError = 'Chưa kiểm được mã. Thử lại sau.';
      } else {
        const priced = await priceDiscount(db, goods.subtotal, values.discountCode, await visitorHash(), Date.now(), true);
        if (!priced.ok) {
          Astro.response.status = 422;
          errors = { discountCode: priced.error };
        } else {
          quote = priced.discount;
        }
      }
    }
  } else {
    const uniquePosted = [...new Set(postedAddonSlugs)];
    if (uniquePosted.length > 0 && pickedAddons.length !== uniquePosted.length) {
      Astro.response.status = 422;
      errors = { addonSlug: 'Bó dâu bán kèm không còn bán.' };
    } else if (pickedAddons.length > 0 && selected) {
      const parsed = parseCartOrder(
        {
          customerName: values.customerName,
          phone: values.phone,
          address: values.address,
          note: values.note,
          paymentMethod: values.paymentMethod,
          company: read('company'),
          lines: [
            {
              slug: selected.slug,
              quantity: Number(values.quantity) || 1,
              weight: values.weight,
              note: values.tagName,
            },
            ...pickedAddons.map((addon) => ({ slug: addon.slug, quantity: 1, weight: '', note: '' })),
          ],
        },
        catalog,
        comboOffers,
        addonOffers,
      );
      if (!parsed.ok) {
        Astro.response.status = parsed.blocked ? 403 : 422;
        formError = parsed.blocked ? 'Không gửi được đơn.' : '';
        errors = parsed.errors;
      } else if (!db) {
        Astro.response.status = 503;
        formError = 'Chưa lưu được đơn. Thử lại sau.';
      } else {
        try {
          const ipHash = await visitorHash();
          const base = parsed.single ?? parsed.cart;
          const priced = base
            ? await priceDiscount(db, base.subtotal, values.discountCode, ipHash)
            : { ok: false as const, error: 'Giỏ đang trống.' };
          if (!priced.ok) {
            Astro.response.status = 422;
            errors = { discountCode: priced.error };
          } else {
            const saved = parsed.single
              ? await placeOrder(db, { ...parsed.single, ...applyDiscount(parsed.single.subtotal, priced.discount) }, ipHash)
              : parsed.cart
                ? await placeCartOrder(db, { ...parsed.cart, ...applyDiscount(parsed.cart.subtotal, priced.discount) }, ipHash)
                : { ok: false as const, status: 422 as const, error: 'Giỏ đang trống.' };
            if (!saved.ok) {
              Astro.response.status = saved.status;
              formError = saved.error;
            } else {
              const response = Astro.redirect(`${routes.checkoutSuccess}?ma=${saved.code}`, 303);
              response.headers.set('Cache-Control', 'no-store');
              return response;
            }
          }
        } catch (error) {
          Astro.response.status = 503;
          formError = 'Chưa lưu được đơn. Thử lại sau.';
          console.error(JSON.stringify({ event: 'order_create_failed', name: error instanceof Error ? error.name : 'unknown' }));
        }
      }
    } else {
      const parsed = parseOrderSubmission(
        { ...values, productSlug: selectedSlug, company: read('company'), landing },
        catalog,
        comboOffers,
      );
      if (!parsed.ok) {
        Astro.response.status = parsed.blocked ? 403 : 422;
        formError = parsed.blocked ? 'Không gửi được đơn.' : '';
        errors = parsed.errors;
      } else if (!db) {
        Astro.response.status = 503;
        formError = 'Chưa lưu được đơn. Thử lại sau.';
      } else {
        try {
          const ipHash = await visitorHash();
          const priced = await priceDiscount(db, parsed.draft.subtotal, values.discountCode, ipHash);
          if (!priced.ok) {
            Astro.response.status = 422;
            errors = { discountCode: priced.error };
          } else {
            const saved = await placeOrder(db, { ...parsed.draft, ...applyDiscount(parsed.draft.subtotal, priced.discount) }, ipHash);
            if (!saved.ok) {
              Astro.response.status = saved.status;
              formError = saved.error;
            } else {
              const response = Astro.redirect(`${routes.checkoutSuccess}?ma=${saved.code}`, 303);
              response.headers.set('Cache-Control', 'no-store');
              return response;
            }
          }
        } catch (error) {
          Astro.response.status = 503;
          formError = 'Chưa lưu được đơn. Thử lại sau.';
          console.error(JSON.stringify({ event: 'order_create_failed', name: error instanceof Error ? error.name : 'unknown' }));
        }
      }
    }
  }
} else if (site) {
  Astro.response.headers.set('Cache-Control', 'public, max-age=60');
} else {
  Astro.response.headers.set('Cache-Control', 'no-store');
}

async function visitorHash(): Promise<string> {
  let address: string | null = null;
  try {
    address = Astro.clientAddress;
  } catch {
    address = null;
  }
  return hashIp(clientIp(Astro.request, address));
}

const meta = buildMeta(getSiteOrigin(Astro.url.origin), {
  title: site ? `Đặt hàng | ${site.siteName}` : 'Chưa sẵn sàng',
  description: 'Gửi thông tin để xưởng làm vòng. Chưa thanh toán trên website.',
  path: routes.checkout,
  siteName: site?.siteName,
  robots: site ? 'index,follow' : 'noindex,nofollow',
});

const selectedQty = Number(values.quantity);
const selectedGroup = selected ? shipGroupOf(selected.categorySlug) : 'other';
const formAddons = selectedGroup === 'bracelet' ? addons : [];
const comboBase =
  selected && Number.isInteger(selectedQty) && selectedQty > 0
    ? catalogUnitWithComboOffers(selected.price, selected.id, selectedQty, comboOffers)
    : selected?.price ?? 0;
const mainUnit =
  selected && Number.isInteger(selectedQty) && selectedQty > 0
    ? lineUnitPrice(selected, selectedQty, values.weight, comboOffers)
    : comboBase;
const mainGoodsTotal =
  selected && Number.isInteger(selectedQty) && selectedQty > 0 ? mainUnit * selectedQty : mainUnit;
const checkoutOrderIds = selected
  ? new Set([selected.id, ...pickedAddons.map((item) => item.id)])
  : new Set<number>();
const pricedAddons = pickedAddons.map((item) => ({
  ...item,
  salePrice: addonUnitWithBundleOffers(item.price, item.id, checkoutOrderIds, addonOffers),
}));
const addonGoodsTotal = pricedAddons.reduce((sum, item) => sum + item.salePrice, 0);
const goodsTotal = mainGoodsTotal + addonGoodsTotal;
const shipping = selected
  ? resolveCustomerShippingFee({
      lines: [
        { group: selectedGroup, lineTotal: mainGoodsTotal },
        ...pricedAddons.map((item) => ({ group: 'addon' as const, lineTotal: item.salePrice })),
      ],
      baseFee: shipBaseFee,
    })
  : null;
const checkoutAddonHint = addonShipHint(mainGoodsTotal);
---

<PublicLayout
  title={meta.title}
  description={meta.description}
  canonical={site && !posted ? meta.canonical : undefined}
  robots={posted ? 'noindex,nofollow' : meta.robots}
  siteName={meta.siteName}
  faviconUrl={site?.faviconUrl || '/favicon.svg'}
  chrome={site}
>
  {
    !site ? (
      <DataError failed={failed} />
    ) : (
      <main class="mx-auto max-w-xl px-4 py-10">
        <h1 class="text-3xl font-semibold">Đặt hàng</h1>
        <p class="mt-3 text-muted">Một đơn cho một sản phẩm. Xưởng gọi lại để chốt, website không thu tiền trực tuyến.</p>
        <form class="mt-6 flex flex-wrap items-end gap-3" method="get" action={routes.checkout}>
          <label class="min-w-52 flex-1">
            <span class="mb-1 block font-semibold">Sản phẩm</span>
            <select class="field" name="san-pham">
              <option value="">Chọn sản phẩm</option>
              {catalog.map((product) => (
                <option value={product.slug} selected={product.slug === selectedSlug}>
                  {product.name} — {formatVnd(product.price)}
                </option>
              ))}
            </select>
          </label>
          <button class="btn" type="submit">Xem lựa chọn</button>
        </form>
        {catalog.length === 0 && <p class="mt-4 text-muted">Chưa có sản phẩm đang bán.</p>}
        {formError && <p class="error-text mt-4" role="alert">{formError}</p>}
        {errors.productSlug && <p class="error-text mt-4" role="alert">{errors.productSlug}</p>}
        {selected && (
          <section class="mt-8" aria-labelledby="selected-product">
            <h2 id="selected-product" class="text-xl font-semibold">{selected.name}</h2>
            <p class="mt-1 text-primary-strong">
              {formatVnd(comboBase)}
              {comboBase < selected.price && (
                <s class="ml-2 font-normal text-muted">{formatVnd(selected.price)}</s>
              )}
              {Number.isInteger(selectedQty) && selectedQty > 1 && (
                <span class="ml-2 text-sm font-normal text-muted">×{selectedQty}</span>
              )}
            </p>
            <OrderForm
              product={selected}
              values={values}
              errors={errors}
              quote={quote}
              landing={landing}
              shipping={shipping}
              goodsTotal={goodsTotal}
              catalogGoodsTotal={
                (Number.isInteger(selectedQty) && selectedQty > 0
                  ? applyWeightPrice(selected.price, values.weight) * selectedQty
                  : selected.price) + pickedAddons.reduce((sum, item) => sum + item.price, 0)
              }
              shipBaseFee={shipBaseFee}
              shipGroup={selectedGroup}
              addons={formAddons}
              addonHint={checkoutAddonHint}
              comboPricing={toPublicComboPricing(comboOffers, addonOffers, catalog)}
            />
          </section>
        )}
      </main>
    )
  }
</PublicLayout>
