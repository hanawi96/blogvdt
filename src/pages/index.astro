              ))}
            </ol>
          </div>
          <figure class="home-process-video">
            <div class="home-process-video-frame">
              {/* Facade: chỉ tải trình phát YouTube (nặng ~590 KiB) khi khách bấm play. */}
              <button
                class="home-process-video-play"
                type="button"
                data-yt-facade={PROCESS_SHORT_ID}
                aria-label="Phát video quy trình làm vòng dâu tằm"
