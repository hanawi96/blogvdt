---
import DataError from '../components/public/DataError.astro';
import HomeProductCard from '../components/public/HomeProductCard.astro';
import OrderDialog from '../components/public/OrderDialog.astro';
import { listHomeCatalogCategories } from '../features/products/categories';
import {
  catalogApiPath,
  catalogPath,
  CATALOG_PAGE_SIZE,
  homeShopPath,
  listCatalogProducts,
  readCatalogQuery,
  type CatalogQuery,
} from '../features/products/catalog';
import { listFeaturedProducts } from '../features/products/featured';
import { getPublicSite } from '../features/settings/settings';
import { createDb } from '../lib/db/client';
import { getDbBinding, getSiteOrigin } from '../lib/cloudflare/env';
import PublicLayout from '../layouts/PublicLayout.astro';
import { buildMeta, homePageMeta, jsonLd, unavailableMeta } from '../lib/seo/meta';
import { blogReadStatus, PRIVATE_PAGE_CACHE, PUBLIC_PAGE_CACHE } from '../lib/seo/cache';
import { routes } from '../lib/routes';

const HOME_PHOTO_LIMIT = 5;
const HOME_DEFAULT_SORT = 'mac-dinh' as const;

type DemoPhoto = {
  url: string;
  alt: string;
  width: number | null;
  height: number | null;
};

const PROCESS_STEPS = [
  { title: 'Chọn nguyên liệu', text: 'Chọn cành dâu tằm phù hợp trước khi tách và làm sạch.', img: '/Images/quy-trinh/quy-trinh-lam-vong_1.webp' },
  { title: 'Bóc dâu tằm', text: 'Tách phần gỗ dùng làm hạt, giữ vẻ mộc tự nhiên.', img: '/Images/quy-trinh/quy-trinh-lam-vong_2.webp' },
  { title: 'Phơi khô', text: 'Phơi đều để hạt khô, ổn định trước khi mài.', img: '/Images/quy-trinh/quy-trinh-lam-vong_3.webp' },
  { title: 'Mài nhỏ cành dâu', text: 'Tạo hình hạt vừa tay bé, đều từng viên.', img: '/Images/quy-trinh/quy-trinh-lam-vong_4.webp' },
  { title: 'Mài mịn viền hạt', text: 'Mài tay cho nhẵn, hạn chế cạnh sắc.', img: '/Images/quy-trinh/quy-trinh-lam-vong_5.webp' },
  { title: 'Xỏ vòng', text: 'Xỏ dây, chỉnh size theo bé và hoàn thiện.', img: '/Images/quy-trinh/quy-trinh-lam-vong_6.webp' },
] as const;

// Ảnh phản hồi cố định (dọc). Đã nén 600px WebP trong /public/Images/feedback.
const FEEDBACK_PHOTOS = Array.from({ length: 10 }, (_, i) => `/Images/feedback/${i + 1}.webp`);

const BENEFITS = [
  {
    title: 'Ngủ ngon hơn.',
    text: 'Bé bớt giật mình và ngủ ngoan và sâu hơn.',
