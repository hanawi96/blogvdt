  description={meta.description}
  canonical={site ? meta.canonical : undefined}
  robots={meta.robots}
  siteName={meta.siteName}
  image={meta.image}
  imageAlt={site?.ogImageAlt || heroPhoto?.alt || null}
  imageWidth={site?.ogImageWidth ?? heroPhoto?.width ?? null}
  imageHeight={site?.ogImageHeight ?? heroPhoto?.height ?? null}
  faviconUrl={site?.faviconUrl || '/favicon.svg'}
  chrome={site}
  jsonLd={schemaEntries}
  preloadImage="/Images/anh-hero-section.webp"
>
