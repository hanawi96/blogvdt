    text: 'Tất cả vòng dâu tằm bên em sẽ làm theo cân nặng riêng của từng bé, nên các mẹ yên tâm không lo bị chật hay rộng ạ.',
    img: '/Images/usp/USP_5.webp',
  },
  {
    title: 'Kiểm tra hàng thoải mái',
    text: 'Các mẹ khi nhận hàng cứ mở ra kiểm tra hàng thoải mái, nếu không hài lòng cứ trả lại cho shiper ạ.',
    img: '/Images/usp/USP_6.webp',
  },
] as const;

const FAQ_ITEMS = [
  {
    q: 'Vòng có phải làm từ cây dâu tằm thật hay không?',
    a: 'Em cam kết vòng dâu tằm em làm đều làm thủ công từ cây dâu tằm ta Việt Nam do chính nhà em trồng, dâu tằm nhà em rất nhiều vào mùa đông nhà em còn lấy dâu tằm làm củi để đốt luộc bánh trưng với sưởi ấm luôn ạ.',
  },
  {
    q: 'Bạc mix vòng là loại bạc gì S925, S990 hay S999?',
    a: 'Bạc em dùng chủ yếu là bạc S999 ạ (chỉ có charm hoa sen, charm thánh giá là bạc s925 và charm chuông là bạc S990). Các mẹ có thể mang ra tiệm bạc để kiểm tra thoải mái ạ.',
  },
  {
    q: 'Có cam kết bạc thật không?',
    a: 'Em cam kết bạc thật ạ. Em làm vòng dâu tằm cho các bé đến 9/2026 là đã hơn 2 năm, bên em mua đi bán lại với rất nhiều tiệm bạc. Trong quá trình bán vòng cũng rất nhiều mẹ nghi ngờ, có mẹ còn chửi vì bảo e bán bạc giả. Em có tự tin giải thích và để các mẹ đi kiểm tra thì tất cả các mẹ đi kiểm tra đều được tiệm bạc khẳng định là bạc thật ạ.',
  },
  {
    q: 'Vòng đụng nước thì có làm sao không?',
    a: 'Vòng dâu em làm đều lấy từ phần gốc của cây dâu tằm, nên rất già chắc và đặc lõi, nên ngâm nước thoải mái không bị làm sao. Nhưng ngâm nước lâu và nhiều thì hạt dâu tằm sẽ đậm hơn và sẽ cũ theo thời gian vì không dùng hóa chất bảo quản gì cả.',
  },
  {
    q: 'Vòng mua cho bé sơ sinh thì bé lớn có đeo được tiếp không?',
    a: 'Các mẫu vòng dâu rút đỏ thì đều có thể nới rộng ra khi bé lớn, nên không sợ bị trật. Còn các mẫu vòng co giãn thì sẽ không nới rộng được, nhưng em đã làm trừ hao sẵn để bé vẫn đeo được lâu dài với các vòng co giãn rồi ạ, nên các mẹ cứ yên tâm nha.',
  },
  {
    q: 'Vòng không sử dụng lâu ngày có mốc không?',
    a: 'Dạ, có thể ạ. Vì vòng em làm không dùng hóa chất chống mốc để an toàn cho bé. Nên nếu không sử dụng để ngoài không khí nồm ẩm có thể bị mốc. Còn nếu đeo trên bé hằng ngày, có hơi người thì vòng không bao giờ mốc được ạ.',
  },
  {
    q: 'Bạc này đeo có bị đen hay không?',
    a: 'Tùy cơ địa mỗi người đeo, không khí và nguồn nước, có người sẽ bị đen, có bé bị ngả vàng có người không bị gì cả ạ. Nhưng phần lớn em thấy những người đeo vòng dâu tằm mix bạc bên em đều không bị ngả màu, chỉ có một số rất ít bé đeo là bị thôi ạ. Chỉ cần tẩy lại bằng nước tẩy bạc họ ra tiệm nhờ họ làm sáng lại là được ạ.',
  },
] as const;

function photoAt(photos: DemoPhoto[], index: number): DemoPhoto | null {
  if (photos.length === 0) return null;
  return photos[index % photos.length] ?? null;
}

// Shop trên home: SSR chỉ trang 1 (12 SP). Filter qua ?danh-muc / ?sap-xep; mặc định giá thấp → cao.
const rawShop = readCatalogQuery(Astro.url.searchParams);
const shopQuery: CatalogQuery = {
  q: '',
  category: rawShop.category,
  sort: Astro.url.searchParams.has('sap-xep') ? rawShop.sort : HOME_DEFAULT_SORT,
  page: 1,
};

const loaded = await loadHome(shopQuery);
const status = blogReadStatus({ hasSite: Boolean(loaded.site), failed: loaded.failed });
if (status !== 200) {
  Astro.response.status = status;
  Astro.response.headers.set('X-Robots-Tag', 'noindex');
}
// Trang chủ công khai, cache ngắn giống catalog — giảm TTFB lặp lại, vẫn làm mới sau 60s.
Astro.response.headers.set('Cache-Control', status === 200 ? PUBLIC_PAGE_CACHE : PRIVATE_PAGE_CACHE);

const photoSource = loaded.photos.length > 0 ? loaded.photos : loaded.products;
const photos: DemoPhoto[] = photoSource.flatMap((product) =>
  product.coverUrl
    ? [{ url: product.coverUrl, alt: product.coverAlt || product.name, width: product.coverWidth, height: product.coverHeight }]
    : [],
);
const shopHasMore = loaded.page < loaded.pageCount;
const shopFiltered = Boolean(shopQuery.category) || Astro.url.searchParams.has('sap-xep');
const nextCatalogHref = catalogPath({ ...shopQuery, page: 2 });
const nextApiHref = catalogApiPath({ ...shopQuery, page: 2 });
const heroPhoto = photoAt(photos, 0);
const PROCESS_SHORT_ID = '15TVzfA-Jys';
const site = loaded.site;
const origin = getSiteOrigin(Astro.url.origin);

const pageMeta = site ? homePageMeta(site) : unavailableMeta();
const meta = buildMeta(origin, {
  title: pageMeta.title,
  description: pageMeta.description,
  path: routes.home,
  siteName: site?.siteName,
  robots: site ? (shopFiltered ? 'noindex,follow' : 'index,follow') : 'noindex,nofollow',
  image: site?.ogImageUrl || heroPhoto?.url || null,
});

const schemaEntries: string[] = [];
if (site && meta.canonical) {
  schemaEntries.push(
    jsonLd({
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: site.siteName,
      url: meta.canonical,
      description: meta.description,
      inLanguage: 'vi',
    }),
  );
  schemaEntries.push(
    jsonLd({
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: FAQ_ITEMS.map((item) => ({
        '@type': 'Question',
        name: item.q,
        acceptedAnswer: { '@type': 'Answer', text: item.a },
      })),
    }),
  );
  if (loaded.products.length > 0) {
    schemaEntries.push(
      jsonLd({
        '@context': 'https://schema.org',
        '@type': 'ItemList',
        itemListElement: loaded.products.map((product, index) => ({
          '@type': 'ListItem',
          position: index + 1,
          url: `${origin}${routes.product(product.slug)}`,
          name: product.name,
        })),
      }),
    );
  }
}

async function loadHome(query: CatalogQuery) {
  const empty = {
    site: null as Awaited<ReturnType<typeof getPublicSite>>,
    failed: false,
    products: [] as Awaited<ReturnType<typeof listCatalogProducts>>['products'],
    photos: [] as Awaited<ReturnType<typeof listFeaturedProducts>>,
    categories: [] as Awaited<ReturnType<typeof listHomeCatalogCategories>>,
    total: 0,
    page: 1,
    pageCount: 1,
  };
  try {
    const db = createDb(getDbBinding());
    const siteRow = await getPublicSite(db);
    if (!siteRow) return empty;
    // 3 query hẹp song song: cover hero (featured), danh mục pill, 12 SP trang 1.
    const [photos, categories, shop] = await Promise.all([
      listFeaturedProducts(db, HOME_PHOTO_LIMIT),
      listHomeCatalogCategories(db),
      listCatalogProducts(db, query),
    ]);
    return {
      site: siteRow,
      failed: false,
      photos,
      categories,
      products: shop.products,
      total: shop.total,
      page: shop.page,
      pageCount: shop.pageCount,
    };
  } catch (error) {
    console.error(JSON.stringify({ event: 'home_read_failed', name: error instanceof Error ? error.name : 'unknown' }));
    return { ...empty, failed: true };
  }
}
---

<PublicLayout
