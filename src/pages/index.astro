                src="/Images/tac-dung/1.webp"
                alt="Vòng dâu tằm ta em làm thủ công"
                width="600"
                height="800"
                loading="lazy"
                decoding="async"
                sizes="(min-width: 56rem) 22rem, 70vw"
              />
              <p class="home-benefits-caption">Vòng dâu tằm ta em làm thủ công</p>
            </div>
            <div class="home-benefits-copy">
              <h2 id="loi-ich-title">
                Vòng dâu tằm thật
