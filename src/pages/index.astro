  },
  {
    title: 'Bình an, may mắn.',
    text: 'Một món quà từ cây nhà, mẹ gửi cho bé những điều lành.',
  },
] as const;

const WHY_POINTS = [
  {
    title: 'Làm thủ công từ cành dâu tằm Việt Nam',
    text: 'Vòng đều được làm từ cây dâu tằm ta Việt Nam mà các cụ dùng ngày xưa, không phải dâu tằm lai hiện nay ạ.',
    img: '/Images/usp/USP_1.webp',
  },
  {
    title: 'Không tẩm hóa chất, không sơn bóng',
