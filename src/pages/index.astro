                Công dụng dựa trên kinh nghiệm dân gian. Mỗi bé có thể khác nhau. Các mẹ nhận hàng cứ kiểm tra thoải mái nha.
              </aside>
              <a class="btn btn-cta" href="#danh-muc-me">Chọn vòng cho bé ngay <span aria-hidden="true">→</span></a>
            </div>
          </div>
        </section>

        <section id="vi-sao" class="home-why-section home-defer" aria-labelledby="vi-sao-title">
          <div class="home-wrap">
            <div class="home-why-intro">
              <h2 id="vi-sao-title">
                Tại sao nên chọn
                <span class="home-script">{site.siteName}</span>
              </h2>
              <p class="home-why-rule" aria-hidden="true"><span class="home-why-heart">♥</span></p>
              <p class="home-why-lead">Những lý do khiến hàng ngàn mẹ tin tưởng và lựa chọn vòng dâu tằm của em Ánh.</p>
            </div>
            <ol class="home-why">
              {WHY_POINTS.map((point, index) => (
                <li class:list={['home-why-row', index % 2 === 1 && 'is-flip']}>
                  <div class="home-why-media">
                    <img
                      src={point.img}
                      alt={point.title}
                      width="700"
                      height="700"
                      loading="lazy"
                      decoding="async"
                      sizes="(min-width: 56rem) 22rem, 88vw"
                    />
                  </div>
                  <div class="home-why-copy">
                    <span class="home-why-num" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
                    <h3>{point.title}</h3>
                    <p>{point.text}</p>
                  </div>
                </li>
              ))}
            </ol>
            <div class="home-why-cta">
              <a class="btn home-why-cta-btn" href="#danh-muc-me">Chọn vòng cho bé ngay <span aria-hidden="true">→</span></a>
              <p>Các mẹ kiểm tra hàng thoải mái trước khi thanh toán</p>
            </div>
          </div>
        </section>

        <section id="danh-muc-me" class="home-wrap home-section home-defer" aria-labelledby="danh-muc-me-title">
          <div class="home-section-intro">
            <h2 id="danh-muc-me-title">
              Chọn theo
              <span class="home-script">sở thích của mẹ</span>
            </h2>
            <p class="home-heart-rule" aria-hidden="true"><span>♥</span></p>
          </div>
          {loaded.categories.length > 0 ? (
            <nav class="home-cat-pills" aria-label="Lọc theo danh mục sản phẩm" data-home-cats>
              <a
                class="home-cat-pill"
                href={homeShopPath({ category: '', sort: shopQuery.sort })}
                data-home-filter
                data-category=""
                aria-current={shopQuery.category === '' ? 'true' : undefined}
              >
                <span class="home-cat-thumb home-cat-thumb-all" aria-hidden="true">▦</span>
                <span>Tất cả mẫu</span>
              </a>
              {loaded.categories.map((category) => (
                <a
                  class="home-cat-pill"
                  href={homeShopPath({ category: category.slug, sort: shopQuery.sort })}
                  data-home-filter
                  data-category={category.slug}
                  aria-current={shopQuery.category === category.slug ? 'true' : undefined}
                >
                  {category.coverUrl ? (
                    <img
                      class="home-cat-thumb"
                      src={category.coverUrl}
                      alt=""
                      width="40"
                      height="40"
                      loading="lazy"
                      decoding="async"
                    />
                  ) : (
                    <span class="home-cat-thumb home-cat-thumb-empty" aria-hidden="true" />
                  )}
                  <span>{category.name}</span>
                </a>
              ))}
            </nav>
          ) : (
            <p class="home-empty">Chưa có danh mục đang bán. <a href={routes.catalog}>Xem mẫu vòng</a></p>
          )}
        </section>

        <section
          id="san-pham"
          class="home-wrap home-section home-defer"
          aria-labelledby="san-pham-title"
          data-home-shop
          data-api={routes.catalogApi}
          data-page={String(loaded.page)}
          data-page-count={String(loaded.pageCount)}
          data-category={shopQuery.category}
          data-sort={shopQuery.sort}
          data-cart={routes.cart}
          data-checkout={routes.checkout}
          data-product-base="/san-pham/"
        >
          <div class="home-shop-toolbar">
            <h2 id="san-pham-title" class="sr-only">Mẫu vòng đang nhận đặt</h2>
            <div class="home-shop-sorts" role="group" aria-label="Lọc sản phẩm">
              <a
                class="home-sort-chip"
                href={homeShopPath({
                  category: shopQuery.category,
                  sort: shopQuery.sort === 'ban-chay' ? 'mac-dinh' : 'ban-chay',
                })}
                data-home-filter
                data-sort="ban-chay"
                aria-current={shopQuery.sort === 'ban-chay' ? 'true' : undefined}
              >
                Bán chạy
              </a>
              <a
                class="home-sort-chip"
                href={homeShopPath({
                  category: shopQuery.category,
                  sort: shopQuery.sort === 'giam-gia' ? 'mac-dinh' : 'giam-gia',
                })}
                data-home-filter
                data-sort="giam-gia"
                aria-current={shopQuery.sort === 'giam-gia' ? 'true' : undefined}
              >
                Giảm giá nhiều
              </a>
            </div>
            <p class="home-shop-count" data-home-count>
              {loaded.total === 0
                ? 'Chưa có mẫu'
                : loaded.total === 1
                  ? '1 mẫu'
                  : `${loaded.total} mẫu`}
            </p>
          </div>
          <ul class="home-shop-grid" data-home-grid hidden={loaded.products.length === 0}>
            {loaded.products.map((product, index) => (
              <li>
                <HomeProductCard product={product} eager={index < 2} />
              </li>
            ))}
          </ul>
          <p class="home-empty" data-home-empty hidden={loaded.products.length > 0}>
            Không có mẫu khớp bộ lọc. <a href={homeShopPath({ category: '', sort: shopQuery.sort })}>Xem tất cả mẫu</a>
          </p>
          <div class="home-shop-more" data-home-more-wrap hidden={!shopHasMore}>
            <a
              class="btn btn-soft home-shop-more-btn"
              href={nextCatalogHref}
              data-home-more
              data-next-api={nextApiHref}
            >
              Xem tiếp {CATALOG_PAGE_SIZE} mẫu
            </a>
          </div>
          <OrderDialog />
        </section>
        <script>
          import '../scripts/home-shop';
          import '../scripts/youtube-facade';
        </script>

        <section id="danh-gia" class="home-feedback home-defer" aria-labelledby="danh-gia-title">
          <div class="home-wrap">
            <div class="home-feedback-intro">
              <h2 id="danh-gia-title">
                Niềm tin từ
                <span class="home-script">các mẹ bỉm</span>
              </h2>
              <p class="home-feedback-lead">
                <span class="home-feedback-heart" aria-hidden="true">♥</span>
                Những phản hồi chân thành từ các mẹ đã tin dùng sản phẩm.
              </p>
            </div>
          </div>
          <div class="home-feedback-rail" tabindex="0" aria-label="Ảnh phản hồi từ mẹ — vuốt ngang để xem thêm">
            <ul class="home-feedback-list">
              {FEEDBACK_PHOTOS.map((src, index) => (
                <li class="home-feedback-card">
                  <img
                    src={src}
                    alt={`Ảnh phản hồi từ khách hàng ${index + 1}`}
                    width="600"
                    height="752"
                    loading="lazy"
                    decoding="async"
                    sizes="(min-width: 48rem) 16rem, 72vw"
                  />
                </li>
              ))}
            </ul>
          </div>
          <p class="home-feedback-hint">Vuốt ngang để xem <span aria-hidden="true">≫</span></p>
          <aside class="home-promise" aria-labelledby="loi-cam-ket">
            <span class="home-promise-seal" aria-hidden="true">♥</span>
            <p id="loi-cam-ket" class="home-promise-title">Lời cam kết từ em</p>
            <p class="home-promise-text">
              Em cam kết vòng làm <strong>thủ công</strong>, không hóa chất. Các mẹ nhận hàng cứ kiểm tra thoải mái — ưng thì thanh toán, không ưng trả shiper, <strong>không mất thêm chi phí nào cả</strong>.
            </p>
          </aside>
        </section>

        <section id="faq" class="home-wrap home-section home-defer" aria-labelledby="faq-title">
          <div class="home-section-intro home-faq-intro">
            <h2 id="faq-title">
              Câu hỏi
              <span class="home-script">mẹ thường hỏi</span>
            </h2>
            <div class="home-faq-divider" aria-hidden="true">
              <span>♥</span>
            </div>
            <p>Những thắc mắc phổ biến nhất từ các mẹ về vòng dâu tằm</p>
          </div>
          <div class="home-faq">
            {FAQ_ITEMS.map((item) => (
              <details class="home-faq-item">
                <summary>{item.q}</summary>
                <p>{item.a}</p>
              </details>
            ))}
          </div>
        </section>

        <div class="home-fab" role="navigation" aria-label="Liên hệ nhanh">
          <a class="home-fab-btn home-fab-top" href="#noi-dung" aria-label="Lên đầu trang">↑</a>
          {(site.zaloUrl || site.facebookUrl) && (
            <a
              class="home-fab-btn home-fab-chat"
              href={site.zaloUrl || site.facebookUrl}
              rel="noopener"
              target="_blank"
              aria-label={site.zaloUrl ? 'Chat Zalo' : 'Chat Facebook'}
            >
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 8.511c.884.284 1.5 1.128 1.5 2.097v4.286c0 1.136-.847 2.1-1.98 2.193-.34.027-.68.052-1.02.072v3.091l-3-3c-1.354 0-2.694-.055-4.02-.163a2.115 2.115 0 0 1-.825-.242m9.345-8.334a2.126 2.126 0 0 0-.476-.095 48.64 48.64 0 0 0-8.048 0c-1.131.094-1.976 1.057-1.976 2.192v4.286c0 .837.46 1.58 1.155 1.951m9.345-8.334V6.637c0-1.621-1.152-3.026-2.76-3.235A48.455 48.455 0 0 0 11.25 3c-2.115 0-4.198.137-6.24.402-1.608.209-2.76 1.614-2.76 3.235v6.226c0 1.621 1.152 3.026 2.76 3.235.577.075 1.157.14 1.74.194V21l4.155-4.155" />
              </svg>
            </a>
          )}
        </div>
      </main>
    ) : (
      <DataError failed={loaded.failed} />
    )
  }
</PublicLayout>
