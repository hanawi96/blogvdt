---
import DataError from '../../components/public/DataError.astro';
import NotFound from '../../components/public/NotFound.astro';
import Pagination from '../../components/public/Pagination.astro';
import PostCard from '../../components/public/PostCard.astro';
import { getPublicTagBySlug, listPublishedPosts, parseListPage } from '../../features/posts/public';
import { redirectHttpResponse } from '../../features/redirects/http';
import { resolvePublicRedirect } from '../../features/redirects/lookup';
import { getPublicSite } from '../../features/settings/settings';
import PublicLayout from '../../layouts/PublicLayout.astro';
import { createDb } from '../../lib/db/client';
import { applyCoverMeasure } from '../../features/media/media';
import { getDbBinding, getSiteOrigin, optionalMediaBucket } from '../../lib/cloudflare/env';
import { buildMeta, notFoundMeta, tagPageMeta, unavailableMeta } from '../../lib/seo/meta';
import { blogReadStatus, FRESH_PAGE_CACHE, PRIVATE_PAGE_CACHE } from '../../lib/seo/cache';
import { routes } from '../../lib/routes';

const slug = Astro.params.slug ?? '';
const requestedPage = parseListPage(Astro.url.searchParams.get('page'));
const page = requestedPage ?? 1;
const loaded = await loadTag();
if (loaded.http) return loaded.http;
const missing = Boolean(loaded.site) && !loaded.tag;
const outOfRange = requestedPage === null || (Boolean(loaded.tag) && requestedPage > loaded.pageCount);
const status = blogReadStatus({ hasSite: Boolean(loaded.site), failed: loaded.failed, notFound: missing || outOfRange });
if (status !== 200) {
  Astro.response.status = status;
  Astro.response.headers.set('X-Robots-Tag', 'noindex');
}
Astro.response.headers.set('Cache-Control', status === 200 ? FRESH_PAGE_CACHE : PRIVATE_PAGE_CACHE);

const tagPath = routes.tag(loaded.tag?.slug || slug);
const path = loaded.tag && page > 1 ? `${tagPath}?page=${page}` : tagPath;
const pageMeta = !loaded.site ? unavailableMeta() : !loaded.tag || outOfRange ? notFoundMeta() : tagPageMeta(loaded.tag, loaded.site.siteName, page);
const leadCover = loaded.posts.findIndex((post) => post.coverUrl);
const allowIndex = Boolean(loaded.tag && !outOfRange && loaded.tag.robots === 'index');
const meta = buildMeta(getSiteOrigin(Astro.url.origin), {
  title: pageMeta.title,
  description: pageMeta.description,
  path,
  siteName: loaded.site?.siteName,
  robots: allowIndex ? 'index,follow' : 'noindex,follow',
});
if (loaded.tag && !outOfRange && !allowIndex) {
  Astro.response.headers.set('X-Robots-Tag', 'noindex, follow');
}

async function loadTag() {
  try {
    const db = createDb(getDbBinding());
    const site = await getPublicSite(db);
    if (!site) return { site: null, failed: false, tag: null, posts: [], total: 0, pageCount: 1, http: null };
    const tag = await getPublicTagBySlug(db, slug);
    if (!tag) {
      const outcome = await resolvePublicRedirect(db, routes.tag(slug));
      return {
        site,
        failed: false,
        tag: null,
        posts: [],
        total: 0,
        pageCount: 1,
        http: outcome ? redirectHttpResponse(outcome) : null,
      };
    }
    const list = await listPublishedPosts(db, { page, tagId: tag.id });
    return {
      site,
      failed: false,
      tag,
      posts: await applyCoverMeasure(optionalMediaBucket(), list.posts),
      total: list.total,
      pageCount: list.pageCount,
      http: null,
    };
  } catch (error) {
    console.error(JSON.stringify({ event: 'tag_public_failed', name: error instanceof Error ? error.name : 'unknown' }));
    return { site: null, failed: true, tag: null, posts: [], total: 0, pageCount: 1, http: null };
  }
}
---

<PublicLayout
  title={meta.title}
  description={meta.description}
  canonical={loaded.tag && !outOfRange ? meta.canonical : undefined}
  robots={meta.robots}
  siteName={meta.siteName}
  faviconUrl={loaded.site?.faviconUrl || '/favicon.svg'}
  chrome={loaded.site}
>
  {
    !loaded.site ? (
      <DataError failed={loaded.failed} />
    ) : missing || outOfRange || !loaded.tag ? (
      <NotFound />
    ) : (
      <main class="mx-auto max-w-5xl px-4 py-10">
        <p class="text-sm font-semibold uppercase tracking-wide text-muted">Thẻ</p>
        <h1 class="mt-2 text-3xl font-semibold">{loaded.tag.name}</h1>
        {loaded.tag.description && <p class="mt-3 max-w-2xl text-muted">{loaded.tag.description}</p>}
        <p class="mt-4 text-sm text-muted">
          {loaded.total === 1 ? '1 bài viết' : `${loaded.total} bài viết`}
        </p>
        <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {loaded.posts.map((post, index) => (
            <li><PostCard post={post} eager={index === leadCover} /></li>
          ))}
        </ul>
        <Pagination
          page={page}
          pageCount={loaded.pageCount}
          hrefFor={(next) => (next > 1 ? `${routes.tag(slug)}?page=${next}` : routes.tag(slug))}
        />
      </main>
    )
  }
</PublicLayout>
