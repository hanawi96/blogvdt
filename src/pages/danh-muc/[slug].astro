---
import BlogSidebar from '../../components/public/BlogSidebar.astro';
import DataError from '../../components/public/DataError.astro';
import NotFound from '../../components/public/NotFound.astro';
import Pagination from '../../components/public/Pagination.astro';
import PostCard from '../../components/public/PostCard.astro';
import { getCategoryBySlug, listPublicCategories, listPublishedPosts, listRecentPublishedPosts, parseListPage } from '../../features/posts/public';
import { listBestSellers } from '../../features/products/catalog';
import { redirectHttpResponse } from '../../features/redirects/http';
import { resolvePublicRedirect } from '../../features/redirects/lookup';
import { getPublicSite } from '../../features/settings/settings';
import PublicLayout from '../../layouts/PublicLayout.astro';
import { createDb } from '../../lib/db/client';
import { applyCoverMeasure } from '../../features/media/media';
import { getDbBinding, getSiteOrigin, optionalMediaBucket } from '../../lib/cloudflare/env';
import { buildMeta, canonicalUrl, categoryPageMeta, notFoundMeta, unavailableMeta } from '../../lib/seo/meta';
import { blogReadStatus, FRESH_PAGE_CACHE, PRIVATE_PAGE_CACHE } from '../../lib/seo/cache';
import { routes } from '../../lib/routes';

const slug = Astro.params.slug ?? '';
const requestedPage = parseListPage(Astro.url.searchParams.get('page'));
const page = requestedPage ?? 1;
const loaded = await loadCategory();
if (loaded.http) return loaded.http;
const missing = Boolean(loaded.site) && !loaded.category;
const outOfRange = requestedPage === null || (Boolean(loaded.category) && requestedPage > loaded.pageCount);
const status = blogReadStatus({ hasSite: Boolean(loaded.site), failed: loaded.failed, notFound: missing || outOfRange });
if (status !== 200) {
  Astro.response.status = status;
  Astro.response.headers.set('X-Robots-Tag', 'noindex');
}
Astro.response.headers.set('Cache-Control', status === 200 ? FRESH_PAGE_CACHE : PRIVATE_PAGE_CACHE);

const categoryPath = routes.knowledgeCategory(loaded.category?.slug || slug);
const listPath = (next: number) => (next > 1 ? `${categoryPath}?page=${next}` : categoryPath);
const path = listPath(page);
const pageMeta = !loaded.site ? unavailableMeta() : !loaded.category || outOfRange ? notFoundMeta() : categoryPageMeta(loaded.category, loaded.site.siteName, page);
const leadCover = loaded.posts.findIndex((post) => post.coverUrl);
const origin = getSiteOrigin(Astro.url.origin);
const meta = buildMeta(origin, {
  title: pageMeta.title,
  description: pageMeta.description,
  path,
  siteName: loaded.site?.siteName,
  robots: loaded.category && !outOfRange ? 'index,follow' : 'noindex,nofollow',
});
const canIndex = Boolean(loaded.category) && !outOfRange;
const prevUrl = canIndex && page > 1 ? canonicalUrl(origin, listPath(page - 1)) || null : null;
const nextUrl = canIndex && page < loaded.pageCount ? canonicalUrl(origin, listPath(page + 1)) || null : null;

async function loadCategory() {
  try {
    const db = createDb(getDbBinding());
    const site = await getPublicSite(db);
    if (!site) return { site: null, failed: false, category: null, posts: [], categories: [], recent: [], bestsellers: [], total: 0, pageCount: 1, http: null };
    const category = await getCategoryBySlug(db, slug);
    if (!category) {
      const outcome = await resolvePublicRedirect(db, routes.knowledgeCategory(slug));
      return {
        site,
        failed: false,
        category: null,
        posts: [],
        categories: [],
        recent: [],
        bestsellers: [],
        total: 0,
        pageCount: 1,
        http: outcome ? redirectHttpResponse(outcome) : null,
      };
    }
    const [list, categories, recent, bestsellers] = await Promise.all([
      listPublishedPosts(db, { page, categoryId: category.id }),
      listPublicCategories(db),
      listRecentPublishedPosts(db, 5),
      listBestSellers(db, 5),
    ]);
    return { site, failed: false, category, posts: await applyCoverMeasure(optionalMediaBucket(), list.posts), categories, recent, bestsellers, total: list.total, pageCount: list.pageCount, http: null };
  } catch (error) {
    console.error(JSON.stringify({ event: 'category_public_failed', name: error instanceof Error ? error.name : 'unknown' }));
    return { site: null, failed: true, category: null, posts: [], categories: [], recent: [], bestsellers: [], total: 0, pageCount: 1, http: null };
  }
}
---

<PublicLayout
  title={meta.title}
  description={meta.description}
  canonical={loaded.category && !outOfRange ? meta.canonical : undefined}
  prevUrl={prevUrl}
  nextUrl={nextUrl}
  robots={meta.robots}
  siteName={meta.siteName}
  faviconUrl={loaded.site?.faviconUrl || '/favicon.svg'}
  chrome={loaded.site}
>
  {
    !loaded.site ? (
      <DataError failed={loaded.failed} />
    ) : missing || outOfRange || !loaded.category ? (
      <NotFound />
    ) : (
      <>
        <section class="blog-hero">
          <div class="blog-hero-in">
            <h1 class="blog-hero-title">{loaded.category.name}</h1>
            {loaded.category.description && <p class="blog-hero-lead">{loaded.category.description}</p>}
          </div>
        </section>
        <main class="blog-wrap">
          <nav class="blog-filter" aria-label="Danh mục">
            <a class="blog-filter-chip" href={routes.knowledgeList}>Tất cả</a>
            {loaded.categories.map((category) => (
              <a
                class:list={['blog-filter-chip', category.slug === loaded.category?.slug && 'is-active']}
                href={routes.knowledgeCategory(category.slug)}
                aria-current={category.slug === loaded.category?.slug ? 'page' : undefined}
              >
                {category.name}
              </a>
            ))}
          </nav>
          <div class="blog-columns">
            <div class="blog-main">
              {loaded.posts.length === 0 ? (
                <p class="text-muted">Danh mục này chưa có bài viết.</p>
              ) : (
                <ul class="blog-grid">
                  {loaded.posts.map((post, index) => (
                    <li><PostCard post={post} eager={index === leadCover} /></li>
                  ))}
                </ul>
              )}
              <Pagination
                page={page}
                pageCount={loaded.pageCount}
                hrefFor={(next) => (next > 1 ? `${routes.knowledgeCategory(slug)}?page=${next}` : routes.knowledgeCategory(slug))}
              />
            </div>
            <BlogSidebar recent={loaded.recent} site={loaded.site} bestsellers={loaded.bestsellers} />
          </div>
        </main>
      </>
    )
  }
</PublicLayout>
