---
import AddressField from '../components/public/AddressField.astro';
import DataError from '../components/public/DataError.astro';
import DiscountCodeField from '../components/public/DiscountCodeField.astro';
import PaymentField from '../components/public/PaymentField.astro';
import { addCartLine, CART_COOKIE, CART_MAX_QUANTITY, cartCookieOptions, parseCart, postedCartLines, serializeCart, type CartLine } from '../features/cart/cart';
import { applyDiscount, type DiscountQuote } from '../features/discounts/quote';
import { priceDiscount } from '../features/discounts/discounts';
import { listOrderCosts } from '../features/costs/order-costs';
import { parseCartOrder, type CatalogProduct } from '../features/orders/order';
import { placeCartOrder, placeOrder } from '../features/orders/orders';
import { listOrderCatalog } from '../features/products/public';
import { applyWeightPrice, isValidWeight, requiresWeight, weightSurchargeLabel } from '../features/products/weight';
import { getPublicSite } from '../features/settings/settings';
import { baseCustomerShippingFee, resolveCustomerShippingFee, shipGroupOf } from '../features/shipping/customer-fee';
import PublicLayout from '../layouts/PublicLayout.astro';
import { createDb } from '../lib/db/client';
import { getDbBinding } from '../lib/cloudflare/env';
import { clientIp, hashIp, isSameOrigin } from '../lib/http';
import { formatVnd } from '../lib/money';
import { routes } from '../lib/routes';
import type { FieldErrors } from '../lib/validation/errors';

const secure = Astro.url.protocol === 'https:';
const loaded = await loadCart();
let lines = parseCart(Astro.cookies.get(CART_COOKIE)?.value);
let formError = '';
let errors: FieldErrors = {};
const values = { customerName: '', phone: '', address: '', provinceCode: '', wardCode: '', addressLine: '', note: '', paymentMethod: '', discountCode: '' };
let quote: DiscountQuote | null = null;
Astro.response.headers.set('Cache-Control', 'private, no-store');
const shipBaseFee = loaded.db ? baseCustomerShippingFee(await listOrderCosts(loaded.db)) : 0;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const read = (name: string) => {
    const value = form.get(name);
    return typeof value === 'string' ? value : '';
  };
  const intent = read('intent');
  const wantsJson = Astro.request.headers.get('accept')?.includes('application/json') ?? false;
  const discountJson = (status: number, body: { ok: true; quote: DiscountQuote } | { ok: false; error: string }) =>
    new Response(JSON.stringify(body), {
      status,
      headers: { 'content-type': 'application/json; charset=utf-8', 'cache-control': 'private, no-store' },
    });
  values.customerName = read('customerName');
  values.phone = read('phone');
  values.address = read('address');
  values.provinceCode = read('provinceCode');
  values.wardCode = read('wardCode');
  values.addressLine = read('addressLine');
  values.note = read('note');
  values.paymentMethod = read('paymentMethod');
  values.discountCode = read('discountCode');
  if (!loaded.site) {
    Astro.response.status = 503;
  } else if (!isSameOrigin(Astro.request)) {
    Astro.response.status = 403;
    formError = 'Nguồn gửi không hợp lệ.';
  } else if (intent === 'add') {
    const added = addCartLine(lines, { slug: read('slug'), quantity: Number(read('quantity') || '1'), weight: read('weight') });
    const product = loaded.catalog.find((item) => item.slug === read('slug'));
    if (!added.ok) formError = added.error;
    else if (!product) formError = 'Sản phẩm không còn bán.';
    else if (requiresWeight(product.weightScale) && !read('weight').trim()) formError = 'Chọn cân nặng cho bé.';
    else if (!isValidWeight(product.weightScale, read('weight'))) formError = 'Cân nặng không hợp lệ.';
    else {
      remember(added.lines);
      return Astro.redirect(routes.cart, 303);
    }
  } else if (intent === 'save' || intent.startsWith('remove:')) {
    const posted = linesFrom(form, intent);
    if (!posted.ok) formError = posted.error;
    else {
      remember(posted.lines.filter((line) => loaded.catalog.some((item) => item.slug === line.slug)));
      return Astro.redirect(routes.cart, 303);
    }
  } else if (intent === 'apply') {
    const posted = linesFrom(form, intent);
    const fail = (status: number, error: string, field = false) => {
      if (wantsJson) return discountJson(status, { ok: false, error });
      Astro.response.status = status;
      if (field) errors = { discountCode: error };
      else formError = error;
      return null;
    };
    if (!posted.ok) {
      const denied = fail(422, posted.error);
      if (denied) return denied;
    } else if (read('company').trim()) {
      const denied = fail(403, 'Không gửi được đơn.');
      if (denied) return denied;
    } else {
      lines = posted.lines;
      const subtotal = merchandiseTotal(posted.lines, loaded.catalog);
      if (subtotal === null) {
        const denied = fail(422, posted.lines.length === 0 ? 'Giỏ đang trống.' : 'Một mẫu trong giỏ không còn bán.');
        if (denied) return denied;
      } else if (!loaded.db) {
        const denied = fail(503, 'Chưa kiểm được mã. Thử lại sau.');
        if (denied) return denied;
      } else {
        const priced = await priceDiscount(loaded.db, subtotal, values.discountCode, await visitorHash(), Date.now(), true);
        if (!priced.ok) {
          const denied = fail(422, priced.error, true);
          if (denied) return denied;
        } else if (priced.discount) {
          quote = priced.discount;
          if (wantsJson) return discountJson(200, { ok: true, quote: priced.discount });
        } else {
          const denied = fail(422, 'Nhập mã giảm giá.', true);
          if (denied) return denied;
        }
      }
    }
  } else if (intent === 'order') {
    const posted = linesFrom(form, intent);
    if (!posted.ok) {
      Astro.response.status = 422;
      formError = posted.error;
    } else {
      lines = posted.lines;
      const parsed = parseCartOrder({ ...values, company: read('company'), lines }, loaded.catalog);
      if (!parsed.ok) {
        Astro.response.status = parsed.blocked ? 403 : 422;
        formError = parsed.blocked ? 'Không gửi được đơn.' : '';
        errors = parsed.errors;
      } else if (!loaded.db) {
        Astro.response.status = 503;
        formError = 'Chưa lưu được đơn. Thử lại sau.';
      } else {
        try {
          const ipHash = await visitorHash();
          const base = parsed.single ?? parsed.cart;
          const priced = base ? await priceDiscount(loaded.db, base.subtotal, values.discountCode, ipHash) : { ok: true as const, discount: null };
          if (!priced.ok) {
            Astro.response.status = 422;
            errors = { discountCode: priced.error };
          } else {
            const saved = parsed.single
              ? await placeOrder(loaded.db, { ...parsed.single, ...applyDiscount(parsed.single.subtotal, priced.discount) }, ipHash)
              : parsed.cart
                ? await placeCartOrder(loaded.db, { ...parsed.cart, ...applyDiscount(parsed.cart.subtotal, priced.discount) }, ipHash)
                : { ok: false as const, status: 422 as const, error: 'Giỏ đang trống.' };
            if (!saved.ok) {
              Astro.response.status = saved.status;
              formError = saved.error;
            } else {
              Astro.cookies.set(CART_COOKIE, '', cartCookieOptions(secure, 0));
              const response = Astro.redirect(`${routes.checkoutSuccess}?ma=${saved.code}`, 303);
              response.headers.set('Cache-Control', 'private, no-store');
              return response;
            }
          }
        } catch (error) {
          Astro.response.status = 503;
          formError = 'Chưa lưu được đơn. Thử lại sau.';
          console.error(JSON.stringify({ event: 'cart_order_failed', name: error instanceof Error ? error.name : 'unknown' }));
        }
      }
    }
  } else {
    Astro.response.status = 422;
    formError = 'Thao tác không hợp lệ.';
  }
}

const resolved = lines.flatMap((line) => {
  const product = loaded.catalog.find((item) => item.slug === line.slug);
  if (!product) return [];
  // Đơn giá đã gồm phụ thu cân nặng (vòng to hơn cần thêm nguyên liệu).
  const unitPrice = applyWeightPrice(product.price, line.weight);
  return [
    {
      ...line,
      name: product.name,
      price: unitPrice,
      basePrice: product.price,
      surcharge: weightSurchargeLabel(line.weight, product.price),
      coverUrl: product.coverUrl,
      coverAlt: product.coverAlt,
      categorySlug: product.categorySlug ?? '',
      shipGroup: shipGroupOf(product.categorySlug),
      lineTotal: unitPrice * line.quantity,
    },
  ];
});
const dropped = resolved.length !== lines.length;
if (dropped && Astro.request.method === 'GET') remember(resolved.map(({ slug, quantity, weight }) => ({ slug, quantity, weight })));
const total = resolved.reduce((sum, line) => sum + line.lineTotal, 0);
const pieces = resolved.reduce((sum, line) => sum + line.quantity, 0);
const goodsPayable = quote?.totalPrice ?? total;
const shipping = resolveCustomerShippingFee({
  lines: resolved.map((line) => ({ group: line.shipGroup, lineTotal: line.lineTotal })),
  baseFee: shipBaseFee,
});
const payable = goodsPayable + shipping.fee;

function linesFrom(form: FormData, intent: string): { ok: true; lines: CartLine[] } | { ok: false; error: string } {
  const slugs = strings(form, 'slug');
  const quantities = strings(form, 'quantity');
  const weights = strings(form, 'weight');
  if (intent.startsWith('remove:')) {
    const index = Number(intent.slice('remove:'.length));
    if (!Number.isInteger(index) || index < 0 || index >= slugs.length) return { ok: false, error: 'Không xóa được mẫu này.' };
    slugs.splice(index, 1);
    quantities.splice(index, 1);
    weights.splice(index, 1);
  }
  return postedCartLines(slugs, quantities, weights);
}

function strings(form: FormData, name: string): string[] {
  return form.getAll(name).flatMap((value) => (typeof value === 'string' ? [value] : []));
}

function remember(next: CartLine[]) {
  Astro.cookies.set(CART_COOKIE, next.length ? serializeCart(next) : '', cartCookieOptions(secure, next.length ? undefined : 0));
}

function merchandiseTotal(cartLines: CartLine[], catalog: CatalogProduct[]): number | null {
  if (cartLines.length === 0) return null;
  let total = 0;
  for (const line of cartLines) {
    const product = catalog.find((item) => item.slug === line.slug);
    if (!product || !Number.isInteger(line.quantity) || line.quantity < 1) return null;
    total += applyWeightPrice(product.price, line.weight) * line.quantity;
  }
  return total;
}

async function visitorHash(): Promise<string> {
  let address: string | null = null;
  try {
    address = Astro.clientAddress;
  } catch {
    address = null;
  }
  return hashIp(clientIp(Astro.request, address));
}

async function loadCart() {
  try {
    const db = createDb(getDbBinding());
    const site = await getPublicSite(db);
    if (!site) return { site: null, failed: false, catalog: [], db: null };
    return { site, failed: false, catalog: await listOrderCatalog(db), db };
  } catch (error) {
    console.error(JSON.stringify({ event: 'cart_load_failed', name: error instanceof Error ? error.name : 'unknown' }));
    return { site: null, failed: true, catalog: [], db: null };
  }
}
---

<PublicLayout
  title={loaded.site ? `Giỏ hàng | ${loaded.site.siteName}` : 'Chưa sẵn sàng'}
  description="Gom nhiều mẫu vòng rồi gửi một lần. Website không thu tiền trực tuyến."
  robots="noindex,nofollow"
  siteName={loaded.site?.siteName}
  faviconUrl={loaded.site?.faviconUrl || '/favicon.svg'}
  chrome={loaded.site}
>
  {
    !loaded.site ? (
      <DataError failed={loaded.failed} />
    ) : (
      <main class="mx-auto max-w-2xl px-4 py-8 sm:py-10">
        <h1 class="text-3xl font-semibold">Giỏ hàng</h1>
        {resolved.length > 0 && (
          <p class="mt-2 text-muted">
            <span data-cart-sum-lines>{resolved.length} mẫu</span> · <span data-cart-sum-count>{pieces}</span> chiếc
          </p>
        )}
        {dropped && <p class="mt-3 text-muted">Đã bỏ mẫu không còn bán.</p>}
        {formError && <p class="error-text mt-3" role="alert">{formError}</p>}
        {errors.cart && <p class="error-text mt-3" role="alert">{errors.cart}</p>}
        {resolved.length === 0 ? (
          <section class="cart-empty">
            <svg class="cart-empty-art" viewBox="0 0 200 150" role="img" aria-label="Giỏ hàng trống với trái tim" xmlns="http://www.w3.org/2000/svg">
              <ellipse cx="100" cy="120" rx="78" ry="12" fill="#f6dfe3" />
              <circle cx="100" cy="66" r="52" fill="#fbeef0" />
              <g fill="none" stroke="#e79aa9" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M60 58h66l-7 34H67z" fill="#fdf1f3" />
                <path d="M60 58l-5-14h-9" />
                <path d="M72 58l6-14h30l6 14" fill="#fde7eb" />
              </g>
              <path d="M93 66c0-4 7-4 7 1 0-5 7-5 7-1 0 5-7 9-7 9s-7-4-7-9z" fill="#f08ea0" />
              <g fill="none" stroke="#e79aa9" stroke-width="3.2" stroke-linecap="round">
                <path d="M67 92l-3 10h58l-3-10" />
              </g>
              <circle cx="74" cy="110" r="6" fill="#fff" stroke="#e79aa9" stroke-width="3.2" />
              <circle cx="118" cy="110" r="6" fill="#fff" stroke="#e79aa9" stroke-width="3.2" />
              <path d="M138 40c0-3 5-3 5 1 0-4 5-4 5 0 0 4-5 7-5 7s-5-3-5-8z" fill="#f4a9b6" />
              <path d="M44 74c6-2 10-7 10-7M48 86c5 1 10-1 10-1" stroke="#b7d8b0" stroke-width="3" stroke-linecap="round" fill="none" />
            </svg>
            <h2 class="cart-empty-title">Giỏ hàng của bạn đang trống</h2>
            <p class="cart-empty-text">Bạn chưa chọn mẫu vòng nào. Ghé xem các mẫu vòng dâu tằm thủ công, gom lại rồi gửi đơn một lần nhé.</p>
            <div class="cart-empty-actions">
              <a class="btn btn-accent cart-empty-btn" href={routes.catalog}>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M6 7h12l1 13H5L6 7z" />
                  <path d="M9 7a3 3 0 0 1 6 0" />
                </svg>
                Xem mẫu vòng
              </a>
              <a class="btn cart-empty-btn" href={routes.home}>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M20 12l-8 8-8-8a4 4 0 0 1 8-3 4 4 0 0 1 8 3z" />
                </svg>
                Về trang chủ
              </a>
            </div>
          </section>
        ) : (
          <form class="cart-layout" method="post" action={routes.cart} data-cart-page>
            <button class="sr-only" type="submit" data-cart-noop tabindex="-1" aria-hidden="true">Giỏ hàng</button>
            <section class="cart-card" aria-labelledby="cart-items-title">
              <h2 id="cart-items-title" class="cart-card-title text-lg font-semibold">Mẫu vòng đã chọn</h2>
              <ul class="cart-list">
                {resolved.map((line, index) => (
                  <li class="cart-item" data-cart-item data-price={line.price} data-ship-group={line.shipGroup}>
                    {line.coverUrl ? (
                      <img class="cart-thumb" src={line.coverUrl} alt={line.coverAlt || line.name} width="80" height="80" loading="lazy" />
                    ) : (
                      <span class="cart-thumb" aria-hidden="true"></span>
                    )}
                    <div class="cart-body">
                      <a class="cart-name" href={routes.product(line.slug)}>{line.name}</a>
                      <p class="cart-price">{formatVnd(line.price)}</p>
                      <input type="hidden" name="slug" value={line.slug} />
                      <input type="hidden" name="weight" value={line.weight} />
                      {line.weight && (
                        <p class="cart-meta">
                          <span class="cart-tag">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                              <path d="M12 3a2 2 0 0 0-2 2H6l-3 11a4 4 0 0 0 8 0L8 5" />
                              <path d="M16 5h2l3 11a4 4 0 0 1-8 0l3-11h-4" />
                            </svg>
                            Cân nặng: {line.weight}
                          </span>
                          {line.surcharge && <span class="cart-surcharge">Vòng lớn {line.surcharge} nguyên liệu</span>}
                        </p>
                      )}
                      {errors[`weight${index}`] && <p class="error-text mt-1">{errors[`weight${index}`]}</p>}
                      <button class="cart-remove" type="submit" name="intent" value={`remove:${index}`} formnovalidate>
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <path d="M4 7h16" />
                          <path d="M10 11v6M14 11v6" />
                          <path d="M6 7l1 13h10l1-13" />
                          <path d="M9 7V5a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2" />
                        </svg>
                        Xóa
                      </button>
                    </div>
                    <div class="cart-row">
                      <div class="qty">
                        <button class="qty-btn" type="button" data-qty-step="-1" aria-label={`Giảm số lượng ${line.name}`} hidden>−</button>
                        <input
                          class="qty-input"
                          name="quantity"
                          type="number"
                          inputmode="numeric"
                          min="1"
                          max={CART_MAX_QUANTITY}
                          required
                          value={line.quantity}
                          aria-label={`Số lượng ${line.name}`}
                        />
                        <button class="qty-btn" type="button" data-qty-step="1" aria-label={`Tăng số lượng ${line.name}`} hidden>+</button>
                      </div>
                      <p class="cart-line-total" data-line-total>{formatVnd(line.lineTotal)}</p>
                    </div>
                    {errors[`quantity${index}`] && <p class="error-text cart-row-error">{errors[`quantity${index}`]}</p>}
                  </li>
                ))}
              </ul>
              <div class="cart-tools">
                <a href={routes.catalog}>← Xem thêm mẫu</a>
              </div>
            </section>
            <section class="cart-card cart-checkout" aria-labelledby="cart-checkout-title">
              <h2 id="cart-checkout-title" class="cart-card-title text-lg font-semibold">Thông tin nhận hàng</h2>
            <div class="absolute -left-[9999px]" aria-hidden="true">
              <label for="company">Công ty</label>
              <input id="company" name="company" tabindex="-1" autocomplete="off" />
            </div>
            <div class="form-pair mt-4">
              <label class="block" for="customer-name">
                <span class="mb-1 block font-semibold">Họ tên</span>
                <input id="customer-name" class="field" name="customerName" required maxlength="80" autocomplete="name" value={values.customerName} />
                {errors.customerName && <span class="error-text">{errors.customerName}</span>}
              </label>
              <label class="block" for="phone">
                <span class="mb-1 block font-semibold">Số điện thoại</span>
                <input id="phone" class="field" name="phone" type="tel" required maxlength="20" autocomplete="tel" value={values.phone} />
                {errors.phone && <span class="error-text">{errors.phone}</span>}
              </label>
            </div>
            <AddressField
              idPrefix="cart-address"
              error={errors.address}
              address={values.address}
              provinceCode={values.provinceCode}
              wardCode={values.wardCode}
              line={values.addressLine}
              paired
            />
            <label class="mt-4 block" for="note">
              <span class="mb-1 block font-semibold">Ghi chú</span>
              <textarea id="note" class="field min-h-20" name="note" maxlength="500">{values.note}</textarea>
              {errors.note && <span class="error-text">{errors.note}</span>}
            </label>
            <PaymentField value={values.paymentMethod} error={errors.paymentMethod} />
            <DiscountCodeField id="cart-discount" value={values.discountCode} error={errors.discountCode} quote={quote} />
            <div class="cart-sum-stack" data-cart-ship data-ship-base={shipBaseFee} data-ship-goods={goodsPayable}>
              <div class="cart-sum">
                <span>Tạm tính</span>
                <strong data-cart-goods>{formatVnd(total)}</strong>
              </div>
              {quote && quote.discountAmount > 0 && (
                <div class="cart-sum cart-sum-muted">
                  <span>Giảm giá</span>
                  <strong>−{formatVnd(quote.discountAmount)}</strong>
                </div>
              )}
              <div class="cart-sum cart-sum-muted">
                <span data-cart-ship-label>{shipping.free ? 'Phí vận chuyển' : 'Phí vận chuyển'}</span>
                <strong data-cart-ship-fee>{shipping.free ? 'Miễn phí' : formatVnd(shipping.fee)}</strong>
              </div>
              <div class="cart-sum">
                <span data-cart-sum-label>Phải trả</span>
                <strong data-cart-total data-payable-amount={payable}>{formatVnd(payable)}</strong>
              </div>
            </div>
            <p class="cart-sum-note">Nhận hàng kiểm tra hàng thoải mái, ưng ý thì mới thanh toán.</p>
            <button class="btn btn-accent mt-4 w-full" type="submit" name="intent" value="order">Gửi đơn</button>
            </section>
          </form>
        )}
      </main>
    )
  }
</PublicLayout>
<script>
  import { CART_COOKIE, CART_MAX_AGE, cartCount, postedCartLines, serializeCart, type CartLine } from '../features/cart/cart';
  import { resolveCustomerShippingFee, type ShipGroup } from '../features/shipping/customer-fee';

  const form = document.querySelector('form[data-cart-page]');
  if (form instanceof HTMLFormElement) {
    const money = new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND', maximumFractionDigits: 0 });
    const shipRoot = form.querySelector('[data-cart-ship]');
    const shipBase = shipRoot instanceof HTMLElement ? Number(shipRoot.dataset.shipBase || '0') : 0;

    // Tính lại tiền từng dòng, phí ship và tổng ngay khi đổi số lượng (server vẫn tính lại khi gửi).
    const recalc = (goodsPayable?: number) => {
      let total = 0;
      let pieces = 0;
      const shipLines: { group: ShipGroup; lineTotal: number }[] = [];
      form.querySelectorAll<HTMLElement>('[data-cart-item]').forEach((item) => {
        const input = item.querySelector('input[name="quantity"]');
        if (!(input instanceof HTMLInputElement)) return;
        const price = Number(item.dataset.price);
        const quantity = Number(input.value);
        if (!Number.isInteger(quantity) || quantity < 1 || quantity > (Number(input.max) || 20)) return;
        const lineTotal = price * quantity;
        total += lineTotal;
        pieces += quantity;
        const group = (item.dataset.shipGroup || 'other') as ShipGroup;
        shipLines.push({ group, lineTotal });
        const out = item.querySelector('[data-line-total]');
        if (out) out.textContent = money.format(lineTotal);
      });
      const shipping = resolveCustomerShippingFee({ lines: shipLines, baseFee: shipBase });
      const payableGoods = typeof goodsPayable === 'number' && Number.isFinite(goodsPayable) ? goodsPayable : total;
      if (shipRoot instanceof HTMLElement) shipRoot.dataset.shipGoods = String(payableGoods);
      const goodsOut = form.querySelector('[data-cart-goods]');
      if (goodsOut) goodsOut.textContent = money.format(total);
      const shipFeeOut = form.querySelector('[data-cart-ship-fee]');
      if (shipFeeOut) shipFeeOut.textContent = shipping.free ? 'Miễn phí' : money.format(shipping.fee);
      const totalOut = form.querySelector('[data-cart-total]');
      if (totalOut instanceof HTMLElement) {
        totalOut.textContent = money.format(payableGoods + shipping.fee);
        totalOut.dataset.payableAmount = String(payableGoods + shipping.fee);
      }
      const countOut = document.querySelector('[data-cart-sum-count]');
      if (countOut) countOut.textContent = String(pieces);
    };

    form.querySelectorAll<HTMLButtonElement>('[data-qty-step]').forEach((button) => {
      button.hidden = false;
      button.addEventListener('click', () => {
        const input = button.closest('.qty')?.querySelector('input[name="quantity"]');
        if (!(input instanceof HTMLInputElement)) return;
        const max = Number(input.max) || 20;
        const next = (Number.isInteger(Number(input.value)) ? Number(input.value) : 1) + Number(button.dataset.qtyStep);
        input.value = String(Math.min(max, Math.max(1, next)));
        recalc();
        markQuoteStale();
        persist();
      });
    });
    const store = (lines: CartLine[]) => {
      const secure = location.protocol === 'https:' ? '; Secure' : '';
      const maxAge = lines.length === 0 ? 0 : CART_MAX_AGE;
      const value = lines.length === 0 ? '' : encodeURIComponent(serializeCart(lines));
      document.cookie = `${CART_COOKIE}=${value}; Path=/; Max-Age=${maxAge}; SameSite=Lax${secure}`;
      const count = cartCount(lines);
      const label = count > 0 ? `Giỏ hàng, ${count} chiếc` : 'Giỏ hàng';
      document.querySelectorAll('[data-cart-count], [data-cart-count-mobile]').forEach((node) => {
        if (!(node instanceof HTMLElement)) return;
        node.hidden = count < 1;
        node.textContent = count > 0 ? String(count) : '';
      });
      document.querySelectorAll('[data-cart-link], [data-cart-link-mobile]').forEach((node) => {
        if (node instanceof HTMLAnchorElement) node.setAttribute('aria-label', label);
      });
    };
    const persist = () => {
      const slugs = [...form.querySelectorAll<HTMLInputElement>('input[name="slug"]')].map((input) => input.value);
      const quantities = [...form.querySelectorAll<HTMLInputElement>('input[name="quantity"]')].map((input) => input.value);
      const weights = [...form.querySelectorAll<HTMLInputElement>('input[name="weight"]')].map((input) => input.value);
      const posted = postedCartLines(slugs, quantities, weights);
      if (posted.ok) store(posted.lines);
    };
    let saveTimer = 0;
    let applySerial = 0;
    const markQuoteStale = () => {
      applySerial += 1;
      const applyButton = form.querySelector('button[name="intent"][value="apply"]');
      if (applyButton instanceof HTMLButtonElement) {
        applyButton.disabled = false;
        applyButton.textContent = 'Áp dụng';
      }
      const label = form.querySelector('[data-cart-sum-label]');
      if (label) label.textContent = 'Tạm tính';
      const quoteNote = form.querySelector('[data-discount-quote]');
      if (quoteNote instanceof HTMLElement && !quoteNote.hidden && quoteNote.textContent) {
        quoteNote.textContent = 'Số lượng vừa đổi. Bấm Áp dụng để xem số giảm mới.';
      }
    };
    const showDiscount = (message: string, isError: boolean) => {
      const error = form.querySelector('[data-discount-error]');
      const quoteNote = form.querySelector('[data-discount-quote]');
      if (error instanceof HTMLElement) {
        error.hidden = !isError;
        error.textContent = isError ? message : '';
      }
      if (quoteNote instanceof HTMLElement) {
        quoteNote.hidden = isError || !message;
        quoteNote.textContent = isError ? '' : message;
      }
    };
    const previewDiscount = async (button: HTMLButtonElement) => {
      const serial = ++applySerial;
      const body = new FormData(form);
      body.set('intent', 'apply');
      button.disabled = true;
      button.textContent = 'Đang áp dụng...';
      try {
        const response = await fetch(form.action, { method: 'POST', body, headers: { accept: 'application/json' } });
        const payload: unknown = await response.json();
        if (serial !== applySerial) return;
        const row = payload && typeof payload === 'object' ? payload as { ok?: boolean; error?: string; quote?: { code?: string; discountAmount?: number; totalPrice?: number } } : null;
        const quoteRow = row?.quote;
        const discountAmount = quoteRow?.discountAmount;
        const totalPrice = quoteRow?.totalPrice;
        if (
          !response.ok ||
          !row?.ok ||
          typeof quoteRow?.code !== 'string' ||
          typeof discountAmount !== 'number' ||
          typeof totalPrice !== 'number' ||
          !Number.isInteger(discountAmount) ||
          !Number.isInteger(totalPrice)
        ) {
          showDiscount(typeof row?.error === 'string' ? row.error : 'Chưa kiểm được mã. Thử lại sau.', true);
          const sumLabel = form.querySelector('[data-cart-sum-label]');
          if (sumLabel) sumLabel.textContent = 'Tạm tính';
          recalc();
          return;
        }
        const codeField = form.querySelector('[name="discountCode"]');
        if (codeField instanceof HTMLInputElement) codeField.value = quoteRow.code;
        showDiscount(`Giảm ${quoteRow.code}: −${money.format(discountAmount)}. Còn ${money.format(totalPrice)} trước ship.`, false);
        const sumLabel = form.querySelector('[data-cart-sum-label]');
        if (sumLabel) sumLabel.textContent = 'Phải trả';
        recalc(totalPrice);
      } catch {
        if (serial !== applySerial) return;
        showDiscount('Chưa kiểm được mã. Thử lại sau.', true);
      } finally {
        if (serial === applySerial) {
          button.disabled = false;
          button.textContent = 'Áp dụng';
        }
      }
    };
    form.addEventListener('input', (event) => {
      if (!(event.target instanceof HTMLInputElement) || event.target.name !== 'quantity') return;
      recalc();
      markQuoteStale();
      window.clearTimeout(saveTimer);
      saveTimer = window.setTimeout(persist, 250);
    });

    // Xử lý theo click thay vì submit: click luôn bắn, không phụ thuộc validation hay hành vi submit.
    form.addEventListener('click', (event) => {
      const button = event.target instanceof Element ? event.target.closest('button[name="intent"]') : null;
      if (!(button instanceof HTMLButtonElement)) return;
      if (button.value.startsWith('remove:')) {
        event.preventDefault();
        button.closest('[data-cart-item]')?.remove();
        const linesOut = document.querySelector('[data-cart-sum-lines]');
        const remaining = form.querySelectorAll('[data-cart-item]').length;
        if (linesOut) linesOut.textContent = `${remaining} mẫu`;
        recalc();
        markQuoteStale();
        persist();
        if (remaining === 0) location.reload();
        return;
      }
      if (button.value === 'apply') {
        event.preventDefault();
        void previewDiscount(button);
      }
    });

    // Chặn bấm "Gửi đơn" hai lần; không vô hiệu hóa nút vì giá trị intent cần được gửi đi.
    let sending = false;
    form.addEventListener('submit', (event) => {
      const submitter = event instanceof SubmitEvent ? event.submitter : null;
      if (!(submitter instanceof HTMLButtonElement) || submitter.value !== 'order') {
        event.preventDefault();
        return;
      }
      if (sending) {
        event.preventDefault();
        return;
      }
      sending = true;
      submitter.textContent = 'Đang gửi...';
    });
    window.addEventListener('pageshow', () => {
      sending = false;
      const orderButton = form.querySelector('button[name="intent"][value="order"]');
      if (orderButton) orderButton.textContent = 'Gửi đơn';
    });
  }
</script>
