---
import AddressField from '../components/public/AddressField.astro';
import DataError from '../components/public/DataError.astro';
import DiscountCodeField from '../components/public/DiscountCodeField.astro';
import PaymentField from '../components/public/PaymentField.astro';
import AddonPicker from '../components/public/AddonPicker.astro';
import { addCartLine, CART_COOKIE, CART_MAX_NOTE, CART_MAX_QUANTITY, cartCookieOptions, parseCart, postedCartLines, serializeCart, type CartLine } from '../features/cart/cart';
import { applyDiscount, type DiscountQuote } from '../features/discounts/quote';
import { priceDiscount } from '../features/discounts/discounts';
import { listOrderCosts } from '../features/costs/order-costs';
import {
  addonUnitWithBundleOffers,
  listActiveAddonBundleOffers,
  listActiveComboOffersByProductId,
  type AddonBundleOffer,
} from '../features/home-collections/collections';
import { lineUnitPrice, parseCartOrder, type CatalogProduct, type ComboOffersByProduct } from '../features/orders/order';
import { placeCartOrder, placeOrder } from '../features/orders/orders';
import {
  addonShipHint,
  cartShowsAddonUpsell,
  findAddonInCatalog,
  findAddonsInCatalog,
  listPublicAddons,
  type PublicAddon,
} from '../features/products/addons';
import { listOrderCatalog } from '../features/products/public';
import { productRequiresTagName, TAG_NAME_MAX } from '../features/products/tag-name';
import { applyWeightPrice, isValidWeight, requiresWeight, weightSurchargeLabel } from '../features/products/weight';
import { getPublicSite } from '../features/settings/settings';
import { baseCustomerShippingFee, resolveCustomerShippingFee, shipGroupOf } from '../features/shipping/customer-fee';
import PublicLayout from '../layouts/PublicLayout.astro';
import { createDb } from '../lib/db/client';
import { getDbBinding } from '../lib/cloudflare/env';
import { clientIp, hashIp, isSameOrigin } from '../lib/http';
import { formatVnd } from '../lib/money';
import { routes } from '../lib/routes';
import type { FieldErrors } from '../lib/validation/errors';

const secure = Astro.url.protocol === 'https:';
const loaded = await loadCart();
let lines = parseCart(Astro.cookies.get(CART_COOKIE)?.value);
const comboOffers = loaded.comboOffers;
const addonOffers = loaded.addonOffers;
let formError = '';
let errors: FieldErrors = {};
const values = { customerName: '', phone: '', address: '', provinceCode: '', wardCode: '', addressLine: '', note: '', paymentMethod: '', discountCode: '' };
let quote: DiscountQuote | null = null;
Astro.response.headers.set('Cache-Control', 'private, no-store');
const shipBaseFee = loaded.db ? baseCustomerShippingFee(await listOrderCosts(loaded.db)) : 0;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const read = (name: string) => {
    const value = form.get(name);
    return typeof value === 'string' ? value : '';
  };
  const intent = read('intent');
  const wantsJson = Astro.request.headers.get('accept')?.includes('application/json') ?? false;
  const discountJson = (status: number, body: { ok: true; quote: DiscountQuote } | { ok: false; error: string }) =>
    new Response(JSON.stringify(body), {
      status,
      headers: { 'content-type': 'application/json; charset=utf-8', 'cache-control': 'private, no-store' },
    });
  values.customerName = read('customerName');
  values.phone = read('phone');
  values.address = read('address');
  values.provinceCode = read('provinceCode');
  values.wardCode = read('wardCode');
  values.addressLine = read('addressLine');
  values.note = read('note');
  values.paymentMethod = read('paymentMethod');
  values.discountCode = read('discountCode');
  if (!loaded.site) {
    Astro.response.status = 503;
  } else if (!isSameOrigin(Astro.request)) {
    Astro.response.status = 403;
    formError = 'Nguồn gửi không hợp lệ.';
  } else if (intent === 'add') {
    const tagName = read('tagName').replace(/\s+/g, ' ').trim();
    const added = addCartLine(lines, {
      slug: read('slug'),
      quantity: Number(read('quantity') || '1'),
      weight: read('weight'),
      note: tagName,
    });
    const product = loaded.catalog.find((item) => item.slug === read('slug'));
    const addonRaws = strings(form, 'addonSlug');
    const pickedAddons = findAddonsInCatalog(addonRaws, loaded.catalog);
    if (!added.ok) formError = added.error;
    else if (!product) formError = 'Sản phẩm không còn bán.';
    else if (requiresWeight(product.weightScale) && !read('weight').trim()) formError = 'Chọn cân nặng cho bé.';
    else if (!isValidWeight(product.weightScale, read('weight'))) formError = 'Cân nặng không hợp lệ.';
    else if (productRequiresTagName(product.name) && !tagName) formError = 'Nhập tên cần in lên thẻ.';
    else if (productRequiresTagName(product.name) && tagName.length > TAG_NAME_MAX) formError = `Tên in thẻ tối đa ${TAG_NAME_MAX} ký tự.`;
    else if (addonRaws.length > 0 && pickedAddons.length !== [...new Set(addonRaws.map((item) => item.trim()).filter(Boolean))].length) {
      formError = 'Bó dâu bán kèm không còn bán.';
    } else {
      let next = added.lines;
      let failed = '';
      for (const addon of pickedAddons) {
        const withAddon = addCartLine(next, { slug: addon.slug, quantity: 1, weight: '', note: '' });
        if (!withAddon.ok) {
          failed = withAddon.error;
          break;
        }
        next = withAddon.lines;
      }
      if (failed) formError = failed;
      else {
        remember(next);
        return Astro.redirect(routes.cart, 303);
      }
    }
  } else if (intent === 'add-addon' || intent.startsWith('add-addon:')) {
    const posted = linesFrom(form, 'save');
    const addonSlug = intent.startsWith('add-addon:') ? intent.slice('add-addon:'.length) : read('addonSlug');
    const addon = findAddonInCatalog(addonSlug, loaded.catalog);
    if (!posted.ok) formError = posted.error;
    else if (!addon) formError = 'Chọn bó dâu đang bán.';
    else {
      const withAddon = addCartLine(posted.lines, { slug: addon.slug, quantity: 1, weight: '', note: '' });
      if (!withAddon.ok) formError = withAddon.error;
      else {
        remember(withAddon.lines);
        return Astro.redirect(routes.cart, 303);
      }
    }
  } else if (intent === 'save' || intent.startsWith('remove:')) {
    const posted = linesFrom(form, intent);
    if (!posted.ok) formError = posted.error;
    else {
      remember(posted.lines.filter((line) => loaded.catalog.some((item) => item.slug === line.slug)));
      return Astro.redirect(routes.cart, 303);
    }
  } else if (intent === 'apply') {
    const posted = linesFrom(form, intent);
    const fail = (status: number, error: string, field = false) => {
      if (wantsJson) return discountJson(status, { ok: false, error });
      Astro.response.status = status;
      if (field) errors = { discountCode: error };
      else formError = error;
      return null;
    };
    if (!posted.ok) {
      const denied = fail(422, posted.error);
      if (denied) return denied;
    } else if (read('company').trim()) {
      const denied = fail(403, 'Không gửi được đơn.');
      if (denied) return denied;
    } else {
      lines = posted.lines;
      const subtotal = merchandiseTotal(posted.lines, loaded.catalog);
      if (subtotal === null) {
        const denied = fail(422, posted.lines.length === 0 ? 'Giỏ đang trống.' : 'Một mẫu trong giỏ không còn bán.');
        if (denied) return denied;
      } else if (!loaded.db) {
        const denied = fail(503, 'Chưa kiểm được mã. Thử lại sau.');
        if (denied) return denied;
      } else {
        const priced = await priceDiscount(loaded.db, subtotal, values.discountCode, await visitorHash(), Date.now(), true);
        if (!priced.ok) {
          const denied = fail(422, priced.error, true);
          if (denied) return denied;
        } else if (priced.discount) {
          quote = priced.discount;
          if (wantsJson) return discountJson(200, { ok: true, quote: priced.discount });
        } else {
          const denied = fail(422, 'Nhập mã giảm giá.', true);
          if (denied) return denied;
        }
      }
    }
  } else if (intent === 'order') {
    const posted = linesFrom(form, intent);
    if (!posted.ok) {
      Astro.response.status = 422;
      formError = posted.error;
    } else {
      lines = posted.lines;
      const parsed = parseCartOrder(
        { ...values, company: read('company'), lines },
        loaded.catalog,
        comboOffers,
        addonOffers,
      );
      if (!parsed.ok) {
        Astro.response.status = parsed.blocked ? 403 : 422;
        formError = parsed.blocked ? 'Không gửi được đơn.' : '';
        errors = parsed.errors;
      } else if (!loaded.db) {
        Astro.response.status = 503;
        formError = 'Chưa lưu được đơn. Thử lại sau.';
      } else {
        try {
          const ipHash = await visitorHash();
          const base = parsed.single ?? parsed.cart;
          const priced = base ? await priceDiscount(loaded.db, base.subtotal, values.discountCode, ipHash) : { ok: true as const, discount: null };
          if (!priced.ok) {
            Astro.response.status = 422;
            errors = { discountCode: priced.error };
          } else {
            const saved = parsed.single
              ? await placeOrder(loaded.db, { ...parsed.single, ...applyDiscount(parsed.single.subtotal, priced.discount) }, ipHash)
              : parsed.cart
                ? await placeCartOrder(loaded.db, { ...parsed.cart, ...applyDiscount(parsed.cart.subtotal, priced.discount) }, ipHash)
                : { ok: false as const, status: 422 as const, error: 'Giỏ đang trống.' };
            if (!saved.ok) {
              Astro.response.status = saved.status;
              formError = saved.error;
            } else {
              Astro.cookies.set(CART_COOKIE, '', cartCookieOptions(secure, 0));
              const response = Astro.redirect(`${routes.checkoutSuccess}?ma=${saved.code}`, 303);
              response.headers.set('Cache-Control', 'private, no-store');
              return response;
            }
          }
        } catch (error) {
          Astro.response.status = 503;
          formError = 'Chưa lưu được đơn. Thử lại sau.';
          console.error(JSON.stringify({ event: 'cart_order_failed', name: error instanceof Error ? error.name : 'unknown' }));
        }
      }
    }
  } else {
    Astro.response.status = 422;
    formError = 'Thao tác không hợp lệ.';
  }
}

const cartProductIds = new Set(
  lines.flatMap((line) => {
    const product = loaded.catalog.find((item) => item.slug === line.slug);
    return product ? [product.id] : [];
  }),
);
const resolved = lines.flatMap((line) => {
  const product = loaded.catalog.find((item) => item.slug === line.slug);
  if (!product) return [];
  // Đơn giá: giảm combo / bán kèm (nếu đủ điều kiện) rồi phụ thu cân nặng.
  const unitPrice = lineUnitPrice(
    product,
    line.quantity,
    line.weight,
    comboOffers,
    addonOffers,
    cartProductIds,
  );
  const catalogUnit = applyWeightPrice(product.price, line.weight);
  const compareUnit =
    product.comparePrice != null ? applyWeightPrice(product.comparePrice, line.weight) : null;
  const wasUnit =
    catalogUnit > unitPrice
      ? catalogUnit
      : compareUnit != null && compareUnit > unitPrice
        ? compareUnit
        : null;
  const lineTotal = unitPrice * line.quantity;
  const catalogLineTotal = catalogUnit * line.quantity;
  return [
    {
      ...line,
      name: product.name,
      needsTag: productRequiresTagName(product.name),
      price: unitPrice,
      catalogUnit,
      comparePrice: wasUnit,
      basePrice: product.price,
      surcharge: weightSurchargeLabel(line.weight, product.price),
      coverUrl: product.coverUrl,
      coverAlt: product.coverAlt,
      categorySlug: product.categorySlug ?? '',
      shipGroup: shipGroupOf(product.categorySlug),
      lineTotal,
      catalogLineTotal,
      comboSave: Math.max(0, catalogLineTotal - lineTotal),
    },
  ];
});
const dropped = resolved.length !== lines.length;
if (dropped && Astro.request.method === 'GET') remember(resolved.map(({ slug, quantity, weight, note }) => ({ slug, quantity, weight, note })));
const total = resolved.reduce((sum, line) => sum + line.lineTotal, 0);
const catalogTotal = resolved.reduce((sum, line) => sum + line.catalogLineTotal, 0);
const comboSaveTotal = resolved.reduce((sum, line) => sum + line.comboSave, 0);
const pieces = resolved.reduce((sum, line) => sum + line.quantity, 0);
const goodsPayable = quote?.totalPrice ?? total;
const shipping = resolveCustomerShippingFee({
  lines: resolved.map((line) => ({ group: line.shipGroup, lineTotal: line.lineTotal })),
  baseFee: shipBaseFee,
});
const payable = goodsPayable + shipping.fee;
const showAddonUpsell = cartShowsAddonUpsell(resolved) && loaded.addons.length > 0;
const cartUpsellAddons = showAddonUpsell
  ? loaded.addons.map((addon) => {
      const sale = addonUnitWithBundleOffers(addon.price, addon.id, cartProductIds, addonOffers);
      return sale < addon.price ? { ...addon, price: sale } : addon;
    })
  : loaded.addons;
const addedAddonSlugs = resolved.filter((line) => line.shipGroup === 'addon').map((line) => line.slug);
const braceletGoods = resolved
  .filter((line) => line.shipGroup === 'bracelet')
  .reduce((sum, line) => sum + line.lineTotal, 0);
const cartAddonHint = addonShipHint(braceletGoods);

function linesFrom(form: FormData, intent: string): { ok: true; lines: CartLine[] } | { ok: false; error: string } {
  const slugs = strings(form, 'slug');
  const quantities = strings(form, 'quantity');
  const weights = strings(form, 'weight');
  const notes = strings(form, 'lineNote');
  if (intent.startsWith('remove:')) {
    const index = Number(intent.slice('remove:'.length));
    if (!Number.isInteger(index) || index < 0 || index >= slugs.length) return { ok: false, error: 'Không xóa được mẫu này.' };
    slugs.splice(index, 1);
    quantities.splice(index, 1);
    weights.splice(index, 1);
    if (notes.length > index) notes.splice(index, 1);
  }
  return postedCartLines(
    slugs,
    quantities,
    weights,
    slugs.map((_, index) => notes[index] ?? ''),
  );
}

function strings(form: FormData, name: string): string[] {
  return form.getAll(name).flatMap((value) => (typeof value === 'string' ? [value] : []));
}

function remember(next: CartLine[]) {
  Astro.cookies.set(CART_COOKIE, next.length ? serializeCart(next) : '', cartCookieOptions(secure, next.length ? undefined : 0));
}

function merchandiseTotal(
  cartLines: CartLine[],
  catalog: CatalogProduct[],
  offers: ComboOffersByProduct = comboOffers,
  bundles: readonly AddonBundleOffer[] = addonOffers,
): number | null {
  if (cartLines.length === 0) return null;
  const ids = new Set<number>();
  for (const line of cartLines) {
    const product = catalog.find((item) => item.slug === line.slug);
    if (product) ids.add(product.id);
  }
  let total = 0;
  for (const line of cartLines) {
    const product = catalog.find((item) => item.slug === line.slug);
    if (!product || !Number.isInteger(line.quantity) || line.quantity < 1) return null;
    total += lineUnitPrice(product, line.quantity, line.weight, offers, bundles, ids) * line.quantity;
  }
  return total;
}

async function visitorHash(): Promise<string> {
  let address: string | null = null;
  try {
    address = Astro.clientAddress;
  } catch {
    address = null;
  }
  return hashIp(clientIp(Astro.request, address));
}

async function loadCart(): Promise<{
  site: Awaited<ReturnType<typeof getPublicSite>>;
  failed: boolean;
  catalog: Awaited<ReturnType<typeof listOrderCatalog>>;
  addons: PublicAddon[];
  comboOffers: ComboOffersByProduct;
  addonOffers: AddonBundleOffer[];
  db: ReturnType<typeof createDb> | null;
}> {
  try {
    const db = createDb(getDbBinding());
    const site = await getPublicSite(db);
    if (!site) {
      return { site: null, failed: false, catalog: [], addons: [], comboOffers: new Map(), addonOffers: [], db: null };
    }
    const [catalog, addons, offers, bundles] = await Promise.all([
      listOrderCatalog(db),
      listPublicAddons(db),
      listActiveComboOffersByProductId(db),
      listActiveAddonBundleOffers(db),
    ]);
    return { site, failed: false, catalog, addons, comboOffers: offers, addonOffers: bundles, db };
  } catch (error) {
    console.error(JSON.stringify({ event: 'cart_load_failed', name: error instanceof Error ? error.name : 'unknown' }));
    return { site: null, failed: true, catalog: [], addons: [], comboOffers: new Map(), addonOffers: [], db: null };
  }
}
---

<PublicLayout
  title={loaded.site ? `Giỏ hàng | ${loaded.site.siteName}` : 'Chưa sẵn sàng'}
  description="Gom nhiều mẫu vòng rồi gửi một lần. Website không thu tiền trực tuyến."
  robots="noindex,nofollow"
  siteName={loaded.site?.siteName}
  faviconUrl={loaded.site?.faviconUrl || '/favicon.svg'}
  chrome={loaded.site}
>
  {
    !loaded.site ? (
      <DataError failed={loaded.failed} />
    ) : (
      <main class="cart-page">
        <header class="cart-page-head">
          <h1 class="cart-page-title">Giỏ hàng</h1>
          {resolved.length > 0 && (
            <p class="cart-page-meta">
              <span data-cart-sum-lines>{resolved.length} mẫu</span> · <span data-cart-sum-count>{pieces}</span> chiếc
            </p>
          )}
        </header>
        {dropped && <p class="mt-3 text-muted">Đã bỏ mẫu không còn bán.</p>}
        {formError && <p class="error-text mt-3" role="alert">{formError}</p>}
        {errors.cart && <p class="error-text mt-3" role="alert">{errors.cart}</p>}
        {resolved.length === 0 ? (
          <section class="cart-empty">
            <svg class="cart-empty-art" viewBox="0 0 200 150" role="img" aria-label="Giỏ hàng trống với trái tim" xmlns="http://www.w3.org/2000/svg">
              <ellipse cx="100" cy="120" rx="78" ry="12" fill="#f6dfe3" />
              <circle cx="100" cy="66" r="52" fill="#fbeef0" />
              <g fill="none" stroke="#e79aa9" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M60 58h66l-7 34H67z" fill="#fdf1f3" />
                <path d="M60 58l-5-14h-9" />
                <path d="M72 58l6-14h30l6 14" fill="#fde7eb" />
              </g>
              <path d="M93 66c0-4 7-4 7 1 0-5 7-5 7-1 0 5-7 9-7 9s-7-4-7-9z" fill="#f08ea0" />
              <g fill="none" stroke="#e79aa9" stroke-width="3.2" stroke-linecap="round">
                <path d="M67 92l-3 10h58l-3-10" />
              </g>
              <circle cx="74" cy="110" r="6" fill="#fff" stroke="#e79aa9" stroke-width="3.2" />
              <circle cx="118" cy="110" r="6" fill="#fff" stroke="#e79aa9" stroke-width="3.2" />
              <path d="M138 40c0-3 5-3 5 1 0-4 5-4 5 0 0 4-5 7-5 7s-5-3-5-8z" fill="#f4a9b6" />
              <path d="M44 74c6-2 10-7 10-7M48 86c5 1 10-1 10-1" stroke="#b7d8b0" stroke-width="3" stroke-linecap="round" fill="none" />
            </svg>
            <h2 class="cart-empty-title">Giỏ hàng của bạn đang trống</h2>
            <p class="cart-empty-text">Bạn chưa chọn mẫu vòng nào. Ghé xem các mẫu vòng dâu tằm thủ công, gom lại rồi gửi đơn một lần nhé.</p>
            <div class="cart-empty-actions">
              <a class="btn btn-accent cart-empty-btn" href={routes.catalog}>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M6 7h12l1 13H5L6 7z" />
                  <path d="M9 7a3 3 0 0 1 6 0" />
                </svg>
                Xem mẫu vòng
              </a>
              <a class="btn cart-empty-btn" href={routes.home}>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M20 12l-8 8-8-8a4 4 0 0 1 8-3 4 4 0 0 1 8 3z" />
                </svg>
                Về trang chủ
              </a>
            </div>
          </section>
        ) : (
          <form class="cart-layout" method="post" action={routes.cart} data-cart-page>
            <button class="sr-only" type="submit" data-cart-noop tabindex="-1" aria-hidden="true">Giỏ hàng</button>
            <div class="cart-items-panel">
              <h2 id="cart-items-title" class="cart-section-title">Mẫu vòng đã chọn</h2>
              <ul class="cart-list">
                {resolved.map((line, index) => {
                  const noteOpen = line.needsTag || Boolean(line.note) || Boolean(errors[`note${index}`]);
                  return (
                  <li
                    class="cart-item"
                    data-cart-item
                    data-price={line.price}
                    data-catalog-price={line.catalogUnit}
                    data-ship-group={line.shipGroup}
                  >
                    <div class="cart-item-main">
                      {line.coverUrl ? (
                        <img class="cart-thumb" src={line.coverUrl} alt={line.coverAlt || line.name} width="88" height="88" loading="lazy" />
                      ) : (
                        <span class="cart-thumb" aria-hidden="true"></span>
                      )}
                      <div class="cart-info">
                        <a class="cart-name" href={routes.product(line.slug)}>{line.name}</a>
                        <input type="hidden" name="slug" value={line.slug} />
                        <input type="hidden" name="weight" value={line.weight} />
                        {line.weight && (
                          <p class="cart-meta">
                            <span class="cart-tag">Size: {line.weight}</span>
                            {line.surcharge && <span class="cart-surcharge">Vòng lớn {line.surcharge}</span>}
                          </p>
                        )}
                        <p class="cart-price-row">
                          {line.comparePrice != null && <span class="cart-price-was">{formatVnd(line.comparePrice)}</span>}
                          <span class="cart-price-now">{formatVnd(line.price)}</span>
                        </p>
                      </div>
                      <div class="cart-qty-wrap">
                        <div class="qty" aria-label={`Số lượng ${line.name}`}>
                          <button class="qty-btn" type="button" data-qty-step="-1" aria-label={`Giảm số lượng ${line.name}`} hidden>−</button>
                          <input
                            class="qty-input"
                            name="quantity"
                            type="number"
                            inputmode="numeric"
                            min="1"
                            max={CART_MAX_QUANTITY}
                            required
                            value={line.quantity}
                            aria-label={`Số lượng ${line.name}`}
                          />
                          <button class="qty-btn" type="button" data-qty-step="1" aria-label={`Tăng số lượng ${line.name}`} hidden>+</button>
                        </div>
                        <p class="cart-line-total" data-line-total>{formatVnd(line.lineTotal)}</p>
                      </div>
                    </div>
                    <div class="cart-item-foot">
                      {!line.needsTag && (
                        <button
                          class="cart-note-open"
                          type="button"
                          data-cart-note-open
                          hidden={noteOpen}
                        >
                          + Thêm lưu ý cho sản phẩm
                        </button>
                      )}
                      <label
                        class={`cart-note${line.needsTag ? ' cart-note-tag' : ''}`}
                        for={`cart-note-${index}`}
                        hidden={!noteOpen}
                        data-cart-note-wrap
                      >
                        <span class="cart-note-icon" aria-hidden="true">
                          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M21 15a4 4 0 0 1-4 4H8l-5 3V7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4z" />
                          </svg>
                        </span>
                        <span class="cart-note-label">{line.needsTag ? 'Tên bé' : 'Lưu ý'}</span>
                        <input
                          id={`cart-note-${index}`}
                          class="field cart-note-input"
                          name="lineNote"
                          type="text"
                          maxlength={line.needsTag ? TAG_NAME_MAX : CART_MAX_NOTE}
                          required={line.needsTag}
                          value={line.note}
                          autocomplete="off"
                          placeholder={line.needsTag ? 'Nhập tên cần in…' : 'Ghi chú thêm…'}
                          aria-label={line.needsTag ? `Tên cần in lên thẻ — ${line.name}` : `Lưu ý — ${line.name}`}
                          data-cart-note
                        />
                      </label>
                      <button
                        class="cart-remove"
                        type="submit"
                        name="intent"
                        value={`remove:${index}`}
                        formnovalidate
                        aria-label={`Xóa ${line.name}`}
                        title="Xóa"
                      >
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                          <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
                        </svg>
                      </button>
                    </div>
                    {errors[`weight${index}`] && <p class="error-text cart-field-error">{errors[`weight${index}`]}</p>}
                    {errors[`note${index}`] && <p class="error-text cart-field-error">{errors[`note${index}`]}</p>}
                    {errors[`quantity${index}`] && <p class="error-text cart-field-error">{errors[`quantity${index}`]}</p>}
                  </li>
                  );
                })}
              </ul>
              <div class="cart-tools">
                <a href={routes.catalog}>← Xem thêm mẫu</a>
              </div>
              {
                showAddonUpsell && (
                  <AddonPicker
                    addons={cartUpsellAddons}
                    hint={cartAddonHint}
                    addedSlugs={addedAddonSlugs}
                    upsell
                    idPrefix="cart-addon"
                    class="mt-5"
                  />
                )
              }
            </div>
            <section class="cart-card cart-checkout" aria-labelledby="cart-checkout-title">
              <h2 id="cart-checkout-title" class="cart-card-title text-lg font-semibold">Thông tin nhận hàng</h2>
            <div class="absolute -left-[9999px]" aria-hidden="true">
              <label for="company">Công ty</label>
              <input id="company" name="company" tabindex="-1" autocomplete="off" />
            </div>
            <div class="form-pair mt-4">
              <label class="block" for="customer-name">
                <span class="mb-1 block font-semibold">Họ tên</span>
                <input id="customer-name" class="field" name="customerName" required maxlength="80" autocomplete="name" value={values.customerName} />
                {errors.customerName && <span class="error-text">{errors.customerName}</span>}
              </label>
              <label class="block" for="phone">
                <span class="mb-1 block font-semibold">Số điện thoại</span>
                <input id="phone" class="field" name="phone" type="tel" required maxlength="20" autocomplete="tel" value={values.phone} />
                {errors.phone && <span class="error-text">{errors.phone}</span>}
              </label>
            </div>
            <AddressField
              idPrefix="cart-address"
              error={errors.address}
              address={values.address}
              provinceCode={values.provinceCode}
              wardCode={values.wardCode}
              line={values.addressLine}
              paired
            />
            <label class="mt-4 block" for="note">
              <span class="mb-1 block font-semibold">Ghi chú</span>
              <textarea id="note" class="field min-h-20" name="note" maxlength="500">{values.note}</textarea>
              {errors.note && <span class="error-text">{errors.note}</span>}
            </label>
            <PaymentField value={values.paymentMethod} error={errors.paymentMethod} />
            <DiscountCodeField id="cart-discount" value={values.discountCode} error={errors.discountCode} quote={quote} />
            <div class="cart-sum-stack" data-cart-ship data-ship-base={shipBaseFee} data-ship-goods={goodsPayable}>
              <ul class="cart-sum-lines" data-cart-order-lines aria-label="Sản phẩm trong đơn">
                {resolved.map((line) => (
                  <li class:list={['cart-sum-line', line.shipGroup === 'addon' && 'is-addon']}>
                    <span class="cart-sum-line-text">
                      <span class="cart-sum-line-name">{line.name}</span>
                      {line.quantity > 1 && <span class="cart-sum-line-qty">×{line.quantity}</span>}
                      {line.weight && <span class="cart-sum-line-meta">{line.weight}</span>}
                    </span>
                    <span class="cart-sum-line-price">{formatVnd(line.lineTotal)}</span>
                  </li>
                ))}
              </ul>
              <div class="cart-sum">
                <span>Tạm tính</span>
                <strong data-cart-goods>{formatVnd(comboSaveTotal > 0 ? catalogTotal : total)}</strong>
              </div>
              <div class="cart-sum cart-sum-muted cart-sum-combo" data-cart-combo-save hidden={comboSaveTotal <= 0}>
                <span>Giảm combo</span>
                <strong data-cart-combo-save-amount>−{formatVnd(comboSaveTotal)}</strong>
              </div>
              {quote && quote.discountAmount > 0 && (
                <div class="cart-sum cart-sum-muted">
                  <span>Giảm giá</span>
                  <strong>−{formatVnd(quote.discountAmount)}</strong>
                </div>
              )}
              <div class="cart-sum cart-sum-muted">
                <span data-cart-ship-label>{shipping.free ? 'Phí vận chuyển' : 'Phí vận chuyển'}</span>
                <strong data-cart-ship-fee>{shipping.free ? 'Miễn phí' : formatVnd(shipping.fee)}</strong>
              </div>
              <div class="cart-sum">
                <span data-cart-sum-label>Phải trả</span>
                <strong data-cart-total data-payable-amount={payable}>{formatVnd(payable)}</strong>
              </div>
            </div>
            <p class="cart-sum-note">Nhận hàng kiểm tra hàng thoải mái, ưng ý thì mới thanh toán.</p>
            <button class="btn btn-accent mt-4 w-full" type="submit" name="intent" value="order">Gửi đơn</button>
            </section>
          </form>
        )}
      </main>
    )
  }
</PublicLayout>
<script>
  import {
    addCartLine,
    CART_COOKIE,
    CART_MAX_AGE,
    CART_MAX_NOTE,
    CART_MAX_QUANTITY,
    cartCount,
    parseCart,
    postedCartLines,
    serializeCart,
    type CartLine,
  } from '../features/cart/cart';
  import { resolveCustomerShippingFee, type ShipGroup } from '../features/shipping/customer-fee';

  const form = document.querySelector('form[data-cart-page]');
  if (form instanceof HTMLFormElement) {
    const money = new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND', maximumFractionDigits: 0 });
    const shipRoot = form.querySelector('[data-cart-ship]');
    const shipBase = shipRoot instanceof HTMLElement ? Number(shipRoot.dataset.shipBase || '0') : 0;
    const cartList = form.querySelector('.cart-list');

    const readCookie = (): CartLine[] => {
      const raw = document.cookie.split('; ').find((part) => part.startsWith(`${CART_COOKIE}=`));
      if (!raw) return [];
      const value = raw.slice(CART_COOKIE.length + 1);
      try {
        return parseCart(value.includes('%') ? decodeURIComponent(value) : value);
      } catch {
        return [];
      }
    };

    // Tính lại tiền từng dòng, phí ship và tổng ngay khi đổi số lượng (server vẫn tính lại khi gửi).
    const recalc = (goodsPayable?: number) => {
      let total = 0;
      let catalogTotal = 0;
      let pieces = 0;
      const shipLines: { group: ShipGroup; lineTotal: number }[] = [];
      const summaryRows: HTMLLIElement[] = [];
      form.querySelectorAll<HTMLElement>('[data-cart-item]').forEach((item) => {
        const input = item.querySelector('input[name="quantity"]');
        if (!(input instanceof HTMLInputElement)) return;
        const price = Number(item.dataset.price);
        const catalogPrice = Number(item.dataset.catalogPrice);
        const quantity = Number(input.value);
        if (!Number.isInteger(quantity) || quantity < 1 || quantity > (Number(input.max) || 20)) return;
        const lineTotal = price * quantity;
        const catalogLine =
          Number.isFinite(catalogPrice) && catalogPrice > 0 ? catalogPrice * quantity : lineTotal;
        total += lineTotal;
        catalogTotal += catalogLine;
        pieces += quantity;
        const group = (item.dataset.shipGroup || 'other') as ShipGroup;
        shipLines.push({ group, lineTotal });
        const out = item.querySelector('[data-line-total]');
        if (out) out.textContent = money.format(lineTotal);

        const name = item.querySelector('.cart-name')?.textContent?.trim() || 'Sản phẩm';
        const weight = (item.querySelector('input[name="weight"]') as HTMLInputElement | null)?.value.trim() || '';
        const li = document.createElement('li');
        li.className = group === 'addon' ? 'cart-sum-line is-addon' : 'cart-sum-line';
        const text = document.createElement('span');
        text.className = 'cart-sum-line-text';
        const nameEl = document.createElement('span');
        nameEl.className = 'cart-sum-line-name';
        nameEl.textContent = name;
        text.append(nameEl);
        if (quantity > 1) {
          const qtyEl = document.createElement('span');
          qtyEl.className = 'cart-sum-line-qty';
          qtyEl.textContent = `×${quantity}`;
          text.append(qtyEl);
        }
        if (weight) {
          const metaEl = document.createElement('span');
          metaEl.className = 'cart-sum-line-meta';
          metaEl.textContent = weight;
          text.append(metaEl);
        }
        const priceEl = document.createElement('span');
        priceEl.className = 'cart-sum-line-price';
        priceEl.textContent = money.format(lineTotal);
        li.append(text, priceEl);
        summaryRows.push(li);
      });
      const comboSave = Math.max(0, catalogTotal - total);
      const shipping = resolveCustomerShippingFee({ lines: shipLines, baseFee: shipBase });
      const payableGoods = typeof goodsPayable === 'number' && Number.isFinite(goodsPayable) ? goodsPayable : total;
      if (shipRoot instanceof HTMLElement) shipRoot.dataset.shipGoods = String(payableGoods);
      const goodsOut = form.querySelector('[data-cart-goods]');
      if (goodsOut) goodsOut.textContent = money.format(comboSave > 0 ? catalogTotal : total);
      const comboRow = form.querySelector('[data-cart-combo-save]');
      const comboAmount = form.querySelector('[data-cart-combo-save-amount]');
      if (comboRow instanceof HTMLElement) comboRow.hidden = comboSave <= 0;
      if (comboAmount) comboAmount.textContent = `−${money.format(comboSave)}`;
      const shipFeeOut = form.querySelector('[data-cart-ship-fee]');
      if (shipFeeOut) shipFeeOut.textContent = shipping.free ? 'Miễn phí' : money.format(shipping.fee);
      const totalOut = form.querySelector('[data-cart-total]');
      if (totalOut instanceof HTMLElement) {
        totalOut.textContent = money.format(payableGoods + shipping.fee);
        totalOut.dataset.payableAmount = String(payableGoods + shipping.fee);
      }
      const countOut = document.querySelector('[data-cart-sum-count]');
      if (countOut) countOut.textContent = String(pieces);
      const linesOut = document.querySelector('[data-cart-sum-lines]');
      const remaining = form.querySelectorAll('[data-cart-item]').length;
      if (linesOut) linesOut.textContent = `${remaining} mẫu`;
      const orderLines = form.querySelector('[data-cart-order-lines]');
      if (orderLines instanceof HTMLElement) orderLines.replaceChildren(...summaryRows);
    };

    const bindQtyButton = (button: HTMLButtonElement) => {
      button.hidden = false;
      button.addEventListener('click', () => {
        const input = button.closest('.qty')?.querySelector('input[name="quantity"]');
        if (!(input instanceof HTMLInputElement)) return;
        const max = Number(input.max) || 20;
        const next = (Number.isInteger(Number(input.value)) ? Number(input.value) : 1) + Number(button.dataset.qtyStep);
        input.value = String(Math.min(max, Math.max(1, next)));
        recalc();
        markQuoteStale();
        persist();
      });
    };
    form.querySelectorAll<HTMLButtonElement>('[data-qty-step]').forEach(bindQtyButton);

    const store = (lines: CartLine[]) => {
      const secure = location.protocol === 'https:' ? '; Secure' : '';
      const maxAge = lines.length === 0 ? 0 : CART_MAX_AGE;
      const value = lines.length === 0 ? '' : encodeURIComponent(serializeCart(lines));
      document.cookie = `${CART_COOKIE}=${value}; Path=/; Max-Age=${maxAge}; SameSite=Lax${secure}`;
      const count = cartCount(lines);
      const label = count > 0 ? `Giỏ hàng, ${count} chiếc` : 'Giỏ hàng';
      document.querySelectorAll('[data-cart-count], [data-cart-count-mobile]').forEach((node) => {
        if (!(node instanceof HTMLElement)) return;
        node.hidden = count < 1;
        node.textContent = count > 0 ? String(count) : '';
      });
      document.querySelectorAll('[data-cart-link], [data-cart-link-mobile]').forEach((node) => {
        if (node instanceof HTMLAnchorElement) node.setAttribute('aria-label', label);
      });
    };
    const persist = () => {
      const items = [...form.querySelectorAll<HTMLElement>('[data-cart-item]')];
      const slugs = items.map((item) => (item.querySelector('input[name="slug"]') as HTMLInputElement | null)?.value ?? '');
      const quantities = items.map((item) => (item.querySelector('input[name="quantity"]') as HTMLInputElement | null)?.value ?? '');
      const weights = items.map((item) => (item.querySelector('input[name="weight"]') as HTMLInputElement | null)?.value ?? '');
      const notes = items.map((item) => (item.querySelector('input[name="lineNote"]') as HTMLInputElement | null)?.value ?? '');
      const posted = postedCartLines(slugs, quantities, weights, notes);
      if (posted.ok) store(posted.lines);
    };

    const setAddonButtonState = (slug: string, added: boolean) => {
      const card = form.querySelector(`[data-addon-card="${CSS.escape(slug)}"]`);
      const button = card?.querySelector('.addon-add-icon');
      if (!(button instanceof HTMLButtonElement)) return;
      const name = card instanceof HTMLElement ? card.dataset.addonName || 'Bó dâu' : 'Bó dâu';
      button.classList.toggle('is-added', added);
      button.disabled = added;
      button.title = added ? 'Đã thêm' : 'Thêm vào giỏ';
      button.setAttribute('aria-label', added ? `${name} đã có trong giỏ` : `Thêm ${name} vào giỏ`);
      const mark = button.querySelector('span');
      if (mark) mark.textContent = added ? '✓' : '+';
    };

    const syncAddonButtons = () => {
      const inCart = new Set(
        [...form.querySelectorAll<HTMLInputElement>('[data-cart-item] input[name="slug"]')]
          .map((input) => input.value)
          .filter(Boolean),
      );
      form.querySelectorAll<HTMLElement>('[data-addon-card]').forEach((card) => {
        const slug = card.dataset.addonCard;
        if (!slug) return;
        setAddonButtonState(slug, inCart.has(slug));
      });
    };

    const appendAddonLine = (card: HTMLElement) => {
      if (!(cartList instanceof HTMLElement)) return;
      const slug = card.dataset.addonCard ?? '';
      const name = card.dataset.addonName ?? '';
      const price = Number(card.dataset.addonPrice || '0');
      const cover = card.dataset.addonCover ?? '';
      const href = card.dataset.addonHref || `/san-pham/${slug}`;
      if (!slug || !name || !Number.isSafeInteger(price) || price < 0) return;

      const index = form.querySelectorAll('[data-cart-item]').length;
      const noteId = `cart-note-${index}-${slug}`;
      const item = document.createElement('li');
      item.className = 'cart-item';
      item.dataset.cartItem = '';
      item.dataset.price = String(price);
      item.dataset.shipGroup = 'addon';

      const main = document.createElement('div');
      main.className = 'cart-item-main';
      if (cover) {
        const img = document.createElement('img');
        img.className = 'cart-thumb';
        img.src = cover;
        img.alt = name;
        img.width = 88;
        img.height = 88;
        img.loading = 'lazy';
        main.append(img);
      } else {
        const thumb = document.createElement('span');
        thumb.className = 'cart-thumb';
        thumb.setAttribute('aria-hidden', 'true');
        main.append(thumb);
      }

      const info = document.createElement('div');
      info.className = 'cart-info';
      const link = document.createElement('a');
      link.className = 'cart-name';
      link.href = href;
      link.textContent = name;
      const slugInput = document.createElement('input');
      slugInput.type = 'hidden';
      slugInput.name = 'slug';
      slugInput.value = slug;
      const weightInput = document.createElement('input');
      weightInput.type = 'hidden';
      weightInput.name = 'weight';
      weightInput.value = '';
      const priceRow = document.createElement('p');
      priceRow.className = 'cart-price-row';
      const priceNow = document.createElement('span');
      priceNow.className = 'cart-price-now';
      priceNow.textContent = money.format(price);
      priceRow.append(priceNow);
      info.append(link, slugInput, weightInput, priceRow);

      const qtyWrap = document.createElement('div');
      qtyWrap.className = 'cart-qty-wrap';
      const qty = document.createElement('div');
      qty.className = 'qty';
      qty.setAttribute('aria-label', `Số lượng ${name}`);
      const dec = document.createElement('button');
      dec.className = 'qty-btn';
      dec.type = 'button';
      dec.dataset.qtyStep = '-1';
      dec.setAttribute('aria-label', `Giảm số lượng ${name}`);
      dec.textContent = '−';
      const qtyInput = document.createElement('input');
      qtyInput.className = 'qty-input';
      qtyInput.name = 'quantity';
      qtyInput.type = 'number';
      qtyInput.inputMode = 'numeric';
      qtyInput.min = '1';
      qtyInput.max = String(CART_MAX_QUANTITY);
      qtyInput.required = true;
      qtyInput.value = '1';
      qtyInput.setAttribute('aria-label', `Số lượng ${name}`);
      const inc = document.createElement('button');
      inc.className = 'qty-btn';
      inc.type = 'button';
      inc.dataset.qtyStep = '1';
      inc.setAttribute('aria-label', `Tăng số lượng ${name}`);
      inc.textContent = '+';
      qty.append(dec, qtyInput, inc);
      const lineTotal = document.createElement('p');
      lineTotal.className = 'cart-line-total';
      lineTotal.dataset.lineTotal = '';
      lineTotal.textContent = money.format(price);
      qtyWrap.append(qty, lineTotal);
      main.append(info, qtyWrap);

      const foot = document.createElement('div');
      foot.className = 'cart-item-foot';
      const noteOpen = document.createElement('button');
      noteOpen.className = 'cart-note-open';
      noteOpen.type = 'button';
      noteOpen.dataset.cartNoteOpen = '';
      noteOpen.textContent = '+ Thêm lưu ý cho sản phẩm';
      const noteLabel = document.createElement('label');
      noteLabel.className = 'cart-note';
      noteLabel.htmlFor = noteId;
      noteLabel.hidden = true;
      noteLabel.dataset.cartNoteWrap = '';
      const noteInput = document.createElement('input');
      noteInput.id = noteId;
      noteInput.className = 'field cart-note-input';
      noteInput.name = 'lineNote';
      noteInput.type = 'text';
      noteInput.maxLength = CART_MAX_NOTE;
      noteInput.value = '';
      noteInput.autocomplete = 'off';
      noteInput.placeholder = 'Ghi chú thêm…';
      noteInput.dataset.cartNote = '';
      noteInput.setAttribute('aria-label', `Lưu ý — ${name}`);
      const noteIcon = document.createElement('span');
      noteIcon.className = 'cart-note-icon';
      noteIcon.setAttribute('aria-hidden', 'true');
      const noteLabelText = document.createElement('span');
      noteLabelText.className = 'cart-note-label';
      noteLabelText.textContent = 'Lưu ý';
      noteLabel.append(noteIcon, noteLabelText, noteInput);
      const remove = document.createElement('button');
      remove.className = 'cart-remove';
      remove.type = 'submit';
      remove.name = 'intent';
      remove.value = `remove:${index}`;
      remove.formNoValidate = true;
      remove.setAttribute('aria-label', `Xóa ${name}`);
      remove.title = 'Xóa';
      remove.innerHTML =
        '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" /></svg>';
      foot.append(noteOpen, noteLabel, remove);
      item.append(main, foot);
      cartList.append(item);
      bindQtyButton(dec);
      bindQtyButton(inc);
    };
    let saveTimer = 0;
    let applySerial = 0;
    const markQuoteStale = () => {
      applySerial += 1;
      const applyButton = form.querySelector('button[name="intent"][value="apply"]');
      if (applyButton instanceof HTMLButtonElement) {
        applyButton.disabled = false;
        applyButton.textContent = 'Áp dụng';
      }
      const label = form.querySelector('[data-cart-sum-label]');
      if (label) label.textContent = 'Tạm tính';
      const quoteNote = form.querySelector('[data-discount-quote]');
      if (quoteNote instanceof HTMLElement && !quoteNote.hidden && quoteNote.textContent) {
        quoteNote.textContent = 'Số lượng vừa đổi. Bấm Áp dụng để xem số giảm mới.';
      }
    };
    const showDiscount = (message: string, isError: boolean) => {
      const error = form.querySelector('[data-discount-error]');
      const quoteNote = form.querySelector('[data-discount-quote]');
      if (error instanceof HTMLElement) {
        error.hidden = !isError;
        error.textContent = isError ? message : '';
      }
      if (quoteNote instanceof HTMLElement) {
        quoteNote.hidden = isError || !message;
        quoteNote.textContent = isError ? '' : message;
      }
    };
    const previewDiscount = async (button: HTMLButtonElement) => {
      const serial = ++applySerial;
      const body = new FormData(form);
      body.set('intent', 'apply');
      button.disabled = true;
      button.textContent = 'Đang áp dụng...';
      try {
        const response = await fetch(form.action, { method: 'POST', body, headers: { accept: 'application/json' } });
        const payload: unknown = await response.json();
        if (serial !== applySerial) return;
        const row = payload && typeof payload === 'object' ? payload as { ok?: boolean; error?: string; quote?: { code?: string; discountAmount?: number; totalPrice?: number } } : null;
        const quoteRow = row?.quote;
        const discountAmount = quoteRow?.discountAmount;
        const totalPrice = quoteRow?.totalPrice;
        if (
          !response.ok ||
          !row?.ok ||
          typeof quoteRow?.code !== 'string' ||
          typeof discountAmount !== 'number' ||
          typeof totalPrice !== 'number' ||
          !Number.isInteger(discountAmount) ||
          !Number.isInteger(totalPrice)
        ) {
          showDiscount(typeof row?.error === 'string' ? row.error : 'Chưa kiểm được mã. Thử lại sau.', true);
          const sumLabel = form.querySelector('[data-cart-sum-label]');
          if (sumLabel) sumLabel.textContent = 'Tạm tính';
          recalc();
          return;
        }
        const codeField = form.querySelector('[name="discountCode"]');
        if (codeField instanceof HTMLInputElement) codeField.value = quoteRow.code;
        showDiscount(`Giảm ${quoteRow.code}: −${money.format(discountAmount)}. Còn ${money.format(totalPrice)} trước ship.`, false);
        const sumLabel = form.querySelector('[data-cart-sum-label]');
        if (sumLabel) sumLabel.textContent = 'Phải trả';
        recalc(totalPrice);
      } catch {
        if (serial !== applySerial) return;
        showDiscount('Chưa kiểm được mã. Thử lại sau.', true);
      } finally {
        if (serial === applySerial) {
          button.disabled = false;
          button.textContent = 'Áp dụng';
        }
      }
    };
    form.addEventListener('input', (event) => {
      if (!(event.target instanceof HTMLInputElement)) return;
      if (event.target.name === 'quantity') {
        recalc();
        markQuoteStale();
        window.clearTimeout(saveTimer);
        saveTimer = window.setTimeout(persist, 250);
        return;
      }
      if (event.target.name === 'lineNote') {
        window.clearTimeout(saveTimer);
        saveTimer = window.setTimeout(persist, 250);
      }
    });

    // Xử lý theo click thay vì submit: click luôn bắn, không phụ thuộc validation hay hành vi submit.
    form.addEventListener('click', (event) => {
      const target = event.target instanceof Element ? event.target : null;
      const noteOpen = target?.closest('[data-cart-note-open]');
      if (noteOpen instanceof HTMLButtonElement) {
        event.preventDefault();
        const foot = noteOpen.closest('.cart-item-foot');
        const wrap = foot?.querySelector('[data-cart-note-wrap]');
        noteOpen.hidden = true;
        if (wrap instanceof HTMLElement) {
          wrap.hidden = false;
          const input = wrap.querySelector('[data-cart-note]');
          if (input instanceof HTMLInputElement) input.focus();
        }
        return;
      }
      const button = target?.closest('button[name="intent"]');
      if (!(button instanceof HTMLButtonElement)) return;
      if (button.value.startsWith('remove:')) {
        event.preventDefault();
        const row = button.closest('[data-cart-item]');
        row?.remove();
        const remaining = form.querySelectorAll('[data-cart-item]').length;
        syncAddonButtons();
        recalc();
        markQuoteStale();
        persist();
        if (remaining === 0) location.reload();
        return;
      }
      if (button.value === 'apply') {
        event.preventDefault();
        void previewDiscount(button);
      }
      // Icon +: thêm bó vào giỏ, đánh dấu ✓, không reload — vẫn thêm được bó còn lại.
      if (button.value === 'add-addon' || button.value.startsWith('add-addon:')) {
        event.preventDefault();
        if (button.disabled || button.classList.contains('is-added')) return;
        const slug =
          button.value.startsWith('add-addon:') ? button.value.slice('add-addon:'.length).trim() : '';
        const card = button.closest('[data-addon-card]');
        if (!slug || !(card instanceof HTMLElement)) {
          window.alert('Chọn bó dâu để thêm vào giỏ.');
          return;
        }
        persist();
        const added = addCartLine(readCookie(), {
          slug,
          quantity: 1,
          weight: '',
          note: '',
        });
        if (!added.ok) {
          window.alert(added.error);
          return;
        }
        store(added.lines);
        const alreadyInDom = [...form.querySelectorAll<HTMLInputElement>('[data-cart-item] input[name="slug"]')].some(
          (input) => input.value === slug,
        );
        if (!alreadyInDom) appendAddonLine(card);
        setAddonButtonState(slug, true);
        recalc();
        markQuoteStale();
      }
    });

    // Chỉ cho POST "Gửi đơn" (và no-JS add-addon). Chặn submit ẩn / Enter làm mất intent.
    let sending = false;
    form.addEventListener('submit', (event) => {
      const submitter = event instanceof SubmitEvent ? event.submitter : null;
      if (!(submitter instanceof HTMLButtonElement)) {
        event.preventDefault();
        return;
      }
      if (submitter.value === 'add-addon' || submitter.value.startsWith('add-addon:')) return;
      if (submitter.value !== 'order') {
        event.preventDefault();
        return;
      }
      if (sending) {
        event.preventDefault();
        return;
      }
      sending = true;
      submitter.textContent = 'Đang gửi...';
    });
    window.addEventListener('pageshow', () => {
      sending = false;
      const orderButton = form.querySelector('button[name="intent"][value="order"]');
      if (orderButton) orderButton.textContent = 'Gửi đơn';
    });
  }
</script>
