---
import DataError from '../../components/public/DataError.astro';
import Pagination from '../../components/public/Pagination.astro';
import PostCard from '../../components/public/PostCard.astro';
import { listPublicCategories, listPublishedPosts } from '../../features/posts/public';
import { getPublicSite } from '../../features/settings/settings';
import PublicLayout from '../../layouts/PublicLayout.astro';
import { createDb } from '../../lib/db/client';
import { getDbBinding } from '../../lib/cloudflare/env';
import { buildMeta } from '../../lib/seo/meta';
import { routes } from '../../lib/routes';

const page = pageNumber(Astro.url.searchParams.get('page'));
const loaded = await loadList();
const outOfRange = loaded.site && loaded.total > 0 && page > loaded.pageCount;
if (outOfRange) Astro.response.status = 404;
if (loaded.site && !outOfRange) Astro.response.headers.set('Cache-Control', 'public, max-age=60');
else Astro.response.headers.set('Cache-Control', 'no-store');

const meta = buildMeta(Astro.url.origin, {
  title: loaded.site ? `Kiến thức | ${loaded.site.siteName}` : 'Chưa sẵn sàng',
  description: loaded.site?.defaultSeoDescription || 'Bài viết về vòng tơ tằm thủ công.',
  path: page > 1 ? `${routes.knowledgeList}?page=${page}` : routes.knowledgeList,
  siteName: loaded.site?.siteName,
  robots: loaded.site && !outOfRange ? 'index,follow' : 'noindex,nofollow',
});

function pageNumber(value: string | null): number {
  const page = Number(value ?? '1');
  return Number.isInteger(page) && page > 0 ? page : 1;
}

async function loadList() {
  try {
    const db = createDb(getDbBinding());
    const site = await getPublicSite(db);
    if (!site) return { site: null, failed: false, posts: [], categories: [], total: 0, pageCount: 1 };
    const [list, categories] = await Promise.all([
      listPublishedPosts(db, { page }),
      listPublicCategories(db),
    ]);
    return { site, failed: false, posts: list.posts, categories, total: list.total, pageCount: list.pageCount };
  } catch (error) {
    console.error(JSON.stringify({ event: 'post_list_public_failed', name: error instanceof Error ? error.name : 'unknown' }));
    return { site: null, failed: true, posts: [], categories: [], total: 0, pageCount: 1 };
  }
}
---

<PublicLayout
  title={meta.title}
  description={meta.description}
  canonical={loaded.site && !outOfRange ? meta.canonical : undefined}
  robots={meta.robots}
  siteName={meta.siteName}
  faviconUrl={loaded.site?.faviconUrl || '/favicon.svg'}
  chrome={loaded.site}
>
  {
    !loaded.site ? (
      <DataError failed={loaded.failed} />
    ) : outOfRange ? (
      <main class="mx-auto max-w-5xl px-4 py-16">
        <h1 class="text-3xl font-semibold">Không có trang này</h1>
        <p class="mt-4"><a href={routes.knowledgeList}>Về danh sách bài viết</a></p>
      </main>
    ) : (
      <main class="mx-auto max-w-5xl px-4 py-10">
        <h1 class="text-3xl font-semibold">Kiến thức</h1>
        <p class="mt-3 max-w-2xl text-muted">Bài viết về cách nhìn vòng tơ tằm thủ công và quy trình làm tại xưởng.</p>
        <nav class="mt-6 flex flex-wrap gap-2" aria-label="Danh mục">
          <a class="btn btn-primary" href={routes.knowledgeList} aria-current="page">Tất cả</a>
          {loaded.categories.map((category) => (
            <a class="btn" href={routes.knowledgeCategory(category.slug)}>{category.name}</a>
          ))}
        </nav>
        {loaded.posts.length === 0 ? (
          <p class="mt-8 text-muted">Chưa có bài viết.</p>
        ) : (
          <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {loaded.posts.map((post) => (
              <li><PostCard post={post} /></li>
            ))}
          </ul>
        )}
        <Pagination page={page} pageCount={loaded.pageCount} hrefFor={(next) => (next > 1 ? `${routes.knowledgeList}?page=${next}` : routes.knowledgeList)} />
      </main>
    )
  }
</PublicLayout>
