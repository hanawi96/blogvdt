---
import DataError from '../../components/public/DataError.astro';
import NotFound from '../../components/public/NotFound.astro';
import PublicLayout from '../../layouts/PublicLayout.astro';
import { bumpLandingView, getLandingPreview, getPublicLanding } from '../../features/landings/landings';
import { referencedMediaIds, referencedProductIds, hasProductsBlock, type LandingBlock } from '../../features/landings/blocks';
import { mediaMapByIds } from '../../features/media/media';
import { EMPTY_TRACKING, mergeTracking, type Tracking } from '../../features/tracking/tracking';
import { listLandingProducts, type LandingProduct } from '../../features/products/public';
import { getPublicSite } from '../../features/settings/settings';
import { createDb } from '../../lib/db/client';
import { getDbBinding, getSiteOrigin } from '../../lib/cloudflare/env';
import { formatVnd } from '../../lib/money';
import { buildMeta } from '../../lib/seo/meta';
import { ORDER_MAX_QUANTITY } from '../../features/orders/order';
import { routes } from '../../lib/routes';

const slug = Astro.params.slug ?? '';
const preview = Astro.url.searchParams.get('preview') === '1' && Astro.locals.adminSession?.role === 'admin';

let site: Awaited<ReturnType<typeof getPublicSite>> = null;
let blocks: LandingBlock[] = [];
let landing: { title: string; slug: string; robots: string; seoTitle: string | null; metaDescription: string | null; ogMediaId: number | null; tracking: Tracking } | null = null;
let products: LandingProduct[] = [];
let blockImages = new Map<number, { url: string; alt: string; width: number | null; height: number | null }>();
let ogImageUrl: string | null = null;
let failed = false;

try {
  const db = createDb(getDbBinding());
  site = await getPublicSite(db);
  const row = preview ? await getLandingPreview(db, slug) : await getPublicLanding(db, slug);
  if (row) {
    landing = { title: row.title, slug: row.slug, robots: row.robots, seoTitle: row.seoTitle, metaDescription: row.metaDescription, ogMediaId: row.ogMediaId, tracking: row.tracking };
    blocks = row.blocks;
    const productIds = referencedProductIds(blocks);
    const needAllProducts = hasProductsBlock(blocks) && productIds.length === 0;
    const blockImageIds = referencedMediaIds(blocks);
    const mediaIds = [...blockImageIds, ...(row.ogMediaId ? [row.ogMediaId] : [])];
    const [resolvedProducts, mediaMap] = await Promise.all([
      hasProductsBlock(blocks) ? listLandingProducts(db, needAllProducts ? [] : productIds) : Promise.resolve([]),
      mediaIds.length > 0 ? mediaMapByIds(db, mediaIds) : Promise.resolve(new Map()),
    ]);
    products = resolvedProducts;
    blockImages = mediaMap;
    ogImageUrl = row.ogMediaId ? (mediaMap.get(row.ogMediaId)?.url ?? null) : null;
    // Đếm lượt xem thật (bỏ qua khi admin xem thử) để đo chuyển đổi.
    if (!preview) {
      try {
        await bumpLandingView(db, slug);
      } catch (viewError) {
        console.error(JSON.stringify({ event: 'landing_view_bump_failed', name: viewError instanceof Error ? viewError.name : 'unknown' }));
      }
    }
  }
} catch (error) {
  failed = true;
  console.error(JSON.stringify({ event: 'landing_public_failed', name: error instanceof Error ? error.name : 'unknown' }));
}

if (!landing) {
  Astro.response.status = failed ? 503 : 404;
  Astro.response.headers.set('Cache-Control', 'no-store');
} else {
  // Trang quảng cáo không public-cache để sửa là thấy ngay; vẫn cho trình duyệt dùng lại trong thời gian ngắn.
  Astro.response.headers.set('Cache-Control', preview ? 'no-store' : 'public, max-age=30');
}

const origin = getSiteOrigin(Astro.url.origin);
const indexable = landing?.robots === 'index' && !preview;
const meta = buildMeta(origin, {
  title: landing ? `${landing.seoTitle || landing.title}${site ? ` | ${site.siteName}` : ''}` : 'Không tìm thấy trang',
  description: landing?.metaDescription || site?.defaultSeoDescription || '',
  path: routes.landing(slug),
  image: ogImageUrl ?? undefined,
  siteName: site?.siteName,
  robots: indexable ? 'index,follow' : 'noindex,nofollow',
});

const orderableProducts = products.map((product) => ({
  slug: product.slug,
  name: product.name,
  price: product.price,
}));

// Mã theo dõi của trang ưu tiên hơn mã chung ở Cài đặt; tắt hoàn toàn khi admin xem thử.
const pageTracking = preview || !landing ? EMPTY_TRACKING : mergeTracking(landing.tracking, site?.tracking ?? EMPTY_TRACKING);
---

<PublicLayout
  title={meta.title}
  description={meta.description}
  canonical={indexable ? meta.canonical : undefined}
  image={meta.image}
  robots={meta.robots}
  siteName={meta.siteName}
  faviconUrl={site?.faviconUrl || '/favicon.svg'}
  chrome={null}
  tracking={pageTracking}
  trackEvent="view"
>
  {
    !landing ? (
      failed ? <DataError failed={true} /> : <NotFound />
    ) : (
      <main class="landing-page">
        {preview && <p class="landing-preview-flag">Đang xem thử bản nháp. Trang chưa công khai.</p>}
        {
          blocks.map((block) => {
            if (block.type === 'hero') {
              const image = block.imageMediaId ? blockImages.get(block.imageMediaId) : null;
              return (
                <section class="lp-hero" class:list={[image && 'lp-hero-has-image']}>
                  {image && <img class="lp-hero-bg" src={image.url} alt={image.alt} width={image.width ?? undefined} height={image.height ?? undefined} />}
                  <div class="lp-hero-inner">
                    {block.eyebrow && <p class="lp-eyebrow">{block.eyebrow}</p>}
                    <h1 class="lp-hero-title">{block.title}</h1>
                    {block.subtitle && <p class="lp-hero-subtitle">{block.subtitle}</p>}
                    {block.ctaText && <a class="btn btn-accent lp-hero-cta" href={block.ctaAnchor}>{block.ctaText}</a>}
                  </div>
                </section>
              );
            }
            if (block.type === 'text') {
              return (
                <section class="lp-section lp-text">
                  {block.title && <h2 class="lp-section-title">{block.title}</h2>}
                  {block.body && <p class="lp-text-body">{block.body}</p>}
                </section>
              );
            }
            if (block.type === 'image') {
              const image = block.imageMediaId ? blockImages.get(block.imageMediaId) : null;
              if (!image) return null;
              return (
                <figure class="lp-section lp-image">
                  <img src={image.url} alt={block.caption || image.alt} width={image.width ?? undefined} height={image.height ?? undefined} loading="lazy" />
                  {block.caption && <figcaption class="lp-image-caption">{block.caption}</figcaption>}
                </figure>
              );
            }
            if (block.type === 'benefits') {
              return (
                <section class="lp-section">
                  {block.title && <h2 class="lp-section-title">{block.title}</h2>}
                  <ul class="lp-benefits">
                    {block.items.map((item) => (
                      <li class="lp-benefit">
                        {item.title && <p class="lp-benefit-title">{item.title}</p>}
                        {item.desc && <p class="lp-benefit-desc">{item.desc}</p>}
                      </li>
                    ))}
                  </ul>
                </section>
              );
            }
            if (block.type === 'products') {
              return (
                <section class="lp-section" id="san-pham">
                  {block.title && <h2 class="lp-section-title">{block.title}</h2>}
                  {products.length === 0 ? (
                    <p class="text-muted">Chưa có sản phẩm để hiển thị.</p>
                  ) : (
                    <ul class="lp-products">
                      {products.map((product) => (
                        <li class="lp-product-card">
                          {product.coverUrl ? (
                            <img class="lp-product-img" src={product.coverUrl} alt={product.coverAlt} loading="lazy" />
                          ) : (
                            <span class="lp-product-img lp-product-img-empty" aria-hidden="true" />
                          )}
                          <p class="lp-product-name">{product.name}</p>
                          <p class="lp-product-price">{formatVnd(product.price)}</p>
                          <button type="button" class="btn btn-primary lp-product-pick" data-pick-product={product.slug}>Đặt mẫu này</button>
                        </li>
                      ))}
                    </ul>
                  )}
                </section>
              );
            }
            return (
              <section class="lp-section lp-cta">
                {block.title && <h2 class="lp-section-title">{block.title}</h2>}
                {block.subtitle && <p class="lp-cta-subtitle">{block.subtitle}</p>}
                <a class="btn btn-accent" href={block.anchor}>{block.buttonText}</a>
              </section>
            );
          })
        }

        <section class="lp-section lp-order" id="dat-hang">
          <h2 class="lp-section-title">Đặt hàng</h2>
          {
            orderableProducts.length === 0 ? (
              <p class="text-muted">Chưa có sản phẩm để đặt.</p>
            ) : (
              <form class="lp-order-form" method="post" action={routes.checkout} data-landing-order data-landing={landing.slug}>
                <div class="absolute -left-[9999px]" aria-hidden="true">
                  <label for="company">Công ty</label>
                  <input id="company" name="company" tabindex="-1" autocomplete="off" />
                </div>
                <input type="hidden" name="landing" value={landing.slug} />
                <label class="block">
                  <span class="mb-1 block font-semibold">Mẫu đã chọn</span>
                  <select class="field" name="productSlug" data-order-select>
                    {orderableProducts.map((product) => (
                      <option value={product.slug}>
                        {product.name} — {formatVnd(product.price)}
                      </option>
                    ))}
                  </select>
                </label>
                <label class="mt-4 block" for="lp-quantity">
                  <span class="mb-1 block font-semibold">Số lượng</span>
                  <input id="lp-quantity" class="field" name="quantity" type="number" min="1" max={ORDER_MAX_QUANTITY} required value="1" />
                </label>
                <label class="mt-4 block" for="lp-name">
                  <span class="mb-1 block font-semibold">Họ tên</span>
                  <input id="lp-name" class="field" name="customerName" required maxlength="80" autocomplete="name" />
                </label>
                <label class="mt-4 block" for="lp-phone">
                  <span class="mb-1 block font-semibold">Số điện thoại</span>
                  <input id="lp-phone" class="field" name="phone" type="tel" required maxlength="20" autocomplete="tel" />
                </label>
                <label class="mt-4 block" for="lp-address">
                  <span class="mb-1 block font-semibold">Địa chỉ nhận hàng</span>
                  <textarea id="lp-address" class="field min-h-24" name="address" required maxlength="240" autocomplete="street-address"></textarea>
                </label>
                <label class="mt-4 block" for="lp-note">
                  <span class="mb-1 block font-semibold">Ghi chú</span>
                  <textarea id="lp-note" class="field min-h-20" name="note" maxlength="500"></textarea>
                </label>
                <button class="btn btn-accent mt-6 w-full" type="submit">Gửi đơn</button>
                <p class="mt-3 text-sm text-muted">Xưởng gọi lại để chốt đơn. Website không thu tiền trực tuyến.</p>
              </form>
            )
          }
        </section>
      </main>
    )
  }
</PublicLayout>

<script>
  // Bắn sự kiện "bắt đầu đặt hàng" tới các nền tảng có mặt. Chỉ bắn một lần mỗi trang.
  let checkoutFired = false;
  function fireInitiateCheckout() {
    if (checkoutFired) return;
    checkoutFired = true;
    const w = window as typeof window & {
      fbq?: (...args: unknown[]) => void;
      ttq?: { track?: (...args: unknown[]) => void };
      gtag?: (...args: unknown[]) => void;
    };
    try {
      w.fbq?.('track', 'InitiateCheckout');
      w.ttq?.track?.('InitiateCheckout');
      w.gtag?.('event', 'begin_checkout');
    } catch {
      /* không để lỗi tracking ảnh hưởng thao tác đặt hàng */
    }
  }

  const form = document.querySelector('[data-landing-order]');
  if (form instanceof HTMLFormElement) {
    const select = form.querySelector('[data-order-select]');

    // Nút "Đặt mẫu này" ở lưới: chọn đúng sản phẩm rồi cuộn tới form.
    for (const pick of document.querySelectorAll('[data-pick-product]')) {
      pick.addEventListener('click', () => {
        const slug = pick instanceof HTMLElement ? pick.dataset.pickProduct : '';
        if (select instanceof HTMLSelectElement && slug) select.value = slug;
        fireInitiateCheckout();
        document.getElementById('dat-hang')?.scrollIntoView({ behavior: 'smooth' });
      });
    }

    form.addEventListener('submit', () => {
      fireInitiateCheckout();
      const button = form.querySelector('button[type="submit"]');
      if (button instanceof HTMLButtonElement) {
        button.disabled = true;
        button.textContent = 'Đang gửi...';
      }
    });
  }
</script>
